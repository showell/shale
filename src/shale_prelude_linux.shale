-- **THE LINUX PRELUDE** (metal-vmm QUEUE 233, chunk 2; the dogfood
-- design's "Running a program", "Text" and "Edits that work"): what a
-- script has on Linux beside the core's. `run` and `real` are the names a
-- script types for the host's own calls; the rest are written in Shale,
-- over the core's builtins, so their every read and step is charged as if
-- the script had written them. Metal has none of this.

-- A program, run under `opts` (the host checks them: `timeout_ms` and a
-- keep are required).
function run(argv, opts)
  return host("run", argv, opts)
end

-- A Shale path's absolute OS path, for a program's argv.
function real(path)
  return host("real", path)
end

-- **A LONG JOB** (`job_start`): a program that outlives this run, its
-- output in `opts.log` and its record in `<log>.job`, under a detached
-- reaper. A later run finds it by that record's path.
function job_start(argv, opts)
  return host("job_start", argv, opts)
end

-- Whether a job (or the one whose record is at that path) still runs.
function job_alive(job)
  return host("job_alive", job)
end

-- A job stopped: TERM to its group, 2 seconds, then KILL; whether it ran.
function job_stop(job)
  return host("job_stop", job)
end

-- Until a job ends, a file holds a string, or the time runs out:
-- `{ended = "exited" | "found" | "timeout"[, code]}`.
function job_wait(job, opts)
  return host("job_wait", job, opts)
end

-- **THE `&&` OF A SHELL CHAIN**: `r` when its program exited 0; else its
-- output printed, and a failure naming the program and how it ended.
function must(r)
  if r.ended == "exit" and r.code == 0 then return r end
  local out = r.out
  if ends_with(out, "\n") then out = sub(out, 1, #out - 1) end
  if out ~= "" then print(out) end
  local what = "`" .. join(r.argv, " ") .. "`"
  if r.ended == "exit" then fail(what .. " exited " .. r.code) end
  if r.ended == "timeout" then fail(what .. " timed out") end
  fail(what .. " was ended by a signal")
end

-- `http` and `http_get`'s one request (below), `who` the name a slip is
-- told by.
function curl_http(who, method, url, opts?)
  local ms = 30000
  local o = {whole = 16777216}
  local argv = {"curl", "-sS", "--proto", "=http,https", "-X", method, "-D", "-"}
  if opts ~= nil then
    for k in keys(opts) do
      if k == "timeout_ms" then
        ms = opts.timeout_ms
      elseif k == "headers" then
        for h in opts.headers do
          push(argv, "-H")
          push(argv, h)
        end
      elseif k == "bearer" then
        o.secrets = {SHALE_BEARER = opts.bearer}
        push(argv, "--variable")
        push(argv, "%SHALE_BEARER")
        push(argv, "--expand-header")
        push(argv, "Authorization: Bearer {{SHALE_BEARER}}")
      elseif k == "body" and who == "http" then
        o.stdin = opts.body
        push(argv, "--data-binary")
        push(argv, "@-")
      elseif who == "http" then
        fail("`http` takes body, headers, bearer and timeout_ms, not `" .. k .. "`")
      else
        fail("`" .. who .. "` takes headers, bearer and timeout_ms, not `" .. k .. "`")
      end
    end
  end
  if not starts_with(url, "http://") and not starts_with(url, "https://") then fail("`" .. who .. "`: " .. url .. " is not an http:// or https:// URL") end
  push(argv, "--max-time")
  push(argv, tostring((ms + 999) // 1000))
  -- The status after the body, on a line of its own.
  push(argv, "-w")
  push(argv, "\n%{http_code}")
  push(argv, url)
  o.timeout_ms = ms + 5000
  local r = run(argv, o)
  -- The status is the last three bytes (`-w`'s `\n%{http_code}`), read from
  -- the end, not by splitting a large body into lines.
  local code = ""
  if #r.out >= 4 and sub(r.out, -4, -4) == "\n" then code = sub(r.out, -3) end
  if r.ended ~= "exit" then fail("`" .. who .. " " .. url .. "` did not finish (" .. r.ended .. ")") end
  if r.code ~= 0 then
    local why = trim(sub(r.out, 1, #r.out - #code))
    fail("`" .. who .. " " .. url .. "`: " .. (why ~= "" and why or "curl exited " .. r.code))
  end
  -- The head (`-D -`), a blank line, then the body; a `100 Continue` head
  -- before the answer's is passed over. Cut out of curl's output in place:
  -- the body is copied once (a copy is charged by its bytes).
  local at = 1
  local cut = find(r.out, "\r\n\r\n")
  while cut ~= nil and sub(r.out, at, at + 4) == "HTTP/" and contains(sub(r.out, at, cut), " 100 ") do
    at = cut + 4
    cut = find(r.out, "\r\n\r\n", at)
  end
  if cut == nil then fail("`" .. who .. " " .. url .. "`: curl gave no head") end
  -- After the status line, each line a `Name: value`, or the one before
  -- it continued (a folded header, begun by a space or a tab); anything
  -- else is curl's head misread, said, not passed by.
  local headers = {}
  local prev = nil
  local head = lines(sub(r.out, at, cut - 1))
  for i = 2, #head do
    local line = head[i]
    local colon = find(line, ":")
    if (starts_with(line, " ") or starts_with(line, "\t")) and prev ~= nil then
      headers[prev] = headers[prev] .. " " .. trim(line)
    elseif colon ~= nil then
      local name = lower(sub(line, 1, colon - 1))
      local value = trim(sub(line, colon + 1))
      local had = get(headers, name, nil)
      if had == nil then headers[name] = value else headers[name] = had .. "\n" .. value end
      prev = name
    else
      fail("`" .. who .. " " .. url .. "`: a head line that is no header: " .. line)
    end
  end
  return {status = tonumber(code), headers = headers, body = sub(r.out, cut + 4, #r.out - #code - 1), ms = r.ms}
end

-- **AN HTTP REQUEST, BY `curl`** (2026-10-25: a site's visitors, each kept
-- by the cookie its first answer set, told apart by hand): `method` to
-- `url`, and `{status, headers, body, ms}`, the status a number whatever it
-- is (the caller judges it). Its options:
-- - `body`: the request's body, a string, sent on curl's stdin (never in an
--   argv);
-- - `headers`: `"Name: value"` lines;
-- - `bearer`: a Shale path whose file holds a token, sent as
--   `Authorization: Bearer` and scrubbed from the output, never in an argv;
-- - `timeout_ms` (default 30000): the whole request's.
-- The answer's `headers` map each name, lowercased, to its value, several
-- of one name (`set-cookie`) joined by "\n". A redirect is the answer, not
-- followed. No answer at all (a name that does not resolve, a refused
-- connection, the time out) stops, in curl's words. Linux only: metal has
-- no `curl`.
function http(method, url, opts?)
  return curl_http("http", method, url, opts)
end

-- **AN HTTP GET, BY `curl`** (2026-10-23: a release's checks fetched
-- `/version` and a page by hand): `http`'s answer to a GET. It takes
-- `headers`, `bearer` and `timeout_ms`, as `http` does.
function http_get(url, opts?)
  return curl_http("http_get", "GET", url, opts)
end

-- The lines of `s` a regular expression matches (`{invert = true}`: the
-- others; `{nocase = true}`: either case), each `{line, text}`, numbered
-- from 1.
function re_lines(s, pattern, opts?)
  local o = {}
  local invert = false
  if opts ~= nil then
    for k in keys(opts) do
      if k == "nocase" then
        o.nocase = opts.nocase
      elseif k == "invert" then
        invert = opts.invert
      else
        fail("`re_lines` takes `invert` and `nocase`, not `" .. k .. "`")
      end
    end
  end
  local got = {}
  local n = 0
  for text in lines(s) do
    n = n + 1
    if (re_find(text, pattern, o) ~= nil) ~= invert then push(got, {line = n, text = text}) end
  end
  return got
end

-- The first `n` lines of a file, read a part at a time; nil when there is
-- no file.
function head_lines(p, n)
  if n < 0 then fail("`head_lines`: " .. n .. " lines") end
  if not exists(p) then return nil end
  local got = {}
  local at = 0
  while #got < n do
    local part = read_lines(p, at)
    for l in part.lines do
      if #got == n then break end
      push(got, l)
    end
    if part.done then break end
    at = part.next
  end
  return got
end

-- The last `n` lines of a file; nil when there is no file. It reads back
-- from the end, a part twice the last each time, until `n` lines fit.
function tail_lines(p, n)
  if n < 0 then fail("`tail_lines`: " .. n .. " lines") end
  if not exists(p) then return nil end
  local size = stat(p).size
  local part = 65536
  while true do
    local from = 0
    if size > part then from = size - part end
    -- A part begins at a line's start: the one after a newline at or
    -- after the byte before it.
    local at = 0
    if from > 0 then
      local nl = find_next(p, "\n", from - 1)
      if nl == nil then at = size else at = nl + 1 end
    end
    local got = {}
    while at < size do
      local r = read_lines(p, at)
      for l in r.lines do push(got, l) end
      if #got > n then got = last(got, n) end
      if r.done then break end
      at = r.next
    end
    if #got >= n or from == 0 then return last(got, n) end
    part = part * 2
  end
end

-- A list's strings, each once, in the order first seen.
function unique(list)
  local seen = {}
  local got = {}
  for x in list do
    if not has_key(seen, x) then
      seen[x] = true
      push(got, x)
    end
  end
  return got
end

-- The lines of a file of any size holding a literal, `{line, text}`, a
-- part at a time, numbered across the parts: `grep` past the call-bytes
-- cap.
function grep_all(p, lit)
  if lit == "" then fail("`grep_all` of \"\": every line holds it") end
  local got = {}
  local n = 0
  local at = 0
  while true do
    local r = read_lines(p, at)
    for l in r.lines do
      n = n + 1
      if contains(l, lit) then push(got, {line = n, text = l}) end
    end
    if r.done then return got end
    at = r.next
  end
end

-- **A NAME BELOW A FOLDER**, spelled as every call takes it: in the root
-- (`""`, `"."`) the name, in a mount's folder (`m:`, `m:.`) `m:name`,
-- else `dir/name`.
function path_under(dir, name)
  if dir == "" or dir == "." then return name end
  if ends_with(dir, ":") then return dir .. name end
  if ends_with(dir, ":.") then return sub(dir, 1, #dir - 1) .. name end
  return dir .. "/" .. name
end

-- The names of the `n` entries of a folder that changed last, newest
-- first (`ls -t | head`); names that changed at once, by name. The root is
-- `""` or `"."`.
function newest(p, n)
  local rows = {}
  for name in ls(p) do
    push(rows, {name = name, modified = stat(path_under(p, name)).modified})
  end
  sort(rows, "modified", "desc")
  local got = {}
  for r in take(rows, n) do push(got, r.name) end
  return got
end

-- **A RENAME THAT KNOWS ZIG** (metal-vmm QUEUE 234, 3): each identifier
-- token `from` in a Zig file becomes `to`, never one after `.`, nor
-- `@"from"`, nor in a string or a comment; `opts.lines = {first, last}`
-- limits it. A qualified `to` where `from` is declared stops the run.
-- `{renamed, left_in_comments}`.
function zig_rename(path, from, to, opts?)
  -- `host` takes three arguments past its name: `from` and `to` go as one.
  return host("zig_rename", path, {from = from, to = to}, opts)
end

-- Many names at once, `zig_rename` over a map: `{a = "x.a", b = "x.b"}`,
-- one pass, one write.
function zig_renames(path, names, opts?)
  return host("zig_rename", path, {many = names}, opts)
end

-- **A ZIG FILE'S TOP-LEVEL DECLARATIONS** (metal-vmm QUEUE 235, 1), from
-- Zig's own parser, in file order: each `{kind, name, name_form,
-- visibility, linkage, first, last, start, stop, uses[, comment_above]}`,
-- `uses` the top-level names its span uses. `opts.container` names a
-- container: its members instead, each with `reaches` too.
function zig_decls(path, opts?)
  if opts == nil then return host("zig_decls", path) end
  return host("zig_decls", path, opts)
end

-- **TOP-LEVEL DECLARATIONS MOVED BETWEEN ZIG FILES** (metal-vmm QUEUE 235,
-- 2): `names` (a name, or `{kind, name}`) cut from `from` and put in `to`
-- (made if missing), at its end or `opts.after` a declaration;
-- `opts.comment` is "doc" or "doc_and_plain". What the move broke:
-- `{moved, needs_pub, needs_import, needs_from_from, uses_left}`.
function zig_move(from, to, names, opts?)
  -- `host` takes three arguments past its name.
  -- A map holds no nil: `opts` only when given.
  local packed = {names = names}
  if opts ~= nil then packed.opts = opts end
  return host("zig_move", from, to, packed)
end

-- A Zig file's tokens, from Zig's tokenizer: each `{tag, text, line}`;
-- `opts.tag` (a std.zig.Token.Tag name) keeps one tag.
function zig_tokens(path, opts?)
  if opts == nil then return host("zig_tokens", path) end
  return host("zig_tokens", path, opts)
end

-- **A ZIG FILE'S `@import`s AND `@embedFile`s** (metal-vmm QUEUE 235, 3),
-- from Zig's parser, in source order: each `{kind = "import" | "embed",
-- target, name, line, file = "found" | "missing" | "module"}`.
function zig_imports(path)
  return host("zig_imports", path)
end

-- A new file: refused if one is there already.
function create(p, text)
  if exists(p) then fail("`create`: " .. p .. " is there already: `edit` or `replace` it") end
  replace(p, text)
end

-- **INTERNAL to `edits_all`** (as is `edit_words`): no script's to call,
-- but its name is taken. Whether `c` (one byte, or "" at an end) is a
-- word's, as `edit`'s `word` reads it: a letter, a digit or `_`.
function edit_word_byte(c)
  return c ~= "" and re_find(c, "^[A-Za-z0-9_]$") ~= nil
end

-- **INTERNAL to `edits_all`**: `text` with each whole-word `old` replaced
-- by `new`, as `edit`'s `{word = true, all = true}` does: `{text, n}`.
function edit_words(text, old, new)
  local out = {}
  local rest = text
  local before = ""
  local n = 0
  while true do
    local at = find(rest, old)
    if at == nil then break end
    local prev = before
    if at > 1 then prev = sub(rest, at - 1, at - 1) end
    local next = sub(rest, at + #old, at + #old)
    if not edit_word_byte(prev) and not edit_word_byte(next) then
      push(out, sub(rest, 1, at - 1))
      push(out, new)
      n = n + 1
      before = sub(old, #old, #old)
      rest = sub(rest, at + #old)
    else
      -- On by one byte, as `edit` steps: a match overlapping this one
      -- may still hold.
      push(out, sub(rest, 1, at))
      before = sub(rest, at, at)
      rest = sub(rest, at + 1)
    end
  end
  push(out, rest)
  return {text = join(out, ""), n = n}
end

-- **EDITS TO SEVERAL FILES** (`{{p, {{old, new[, all][, word]}, ...}}, ...}`):
-- every file's edits checked against it first, in sequence as `edit`'s
-- list form applies them, and nothing written unless all hold; then each
-- file is edited, atomically. The set is not atomic: a file changed
-- between the check and its edit stops there, the files before it
-- written. A `word` edit is checked as `edit` applies it, whole words
-- only, so the edits after it are checked against its result. The
-- replacements made in all.
function edits_all(list)
  -- A file named twice, by any spelling (a mount's, the root's), is checked
  -- against its earlier edits' result, as `edit` will meet it.
  local checked = {}
  -- Each item is one `edit`: a change, its bytes the file as written.
  local bytes = 0
  for item in list do
    if #item[2] > 64 then fail("`edits_all`: " .. item[1] .. " has " .. #item[2] .. " edits, and `edit` takes at most 64 a call; nothing written") end
    local key = real(item[1])
    local text = get(checked, key, nil)
    if text == nil then text = read(item[1]) end
    local j = 0
    for e in item[2] do
      j = j + 1
      local where = "`edits_all`: " .. item[1] .. "'s edit " .. j .. ": "
      local all = get(e, "all", false)
      if e.old == "" then fail(where .. "`old` is empty; nothing written") end
      if get(e, "word", false) then
        local r = edit_words(text, e.old, e.new)
        if r.n == 0 then fail(where .. "`old` is not there as a whole word; nothing written") end
        if r.n > 1 and not all then fail(where .. "`old` is there " .. r.n .. " times as a whole word, and the edit does not say `all`; nothing written") end
        text = r.text
      else
        local times = #split(text, e.old) - 1
        if times == 0 then fail(where .. "`old` is not there; nothing written") end
        if times > 1 and not all then fail(where .. "`old` is there " .. times .. " times, and the edit does not say `all`; nothing written") end
        text = substitute(text, e.old, e.new)
      end
    end
    checked[key] = text
    bytes = bytes + #text
  end
  local left = budget()
  if #list > left.changes then fail("`edits_all`: " .. #list .. " files to write, and the budget has " .. left.changes .. " change" .. (left.changes == 1 and "" or "s") .. " left; nothing written") end
  if bytes > left.change_bytes then fail("`edits_all`: " .. bytes .. " bytes to write, and the budget has " .. left.change_bytes .. " left; nothing written") end
  -- A file that may not change (a read-only mount's) stops it here,
  -- before any is written.
  for item in list do host("may_change", item[1]) end
  local n = 0
  for item in list do n = n + edit(item[1], item[2]) end
  return n
end
