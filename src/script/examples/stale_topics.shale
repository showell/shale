-- Every topic untouched for 30 days (its transcript's modified time), with
-- its message count and that time: the candidates to delete
-- (delete_topic.shale). topics.shale, its condition one clause longer.
-- Every topic with its message count: the direct conversations
-- (chat/<a>_<b>/sessions/<sid>.md) and the channels
-- (chat/channels/<name>/sessions/<sid>.md). A message is a block that
-- starts with a line "MSG_<sid>_<n>", and no message's text holds "MSG_"
-- (as find_message.shale reads them): counted without holding a
-- transcript, in one call when it is within the call-bytes cap (1 MiB),
-- and by the prelude's count_all, a part at a time, when it is bigger.

const CAP = 1048576

function messages(e)
  if e.size <= CAP then return count_in(e.path, "MSG_") end
  return count_all(e.path, "MSG_")
end

local total = 0
for e in walk_all("chat", {like = "*.md", kind = "file"}) do
  local parts = split(e.path, "/")
  local sid = strip_suffix(parts[#parts], ".md")
  if parts[#parts - 1] == "sessions" and e.modified < now() - 30 * 86400 then
    local label = parts[2]
    if parts[2] == "channels" then label = "#" .. parts[3] end
    print(label, sid, messages(e), date(e.modified))
    total = total + 1
  end
end
print("topics", total)
