-- **THE PRELUDE** (metal-vmm QUEUE 220): functions every script has,
-- written in Shale. Each part of their work is one builtin call under its
-- cap, so a run's slices and budgets are as if the script had written them
-- itself. A script may declare a function of the same name: its calls are
-- then its own.

-- Every entry `walk(path, opts)` gives, from `opts.after` on if it is given,
-- a part at a time: one call considers at most the call-entries cap (256)
-- and ends its part with a `more` entry, whose path is where the next part
-- starts. `opts` (none: `{}`) is not changed. Each entry's `path` begins
-- with `path`, as `walk`'s do.
function walk_all(path, opts?)
  local o = {after = ""}
  if opts == nil then opts = {} end
  for k in keys(opts) do o[k] = opts[k] end
  local got = {}
  while true do
    local more = nil
    for e in walk(path, o) do
      if e.kind == "more" then more = e.path else push(got, e) end
    end
    if more == nil then return got end
    o.after = more
  end
end

-- **AS FAR AS THE READS ALLOW** (metal-vmm QUEUE 229): every entry `walk`
-- gives from `opts.after` on, a part at a time, until the walk ends or
-- its reads would leave fewer than `keep` for the rest of the script:
-- `{entries, more, done}`. Not `done`, `more` is the path a later walk goes
-- on after (`opts.after = more`), and every entry up to it is in
-- `entries`. `opts` is not changed.
function walk_upto(path, opts, keep)
  local o = {after = ""}
  for k in keys(opts) do o[k] = opts[k] end
  o.keep_reads = keep
  local got = {}
  while true do
    local more = nil
    for e in walk(path, o) do
      if e.kind == "more" then more = e.path else push(got, e) end
    end
    if more == nil then return {entries = got, more = "", done = true} end
    -- A part that took nothing had no room to: the reads are what is kept.
    if more == o.after then return {entries = got, more = more, done = false} end
    o.after = more
  end
end

-- Whether what is left of the budgets holds `need`, a map of `budget()`'s
-- names (`{reads = 2, read_bytes = 4096}`): the guard before work a
-- budget would stop half done.
function room_for(need)
  local left = budget()
  for k in keys(need) do
    if left[k] < need[k] then return false end
  end
  return true
end

-- **THE FILES A GLOB NAMES** (metal-vmm QUEUE 229): every file whose path
-- matches `pattern` (`match_path`: `**` any parts, `*` and `?` in one),
-- sorted as the walk goes. The walk starts at the pattern's parts before
-- its first wildcard, and passes by hidden names (`.git`, `.zig-cache`)
-- unless `opts` says `{hidden = true}` (QUEUE 233).
function glob(pattern, opts?)
  local skip = ".*"
  if opts ~= nil then
    for k in keys(opts) do
      if k ~= "hidden" then fail("`glob` takes `hidden`, not `" .. k .. "`") end
    end
    if get(opts, "hidden", false) then skip = "" end
  end
  -- A mount's name (`m:`) is no part: the parts are what follows it.
  local mount = ""
  local rest = pattern
  local named = re_find(pattern, "^([A-Za-z0-9_-]+:)")
  if named ~= nil then
    mount = named.group
    rest = sub(pattern, #mount + 1)
  end
  local parts = split(rest, "/")
  local base = {}
  -- A `.` or `..` part names no path: refused, as every store call does.
  for p in parts do
    if p == "." or p == ".." then fail("`glob`: \"" .. pattern .. "\" has a part (\"" .. p .. "\") that is not a name") end
  end
  for p in parts do
    if contains(p, "*") or contains(p, "?") then break end
    push(base, p)
  end
  local from = mount .. join(base, "/")
  local got = {}
  if #base == #parts then
    if exists(from) and not is_dir(from) then push(got, from) end
    return got
  end
  if from ~= "" and not exists(from) then return got end
  local o = {kind = "file"}
  if skip ~= "" then o.skip = skip end
  for e in walk_all(from, o) do
    if match_path(sub(e.path, #mount + 1), rest) then push(got, e.path) end
  end
  return got
end

-- How many times `s` occurs in the file, a part at a time: one scan brings
-- at most the call-bytes cap (`call_bytes()`, 1 MiB unset). A stat,
-- then a scan a part.
function count_all(path, s)
  local part = call_bytes()
  local size = stat(path).size
  local n = 0
  local at = 0
  while at < size do
    n = n + count_in(path, s, at, min(part, size - at))
    at = at + part
  end
  return n
end

-- The 0-based offset of the first `s` at or after `at`, or nil: the file a
-- part at a time from `at`, as `find_in`. The first part is scanned at
-- once (a part past the file's end is cut at it); only when it finds
-- nothing is the file stat'ed, to see whether there is more.
function find_next(path, s, at)
  local part = call_bytes()
  local f = find_in(path, s, at, part)
  if f ~= nil then return f end
  local size = stat(path).size
  at = at + part
  while at < size do
    f = find_in(path, s, at, min(part, size - at))
    if f ~= nil then return f end
    at = at + part
  end
  return nil
end
-- All of `l` but its first `n` items, in order (none of a list no longer
-- than `n`): `take`'s other half, so a part of a list is
-- `take(drop(l, from), count)`. A count below 0 is a stop, as `take`'s is.
function drop(l, n)
  if n < 0 then fail("`drop`: a count of " .. n) end
  return last(l, max(0, #l - n))
end

-- **A SCRIPT'S OWN CHECK**: `ok` must be true, else the run stops with
-- `why` (`fail`'s class). Only a boolean is taken: a number, a string or
-- nil is a stop of its own, never true by default (Lua's `assert(0)`).
function assert(ok, why)
  if ok == false then fail(why) end
  if ok ~= true then fail("`assert`: its first argument must be true or false, not " .. tostring(ok)) end
end

-- **A CALL'S OPTIONS, HELD TO ITS NAMES**: a stop naming the first key of
-- `opts` (nil: none) that `names` does not list, and the call `who` whose
-- it is, so a misspelt option is never passed by.
function opts_only(opts, names, who)
  if opts == nil then return nil end
  for k in keys(opts) do
    local known = false
    for n in names do
      if n == k then known = true end
    end
    if not known then
      local said = {}
      for n in names do push(said, "`" .. n .. "`") end
      local list = "no options"
      if #said > 0 then list = join(said, ", ") end
      fail("`" .. who .. "` takes " .. list .. ", not `" .. k .. "`")
    end
  end
end

-- Items `from` to `to` of `l`, both kept, as a new list: none when `from >
-- to`, and an end past the list is cut at it. Items count from 1, so a
-- `from` below 1 is a stop.
function slice(l, from, to)
  if from < 1 then fail("`slice`: a start of " .. from .. "; items count from 1") end
  return take(drop(l, from - 1), max(0, to - from + 1))
end

-- `v` pushed onto the list at `m[k]`, made empty first if `k` is not there:
-- a map of lists, grown an item at a time.
function push_at(m, k, v)
  if not has_key(m, k) then m[k] = {} end
  push(m[k], v)
end

-- `m[k]` counted up by `n` (1 unless given), from 0 if `k` is not there;
-- the new count.
function incr(m, k, n?)
  if n == nil then n = 1 end
  m[k] = get(m, k, 0) + n
  return m[k]
end

-- A map of each of `list`'s items to true, so `has_key(set, x)` asks
-- whether `x` is among them. A map's keys are strings, so an item that is
-- not one is a stop; `has_item` asks a list of any items.
function set_of(list)
  local set = {}
  for x in list do
    if tostring(x) ~= x then fail("`set_of`: an item " .. tostring(x) .. " is not a string; a map's keys are strings (`has_item` takes any)") end
    set[x] = true
  end
  return set
end

-- Whether `x` is one of `list`'s items (`==`), looked for in order.
function has_item(list, x)
  for y in list do
    if y == x then return true end
  end
  return false
end

-- Every 1-based position where `t` starts in `s`, in order, overlapping
-- ones too (`find_all("aaa", "aa")` is `{1, 2}`); none is `{}`. An empty `t`
-- is a stop: it is found everywhere.
function find_all(s, t)
  if t == "" then fail("`find_all`: an empty string is found at every position; look for one that is not empty") end
  local got = {}
  local at = find(s, t)
  while at ~= nil do
    push(got, at)
    if at + 1 > #s then break end
    at = find(s, t, at + 1)
  end
  return got
end

-- Every match of `pattern` in `s`, left to right and not overlapping, each
-- as `re_find` gives it (`{at, text[, groups, group]}`); none is `{}`. Each
-- search sees the whole of `s` (`re_find`'s `from`), so `^` and `\b` mean
-- its real edges; after an empty match the next search starts a byte on.
-- `opts` takes `nocase`.
function re_find_all(s, pattern, opts?)
  opts_only(opts, {"nocase"}, "re_find_all")
  local o = {from = 1}
  if opts ~= nil and has_key(opts, "nocase") then o.nocase = opts.nocase end
  local got = {}
  while o.from <= #s + 1 do
    local m = re_find(s, pattern, o)
    if m == nil then break end
    push(got, m)
    o.from = m.at + max(1, #m.text)
  end
  return got
end

-- What precedes `p`'s last `/`: its folder, "" (the root) when it has
-- none. `basename`'s other half.
function dirname(p)
  local m = re_find(p, "^(.*)/")
  if m == nil then return "" end
  return m.group
end

-- `p` with its `.` and empty parts left out and each `..` taking back the
-- part before it (`a/./b/../c` is `a/c`, a mount's `m:` kept in front); nil
-- when a `..` would climb above where `p` starts (`..`, `a/../..`). An
-- absolute path is a stop: a path is the root's.
function path_normal(p)
  if starts_with(p, "/") then fail("`path_normal`: \"" .. p .. "\" is absolute; a path is the root's, or a mount's (`m:path`)") end
  local mount = ""
  local named = re_find(p, "^([A-Za-z0-9_-]+:)")
  if named ~= nil then
    mount = named.group
    p = sub(p, #mount + 1)
  end
  local parts = {}
  for x in split(p, "/") do
    if x == ".." then
      if #parts == 0 then return nil end
      parts = take(parts, #parts - 1)
    elseif x ~= "." and x ~= "" then
      push(parts, x)
    end
  end
  return mount .. join(parts, "/")
end
