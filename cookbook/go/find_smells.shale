-- Functions in a Go tree that may want a second look, read from Go's own
-- parser (go_tree, cookbook/go/parsed.shale). The Zig smells that translate
-- to Go, and the block nesting a reader has to hold in their head:
--
--   long_func    a function or method of `long=` lines or more (80), its
--                signature to its `}`: a seam to look for.
--   deep_block   a function whose statements nest `deep=` blocks deep (4):
--                each `if`, `for`, `switch` or `select` is a level, an
--                `else if` is not, and a function literal starts again at
--                zero, judged on its own. The finding is at the first
--                statement that deep.
--   many_params  a function of `params=` parameters or more (6): a struct
--                waiting to be named.
--   bool_param   a function with a `bool` parameter: a call site's bare
--                `true` says nothing, where a named type would.
--
-- One line a finding, `path:line: <check>: <what>`, between two copies of
-- the counts; the run exits 0 on findings, which are for a reader, and fails
-- on a file go-ast refuses.
--
--   cd <repo> && shale <shale>/cookbook/go/find_smells.shale long=60 tests=0
--   shale cookbook:go/find_smells.shale self_test=1
--
-- `glob=` names the files (`**/*.go`), and `tests=0` leaves out the
-- `_test.go` files. `self_test=1` reads `cookbook/go/plants/find_smells/` at
-- `long=19`, so a plant stays small, and the other defaults; each line
-- ending `// want: <check>, ...` gives exactly those findings.
-- budget: steps=200000000 arena_bytes=2000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const PLANTS = "cookbook:go/plants/find_smells/"
const GLOB = SELF_TEST and (PLANTS .. "*.go") or arg("glob", "**/*.go")
const TESTS = arg("tests", 1) == 1
const LONG = SELF_TEST and 19 or arg("long", 80)
const DEEP = SELF_TEST and 4 or arg("deep", 4)
const PARAMS = SELF_TEST and 6 or arg("params", 6)
const CHECKS = {"long_func", "deep_block", "many_params", "bool_param"}
use("cookbook:go/parsed.shale")
use("cookbook:findings.shale")

const LEVELS = {IfStmt = true, ForStmt = true, RangeStmt = true, SwitchStmt = true, TypeSwitchStmt = true, SelectStmt = true}
const FUNCTIONS = {FuncDecl = true, FuncLit = true}

function say(report, path, line, check, what)
  push(report, {path = path, line = line, check = check, what = what})
  return nil
end

-- A function's name, or `a func literal in f` for a literal.
function function_name(nodes, i)
  if nodes[i].kind == "FuncDecl" then return nodes[kid_in(nodes, i, "Name")].name end
  local p = nodes[i].parent
  while p > 0 and nodes[p].kind ~= "FuncDecl" do p = nodes[p].parent end
  if p == 0 then return "a func literal" end
  return "a func literal in " .. nodes[kid_in(nodes, p, "Name")].name
end

-- Each parameter `{name, type}`, one a name (`a, b int` is two).
function params_of(nodes, source_lines, func)
  local got = {}
  local list = kid_in(nodes, kid_in(nodes, func, "Type"), "Params")
  for field in kids_in(nodes, list, "List") do
    local t = source_of(source_lines, nodes[kid_in(nodes, field, "Type")])
    local names = kids_in(nodes, field, "Names")
    if #names == 0 then push(got, {name = "_", type = t}) end
    for k in names do push(got, {name = nodes[k].name, type = t}) end
  end
  return got
end

function signatures(f, nodes, source_lines, report)
  for i = 1, #nodes do
    if nodes[i].kind == "FuncDecl" then
      local name = function_name(nodes, i)
      local n = nodes[i]
      local length = n.end_line - n.line + 1
      if length >= LONG then say(report, f.path, n.line, "long_func", "`" .. name .. "` is " .. length .. " lines") end
      local params = params_of(nodes, source_lines, i)
      if #params >= PARAMS then say(report, f.path, n.line, "many_params", "`" .. name .. "` takes " .. #params .. " parameters") end
      local flags = {}
      for q in params do
        if q.type == "bool" then push(flags, q.name) end
      end
      if #flags > 0 then say(report, f.path, n.line, "bool_param", "`" .. name .. "` takes `bool` " .. join(flags, ", ") .. ": a caller's bare `true` says nothing") end
    end
  end
  return nil
end

-- The block depth of each statement, counted from its function: a level
-- for each `if` (not an `else if`), `for`, `switch` and `select` around it
-- and its own; one finding a function, at its first statement `DEEP` deep.
function nesting(f, nodes, report)
  local level = {}
  local deepest = {}
  local first_deep = {}
  -- Each node's function, its nearest FuncDecl or FuncLit.
  local owner = {}
  for i = 1, #nodes do
    local n = nodes[i]
    local p = n.parent
    local inherited = 0
    local func = 0
    if p > 0 then
      inherited = level[p]
      func = owner[p]
    end
    if has_key(FUNCTIONS, n.kind) then
      inherited = 0
      func = i
    end
    local own = 0
    if has_key(LEVELS, n.kind) and not (n.kind == "IfStmt" and get(n, "role", "") == "Else") then own = 1 end
    push(level, inherited + own)
    push(owner, func)
    if own == 1 and func > 0 and level[i] > get(deepest, tostring(func), 0) then
      deepest[tostring(func)] = level[i]
      if level[i] == DEEP then first_deep[tostring(func)] = i end
    end
  end
  for key in keys(first_deep) do
    local func = parse_int(key)
    local at = nodes[first_deep[key]]
    say(report, f.path, at.line, "deep_block", "`" .. function_name(nodes, func) .. "` nests " .. deepest[key] .. " blocks deep, the first " .. DEEP .. " here")
  end
  return nil
end

const paths = go_paths(GLOB, TESTS)
local parsed = parse_go_files(paths)
local report = {}
for f in parsed.files do
  local source_lines = split(read(f.path), "\n")
  signatures(f, f.nodes, source_lines, report)
  nesting(f, f.nodes, report)
end
sort(report, {"path", "line", "check", "what"})
local count_by_check = {}
local finding_lines = {}
const found_at = {}
for r in report do
  incr(count_by_check, r.check)
  push(finding_lines, r.path .. ":" .. r.line .. ": " .. r.check .. ": " .. r.what)
  push_at(found_at, r.path .. ":" .. r.line, r.check)
end
local counts = {}
for c in CHECKS do push(counts, c .. " " .. get(count_by_check, c, 0)) end
print_findings("smells (Go): " .. #paths .. " files; " .. join(counts, ", ") .. " (long " .. LONG .. ", deep " .. DEEP .. ", params " .. PARAMS .. ")", finding_lines)
fail_if_go_refused("smells", parsed.refused)
if SELF_TEST then check_want_marks("smells", paths, found_at, CHECKS) end
