-- **A roc-chat CONVERSATION, LISTENED TO FOR ONE AGENT**: its stream
-- (`GET /conversations/<conv>/stream`), and one line a post that is for
-- the agent, `#<id> by <principal>: <its first line>`. The key stays in a
-- secrets mount: `run`'s `secrets` gives it to curl alone, which reads it
-- from its environment (`--variable`), so no script sees it.
--
--   shale cookbook:listen.shale site=https://chat.lynrummy.com conv=3 me=agent:2 key=keys:roc_chat_cc_key once=1
--   shale cookbook:listen.shale site=... conv=3 me=agent:2 key=keys:... log=listen.log after=12
--
-- **A POST IS FOR THE AGENT** when both hold (`for_me`, pure):
--   1. it is not the agent's own (`by` is not `me`);
--   2. it names the agent: the server's `mentions` holds `me`. The rule
--      of who a post names has one home, roc-chat's app/Mentions.roc
--      (words, skipping quoted and fenced text), so every listener agrees;
--      a message without `mentions` stops the run, named, never a guess.
-- There is no rule for agents answering agents: the roc-chat server
-- bounds agent-to-agent traffic, the one home of that limit, so an
-- agent's every mention is heard.
-- **THE BUDGET WARNING**: the server's limit is mirrored here (its numbers
-- below), so at 12 of 15 of the agent's own agent-to-agent posts this hour
-- one line, `budget: ...`, says so once a crossing, before any post heard
-- with it; it never ends a run, and goes to `log=` too.
-- `after=` is the last id already handled: nothing at or before it is
-- printed.
--
-- **HOW IT LISTENS**: a run's output reaches the terminal only when it
-- ends, and a run starts at most 64 programs, so the stream is held in
-- windows: one curl a window (`window=` seconds, 20 by default, under
-- curl's `--max-time`), the first with no `Last-Event-ID` (the newest page),
-- each after it resuming at the last whole frame. A post is heard at most
-- a window late.
-- **IN BATCHES** (`after_batch`, pure): the windows run in a batch, a
-- child run of this script (`batch=1`, every value passed on) with its own
-- 64 programs: 63 curls, about 21 minutes of quiet at 20 s windows. It
-- ends one of three ways: a post heard with `once=1`, which the caller
-- prints and exits 0 on; a stop (a refusal, a gap), which stops the caller
-- with the batch's own line; or its curls spent, which it ends with
-- `listen batch spent: after=<id>`, and the caller starts the next batch
-- from that id. Any other end stops the caller, named, never a quiet loop.
-- A batch is one of the caller's programs, so a run listens through 63
-- batches, about 22 hours of quiet; then it stops, naming the `after=` to
-- start it again with. The batch's lines (posts, `budget:`, reconnects)
-- reach the caller's output when the batch ends, and `log=` as heard.
--   - `once=1` prints the first post for the agent and exits 0: a detached
--     command that ends is what wakes a session on the box.
--   - Otherwise each line is appended to `log=` as it is heard (required),
--     for `tail -F` under a watcher, until the run's batches are spent; the
--     stop names the `after=` to go on from.
-- **IT RECONNECTS BY ITSELF** (`after_window`, pure): a deploy restarts
-- roc-chat and ends every stream, so the stream ended by the server, no
-- connection, curl failing mid-stream, or any status but 200, 401, 403
-- and 404 (a 502 from the proxy while the server is down) is a reconnect,
-- never a stop. Each prints one line, `reconnecting after <reason>, from
-- after=<id>, in <n> s`, (to `log=` too), waits (`backoff_s`: 2, 5, 15,
-- 30, then 60 s between attempts, back to 2 after a window that ran its
-- length) and resumes from the last id seen, so nothing is missed or
-- heard twice. A reconnect is a curl, one of its batch's 63, and each
-- batch begins its waits again at 2 s.
-- **A DEAD LISTENER IS NEVER QUIET**: a refusal, 401 or 403 (the key
-- revoked or wrong) or 404 (no such conversation, or not the agent's),
-- a `gap` (more missed than the backlog holds), a message without
-- `mentions` (a server older than them), or the run's batches spent
-- (start it again with the `after=` the stop names) each stop the run
-- nonzero, named.
--
-- `self_test=1` feeds the recorded frames in `cookbook/plants/listen/`
-- through the same `consume` the live path uses, and a batch's every end
-- through `after_batch`: no roc-chat, no network. Two hidden knobs serve a
-- live test against a local server: `curls=` (1 to 63) a batch's curls,
-- to roll batches over quickly, and `self=` the script a batch runs
-- (`cookbook:listen.shale`, as no builtin names a script's own path).
--
-- budget: steps=200000000 arena_bytes=400000000

const SELF = arg("self_test", "") == "1"
const SITE = arg("site", "")
const CONV = arg("conv", "")
const ME = arg("me", "")
const KEY = arg("key", "")
const AFTER = tonumber(arg("after", "0"))
const ONCE = arg("once", "") == "1"
const LOG = arg("log", "")
const WINDOW_S = tonumber(arg("window", "20"))
-- A batch, the child run that holds the windows (see HOW IT LISTENS).
const BATCH = arg("batch", "") == "1"
-- How the parent runs itself: no builtin names a script's own path, so
-- it is said here, and `self=` (a hidden test knob) runs a lane's copy.
const SELF_PATH = arg("self", "cookbook:listen.shale")
-- Of a run's 64 programs, a batch's windows take all but one, left
-- spare; `curls=` (a hidden test knob) takes fewer, to roll batches over.
const WINDOWS_MOST = tonumber(arg("curls", "63"))
-- The parent's programs: one a batch, all but one, left spare.
const BATCHES_MOST = 63
-- The line a batch ends with when its curls are spent: the parent goes
-- on from its id. Never a post's line, which starts with `#`.
const SPENT = "listen batch spent: after="
const LINE_MOST = 200
-- **roc-chat's agent-to-agent limit, mirrored**: an agent makes at most
-- AGENT_POSTS_MOST posts naming another agent in WINDOW_SECS, counting
-- only those since the last human post (a human post resets it). The
-- server enforces it; the listener warns at WARN_AT, before a refusal.
const AGENT_POSTS_MOST = 15
const WINDOW_SECS = 3600
const WARN_AT = 12

-- ── the decision, pure ───────────────────────────────────────────────────

function contains_item(list, x)
  for v in list do
    if v == x then return true end
  end
  return false
end

-- **WHO A POST NAMES**: the server's `mentions` (roc-chat's
-- app/Mentions.roc, the one home of the rule); `consume` has refused a
-- message without them.
function names(msg, id)
  return contains_item(msg.mentions, id)
end

-- Rules 1 and 2.
function for_me(msg, me)
  if msg.by == me then return false end
  return names(msg, me)
end

-- Whether `by` is an agent and the post names an agent not itself: one
-- of the agent-to-agent posts the server's limit counts.
function agent_to_agent(msg)
  if not starts_with(msg.by, "agent:") then return false end
  for m in msg.mentions do
    if m ~= msg.by and starts_with(m, "agent:") then return true end
  end
  return false
end

-- The agent's agent-to-agent posts within the hour before `newest`.
-- `at` is roc-chat's message time in seconds, and "now" is the newest
-- `at` seen, never the box's clock, so a replay counts as the live run
-- did.
function budget_used(ats, newest)
  local n = 0
  for t in ats do
    if t > newest - WINDOW_SECS then n = n + 1 end
  end
  return n
end

-- The post's first line with text, trimmed and cut.
function first_line(md)
  for l in lines(md) do
    local t = trim(l)
    if t ~= "" then
      if #t > LINE_MOST then return sub(t, 1, LINE_MOST) .. "..." end
      return t
    end
  end
  return ""
end

-- ── the reconnect, pure ──────────────────────────────────────────────────

-- What a window's answer means, `{act, reason}`: `go` (it ran its
-- length, curl's `--max-time`, code 28: listen on), `stop` (a refusal,
-- which no retry mends) or `reconnect` (anything else, an outage).
-- `status` is curl's `%{http_code}`, "000" when nothing answered.
function after_window(status, code)
  if status == "401" or status == "403" then
    return {act = "stop", reason = "the stream answered " .. status .. ": the key refused (revoked or wrong)"}
  end
  if status == "404" then
    return {act = "stop", reason = "the stream answered 404: no such conversation, or not the agent's"}
  end
  if status == "200" then
    if code == 28 then return {act = "go", reason = ""} end
    if code == 0 then return {act = "reconnect", reason = "the server ended the stream"} end
    return {act = "reconnect", reason = "curl exited " .. code .. " mid-stream"}
  end
  if status == "000" or status == "" then
    return {act = "reconnect", reason = "no connection (curl exited " .. code .. ")"}
  end
  return {act = "reconnect", reason = "the stream answered " .. status}
end

-- Seconds to wait before the `n`th reconnect in a row.
function backoff_s(n)
  if n <= 1 then return 2 end
  if n == 2 then return 5 end
  if n == 3 then return 15 end
  if n == 4 then return 30 end
  return 60
end

-- The `after=` a caller goes on from: the last id seen, or the one it
-- gave if nothing newer came.
function resume_id(state)
  if state.last > state.after then return state.last end
  return state.after
end

-- ── the batches, pure ────────────────────────────────────────────────────

-- What a batch's end means, `{act, lines, after, reason}`, from `run`'s
-- answer (`code`, `ended`, `out`): `lines` are the batch's own (posts,
-- `budget:` and reconnect lines), to pass through; `act` is `done` (a
-- post heard with `once`), `next` (its curls spent: go on from `after`)
-- or `stop` (its own stop, a refusal or a gap, or an end that is none of
-- these, so a broken batch never loops quietly).
function after_batch(r, once)
  local out = {}
  local after = ""
  local stopped = ""
  local post = false
  -- Shale's footers (`── time:`, `── used:`, a stop's `called from`)
  -- end a run, and a footer can run over lines; only `── budgets` comes
  -- first.
  local footer = false
  for l in lines(r.out) do
    if starts_with(l, "──") and not starts_with(l, "── budgets") then
      footer = true
      local at = find(l, ": fail: ")
      if starts_with(l, "── stopped at ") then
        if at ~= nil then stopped = sub(l, at + 8) else stopped = l end
      end
    elseif footer or starts_with(l, "──") then
      -- not the batch's
    elseif starts_with(l, SPENT) then
      after = sub(l, #SPENT + 1)
    elseif l ~= "" then
      push(out, l)
      if starts_with(l, "#") then post = true end
    end
  end
  if stopped ~= "" then
    -- The stop's own step count is the child's, not the line's.
    local m = re_find(stopped, " \\([0-9]+ steps\\)$")
    if m ~= nil then stopped = sub(stopped, 1, m.at - 1) end
  end
  if r.ended ~= "exit" then
    return {act = "stop", lines = out, after = "", reason = "listen: a batch ended by " .. r.ended .. ", not by itself"}
  end
  if r.code ~= 0 then
    if stopped == "" then stopped = "listen: a batch exited " .. r.code .. " naming no stop" end
    return {act = "stop", lines = out, after = "", reason = stopped}
  end
  if once and post then return {act = "done", lines = out, after = "", reason = ""} end
  if re_find(after, "^[0-9]+$") ~= nil then return {act = "next", lines = out, after = after, reason = ""} end
  return {act = "stop", lines = out, after = "", reason = "listen: a batch exited 0 with no post and no `" .. SPENT .. "<id>` line"}
end

-- ── the frames, pure ─────────────────────────────────────────────────────

function new_state(me, after, conv)
  return {me = me, after = after, conv = conv, last = 0, seen = {}, mine_ats = {}, newest = 0, warned = false}
end

-- The whole frames of a stretch of the stream, each `{event, id, data}`:
-- a frame ends at a blank line, so the last piece, cut by the window or
-- empty, is left for the next window to bring again; `: ping` and other
-- comment lines are none.
function frames(text)
  local got = {}
  local pieces = split(text, "\n\n")
  for k = 1, #pieces - 1 do
    local f = {event = "message", id = "", data = {}}
    local any = false
    for l in lines(pieces[k]) do
      if starts_with(l, "event: ") then
        f.event = sub(l, 8)
        any = true
      elseif starts_with(l, "id: ") then
        f.id = sub(l, 5)
        any = true
      elseif starts_with(l, "data: ") then
        push(f.data, sub(l, 7))
        any = true
      end
    end
    if any then push(got, {event = f.event, id = f.id, data = join(f.data, "\n")}) end
  end
  return got
end

-- A stretch of the stream into `state`: `{lines, warns, err}`, each line a
-- post for the agent past `after`, each warn a budget crossing, `err` a gap's account or a message's without
-- `mentions`, each ending where `after=` goes on. A post seen before
-- (a window that brings one again) is not printed twice.
function consume(state, text)
  local out = {}
  local warns = {}
  for f in frames(text) do
    if f.event == "gap" then
      return {lines = out, warns = warns, err = "a gap: posts before " .. get(json_read(f.data), "before", "?") .. " are past the backlog; read them with GET /conversations/<id>?before= and start again with after="}
    end
    if f.event == "message" then
      local msg = json_read(f.data)
      if not has_key(msg, "mentions") then
        return {lines = out, warns = warns, err = "the server sent no mentions with #" .. msg.id .. ": is it a roc-chat older than 2026-10-30, when every message began to carry them? Who a post names is the server's to say, never guessed here; with a server that sends them, go on with after="}
      end
      local key = tostring(msg.id)
      if not has_key(state.seen, key) then
        state.seen[key] = true
        local mine = for_me(msg, state.me)
        if msg.at > state.newest then state.newest = msg.at end
        if starts_with(msg.by, "human:") then
          state.mine_ats = {}
        elseif msg.by == state.me and agent_to_agent(msg) then
          push(state.mine_ats, msg.at)
        end
        local used = budget_used(state.mine_ats, state.newest)
        if used >= WARN_AT and not state.warned then
          push(warns, "budget: " .. used .. " of " .. AGENT_POSTS_MOST .. " agent-to-agent posts this hour; ask a human to post in conversation " .. state.conv .. " to reset it")
        end
        state.warned = used >= WARN_AT
        if msg.id > state.last then state.last = msg.id end
        if mine and msg.id > state.after then push(out, "#" .. msg.id .. " by " .. msg.by .. ": " .. first_line(msg.markdown)) end
      end
    end
  end
  return {lines = out, warns = warns, err = ""}
end

-- ── the self-test ────────────────────────────────────────────────────────

const PLANTS = "cookbook:plants/listen"

function expect(tally, cond, what)
  if cond then print("ok   " .. what) else print("FAIL " .. what); tally.bad = tally.bad + 1 end
  return nil
end

-- The windows in order, each a plant file, through one state.
function replay(files, after)
  local state = new_state("agent:2", after, "3")
  local all = {}
  local warns = {}
  for f in files do
    local r = consume(state, read(PLANTS .. "/" .. f))
    for l in r.lines do push(all, l) end
    for w in r.warns do push(warns, w) end
    if r.err ~= "" then return {lines = all, warns = warns, err = r.err, state = state} end
  end
  return {lines = all, warns = warns, err = "", state = state}
end

function self_test()
  local tally = {bad = 0}
  local two = replay({"backlog.sse", "live.sse"}, 0)
  expect(tally, two.err == "" and two.state.last == 9, "after two windows the last whole frame is #9, the cut #10 left for the next")
  local three = replay({"backlog.sse", "live.sse", "again.sse"}, 0)
  expect(tally, join(three.lines, " | ") == "#1 by human:7: @CC hi | #2 by agent:1: @CC can you look? | #4 by agent:1: @CC thanks | #5 by human:7: CC, one more thing | #8 by agent:1: @CC and a second | #10 by agent:1: @CC a third agent post in a row", "the three windows give #1, #2, #4, #5, #8 and #10, each once: " .. join(three.lines, " | "))
  expect(tally, three.err == "" and three.state.last == 10, "the third window brings #5 and #9 again and #10 whole")
  local resumed = replay({"backlog.sse", "live.sse", "again.sse"}, 5)
  expect(tally, join(resumed.lines, " | ") == "#8 by agent:1: @CC and a second | #10 by agent:1: @CC a third agent post in a row", "after=5 gives #8 and #10: " .. join(resumed.lines, " | "))
  local gap = replay({"gap.sse"}, 0)
  expect(tally, gap.err ~= "" and contains(gap.err, "posts before 40") and #gap.lines == 0, "a gap is an error, named")
  local served = replay({"served.sse"}, 0)
  expect(tally, join(served.lines, " | ") == "#2 by human:7: the server says this one names CC", "the server's mentions decide, over the markdown: " .. join(served.lines, " | "))
  local status = replay({"status.sse"}, 0)
  expect(tally, join(status.lines, " | ") == "#4 by agent:1: @CC a question, after two status posts", "the agent's own posts are not heard, even naming it; the question after them is: " .. join(status.lines, " | "))
  local unserved = replay({"unserved.sse"}, 0)
  expect(tally, contains(unserved.err, "the server sent no mentions with #2") and join(unserved.lines, " | ") == "#1 by human:7: @CC first" and unserved.state.last == 1, "a message without mentions stops the run, named, after the posts before it: " .. unserved.err)
  local tenth = replay({"tenth.sse"}, 0)
  expect(tally, #tenth.lines == 10 and tenth.lines[10] == "#19 by agent:1: @CC tenth", "an agent's tenth mention in a row, answered by the agent each time, is still heard: " .. join(tenth.lines, " | "))
  local warn = replay({"budget_warn.sse"}, 0)
  expect(tally, join(warn.warns, " | ") == "budget: 12 of 15 agent-to-agent posts this hour; ask a human to post in conversation 3 to reset it", "twelve of the agent's agent-to-agent posts in the hour warn once, the thirteenth not again: " .. join(warn.warns, " | "))
  local reset = replay({"budget_reset.sse"}, 0)
  expect(tally, #reset.warns == 0, "a human post after eleven starts the count again, so eleven more warn nothing: " .. join(reset.warns, " | "))
  local old = replay({"budget_old.sse"}, 0)
  expect(tally, #old.warns == 0, "posts older than the hour count for nothing: " .. join(old.warns, " | "))
  local quiet = replay({"pings.sse"}, 0)
  expect(tally, #quiet.lines == 0 and quiet.state.last == 0, "pings alone are nothing")
  for s in {"401", "403", "404"} do
    local d = after_window(s, 0)
    expect(tally, d.act == "stop" and contains(d.reason, s), "a " .. s .. " stops the run, naming it: " .. d.reason)
  end
  local full = after_window("200", 28)
  expect(tally, full.act == "go", "a window that ran its length (200, curl 28) listens on")
  local ended = after_window("200", 0)
  expect(tally, ended.act == "reconnect" and ended.reason == "the server ended the stream", "a stream the server ended (200, curl 0) reconnects: " .. ended.reason)
  local cut = after_window("200", 56)
  expect(tally, cut.act == "reconnect" and contains(cut.reason, "56"), "curl failing mid-stream reconnects: " .. cut.reason)
  local down = after_window("000", 7)
  expect(tally, down.act == "reconnect" and contains(down.reason, "no connection"), "no connection (000, curl 7) reconnects: " .. down.reason)
  local slow = after_window("000", 28)
  expect(tally, slow.act == "reconnect", "nothing answering within the window (000, curl 28) reconnects, never a go")
  for s in {"500", "502", "503", "504", "429", "400", "410"} do
    expect(tally, after_window(s, 0).act == "reconnect", "a " .. s .. " is no refusal: it reconnects")
  end
  local waits = {}
  for n = 1, 7 do push(waits, tostring(backoff_s(n))) end
  expect(tally, join(waits, " ") == "2 5 15 30 60 60 60", "the waits back off 2, 5, 15, 30, then 60 s: " .. join(waits, " "))
  expect(tally, resume_id(new_state("agent:2", 12, "3")) == 12 and resume_id(three.state) == 10, "a reconnect goes on from the after= given until a newer id is seen")
  local heard_once = after_batch({code = 0, ended = "exit", out = "reconnecting after the server ended the stream, from after=7, in 2 s\nbudget: 12 of 15 agent-to-agent posts this hour; ask a human\n#9 by human:7: @CC hi\n── time: 4 s\n"}, true)
  expect(tally, heard_once.act == "done" and join(heard_once.lines, " | ") == "reconnecting after the server ended the stream, from after=7, in 2 s | budget: 12 of 15 agent-to-agent posts this hour; ask a human | #9 by human:7: @CC hi", "a batch that heard a post with once=1 is done, its lines passed through, the footer not: " .. join(heard_once.lines, " | "))
  local refused = after_batch({code = 1, ended = "exit", out = "reconnecting after no connection (curl exited 7), from after=7, in 2 s\n── stopped at cookbook:listen.shale:470:43: fail: listen: the stream answered 401: the key refused (revoked or wrong); nothing to retry (812 steps)\n── used: 812 of 200000000 steps\n"}, true)
  expect(tally, refused.act == "stop" and refused.reason == "listen: the stream answered 401: the key refused (revoked or wrong); nothing to retry" and #refused.lines == 1, "a batch's refusal stops the parent with the batch's own line: " .. refused.reason)
  local spent = after_batch({code = 0, ended = "exit", out = "reconnecting after the stream answered 502, from after=12, in 2 s\n" .. SPENT .. "12\n── time: 1260 s\n"}, true)
  expect(tally, spent.act == "next" and spent.after == "12" and join(spent.lines, " | ") == "reconnecting after the stream answered 502, from after=12, in 2 s", "a batch with its curls spent starts the next from its id, the spent line not passed through: " .. spent.after)
  local logged = after_batch({code = 0, ended = "exit", out = "#9 by human:7: @CC hi\n" .. SPENT .. "9\n"}, false)
  expect(tally, logged.act == "next" and logged.after == "9" and logged.lines[1] == "#9 by human:7: @CC hi", "without once=1 a post heard is passed through and the next batch goes on from its id")
  local wrapped = after_batch({code = 0, ended = "exit", out = "── budgets from the script's header: steps=200000000\n#9 by human:7: @CC hi\n── time: 5 programs, 10.1 s in all; the slowest 2.0 s: curl -sN -w\n%{http_code} --variable; slept 2.0 s\n   called from x\n"}, true)
  expect(tally, wrapped.act == "done" and join(wrapped.lines, " | ") == "#9 by human:7: @CC hi", "the budgets header and a footer running over lines are not the batch's: " .. join(wrapped.lines, " | "))
  local silent = after_batch({code = 0, ended = "exit", out = "reconnecting after the server ended the stream, from after=3, in 2 s\n"}, true)
  expect(tally, silent.act == "stop" and contains(silent.reason, "no post and no"), "a batch that exits 0 with neither a post nor a spent line stops, never loops: " .. silent.reason)
  local bare = after_batch({code = 0, ended = "exit", out = ""}, false)
  expect(tally, bare.act == "stop", "a batch with no output at all stops")
  local crashed = after_batch({code = 2, ended = "exit", out = "shale: cookbook:nope.shale: not found\n"}, true)
  expect(tally, crashed.act == "stop" and contains(crashed.reason, "exited 2") and crashed.lines[1] == "shale: cookbook:nope.shale: not found", "a batch that dies naming no stop stops the parent with its code, its output passed through: " .. crashed.reason)
  local killed = after_batch({code = 0, ended = "timeout", out = SPENT .. "4\n"}, true)
  expect(tally, killed.act == "stop" and contains(killed.reason, "timeout"), "a batch ended by its timeout stops, even with a spent line: " .. killed.reason)
  local junk = after_batch({code = 0, ended = "exit", out = SPENT .. "x\n"}, true)
  expect(tally, junk.act == "stop", "a spent line whose id is no number stops")
  if tally.bad > 0 then fail("listen: self-test: " .. tally.bad .. " failed") end
  print("listen self_test: PASS (own posts and pings give none, an agent's every mention is heard, the server's mentions decide, a message without them stops the run, after= and a repeated window print nothing twice, a gap is named, the budget warns once at 12 in the hour since a human spoke, 401, 403 and 404 stop, an ended stream, no connection and every other status reconnect, backing off 2 to 60 s, and a batch heard, refused, spent or broken each decides the caller: done, stop, the next batch, stop)")
end

-- ── the live path ────────────────────────────────────────────────────────

function heard(l)
  print(l)
  if LOG ~= "" then append(LOG, l .. "\n") end
  return nil
end

function needed()
  if SITE == "" or CONV == "" or ME == "" or KEY == "" then
    fail("listen: site=, conv=, me= and key=keys:<file> are each needed")
  end
  if not ONCE and LOG == "" then fail("listen: without once=1, log= is needed: a run's output shows only when it ends, and the lines are appended there as they are heard") end
  return nil
end

-- One batch: its windows, until a post with `once`, a stop, or its curls
-- spent, which it ends with the `SPENT` line.
function listen()
  needed()
  local state = new_state(ME, AFTER, CONV)
  -- Reconnects in a row, since the last window that ran its length.
  local tries = 0
  for w = 1, WINDOWS_MOST do
    local argv = {"curl", "-sN", "--max-time", tostring(WINDOW_S), "-w", "\\n%{http_code}",
      "--variable", "%LISTEN_KEY", "--expand-header", "Authorization: Bearer {{LISTEN_KEY:trim}}"}
    if state.last > 0 then
      push(argv, "-H")
      push(argv, "Last-Event-ID: " .. state.last)
    end
    push(argv, SITE .. "/conversations/" .. CONV .. "/stream")
    local r = run(argv, {timeout_ms = (WINDOW_S + 30) * 1000, whole = 16777216, secrets = {LISTEN_KEY = KEY}})
    local cut = #r.out
    while cut > 0 and sub(r.out, cut, cut) ~= "\n" do cut = cut - 1 end
    local status = sub(r.out, cut + 1)
    local next = after_window(status, r.code)
    if next.act == "stop" then fail("listen: " .. next.reason .. "; nothing to retry") end
    if status == "200" then
      local got = consume(state, sub(r.out, 1, cut - 1))
      for w in got.warns do heard(w) end
      for l in got.lines do
        heard(l)
        if ONCE then return nil end
      end
      if got.err ~= "" then fail("listen: " .. got.err .. resume_id(state)) end
    end
    if next.act == "go" then
      tries = 0
    elseif w < WINDOWS_MOST then
      tries = tries + 1
      heard("reconnecting after " .. next.reason .. ", from after=" .. resume_id(state) .. ", in " .. backoff_s(tries) .. " s")
      sleep(backoff_s(tries) * 1000)
    end
  end
  print(SPENT .. resume_id(state))
  return nil
end

-- The listener a caller starts: batches, each a child run of this script
-- with its own 64 programs, one of the parent's each.
function listen_batches()
  needed()
  if WINDOWS_MOST < 1 or WINDOWS_MOST > 63 then fail("listen: curls= is 1 to 63, a batch's programs") end
  local after = tostring(AFTER)
  for b = 1, BATCHES_MOST do
    local argv = {"shale", "--root", ".", SELF_PATH, "batch=1", "site=" .. SITE, "conv=" .. CONV, "me=" .. ME,
      "key=" .. KEY, "after=" .. after, "window=" .. WINDOW_S, "curls=" .. WINDOWS_MOST}
    if ONCE then push(argv, "once=1") end
    if LOG ~= "" then push(argv, "log=" .. LOG) end
    -- The longest a batch can take: each curl its window and slack, and
    -- the longest wait after it.
    local r = run(argv, {timeout_ms = WINDOWS_MOST * (WINDOW_S + 90) * 1000 + 60000, tail = 2000, width = 4096})
    local d = after_batch(r, ONCE)
    -- The batch wrote its lines to `log=` as it heard them.
    for l in d.lines do print(l) end
    if d.act == "done" then return nil end
    if d.act == "stop" then fail(d.reason) end
    after = d.after
  end
  fail("listen: " .. BATCHES_MOST .. " batches of " .. WINDOWS_MOST .. " curls, a run's programs spent; start it again with after=" .. after)
end

if SELF then self_test() elseif BATCH then listen() else listen_batches() end
