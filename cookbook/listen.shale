-- **A roc-chat CONVERSATION, LISTENED TO FOR ONE AGENT**: its stream
-- (`GET /conversations/<conv>/stream`), and one line a post that is for
-- the agent, `#<id> by <principal>: <its first line>`. The key stays in a
-- secrets mount: `run`'s `secrets` gives it to curl alone, which reads it
-- from its environment (`--variable`), so no script sees it.
--
--   shale cookbook:listen.shale site=https://chat.lynrummy.com conv=3 me=agent:2 key=keys:roc_chat_cc_key once=1
--   shale cookbook:listen.shale site=... conv=3 me=agent:2 key=keys:... log=listen.log after=12
--
-- **A POST IS FOR THE AGENT** when both hold (`for_me`, pure):
--   1. it is not the agent's own (`by` is not `me`);
--   2. it names the agent: the server's `mentions` holds `me`. The rule
--      of who a post names has one home, roc-chat's app/Mentions.roc
--      (words, skipping quoted and fenced text), so every listener agrees;
--      a message without `mentions` stops the run, named, never a guess.
-- There is no rule for agents answering agents: the roc-chat server
-- bounds agent-to-agent traffic, the one home of that limit, so an
-- agent's every mention is heard.
-- **THE BUDGET WARNING**: the server's limit is mirrored here (its numbers
-- below), so at 12 of 15 of the agent's own agent-to-agent posts this hour
-- one line, `budget: ...`, says so once a crossing, before any post heard
-- with it; it never ends a run, and goes to `log=` too.
-- `after=` is the last id already handled: nothing at or before it is
-- printed.
--
-- **HOW IT LISTENS**: a run's output reaches the terminal only when it
-- ends, and a run starts at most 64 programs, so the stream is held in
-- windows: one curl a window (`window=` seconds, 20 by default, under
-- curl's `--max-time`), the first with no `Last-Event-ID` (the newest page),
-- each after it resuming at the last whole frame. A post is heard at most
-- a window late.
--   - `once=1` prints the first post for the agent and exits 0: a detached
--     command that ends is what wakes a session on the box.
--   - Otherwise each line is appended to `log=` as it is heard (required),
--     for `tail -F` under a watcher, until the run's programs are spent; the
--     stop names the `after=` to go on from.
-- **A DEAD LISTENER IS NEVER QUIET**: the key refused (any status but
-- 200), the stream ended by the server, curl failing, a `gap` (more missed
-- than the backlog holds), a message without `mentions` (a server older
-- than them), or the windows spent each stop the run, named.
--
-- `self_test=1` feeds the recorded frames in `cookbook/plants/listen/`
-- through the same `consume` the live path uses: no roc-chat, no network.
--
-- budget: steps=200000000 arena_bytes=400000000

const SELF = arg("self_test", "") == "1"
const SITE = arg("site", "")
const CONV = arg("conv", "")
const ME = arg("me", "")
const KEY = arg("key", "")
const AFTER = tonumber(arg("after", "0"))
const ONCE = arg("once", "") == "1"
const LOG = arg("log", "")
const WINDOW_S = tonumber(arg("window", "20"))
-- Of a run's 64 programs, the windows take all but one, left spare.
const WINDOWS_MOST = 63
const LINE_MOST = 200
-- **roc-chat's agent-to-agent limit, mirrored**: an agent makes at most
-- AGENT_POSTS_MOST posts naming another agent in WINDOW_SECS, counting
-- only those since the last human post (a human post resets it). The
-- server enforces it; the listener warns at WARN_AT, before a refusal.
const AGENT_POSTS_MOST = 15
const WINDOW_SECS = 3600
const WARN_AT = 12

-- ── the decision, pure ───────────────────────────────────────────────────

function contains_item(list, x)
  for v in list do
    if v == x then return true end
  end
  return false
end

-- **WHO A POST NAMES**: the server's `mentions` (roc-chat's
-- app/Mentions.roc, the one home of the rule); `consume` has refused a
-- message without them.
function names(msg, id)
  return contains_item(msg.mentions, id)
end

-- Rules 1 and 2.
function for_me(msg, me)
  if msg.by == me then return false end
  return names(msg, me)
end

-- Whether `by` is an agent and the post names an agent not itself: one
-- of the agent-to-agent posts the server's limit counts.
function agent_to_agent(msg)
  if not starts_with(msg.by, "agent:") then return false end
  for m in msg.mentions do
    if m ~= msg.by and starts_with(m, "agent:") then return true end
  end
  return false
end

-- The agent's agent-to-agent posts within the hour before `newest`.
-- `at` is roc-chat's message time in seconds, and "now" is the newest
-- `at` seen, never the box's clock, so a replay counts as the live run
-- did.
function budget_used(ats, newest)
  local n = 0
  for t in ats do
    if t > newest - WINDOW_SECS then n = n + 1 end
  end
  return n
end

-- The post's first line with text, trimmed and cut.
function first_line(md)
  for l in lines(md) do
    local t = trim(l)
    if t ~= "" then
      if #t > LINE_MOST then return sub(t, 1, LINE_MOST) .. "..." end
      return t
    end
  end
  return ""
end

-- ── the frames, pure ─────────────────────────────────────────────────────

function new_state(me, after, conv)
  return {me = me, after = after, conv = conv, last = 0, seen = {}, mine_ats = {}, newest = 0, warned = false}
end

-- The whole frames of a stretch of the stream, each `{event, id, data}`:
-- a frame ends at a blank line, so the last piece, cut by the window or
-- empty, is left for the next window to bring again; `: ping` and other
-- comment lines are none.
function frames(text)
  local got = {}
  local pieces = split(text, "\n\n")
  for k = 1, #pieces - 1 do
    local f = {event = "message", id = "", data = {}}
    local any = false
    for l in lines(pieces[k]) do
      if starts_with(l, "event: ") then
        f.event = sub(l, 8)
        any = true
      elseif starts_with(l, "id: ") then
        f.id = sub(l, 5)
        any = true
      elseif starts_with(l, "data: ") then
        push(f.data, sub(l, 7))
        any = true
      end
    end
    if any then push(got, {event = f.event, id = f.id, data = join(f.data, "\n")}) end
  end
  return got
end

-- A stretch of the stream into `state`: `{lines, warns, err}`, each line a
-- post for the agent past `after`, each warn a budget crossing, `err` a gap's account or a message's without
-- `mentions`, each ending where `after=` goes on. A post seen before
-- (a window that brings one again) is not printed twice.
function consume(state, text)
  local out = {}
  local warns = {}
  for f in frames(text) do
    if f.event == "gap" then
      return {lines = out, warns = warns, err = "a gap: posts before " .. get(json_read(f.data), "before", "?") .. " are past the backlog; read them with GET /conversations/<id>?before= and start again with after="}
    end
    if f.event == "message" then
      local msg = json_read(f.data)
      if not has_key(msg, "mentions") then
        return {lines = out, warns = warns, err = "the server sent no mentions with #" .. msg.id .. ": is it a roc-chat older than 2026-10-30, when every message began to carry them? Who a post names is the server's to say, never guessed here; with a server that sends them, go on with after="}
      end
      local key = tostring(msg.id)
      if not has_key(state.seen, key) then
        state.seen[key] = true
        local mine = for_me(msg, state.me)
        if msg.at > state.newest then state.newest = msg.at end
        if starts_with(msg.by, "human:") then
          state.mine_ats = {}
        elseif msg.by == state.me and agent_to_agent(msg) then
          push(state.mine_ats, msg.at)
        end
        local used = budget_used(state.mine_ats, state.newest)
        if used >= WARN_AT and not state.warned then
          push(warns, "budget: " .. used .. " of " .. AGENT_POSTS_MOST .. " agent-to-agent posts this hour; ask a human to post in conversation " .. state.conv .. " to reset it")
        end
        state.warned = used >= WARN_AT
        if msg.id > state.last then state.last = msg.id end
        if mine and msg.id > state.after then push(out, "#" .. msg.id .. " by " .. msg.by .. ": " .. first_line(msg.markdown)) end
      end
    end
  end
  return {lines = out, warns = warns, err = ""}
end

-- ── the self-test ────────────────────────────────────────────────────────

const PLANTS = "cookbook:plants/listen"

function expect(tally, cond, what)
  if cond then print("ok   " .. what) else print("FAIL " .. what); tally.bad = tally.bad + 1 end
  return nil
end

-- The windows in order, each a plant file, through one state.
function replay(files, after)
  local state = new_state("agent:2", after, "3")
  local all = {}
  local warns = {}
  for f in files do
    local r = consume(state, read(PLANTS .. "/" .. f))
    for l in r.lines do push(all, l) end
    for w in r.warns do push(warns, w) end
    if r.err ~= "" then return {lines = all, warns = warns, err = r.err, state = state} end
  end
  return {lines = all, warns = warns, err = "", state = state}
end

function self_test()
  local tally = {bad = 0}
  local two = replay({"backlog.sse", "live.sse"}, 0)
  expect(tally, two.err == "" and two.state.last == 9, "after two windows the last whole frame is #9, the cut #10 left for the next")
  local three = replay({"backlog.sse", "live.sse", "again.sse"}, 0)
  expect(tally, join(three.lines, " | ") == "#1 by human:7: @CC hi | #2 by agent:1: @CC can you look? | #4 by agent:1: @CC thanks | #5 by human:7: CC, one more thing | #8 by agent:1: @CC and a second | #10 by agent:1: @CC a third agent post in a row", "the three windows give #1, #2, #4, #5, #8 and #10, each once: " .. join(three.lines, " | "))
  expect(tally, three.err == "" and three.state.last == 10, "the third window brings #5 and #9 again and #10 whole")
  local resumed = replay({"backlog.sse", "live.sse", "again.sse"}, 5)
  expect(tally, join(resumed.lines, " | ") == "#8 by agent:1: @CC and a second | #10 by agent:1: @CC a third agent post in a row", "after=5 gives #8 and #10: " .. join(resumed.lines, " | "))
  local gap = replay({"gap.sse"}, 0)
  expect(tally, gap.err ~= "" and contains(gap.err, "posts before 40") and #gap.lines == 0, "a gap is an error, named")
  local served = replay({"served.sse"}, 0)
  expect(tally, join(served.lines, " | ") == "#2 by human:7: the server says this one names CC", "the server's mentions decide, over the markdown: " .. join(served.lines, " | "))
  local status = replay({"status.sse"}, 0)
  expect(tally, join(status.lines, " | ") == "#4 by agent:1: @CC a question, after two status posts", "the agent's own posts are not heard, even naming it; the question after them is: " .. join(status.lines, " | "))
  local unserved = replay({"unserved.sse"}, 0)
  expect(tally, contains(unserved.err, "the server sent no mentions with #2") and join(unserved.lines, " | ") == "#1 by human:7: @CC first" and unserved.state.last == 1, "a message without mentions stops the run, named, after the posts before it: " .. unserved.err)
  local tenth = replay({"tenth.sse"}, 0)
  expect(tally, #tenth.lines == 10 and tenth.lines[10] == "#19 by agent:1: @CC tenth", "an agent's tenth mention in a row, answered by the agent each time, is still heard: " .. join(tenth.lines, " | "))
  local warn = replay({"budget_warn.sse"}, 0)
  expect(tally, join(warn.warns, " | ") == "budget: 12 of 15 agent-to-agent posts this hour; ask a human to post in conversation 3 to reset it", "twelve of the agent's agent-to-agent posts in the hour warn once, the thirteenth not again: " .. join(warn.warns, " | "))
  local reset = replay({"budget_reset.sse"}, 0)
  expect(tally, #reset.warns == 0, "a human post after eleven starts the count again, so eleven more warn nothing: " .. join(reset.warns, " | "))
  local old = replay({"budget_old.sse"}, 0)
  expect(tally, #old.warns == 0, "posts older than the hour count for nothing: " .. join(old.warns, " | "))
  local quiet = replay({"pings.sse"}, 0)
  expect(tally, #quiet.lines == 0 and quiet.state.last == 0, "pings alone are nothing")
  if tally.bad > 0 then fail("listen: self-test: " .. tally.bad .. " failed") end
  print("listen self_test: PASS (own posts and pings give none, an agent's every mention is heard, the server's mentions decide, a message without them stops the run, after= and a repeated window print nothing twice, a gap is named, the budget warns once at 12 in the hour since a human spoke)")
end

-- ── the live path ────────────────────────────────────────────────────────

function heard(l)
  print(l)
  if LOG ~= "" then append(LOG, l .. "\n") end
  return nil
end

function listen()
  if SITE == "" or CONV == "" or ME == "" or KEY == "" then
    fail("listen: site=, conv=, me= and key=keys:<file> are each needed")
  end
  if not ONCE and LOG == "" then fail("listen: without once=1, log= is needed: a run's output shows only when it ends, and the lines are appended there as they are heard") end
  local state = new_state(ME, AFTER, CONV)
  for w = 1, WINDOWS_MOST do
    local argv = {"curl", "-sN", "--max-time", tostring(WINDOW_S), "-w", "\n%{http_code}",
      "--variable", "%LISTEN_KEY", "--expand-header", "Authorization: Bearer {{LISTEN_KEY:trim}}"}
    if state.last > 0 then
      push(argv, "-H")
      push(argv, "Last-Event-ID: " .. state.last)
    end
    push(argv, SITE .. "/conversations/" .. CONV .. "/stream")
    local r = run(argv, {timeout_ms = (WINDOW_S + 30) * 1000, whole = 16777216, secrets = {LISTEN_KEY = KEY}})
    local cut = #r.out
    while cut > 0 and sub(r.out, cut, cut) ~= "\n" do cut = cut - 1 end
    local status = sub(r.out, cut + 1)
    if status ~= "200" then fail("listen: the stream answered " .. status .. " (curl exited " .. r.code .. "): the key refused, or the conversation not the agent's") end
    local got = consume(state, sub(r.out, 1, cut - 1))
    for w in got.warns do heard(w) end
    for l in got.lines do
      heard(l)
      if ONCE then return nil end
    end
    if got.err ~= "" then fail("listen: " .. got.err .. state.last) end
    if r.code == 0 then fail("listen: the server ended the stream; go on with after=" .. state.last) end
    if r.code ~= 28 then fail("listen: curl exited " .. r.code .. "; go on with after=" .. state.last) end
  end
  fail("listen: " .. WINDOWS_MOST .. " windows, a run's programs spent; go on with after=" .. state.last)
end

if SELF then self_test() else listen() end
