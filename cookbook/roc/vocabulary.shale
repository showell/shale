-- This recipe holds a project to the words it has decided on. The project
-- keeps a file of them, and the recipe reports each identifier and comment
-- in its .roc files that uses a word the file retires. The word lists belong
-- to the project, so none is built in here.
--
--   cd <repo> && shale <shale>/cookbook/roc/vocabulary.shale words=vocabulary.txt
--   shale cookbook:roc/vocabulary.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default;
--   words      the project's file of decided words, which must be given;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/vocabulary/`.
--
-- Each line of the words file is `kept: retired, retired`, in lower case,
-- such as `lean: tilt`. A blank line or one starting with `#` is skipped.
-- The file is matched by whole words, so a plural that should go needs its
-- own entry, and a word with a good second meaning can't be listed at all.
-- A malformed line stops the run, as does a word retired twice or a word
-- both kept and retired.
--
-- Identifiers are read from the tree of Roc's own parser and split into words
-- at underscores and capitals, so `TiltStep` and `tilt_step` both hold
-- `tilt`. Comments are read as words too, and the text of a string doesn't
-- count. There are two checks, one for each place a word can be:
--
--   retired_name     an identifier that holds a retired word;
--   retired_comment  a comment that holds one.
--
-- The output is the counts, one line per finding,
-- `path:line: retired_name: tilt_step: tilt is lean here`, and the counts
-- again (cookbook/roc/findings.shale). Each word is reported once a line for
-- each name that holds it. The run fails if there are findings, or if any
-- file doesn't parse, and the files that do parse are judged either way.
-- budget: steps=800000000 arena_bytes=2000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const GLOB = arg("glob", "**/*.roc")
const WORDS_FILE = arg("words", "")
use("cookbook:roc/declared.shale")
use("cookbook:roc/findings.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/gate_recipe.shale")
const CHECKS = {"retired_name", "retired_comment"}

-- Which attribute holds the identifier in each kind of node that has one. A
-- `field` node may hold a field's name under either attribute.
const IDENTIFIER_ATTRIBUTES = {
  ty = {"name"},
  ["ty-var"] = {"raw"},
  ["e-ident"] = {"raw"},
  ["p-ident"] = {"raw"},
  ["e-tag"] = {"raw"},
  ["p-tag"] = {"raw"},
  ["s-type-anno"] = {"name"},
  ["s-import"] = {"raw"},
  ["s-var"] = {"name"},
  ["anno-record-field"] = {"name"},
  ["record-field"] = {"name"},
  header = {"name"},
  field = {"field", "name"},
  segment = {"field"},
  ["e-method-call"] = {"method"},
  ["p-list-rest"] = {"name"},
  ["exposed-upper-ident"] = {"text"},
}

-- The words file as a map from each retired word to the word kept for it.
function retired_words(path)
  if not exists(path) then fail("vocabulary: no words file " .. path) end
  local kept_by_retired = {}
  local kept_words = {}
  local number = 0
  for raw in lines(read(path)) do
    number = number + 1
    local l = trim(raw)
    if l ~= "" and not starts_with(l, "#") then
      local m = re_find(l, "^([a-z0-9]+): *([a-z0-9]+(?:, *[a-z0-9]+)*)$")
      if m == nil then fail("vocabulary: " .. path .. ":" .. number .. ": expected `kept: retired, retired`, in lower case") end
      kept_words[m.groups[1]] = true
      for retired in split(m.groups[2], ",") do
        local word = trim(retired)
        if has_key(kept_by_retired, word) then fail("vocabulary: " .. path .. ":" .. number .. ": `" .. word .. "` is retired twice") end
        kept_by_retired[word] = m.groups[1]
      end
    end
  end
  for word in keys(kept_by_retired) do
    if has_key(kept_words, word) then fail("vocabulary: " .. path .. ": `" .. word .. "` is both kept and retired") end
  end
  return kept_by_retired
end

-- The line of node `at`, or of the nearest node around it that has one.
function node_line(tree, at)
  local k = at
  while k ~= 0 and tree[k].line == 0 do k = tree[k].parent end
  return k == 0 and 0 or tree[k].line
end

-- Each retired word in `text`, once, as the words of the names in it.
function retired_in(text, kept_by_retired)
  local found = {}
  for m in re_find_all(text, "[A-Za-z0-9_]+") do
    for w in name_words(m.text) do
      if has_key(kept_by_retired, w) then found[w] = true end
    end
  end
  return sort(keys(found))
end

function judge_names(f, kept_by_retired, report)
  local tree = f.nodes
  local seen = {}
  for i = 1, #tree do
    for name_attribute in get(IDENTIFIER_ATTRIBUTES, tree[i].kind, {}) do
      local name = attribute(tree, i, name_attribute)
      if name ~= "" then
        for w in retired_in(name, kept_by_retired) do
          local line = node_line(tree, i)
          local key = line .. "|" .. name .. "|" .. w
          if not has_key(seen, key) then
            seen[key] = true
            push(report, {path = f.path, line = line, check = "retired_name", what = name .. ": " .. w .. " is " .. kept_by_retired[w] .. " here"})
          end
        end
      end
    end
  end
  return nil
end

function judge_comments(f, kept_by_retired, report)
  local number = 0
  for l in lines(read(f.path)) do
    number = number + 1
    local comment = comment_on_line(l)
    if comment ~= nil then
      for w in retired_in(comment, kept_by_retired) do
        push(report, {path = f.path, line = number, check = "retired_comment", what = w .. " is " .. kept_by_retired[w] .. " here"})
      end
    end
  end
  return nil
end

function self_test()
  local at = "cookbook:roc/plants/vocabulary/"
  local words = "words=" .. at .. "words.txt"
  check_plants("vocabulary", "cookbook:roc/vocabulary.shale", CHECKS, {
    {glob = at .. "names.roc", args = {words}, counts = {retired_name = 9}, says = {"names.roc:6: retired_name: tilt_step: tilt is lean here", "RideTour: tour is ride here", "names.roc:12: retired_name: tour_stops", "names.roc:16: retired_name: .tilt"}},
    {glob = at .. "comments.roc", args = {words}, counts = {retired_comment = 3}, says = {"comments.roc:2: retired_comment: tilt is lean here"}},
    {glob = at .. "clean.roc", args = {words}},
    {glob = at .. "broken/*.roc", args = {words}, stops = true, counts = {retired_name = 1}, says = {"refused: "}},
    {glob = at .. "clean.roc", stops = true, says = {"give words="}},
    {glob = at .. "clean.roc", args = {"words=" .. at .. "no_such.txt"}, stops = true, says = {"no words file"}},
    {glob = at .. "clean.roc", args = {"words=" .. at .. "words_malformed.txt"}, stops = true, says = {"words_malformed.txt:2: expected"}},
    {glob = at .. "clean.roc", args = {"words=" .. at .. "words_twice.txt"}, stops = true, says = {"`tilt` is retired twice"}},
    {glob = at .. "clean.roc", args = {"words=" .. at .. "words_both.txt"}, stops = true, says = {"`tilt` is both kept and retired"}},
  })
  return nil
end

function run_check()
  if WORDS_FILE == "" then fail("vocabulary: give words=<the project's file of decided words>") end
  local kept_by_retired = retired_words(WORDS_FILE)
  local paths = glob(GLOB)
  local parsed = parse_roc_files(paths)
  local report = {}
  for f in parsed.files do
    judge_names(f, kept_by_retired, report)
    judge_comments(f, kept_by_retired, report)
  end
  local verdict = verdict_of("vocabulary", CHECKS, report, #paths)
  print_findings(verdict.summary, verdict.found)
  fail_if_refused("vocabulary", parsed.refused)
  return verdict
end

-- This `fail` stands at the top level so the summary is the last line a
-- caller reads: a stop inside a function prints the calls after it.
if SELF_TEST then
  self_test()
else
  local verdict = run_check()
  if #verdict.found > 0 then fail(verdict.summary) end
end
