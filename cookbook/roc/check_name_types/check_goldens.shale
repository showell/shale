-- cookbook/roc/check_name_types/check_goldens.shale: check_name_types (the
-- Roc script beside this, check_name_types.roc, through its launcher
-- cookbook/roc/check_name_types.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/check_name_types/check_goldens.shale self_test=1
--   shale cookbook/roc/check_name_types/check_goldens.shale write=1
--
-- The cases are each plant row of the recipe's self-test (its glob and its
-- arguments), the plants all at once with each table, the quiet plants at
-- once, a glob that finds nothing, and `self_test=1`. The goldens were written from
-- the Shale original's output on them, and the port matched it on other
-- repositories' trees too (roc-chat, roc-apps, roc-screensaver, each without
-- a table and with a table of their words), which are left out because
-- their code moves. `write=1` writes the goldens again from the launcher, for
-- a change meant to move them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude
-- included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/roc/check_name_types.shale"
const GOLDENS = "cookbook/roc/check_name_types/goldens.txt"
const AT = "cookbook:roc/plants/check_name_types/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The plant rows, as `{glob, args}`: the self-test's, then the plants all at
-- once with each table.
const ROWS = {
  {glob = "name_type.roc", args = "table=" .. AT .. "table.txt"},
  {glob = "name_type.roc"},
  {glob = "quiet_name_type.roc", args = "table=" .. AT .. "table.txt"},
  {glob = "bare_beside_unit/*.roc"},
  {glob = "quiet_bare/*.roc"},
  {glob = "bare_any/*.roc"},
  {glob = "bare_any/*.roc", args = "table=" .. AT .. "table_any.txt"},
  {glob = "name_type.roc", args = "table=" .. AT .. "table_any.txt"},
  {glob = "no_value.roc"},
  {glob = "quiet_no_value.roc"},
  {glob = "broken/*.roc"},
  {glob = "quiet_name_type.roc", args = "table=" .. AT .. "no_such.txt"},
  {glob = "quiet_name_type.roc", args = "table=" .. AT .. "table_malformed.txt"},
  {glob = "quiet_name_type.roc", args = "table=" .. AT .. "table_twice.txt"},
  {glob = "**/*.roc"},
  {glob = "**/*.roc", args = "table=" .. AT .. "table.txt"},
  {glob = "**/*.roc", args = "table=" .. AT .. "table_any.txt"},
  {glob = "quiet_*.roc", args = "table=" .. AT .. "table.txt"},
  {glob = "nothing_here/*.roc"},
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: check_name_types: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- Each case, `{name, values}`: the values on the launcher's stdin.
function cases()
  local out = {}
  for row in ROWS do
    local values = "glob=" .. AT .. row.glob .. "\n"
    local name = row.glob
    if has_key(row, "args") then
      values = values .. row.args .. "\n"
      name = name .. " " .. row.args
    end
    push(out, {name = name, values = values})
  end
  push(out, {name = "self_test=1", values = "self_test=1\n"})
  return out
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = c.values, timeout_ms = 900000, whole = 8000000})
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
