# A plant for `stale_doc_name`: docs that name what is gone.
import QuietDocShelf

## Each stop at its cheapest place, as `cheapest_insert_by_building` does.
cheapest_insert : U64 -> U64
cheapest_insert = |number| number + QuietDocShelf.shelf_width

## As wide as `QuietDocShelf.shelf_height`.
# And `insert_best!`, gone too.
width : U64
width = 3
