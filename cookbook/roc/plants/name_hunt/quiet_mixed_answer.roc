## Quiet for name_hunt's `mixed_tense`: the domain's words for a state. An
## effect's answer, a record's field and a pure function's argument are
## never what an effect is told to do.
Answers := [].{
	Kind : [Redirect, Respond, Found, Held]

	serve_page! : Str => Kind

	Route : { tail : [Upload, Pin, Saved] }

	tail_name : [Upload, Pin, Saved] -> Str
}
