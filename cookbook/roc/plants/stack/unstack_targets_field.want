platform ""
	requires {
		step : U8 -> U8
	}
	exposes []
	packages {}
	provides { "s": host }
	targets: {
		x64musl: {
			inputs: ["crt1.o", "host.o", app, "libc.a", "libm.a", "libz.a"],
			output: Archive,
		},
		wasm32: {
			inputs: [app],
			output: Archive,
		},
	}

# `targets` is a keyword, so this longer name is a field like any other.
settings = { build_targets: { first: 1, second: 2 } }

host : U8 -> U8
host = |a| step(a)
