## Under the types (root TypedApp), with `peers=undo`: a method call of a
## symmetric function whose receiver and first argument are of one type
## turns back into a module call, `a.max(b)` to `U64.max(a, b)`: two Strs'
## `concat`, the app's own Hues' `max`, a Tint's `max` with a U64 (the
## alias read through), `map2` of two lists, and `bitwise_and`. Without
## it, each is a peer_receiver finding. Off the list, each method call
## stays: `xs.get(i)`, `xs.fold([], f)`, `a.starts_with(b)`, Hues'
## `relative` and Hues' `plus`.
import Hues

PeerMethods := [].{
	Tint : U64

	biggest : U64, U64 -> U64
	biggest = |a, b| U64.max(a, b)

	glued : Str, Str -> Str
	glued = |a, b| Str.concat(a, b)

	brighter : Hues, Hues -> Hues
	brighter = |a, b| Hues.max(a, b)

	tinted : Tint, U64 -> U64
	tinted = |tint, n| U64.max(tint, n)

	labels : List(U64), List(Str) -> List(Str)
	labels = |xs, ys| List.map2(xs, ys, |x, y| "${x.to_str()}${y}")

	masked : U64, U64 -> U64
	masked = |a, b| U64.bitwise_and(a, b)

	item : List(U64), U64 -> U64
	item = |xs, i| xs.get(i) ?? 0

	copied : List(U64) -> List(U64)
	copied = |xs| xs.fold([], |acc, x| acc.append(x))

	prefixed : Str, Str -> Bool
	prefixed = |a, b| a.starts_with(b)

	apart : Hues, Hues -> I64
	apart = |a, b| a.relative(b)

	mixed : Hues, Hues -> Hues
	mixed = |a, b| a.plus(b)
}

expect PeerMethods.biggest(1, 2) == 2
expect PeerMethods.glued("a", "b") == "ab"
expect PeerMethods.brighter(Hues.red, Hues.blue) == Hues.red
expect PeerMethods.tinted(3, 4) == 4
expect PeerMethods.labels([1], ["a"]) == ["1a"]
expect PeerMethods.masked(6, 3) == 2
expect PeerMethods.item([5], 0) == 5
expect PeerMethods.copied([5]) == [5]
expect PeerMethods.prefixed("ab", "a")
expect PeerMethods.apart(Hues.red, Hues.blue) == 2
expect PeerMethods.mixed(Hues.red, Hues.blue).relative(Hues.blue) == 3
