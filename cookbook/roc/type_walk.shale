-- This recipe prints a Roc module's types and every type they depend on,
-- the most primitive first, with no function bodies, so the types can be
-- reviewed on their own.
--
--   cd <repo> && shale <shale>/cookbook/roc/type_walk.shale module=Pigs
--   shale cookbook:roc/type_walk.shale self_test=1
--
-- The arguments:
--   module     the module to start from, read from `<root>/<module>.roc`;
--   root       the folder that holds it, `.` by default;
--   packages   where a package's modules are, as `lib=repos:roc-apps/lib`,
--              several separated by commas. Without it a package's folder is
--              read from the headers of the apps in the root folder, which
--              works only when that folder is under the root, so a package at
--              `../lib` needs this argument;
--   max_depth  how many steps from the module's own types to follow, 3 by
--              default (WALK_MAX_DEPTH). The module's types are at depth 0 and
--              the types they mention at depth 1. A type at the last depth is
--              printed, and the types it mentions that aren't printed anyway
--              are named in one line, not followed. A clear type reads from
--              its immediate children alone, which is depth 1;
--   full_depth the deepest depth printed in full, 1 by default
--              (WALK_FULL_DEPTH). A deeper type prints its header, doc and
--              definition, and its block's members as one line of names,
--              `.{ metres, to_metres, zero }`. It still counts and is followed
--              as before; only its printing is shorter;
--   stop       the hub types that are named but never expanded, comma
--              separated, WALK_STOP by default; `stop=` empty stops none. An
--              entry is a type's printed name, `Shapes.Shape`, or a module's
--              name and `.*`, `Brush.*`, for every type of that module. A
--              stopped type is named once, in the `# Stopped` line, is not
--              printed, and nothing it mentions is followed through it. The
--              asked module's own types are never stopped;
--   brief      the types printed by name and members alone at every depth,
--              even depth 1, comma separated, WALK_BRIEF by default; `brief=`
--              empty makes none brief. An entry is a type's printed name or
--              `Module.*`, as for `stop`, or `units`: every nominal type over
--              one builtin number with no type nested in its block, such as
--              `Distance :: F64.{ ... }` or `Steps :: U32.{ ... }`, found from
--              its declaration. The asked module's own types are never brief;
--   uses       with `uses=0`, leave out the outside uses of the asked module's
--              members (below);
--   named_by   with `named_by=0`, leave out the "named by" section (below);
--              with `named_by=production`, list only its untagged entries,
--              leaving out those tagged `(test)` or `(private)`;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/type_walk/`.
--
-- The types read are the type declarations at a file's top level and those
-- nested in a type's `.{ ... }` block. A type's members are the annotations
-- in its own block, in source order: its functions, whose type is written as
-- a function, and its constants, whose type is not, such as `count : I64`.
-- Each is printed as its doc and its annotation, with its body or value left
-- out, not written as `...`, and a constant's annotation ends in
-- `# constant`, so it reads as one even when its type is an alias. An
-- annotation whose whole type is `_` is left out, since it says nothing of
-- the type's surface. Values outside any block (a module's private helpers)
-- are left out, and so are the types only they mention.
--
-- Every type name in a printed definition or annotation is followed: a bare
-- name declared in the same file, a bare name that is an imported module's own
-- type (`Distance` after `import Distance`), and `Module.Type`. A tag's name is
-- not a type, but its payload is. Builtins (`Str`, `List`, `U32` and the rest)
-- are leaves, named in one line and not expanded. Type variables are not
-- followed; each is named with the types it appears in.
--
-- The types come out in topological order: a type before every type that
-- mentions it, its definition or its functions. Ties go by module, then by
-- name, and the asked-for module's types come last. Types that mention each
-- other form a cycle, which is reported in one line before its members; the
-- members then follow, by their definitions where those order them, else by
-- name. Each type has a header line with its name, file and line, then its
-- doc comment and its definition as written, and then its functions inside a
-- `.{ ... }`. The source's text is kept, re-indented.
--
-- A header line names the asked module's imports that hold no printed,
-- stopped or beyond-depth type, `# Imported but not in any printed type:
-- Camera, Screen`: modules its functions use only in their bodies (or in
-- annotations outside its types' blocks), which a reviewer should read too.
--
-- The other files are the root folder's other `.roc` files and those under
-- its `gates/` folder. A gates app's `import game.Geom` reads the package's
-- folder from that app's own header, unless `packages=` names it.
--
-- Each member of the asked module's types ends with its outside uses, `#
-- used by 3 files, 1 in tests only`, or `# no outside use` (after `#
-- constant;` on a constant). A file uses a member by naming it through its
-- import of the asked module, `Geom.ahead_point` or
-- `Geom.AheadPoint.at_height`, or by calling it, `point.at_height(h)`, or
-- through its operator, `a < b` for `is_lt`, on a receiver the file plainly
-- types as its type (walk_uses.shale says when). A call on a receiver of no
-- known type counts for every member of its name, and only in a file with no
-- use above: `; by method name in 2 more`, `; by operator, untyped, in 1
-- more`. A use is in tests when it sits in an `expect`, in a top-level value
-- that only expects use (directly or through other such values), or anywhere
-- in a file under a `gates/` folder; a file is "in tests only" when all its
-- uses of the member are. A header line lists the members no other file uses
-- or may use, `# Public, but used only in this file: near_plane_crossing,
-- AheadPoint.at_right`, a nested type's members named with their type.
--
-- After the types, the "named by" section lists every annotation, a
-- function's or a constant's, in a type's block or at the top level, and
-- every type definition, in the other files that mentions one of the asked
-- module's types, grouped by module, each as `file:line: ` and its text, a
-- member or nested type qualified by the type it sits in. An entry in tests,
-- by the rule above, is tagged `(test)` after its place, and a top-level
-- annotation that is not is tagged `(private)`, being a helper outside any
-- block. A mention counts when it resolves to the asked module's type as the
-- walk resolves names, through the file's import of the asked module,
-- qualified or bare, so another type of the same bare name does not. The last
-- line counts the types, functions, constants, modules, leaves, type
-- variables, types beyond the depth, stopped types, the members with no
-- outside use, the method calls and operators of their names typed and
-- pooled, and the annotations and types the "named by" section found,
-- all of them whatever `named_by=production` lists, split into production
-- (untagged or private) and test.
--
-- A name that resolves to no file or no type, or a file that doesn't parse,
-- is listed after the output, and the run then fails.
-- budget: steps=800000000 arena_bytes=2000000000 output_bytes=8000000

const SELF_TEST = arg("self_test", "") == "1"

-- How many steps from the module's own types the walk follows when
-- `max_depth=` doesn't say.
const WALK_MAX_DEPTH = 3

-- The deepest depth printed in full when `full_depth=` doesn't say.
const WALK_FULL_DEPTH = 1

-- The hub types named but never expanded when `stop=` doesn't say: types so
-- widely used that following them buries the module's own story.
const WALK_STOP = {"Shapes.Shape", "Brush.*", "World.Segment"}

-- The types printed by name and members alone at every depth when `brief=`
-- doesn't say: the plain unit wrappers, whose members are arithmetic a
-- reviewer reads past.
const WALK_BRIEF = {"units"}

-- The builtin numbers a unit wrapper may be a nominal type over.
const WALK_NUMBERS = {"F32", "F64", "Dec", "U8", "U16", "U32", "U64", "U128", "I8", "I16", "I32", "I64", "I128"}
use("cookbook:roc/declared.shale")
use("cookbook:roc/walk_uses.shale")

function path_join(dir, name)
  if dir == "" or dir == "." then return name end
  return dir .. "/" .. name
end

-- The type declaration's name with the names of the declarations it is
-- nested in: `Pigs.PigInterest`.
function qualified_name(tree, at)
  local parts = {get(tree[tree[at].kids[1]], "name", "")}
  local k = tree[at].parent
  while k ~= 0 do
    if tree[k].kind == "s-type-decl" then
      local name = get(tree[tree[k].kids[1]], "name", "")
      local grown = {name}
      for p in parts do push(grown, p) end
      parts = grown
    end
    k = tree[k].parent
  end
  return join(parts, ".")
end

-- The source between two places, a end column being one past the last
-- character, with each line after the first losing the first line's
-- indentation.
function source_text(src, line, col, end_line, end_col)
  local first = src[line]
  local indent = #first - #re_find(first, "^[ \t]*(.*)$").group
  if line == end_line then return {sub(first, col, end_col - 1)} end
  local out = {sub(first, col)}
  for l = line + 1, end_line do
    local text = l == end_line and sub(src[l], 1, end_col - 1) or src[l]
    local k = 1
    while k <= indent and k <= #text and (sub(text, k, k) == "\t" or sub(text, k, k) == " ") do k = k + 1 end
    push(out, sub(text, k))
  end
  return out
end

-- The comment lines directly above line `line`, trimmed, in order.
function doc_lines_above(src, line)
  local out = {}
  local k = line - 1
  while k >= 1 and starts_with(trim(src[k]), "#") do
    push(out, trim(src[k]))
    k = k - 1
  end
  local ordered = {}
  for i = #out, 1, -1 do push(ordered, out[i]) end
  return ordered
end

-- Each package's folder, from the `packages=` argument and the headers of
-- the apps directly in the root folder, as `{dir}` or `{err}`.
-- Roc's trees of the files `paths`, in order, as `roc_tree` gives them,
-- parsing only those not already in `trees` and keeping them there, so walks
-- that share `trees` parse a file once.
function parsed_files(trees, paths)
  local fresh = {}
  for p in paths do
    if not has_key(trees, p) then push(fresh, p) end
  end
  if #fresh > 0 then
    for f in roc_tree(fresh) do trees[f.path] = f end
  end
  local out = {}
  for p in paths do push(out, trees[p]) end
  return out
end

-- The packages an app's header names, from its tree, as `{name, raw}`, `raw`
-- being the path written for its main file.
function header_packages(tree)
  local out = {}
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "record-field" and n.parent ~= 0 and tree[n.parent].kind == "packages" then
      local raw = ""
      for j = i + 1, #tree do
        if tree[j].kind == "e-string-part" and tree[tree[j].parent].parent == i then raw = tree[j].raw end
      end
      push(out, {name = n.name, raw = raw})
    end
  end
  return out
end

function package_folders(root, given, trees)
  local out = {}
  local apps = {}
  for p in glob(path_join(root, "*.roc")) do
    for l in lines(read(p)) do
      if starts_with(l, "app [") or starts_with(l, "app[") then push(apps, p) end
    end
  end
  if #apps > 0 then
    for f in parsed_files(trees, apps) do
      if f.err == "" then
        for pkg in header_packages(f.nodes) do
          local dir = path_normal(path_join(root, dirname(pkg.raw)))
          local found = dir == nil and {err = "`" .. pkg.name .. "` is at `" .. dirname(pkg.raw) .. "` from the root, outside it: pass packages=" .. pkg.name .. "=<folder>, such as a repos: path"} or {dir = dir}
          if has_key(out, pkg.name) and get(out[pkg.name], "dir", "") ~= get(found, "dir", "") then
            found = {err = "the apps in the root give `" .. pkg.name .. "` two folders: pass packages=" .. pkg.name .. "=<folder>"}
          end
          out[pkg.name] = found
        end
      end
    end
  end
  if given ~= "" then
    for pair in split(given, ",") do
      local at = find(pair, "=")
      if at == nil then fail("type_walk: packages=: `" .. pair .. "` is no name=folder") end
      out[trim(sub(pair, 1, at - 1))] = {dir = trim(sub(pair, at + 1)), given = true}
    end
  end
  return out
end

-- The folder of each package the file's own app header names, where it lies
-- inside the root, unless `packages=` names that package: a gates app's
-- `game: "../game.roc"`.
function own_packages(st, tree, path)
  local out = {}
  for pkg in header_packages(tree) do
    local dir = path_normal(path_join(dirname(path), dirname(pkg.raw)))
    local given = get(get(st.packages, pkg.name, {}), "given", false)
    if dir ~= nil and not given then out[pkg.name] = {dir = dir} end
  end
  return out
end

-- Parses the files in `paths` not read before and records what each
-- declares and imports.
function load_files(st, paths)
  local fresh = {}
  for p in paths do
    if not has_key(st.files, p) then push(fresh, p) end
  end
  if #fresh == 0 then return nil end
  for f in parsed_files(st.trees, fresh) do
    if f.err ~= "" then
      st.files[f.path] = {path = f.path, err = f.err}
      if f.err ~= "no such file" then push(st.refused, f.path .. ": " .. f.err) end
    else
      local info = {path = f.path, err = "", module = module_name(f.path), nodes = f.nodes, src = split(read(f.path), "\n"), types = {}, imports = {}}
      local tree = f.nodes
      local own = own_packages(st, tree, f.path)
      for i = 1, #tree do
        local n = tree[i]
        if n.kind == "s-type-decl" and is_outer(tree, i) and get(tree[n.kids[1]], "name", "") ~= "" then
          local q = qualified_name(tree, i)
          local t = {id = f.path .. "#" .. q, path = f.path, module = info.module, qualified = q, name = last_part(q), at = i, line = n.line}
          push(info.types, t)
          st.types[t.id] = t
        end
        if n.kind == "s-import" and is_outer(tree, i) then
          local raw = get(n, "raw", "")
          local parts = split(raw, ".")
          local target = {}
          if #parts == 1 then
            target = {path = path_normal(path_join(dirname(f.path), raw .. ".roc"))}
          else
            local pkg = has_key(own, parts[1]) and own[parts[1]] or get(st.packages, parts[1], {err = "no app in the root names the package `" .. parts[1] .. "`: pass packages=" .. parts[1] .. "=<folder>"})
            if has_key(pkg, "err") then target = {err = pkg.err} else target = {path = path_join(pkg.dir, join(drop(parts, 1), "/") .. ".roc")} end
          end
          info.imports[parts[#parts]] = target
        end
      end
      st.files[f.path] = info
    end
  end
  return nil
end

-- The type names and type variables the type at node `at` mentions, pushed
-- onto `into` as `{name, line}` and `{var, line}`. A tag's name is skipped and
-- its payload read.
function mentions_in(tree, at, into)
  local n = tree[at]
  local parent_kind = n.parent ~= 0 and tree[n.parent].kind or ""
  if n.kind == "ty-var" then
    push(into, {var = get(n, "raw", ""), line = n.line})
    return into
  end
  if n.kind == "ty" then
    if parent_kind ~= "tags" and get(n, "name", "") ~= "" then push(into, {name = n.name, line = n.line}) end
    return into
  end
  local kids = n.kids
  local from = 1
  if n.kind == "ty-apply" and parent_kind == "tags" then from = 2 end
  for k = from, #kids do mentions_in(tree, kids[k], into) end
  return into
end

-- A type's name as printed: qualified by its module, or with the module
-- named after it when the type sits outside the module's own type.
function display_name(t)
  if t.qualified == t.module or starts_with(t.qualified, t.module .. ".") then return t.qualified end
  return t.qualified .. ", in module " .. t.module
end

function add_edge(st, from, to, in_definition)
  if from == to then return nil end
  local seen = st.dep_seen
  if not has_key(seen, from .. ">" .. to) then
    seen[from .. ">" .. to] = true
    push_at(st.deps, from, to)
  end
  if in_definition and not has_key(seen, from .. "=" .. to) then
    seen[from .. "=" .. to] = true
    push_at(st.def_deps, from, to)
  end
  return nil
end

-- Adds the type `id`, at `depth` steps from the module, to the next depth's
-- types, unless it is already read.
function enqueue(st, id, depth)
  if has_key(st.visited, id) then return nil end
  st.visited[id] = true
  st.depth_of[id] = depth
  push(st.next, id)
  return nil
end

-- Whether the list of type names `names` (a stop list or a brief list) holds
-- the type `t`: its printed name, or its module's name and `.*`.
function listed(names, t)
  local name = display_name(t)
  for s in names do
    if s == name or s == t.module .. ".*" then return true end
  end
  return false
end

-- A list of type names from `who=`'s comma-separated text: none for "".
function parse_type_list(text, who)
  local out = {}
  for part in split(text, ",") do
    local s = trim(part)
    if s ~= "" then
      if contains(s, "*") and not (ends_with(s, ".*") and #s > 2 and not contains(sub(s, 1, #s - 1), "*")) then fail("type_walk: " .. who .. "=: `" .. s .. "` is no type's name and no `Module.*`") end
      push(out, s)
    end
  end
  return out
end

-- The stop list from `stop=`'s text.
function parse_stops(text)
  return parse_type_list(text, "stop")
end

-- The brief list from `brief=`'s text, which may also hold `units`.
function parse_brief(text)
  return parse_type_list(text, "brief")
end

-- Whether the type `t` is a unit wrapper: a nominal type (`::`) over one
-- builtin number, with no type declared in its block.
function is_unit(st, t)
  local info = st.files[t.path]
  local tree = info.nodes
  local kids = tree[t.at].kids
  if #kids < 2 or tree[kids[2]].kind ~= "ty" or not has_item(WALK_NUMBERS, get(tree[kids[2]], "name", "")) then return false end
  local name_node = tree[kids[1]]
  local between = sub(info.src[name_node.end_line], name_node.end_col, name_node.end_col + 3)
  if not contains(between, "::") then return false end
  for k in kids do
    if tree[k].kind == "associated" then
      for m in tree[k].kids do
        if tree[m].kind == "s-type-decl" then return false end
      end
    end
  end
  return true
end

-- Whether the type `id` prints by name and members alone at every depth: it
-- is on the brief list, or a unit wrapper while the list holds `units`. The
-- asked module's own types never are.
function is_brief(st, id)
  if has_key(st.asked, id) then return false end
  local t = st.types[id]
  if listed(st.brief, t) then return true end
  return has_item(st.brief, "units") and is_unit(st, t)
end

-- Settles one mention of the type `m.from`: an edge, a leaf, a lost name, or
-- a wait for its file. A stopped type is named as stopped and gets no edge.
-- At the last depth a type not read already is named as beyond it, and gets
-- no edge, so it is not printed.
function settle(st, m)
  local info = st.files[st.types[m.from].path]
  local r = resolve(st, info, m.name)
  if r.kind == "need" then
    push(st.deferred, m)
    st.wanted[r.path] = true
  elseif r.kind == "type" then
    if not has_key(st.asked, r.id) and listed(st.stops, st.types[r.id]) then
      st.stopped[r.id] = true
    elseif st.depth < st.max_depth or has_key(st.visited, r.id) then
      add_edge(st, m.from, r.id, m.in_definition)
      enqueue(st, r.id, st.depth + 1)
    else
      st.beyond[r.id] = true
    end
  elseif r.kind == "leaf" then
    st.leaves[m.name] = true
  else
    push(st.lost, info.path .. ":" .. m.line .. ": `" .. m.name .. "`: " .. r.why)
  end
  return nil
end

function visit(st, id)
  local t = st.types[id]
  local info = st.files[t.path]
  local tree = info.nodes
  local kids = tree[t.at].kids
  local found = {}
  if #kids > 1 and tree[kids[2]].kind ~= "associated" then mentions_in(tree, kids[2], found) end
  local in_definition = #found
  for member in members_of(tree, t.at) do
    for k in tree[member.at].kids do mentions_in(tree, k, found) end
  end
  for i = 1, #found do
    local m = found[i]
    if has_key(m, "var") then
      if not has_key(st.vars, m.var) then st.vars[m.var] = {} end
      st.vars[m.var][display_name(t)] = true
    else
      settle(st, {from = id, name = m.name, line = m.line, in_definition = i <= in_definition})
    end
  end
  return nil
end

function sort_key(st, id)
  local t = st.types[id]
  return (has_key(st.asked, id) and "1" or "0") .. t.module .. "\t" .. t.qualified .. "\t" .. t.path
end

-- Tarjan's strongly connected components over `st.deps`.
function strong_connect(st, g, v)
  g.index[v] = g.counter
  g.low[v] = g.counter
  g.counter = g.counter + 1
  push(g.stack, v)
  g.on[v] = true
  for w in get(st.deps, v, {}) do
    if not has_key(g.index, w) then
      strong_connect(st, g, w)
      if g.low[w] < g.low[v] then g.low[v] = g.low[w] end
    elseif get(g.on, w, false) then
      if g.index[w] < g.low[v] then g.low[v] = g.index[w] end
    end
  end
  if g.low[v] == g.index[v] then
    local members = {}
    local done = false
    while not done do
      local w = g.stack[#g.stack]
      g.stack = take(g.stack, #g.stack - 1)
      g.on[w] = false
      push(members, w)
      done = w == v
    end
    push(g.components, members)
  end
  return nil
end

-- The id with the smallest sort key among `ids` that `is_ready` allows.
function smallest_ready(st, ids, is_ready)
  local best = nil
  local best_key = ""
  for id in ids do
    if is_ready[id] then
      local key = sort_key(st, id)
      if best == nil or key < best_key then
        best = id
        best_key = key
      end
    end
  end
  return best
end

-- A cycle's members, each after the members its definition mentions where
-- that orders them, else by sort key.
function order_in_cycle(st, members)
  local inside = set_of(members)
  local placed = {}
  local out = {}
  while #out < #members do
    local ready = {}
    local any = false
    for id in members do
      local ok = not has_key(placed, id)
      if ok then
        for w in get(st.def_deps, id, {}) do
          if has_key(inside, w) and not has_key(placed, w) then ok = false end
        end
      end
      ready[id] = ok
      if ok then any = true end
    end
    if not any then
      for id in members do ready[id] = not has_key(placed, id) end
    end
    local pick = smallest_ready(st, members, ready)
    placed[pick] = true
    push(out, pick)
  end
  return out
end

-- Every type read, in printing order, as `{id, cycle}` items, where an item
-- with `cycle` set is a cycle's report line, with its members.
function printing_order(st)
  local ids = sort(keys(st.visited))
  local g = {index = {}, low = {}, counter = 1, stack = {}, on = {}, components = {}}
  for id in ids do
    if not has_key(g.index, id) then strong_connect(st, g, id) end
  end
  local component_of = {}
  local key_of = {}
  for c = 1, #g.components do
    local best = ""
    for id in g.components[c] do
      component_of[id] = c
      local key = sort_key(st, id)
      if best == "" or key < best then best = key end
    end
    key_of[c] = best
  end
  local printed = {}
  for c = 1, #g.components do push(printed, false) end
  local out = {}
  local left = #g.components
  while left > 0 do
    local pick = 0
    for c = 1, #g.components do
      if not printed[c] and (pick == 0 or key_of[c] < key_of[pick]) then
        local ready = true
        for id in g.components[c] do
          for w in get(st.deps, id, {}) do
            if component_of[w] ~= c and not printed[component_of[w]] then ready = false end
          end
        end
        if ready then pick = c end
      end
    end
    printed[pick] = true
    left = left - 1
    local members = g.components[pick]
    if #members == 1 then
      push(out, {id = members[1]})
    else
      push(out, {cycle = members})
      for id in order_in_cycle(st, members) do push(out, {id = id}) end
    end
  end
  return out
end

-- Reads every file the files read import, and theirs, so a receiver's type
-- resolves when the uses are counted.
function load_imports(st)
  local more = true
  while more do
    local found = {}
    for p in keys(st.files) do
      local imports = get(st.files[p], "imports", {})
      for name in keys(imports) do
        local q = get(imports[name], "path", "")
        if q ~= "" and not has_key(st.files, q) then found[q] = true end
      end
    end
    load_files(st, sort(keys(found)))
    more = #keys(found) > 0
  end
  return nil
end

-- The root folder's other `.roc` files and those under its `gates/` folder,
-- read, with the asked file `start` left out.
function other_files(st, root, start)
  local paths = {}
  local found = {}
  for p in glob(path_join(root, "*.roc")) do push(found, p) end
  for p in glob(path_join(root, "gates/**/*.roc")) do push(found, p) end
  for p in sort(found) do
    if path_normal(p) ~= start then push(paths, path_normal(p)) end
  end
  load_files(st, paths)
  return paths
end

-- The lines printed for one type.
function type_lines(st, id)
  local t = st.types[id]
  local info = st.files[t.path]
  local tree = info.nodes
  local src = info.src
  local decl = tree[t.at]
  local out = {"", "#### " .. display_name(t) .. "   (" .. t.path .. ":" .. t.line .. ")"}
  local doc = doc_lines_above(src, decl.line)
  if #doc == 0 and t.qualified == t.module and tree[decl.parent].kind ~= "associated" then doc = opening_comment(src) end
  for l in doc do push(out, l) end
  local kids = decl.kids
  local last = (#kids > 1 and tree[kids[2]].kind ~= "associated") and tree[kids[2]] or tree[kids[1]]
  local definition = source_text(src, decl.line, decl.col, last.end_line, last.end_col)
  local members = members_of(tree, t.at)
  if #members == 0 then
    for l in definition do push(out, l) end
    return out
  end
  if st.depth_of[id] > st.full_depth or is_brief(st, id) then
    local names = {}
    for member in members do
      push(names, get(tree[member.at], "name", ""))
      if member.constant then st.constant_count = st.constant_count + 1 else st.function_count = st.function_count + 1 end
    end
    definition[#definition] = definition[#definition] .. ".{ " .. join(names, ", ") .. " }"
    for l in definition do push(out, l) end
    return out
  end
  definition[#definition] = definition[#definition] .. ".{"
  for l in definition do push(out, l) end
  for i = 1, #members do
    local f = tree[members[i].at]
    if i > 1 then push(out, "") end
    for l in doc_lines_above(src, f.line) do push(out, "\t" .. l) end
    local anno = source_text(src, f.line, f.col, f.end_line, f.end_col)
    local notes = {}
    if members[i].constant then
      push(notes, "constant")
      st.constant_count = st.constant_count + 1
    else
      st.function_count = st.function_count + 1
    end
    local key = id .. "\t" .. get(f, "name", "")
    if st.uses and has_key(st.member_rec, key) then push(notes, uses_note(st.member_rec[key])) end
    if #notes > 0 then anno[#anno] = anno[#anno] .. "   # " .. join(notes, "; ") end
    for l in anno do push(out, "\t" .. l) end
  end
  push(out, "}")
  return out
end

-- Whether a mention in `found`, from the file `info`, resolves to one of the
-- asked module's types. Only a name through the file's import of the asked
-- file `start` can, and it is then resolved as the walk resolves it, so a
-- bare name the file declares itself is its own. A name the import holds no
-- type of is lost.
function names_asked(st, info, found, start)
  local hit = false
  for m in found do
    if has_key(m, "name") then
      local parts = split(m.name, ".")
      local target = get(info.imports, parts[1], {})
      if get(target, "path", "") == start then
        local r = resolve(st, info, m.name)
        if r.kind == "type" and has_key(st.asked, r.id) then hit = true end
        if r.kind == "lost" then push(st.lost, info.path .. ":" .. m.line .. ": `" .. m.name .. "`: " .. r.why) end
      end
    end
  end
  return hit
end

-- The qualified name of the type declaration around node `at`, with a `.`
-- after it, or "" at the top level.
function owner_prefix(tree, at)
  local k = tree[at].parent
  while k ~= 0 do
    if tree[k].kind == "s-type-decl" then return qualified_name(tree, k) .. "." end
    k = tree[k].parent
  end
  return ""
end

-- The "named by" items of the file `info`, in line order, as `{lines,
-- is_type, tag}`: each type definition and annotation that mentions one of
-- the asked module's types. `tag` is `test` for one in tests (a gates app's,
-- or a top-level value's that only expects use), `private` for any other
-- top-level annotation, and "" otherwise.
function named_by_items(st, info, start)
  local out = {}
  local tree = info.nodes
  local fc = file_context(st, info)
  for i = 1, #tree do
    local n = tree[i]
    if is_outer(tree, i) then
      if n.kind == "s-type-decl" and #n.kids > 1 and tree[n.kids[2]].kind ~= "associated" then
        local name = get(tree[n.kids[1]], "name", "")
        if name ~= "" and names_asked(st, info, mentions_in(tree, n.kids[2], {}), start) then
          local last = tree[n.kids[2]]
          local text = source_text(info.src, n.line, n.col, last.end_line, last.end_col)
          text[1] = qualified_name(tree, i) .. sub(text[1], #name + 1)
          push(out, {lines = text, line = n.line, is_type = true, tag = fc.gates and "test" or ""})
        end
      end
      if n.kind == "s-type-anno" and #n.kids > 0 then
        local found = {}
        for k in n.kids do mentions_in(tree, k, found) end
        if names_asked(st, info, found, start) then
          local text = source_text(info.src, n.line, n.col, n.end_line, n.end_col)
          local owner = owner_prefix(tree, i)
          text[1] = owner .. text[1]
          local tag = ""
          if fc.gates or (owner == "" and has_key(fc.test_values, get(n, "name", ""))) then
            tag = "test"
          elseif owner == "" then
            tag = "private"
          end
          push(out, {lines = text, line = n.line, is_type = false, tag = tag})
        end
      end
    end
  end
  return out
end

-- The "named by" section for the asked module's file `start`, from the
-- other files `paths`, as `{lines, annotations, types, production, test}`.
-- With `production_only`, the entries tagged `test` or `private` are counted
-- but not listed.
function named_by(st, root, module, start, paths, production_only)
  local lines_out = {}
  local counts = {annotations = 0, types = 0, production = 0, test = 0, private = 0}
  local any = false
  for p in paths do
    local info = st.files[p]
    if info.err == "" then
      local shown = {}
      for item in named_by_items(st, info, start) do
        any = true
        if item.is_type then counts.types = counts.types + 1 else counts.annotations = counts.annotations + 1 end
        if item.tag == "test" then counts.test = counts.test + 1 else counts.production = counts.production + 1 end
        if item.tag == "private" then counts.private = counts.private + 1 end
        if not production_only or item.tag == "" then push(shown, item) end
      end
      if #shown > 0 then
        push(lines_out, "")
        push(lines_out, "### " .. info.module)
        for item in shown do
          local tag = item.tag == "" and "" or "(" .. item.tag .. ") "
          push(lines_out, info.path .. ":" .. item.line .. ": " .. tag .. item.lines[1])
          for l in drop(item.lines, 1) do push(lines_out, l) end
        end
      end
    end
  end
  local where = (root == "" or root == ".") and "the root folder" or root
  local head = not any and "# Named by: no annotation or type in the other modules of " .. where .. " mentions " .. module .. "'s types." or "# Named by: the annotations and types in the other modules of " .. where .. " that mention " .. module .. "'s types."
  if any and production_only then head = head .. " Production only: " .. counts.test .. " test and " .. counts.private .. " private entries left out." end
  local section = {"", head}
  for l in lines_out do push(section, l) end
  counts.lines = section
  return counts
end

-- The asked module's imports, by name, that hold no type the walk printed,
-- stopped or named beyond its depth.
function imports_not_printed(st, start)
  local seen = {}
  for id in keys(st.visited) do seen[st.types[id].path] = true end
  for id in keys(st.stopped) do seen[st.types[id].path] = true end
  for id in keys(st.beyond) do seen[st.types[id].path] = true end
  local out = {}
  local imports = st.files[start].imports
  for name in sort(keys(imports)) do
    if not has_key(seen, get(imports[name], "path", "")) then push(out, name) end
  end
  return out
end

-- Walks the module `module` in the folder `root`, `max_depth` steps from its
-- own types, and gives `{lines, lost, refused}`: the lines to print, the names
-- that resolve to nothing, and the files that don't parse. Each depth is
-- settled, files and all, before the next starts, so a type is read at the
-- fewest steps it is from the module. `settings` may hold `stops` (a list,
-- WALK_STOP unless given), `brief` (a list, WALK_BRIEF), `full_depth`
-- (WALK_FULL_DEPTH), `uses` (true), `named_by` (true) and
-- `named_by_production` (false), and `trees`, a map of parsed files that
-- walks may share (the self-test's do, to parse each plant once).
function walk(root, module, packages_arg, max_depth, settings?)
  local given = settings == nil and {} or settings
  local trees = get(given, "trees", {})
  local st = {files = {}, types = {}, trees = trees, packages = package_folders(root, packages_arg, trees), refused = {},lost = {}, leaves = {}, vars = {}, deps = {}, def_deps = {}, dep_seen = {}, visited = {}, depth_of = {}, asked = {}, next = {}, beyond = {}, stopped = {}, stops = get(given, "stops", WALK_STOP), brief = get(given, "brief", WALK_BRIEF), full_depth = get(given, "full_depth", WALK_FULL_DEPTH), uses = get(given, "uses", true), named_by = get(given, "named_by", true), depth = 0, max_depth = max_depth, deferred = {}, wanted = {}, function_count = 0, constant_count = 0, contexts = {}, typing = {}, resolved = {}, precision = {}, member_rec = {}, member_list = {}, members_by_name = {}}
  if module == "" then fail("type_walk: name the module to start from, as module=Pigs") end
  local start = path_normal(path_join(root, module .. ".roc"))
  if start == nil or not exists(start) then fail("type_walk: no file " .. path_join(root, module .. ".roc") .. " for module=" .. module) end
  load_files(st, {start})
  if st.files[start].err ~= "" then return {lines = {}, lost = {}, refused = st.refused} end
  for t in st.files[start].types do
    st.asked[t.id] = true
    enqueue(st, t.id, 0)
  end
  while #st.next > 0 do
    local these = st.next
    st.next = {}
    for id in these do visit(st, id) end
    while #st.deferred > 0 do
      load_files(st, sort(keys(st.wanted)))
      st.wanted = {}
      local again = st.deferred
      st.deferred = {}
      for m in again do settle(st, m) end
    end
    st.depth = st.depth + 1
  end
  local lines_out = {"# The types of " .. module .. " and every type they depend on, to depth " .. max_depth .. ", the most primitive first.", "# Builtin leaves, not expanded: " .. join(sort(keys(st.leaves)), ", ")}
  local stopped = {}
  for id in keys(st.stopped) do push(stopped, display_name(st.types[id])) end
  if #stopped > 0 then push(lines_out, "# Stopped, not expanded: " .. join(sort(stopped), "; ")) end
  local beyond = {}
  for id in keys(st.beyond) do push(beyond, display_name(st.types[id])) end
  if #beyond > 0 then push(lines_out, "# Beyond depth " .. max_depth .. ", not followed: " .. join(sort(beyond), "; ")) end
  local var_notes = {}
  for v in sort(keys(st.vars)) do push(var_notes, v .. " (" .. join(sort(keys(st.vars[v])), ", ") .. ")") end
  if #var_notes > 0 then push(lines_out, "# Type variables, not followed: " .. join(var_notes, "; ")) end
  local unprinted = imports_not_printed(st, start)
  if #unprinted > 0 then push(lines_out, "# Imported but not in any printed type: " .. join(unprinted, ", ")) end
  local briefs = {}
  for id in keys(st.visited) do
    if is_brief(st, id) and #members_of(st.files[st.types[id].path].nodes, st.types[id].at) > 0 then push(briefs, display_name(st.types[id])) end
  end
  if #briefs > 0 then push(lines_out, "# Brief, members by name at every depth: " .. join(sort(briefs), "; ")) end
  local paths = {}
  if st.uses or st.named_by then paths = other_files(st, root, start) end
  local unused = {}
  if st.uses then
    load_imports(st)
    asked_members(st, start)
    for p in paths do
      if st.files[p].err == "" then count_uses(st, st.files[p], start) end
    end
    unused = unused_members(st)
    if #unused > 0 then push(lines_out, "# Public, but used only in this file: " .. join(unused, ", ")) end
  end
  local modules = {}
  for item in printing_order(st) do
    if has_key(item, "cycle") then
      local names = {}
      for id in item.cycle do push(names, display_name(st.types[id])) end
      push(lines_out, "")
      push(lines_out, "# Cycle: these types mention each other: " .. join(sort(names), ", "))
    else
      modules[st.types[item.id].path] = true
      for l in type_lines(st, item.id) do push(lines_out, l) end
    end
  end
  local counts = "# " .. #keys(st.visited) .. " types, " .. st.function_count .. " functions, " .. st.constant_count .. " constants, " .. #keys(modules) .. " modules, " .. #keys(st.leaves) .. " leaves, " .. #keys(st.vars) .. " type variables, " .. #beyond .. " beyond depth " .. max_depth .. ", " .. #stopped .. " stopped"
  if st.uses then counts = counts .. ", " .. #unused .. " members with no outside use" .. precision_note(st) end
  if st.named_by then
    local section = named_by(st, root, module, start, paths, get(given, "named_by_production", false))
    for l in section.lines do push(lines_out, l) end
    counts = counts .. ", named by " .. section.annotations .. " annotations and " .. section.types .. " types: " .. section.production .. " production, " .. section.test .. " test"
  end
  push(lines_out, "")
  push(lines_out, counts)
  return {lines = lines_out, lost = st.lost, refused = st.refused}
end

function check(failures, ok, what)
  if not ok then push(failures, what) end
  return nil
end

function has_line(ls, line)
  for l in ls do
    if l == line then return true end
  end
  return false
end

function has_text(ls, text)
  for l in ls do
    if contains(l, text) then return true end
  end
  return false
end

-- The type names of the header lines, in order.
function headers_of(ls)
  local out = {}
  for l in ls do
    if starts_with(l, "#### ") then push(out, split(sub(l, 6), "   (")[1]) end
  end
  return out
end

function self_test()
  local at = "cookbook:roc/plants/type_walk/"
  local failures = {}
  -- Every walk shares one map of parsed files, since a run may start only 64
  -- programs.
  local trees = {}
  local r = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees})
  local ls = r.lines
  local headers = headers_of(ls)
  -- Speed is mentioned only by the constant `cruising`, so it joining the
  -- order shows a constant's annotation is followed.
  local want = {"Tagged, in module Leg", "Note", "Note.Mark", "Speed", "Unit.Metres", "Leg", "Leg.Stretch", "Ride", "Ride.Plan"}
  check(failures, join(headers, " | ") == join(want, " | "), "order: got " .. join(headers, " | "))
  check(failures, #r.lost == 0, "lost names: " .. join(r.lost, "; "))
  check(failures, #r.refused == 0, "refused: " .. join(r.refused, "; "))
  -- U32 appears only in the constant `count : U32`, so it is a leaf because
  -- constants are printed and followed.
  check(failures, has_line(ls, "# Builtin leaves, not expanded: F64, List, Str, U32"), "leaves line")
  check(failures, has_line(ls, "# Type variables, not followed: a (Tagged, in module Leg)"), "type variable line")
  check(failures, has_line(ls, "# Cycle: these types mention each other: Note, Note.Mark"), "cycle line")
  check(failures, has_line(ls, "# 9 types, 4 functions, 4 constants, 5 modules, 4 leaves, 1 type variables, 0 beyond depth 3, 0 stopped, 1 members with no outside use, method calls 0 typed and 1 pooled, operators 0 typed and 0 pooled, named by 4 annotations and 1 types: 3 production, 2 test"), "counts line: " .. ls[#ls])
  check(failures, not has_text(ls, "# Beyond depth"), "a beyond line when the walk reached every type")
  check(failures, has_line(ls, "\t## How many rides a day allows."), "a constant's doc")
  -- main.roc reads `Ride.count` in production, and Trip.roc in a value that
  -- only another value reads, which only an expect reads.
  check(failures, has_line(ls, "\tcount : U32   # constant; used by 2 files, 1 in tests only"), "a constant's annotation, marked, used in production and in a test-only value")
  check(failures, has_line(ls, "\tcruising : Speed   # constant; no outside use"), "a constant of a type from another module, which nothing outside uses")
  check(failures, not has_text(ls, "CONSTANT_MARKER") and not has_text(ls, "= 3"), "a constant's value is printed")
  check(failures, not has_text(ls, "legs_of : Ride -> List(Leg)   # constant"), "a function is marked as a constant")
  -- `is_eq : _` leaves its whole type to inference, so its annotation says
  -- nothing of Ride's surface and is left out.
  check(failures, not has_text(ls, "is_eq"), "an annotation of type `_` is printed")
  check(failures, has_line(ls, "Ride :: { legs : List(Leg), name : Str }.{"), "a module type's definition opens its block")
  -- Only gates/Check.roc, through its own header's `game` package, uses
  -- `legs_of`.
  check(failures, has_line(ls, "\tlegs_of : Ride -> List(Leg)   # used by 1 file, 1 in tests only"), "a function's annotation, used by a gates app alone")
  check(failures, has_line(ls, "\t## The legs of a ride, in order."), "a function's doc")
  -- Trip.roc names `noted` in an expect, and Log.roc calls `.noted()` on a
  -- value of no known type.
  check(failures, has_line(ls, "\tnoted : Ride, Note -> Str   # used by 1 file, 1 in tests only; by method name in 1 more"), "a type only an annotation mentions, its member used in an expect and by method name")
  check(failures, has_line(ls, "# Public, but used only in this file: cruising"), "the members no other file uses")
  local unused = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, uses = false}).lines
  check(failures, has_line(unused, "\tcount : U32   # constant") and has_line(unused, "\tlegs_of : Ride -> List(Leg)"), "uses=0 keeps the uses")
  check(failures, not has_text(unused, "Public, but") and not has_text(unused, "outside use") and not has_text(unused, "used by"), "uses=0 keeps the summary")
  check(failures, unused[#unused] == "# 9 types, 4 functions, 4 constants, 5 modules, 4 leaves, 1 type variables, 0 beyond depth 3, 0 stopped, named by 4 annotations and 1 types: 3 production, 2 test", "uses=0 counts line: " .. unused[#unused])
  check(failures, has_line(ls, "Plan : [Short, Long(Leg.Stretch)]"), "a nested type, re-indented")
  check(failures, has_line(ls, "## How long a ride's plan is."), "a nested type's doc")
  check(failures, has_line(ls, "## A ride is a list of legs, with a name."), "a module type's doc from the file's opening comment")
  check(failures, has_line(ls, "\tlabel : Tagged(Str),"), "a multiline definition, re-indented")
  check(failures, has_line(ls, "#### Unit.Metres   (" .. at .. "chain/shared/Unit.roc:6)"), "a type from a package")
  check(failures, not has_text(ls, "BODY_MARKER") and not has_text(ls, "ride.legs") and not has_text(ls, "|ride|"), "a body is printed")
  check(failures, not has_text(ls, "helper") and not has_text(ls, "#### Hidden"), "a helper outside the block, or its type, is printed")

  -- Unit.Metres is two steps from Ride, past the default full depth of 1, so
  -- its members are one line of names; Leg, one step away, is whole.
  check(failures, has_line(ls, "Metres :: F64.{ zero, plus }"), "a type past the full depth, its members by name")
  check(failures, not has_text(ls, "plus : Metres, Metres -> Metres"), "a type past the full depth printed whole")
  check(failures, has_line(ls, "\tlength_of : Leg -> Unit.Metres"), "a type at the full depth printed whole")
  -- Metres is a unit, brief by default, so this full depth is shown with no
  -- brief types.
  local full = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, full_depth = 3, brief = {}}).lines
  check(failures, has_line(full, "Metres :: F64.{") and has_line(full, "\tplus : Metres, Metres -> Metres") and has_line(full, "\tzero : Metres   # constant"), "full_depth=3 prints a depth-2 type whole")
  check(failures, not has_text(full, "Metres :: F64.{ zero"), "full_depth=3 still names a depth-2 type's members")
  check(failures, full[#full] == ls[#ls], "the full depth changes the counts: " .. full[#full])

  -- Speed and Unit.Metres are nominal types over F64 with no nested type, so
  -- units: brief at every depth, Speed at depth 1 among them.
  check(failures, has_line(ls, "Speed :: F64.{ still }"), "a unit at depth 1 printed whole")
  check(failures, has_line(ls, "# Brief, members by name at every depth: Speed; Unit.Metres"), "the brief line")
  check(failures, has_line(full, "Speed :: F64.{") and has_line(full, "\tstill : Speed   # constant") and not has_text(full, "# Brief"), "brief= empty prints a unit brief")
  local deep = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, full_depth = 3}).lines
  check(failures, has_line(deep, "Metres :: F64.{ zero, plus }"), "a unit within the full depth printed whole")
  local named_brief = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, brief = parse_brief("Leg")}).lines
  check(failures, has_line(named_brief, "}.{ length_of }") and has_line(named_brief, "# Brief, members by name at every depth: Leg"), "a type on the brief list by name printed whole")
  check(failures, has_line(named_brief, "Speed :: F64.{") and has_line(named_brief, "\tstill : Speed   # constant"), "a unit printed brief without `units` on the list")
  local asked_unit = walk(at .. "chain/app", "Speed", "", WALK_MAX_DEPTH, {trees = trees}).lines
  check(failures, has_line(asked_unit, "Speed :: F64.{") and not has_text(asked_unit, "# Brief"), "the asked module's unit printed brief")

  -- Tally is imported for a body alone, and Hidden for a helper outside the
  -- block; Leg, Note and Speed hold printed types.
  check(failures, has_line(ls, "# Imported but not in any printed type: Hidden, Tally"), "the imports in no printed type")

  -- Trip names Ride in its definition, in a member's annotation and in a
  -- top-level helper's; its own `own_plan` mentions Trip's `Plan`, not Ride's.
  check(failures, has_line(ls, "# Named by: the annotations and types in the other modules of " .. at .. "chain/app that mention Ride's types."), "the named-by heading")
  check(failures, has_line(ls, "### Trip"), "the named-by module")
  check(failures, has_line(ls, at .. "chain/app/Trip.roc:6: Trip :: { ride : Ride, legs : List(Leg) }"), "named by a type's definition")
  check(failures, has_line(ls, at .. "chain/app/Trip.roc:9: Trip.plan_of : Trip -> Ride.Plan"), "named by a member's annotation")
  check(failures, has_line(ls, at .. "chain/app/Trip.roc:20: (private) start : Ride -> Trip"), "named by a top-level helper, tagged private")
  check(failures, has_line(ls, at .. "chain/app/Trip.roc:32: (test) sample_plan : Ride.Plan"), "named by a value only an expect reads, tagged test")
  check(failures, has_line(ls, at .. "chain/app/gates/Check.roc:10: (test) check : Ride -> U64"), "named by a gates app, tagged test")
  check(failures, not has_text(ls, "own_plan"), "named by another type of the same bare name")
  local production = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, named_by_production = true}).lines
  check(failures, has_line(production, "# Named by: the annotations and types in the other modules of " .. at .. "chain/app that mention Ride's types. Production only: 2 test and 1 private entries left out."), "the production-only heading")
  check(failures, has_line(production, at .. "chain/app/Trip.roc:6: Trip :: { ride : Ride, legs : List(Leg) }") and has_line(production, at .. "chain/app/Trip.roc:9: Trip.plan_of : Trip -> Ride.Plan"), "named_by=production leaves out an untagged entry")
  check(failures, not has_text(production, "start : Ride") and not has_text(production, "sample_plan") and not has_text(production, "### Check"), "named_by=production lists a tagged entry")
  check(failures, production[#production] == ls[#ls], "named_by=production changes the counts: " .. production[#production])
  -- Ride's own `helper : Ride -> Hidden` would be listed were Ride read.
  local own = false
  for l in ls do
    if starts_with(l, at .. "chain/app/Ride.roc:") then own = true end
  end
  check(failures, not own, "named by the asked module itself")
  local unnamed = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, named_by = false}).lines
  check(failures, not has_text(unnamed, "Named by") and not has_text(unnamed, "Trip.roc"), "named_by=0 keeps the section")
  check(failures, unnamed[#unnamed] == "# 9 types, 4 functions, 4 constants, 5 modules, 4 leaves, 1 type variables, 0 beyond depth 3, 0 stopped, 1 members with no outside use, method calls 0 typed and 1 pooled, operators 0 typed and 0 pooled", "named_by=0 counts line: " .. unnamed[#unnamed])
  -- Lost names a module no other file names, and its type has no members.
  local alone = walk(at .. "unresolved", "Lost", "", WALK_MAX_DEPTH, {trees = trees}).lines
  check(failures, has_line(alone, "# Named by: no annotation or type in the other modules of " .. at .. "unresolved mentions Lost's types."), "the named-by line with none")
  check(failures, not has_text(alone, "Public, but"), "the unused-members line with no members")

  -- Note stopped: named once, not printed, and Note.Mark, reached only
  -- through it, never read. Ride's own Ride.Plan is never stopped.
  local stopped = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, stops = {"Note", "Ride.Plan"}}).lines
  check(failures, has_line(stopped, "# Stopped, not expanded: Note"), "the stopped line")
  check(failures, not has_text(stopped, "#### Note") and not has_text(stopped, "Mark"), "a stopped type expanded")
  check(failures, has_text(stopped, "#### Ride.Plan"), "an asked type stopped")
  check(failures, has_line(stopped, "# Imported but not in any printed type: Hidden, Tally"), "a stopped import named as unprinted")
  check(failures, stopped[#stopped] == "# 7 types, 4 functions, 4 constants, 4 modules, 4 leaves, 1 type variables, 0 beyond depth 3, 1 stopped, 1 members with no outside use, method calls 0 typed and 1 pooled, operators 0 typed and 0 pooled, named by 4 annotations and 1 types: 3 production, 2 test", "stopped counts line: " .. stopped[#stopped])
  local by_module = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, stops = parse_stops(" Leg.* , ")}).lines
  check(failures, has_line(by_module, "# Stopped, not expanded: Leg; Leg.Stretch"), "a module's types stopped by `.*`: got " .. join(headers_of(by_module), " | "))
  check(failures, not has_text(by_module, "Unit.Metres") and not has_text(by_module, "Tagged"), "a type followed through a stopped one")
  check(failures, not has_text(ls, "# Stopped"), "a stopped line with nothing stopped")
  check(failures, #parse_stops("") == 0, "stop= empty stops something")
  local unstopped = walk(at .. "chain/app", "Ride", "", WALK_MAX_DEPTH, {trees = trees, stops = parse_stops("")}).lines
  check(failures, has_text(unstopped, "#### Note   (") and not has_text(unstopped, "# Stopped"), "with no stops, Note is expanded")
  check(failures, not has_text(ls, "#### Unit "), "a module type nobody mentions is printed")
  check(failures, not has_line(ls, "#### Short") and not has_text(ls, "Long,"), "a tag is read as a type")

  -- Ride's deepest types, Note.Mark, Tagged and Unit.Metres, are two steps
  -- from it, so depth 1 names them and prints the rest, and Note's cycle
  -- through Note.Mark is gone with it.
  local one = walk(at .. "chain/app", "Ride", "", 1, {trees = trees}).lines
  check(failures, join(headers_of(one), " | ") == "Leg | Leg.Stretch | Note | Speed | Ride | Ride.Plan", "depth 1 order: got " .. join(headers_of(one), " | "))
  check(failures, has_line(one, "# Beyond depth 1, not followed: Note.Mark; Tagged, in module Leg; Unit.Metres"), "depth 1 beyond line")
  check(failures, has_line(one, "# 6 types, 3 functions, 3 constants, 4 modules, 4 leaves, 0 type variables, 3 beyond depth 1, 0 stopped, 1 members with no outside use, method calls 0 typed and 1 pooled, operators 0 typed and 0 pooled, named by 4 annotations and 1 types: 3 production, 2 test"),"depth 1 counts line: " .. one[#one])
  check(failures, not has_text(one, "# Cycle"), "a cycle through a type beyond the depth")
  check(failures, has_line(one, "\tlabel : Tagged(Str),"), "a type at the last depth printed whole")
  -- Depth 0 is the module's own types, and Speed's F64 is no longer read.
  local zero = walk(at .. "chain/app", "Ride", "", 0, {trees = trees}).lines
  check(failures, join(headers_of(zero), " | ") == "Ride | Ride.Plan", "depth 0 order: got " .. join(headers_of(zero), " | "))
  check(failures, has_line(zero, "# Beyond depth 0, not followed: Leg; Leg.Stretch; Note; Speed"), "depth 0 beyond line")
  check(failures, has_line(zero, "# Builtin leaves, not expanded: List, Str, U32"), "depth 0 leaves line")

  -- Width has members named as Span's. Typed.roc calls each Span member
  -- below on a Span through one typing rule; OtherType.roc calls `plus`,
  -- `minus` and `>` on Widths alone, and Width.roc's own `+`, `-` and `>`
  -- are on the F64s its patterns unwrap; Pooled.roc calls `plus` and applies
  -- `<=` on values of no known type.
  local m = walk(at .. "methods", "Span", "", WALK_MAX_DEPTH, {trees = trees, named_by = false}).lines
  check(failures, has_line(m, "\tplus : Span, Span -> Span   # used by 1 file; by method name in 1 more"), "a field's receiver typed, and an untyped one pooled")
  check(failures, has_line(m, "\tscaled : Span, F64 -> Span   # used by 1 file"), "a local from a qualified call typed")
  check(failures, has_line(m, "\thalved : Span -> Span   # used by 1 file"), "a qualified constant typed")
  check(failures, has_line(m, "\tdoubled : Span -> Span   # used by 1 file"), "a method's result typed")
  check(failures, has_line(m, "\tflipped : Span -> Span   # used by 1 file"), "a constant of the file typed")
  check(failures, has_line(m, "\tminus : Span, Span -> Span   # no outside use") and has_line(m, "\tis_gt : Span, Span -> Bool   # no outside use"), "a call on another type counted, through a parameter, an alias, a field, an operator or a nominal pattern")
  check(failures, has_line(m, "\tis_lt : Span, Span -> Bool   # used by 1 file"), "an operator on an alias of the type")
  check(failures, has_line(m, "\tis_gte : Span, Span -> Bool   # used by 1 file"), "a comparison typed by its right side")
  check(failures, has_line(m, "\tis_lte : Span, Span -> Bool   # used by operator only, untyped, in 1 file"), "an untyped operator pooled")
  check(failures, has_line(m, "# Public, but used only in this file: minus, is_gt"), "the members used only here, beside calls typed elsewhere and untyped operators")
  check(failures, m[#m] == "# 1 types, 11 functions, 1 constants, 1 modules, 2 leaves, 0 type variables, 0 beyond depth 3, 0 stopped, 2 members with no outside use, method calls 9 typed and 1 pooled, operators 6 typed and 1 pooled", "methods counts line: " .. m[#m])

  local lost = walk(at .. "unresolved", "Lost", "", WALK_MAX_DEPTH, {trees = trees}).lost
  check(failures, #lost == 2, "two lost names, got " .. #lost .. ": " .. join(lost, "; "))
  check(failures, has_text(lost, "`Nowhere.Thing`: `Nowhere` is no imported module"), "a name of no import is lost")
  check(failures, has_text(lost, "`Gone`: no file " .. at .. "unresolved/Gone.roc"), "a missing module is lost")
  local moved = walk(at .. "chain/app", "Ride", "shared=" .. at .. "chain/nowhere", WALK_MAX_DEPTH, {trees = trees}).lost
  check(failures, #moved == 2 and has_text(moved, "Leg.roc:5: `Unit.Metres`: no file " .. at .. "chain/nowhere/Unit.roc"), "packages= overrides the app's folder, got " .. join(moved, "; "))
  for f in failures do print("FAIL: " .. f) end
  if #failures > 0 then fail("type_walk: " .. #failures .. " self-test checks failed") end
  print("type_walk: self test passed")
  return nil
end

if SELF_TEST then
  self_test()
else
  local depth_arg = arg("max_depth", tostring(WALK_MAX_DEPTH))
  local max_depth = parse_int(depth_arg)
  if max_depth == nil or max_depth < 0 then fail("type_walk: max_depth=" .. depth_arg .. " is no count of steps, such as 3") end
  local full_arg = arg("full_depth", tostring(WALK_FULL_DEPTH))
  local full_depth = parse_int(full_arg)
  if full_depth == nil or full_depth < 0 then fail("type_walk: full_depth=" .. full_arg .. " is no count of steps, such as 1") end
  local named_by_arg = arg("named_by", "1")
  if named_by_arg ~= "0" and named_by_arg ~= "1" and named_by_arg ~= "production" then fail("type_walk: named_by=" .. named_by_arg .. " is none of 0, 1 and production") end
  local uses_arg = arg("uses", "1")
  if uses_arg ~= "0" and uses_arg ~= "1" then fail("type_walk: uses=" .. uses_arg .. " is neither 0 nor 1") end
  local settings = {stops = parse_stops(arg("stop", join(WALK_STOP, ","))), brief = parse_brief(arg("brief", join(WALK_BRIEF, ","))), full_depth = full_depth, uses = uses_arg == "1", named_by = named_by_arg ~= "0", named_by_production = named_by_arg == "production"}
  local r = walk(arg("root", "."), arg("module", ""), arg("packages", ""), max_depth, settings)
  print(join(r.lines, "\n"))
  for l in r.lost do print("lost: " .. l) end
  for l in r.refused do print("refused: " .. l) end
  if #r.lost > 0 or #r.refused > 0 then fail("type_walk: " .. #r.lost .. " names resolve to no type and " .. #r.refused .. " files don't parse (named above); every other type is printed") end
end
