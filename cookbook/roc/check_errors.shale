-- This recipe checks how Roc code reports failure, against the rules in
-- roc-apps docs/roc-style.md ("Errors and failure"). It reads each .roc
-- file's parse tree from Roc's own parser, so text in a comment or a string
-- never matches. A finding is a question for the reader, not a verdict.
-- There are five checks:
--
--   error_alias   A function's result is a `Try` whose error is an alias of
--                 tags (`ReadError : [Missing, Failed]`, or a module's
--                 `Accounts.Unreadable`) instead of the tags written in
--                 place. A shared alias makes every caller handle tags its
--                 function can't return. The alias is looked up in the files
--                 checked, through an alias of an alias. An error that is not
--                 a tag union (a record, a `Str`), an alias in an argument,
--                 an inferred error (`_`) and a type variable are all fine.
--                 An error declared outside the files checked can't be
--                 judged, so the summary line names it.
--   optional_tag  A tag named like an optional (`Some`, `None`, `Nothing`;
--                 the full list is cookbook/words/optionals.txt). A value
--                 that may be absent should be tagged by what it is, and its
--                 absence by why (`[Latest(Message), NoMessage]`). A type
--                 that names such a tag beside a tag with a payload is a
--                 finding at the tag's line. With no payload there, the union
--                 is a mode with two ways (`[Words, None]`), and `None` is one
--                 of them. A tag in an expression or a pattern is a finding,
--                 once per file, only when no type in the files checked names
--                 it, so read the whole tree. A tag matches by its whole name:
--                 `NoneChosen` is not `None`.
--   set_fallback  `List.set(l, i, v) ?? l`, or `l.set(i, v) ?? l`, where the
--                 fallback is the list being stored into. Naming `l` there
--                 makes every store copy the list (roc-apps CLAUDE.md, "Six
--                 shapes copy").
--   placeholder   A `??` whose fallback is a string literal with nothing
--                 interpolated (`?? "bogus"`, `?? ""`). The style guide asks
--                 for a `crash` with a reason when the lookup can't fail, and
--                 a tag for the case when it can.
--   number_fallback  A `??` that falls back to a number after a lookup by
--                 index, `List.get(l, i) ?? 0.0` or `l.get(i) ?? 0.0`. An index
--                 past the end is a bug, not a zero. Without types `.get` is
--                 taken for a `List`'s, so a `Dict`'s may read here; `Dict.get`
--                 and any other lookup are left alone.
--
-- `error_alias` reads only top-level and module-member annotations. The
-- `??` checks read every expression.
--
-- With `types=1 root=app/main.roc` (or `root=a.roc,b.roc` for several apps)
-- the recipe also asks Roc's type checker (cookbook/roc/types.shale). A
-- placeholder finding then names the fallback's type and the tags the lookup
-- fails with, and `number_fallback` goes by the lookup's type instead of its
-- name: any lookup that fails only with `[OutOfBounds]`. A lookup that can
-- fail with `KeyNotFound` or `ListWasEmpty` may fall back to a number, since
-- zero is often the right answer for a count or a total. A file that no root
-- reaches is checked without types, listed after the findings, and fails the
-- run.
--
-- The recipe prints a summary line of counts, one line per finding
-- (`path:line: check: why`), and the summary again. A file that does not
-- parse is listed after the findings and fails the run, once every other
-- file has been checked.
--
--   cd <repo> && shale <shale>/cookbook/roc/check_errors.shale glob='app/**/*.roc'
--   shale cookbook:roc/check_errors.shale self_test=1
--
-- `self_test=1` runs the checks over the plants in cookbook/roc/plants/check_errors/
-- (and its typed/ folder, with the types and root typed/QuietApp.roc). Each
-- plant is named for the check it holds, and that check must fire on it and
-- on no other check's plant. A `quiet_*.roc` plant must draw no finding, and
-- a plant named for no check is a failure. Every `optional_tag` finding must
-- point at a line that names its tag.
-- budget: steps=400000000 arena_bytes=3000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/check_errors/"
const GLOB = SELF_TEST and (PLANTS .. "*.roc") or arg("glob", "**/*.roc")
const CHECKS = {"error_alias", "optional_tag", "set_fallback", "placeholder", "number_fallback"}
use("cookbook:findings.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/pinned.shale")
use("cookbook:roc/types.shale")
const TYPES_ARG = arg("types", "0")
if TYPES_ARG ~= "0" and TYPES_ARG ~= "1" then fail("check_errors: types=" .. TYPES_ARG .. " must be 0 (the default) or 1") end
-- The self-test checks its typed plants with the types, and the rest without.
const USE_TYPES = SELF_TEST or TYPES_ARG == "1"
const ROOT = SELF_TEST and (PLANTS .. "typed/QuietApp.roc") or arg("root", "")

-- The words listed in cookbook/words/<file>, one per line, with `--`
-- starting a note.
function read_word_set(file)
  local words = {}
  for l in lines(read("cookbook:words/" .. file)) do
    local w = trim(split(l, "--")[1])
    if contains(w, " ") or has_key(words, w) then fail("check_errors: cookbook/words/" .. file .. ": `" .. w .. "` is not a single word, or is listed twice") end
    if w ~= "" then words[w] = true end
  end
  return words
end
const OPTIONALS = read_word_set("optionals.txt")

const finding_counts = {}
for c in CHECKS do finding_counts[c] = 0 end
const fired = {}
const finding_lines = {}

function record_finding(path, line, check, why)
  push(finding_lines, path .. ":" .. line .. ": " .. check .. ": " .. why)
  finding_counts[check] = finding_counts[check] + 1
  fired[path .. "|" .. check] = true
  return nil
end

const paths = glob(GLOB)
if SELF_TEST then
  for q in glob(PLANTS .. "typed/*.roc") do push(paths, q) end
end
-- The self-test's untyped plants are exempt from being reached by its root.
const TYPES = USE_TYPES and roc_types_for_files("check_errors", ROOT, roc_bin("check_errors", SELF_TEST), paths, SELF_TEST and set_of(glob(PLANTS .. "*.roc")) or {}) or {real = {}, pats = {}, exprs = {}, unreached = {}}
const PARSED = parse_roc_files(paths)

-- Every parsed file's nodes, in one list. Each node's `parent` and `kids`
-- are indexes into this list, and a root's `parent` is 0. NODE_PATH holds
-- each node's file.
const NODES = {}
const NODE_PATH = {}
for f in PARSED.files do
  local offset = #NODES
  for n in f.nodes do
    local ks = {}
    for k in n.kids do push(ks, k + offset) end
    n.kids = ks
    if n.parent > 0 then n.parent = n.parent + offset end
    push(NODES, n)
    push(NODE_PATH, f.path)
  end
end

function kids(at)
  return NODES[at].kids
end

-- Nodes are in source order, each before its kids, so a subtree runs from
-- its root to this node.
function last_descendant(at)
  local i = at
  while #NODES[i].kids > 0 do i = NODES[i].kids[#NODES[i].kids] end
  return i
end

function kind(at)
  return NODES[at].kind
end

function node_name(at)
  return get(NODES[at], "name", "")
end

function node_raw(at)
  return get(NODES[at], "raw", "")
end

-- A node with no line of its own takes the line of the next node that has
-- one.
function node_line(at)
  local i = at
  while i <= #NODES and NODES[i].line == 0 do i = i + 1 end
  return i <= #NODES and NODES[i].line or "?"
end

-- Each tag of the tag union at `at`, as a whole node (`Some(U64)`).
function union_tag_nodes(at)
  local out = {}
  for t in kids(at) do
    if kind(t) == "tags" then
      for g in kids(t) do push(out, g) end
    end
  end
  return out
end

-- The name of a tag node: `Some` for `Some(U64)`.
function tag_name(g)
  if kind(g) == "ty-apply" then return node_name(kids(g)[1]) end
  return node_name(g)
end

function union_tag_names(at)
  local out = {}
  for g in union_tag_nodes(at) do push(out, tag_name(g)) end
  return out
end

-- ── error_alias ──────────────────────────────────────────────────────────

const TOP_LEVEL_KINDS = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

-- Whether the annotation at `at` is top-level or a module member: every
-- node above it is a file, its statements, a type declaration, or a type's
-- associated block.
function is_top_level(at)
  local p = NODES[at].parent
  while p > 0 do
    if not has_key(TOP_LEVEL_KINDS, kind(p)) then return false end
    p = NODES[p].parent
  end
  return true
end

-- The name the type declaration at `at` declares, or "" if `at` is not one.
function declared_name(at)
  local ks = kids(at)
  if kind(at) ~= "s-type-decl" or #ks < 2 then return "" end
  return node_name(ks[1])
end

-- The type declaration at `at`'s name, qualified by the declarations
-- around it (`Stored.Problem`).
function nested_name(at)
  local inner_first = {declared_name(at)}
  local p = NODES[at].parent
  while p > 0 do
    if declared_name(p) ~= "" then push(inner_first, declared_name(p)) end
    p = NODES[p].parent
  end
  local outer_first = {}
  for k = #inner_first, 1, -1 do push(outer_first, inner_first[k]) end
  return join(outer_first, ".")
end

-- Every type declared in the files checked, mapped to the node of what it
-- is declared as. DECLARED_QUALIFIED is keyed by the qualified name, and a
-- file's top-level types also by the file's module name (`Access.Answer`
-- for `Answer` in Access.roc). DECLARED_IN_FILE is keyed by path and bare
-- name.
const DECLARED_QUALIFIED = {}
const DECLARED_IN_FILE = {}
for i = 1, #NODES do
  local name = declared_name(i)
  if name ~= "" then
    local definition = kids(i)[2]
    local qualified = nested_name(i)
    DECLARED_QUALIFIED[qualified] = definition
    if qualified == name then
      local file_name = split(NODE_PATH[i], "/")
      file_name = file_name[#file_name]
      DECLARED_QUALIFIED[sub(file_name, 1, #file_name - 4) .. "." .. name] = definition
    end
    DECLARED_IN_FILE[NODE_PATH[i] .. "|" .. name] = definition
  end
end

const BUILTIN_TYPES = {Str = true, Bool = true, U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true, F32 = true, F64 = true, Dec = true, List = true, Dict = true, Set = true, Box = true}

-- What the error type named `name` in `path` is: "union" for an alias of
-- tags (followed through up to 8 aliases of aliases), "unknown" for a type
-- declared outside the files checked, or "other" for anything else (a
-- record, a builtin, an empty module type).
function error_kind(path, name, hops)
  if has_key(BUILTIN_TYPES, name) then return "other" end
  local at = get(DECLARED_IN_FILE, path .. "|" .. name) or get(DECLARED_QUALIFIED, name)
  if at == nil then return "unknown" end
  if kind(at) == "ty-tag-union" then return #union_tag_names(at) > 0 and "union" or "other" end
  if kind(at) == "ty" and node_name(at) ~= "" and hops < 8 then return error_kind(path, node_name(at), hops + 1) end
  return "other"
end

-- The error node of a `Try(ok, error)` type at `at`, or 0 for any other node.
function try_error_node(at)
  local ks = kids(at)
  if kind(at) == "ty-apply" and #ks == 3 and node_name(ks[1]) == "Try" then return ks[3] end
  return 0
end

-- How many times each error declared outside the files checked is named.
const unjudged_errors = {}

for i = 1, #NODES do
  if kind(i) == "s-type-anno" and is_top_level(i) then
    local ks = kids(i)
    if #ks > 0 and kind(ks[1]) == "ty-fn" then
      local parts = kids(ks[1])
      local result = parts[#parts]
      for j = result, last_descendant(result) do
        local err = try_error_node(j)
        if err > 0 and node_name(err) ~= "" and kind(err) == "ty" then
          local name = node_name(err)
          local ek = error_kind(NODE_PATH[i], name, 0)
          if ek == "union" then record_finding(NODE_PATH[i], node_line(i), "error_alias", "`" .. node_name(i) .. "` fails with `" .. name .. "`, a shared alias of tags: list the tags it can return in place, or leave the error to inference (`_`)") end
          if ek == "unknown" then unjudged_errors[name] = get(unjudged_errors, name, 0) + 1 end
        end
      end
    end
  end
end

-- ── optional_tag ─────────────────────────────────────────────────────────

-- The optional tags some type names, and the first use of each optional
-- tag in an expression or pattern, keyed by path and tag.
const optionals_in_types = {}
const first_optional_uses = {}
-- Each `optional_tag` finding as `{path, line, tag}`, for the self-test.
const optional_findings = {}
for i = 1, #NODES do
  local k = kind(i)
  if k == "ty-tag-union" then
    local has_payload = false
    for g in union_tag_nodes(i) do
      if kind(g) == "ty-apply" then has_payload = true end
    end
    for g in union_tag_nodes(i) do
      local t = tag_name(g)
      if has_key(OPTIONALS, t) then
        optionals_in_types[t] = true
        if has_payload then
          push(optional_findings, {path = NODE_PATH[i], line = node_line(g), tag = t})
          record_finding(NODE_PATH[i], node_line(g), "optional_tag", "`" .. t .. "` names an optional: tag what the value is, and its absence by why (`[Latest(Message), NoMessage]`)")
        end
      end
    end
  elseif k == "e-tag" or k == "p-tag" then
    local t = node_raw(i)
    local key = NODE_PATH[i] .. "|" .. t
    if has_key(OPTIONALS, t) and not has_key(first_optional_uses, key) then first_optional_uses[key] = {path = NODE_PATH[i], line = node_line(i), tag = t} end
  end
end
for key in sort(keys(first_optional_uses)) do
  local first_use = first_optional_uses[key]
  if not has_key(optionals_in_types, first_use.tag) then
    push(optional_findings, first_use)
    record_finding(first_use.path, first_use.line, "optional_tag", "`" .. first_use.tag .. "` names an optional, and no type in the files read says what it is: tag the value by what it is, and its absence by why")
  end
end

-- ── set_fallback and placeholder: what a `??` falls back to ──────────────

-- Whether the expressions at `a` and `b` are the same value written twice
-- (`board`, `r.b`): the same kinds, names and fields, all the way down.
function same_expr(a, b)
  if kind(a) ~= kind(b) or node_raw(a) ~= node_raw(b) or get(NODES[a], "field", "") ~= get(NODES[b], "field", "") then return false end
  local ka = kids(a)
  local kb = kids(b)
  if #ka ~= #kb then return false end
  for k = 1, #ka do
    if not same_expr(ka[k], kb[k]) then return false end
  end
  return true
end

-- The list that the `List.set(l, i, v)` or `l.set(i, v)` call at `at`
-- stores into, or 0 for any other expression.
function set_target(at)
  local ks = kids(at)
  if kind(at) == "e-apply" and #ks == 4 and kind(ks[1]) == "e-ident" and node_raw(ks[1]) == "List.set" then return ks[2] end
  if kind(at) == "e-method-call" and get(NODES[at], "method", "") == ".set" then
    for k in ks do
      if kind(k) == "receiver" and #kids(k) == 1 then return kids(k)[1] end
    end
  end
  return 0
end

-- Whether `at` is a string literal with nothing interpolated.
function is_literal_str(at)
  if kind(at) ~= "e-string" then return false end
  for k in kids(at) do
    if kind(k) ~= "e-string-part" then return false end
  end
  return true
end

-- Whether `at` is a lookup by index: `List.get(l, i)` or `l.get(i)`.
function is_index_lookup(at)
  local ks = kids(at)
  if kind(at) == "e-apply" and kind(ks[1]) == "e-ident" then return node_raw(ks[1]) == "List.get" end
  return kind(at) == "e-method-call" and get(NODES[at], "method", "") == ".get"
end

function is_number(at)
  return kind(at) == "e-int" or kind(at) == "e-frac"
end

for i = 1, #NODES do
  local ks = kids(i)
  if kind(i) == "e-binop" and get(NODES[i], "op", "") == "??" and #ks == 2 then
    local lookup = ks[1]
    local fallback = ks[2]
    local path = NODE_PATH[i]
    local target = set_target(lookup)
    if target > 0 and same_expr(target, fallback) then record_finding(path, node_line(fallback), "set_fallback", "`List.set(l, i, v) ?? l`: the fallback names `l`, so every store copies; write `?? crash \"...\"` instead (roc-apps CLAUDE.md, \"Six shapes copy\")") end
    -- With types, the tag union the lookup's `Try` fails with, such as
    -- `[OutOfBounds]`, or "" when it is unknown.
    local has_types = USE_TYPES and has_key(TYPES.real, path)
    local lookup_error = ""
    if has_types then
      local lookup_type = roc_type_at(TYPES, "expr", path, NODES[lookup])
      local m = lookup_type ~= nil and re_find(lookup_type, "^Try\\((.*), (\\[[^\\[\\]]*\\])\\)$") or nil
      if m ~= nil then lookup_error = m.groups[2] end
    end
    local lookup_said = lookup_error ~= "" and (", for a lookup that fails with `" .. lookup_error .. "`") or ""
    if is_literal_str(fallback) then
      local text = ""
      for k in kids(fallback) do text = text .. node_raw(k) end
      record_finding(path, node_line(fallback), "placeholder", "falls back to the literal `\"" .. text .. "\"`" .. (has_types and (", a Str" .. lookup_said) or "") .. ": if the lookup can't fail, `crash` with a reason, \"never a silent `?? default`\"; if it can, keep that case as a tag (roc-apps docs/roc-style.md, \"Errors and failure\")")
    end
    if is_number(fallback) and (lookup_error == "[OutOfBounds]" or (not has_types and is_index_lookup(lookup))) then
      local fallback_type = has_types and (", a " .. (roc_type_at(TYPES, "expr", path, NODES[fallback]) or "?")) or ""
      record_finding(path, node_line(fallback), "number_fallback", "falls back to `" .. node_raw(fallback) .. "`" .. fallback_type .. lookup_said .. ": an index past the end is a bug, not a " .. node_raw(fallback) .. "; `crash` with a reason, or keep the case as a tag (roc-apps docs/roc-style.md, \"Errors and failure\")")
    end
  end
end

local counts = {}
for c in CHECKS do push(counts, c .. " " .. finding_counts[c]) end
local unjudged = {}
for n in sort(keys(unjudged_errors)) do push(unjudged, n .. " (" .. unjudged_errors[n] .. ")") end
local unjudged_said = #unjudged > 0 and ("; error_alias not judged, declared outside the files hunted: " .. join(unjudged, ", ")) or ""
print_findings("check_errors (Roc): " .. #paths .. " files; " .. join(counts, ", ") .. unjudged_said, finding_lines)
fail_if_refused("check_errors", PARSED.refused, TYPES.unreached)

-- A plant's name relative to PLANTS. A typed plant's module name is read
-- in snake case: `typed/PlaceholderIndex.roc` is `placeholder_index.roc`.
function plant_name(path)
  local name = sub(path, #PLANTS + 1)
  if starts_with(name, "typed/") then return snake_case_plant_name(sub(name, 7)) end
  return name
end

function is_plant_for(name, check)
  return name == check .. ".roc" or starts_with(name, check .. "_")
end

if SELF_TEST then
  local failures = {}
  for c in CHECKS do
    local planted = 0
    for p in paths do
      local mine = is_plant_for(plant_name(p), c)
      if mine then planted = planted + 1 end
      local did_fire = has_key(fired, p .. "|" .. c)
      if mine and not did_fire then push(failures, "`" .. c .. "` does not fire on its plant " .. p) end
      if did_fire and not mine then push(failures, "`" .. c .. "` fires on " .. p .. ", another check's plant") end
    end
    if planted == 0 then push(failures, "`" .. c .. "` has no plant") end
  end
  -- No check would ever fail on a plant named for none of them.
  for p in paths do
    local name = plant_name(p)
    local named = starts_with(name, "quiet_")
    for c in CHECKS do
      if is_plant_for(name, c) then named = true end
    end
    if not named then push(failures, p .. ": a plant the table does not judge") end
  end
  -- Every error a plant names is declared in a plant; otherwise a quiet
  -- plant could pass without `error_alias` judging it.
  for n in sort(keys(unjudged_errors)) do push(failures, "`error_alias` cannot judge `" .. n .. "`, declared in no plant") end
  for f in optional_findings do
    local source_lines = split(read(f.path), "\n")
    if f.line == "?" or not contains(source_lines[f.line], f.tag) then push(failures, "`optional_tag` says " .. f.path .. ":" .. f.line .. ", a line that does not name `" .. f.tag .. "`") end
  end
  for w in failures do print("FAIL " .. w) end
  if #failures > 0 then fail("check_errors self_test: " .. #failures .. " plants wrong") end
  print("check_errors (Roc) self_test: PASS (each check fires on its plants alone, the quiet_ plants on none, each optional at its tag's line)")
end
