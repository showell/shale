-- hunt_names' checks that are judged over what the whole read gathered,
-- once every file is read: `preposition_split`, from the trailing
-- prepositions each file puts on its stems; `container` and a field's
-- `short_name`, from the type and field names; `where_name`, from a file's
-- `where` clauses; and the census of effects' first words that `words=1`
-- prints. hunt_names.shale's header says what each check finds. They need
-- no parse-tree helper and no other library, so they sit apart from the
-- recipe, which reports what they find.
--
--   use("./naming_passes.shale")

-- The names in each file that end in a preposition, grouped by the stem
-- before it. Each key is `path|stem`, each value `{path, line, stem,
-- prepositions}`, and `prepositions` maps each preposition to the first
-- name using it and that name's arity.
const PREPOSITIONS_BY_STEM = {}
-- The stems each trailing preposition is put on in each file, grouped by the
-- preposition and the shape of the annotation: its first argument's type and
-- its result. Each key is `path|preposition|first|result`, each value a set
-- of stems. A preposition reaching CONVENTION_STEMS stems of one shape in a
-- file goes into SUFFIX_CONVENTIONS as `path|preposition`. Counting stems by
-- preposition alone, or by result alone, would make a common preposition
-- (`_of`) a convention in any large module. Counting them across files made
-- a pair's verdict move when an unrelated file lost a name.
const STEMS_BY_SHAPE = {}
const CONVENTION_STEMS = 3
const SUFFIX_CONVENTIONS = {}
const OPPOSITE_PAIRS = {["after|before"] = true, ["from|to"] = true, ["with|without"] = true, ["over|under"] = true}
-- A field of one of these holds one plain value, so `container` passes it.
const SCALAR_TYPES = {U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true, F32 = true, F64 = true, Dec = true, Str = true, Bool = true}

-- Notes a name that ends in a preposition, for `preposition_split`, in
-- PREPOSITIONS_BY_STEM and, when it is an annotated function, in
-- STEMS_BY_SHAPE and SUFFIX_CONVENTIONS. `ws` is the name's words.
function note_trailing_preposition(def, ws)
  local preposition = ws[#ws]
  local stem = join(take(ws, #ws - 1), "_")
  local key = def.path .. "|" .. stem
  if not has_key(PREPOSITIONS_BY_STEM, key) then PREPOSITIONS_BY_STEM[key] = {path = def.path, line = def.line, stem = stem, prepositions = {}} end
  local group = PREPOSITIONS_BY_STEM[key]
  if def.annotation and def.fn then
    local shape_key = def.path .. "|" .. preposition .. "|" .. def.first .. "|" .. def.result
    if not has_key(STEMS_BY_SHAPE, shape_key) then STEMS_BY_SHAPE[shape_key] = {} end
    STEMS_BY_SHAPE[shape_key][stem] = true
    if #keys(STEMS_BY_SHAPE[shape_key]) >= CONVENTION_STEMS then SUFFIX_CONVENTIONS[def.path .. "|" .. preposition] = true end
  end
  if not has_key(group.prepositions, preposition) then
    group.prepositions[preposition] = {name = def.name, arity = get(def, "arity", -1)}
  end
  return nil
end

-- What `preposition_split` finds in the stems noted, each `{path, line,
-- why}`, in the order of their keys. `declared_keywords` holds each file's
-- `# keywords:` words, by path.
function preposition_split_findings(declared_keywords)
  local found = {}
  for key in sort(keys(PREPOSITIONS_BY_STEM)) do
    local group = PREPOSITIONS_BY_STEM[key]
    local fewest_arguments = -1
    for preposition in keys(group.prepositions) do
      local arity = group.prepositions[preposition].arity
      if arity >= 0 and (fewest_arguments < 0 or arity < fewest_arguments) then fewest_arguments = arity end
    end
    local split_names = {}
    local split_prepositions = {}
    for preposition in sort(keys(group.prepositions)) do
      local first_use = group.prepositions[preposition]
      local is_from_worker = preposition == "from" and fewest_arguments >= 0 and first_use.arity > fewest_arguments
      local is_convention = has_key(SUFFIX_CONVENTIONS, group.path .. "|" .. preposition)
      local is_keyword = has_item(get(declared_keywords, group.path, {}), preposition)
      if not is_from_worker and not is_convention and not is_keyword then
        push(split_names, first_use.name)
        push(split_prepositions, preposition)
      end
    end
    local is_opposite_pair = #split_names == 2 and get(OPPOSITE_PAIRS, join(split_prepositions, "|"), false)
    if #split_names > 1 and not is_opposite_pair then push(found, {path = group.path, line = group.line, why = "`" .. group.stem .. "` takes " .. #split_names .. " prepositions here (" .. join(split_names, ", ") .. "): one relation keeps one preposition, or the names say how they differ"}) end
  end
  return found
end

-- Whether a doc says whose a container word is (`a folder's entry`, `a
-- listing's entries`), in the word's singular or plural.
function doc_says_whose(doc, word)
  local forms = {word, word .. "s"}
  if ends_with(word, "ies") then push(forms, sub(word, 1, #word - 3) .. "y") end
  if ends_with(word, "y") then push(forms, sub(word, 1, #word - 1) .. "ies") end
  if ends_with(word, "s") then push(forms, sub(word, 1, #word - 1)) end
  for form in forms do
    if contains(doc, "'s " .. form) then return true end
  end
  return false
end

-- What `short_name` and `container` find in one type or field name, each
-- `{check, why}`: `named` is `{name, words, is_field, doc, ...}` as the read
-- gathered it, and `vague` and `containers` the word sets.
function container_findings(named, vague, containers)
  local found = {}
  local only_container_words = #named.words > 0
  local doc_owns_it = false
  for w in named.words do
    if not has_key(vague, w) and not has_key(containers, w) then only_container_words = false end
    if doc_says_whose(named.doc, w) then doc_owns_it = true end
  end
  -- A field of a plain value (`entry : F64`) holds nothing a container could.
  local is_scalar = named.is_field and not named.is_function and has_key(SCALAR_TYPES, named.gives)
  if named.is_field and #named.name == 1 and not named.letter_of_set then push(found, {check = "short_name", why = "the field `" .. named.name .. "` is one letter, read far from where it is set: name what it holds"}) end
  if only_container_words and not doc_owns_it and not is_scalar then push(found, {check = "container", why = (named.is_field and "the field `" or "the type `") .. named.name .. "` is only container words: name it for what it holds, or say whose it is in its doc (`## A folder's entry`)"}) end
  return found
end

-- What `where_name` finds in one parsed file, each `{line, why}`.
-- `fixed_names` is the set of methods Roc calls by name, which pass.
function where_name_findings(file, fixed_names)
  local found = {}
  for n in file.nodes do
    if n.kind == "method" and file.nodes[n.parent].kind == "where" then
      local bare = ends_with(n.name, "!") and sub(n.name, 1, #n.name - 1) or n.name
      if #split(bare, "_") < 2 and not has_key(fixed_names, n.name) then push(found, {line = n.line, why = "the `where` method `" .. n.name .. "` is one word, and a `where` clause matches by name alone: say what it is for (`scenery_height`, not `height`)"}) end
    end
  end
  return found
end

-- The census `words=1` prints, from `census`, each first word an effect
-- starts with mapped to `{word, count, verdict}`: `{lines, summary}`, a
-- line a word, the most used first, and the summary's counts.
function census_lines(census)
  local rows = {}
  local effects_by_verdict = {}
  local total = 0
  for w in keys(census) do
    local row = census[w]
    push(rows, row)
    effects_by_verdict[row.verdict] = get(effects_by_verdict, row.verdict, 0) + row.count
    total = total + row.count
  end
  sort(rows, {{key = "count", desc = true}, "word"})
  local out = {}
  for r in rows do push(out, pad(r.count, -4) .. " " .. pad(r.word, 12) .. " " .. r.verdict) end
  local verdict_counts = {}
  for v in {"verb", "participle", "vague", "asks", "refused"} do push(verdict_counts, v .. " " .. get(effects_by_verdict, v, 0)) end
  return {lines = out, summary = total .. " effects, " .. #rows .. " first words; effects by verdict: " .. join(verdict_counts, ", ")}
end
