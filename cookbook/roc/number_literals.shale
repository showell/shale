-- A library for rewrite_method_calls, loaded with
-- `use("./number_literals.shale")`: whether a value's type comes from
-- unsuffixed number literals alone, read from roc_tree's nodes. Such a
-- value's type defaults (to `Dec`) when it is a method call's receiver, so
-- `U64.to_str(5)` is "5" while `(5).to_str()` is "5.0", and the recipe
-- leaves such a call as it is. A tree `t` here is the recipe's: `t.nodes`,
-- each `{kind, raw, name, field, kids, parent}`.

-- The number literals whose type only their use fixes (`5`, `-3`, `0x1F`,
-- `1.5`, `1e3`, `'a'`). Typed literals like `5.U64` (`e-typed-int`,
-- `e-typed-frac`) are not among them.
const UNTYPED_NUMBER_LITERALS = {["e-int"] = true, ["e-frac"] = true, ["e-single-quote"] = true}

-- Whether node `i` is a constant numeric expression: untyped number literals
-- joined only by operators (`e-binop`, `unary`) and parentheses (a
-- one-element `e-tuple`), as in `5`, `(5)`, `2 + 3` or `-(1 + 2)`.
function is_constant_numeric(t, i)
  local n = t.nodes[i]
  if has_key(UNTYPED_NUMBER_LITERALS, n.kind) then return true end
  local joins = n.kind == "e-binop" or n.kind == "unary" or (n.kind == "e-tuple" and #n.kids == 1)
  if not joins or #n.kids == 0 then return false end
  for k in n.kids do
    if not is_constant_numeric(t, k) then return false end
  end
  return true
end

function is_plain_name(n)
  return n.kind == "e-ident" and find(n.raw, ".") == nil
end

-- The name a definition `name = <value>` binds, or "" for any other node.
function defined_name(t, n)
  if n.kind == "s-decl" and #n.kids == 2 and t.nodes[n.kids[1]].kind == "p-ident" then return t.nodes[n.kids[1]].raw end
  return ""
end

function has_parameter_named(t, lambda, name)
  for k in lambda.kids do
    if t.nodes[k].kind == "args" then
      for a in t.nodes[k].kids do
        if t.nodes[a].kind == "p-ident" and t.nodes[a].raw == name then return true end
      end
    end
  end
  return false
end

-- The binding of the plain name `name`, used at node `at`, that gives it its
-- type: `{value = k}` for a definition `name = <k>` or a `var name = <k>`,
-- `{loop = k}` for a `for name in <k>` around the use, or nil when the name
-- has its type another way (a lambda's parameter, an annotation `name :
-- Type` beside the definition) or no binding is found. The binding that
-- counts is the nearest one up the tree: in a block, the last definition
-- before the statement holding the use; at the top level, any definition,
-- since order doesn't matter there. A `var`'s type is its start's, so for
-- a `$name` only its `var` counts, never a reassignment (`$n = $n + 1`).
function binding_of(t, at, name)
  local is_var = starts_with(name, "$")
  local child = at
  local up = t.nodes[at].parent
  while up > 0 do
    local scope = t.nodes[up]
    if scope.kind == "e-lambda" and has_parameter_named(t, scope, name) then return nil end
    if scope.kind == "s-for" and #scope.kids == 3 and child == scope.kids[3] then
      local pat = t.nodes[scope.kids[1]]
      if pat.kind == "p-ident" and pat.raw == name then return {loop = scope.kids[2]} end
    end
    local in_block = scope.kind == "statements" and scope.parent > 0 and t.nodes[scope.parent].kind == "e-block"
    local definition = 0
    local annotated = false
    for k in scope.kids do
      if in_block and k == child then break end
      local s = t.nodes[k]
      if is_var then
        if s.kind == "s-var" and s.name == name and #s.kids == 1 then definition = k end
      elseif defined_name(t, s) == name then
        definition = k
      end
      if s.kind == "s-type-anno" and s.name == name then annotated = true end
    end
    if definition > 0 then
      if annotated then return nil end
      local d = t.nodes[definition]
      return {value = d.kids[#d.kids]}
    end
    child = up
    up = scope.parent
  end
  return nil
end

-- Whether a value at node `i` takes its type from unsuffixed number
-- literals alone, so that as a receiver it defaults (to `Dec`). With `what`
-- "number", the value is the number itself: a constant numeric expression;
-- a plain name bound, unannotated, to one, or to another such name; a loop
-- variable over a list of them or a range of literals (`for n in [10,
-- 1000]`, `for k in 0..<3`); a `var` whose start is one; or a field of a
-- record literal that holds one (`r.a` after `r = { a: 5 }`). With `what`
-- "items", the value is what a `for` walks: a list literal of such numbers,
-- a range of literals, or a name bound to either. (One function for both,
-- since each asks the other and a function is called only below its
-- declaration.)
function takes_literal_type(t, i, what, depth)
  if depth > 8 then return false end
  if is_constant_numeric(t, i) then return true end
  local n = t.nodes[i]
  if is_plain_name(n) then
    local b = binding_of(t, i, n.raw)
    if b == nil then return false end
    if has_key(b, "loop") then return what == "number" and takes_literal_type(t, b.loop, "items", depth + 1) end
    return takes_literal_type(t, b.value, what, depth + 1)
  end
  if what == "items" then
    if n.kind ~= "e-list" or #n.kids == 0 then return false end
    for k in n.kids do
      if not takes_literal_type(t, k, "number", depth + 1) then return false end
    end
    return true
  end
  if n.kind == "e-field-access" and #n.kids == 2 then
    local recv = t.nodes[n.kids[1]]
    local seg = t.nodes[n.kids[2]]
    if recv.kind ~= "receiver" or #recv.kids ~= 1 or seg.kind ~= "segment" then return false end
    local r = recv.kids[1]
    if not is_plain_name(t.nodes[r]) then return false end
    local b = binding_of(t, r, t.nodes[r].raw)
    if b == nil or not has_key(b, "value") or t.nodes[b.value].kind ~= "e-record" then return false end
    for f in t.nodes[b.value].kids do
      local fn = t.nodes[f]
      if fn.kind == "field" and fn.field == seg.field and #fn.kids == 1 then return takes_literal_type(t, fn.kids[1], "number", depth + 1) end
    end
  end
  return false
end

