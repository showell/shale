-- This library names the Roc recipes' checks that are our own house style, not
-- a fault in anyone else's code. Our guides hold our trees to them, and they
-- stay on by default. Another project's guide may say otherwise: Luke Boswell's
-- roc-style.md asks for `if (x) a else b` where ours has braces. `house=0` on a
-- recipe leaves its house checks out, and cookbook/roc/check_another_projects_roc_code.shale runs every
-- recipe that way.
--
--   use("cookbook:roc/house.shale")
--   HOUSE_CHECKS                  each recipe's house checks, by the recipe
--
-- check_another_projects_roc_code.shale loads it, and find_awkward_names' Roc reads its row from
-- this file's text. Each Roc recipe reads its own `house=` argument.
--
-- A check belongs here when a careful project could fairly do the opposite, so
-- a finding says more about our habits than about their code. A check that
-- points at a fault, or at something a project's own guide would also ask,
-- does not.

const HOUSE_CHECKS = {
  find_functions_and_parameters_that_dont_earn_their_keep = {"single"},
  find_awkward_names = {"bare_participle", "container", "phrase_name", "singular_list", "where_name", "world_verb"},
  find_calls_nested_three_deep = {"nested"},
  find_and_remove_extra_parentheses = {"paren_if", "lambda_if"},
  find_names_and_docs_that_say_too_little = {"abbreviation"},
  check_and_fix_group_stacking = {"stack", "unstack", "long", "wide string"},
}
