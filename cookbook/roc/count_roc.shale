-- This recipe counts a Roc project: for each folder of `in`, its modules and
-- lines of Roc, the same for its tests, and its `expect`s, the numbers a
-- landing page or a review quotes. A module is a test's when its path holds
-- one of `tests`' literals (by default `/gates/`, `/tests/`, `Tests.roc`,
-- `Expects.roc` and `_test.roc`); `skip` names more literals whose modules
-- are left out (a book's builder inside an app's folder, say). Build output
-- (zig-out, .zig-cache and every hidden folder) is never counted, and a
-- folder that isn't there stops the run.
--
--   cd ~/showell_repos && shale shale/cookbook/roc/count_roc.shale in=roc-apps/basic,roc-markdown/package
--   cd ~/showell_repos && shale shale/cookbook/roc/count_roc.shale in=roc-apps/canvas_apps/safari skip=/tutorial/
--
-- It is written in Roc, cookbook/roc/count_roc/count_roc.roc, run on Shale's
-- Roc platform (roc_platform/README.md); this file is its launcher. It hands
-- the values it is given to roc_platform/run.shale in the checkout this
-- cookbook is in (the `cookbook` mount's parent), which builds the Roc there
-- (cached; the first build after a change to C Shale compiles the platform's
-- host, 25 to 50 s) and runs the program rooted here, so `in`'s folders are
-- this root's paths. `in` reaches the program as `folders`, since run.shale
-- takes `in=` for the root it runs in. Its goldens, the Shale original's
-- output on the plants, are held by cookbook/roc/count_roc/check_goldens.shale.
-- budget: programs=10

const SCRIPT = "cookbook/roc/count_roc/count_roc.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))

-- Each value is handed on only when it was given, so the defaults have one
-- home, the Roc. Each is read here by its name, so a misspelled one stops the
-- run before anything is built.
const FOLDERS = arg("in", nil)
const TESTS = arg("tests", nil)
const SKIP = arg("skip", nil)
local values = {"script=" .. SCRIPT, "in=" .. real(".")}
if FOLDERS ~= nil then push(values, "folders=" .. FOLDERS) end
if TESTS ~= nil then push(values, "tests=" .. TESTS) end
if SKIP ~= nil then push(values, "skip=" .. SKIP) end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 600000, whole = 4000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("count_roc: the Roc program stopped (exit " .. r.code .. ")") end
