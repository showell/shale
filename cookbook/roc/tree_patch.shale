-- This script turns a changed copy of a folder into a patch. Copy the
-- folder aside, change the copy, then run this from the repository's root.
-- It writes one unified patch that `patch -p1` applies from that root.
--
--   cd <repo> && shale <shale>/cookbook/roc/tree_patch.shale old=roc new=<copy>/roc under=roc out=test/new_kind/sheep.patch
--
-- Give `old` and `new` relative to where the run starts; `under` is the
-- folder's path in the repository. The patch compares the
-- files that match `like` (`*.roc` unless you give one). A file that is
-- only in the copy is added. A file deleted from the copy stays out of the
-- patch.
--
-- budget: steps=100000000

const OLD = arg("old", "")
const NEW = arg("new", "")
const UNDER = arg("under", "")
const OUT = arg("out", "")
const LIKE = arg("like", "*.roc")

if OLD == "" or NEW == "" or UNDER == "" or OUT == "" then fail("tree_patch: old=<folder> new=<changed copy> under=<folder's path in the repo> out=<patch file>") end

local patch = ""
local files = 0
local changed = 0
for e in walk_all(NEW, {kind = "file", like = LIKE}) do
  local rel = sub(e.path, #NEW + 2)
  local was = path(OLD, rel)
  local from = was
  if not exists(was) then from = "/dev/null" end
  local r = run({"diff", "-u", "--label", "a/" .. path(UNDER, rel), "--label", "b/" .. path(UNDER, rel), from, e.path}, {timeout_ms = 60000, whole = 4000000})
  -- diff exits 0 when the files match, 1 when they differ, and 2 on trouble.
  if r.code > 1 then fail("diff " .. rel .. ": code " .. r.code) end
  if r.code == 1 then
    patch = patch .. r.out
    if not ends_with(r.out, "\n") then patch = patch .. "\n" end
    changed = changed + 1
  end
  files = files + 1
end
if changed == 0 then fail("no file under " .. NEW .. " differs from " .. OLD .. ": no patch") end
replace(OUT, patch)
print(OUT .. ": " .. changed .. " of " .. files .. " files changed")
