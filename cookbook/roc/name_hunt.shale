-- This recipe looks for awkward names in every .roc file of a tree: an
-- effect named like a state, a question that returns no `Bool`, a name made
-- only of vague words, and the other checks below. A finding is a question
-- for the reader, not a verdict. The recipe reads the top-level definitions
-- and the members of module types (`Html := [].{ ... }`), never local ones,
-- from the syntax tree of Roc's own parser (cookbook/roc/parsed.shale), so
-- an annotation broken across lines and a `where` clause read as Roc reads
-- them. Files that don't parse are listed after the findings, and then the
-- run fails.
--
--   cd <repo> && shale <shale>/cookbook/roc/name_hunt.shale glob=chat/**/*.roc
--   shale cookbook:roc/name_hunt.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default;
--   words      with `words=1`, print the census of effects' first words
--              (below) instead of the findings;
--   house      with `house=0`, leave out what is only our house style
--              (cookbook/roc/house.shale), for another project's code;
--   types      with `types=1`, also ask Roc's type checker (below);
--   root       the app the type checker starts from, or several
--              (`root=a.roc,b.roc`);
--   self_test  with `self_test=1`, check the plants (below).
--
-- An effect is a function whose name ends in `!`. The checks:
--
--   state_effect  An effect whose first word is a past participle
--                 (`held_raw!`, `done!`) is named like a state; a verb would
--                 say what it does. The participle is fine when it starts
--                 the name of a type in the effect's annotation
--                 (`rounded_rectangle! : Frame, RoundedRectangle => {}`),
--                 because there it describes the thing the effect draws.
--   question      A function named as a question (`is_*`, `has_*`, `can_*`,
--                 `should_*`) that returns something other than a `Bool`,
--                 or an effect so named that returns no `Bool`
--                 (`is_open! : Str => Str`); and a function that returns a
--                 `Bool` but is named like a state (`marked : Str -> Bool`).
--                 A name with `_is_` or `_has_` inside (`unsigned_is_even`)
--                 is a question too. An effect that returns a `Bool`
--                 (`is_playing! : Sound => Bool`) is fine, because asking
--                 the host about live state has to be an effect. Only
--                 functions are checked: a value (`has_got : List(Bool)`)
--                 and an inferred type (`is_eq : _`) are not. With
--                 `types=1` a definition's type comes from the checker, so
--                 an unannotated `is_ready = |n| n + 1` is checked, and a
--                 result that is an alias of `Bool` (`Answer : Bool`)
--                 counts as a `Bool`.
--   vague         A name made only of vague words (cookbook/words/vague.txt):
--                 `handle_data`, `process!`, `do_it`. The entry points
--                 `handle`, `run` and `main` are fine.
--   name_type     A value named `*_count` whose type is not an integer, or
--                 `*_path` whose type is neither `Str` nor one naming `Path`.
--   noun_effect   An effect whose first word is not a known verb
--                 (cookbook/words/verbs.txt), such as a plain noun (`links!`,
--                 `page!`), reads as a value rather than an act. When the
--                 first word is a namespace prefix such as `block_` or
--                 `port_` (cookbook/words/namespaces.txt), the word after it
--                 is checked instead, here and by `state_effect`, and the
--                 namespace's own instructions listed in that file count as
--                 verbs (`port_out_32!`). An effect whose first argument is
--                 a surface, a `Frame` or a `Canvas`, is named for what it
--                 draws there (`circle! : Frame, Circle => {}`, called as
--                 `frame.circle!(...)`), so it is not checked. An effect with
--                 no annotation shows no surface, so it is checked.
--   negative      A `Bool` value named `no_*` or `not_*`, or an annotated
--                 name starting `is_not_`: its negation reads twice.
--   preposition_split  One stem given different trailing prepositions in
--                 one file (`blocks_of`, `blocks_in`, `blocks_from`). One
--                 relation should keep one preposition, or the names should
--                 say how they differ. It is reported once, at the first
--                 name. These prepositions are left out before counting:
--                 - one of a pair of opposites (`insert_before` beside
--                   `insert_after`; also `from` and `to`, `with` and
--                   `without`, `over` and `under`);
--                 - a `_from` name that takes more arguments than its
--                   siblings, a recursive worker resuming at an index
--                   (`blocks_from` beside `blocks_in`);
--                 - a package's suffix convention: a preposition on three
--                   or more stems, in all the files read, whose annotations
--                   share their first argument's type and their result
--                   (roc-markdown's `*_onto` writers each take a `List(U8)`
--                   and return it), so `run_onto` beside `run_at` is no
--                   split;
--                 - a word the file declares as a keyword of the language
--                   it interprets, in a comment line such as
--                   `# keywords: for, on` (BASIC's `do_for`, `do_on`).
--   command_tense  An effect that takes a tag union whose tags all start
--                 with a past participle and carry no payload
--                 (`pin! : ..., [Pinned, Unpinned]`) names an instruction
--                 like an event. A command is a verb (`[Pin, Unpin]`). A
--                 union with a payload (`[Known(accounts), Unasked]`)
--                 carries state rather than an order. The union may be
--                 written in place or be a type declared in any file
--                 checked, and a `List(T)` argument is checked as `T`.
--   mixed_tense   An effect that takes a tag union (read as for
--                 `command_tense`, payloads included) with a tag starting
--                 with a verb beside one starting with a past participle
--                 (`apply! : [Pin, Unpinned]`): one of them is in the wrong
--                 mood. Only what an effect is handed is checked. A union an
--                 effect returns, a record field and a pure function's
--                 argument hold the domain's words for states (`Redirect`
--                 beside `Found`).
--   container     A type's name (`Entry`, `NodeInfo`) or a record field's
--                 (`items : List(Str)`) made only of container words
--                 (cookbook/words/containers.txt) and vague words. It says
--                 where a value sits, not what it holds. When the container
--                 word is the domain's own, the doc comment above the
--                 declaration says whose it is: `## A folder's entry` keeps
--                 `Entry`, and `## A listing's entries` keeps a field
--                 `entries`. A type's words are split at its capitals, a
--                 field's at its underscores. Fields in a local's annotation
--                 are not read.
--   short_name    A top-level or member name of one letter (`w : F64`). It
--                 is read far from where it is defined, and a local of the
--                 same letter shadows it. Locals and lambda parameters are
--                 not checked.
--   worker_name   A name whose last word says only that it is a helper:
--                 `_acc`, `_loop`, `_inner`, `_helper` or `_rec`
--                 (`count_acc`). Name a recursive worker for the parameter
--                 it adds, so that a call reads as a sentence:
--                 `count_from(xs, at)` for a start point,
--                 `render_onto(out, node)` for an output being built,
--                 `walk_with(tree, seen)` for other carried state. The entry
--                 function takes the plain name, `count`. `_step`, `_walk`
--                 and `_go` are ordinary words too, so they are reported
--                 only on a definition that calls itself.
--   stacked_preposition  A name whose last two words are both prepositions
--                 (cookbook/words/prepositions.txt), like `rest_from_onto`:
--                 a worker's suffix added to an entry name that already ends
--                 in one. Let each read once: the entry says what it returns
--                 (`tail_after`), the worker what it adds (`rest_onto`). A
--                 name made only of prepositions (`at_of`) is not reported,
--                 since its first word serves as a noun.
--   taken_word    A name that is a whole word from cookbook/words/taken.txt:
--                 a function named by one of Roc's own words (`record`,
--                 `tag`, `alias`, `module`), which reads as Roc's rather
--                 than the domain's, or a value named by a number from
--                 `one` to `twelve` (`three : List(Fields)`), which says
--                 how many rather than what it holds. A function that
--                 returns the very thing, its result's last part being the
--                 word capitalized (`record : ApiKey.Key -> ApiKey.Record`),
--                 is fine.
--   bare_participle  A pure function whose whole name is one past participle
--                 (`added`, `joined`, `named`, `chosen`), which reads too
--                 easily as a `Bool`. Name it by a noun for what it gives
--                 (`user_by_name`) or a verb for what it does (`add_user`).
--                 A name of two parts or more (`escaped_text`, `is_added`)
--                 and a value are not reported. An effect named this way is
--                 left to `state_effect`, and a function that gives a `Bool`
--                 to `question`.
--   phrase_name   A pure function, not a constant, whose first word is a
--                 preposition (cookbook/words/prepositions.txt) and which gives
--                 something other than a `Bool`: `in_view`, `on_next_segment`,
--                 `over_gap`. Bare like that it reads as a yes or no and hides
--                 what it gives, and a reader of a definition has often lost
--                 the module's context. Name the thing (`trees_in_view`,
--                 `rider_on_next_segment`), even if that repeats the module.
--                 The type decides what reads as a constructor or conversion,
--                 and these pass:
--                 - a constructor: a first word in CONSTRUCTOR_WORDS and a
--                   result, or a `Try` of one, that is its own module's type
--                   or the type it is a member of (`Clock.at_step : U32 ->
--                   Clock`, `Fraction.from_ratio`). The word matters as well
--                   as the type: `Scene.in_view : View -> Scene` gives its own
--                   type and still reads as a question;
--                 - a conversion: `to_*` and `into_*`, which name what they
--                   give, and a `from_*` whose first argument is its own
--                   module's type (`Along.from_start : Along -> Distance`);
--                 - a changed copy: `with_*` or `without_*` that gives its
--                   first argument's type (`with_lean : Bike, Angle -> Bike`).
--                 A definition with no annotation shows none of this, so it
--                 is reported unless `types=1` supplies its type.
--
-- Each name is judged once: from its annotation when it has one, else from
-- its definition. An effect that takes an effectful function (`map2!`,
-- `on_err!`: an argument's type holds a `=>`, or a lambda argument's name
-- ends in `!`) has its `!` from that callback, so it is judged as the name
-- without the `!`. Names chosen elsewhere are skipped: the methods Roc calls
-- by name (cookbook/roc/headers.shale), and the top-level names a platform
-- dictates, which are what an app's header provides (`app [loaded, step]`)
-- and what a platform's header requires and provides.
--
-- The output is the counts, one line per finding,
-- `path:line: <check>: <why>`, and the counts again
-- (cookbook/roc/findings.shale).
--
-- The word lists are in cookbook/words/, shared with the Zig name hunt.
-- participles.txt lists the irregular past participles; any other word
-- ending in `ed` counts as one unless ed_verbs.txt lists it. With `words=1`
-- the recipe prints a census instead of the findings: each first word the
-- effects start with, how many start with it, and its verdict: `verb`,
-- `participle`, `vague`, `asks` (`is`, `has`) or `refused` (what
-- `noun_effect` reports). A verb missing from verbs.txt shows up there as
-- `refused`.
--
-- With `types=1` the recipe asks Roc's type checker for each definition's
-- type (cookbook/roc/types.shale). It needs `root=` and the tree's
-- `roc-version` file. A root the checker refuses, or a roc-types built for
-- another Roc version, stops the run. A file that no root imports is
-- checked without types, listed after the findings, and fails the run.
--
--   cd <repo> && shale <shale>/cookbook/roc/name_hunt.shale glob=app/*.roc root=app/main.roc types=1
--
-- `self_test=1` runs the recipe over `cookbook/roc/plants/name_hunt/`. Each
-- plant is named for the check it holds (`question.roc`,
-- `question_where.roc`) and must make that check report, and no other. A
-- `quiet_*.roc` plant must make no check report. Every check needs a plant,
-- and a plant named for no check fails the test. The census must also give
-- the right verdict for one known word of the plants per verdict. The
-- plants in `typed/` are checked with the types, from their app
-- `typed/QuietApp.roc`, and their CamelCase module names read as snake case
-- (`QuestionInferred` as `question_inferred`); the rest are checked
-- without. The self-test fails without roc-types.
--
-- The recipe reads each file's source as well as its tree, to tell `->`
-- from `=>`, which the tree writes alike. On a large tree that needs more
-- than the default arena.
-- budget: steps=800000000 arena_bytes=3000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
use("cookbook:roc/findings.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/pinned.shale")
use("cookbook:roc/types.shale")
use("cookbook:roc/declared.shale")
use("cookbook:roc/headers.shale")
use("cookbook:roc/house.shale")
const PLANTS = "cookbook:roc/plants/name_hunt/"
const GLOB = SELF_TEST and (PLANTS .. "*.roc") or arg("glob", "**/*.roc")
const TYPES_ARG = arg("types", "0")
if TYPES_ARG ~= "0" and TYPES_ARG ~= "1" then fail("name_hunt: types=" .. TYPES_ARG .. ": 0 (the default) or 1") end
-- The self-test checks its typed plants with the types, and the rest
-- without.
const USE_TYPES = SELF_TEST or TYPES_ARG == "1"
const ROOT = SELF_TEST and (PLANTS .. "typed/QuietApp.roc") or arg("root", "")
-- The type checker's answers, filled in once the files are known; empty
-- unless USE_TYPES.
const CHECKER_TYPES = {real = {}, pats = {}, exprs = {}, unreached = {}}
const CENSUS_ONLY = arg("words", "") == "1"
const CHECKS = {"state_effect", "question", "vague", "name_type", "negative", "noun_effect", "command_tense", "mixed_tense", "container", "preposition_split", "short_name", "worker_name", "stacked_preposition", "taken_word", "bare_participle", "phrase_name"}
-- `worker_name` reports a helper suffix always, and a suffix that is also an
-- ordinary word (a fold's `step`, `List.walk`, `can_go`) only on a
-- definition that calls itself.
const HELPER_SUFFIXES = {acc = true, loop = true, inner = true, helper = true, rec = true}
const RECURSION_SUFFIXES = {step = true, walk = true, go = true}

const VERBS = word_set("cookbook:words/verbs.txt")
const PARTICIPLES = word_set("cookbook:words/participles.txt")
const ED_VERBS = word_set("cookbook:words/ed_verbs.txt")
const VAGUE = word_set("cookbook:words/vague.txt")
const CONTAINERS = word_set("cookbook:words/containers.txt")
const PREPOSITIONS = word_set("cookbook:words/prepositions.txt")

-- cookbook/words/namespaces.txt has a prefix per line followed by the
-- namespace's own instructions (`port in out`). The result maps each prefix
-- to the set of its instructions: `{port = {["in"] = true, out = true}}`.
function namespace_instructions(file)
  local by_prefix = {}
  for l in word_list_lines("cookbook:words/" .. file) do
    local ws = words(l)
    if #ws > 0 then
      if has_key(by_prefix, ws[1]) then fail("name_hunt: cookbook/words/" .. file .. ": `" .. ws[1] .. "` twice") end
      by_prefix[ws[1]] = set_of(drop(ws, 1))
    end
  end
  return by_prefix
end
const NAMESPACES = namespace_instructions("namespaces.txt")

-- cookbook/words/taken.txt has a word per line followed by its kind, `roc`
-- or `cardinal`. The result maps each word to its kind:
-- `{record = "roc", two = "cardinal"}`.
function taken_word_kinds(file)
  local kinds = {}
  for l in word_list_lines("cookbook:words/" .. file) do
    local ws = words(l)
    if #ws > 0 then
      if #ws ~= 2 or (ws[2] ~= "roc" and ws[2] ~= "cardinal") or has_key(kinds, ws[1]) then fail("name_hunt: cookbook/words/" .. file .. ": `" .. join(ws, " ") .. "` is no new word with its kind, `roc` or `cardinal`") end
      kinds[ws[1]] = ws[2]
    end
  end
  return kinds
end
const TAKEN_WORDS = taken_word_kinds("taken.txt")
const SURFACES = {Frame = true, Canvas = true}
-- The first words `phrase_name` lets a constructor start with. They are the
-- ones constructors use in safari, roc-chat and roc-markdown: `Clock.at_step`,
-- `Dm.between`, `SignedIn.by_session`, `MdText.for_input`,
-- `Fraction.from_ratio`, `Name.of_strict`, `Directory.with_founder`.
const CONSTRUCTOR_WORDS = set_of({"at", "between", "by", "for", "from", "of", "with"})
const CONVERSION_WORDS = set_of({"into", "to"})
const CHANGED_COPY_WORDS = set_of({"with", "without"})
-- The names in each file that end in a preposition, grouped by the stem
-- before it. Each key is `path|stem`, each value `{path, line, stem,
-- prepositions}`, and `prepositions` maps each preposition to the first
-- name using it and that name's arity.
const PREPOSITIONS_BY_STEM = {}
-- The stems each trailing preposition is put on, across all the files read,
-- grouped by the preposition and the shape of the annotation: its first
-- argument's type and its result. Each key is `preposition|first|result`,
-- each value a set of stems. A preposition reaching CONVENTION_STEMS stems
-- of one shape goes into SUFFIX_CONVENTIONS. Counting stems by preposition
-- alone, or by result alone, would make a common preposition (`_of`) a
-- convention in any large package.
const STEMS_BY_SHAPE = {}
const CONVENTION_STEMS = 3
const SUFFIX_CONVENTIONS = {}
-- The keywords each file declares (`# keywords: for, on`), by path.
const DECLARED_KEYWORDS = {}
const ENTRY_POINT_NAMES = {handle = true, run = true, main = true}
const INTEGER_TYPES = {U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true}

-- The tag union each type declaration names, by the type's name: `Edit` of
-- `Edit : [Opened, Closed]` maps to its `union_shape`.
const TAG_UNION_TYPES = {}
-- The aliases of `Bool` declared in the files read, by each name the type
-- checker may write for them (`Answer`, `Owner.Answer`).
const BOOL_ALIASES = {}

-- Every type name and record field name that `container` checks, each
-- `{path, line, name, words, is_field, doc}`, where `doc` is the comment
-- lines above its declaration, lowercased.
const TYPE_AND_FIELD_NAMES = {}

const count_by_check = {}
for c in CHECKS do count_by_check[c] = 0 end
-- The set of `path|check` pairs where the check reported, for the self-test.
const fired_in_file = {}
-- Each first word an effect starts with, mapped to `{word, count, verdict}`.
const first_word_census = {}
const finding_lines = {}

function report(path, line, check, why)
  if house_leaves_out("name_hunt", check) then return nil end
  if not CENSUS_ONLY then push(finding_lines, path .. ":" .. line .. ": " .. check .. ": " .. why) end
  count_by_check[check] = count_by_check[check] + 1
  fired_in_file[path .. "|" .. check] = true
  return nil
end

function is_participle(word)
  if has_key(PARTICIPLES, word) then return true end
  return #word > 3 and ends_with(word, "ed") and not has_key(ED_VERBS, word)
end

for word in keys(VERBS) do
  if is_participle(word) then fail("name_hunt: `" .. word .. "` is in cookbook/words/verbs.txt and reads as a participle, which would make its effects states") end
end

-- What an effect's first word says: `participle`, `verb`, `vague`, `asks`
-- (`is`, `has`) or `refused`.
function first_word_verdict(word)
  if is_participle(word) then return "participle" end
  if has_key(VERBS, word) then return "verb" end
  if has_key(VAGUE, word) then return "vague" end
  if word == "is" or word == "has" then return "asks" end
  return "refused"
end

-- ── the syntax tree ──────────────────────────────────────────────────────

-- The source text of the node at `at`, from the file's lines `src`. A
-- node's end column is one past its last character.
function span_text(src, tree, at)
  local node = tree[at]
  if node.line == 0 then return "" end
  if node.line == node.end_line then return sub(src[node.line], node.col, node.end_col - 1) end
  local parts = {sub(src[node.line], node.col)}
  for l = node.line + 1, node.end_line - 1 do push(parts, src[l]) end
  push(parts, sub(src[node.end_line], 1, node.end_col - 1))
  return join(parts, "\n")
end

-- The tags of the tag union at `at`, as `{names, payload}`: `names` lists
-- the tag names (`Unpinned` for `Unpinned(Str)` too), and `payload` says
-- whether any tag carries one.
function union_shape(tree, at)
  local shape = {names = {}, payload = false}
  for t in children(tree, at) do
    if tree[t].kind == "tags" then
      for tag in children(tree, t) do
        local name = attribute(tree, tag, "name")
        if tree[tag].kind == "ty-apply" then
          shape.payload = true
          name = attribute(tree, children(tree, tag)[1], "name")
        end
        if name ~= "" then push(shape.names, name) end
      end
    end
  end
  return shape
end

-- An argument's type, as `command_tense` and `mixed_tense` need it:
-- `{union}` for a tag union written in place, `{ref}` for a named type
-- (its last part: `ChatState.PinEdit` gives `PinEdit`), or `{}`. A
-- `List(T)` gives the shape of `T`, with `list` set.
function argument_shape(tree, at)
  local kind = tree[at].kind
  if kind == "ty-tag-union" then return {union = union_shape(tree, at)} end
  if kind == "ty-apply" then
    local kids = children(tree, at)
    if #kids == 2 and attribute(tree, kids[1], "name") == "List" then
      local element = argument_shape(tree, kids[2])
      element.list = true
      return element
    end
    return {}
  end
  local name = attribute(tree, at, "name")
  if name == "" then return {} end
  local parts = split(name, ".")
  return {ref = parts[#parts]}
end

-- The names of the types the type at `at` mentions, added to the set
-- `into`, each by its last part (`Draw.RoundedRectangle` gives
-- `RoundedRectangle`).
function mentioned_type_names(tree, at, into)
  local name = attribute(tree, at, "name")
  if starts_with(tree[at].kind, "ty") and name ~= "" then
    local parts = split(name, ".")
    into[parts[#parts]] = true
  end
  for c in children(tree, at) do mentioned_type_names(tree, c, into) end
  return into
end

-- Words joined as one type name: `rounded`, `rectangle` gives
-- `RoundedRectangle`.
function camel_case(ws)
  local out = ""
  for w in ws do out = out .. upper(sub(w, 1, 1)) .. sub(w, 2) end
  return out
end

-- The sibling just before the node at `at`, or 0.
function previous_sibling(tree, at)
  local parent = tree[at].parent
  if parent == 0 then return 0 end
  local previous = 0
  for k in tree[parent].kids do
    if k == at then return previous end
    previous = k
  end
  return 0
end

-- Whether the definition at `at` mentions `name` in its body, as an
-- identifier (`name`, `Tree.name`) or a method call (`x.name(...)`). A
-- node's descendants follow it in the tree, each deeper than it.
function calls_itself(tree, at, name)
  local j = at + 1
  while j <= #tree and tree[j].depth > tree[at].depth do
    local node = tree[j]
    if node.kind == "e-ident" then
      local raw = attribute(tree, j, "raw")
      if raw == name or ends_with(raw, "." .. name) then return true end
    end
    if node.kind == "e-method-call" and attribute(tree, j, "method") == name then return true end
    j = j + 1
  end
  return false
end

-- The keywords a file declares in a comment line `# keywords: for, on`,
-- added to DECLARED_KEYWORDS.
function note_declared_keywords(path, src)
  for l in src do
    local found = re_find(trim(l), "^# keywords: (.*)$")
    if found ~= nil then
      for w in split(found.groups[1], ",") do
        if trim(w) ~= "" then push_at(DECLARED_KEYWORDS, path, lower(trim(w))) end
      end
    end
  end
  return nil
end

-- Notes what the type declaration at `i` declares: its tag union in
-- TAG_UNION_TYPES, its name in TYPE_AND_FIELD_NAMES, and in BOOL_ALIASES
-- when it is an alias of `Bool`, under its bare name and, for a module
-- type's member, `Owner.Name` as the checker writes it.
function note_type_declaration(path, src, tree, i)
  local kids = children(tree, i)
  local declared = #kids > 0 and attribute(tree, kids[1], "name") or ""
  if declared == "" then return nil end
  local line = tostring(tree[i].line)
  if #kids > 1 and tree[kids[2]].kind == "ty-tag-union" then TAG_UNION_TYPES[declared] = union_shape(tree, kids[2]) end
  push(TYPE_AND_FIELD_NAMES, {path = path, line = line, name = declared, words = name_words(declared), is_field = false, doc = doc_above(src, tree[i].line)})
  if #kids > 1 and tree[kids[2]].kind == "ty" and attribute(tree, kids[2], "name") == "Bool" then
    BOOL_ALIASES[declared] = true
    local parent = tree[i].parent
    if parent > 0 and tree[parent].kind == "associated" and tree[parent].parent > 0 then
      local owner_kids = children(tree, tree[parent].parent)
      local owner = #owner_kids > 0 and attribute(tree, owner_kids[1], "name") or ""
      if owner ~= "" then BOOL_ALIASES[owner .. "." .. declared] = true end
    end
  end
  return nil
end

-- The top-level annotation at `i`, as a definition record, or nil when it
-- is only a `where` clause. `whole` is its type rendered, and `result` the
-- type it returns. A function's record also has `arity` and `first` (its
-- first argument's type), and an effect's has `types`, the type names its
-- annotation mentions, and `args`, each argument's `argument_shape`.
-- `callback` says it takes an effectful function, an argument whose source
-- holds `=>`.
function annotation_definition(path, src, tree, i)
  local def = {path = path, line = tostring(tree[i].line), name = attribute(tree, i, "name"), owner = owner_of(tree, i), annotation = true, fn = false, callback = false, paired = false}
  local kids = children(tree, i)
  if #kids == 0 or tree[kids[1]].kind == "where" then return nil end
  def.whole = render_type(tree, kids[1])
  def.result = def.whole
  if tree[kids[1]].kind == "ty-fn" then
    local parts = children(tree, kids[1])
    local is_effect = ends_with(def.name, "!")
    def.fn = true
    def.arity = #parts - 1
    def.result = render_type(tree, parts[#parts])
    def.first = #parts > 1 and render_type(tree, parts[1]) or ""
    if is_effect then
      def.types = mentioned_type_names(tree, kids[1], {})
      def.args = {}
    end
    for a in take(parts, #parts - 1) do
      if contains(span_text(src, tree, a), "=>") then def.callback = true end
      if is_effect then push(def.args, argument_shape(tree, a)) end
    end
  end
  return def
end

-- The top-level definition `name = ...` at `i`, as a definition record, or
-- nil when its pattern is not a plain name. `lambda` says its value is a
-- lambda, `callback` that a lambda argument's name ends in `!`, `recurses`
-- (for a name ending in a RECURSION_SUFFIXES word) that it calls itself,
-- and `typed` is the checker's type when there is one.
function value_definition(path, tree, i)
  local kids = children(tree, i)
  if #kids == 0 or tree[kids[1]].kind ~= "p-ident" then return nil end
  local def = {path = path, line = tostring(tree[i].line), name = attribute(tree, kids[1], "raw"), owner = owner_of(tree, i), annotation = false, fn = false, callback = false, paired = false}
  if #kids > 1 and tree[kids[2]].kind == "e-lambda" then
    def.lambda = true
    for part in children(tree, kids[2]) do
      if tree[part].kind == "args" then
        for a in children(tree, part) do
          if ends_with(attribute(tree, a, "raw"), "!") then def.callback = true end
        end
      end
    end
  end
  local ws = split(ends_with(def.name, "!") and sub(def.name, 1, #def.name - 1) or def.name, "_")
  if #ws > 1 and has_key(RECURSION_SUFFIXES, ws[#ws]) then def.recurses = calls_itself(tree, i, def.name) end
  if USE_TYPES and has_key(CHECKER_TYPES.real, path) then
    local checker_type = roc_type_at(CHECKER_TYPES, "pat", path, tree[kids[1]])
    if checker_type ~= nil then def.typed = checker_type end
  end
  return def
end

-- Whether the definition at `i` is a top-level name its file's header dictates.
function is_dictated(tree, i, def, dictated)
  return has_key(dictated, def.name) and owner_of(tree, i) == ""
end

-- Every top-level and module-member annotation and definition in the parsed
-- files, as definition records `{path, line, name, annotation, fn,
-- callback, paired, ...}`. A definition whose annotation is just above it
-- is `paired`, and the annotation then gets `has_def`, the definition's
-- `typed` and its `callback`. Along the way this fills DECLARED_KEYWORDS,
-- TAG_UNION_TYPES, BOOL_ALIASES and TYPE_AND_FIELD_NAMES.
function read_definitions(parsed_files)
  local definitions = {}
  for f in parsed_files do
    local path = f.path
    local tree = f.nodes
    local src = split(read(path), "\n")
    note_declared_keywords(path, src)
    local dictated = header_names(tree).dictated
    -- Each node is outer when it and every ancestor sit in OUTER_KINDS, and
    -- its `declaration_line` is its line when it is an outer annotation or
    -- type declaration, else "". A parent comes before its children.
    local outer = {}
    local declaration_line = {}
    -- The definition record of each annotation, by the node's index.
    local annotation_records = {}
    for i = 1, #tree do
      local node = tree[i]
      local parent = node.parent
      push(outer, parent == 0 or (outer[parent] and has_key(OUTER_KINDS, tree[parent].kind)))
      local kind = node.kind
      push(declaration_line, (outer[i] and (kind == "s-type-anno" or kind == "s-type-decl")) and tostring(node.line) or "")
      if outer[i] and kind == "s-type-decl" then note_type_declaration(path, src, tree, i) end
      if kind == "anno-record-field" then
        local at = field_declaration_line(tree, declaration_line, i)
        local field = attribute(tree, i, "name")
        if at ~= "" and field ~= "" then push(TYPE_AND_FIELD_NAMES, {path = path, line = tostring(node.line), name = field, words = name_words(field), is_field = true, doc = doc_above(src, tonumber(at))}) end
      end
      if outer[i] and kind == "s-type-anno" then
        local def = annotation_definition(path, src, tree, i)
        if def ~= nil and not is_dictated(tree, i, def, dictated) then
          push(definitions, def)
          annotation_records[tostring(i)] = def
        end
      end
      if outer[i] and kind == "s-decl" then
        local def = value_definition(path, tree, i)
        if def ~= nil and not is_dictated(tree, i, def, dictated) then
          local above = get(annotation_records, tostring(previous_sibling(tree, i)))
          if above ~= nil and above.name == def.name then
            def.paired = true
            above.has_def = true
            if has_key(def, "typed") then above.typed = def.typed end
            if def.callback then above.callback = true end
          end
          push(definitions, def)
        end
      end
    end
  end
  return definitions
end

-- ── the checks ───────────────────────────────────────────────────────────

-- A tag's first word, lowercased: `Unpinned` gives `unpinned`, `AddedTo`
-- gives `added`.
function tag_first_word(tag)
  local word = lower(sub(tag, 1, 1))
  local k = 2
  while k <= #tag and sub(tag, k, k) == lower(sub(tag, k, k)) do
    word = word .. sub(tag, k, k)
    k = k + 1
  end
  return word
end

function all_tags_past(tags)
  for t in tags do
    if not is_participle(tag_first_word(t)) then return false end
  end
  return true
end

-- The first argument in a function type's argument text, `a, b`.
function first_argument(args)
  local depth = 0
  for i = 1, #args do
    local ch = sub(args, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    if depth == 0 and ch == "," then return trim(sub(args, 1, i - 1)) end
  end
  return trim(args)
end

-- What a definition's type says, for `question`, `taken_word` and
-- `phrase_name`: `{is_function, first, result, known, source_note}`. The type
-- is the checker's when it gave one, else the annotation's. `known` is false
-- for a definition with no annotation and no checker's type.
function definition_signature(def)
  local signature = {is_function = def.annotation and def.fn, first = get(def, "first", ""), result = get(def, "result", ""), known = def.annotation, source_note = ""}
  if has_key(def, "typed") then
    local checker = roc_type_parts(def.typed)
    signature = {is_function = checker.fn, first = first_argument(checker.args), result = checker.result, known = true, source_note = " (the checker's type)"}
    if has_key(BOOL_ALIASES, checker.result) then signature.result = "Bool" end
  end
  return signature
end

-- Whether `type_text` names the module `def` is in, or the type it is a
-- member of. Type arguments don't count: `Bike.Motion(others)` is `Motion`.
function is_own_type(def, type_text)
  local head = re_find(type_text, "^[A-Za-z0-9_.]+")
  if head == nil then return false end
  local name = last_part(head.text)
  return name == module_name(def.path) or name == def.owner
end

-- `Try(Fraction, [OutOfRange])` gives `Fraction`, and any other type itself.
function success_type(type_text)
  local ok_type = re_find(type_text, "^Try\\(([A-Za-z0-9_.]+)")
  return ok_type ~= nil and ok_type.groups[1] or type_text
end

-- Whether a function that starts with the preposition `word` reads as a
-- constructor, a conversion or a changed copy: `phrase_name` in the header.
function reads_as_maker(def, word, signature)
  if has_key(CONVERSION_WORDS, word) then return true end
  if has_key(CHANGED_COPY_WORDS, word) and signature.result == signature.first then return true end
  if word == "from" and is_own_type(def, signature.first) then return true end
  return has_key(CONSTRUCTOR_WORDS, word) and is_own_type(def, success_type(signature.result))
end

-- Notes a name that ends in a preposition, for `preposition_split`, in
-- PREPOSITIONS_BY_STEM and, when it is an annotated function, in
-- STEMS_BY_SHAPE and SUFFIX_CONVENTIONS.
function note_trailing_preposition(def, ws)
  local preposition = ws[#ws]
  local stem = join(take(ws, #ws - 1), "_")
  local key = def.path .. "|" .. stem
  if not has_key(PREPOSITIONS_BY_STEM, key) then PREPOSITIONS_BY_STEM[key] = {path = def.path, line = def.line, stem = stem, prepositions = {}} end
  local group = PREPOSITIONS_BY_STEM[key]
  if def.annotation and def.fn then
    local shape_key = preposition .. "|" .. def.first .. "|" .. def.result
    if not has_key(STEMS_BY_SHAPE, shape_key) then STEMS_BY_SHAPE[shape_key] = {} end
    STEMS_BY_SHAPE[shape_key][stem] = true
    if #keys(STEMS_BY_SHAPE[shape_key]) >= CONVENTION_STEMS then SUFFIX_CONVENTIONS[preposition] = true end
  end
  if not has_key(group.prepositions, preposition) then
    group.prepositions[preposition] = {name = def.name, arity = get(def, "arity", -1)}
  end
  return nil
end

-- Reports what each check finds in one definition record, except
-- `container` and `preposition_split`, which are judged over all the files
-- afterwards.
function judge_definition(def)
  local path = def.path
  local line = def.line
  local full_name = def.name
  if has_key(LANGUAGE_FIXED_NAMES, full_name) then return nil end
  local has_bang = ends_with(full_name, "!")
  local name = has_bang and sub(full_name, 1, #full_name - 1) or full_name
  local is_effect = has_bang and not def.callback
  local ws = split(name, "_")
  local last_word = ws[#ws]
  local is_annotation = def.annotation
  -- A definition paired with an annotation was judged at the annotation.
  local judged_here = not def.paired
  local asks_inside = contains(name, "_is_") or contains(name, "_has_")
  local has_namespace = is_effect and #ws > 1 and has_key(NAMESPACES, ws[1])
  local act_word = has_namespace and ws[2] or ws[1]
  local act_verdict = first_word_verdict(act_word)
  if has_namespace and act_verdict == "refused" and has_key(NAMESPACES[ws[1]], act_word) then act_verdict = "verb" end
  local act_place = has_namespace and ("the word after its namespace `" .. ws[1] .. "_`") or "its first word"
  local named_as_state = is_participle(act_word) and not asks_inside
  if is_effect and judged_here then
    if not has_key(first_word_census, act_word) then first_word_census[act_word] = {word = act_word, count = 0, verdict = act_verdict} end
    first_word_census[act_word].count = first_word_census[act_word].count + 1
  end
  local arguments = get(def, "args") or {}
  local draws_on_surface = #arguments > 0 and has_key(SURFACES, get(arguments[1], "ref", ""))
  if is_effect and judged_here and act_verdict == "refused" and not draws_on_surface then
    if has_key(PREPOSITIONS, act_word) then report(path, line, "noun_effect", "`" .. full_name .. "` has an effect but " .. act_place .. " is a preposition, `" .. act_word .. "`: an effect is named for its act")
    else report(path, line, "noun_effect", "`" .. full_name .. "` has an effect but " .. act_place .. ", `" .. act_word .. "`, is no verb: it reads as a value, not an act") end
  end
  if judged_here and #ws > 1 and has_key(PREPOSITIONS, last_word) then note_trailing_preposition(def, ws) end
  local names_drawn_type = #ws > 1 and has_key(get(def, "types") or {}, camel_case(ws))
  if is_effect and judged_here and named_as_state and not names_drawn_type then report(path, line, "state_effect", "`" .. full_name .. "` has an effect but is named as a state, `" .. act_word .. "`: a verb says what it does") end
  local named_as_question = #ws > 1 and (ws[1] == "is" or ws[1] == "has" or ws[1] == "can" or ws[1] == "should")
  local signature = definition_signature(def)
  local returns_bool = signature.is_function and signature.result == "Bool"
  if named_as_question and judged_here and is_effect and not returns_bool then report(path, line, "question", "`" .. full_name .. "` asks a question but has an effect" .. (signature.is_function and (" and gives `" .. signature.result .. "`" .. signature.source_note) or "")) end
  if returns_bool and named_as_state and judged_here then report(path, line, "question", "`" .. full_name .. "` gives a `Bool`" .. signature.source_note .. " but is named as a state, `" .. ws[1] .. "`: ask it (`is_*`, `has_*`)") end
  if named_as_question and judged_here and signature.known and signature.is_function and not is_effect and signature.result ~= "Bool" and signature.result ~= "_" then report(path, line, "question", "`" .. full_name .. "` asks a question but gives `" .. signature.result .. "`" .. signature.source_note) end
  if judged_here then
    local all_vague = true
    for w in ws do
      if not has_key(VAGUE, w) then all_vague = false end
    end
    if #ws == 1 and has_key(ENTRY_POINT_NAMES, ws[1]) then all_vague = false end
    if all_vague then report(path, line, "vague", "`" .. full_name .. "` is only vague words: what does it handle, and how?") end
    if #name == 1 then report(path, line, "short_name", "`" .. full_name .. "` is one letter, read far from where it is defined: name what it holds") end
    local has_leading_noun = false
    for w in take(ws, max(#ws - 2, 0)) do
      if not has_key(PREPOSITIONS, w) then has_leading_noun = true end
    end
    if has_leading_noun and has_key(PREPOSITIONS, last_word) and has_key(PREPOSITIONS, ws[#ws - 1]) then report(path, line, "stacked_preposition", "`" .. full_name .. "` stacks two prepositions, `_" .. ws[#ws - 1] .. "_" .. last_word .. "`: let each read once, the entry named for what it gives (`rest`, `tail_after`) and the worker for what it adds (`rest_onto`)") end
    -- A function is known by its type, else by a lambda definition; a value
    -- by a type that is no function, else by a definition that is no
    -- lambda. An inferred annotation (`two : _`) with no checker's type is
    -- neither.
    local has_type = signature.known and not (is_annotation and get(def, "whole", "") == "_" and not has_key(def, "typed"))
    local is_lambda = get(def, "lambda", false)
    local is_function = signature.is_function or (not signature.known and is_lambda)
    local is_value = (has_type and not signature.is_function) or (not signature.known and not is_lambda)
    local taken_kind = get(TAKEN_WORDS, name, "")
    if taken_kind == "roc" and is_function then
      local result_parts = split(signature.result, ".")
      local returns_the_word = signature.is_function and result_parts[#result_parts] == camel_case({name})
      if not returns_the_word then report(path, line, "taken_word", "`" .. full_name .. "` is Roc's own word, `" .. name .. "`, for a function that gives no `" .. camel_case({name}) .. "`: name it for the domain's thing (`element`, `append`), and keep Roc's words for Roc") end
    end
    if taken_kind == "cardinal" and is_value then report(path, line, "taken_word", "`" .. full_name .. "` is a number's name for a value: it says how many, not what it holds") end
    -- An effect so named is `state_effect`'s, and a function so named that
    -- gives a `Bool` is `question`'s, so this check takes the rest.
    if not has_bang and #ws == 1 and is_participle(name) and is_function and not returns_bool then report(path, line, "bare_participle", "`" .. full_name .. "` is a function named by a bare past participle, which reads as a `Bool`: name it by a noun for what it gives (`user_by_name`) or a verb for what it does (`add_user`)") end
    -- An effect is `noun_effect`'s, and a result of `_` says nothing.
    if not has_bang and has_key(PREPOSITIONS, ws[1]) and is_function and not returns_bool and signature.result ~= "_" and not reads_as_maker(def, ws[1], signature) then
      local gives = signature.known and ("gives `" .. signature.result .. "`" .. signature.source_note) or "has no annotation to show it makes its own type"
      report(path, line, "phrase_name", "`" .. full_name .. "` starts with a preposition, `" .. ws[1] .. "`, and " .. gives .. ": bare, it reads as a yes or no and hides what it gives; name the thing (`trees_in_view`, not `in_view`)")
    end
  end
  -- `worker_name` is judged at the definition, which knows whether it calls
  -- itself, and at an annotation only when no definition follows it, as
  -- with a hosted effect.
  local annotation_alone = is_annotation and not get(def, "has_def", false)
  local helper_suffix = has_key(HELPER_SUFFIXES, last_word) and (annotation_alone or not is_annotation)
  local recursion_suffix = has_key(RECURSION_SUFFIXES, last_word) and get(def, "recurses", false)
  if #ws > 1 and (helper_suffix or recursion_suffix) then report(path, line, "worker_name", "`" .. full_name .. "` is named only as a helper, `_" .. last_word .. "`: name the worker for the parameter it adds (`_from` a start point, `_onto` an output built, `_with` other carried state) and give the entry function the plain name") end
  if is_annotation and not def.fn and def.whole ~= "_" then
    local annotated_type = def.whole
    if last_word == "count" and not has_key(INTEGER_TYPES, annotated_type) then report(path, line, "name_type", "`" .. full_name .. "` is a count of type `" .. annotated_type .. "`") end
    if last_word == "path" and annotated_type ~= "Str" and not contains(annotated_type, "Path") then report(path, line, "name_type", "`" .. full_name .. "` is a path of type `" .. annotated_type .. "`") end
    if annotated_type == "Bool" and (ws[1] == "no" or ws[1] == "not") and #ws > 1 then report(path, line, "negative", "`" .. full_name .. "` is a negative flag: `" .. full_name .. " = Bool.false` reads twice") end
  end
  if is_annotation and is_effect and def.fn then
    for argument in arguments do
      local union = get(argument, "union")
      local ref = get(argument, "ref")
      if union == nil and ref ~= nil then union = get(TAG_UNION_TYPES, ref) end
      if union ~= nil then
        local shown = (get(argument, "list") and "a list of " or "") .. "`[" .. join(union.names, ", ") .. "]`"
        if not union.payload and #union.names >= 2 and all_tags_past(union.names) then report(path, line, "command_tense", "`" .. full_name .. "` takes " .. shown .. ", an instruction named like an event: name its tags as commands (`Pinned` is `Pin`)") end
        local command_tags = {}
        local event_tags = {}
        for t in union.names do
          local w = tag_first_word(t)
          if is_participle(w) then push(event_tags, t) elseif has_key(VERBS, w) then push(command_tags, t) end
        end
        if #command_tags > 0 and #event_tags > 0 then report(path, line, "mixed_tense", "`" .. full_name .. "` takes " .. shown .. ": commands (" .. join(command_tags, ", ") .. ") beside events (" .. join(event_tags, ", ") .. "): name what it is told to do in one mood") end
      end
    end
  end
  if is_annotation and #ws > 2 and ws[1] == "is" and ws[2] == "not" then report(path, line, "negative", "`" .. full_name .. "` asks a negative: `!" .. full_name .. "(...)` reads twice") end
  return nil
end

local paths = glob(GLOB)
if SELF_TEST then
  for q in glob(PLANTS .. "typed/*.roc") do push(paths, q) end
end
local file_count = #paths
-- The self-test's untyped plants are imported by no root.
const UNTYPED_PLANTS = SELF_TEST and set_of(glob(PLANTS .. "*.roc")) or {}
if USE_TYPES then
  local got = roc_types_for_files("name_hunt", ROOT, roc_bin("name_hunt", SELF_TEST), paths, UNTYPED_PLANTS)
  CHECKER_TYPES.real = got.real
  CHECKER_TYPES.pats = got.pats
  CHECKER_TYPES.exprs = got.exprs
  CHECKER_TYPES.unreached = got.unreached
end
local parsed = parse_roc_files(paths)
-- This loop does not `yield`, because a yield may keep only 1 MiB, and a
-- large tree's definitions pass that. The arena in the header holds them.
for def in read_definitions(parsed.files) do
  judge_definition(def)
end

-- Whether a doc says whose a container word is (`a folder's entry`, `a
-- listing's entries`), in the word's singular or plural.
function doc_says_whose(doc, word)
  local forms = {word, word .. "s"}
  if ends_with(word, "ies") then push(forms, sub(word, 1, #word - 3) .. "y") end
  if ends_with(word, "y") then push(forms, sub(word, 1, #word - 1) .. "ies") end
  if ends_with(word, "s") then push(forms, sub(word, 1, #word - 1)) end
  for form in forms do
    if contains(doc, "'s " .. form) then return true end
  end
  return false
end

for named in TYPE_AND_FIELD_NAMES do
  local only_container_words = #named.words > 0
  local doc_owns_it = false
  for w in named.words do
    if not has_key(VAGUE, w) and not has_key(CONTAINERS, w) then only_container_words = false end
    if doc_says_whose(named.doc, w) then doc_owns_it = true end
  end
  if only_container_words and not doc_owns_it then report(named.path, named.line, "container", (named.is_field and "the field `" or "the type `") .. named.name .. "` is only container words: name it for what it holds, or say whose it is in its doc (`## A folder's entry`)") end
end

const OPPOSITE_PAIRS = {["after|before"] = true, ["from|to"] = true, ["with|without"] = true, ["over|under"] = true}

for key in sort(keys(PREPOSITIONS_BY_STEM)) do
  local group = PREPOSITIONS_BY_STEM[key]
  local fewest_arguments = -1
  for preposition in keys(group.prepositions) do
    local arity = group.prepositions[preposition].arity
    if arity >= 0 and (fewest_arguments < 0 or arity < fewest_arguments) then fewest_arguments = arity end
  end
  local split_names = {}
  local split_prepositions = {}
  for preposition in sort(keys(group.prepositions)) do
    local first_use = group.prepositions[preposition]
    local is_from_worker = preposition == "from" and fewest_arguments >= 0 and first_use.arity > fewest_arguments
    local is_convention = has_key(SUFFIX_CONVENTIONS, preposition)
    local is_keyword = has_item(get(DECLARED_KEYWORDS, group.path, {}), preposition)
    if not is_from_worker and not is_convention and not is_keyword then
      push(split_names, first_use.name)
      push(split_prepositions, preposition)
    end
  end
  local is_opposite_pair = #split_names == 2 and get(OPPOSITE_PAIRS, join(split_prepositions, "|"), false)
  if #split_names > 1 and not is_opposite_pair then report(group.path, group.line, "preposition_split", "`" .. group.stem .. "` takes " .. #split_names .. " prepositions here (" .. join(split_names, ", ") .. "): one relation keeps one preposition, or the names say how they differ") end
end

if CENSUS_ONLY then
  local rows = {}
  local effects_by_verdict = {}
  local total = 0
  for w in keys(first_word_census) do
    local row = first_word_census[w]
    push(rows, row)
    effects_by_verdict[row.verdict] = get(effects_by_verdict, row.verdict, 0) + row.count
    total = total + row.count
  end
  sort(rows, {{key = "count", desc = true}, "word"})
  local census_lines = {}
  for r in rows do push(census_lines, pad(r.count, -4) .. " " .. pad(r.word, 12) .. " " .. r.verdict) end
  local verdict_counts = {}
  for v in {"verb", "participle", "vague", "asks", "refused"} do push(verdict_counts, v .. " " .. get(effects_by_verdict, v, 0)) end
  print_findings("name_hunt (Roc) census: " .. file_count .. " files; " .. total .. " effects, " .. #rows .. " first words; effects by verdict: " .. join(verdict_counts, ", "), census_lines)
else
  local check_counts = {}
  for c in CHECKS do push(check_counts, c .. " " .. count_by_check[c]) end
  print_findings("name_hunt (Roc): " .. file_count .. " files; " .. join(check_counts, ", ") .. house_note("name_hunt"), finding_lines)
end
fail_if_refused("name_hunt", parsed.refused, CHECKER_TYPES.unreached)

-- A plant's name relative to PLANTS. A typed plant is a CamelCase module
-- (`typed/QuestionInferred.roc`), and its name is given in snake case
-- (`question_inferred.roc`).
function plant_name(path)
  local name = sub(path, #PLANTS + 1)
  if starts_with(name, "typed/") then return snake_case_plant_name(sub(name, 7)) end
  return name
end

function plant_is_for(plant, check)
  return plant == check .. ".roc" or starts_with(plant, check .. "_")
end

if SELF_TEST then
  -- Every plant is judged before the test fails, so one run shows each
  -- plant that is wrong.
  local wrong = {}
  for c in CHECKS do
    local planted = 0
    for path in paths do
      local is_its_plant = plant_is_for(plant_name(path), c)
      if is_its_plant then planted = planted + 1 end
      local fired = has_key(fired_in_file, path .. "|" .. c)
      if is_its_plant and not fired then push(wrong, "`" .. c .. "` does not fire on its plant " .. path) end
      if fired and not is_its_plant then push(wrong, "`" .. c .. "` fires on " .. path .. ", another check's plant") end
    end
    if planted == 0 then push(wrong, "`" .. c .. "` has no plant") end
  end
  -- A plant named for no check could never fail.
  for path in paths do
    local plant = plant_name(path)
    local is_named = starts_with(plant, "quiet_")
    for c in CHECKS do
      if plant_is_for(plant, c) then is_named = true end
    end
    if not is_named then push(wrong, path .. ": a plant the table does not judge") end
  end
  for expected in {{word = "read", verdict = "verb"}, {word = "held", verdict = "participle"}, {word = "process", verdict = "vague"}, {word = "links", verdict = "refused"}} do
    local got = get(first_word_census, expected.word)
    if got == nil then push(wrong, "the census has no `" .. expected.word .. "`")
    elseif got.verdict ~= expected.verdict then push(wrong, "the census calls `" .. expected.word .. "` " .. got.verdict .. ", not " .. expected.verdict) end
  end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("name_hunt self_test: " .. #wrong .. " plants wrong") end
  print("name_hunt (Roc) self_test: PASS (each check fires on its plants alone, the quiet_ plants on none, and the census gives each verdict its known word)")
end
