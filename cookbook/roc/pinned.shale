-- Each repository names its Roc version in a `roc-version` file. This
-- library finds that version's `roc` for the Roc recipes that run the
-- compiler. The version matters because `roc fmt`'s layout and the
-- compiler's method lookup change from one nightly to the next.

-- Every recipe's self-test runs this Roc. CI installs it from roc-apps's release.
const SELF_TEST_PIN = "nightly-2026-10-30-0602c5f"

-- The pin comes from the `roc-version` file where the run starts, or is
-- `SELF_TEST_PIN` in a self-test. `who` names the recipe when it stops.
function roc_bin(who, self_test)
  local pin = SELF_TEST_PIN
  if not self_test then
    if not exists("roc-version") then fail(who .. ": no roc-version where the run starts: run it from the repository's root, whose roc-version pins its Roc") end
    pin = trim(read("roc-version"))
  end
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail(who .. ": no " .. roc .. ": install Roc " .. pin .. " into ~/tools/roc-" .. pin .. "/ (roc-apps's toolchain release carries it)") end
  return real(roc)
end
