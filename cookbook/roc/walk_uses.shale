-- How `cookbook/roc/type_walk.shale` resolves a type's name and finds a
-- type's members, and how many files use each member of the asked module's
-- types. Resolving reads only files the walk has read already (`st.files`).
--
--   use("cookbook:roc/walk_uses.shale")
--   load_files(st, paths), load_imports(st)
--                             parse files into `st.files` and `st.types`
--   package_folders(root, given, trees), own_packages(st, tree, path)
--                             where a file's `import pkg.Module` reads from
--   client_files(text, skip), then clients_line(st, paths, start, root_files)
--                             the files `clients=` names, and their apps
--   clients_missing_apps(st, root, client_paths)
--                             the apps beside a package that `clients=` leaves out
--   resolve(st, info, name)   what a type name written in a file refers to
--   members_of(tree, at)      the annotations in a type's block
--   source_text(src, ...), doc_lines_above(src, line)
--                             a declaration's text, and its doc
--   private_signatures(st, start), public_names(st, start)
--                             a family member's private functions, and its
--                             public names with the error tags each answers
--   test_context(info)     where each node sits, and the values only expects use
--   in_tests(fc, c)        whether a node there is in tests
--   test_only_imports(st, info)
--                          a file's imports that only its tests use
--   asked_members(st, start), then count_uses(st, info, start) for each other
--   file, then uses_note(rec, app_of), unused_members(st) and precision_note(st).
--   Several modules may be asked at once: asked_members for each, their files
--   in the set `st.asked_files`, and count_uses once a file. Each member's
--   record keeps `sites`, `{path, at}` for each node that names it or calls
--   it on a receiver of its type, in production or tests.
--   refused_line(st), with_refused_line(lines, line)
--                             the files roc-ast refused, named before the counts
--
-- A use is in tests when it sits in an `expect`, in a top-level value that
-- only expects use (directly or through other such values), or anywhere in a
-- file under a `gates/` folder, a gates-only app.
--
-- A file uses a member by naming it through its import of the asked module,
-- or by calling it as a method or through an operator. Roc's checker sends
-- `a + b` to `a.plus(b)`, and so on for the operators in
-- WALK_OPERATOR_METHODS, and a unary `-` to `negate` (src/check/Check.zig);
-- `!` is always Bool's `not`. A call counts for a member of the receiver's
-- type when the file makes that type plain (`expr_type`), and for no member
-- of another type of the same name. A receiver it can't type counts for
-- every member of the method's name, pooled, and keeps that member off the
-- list of those used only in their own file.

-- The source between two places, a end column being one past the last
-- character, with each line after the first losing the first line's
-- indentation.
function source_text(src, line, col, end_line, end_col)
  local first = src[line]
  local indent = #first - #re_find(first, "^[ \t]*(.*)$").group
  if line == end_line then return {sub(first, col, end_col - 1)} end
  local out = {sub(first, col)}
  for l = line + 1, end_line do
    local text = l == end_line and sub(src[l], 1, end_col - 1) or src[l]
    local k = 1
    while k <= indent and k <= #text and (sub(text, k, k) == "\t" or sub(text, k, k) == " ") do k = k + 1 end
    push(out, sub(text, k))
  end
  return out
end

-- The comment lines directly above line `line`, trimmed, in order.
function doc_lines_above(src, line)
  local out = {}
  local k = line - 1
  while k >= 1 and starts_with(trim(src[k]), "#") do
    push(out, trim(src[k]))
    k = k - 1
  end
  local ordered = {}
  for i = #out, 1, -1 do push(ordered, out[i]) end
  return ordered
end

-- The builtin types, leaves of the walk.
const WALK_BUILTINS = {Str = true, List = true, Bool = true, Try = true, Box = true, Dict = true, Set = true, Iter = true, Num = true, Int = true, Frac = true, Dec = true, F32 = true, F64 = true, U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true, Utf8Problem = true}

-- The kinds of node a type declaration may sit in and still be one this
-- recipe reads: the top level, or a type's block.
const WALK_OUTER_KINDS = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

-- Whether every ancestor of node `at` is a kind in WALK_OUTER_KINDS.
function is_outer(tree, at)
  local k = tree[at].parent
  while k ~= 0 do
    if not has_key(WALK_OUTER_KINDS, tree[k].kind) then return false end
    k = tree[k].parent
  end
  return true
end

function path_join(dir, name)
  if dir == "" or dir == "." then return name end
  return dir .. "/" .. name
end

-- Roc's trees of the files `paths`, in order, as `roc_tree` gives them,
-- parsing only those not already in `trees` and keeping them there, so walks
-- that share `trees` parse a file once.
function parsed_files(trees, paths)
  local fresh = {}
  for p in paths do
    if not has_key(trees, p) then push(fresh, p) end
  end
  if #fresh > 0 then
    for f in roc_tree(fresh) do trees[f.path] = f end
  end
  local out = {}
  for p in paths do push(out, trees[p]) end
  return out
end

-- The type declaration's name with the names of the declarations it is
-- nested in: `Pigs.PigInterest`.
function qualified_name(tree, at)
  local parts = {get(tree[tree[at].kids[1]], "name", "")}
  local k = tree[at].parent
  while k ~= 0 do
    if tree[k].kind == "s-type-decl" then
      local name = get(tree[tree[k].kids[1]], "name", "")
      local grown = {name}
      for p in parts do push(grown, p) end
      parts = grown
    end
    k = tree[k].parent
  end
  return join(parts, ".")
end

-- The packages an app's or a package's header names, from its tree, as
-- `{name, raw}`, `raw` being the path written for its main file.
function header_packages(tree)
  local out = {}
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "record-field" and n.parent ~= 0 and tree[n.parent].kind == "packages" then
      local raw = ""
      for j = i + 1, #tree do
        if tree[j].kind == "e-string-part" and tree[tree[j].parent].parent == i then raw = tree[j].raw end
      end
      push(out, {name = n.name, raw = raw})
    end
  end
  return out
end

-- Whether the line `l` opens an app's or a package's header.
function is_header_line(l)
  return starts_with(l, "app [") or starts_with(l, "app[") or l == "package" or starts_with(l, "package [") or starts_with(l, "package[")
end

-- Each package's folder, from the `packages=` argument `given` and the
-- headers of the apps and packages directly in the folder `root`, as `{dir}`
-- or `{err}`, a given one with `given` set.
function package_folders(root, given, trees)
  local out = {}
  local apps = {}
  for p in glob(path_join(root, "*.roc")) do
    local header = false
    for l in lines(read(p)) do
      if is_header_line(l) then header = true end
    end
    if header then push(apps, p) end
  end
  if #apps > 0 then
    for f in parsed_files(trees, apps) do
      if f.err == "" then
        for pkg in header_packages(f.nodes) do
          local dir = path_normal(path_join(root, dirname(pkg.raw)))
          local found = dir == nil and {err = "`" .. pkg.name .. "` is at `" .. dirname(pkg.raw) .. "` from the root, outside it: pass packages=" .. pkg.name .. "=<folder>, such as a repos: path"} or {dir = dir}
          if has_key(out, pkg.name) and get(out[pkg.name], "dir", "") ~= get(found, "dir", "") then
            found = {err = "the apps in the root give `" .. pkg.name .. "` two folders: pass packages=" .. pkg.name .. "=<folder>"}
          end
          out[pkg.name] = found
        end
      end
    end
  end
  if given ~= "" then
    for pair in split(given, ",") do
      local at = find(pair, "=")
      if at == nil then fail("type_walk: packages=: `" .. pair .. "` is no name=folder") end
      out[trim(sub(pair, 1, at - 1))] = {dir = trim(sub(pair, at + 1)), given = true}
    end
  end
  return out
end

-- The folder of each package the file at `path` reads, unless `packages=`
-- names that package: from its own header, a gates app's
-- `game: "../game.roc"`, else from the headers of the apps and packages in
-- its folder, as a client app's module reads `import lib.Brush` through its
-- folder's `main.roc`. A folder outside the root and its mounts is left out.
function own_packages(st, tree, path)
  local dir = dirname(path)
  if not has_key(st.dir_packages, dir) then st.dir_packages[dir] = package_folders(dir, "", st.trees) end
  local found = st.dir_packages[dir]
  local own = {}
  for name in keys(found) do
    if has_key(found[name], "dir") then own[name] = found[name] end
  end
  for pkg in header_packages(tree) do
    local at = path_normal(path_join(dir, dirname(pkg.raw)))
    if at ~= nil then own[pkg.name] = {dir = at} end
  end
  local out = {}
  for name in keys(own) do
    if not get(get(st.packages, name, {}), "given", false) then out[name] = own[name] end
  end
  return out
end

-- Parses the files in `paths` not read before and records what each
-- declares and imports, in `st.files` and `st.types`; a file roc-ast refuses
-- goes in `st.refused` and `st.refusals`.
function load_files(st, paths)
  local fresh = {}
  for p in paths do
    if not has_key(st.files, p) then push(fresh, p) end
  end
  if #fresh == 0 then return nil end
  for f in parsed_files(st.trees, fresh) do
    if f.err ~= "" then
      st.files[f.path] = {path = f.path, err = f.err}
      if f.err ~= "no such file" then
        -- roc_tree's `err` names the file first when roc-ast did.
        local why = starts_with(f.err, f.path .. ": ") and sub(f.err, #f.path + 3) or f.err
        push(st.refused, f.path .. ": " .. why)
        push(st.refusals, {path = f.path, why = why})
      end
    else
      -- A library uses no other, so this is declared.shale's module_name,
      -- the file's name less `.roc`.
      local base = basename(f.path)
      local info = {path = f.path, err = "", module = sub(base, 1, #base - 4), nodes = f.nodes, src = split(read(f.path), "\n"), types = {}, imports = {}}
      local tree = f.nodes
      local own = own_packages(st, tree, f.path)
      for i = 1, #tree do
        local n = tree[i]
        if n.kind == "s-type-decl" and is_outer(tree, i) and get(tree[n.kids[1]], "name", "") ~= "" then
          local q = qualified_name(tree, i)
          local q_parts = split(q, ".")
          local t = {id = f.path .. "#" .. q, path = f.path, module = info.module, qualified = q, name = q_parts[#q_parts], at = i, line = n.line}
          push(info.types, t)
          st.types[t.id] = t
        end
        if n.kind == "s-import" and is_outer(tree, i) then
          local raw = get(n, "raw", "")
          local parts = split(raw, ".")
          local target = {}
          if #parts == 1 then
            target = {path = path_normal(path_join(dirname(f.path), raw .. ".roc"))}
          else
            local pkg = has_key(own, parts[1]) and own[parts[1]] or get(st.packages, parts[1], {err = "no app in the root names the package `" .. parts[1] .. "`: pass packages=" .. parts[1] .. "=<folder>"})
            if has_key(pkg, "err") then target = {err = pkg.err} else target = {path = path_join(pkg.dir, join(drop(parts, 1), "/") .. ".roc")} end
          end
          info.imports[parts[#parts]] = target
        end
      end
      st.files[f.path] = info
    end
  end
  return nil
end

-- Reads every file the files read import, and theirs, so a receiver's type
-- resolves when the uses are counted.
function load_imports(st)
  local more = true
  while more do
    local found = {}
    for p in keys(st.files) do
      local imports = get(st.files[p], "imports", {})
      for name in keys(imports) do
        local q = get(imports[name], "path", "")
        if q ~= "" and not has_key(st.files, q) then found[q] = true end
      end
    end
    load_files(st, sort(keys(found)))
    more = #keys(found) > 0
  end
  return nil
end

-- Stops a walk whose `root=`, `module=` or `clients=` climbs with `..`,
-- which no path may, naming the forms that reach a package from outside it.
function refuse_climbing(root, module, clients)
  for pair in {{"root", root}, {"module", module}, {"clients", clients}} do
    if contains(pair[2], "..") then fail("type_walk: " .. pair[1] .. "=" .. pair[2] .. " climbs with `..`, which no path may. Walk a package from outside it with root= as a mount path, root=repos:roc-apps/canvas_apps/lib module=Brush, or from its parent folder, root=lib, and name the apps that use it with clients=, such as clients=repos:roc-apps/canvas_apps/*") end
  end
  return nil
end

-- The client files `clients=`'s text names, comma separated, as `{paths,
-- app_of}`: an entry ending in `.roc` is a glob of files, and any other is a
-- folder or a glob of folders, `repos:roc-apps/canvas_apps/*`, whose `.roc`
-- files at any depth are read. A file's app is the folder its entry names,
-- or for a `.roc` glob the file's own folder. The files in the set `skip`,
-- the root's, are left out. An entry that names no file stops the walk.
function client_files(text, skip)
  local paths = {}
  local app_of = {}
  for part in split(text, ",") do
    local entry = trim(part)
    while ends_with(entry, "/") do entry = sub(entry, 1, #entry - 1) end
    if entry ~= "" then
      local is_file = ends_with(entry, ".roc")
      local found = glob(is_file and entry or entry .. "/**/*.roc")
      if #found == 0 then fail("type_walk: clients=: `" .. entry .. "` names no .roc file") end
      local depth = #split(entry, "/")
      for p in found do
        local q = path_normal(p)
        if not has_key(skip, q) and not has_key(app_of, q) then
          push(paths, q)
          app_of[q] = is_file and dirname(q) or join(take(split(q, "/"), depth), "/")
        end
      end
    end
  end
  return {paths = sort(paths), app_of = app_of}
end

-- The app folders beside the folder `root` that name it as a package in a
-- header directly in them, sorted: `safari` beside `lib`, whose `main.roc`
-- says `lib: "../lib/main.roc"`. None when `root` is `.`, whose parent no
-- path may reach.
function apps_beside(root, trees)
  local here = path_normal(root)
  if here == nil or here == "." or here == "" then return {} end
  local headers = {}
  for p in glob(path_join(dirname(here), "*/*.roc")) do
    local q = path_normal(p)
    if dirname(q) ~= here then
      local header = false
      for l in lines(read(q)) do
        if is_header_line(l) then header = true end
      end
      if header then push(headers, q) end
    end
  end
  local apps = {}
  if #headers > 0 then
    for f in parsed_files(trees, headers) do
      if f.err == "" then
        for pkg in header_packages(f.nodes) do
          if path_normal(path_join(dirname(f.path), dirname(pkg.raw))) == here then apps[dirname(f.path)] = true end
        end
      end
    end
  end
  return sort(keys(apps))
end

-- The lost entry when an app beside the package folder `root` that uses it
-- holds none of the client files `client_paths`, else nil. Its uses would go
-- uncounted, and a member only it uses would read as unused, as when
-- `clients=*_widget` leaves out every app that is no widget.
function clients_missing_apps(st, root, client_paths)
  local missed = {}
  for app in apps_beside(root, st.trees) do
    local covered = false
    for p in client_paths do
      if starts_with(p, app .. "/") then covered = true end
    end
    if not covered then push(missed, app) end
  end
  if #missed == 0 then return nil end
  return "clients=: the apps beside " .. path_normal(root) .. " that use it as a package and hold no client file, whose uses are not counted: " .. join(missed, ", ") .. "; name every app that uses it, as clients=" .. path_join(dirname(path_normal(root)), "*")
end

function plural(n, word)
  return n .. " " .. word .. (n == 1 and "" or "s")
end

-- The clients' header line, after their files are read: how many files in
-- how many apps, and how many of them import the asked file `start`, which
-- may be none. When no client imports any of the root's files, the set
-- `root_files`, a lost entry says so, since paths are compared as written and
-- then the root and the clients are named by paths of two kinds.
function clients_line(st, paths, start, root_files)
  local apps = {}
  local importing = 0
  local into_root = false
  for p in paths do
    apps[st.app_of[p]] = true
    local imports = get(st.files[p], "imports", {})
    local hit = false
    for name in keys(imports) do
      local q = get(imports[name], "path", "")
      if q == start then hit = true end
      if has_key(root_files, q) then into_root = true end
    end
    if hit then importing = importing + 1 end
  end
  if not into_root then push(st.lost, "clients=: none of the " .. #paths .. " client files imports any of the root's files, such as " .. start .. "; name root= and clients= alike, both as mount paths or both from one folder") end
  return "# Clients: " .. plural(#paths, "file") .. " in " .. plural(#keys(apps), "app") .. ", " .. importing .. " importing " .. start
end

-- The type in `info` whose name is `q` exactly, else nil.
function type_named(info, q)
  for t in info.types do
    if t.qualified == q then return t end
  end
  return nil
end

-- What `name` is in the imported module `target`, whose own type `rest` may
-- be when `name` is qualified by the module's name.
function resolve_in_module(st, target, name, rest)
  if has_key(target, "err") then return {kind = "lost", why = target.err} end
  if not has_key(st.files, target.path) then return {kind = "need", path = target.path} end
  local file = st.files[target.path]
  if file.err == "no such file" then return {kind = "lost", why = "no file " .. target.path} end
  if file.err ~= "" then return {kind = "lost", why = target.path .. " doesn't parse"} end
  local t = type_named(file, name) or type_named(file, rest)
  if t ~= nil then return {kind = "type", id = t.id} end
  return {kind = "lost", why = "no type `" .. name .. "` in " .. target.path}
end

-- What the type name `name`, written in the file `info`, refers to:
-- `{kind = "type", id}`, `{kind = "leaf"}`, `{kind = "need", path}` when the
-- file that says is not read yet, or `{kind = "lost", why}`.
function resolve(st, info, name)
  local parts = split(name, ".")
  if #parts == 1 then
    local here = {}
    for t in info.types do
      if t.name == name then push(here, t) end
    end
    if #here == 1 then return {kind = "type", id = here[1].id} end
    if #here > 1 then
      local top = type_named(info, name) or type_named(info, info.module .. "." .. name)
      if top ~= nil then return {kind = "type", id = top.id} end
      return {kind = "lost", why = #here .. " types of this name in the file"}
    end
    if has_key(info.imports, name) then return resolve_in_module(st, info.imports[name], name, name) end
    if has_key(WALK_BUILTINS, name) then return {kind = "leaf"} end
    return {kind = "lost", why = "no type of this name in the file, no import of it, and no builtin"}
  end
  local head = parts[1]
  local rest = join(drop(parts, 1), ".")
  if head == info.module then
    local t = type_named(info, name) or type_named(info, rest)
    if t ~= nil then return {kind = "type", id = t.id} end
    return {kind = "lost", why = "no type `" .. name .. "` in its own module"}
  end
  if has_key(info.imports, head) then return resolve_in_module(st, info.imports[head], name, rest) end
  if has_key(WALK_BUILTINS, head) then return {kind = "leaf"} end
  return {kind = "lost", why = "`" .. head .. "` is no imported module"}
end

-- The annotations in the type's own block, in source order, as `{at,
-- constant}`: `at` is the annotation's node, and `constant` is true when its
-- type is not written as a function. An annotation whose whole type is `_`
-- says nothing about the type's surface, so it is left out.
function members_of(tree, at)
  local out = {}
  for k in tree[at].kids do
    if tree[k].kind == "associated" then
      for m in tree[k].kids do
        if tree[m].kind == "s-type-anno" and #tree[m].kids > 0 then
          local kind = tree[tree[m].kids[1]].kind
          if kind ~= "_" then push(out, {at = m, constant = kind ~= "ty-fn"}) end
        end
      end
    end
  end
  return out
end

-- The member each binary operator calls on its left operand.
const WALK_OPERATOR_METHODS = {["+"] = "plus", ["-"] = "minus", ["*"] = "times", ["/"] = "div_by", ["//"] = "div_trunc_by", ["%"] = "rem_by", ["<"] = "is_lt", ["<="] = "is_lte", [">"] = "is_gt", [">="] = "is_gte", ["=="] = "is_eq", ["!="] = "is_eq"}

-- The operators' members whose two operands have one type, so the right
-- operand's type is the left's.
const WALK_SAME_SIDES = {is_lt = true, is_lte = true, is_gt = true, is_gte = true, is_eq = true}

-- Whether the file at `path` is a gates-only app, under a `gates/` folder.
function is_gates(path)
  return contains("/" .. path, "/gates/")
end

-- The value the node `i` names: an identifier's name, or a punned record
-- field's, as `still_shapes` in `{ still_shapes }`, which roc-ast keeps as a
-- `field` with no identifier under it (boundaries.shale reads it so too).
-- Any other node names none, "".
function value_named(tree, i)
  local n = tree[i]
  if n.kind == "e-ident" then return get(n, "raw", "") end
  if n.kind == "field" and #n.kids == 0 and n.parent ~= 0 and tree[n.parent].kind == "e-record" then return get(n, "field", "") end
  return ""
end

-- Where each node of the file `info` (`{path, nodes}`) sits, as `{ctx,
-- test_values, gates}`: `ctx[i]` is `expect` inside an `expect`,
-- `value:<name>` inside the definition of a top-level value, `block` inside a
-- type's block, and `none` elsewhere. `test_values` is the set of top-level
-- values that only expects use, directly or through other such values; a
-- value nothing uses is not one. A parent comes before its children in the
-- tree.
function test_context(info)
  local tree = info.nodes
  local ctx = {}
  local tops = {}
  for i = 1, #tree do
    local n = tree[i]
    local up = n.parent == 0 and "none" or ctx[n.parent]
    local c = up
    if n.kind == "s-expect" then
      c = "expect"
    elseif n.kind == "associated" then
      c = "block"
    elseif n.kind == "s-decl" and up == "none" and #n.kids > 0 and tree[n.kids[1]].kind == "p-ident" then
      local name = get(tree[n.kids[1]], "raw", "")
      c = "value:" .. name
      tops[name] = true
    end
    push(ctx, c)
  end
  local refs = {}
  for i = 1, #tree do
    local raw = value_named(tree, i)
    if has_key(tops, raw) and ctx[i] ~= "value:" .. raw then push_at(refs, raw, ctx[i]) end
  end
  local test_values = {}
  local changed = true
  while changed do
    changed = false
    for name in sort(keys(refs)) do
      if not has_key(test_values, name) then
        local all = true
        for c in refs[name] do
          if not (c == "expect" or (starts_with(c, "value:") and has_key(test_values, sub(c, 7)))) then all = false end
        end
        if all then
          test_values[name] = true
          changed = true
        end
      end
    end
  end
  return {ctx = ctx, test_values = test_values, gates = is_gates(info.path)}
end

-- Whether a node whose context is `c`, in a file whose `test_context` is
-- `fc`, is in tests: in a gates app, an `expect`, or a value only expects
-- use.
function in_tests(fc, c)
  return fc.gates or c == "expect" or (starts_with(c, "value:") and has_key(fc.test_values, sub(c, 7)))
end

-- The file `info`'s `test_context`, worked out once a walk.
function file_context(st, info)
  if not has_key(st.contexts, info.path) then st.contexts[info.path] = test_context(info) end
  return st.contexts[info.path]
end

-- The imports of the file `info` that only its tests use, sorted, by the name
-- the file uses each by (its alias, else its last part). A use is a name
-- (a punned field's among them), tag or type whose first part is that name
-- or one the import exposes; it is
-- a test's by `in_tests`, or inside the annotation of a top-level value only
-- expects use. A type's block is production, as other files may call its
-- members. A gates app's are all tests, so it has none.
function test_only_imports(st, info)
  local tree = info.nodes
  local fc = file_context(st, info)
  if fc.gates then return {} end
  local owner = {}
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "s-import" and is_outer(tree, i) then
      local parts = split(get(n, "raw", ""), ".")
      local name = get(n, "alias", parts[#parts])
      owner[name] = name
      for k in n.kids do
        if tree[k].kind == "exposing" then
          for e in tree[k].kids do
            if tree[e].kind == "exposed-upper-ident" then owner[get(tree[e], "text", "")] = name end
            if tree[e].kind == "exposed-lower-ident" then
              for t in tree[e].kids do owner[get(tree[t], "value", "")] = name end
            end
          end
        end
      end
    end
  end
  local test_anno = {}
  local used = {}
  for i = 1, #tree do
    local n = tree[i]
    local c = fc.ctx[i]
    if (n.parent ~= 0 and has_key(test_anno, tostring(n.parent))) or (n.kind == "s-type-anno" and c == "none" and has_key(fc.test_values, get(n, "name", ""))) then test_anno[tostring(i)] = true end
    local name = value_named(tree, i)
    if n.kind == "e-tag" then name = get(n, "raw", "") end
    if n.kind == "ty" then name = get(n, "name", "") end
    -- roc-ast keeps only `.Red` of a pattern's `Color.Red`, so the source says.
    if n.kind == "p-tag" then
      name = get(n, "raw", "")
      local m = starts_with(name, ".") and re_find(sub(info.src[n.line], n.col), "^([A-Za-z_][A-Za-z0-9_.]*)") or nil
      if m ~= nil then name = m.group end
    end
    local head = split(name, ".")[1]
    if name ~= "" and has_key(owner, head) then
      local side = (has_key(test_anno, tostring(i)) or in_tests(fc, c)) and "test" or "production"
      if get(used, owner[head], "") ~= "production" then used[owner[head]] = side end
    end
  end
  local out = {}
  for name in sort(keys(used)) do
    if used[name] == "test" then push(out, name) end
  end
  return out
end

-- What the file `info` binds where, worked out once a walk, for `expr_type`:
-- `scope[i]`, the top-level definition or `expect` node `i` sits in (0
-- outside any); `binds`, the names each of those binds, by `<scope>\t<name>`,
-- not counting the definition's own name; `annos`, the annotations at the top
-- level or in a type's block by name, and `beside` the same by the node they
-- sit in and name, `<parent>\t<name>`; and `decls`, how many definitions
-- there bind each name.
function typing_context(st, info)
  if has_key(st.typing, info.path) then return st.typing[info.path] end
  local tree = info.nodes
  local scope = {}
  local cx = {scope = scope, binds = {}, annos = {}, beside = {}, decls = {}}
  for i = 1, #tree do
    local n = tree[i]
    local p = n.parent
    local s = p == 0 and 0 or scope[p]
    local k = n.kind
    if s == 0 and (k == "s-decl" or k == "s-expect") and is_outer(tree, i) then s = i end
    push(scope, s)
    if k == "p-ident" and s ~= 0 then
      if p == s and tree[s].kids[1] == i then
        if tree[s].kind == "s-decl" then incr(cx.decls, get(n, "raw", "")) end
      else
        push_at(cx.binds, s .. "\t" .. get(n, "raw", ""), i)
      end
    end
    if k == "s-type-anno" and s == 0 and is_outer(tree, i) then
      push_at(cx.annos, get(n, "name", ""), i)
      push_at(cx.beside, p .. "\t" .. get(n, "name", ""), i)
    end
  end
  st.typing[info.path] = cx
  return cx
end

-- `resolve_type`'s work, which that function keeps by file and name.
function resolve_alias(st, info, name)
  local here = info
  local want = name
  for step = 1, 8 do
    local r = resolve(st, here, want)
    if r.kind == "leaf" then return "leaf" end
    if r.kind ~= "type" then return nil end
    local t = st.types[r.id]
    local file = st.files[t.path]
    local kids = file.nodes[t.at].kids
    if #kids < 2 or file.nodes[kids[2]].kind ~= "ty" then return r.id end
    local head = file.nodes[kids[1]]
    if contains(sub(file.src[head.end_line], head.end_col, head.end_col + 3), "::") then return r.id end
    here = file
    want = get(file.nodes[kids[2]], "name", "")
  end
  return nil
end

-- What the type name `name`, written in the file `info`, is, an alias
-- (`Across : Width`) followed to the type it names: a type's id, `leaf` for a
-- builtin, or nil when it can't be told, as when its file isn't read.
function resolve_type(st, info, name)
  local key = info.path .. "\t" .. name
  if not has_key(st.resolved, key) then st.resolved[key] = resolve_alias(st, info, name) or false end
  return st.resolved[key] or nil
end

-- The type a type annotation's node `at` in the file `info` names, as
-- `resolve_type` gives it: a name, or an applied name by its head. Any other
-- form (a record, a function, a type variable) is nil.
function anno_type(st, info, at)
  local n = info.nodes[at]
  local name = ""
  if n.kind == "ty" then name = get(n, "name", "") end
  if n.kind == "ty-apply" then name = get(info.nodes[n.kids[1]], "name", "") end
  if name == "" then return nil end
  return resolve_type(st, info, name)
end

-- The type of a value the annotation `anno` in the file `info` declares: what
-- a call of it gives when `applied`, else the constant's own type.
function anno_value_type(st, info, anno, applied)
  local at = info.nodes[anno].kids[1]
  local ty = info.nodes[at]
  if applied then
    if ty.kind ~= "ty-fn" then return nil end
    return anno_type(st, info, ty.kids[#ty.kids])
  end
  if ty.kind == "ty-fn" then return nil end
  return anno_type(st, info, at)
end

-- The member `name` of the type `id`, as `{info, at}`, its file and its
-- annotation, else nil.
function member_anno(st, id, name)
  local t = st.types[id]
  local info = st.files[t.path]
  for member in members_of(info.nodes, t.at) do
    if get(info.nodes[member.at], "name", "") == name then return {info = info, at = member.at} end
  end
  return nil
end

-- The type of the qualified value `raw`, `Pixels.zero` or `Distance.metres`
-- when `applied`, written in the file `info`: from its member's annotation.
function qualified_type(st, info, raw, applied)
  local parts = split(raw, ".")
  local id = resolve_type(st, info, join(take(parts, #parts - 1), "."))
  if id == nil or id == "leaf" then return nil end
  local m = member_anno(st, id, parts[#parts])
  if m == nil then return nil end
  return anno_value_type(st, m.info, m.at, applied)
end

-- The type of the bare value `raw` that no definition binds locally, from
-- the file's one annotation and definition of that name, else nil.
function top_value_type(st, info, cx, raw, applied)
  local annos = get(cx.annos, raw, {})
  if #annos ~= 1 or get(cx.decls, raw, 0) > 1 then return nil end
  return anno_value_type(st, info, annos[1], applied)
end

-- The type of the field `field` of the record type `id`, else nil.
function field_type(st, id, field)
  local t = st.types[id]
  local info = st.files[t.path]
  local kids = info.nodes[t.at].kids
  if #kids < 2 or info.nodes[kids[2]].kind ~= "ty-record" then return nil end
  for k in info.nodes[kids[2]].kids do
    if get(info.nodes[k], "name", "") == field then return anno_type(st, info, info.nodes[k].kids[1]) end
  end
  return nil
end

-- The type the nominal pattern `Pixels.(p)`, its node `at`, gives `p`: the
-- type the nominal type is over, else nil. A tag's pattern, `Ok(p)`, is nil.
function backing_type(st, info, at)
  local n = info.nodes[at]
  local raw = get(n, "raw", "")
  if #n.kids ~= 1 or sub(info.src[n.line], n.col + #raw, n.col + #raw + 1) ~= ".(" then return nil end
  local id = resolve_type(st, info, raw)
  if id == nil or id == "leaf" then return nil end
  local t = st.types[id]
  local file = st.files[t.path]
  local kids = file.nodes[t.at].kids
  local head = file.nodes[kids[1]]
  if #kids < 2 or not contains(sub(file.src[head.end_line], head.end_col, head.end_col + 3), "::") then return nil end
  return anno_type(st, file, kids[2])
end

-- The type of the parameter `p`, in the lambda's `args` node `args`, of the
-- definition `s`, from the definition's annotation beside it, else nil.
function param_type(st, info, cx, s, args, p)
  local tree = info.nodes
  local found = get(cx.beside, tree[s].parent .. "\t" .. get(tree[tree[s].kids[1]], "raw", ""), {})
  if #found ~= 1 then return nil end
  local ty = tree[tree[found[1]].kids[1]]
  local params = tree[args].kids
  if ty.kind ~= "ty-fn" or #ty.kids - 1 ~= #params then return nil end
  for k = 1, #params do
    if params[k] == p then return anno_type(st, info, ty.kids[k]) end
  end
  return nil
end

-- The type of the expression at node `at` in the file `info` (whose
-- `typing_context` is `cx`), where the file makes it plain, as a type's id,
-- `leaf` for a builtin, or nil. It is plain for a parameter of a definition
-- whose annotation gives its type, a local or top-level value bound once in
-- reach, a qualified constant or call (`Pixels.zero`, `Distance.metres(2)`),
-- a call of a top-level annotated function, a field of a value of a record
-- type, a method call on a value of a known type, by the method's
-- annotation, and the value a nominal pattern `Pixels.(p)` unwraps. A name
-- bound twice in a definition, or a `$` variable, is nil.
function expr_type(st, info, cx, at, depth)
  if depth > 12 then return nil end
  local tree = info.nodes
  local n = tree[at]
  if n.kind == "e-tuple" and #n.kids == 1 then return expr_type(st, info, cx, n.kids[1], depth + 1) end
  if n.kind == "e-apply" or n.kind == "e-ident" then
    local applied = n.kind == "e-apply"
    local f = applied and tree[n.kids[1]] or n
    if f.kind ~= "e-ident" then return nil end
    local raw = get(f, "raw", "")
    if contains(raw, ".") then return qualified_type(st, info, raw, applied) end
    if starts_with(raw, "$") then return nil end
    local binds = get(cx.binds, cx.scope[at] .. "\t" .. raw, {})
    if #binds == 0 then return top_value_type(st, info, cx, raw, applied) end
    if #binds > 1 or applied then return nil end
    local p = binds[1]
    local up = tree[tree[p].parent]
    if up.kind == "s-decl" and up.kids[1] == p then return expr_type(st, info, cx, up.kids[2], depth + 1) end
    if up.kind == "p-tag" then return backing_type(st, info, tree[p].parent) end
    local s = cx.scope[at]
    if up.kind == "args" and tree[s].kind == "s-decl" and tree[s].kids[2] == up.parent then return param_type(st, info, cx, s, tree[p].parent, p) end
    return nil
  end
  if n.kind == "e-method-call" then
    local recv = expr_type(st, info, cx, tree[n.kids[1]].kids[1], depth + 1)
    if recv == nil or recv == "leaf" then return nil end
    local name = get(n, "method", "")
    if starts_with(name, ".") then name = sub(name, 2) end
    local m = member_anno(st, recv, name)
    if m == nil then return nil end
    return anno_value_type(st, m.info, m.at, true)
  end
  if n.kind == "e-field-access" then
    local ty = expr_type(st, info, cx, tree[n.kids[1]].kids[1], depth + 1)
    for k in drop(n.kids, 1) do
      if ty == nil or ty == "leaf" then return nil end
      ty = field_type(st, ty, get(tree[k], "field", ""))
    end
    return ty
  end
  return nil
end

-- Records each member of the asked module's types, to count its outside
-- uses: `st.member_rec` by type id and name, and `st.members_by_name`.
function asked_members(st, start)
  local info = st.files[start]
  for t in info.types do
    for member in members_of(info.nodes, t.at) do
      local name = get(info.nodes[member.at], "name", "")
      local label = name
      if starts_with(t.qualified, t.module .. ".") then label = sub(t.qualified, #t.module + 2) .. "." .. name end
      if t.qualified ~= t.module and not starts_with(t.qualified, t.module .. ".") then label = t.qualified .. "." .. name end
      local rec = {label = label, line = info.nodes[member.at].line, prod = {}, test = {}, method_prod = {}, method_test = {}, op_prod = {}, op_test = {}, sites = {}}
      st.member_rec[t.id .. "\t" .. name] = rec
      push(st.member_list, rec)
      push_at(st.members_by_name, name, rec)
    end
  end
  return nil
end

-- The member a dotted name such as `Geom.AheadPoint.at_height`, split into
-- `parts`, names in the asked file `start`, or nil: the type is the parts
-- before the last, with the module's name or without it.
function member_named(st, start, parts)
  local n = #parts
  if n < 2 then return nil end
  local type_parts = take(parts, n - 1)
  local candidates = {join(type_parts, ".")}
  if n > 2 then push(candidates, join(drop(type_parts, 1), ".")) end
  for q in candidates do
    local t = type_named(st.files[start], q)
    if t ~= nil and has_key(st.member_rec, t.id .. "\t" .. parts[n]) then return st.member_rec[t.id .. "\t" .. parts[n]] end
  end
  return nil
end

-- Counts one call of the member `name`, by a method or (`kind` `op`) an
-- operator, in the file `path`, on a receiver of the type `ty`: for that
-- type's member when it is one of the asked module's, for every member of
-- the name, pooled, when `ty` is nil, and for none otherwise.
function count_call(st, path, test, name, ty, kind, at)
  if ty == nil then
    incr(st.precision, kind .. "_pooled")
    for rec in st.members_by_name[name] do
      local into = test and rec[kind .. "_test"] or rec[kind .. "_prod"]
      into[path] = true
    end
    return nil
  end
  incr(st.precision, kind .. "_typed")
  local key = ty .. "\t" .. name
  if has_key(st.asked, ty) and has_key(st.member_rec, key) then
    local rec = st.member_rec[key]
    if test then rec.test[path] = true else rec.prod[path] = true end
    push(rec.sites, {path = path, at = at})
  end
  return nil
end

-- Counts the file `info`'s uses of the asked modules' members: names through
-- its import of the asked file `start` or of a file in `st.asked_files`,
-- method calls, and operators.
function count_uses(st, info, start)
  local fc = file_context(st, info)
  local cx = typing_context(st, info)
  local tree = info.nodes
  local asked_files = get(st, "asked_files", {})
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "e-ident" then
      local parts = split(get(n, "raw", ""), ".")
      local target = #parts > 1 and get(get(info.imports, parts[1], {}), "path", "") or ""
      if target ~= "" and (target == start or has_key(asked_files, target)) then
        local rec = member_named(st, target, parts)
        if rec ~= nil then
          if in_tests(fc, fc.ctx[i]) then rec.test[info.path] = true else rec.prod[info.path] = true end
          push(rec.sites, {path = info.path, at = i})
        end
      end
    elseif n.kind == "e-method-call" then
      local name = get(n, "method", "")
      if starts_with(name, ".") then name = sub(name, 2) end
      if has_key(st.members_by_name, name) then count_call(st, info.path, in_tests(fc, fc.ctx[i]), name, expr_type(st, info, cx, tree[n.kids[1]].kids[1], 0), "method", i) end
    elseif n.kind == "e-binop" or (n.kind == "unary" and get(n, "value", "") == "-") then
      local name = n.kind == "unary" and "negate" or get(WALK_OPERATOR_METHODS, get(n, "op", ""), "")
      if has_key(st.members_by_name, name) then
        local ty = expr_type(st, info, cx, n.kids[1], 0)
        if ty == nil and has_key(WALK_SAME_SIDES, name) then ty = expr_type(st, info, cx, n.kids[2], 0) end
        count_call(st, info.path, in_tests(fc, fc.ctx[i]), name, ty, "op", i)
      end
    end
  end
  return nil
end

-- How many files of `set`, a set of paths, are not in `seen`, and how many of
-- those are not in `prod` either, so only tests use the member there; each
-- is then added to `seen`.
function fresh_files(seen, set, prod)
  local files = 0
  local in_tests = 0
  for p in sort(keys(set)) do
    if not has_key(seen, p) then
      files = files + 1
      if not has_key(prod, p) then in_tests = in_tests + 1 end
    end
  end
  for p in keys(set) do seen[p] = true end
  return {files = files, in_tests = in_tests}
end

-- A member's outside uses as `{named, method, op}`, each `{files,
-- in_tests}`, from its record's sets of files: those that name it or call it
-- on a receiver of its type, then those of the rest that call a method of
-- its name on a receiver of no known type, then those of the rest that apply
-- its operator so.
function uses_of(rec)
  local seen = {}
  local named = {}
  for p in keys(rec.prod) do named[p] = true end
  for p in keys(rec.test) do named[p] = true end
  local out = {named = fresh_files(seen, named, rec.prod)}
  local called = {}
  for p in keys(rec.method_prod) do called[p] = true end
  for p in keys(rec.method_test) do called[p] = true end
  out.method = fresh_files(seen, called, rec.method_prod)
  local applied = {}
  for p in keys(rec.op_prod) do applied[p] = true end
  for p in keys(rec.op_test) do applied[p] = true end
  out.op = fresh_files(seen, applied, rec.op_prod)
  return out
end

-- Whether no other file uses the member, by name, by a typed call, or by a
-- call its name or operator might be.
function is_unused(rec)
  local u = uses_of(rec)
  return u.named.files == 0 and u.method.files == 0 and u.op.files == 0
end

-- How many client apps, by `app_of`, hold a file that names the member of
-- the record `rec` or calls it on a receiver of its type.
function apps_using(rec, app_of)
  local apps = {}
  for p in keys(rec.prod) do
    if has_key(app_of, p) then apps[app_of[p]] = true end
  end
  for p in keys(rec.test) do
    if has_key(app_of, p) then apps[app_of[p]] = true end
  end
  return #keys(apps)
end

-- What a claim of no use adds when a file was refused, whose uses the walk
-- can't see.
const AS_FAR_AS_PARSED = "as far as the parsed files show"

-- The note after a member's annotation: `used by 3 files, 1 in tests only;
-- by method name in 2 more; by operator, untyped, in 1 more`. When the files
-- that name it or call it typed lie in several client apps, by `app_of`, the
-- first part says how many: `used by 9 files in 5 apps`. With `partial`,
-- some file was refused and its uses are unknown, so a member with none says
-- `no outside use, as far as the parsed files show`.
function uses_note(rec, app_of, partial?)
  local u = uses_of(rec)
  local apps = apps_using(rec, app_of)
  if apps > 1 then u.named.apps = apps end
  local parts = {}
  local kinds = {{u.named, "used by ", ""}, {u.method, "by method name in ", "used by method name only, in "}, {u.op, "by operator, untyped, in ", "used by operator only, untyped, in "}}
  for k in kinds do
    local c = k[1]
    if c.files > 0 then
      local text = k[2] .. plural(c.files, "file")
      if #parts > 0 then text = k[2] .. c.files .. " more" elseif k[3] ~= "" then text = k[3] .. plural(c.files, "file") end
      if has_key(c, "apps") then text = text .. " in " .. c.apps .. " apps" end
      if c.in_tests > 0 then text = text .. ", " .. c.in_tests .. " in tests only" end
      push(parts, text)
    end
  end
  if #parts == 0 then return partial == true and "no outside use, " .. AS_FAR_AS_PARSED or "no outside use" end
  return join(parts, "; ")
end

-- The labels of the asked module's members no other file uses, in file
-- order.
function unused_members(st)
  local out = {}
  for rec in st.member_list do
    if is_unused(rec) then push(out, rec.label) end
  end
  return out
end

-- The walk's second line when roc-ast refused files, each named with its
-- reason's first clause, `# Refused by roc-ast, so their uses and mentions
-- are not counted: Scene.roc (52 parse problem(s))`. A refused file's uses
-- are unread, so the counts line ends by naming it too, and a member with
-- none says `no outside use, as far as the parsed files show`, as does the
-- line of members used only in this file.
function refused_line(st)
  local named = {}
  for r in st.refusals do
    local cut = find(r.why, ": ")
    push(named, r.path .. " (" .. (cut == nil and r.why or sub(r.why, 1, cut - 1)) .. ")")
  end
  return "# Refused by roc-ast, so their uses and mentions are not counted: " .. join(sort(named), "; ")
end

-- The walk's lines `lines` with `line` second, under the title, where a
-- reader meets it before any count it qualifies.
function with_refused_line(lines, line)
  local out = {lines[1], line}
  for l in drop(lines, 1) do push(out, l) end
  return out
end

-- The counts line's note of how many method calls and operators of the
-- asked members' names had a receiver typed, and how many were pooled.
function precision_note(st)
  local p = st.precision
  return ", method calls " .. get(p, "method_typed", 0) .. " typed and " .. get(p, "method_pooled", 0) .. " pooled, operators " .. get(p, "op_typed", 0) .. " typed and " .. get(p, "op_pooled", 0) .. " pooled"
end

-- The private top-level functions of the asked file `start`, in source
-- order, each its doc and its annotation, marked `# private`, or `# private;
-- tests only` when only expects use it; with their count.
function private_signatures(st, start)
  local info = st.files[start]
  local tree = info.nodes
  local fc = file_context(st, info)
  local out = {}
  local count = 0
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "s-type-anno" and #n.kids > 0 and tree[n.kids[1]].kind == "ty-fn" and is_outer(tree, i) and tree[n.parent].kind ~= "associated" then
      count = count + 1
      push(out, "")
      for l in doc_lines_above(info.src, n.line) do push(out, l) end
      local anno = source_text(info.src, n.line, n.col, n.end_line, n.end_col)
      local test = fc.gates or has_key(fc.test_values, get(n, "name", ""))
      anno[#anno] = anno[#anno] .. (test and "   # private; tests only" or "   # private")
      for l in anno do push(out, l) end
    end
  end
  return {lines = out, count = count}
end

-- The error tags the annotation `anno` answers, sorted, as `[A, B]`: those of
-- the `Try` its function returns, or its constant's type is. A `Try` whose
-- error is not written as tags gives that type's text; no `Try` gives "".
function error_tags(info, anno)
  local tree = info.nodes
  local top = tree[anno].kids[1]
  local result = tree[top].kind == "ty-fn" and tree[top].kids[#tree[top].kids] or top
  local r = tree[result]
  if r.kind ~= "ty-apply" or #r.kids < 3 or get(tree[r.kids[1]], "name", "") ~= "Try" then return "" end
  local u = tree[r.kids[3]]
  if u.kind ~= "ty-tag-union" then return join(source_text(info.src, u.line, u.col, u.end_line, u.end_col), " ") end
  local names = {}
  for k in u.kids do
    if tree[k].kind == "tags" then
      for g in tree[k].kids do
        local tag = tree[g].kind == "ty-apply" and tree[tree[g].kids[1]] or tree[g]
        push(names, get(tag, "name", "?"))
      end
    end
  end
  return "[" .. join(sort(names), ", ") .. "]"
end

-- The public names of the asked file `start`, its types' members in source
-- order, as `{name, label, errors}`, a nested type's member labelled with its
-- type.
function public_names(st, start)
  local info = st.files[start]
  local out = {}
  for t in info.types do
    for member in members_of(info.nodes, t.at) do
      local name = get(info.nodes[member.at], "name", "")
      local label = name
      if t.qualified ~= t.module then label = (starts_with(t.qualified, t.module .. ".") and sub(t.qualified, #t.module + 2) or t.qualified) .. "." .. name end
      push(out, {name = name, label = label, errors = error_tags(info, member.at)})
    end
  end
  return out
end

