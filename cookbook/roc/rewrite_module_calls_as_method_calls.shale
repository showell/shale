-- This recipe rewrites old-style Roc calls as method calls. A call
-- `Module.fn(first, rest...)` becomes `first.fn(rest...)` wherever that is
-- the same call, that is, wherever the first argument's type is the
-- module's own: `List.map(xs, f)` becomes `xs.map(f)`, and
-- `Str.concat(a, b)` becomes `a.concat(b)`. Nested calls turn from the
-- inside out, so `List.len(List.keep_if(xs, p))` becomes
-- `xs.keep_if(p).len()`. It is written in Roc, the app
-- cookbook/roc/rewrite_module_calls_as_method_calls/rewrite_module_calls_as_method_calls.roc and the modules
-- beside it (Source, Candidates and Literals, the calls to turn; Types,
-- Judging and Peers, what the types say of them; Trial and Compiler, the
-- compiler's judgement; Rewritten, the text written back; Run, the whole run
-- on its Tally; Sweep, what a rewrite leaves; SelfTest and Plants, the
-- self-test), with the cookbook's Roc library (cookbook/roc/lib/: Imports,
-- RocTypes, Text, Tree), on Shale's Roc platform (roc_platform/README.md);
-- this file is its launcher, so it is launched as every Shale recipe is.
--
-- A method call names a subject, so a call of a symmetric function
-- (cookbook/roc/symmetric_functions.txt: `max`, `concat`, `map2`, ...)
-- whose first two arguments' types have one head, aliases read through
-- (`U64.max(a, b)`, `Str.concat(a, b)`), stays a module call, and with the
-- types every run lists each such method call, `a.max(b)`, as a
-- `path:line: peer_receiver: why` finding, counted in the summary;
-- `peers=undo` turns them back (the Roc's Peers). Any other function,
-- `starts_with` or a unit's `plus`, keeps its method call.
--
--   cd <repo> && shale <shale>/cookbook/roc/rewrite_module_calls_as_method_calls.shale glob=app/*.roc root=app/main.roc
--   cd <repo> && shale <shale>/cookbook/roc/rewrite_module_calls_as_method_calls.shale glob=app/*.roc root=app/main.roc apply=1
--   cd <repo> && shale <shale>/cookbook/roc/rewrite_module_calls_as_method_calls.shale glob=app/*.roc root=app/main.roc,app/specs.roc
--   cd <repo> && shale <shale>/cookbook/roc/rewrite_module_calls_as_method_calls.shale glob=src/*.roc root=src/Lib.roc types=0
--   cd <repo> && shale <shale>/cookbook/roc/rewrite_module_calls_as_method_calls.shale glob=app/*.roc root=app/main.roc peers=undo apply=1
--   shale cookbook:roc/rewrite_module_calls_as_method_calls.shale self_test=1
--
-- The arguments:
--   glob   the files to rewrite, `**/*.roc` by default; several globs may be
--          given, separated by commas, and a file two of them match is read
--          once.
--   root   the app that `roc check` and `roc test` run on. Several apps,
--          comma-separated, serve a tree that no one app imports whole,
--          such as test-only modules with an app of their own; each file is
--          then judged on the first root that imports it. With `types=0`
--          only one root is allowed, and it defaults to each file itself.
--   apply  with `apply=1`, the rewrites that pass are kept. Without it the
--          run is a dry run: each trial is written in place and put back
--          byte for byte, so the tree ends as it began.
--   types  with `types=0`, the type checker's types (below) are not read.
--   from   the glob's file to start at, 1 by default (see the program limit
--          below).
--   trials with `trials=0`, nothing is written and no compiler runs: the
--          types alone say what would turn. A call whose first argument
--          the types prove is counted `proven`, one they leave open is
--          counted `unsettled` (listed, with the kind of type they gave),
--          and the rest are `left` as ever. It is the count a report needs
--          without the trial compiles that make a dry run slow, and it
--          differs from a dry run's `rewritten` in two ways: a proven call
--          that `roc check` would refuse (a literal whose type defaults, the
--          ProvenFails plant) is counted, and an unsettled call that would
--          compile is not. It needs the types, so not with `types=0`, and
--          never with `apply=1`.
--   peers  with `peers=undo`, the run's candidates are the peer method
--          calls alone, each turned back into a module call (`a.max(b)` to
--          `U64.max(a, b)`, through the receiver's type) and judged by the
--          compiler as a rewrite is. It needs the types; not with trials=0.
--   types_from  a file in roc-types' format holding the one root's types,
--          read in place of running roc-types (a gate that has typed the
--          app already keeps them). Its first line is held to the tree's
--          pin as roc-types' own is. One root only.
-- A trial writes the file in place, so a run stopped in the middle of one
-- (by a budget, a timeout or Ctrl-C) can leave that file rewritten, whether
-- or not `--undo-on-stop` is given: the Roc program's changes are its own
-- process's, which the launcher's flag does not reach. Run it in a git
-- checkout, so `git diff` shows such a file and `git checkout --` puts it
-- back.
--
-- A syntax tree can't tell a value's type, so the compiler judges each
-- rewrite. The candidates come from Roc's own parser, and the types sort
-- them first (below). A file's remaining candidates are written in, and the
-- file passes when `roc check` on its root passes and the summary of `roc
-- test` (its count of expects and their results) is what it was before.
-- When `roc check` reports an error on a rewritten call's lines, that call
-- stays as it was, with the error's title as its reason, and the file is
-- tried again without it. A `missing method` error on a definition `name =
-- <value>` means the value's type never resolved, and it counts against the
-- rewritten calls whose first argument is that `name`. Any other error, a
-- warning included, is a stray. A refused call can cause errors where its
-- value is used (an `unconditional condition` on an `if` it decides), so
-- strays are judged only in a round that refused no call. A stray in such a
-- round, a changed `roc test` summary (the TestChanged plant), or a file
-- still failing after the last round puts the whole file back, and every
-- candidate in it stays, with that reason. A root that `roc check` refuses
-- before any rewrite stops the run (the BadBase plant). Under `apply=1`, a
-- file that `roc fmt` found clean before is formatted again after its
-- rewrite, and any other is left as the rewrite writes it (Unformatted).
--
-- Some calls are not candidates at all:
--   - a function used as a value, like `Str.trim` in `List.map(xs, Str.trim)`;
--   - a call of the file's own module, like `Store.load!(id)` in Store.roc.
--     Inside its module a function is called by the name it is declared
--     with, and listing every such call would bury the ones that need a
--     hand.
-- These calls are candidates that stay, each listed with its reason:
--   - a call on the right of a `|>`, where the pipe gives the first
--     argument: `x |> List.concat(y)` is `List.concat(x, y)`, not
--     `y.concat()`;
--   - a call with an argument that has no span in the tree (the compiler's
--     `match`), since its text can't be moved;
--   - a call whose first argument is a constant numeric expression, that is,
--     number literals (`5`, `-3`, `1.5`, `'a'`) joined only by operators and
--     parentheses (`2 + 3`, `-(1 + 2)`). The module call fixes the number's
--     type, but a receiver's type defaults: `U64.to_str(5)` is "5", while
--     `(5).to_str()` is a `Dec`'s "5.0". Both pass `roc check`, so only an
--     `expect` would notice. The same holds for a plain name bound to such an
--     expression without an annotation, at its nearest definition (`n = 5`
--     earlier in a block, or a top-level `top = 7`), for a loop variable
--     over a list of such literals or a range of them (`for n in [10,
--     1000]`, `for k in 0..<3`), for a `var` such a literal starts (`var $n
--     = 0`, however it is reassigned) and for a field of a record literal
--     that holds one (`r.a` after `r = { a: 5 }`). A typed literal
--     (`5.U64`), a name, a call or a field anywhere in the expression fixes
--     its type, so `n + 1` is a candidate, and so are an annotated name
--     (`m : U64`) and a parameter. A name bound to anything else whose type
--     only literals give (`start = if c 1 else 0`) is a candidate too, and
--     its type defaults the same way; the compiler catches that only where
--     the default clashes (the ProvenFails plant), and otherwise only an
--     `expect` would.
-- Without the types, a call whose first argument has another type
-- (`Str.from_utf8(bytes)`, a list) is tried, and stays because the
-- compiler reports a `missing method`.
--
-- By default the recipe first reads every expression's type from Roc's own
-- type checker, `roc-types` (`tools:roc-types/bin/roc-types`, or
-- `tools:roc-types-<pin>/bin/roc-types` for the tree's pin, from
-- https://github.com/showell/roc-types, read by the Roc library's RocTypes).
-- It runs once on each root, before any file is tried. The type of each
-- candidate's first argument decides what happens to it:
--   - a concrete type of another kind (`List(U8)` for a `Str` call, a
--     record, a tag union, a function) leaves the call untried, with a
--     reason like `the first argument is a List, not a Str`;
--   - a type whose head is the module itself (`Str`, `List(...)`, `Point`)
--     proves the call; a qualified head never does, even one whose last
--     segment names the module (`Shelf.Book` for a `Book` call);
--   - a type variable, or no type at that spot, leaves the call to the trial;
--   - first, a call whose first two arguments are peers stays (`peers`).
-- The summary counts each kind. The files whose open calls are all proven
-- are written at once, and one `roc check` and one `roc test` on their root
-- confirm them together. When that check fails, the files its errors name
-- are set aside and the rest are confirmed again; an error in any other
-- file, or a changed test summary, sets them all aside. A file set aside,
-- and any file with a call the types couldn't settle, goes through the
-- trial alone. A proof is not a pass: in `U8.to(0, 3)` the checker types
-- `0` as a U8 only because the call makes it one, which is why a constant
-- numeric expression is not a candidate.
-- When the types can't be read, the run stops rather than going on without
-- them. That happens with no `root=` (roc-types reads an app, and reads a
-- type module only through an app), a root that is not an app or that the
-- checker refuses, and a roc-types built for a different Roc than the
-- tree's `roc-version`. A file of the glob with a call to try that no root
-- imports is left untouched and the run goes on; such files are listed
-- after the findings (`not reached by <roots>: <path>`), and the run then
-- fails. A file with no call to try needs no root, as a package's header
-- `main.roc` that nothing imports. The roots' types are read one root at a
-- time. With `types=0` every candidate is tried.
--
-- A run starts at most 1,000 programs of its own count (the compiler's, Roc's
-- parser's, roc-types'), as a Shale run does unset, and a very large tree
-- needs more. The run then stops before a file it might not finish, prints
-- `go on with from=N`, and the next run, given `from=N`, starts at the
-- glob's Nth file. A file with nothing to try uses no programs. Under
-- `apply=1`, a stopped run has already written the files the confirm kept,
-- and the next run finds their calls already turned. Each trial also adds an
-- entry to Roc's cache (`~/.cache/roc`), so a tree of a few dozen files can
-- fill several gigabytes there.
--
-- The output is the summary line (`files N, candidates N, rewritten N, left
-- N, peer_receiver N`, the programs used, the files being those begun, so a
-- gate can tell that the glob found what it meant, then `made_unused_import
-- N, made_long_line N`), a line `path:line: Module.fn: why` for each call
-- that stays, a `made_*` line for each import the rewrite left unused (by
-- the Roc library's Imports, find_unused_imports' rule) and each line it
-- pushed past 100 columns, which a sweep fixes in the same pass, the count of
-- each kind the types found, and the summary again (cookbook/findings.shale).
--
-- The compiler is the one the tree pins: `tools:roc-<pin>/roc`, with the pin
-- read from the `roc-version` file in the directory the run starts in, and
-- a run without that file stops. Method lookup has changed between Roc
-- nightlies, so a rewrite is judged only by the Roc the tree is built with.
-- The self-test uses `SELF_TEST_PIN`, which cookbook/roc/pinned.shale names.
--
-- `self_test=1` judges each plant in `cookbook/roc/plants/rewrite_module_calls_as_method_calls/` in a
-- child run of its own (`plant=<Name>`, through this launcher, run by the
-- `shale` on PATH), so each plant gets a run's programs of its own. The
-- child copies the plants to a fresh folder under `scratch:` and runs with
-- `apply=1` there. The Roc's table (Plants) says how many calls each plant
-- must leave, a reason one of them must give, and how many confirms and
-- rounds it takes; a plant with a `<Name>.want` file must come out as that
-- text. A plant marked `types` runs with the types, its root one of the app
-- plants; the others run with `types=0`. A plant with a `stop` must stop its
-- child run with that text. The self-test fails at once when roc-types is
-- not installed.
--
-- **The launcher** hands every value it is given to roc_platform/run.shale in
-- the checkout this cookbook is in (the `cookbook` mount's parent), which
-- builds the Roc there (cached; the first build after a change to C Shale
-- compiles the platform's host, 25 to 50 s) and runs the program rooted
-- here, so `glob=` and `root=` are this root's paths and the run reads this
-- root's `roc-version`, as the Shale recipe did. A value the Roc script reads
-- no `Shale.arg!` of stops the run before anything is built. Its output is
-- the program's, then the launchers' own stops when it stops. `reads=inputs`
-- builds and runs nothing, and prints the real path of each file the program
-- is built from, one a line (run.shale's header), for a caller's cache key.
-- It is Roc's dev build. run.shale gives the program 10 minutes. Its
-- goldens, the Shale original's output and the files it rewrote on the
-- plants, are held by cookbook/roc/rewrite_module_calls_as_method_calls/check_goldens.shale.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/roc/rewrite_module_calls_as_method_calls/rewrite_module_calls_as_method_calls.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 3600000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("rewrite_module_calls_as_method_calls: the Roc program stopped (exit " .. r.code .. ")") end
