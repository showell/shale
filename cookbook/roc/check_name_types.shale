-- This recipe finds names that disagree with their types: a number left bare
-- beside a typed one, a constant that means "none" but has an ordinary type,
-- and, given a project's table, a word whose names must hold one type.
--
--   cd <repo> && shale <shale>/cookbook/roc/check_name_types.shale table=name_types.txt
--   shale cookbook:roc/check_name_types.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default;
--   table      the project's table of words and types, without which
--              `name_type` has nothing to judge;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/check_name_types/`.
--
-- Each line of the table is `word: Type, Type`, `word: none` or `word: any`,
-- such as `dist: Distance`. A blank line or one starting with `#` is skipped,
-- and a malformed line or a word listed twice stops the run. The table belongs
-- to the project, because what `dist` must be depends on the project's types.
--
-- The checks read top-level names, module members and the record fields of
-- types and annotations, never locals:
--
--   name_type         A name whose last word is in the table has a type the
--                     table doesn't allow. A function is judged by what it
--                     returns, and a type by its last part, so
--                     `Geom.Distance` is `Distance`. In a name that starts
--                     with a preposition or a question, the last word isn't
--                     the thing named (`from_fraction`, `after_two_steps`,
--                     `is_fraction`), so it is not judged. `none` means no
--                     name may end in the word, whatever its type or start,
--                     and `any` means the word holds no promise at all.
--   bare_beside_unit  A field that is a bare number in one record and a unit
--                     in another, a unit being a nominal type built on a
--                     number and declared in the files read. It means a
--                     retyping stopped halfway. Each bare field is a finding.
--                     A field named by a preposition (`from`, `to`, `at`) or
--                     by a word the table gives `any` (`id`, where a host's
--                     number and a user's id are two things) is not judged,
--                     because that word fits any two things.
--   no_value          A constant whose first word is `no`, `none` or `unset`
--                     and whose type is not a `Bool` or a tag union. An
--                     ordinary value kept to mean "none" should be a tag.
--                     A `List` has its own empty case, and a type's own member
--                     of that type (`Attention.none : Attention`) is its
--                     scale's bottom, so neither is judged, and neither is a
--                     constant with no annotation. A string with something in
--                     it is words about the case, not a stand-in for it
--                     (`no_match_words`), so only `""` is judged.
--
-- The output is the counts, one line per finding, and the counts again
-- (cookbook/findings.shale). The run fails if there are findings, or if
-- any file doesn't parse, and the files that do parse are judged either way.
-- budget: steps=800000000 arena_bytes=2000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const GLOB = arg("glob", "**/*.roc")
const TABLE_FILE = arg("table", "")
use("cookbook:roc/declared.shale")
use("cookbook:findings.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/gate_recipe.shale")
const CHECKS = {"name_type", "bare_beside_unit", "no_value"}
const BARE_NUMBERS = {U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true, F32 = true, F64 = true, Dec = true}
const NONE_WORDS = {no = true, none = true, unset = true}
const QUESTION_WORDS = {is = true, has = true, can = true, should = true}
const PREPOSITIONS = word_set("cookbook:words/prepositions.txt")

-- The table as a map from each word to the list of types allowed for it,
-- which is empty for `none` and `{"any"}` for `any`.
function name_type_table(path)
  local table_of_words = {}
  if path == "" then return table_of_words end
  if not exists(path) then fail("check_name_types: no table " .. path) end
  local number = 0
  for raw in lines(read(path)) do
    number = number + 1
    local l = trim(raw)
    if l ~= "" and not starts_with(l, "#") then
      local m = re_find(l, "^([a-z0-9]+): *(none|any|[A-Z][A-Za-z0-9]*(?:, *[A-Z][A-Za-z0-9]*)*)$")
      if m == nil then fail("check_name_types: " .. path .. ":" .. number .. ": expected `word: Type, Type`, `word: none` or `word: any`") end
      if has_key(table_of_words, m.groups[1]) then fail("check_name_types: " .. path .. ":" .. number .. ": `" .. m.groups[1] .. "` is listed twice") end
      local allowed = {}
      if m.groups[2] ~= "none" then
        for t in split(m.groups[2], ",") do push(allowed, trim(t)) end
      end
      table_of_words[m.groups[1]] = allowed
    end
  end
  return table_of_words
end

function promises_nothing(table_of_words, word)
  return has_key(table_of_words, word) and has_item(table_of_words[word], "any")
end

function judge_name_type(d, table_of_words, report)
  local ws = name_words(sub(d.name, 1, ends_with(d.name, "!") and #d.name - 1 or #d.name))
  if #ws == 0 or not has_key(table_of_words, ws[#ws]) then return nil end
  local allowed = table_of_words[ws[#ws]]
  if promises_nothing(table_of_words, ws[#ws]) then return nil end
  local type_name = d.kind == "field" and d.type or d.result
  if type_name == "" or type_name == "_" then return nil end
  local names_something_else = has_key(PREPOSITIONS, ws[1]) or has_key(QUESTION_WORDS, ws[1])
  if #allowed == 0 then
    push(report, {path = d.path, line = d.line, check = "name_type", what = "`" .. d.name .. "` ends in `" .. ws[#ws] .. "`, which no name here may: its type is `" .. type_name .. "`"})
  elseif not names_something_else and not has_item(allowed, last_part(type_name)) then
    push(report, {path = d.path, line = d.line, check = "name_type", what = "`" .. d.name .. "` is `" .. type_name .. "`, and a name ending `" .. ws[#ws] .. "` is `" .. join(allowed, "` or `") .. "` here"})
  end
  return nil
end

-- The nominal types built on a number, by name.
function unit_types(all)
  local units = {}
  for d in all do
    if d.kind == "type" and d.is_nominal and has_key(BARE_NUMBERS, d.underlying) then units[d.name] = true end
  end
  return units
end

function judge_bare_fields(all, table_of_words, report)
  local units = unit_types(all)
  local unit_of_field = {}
  for d in all do
    if d.kind == "field" and has_key(units, last_part(d.type)) then unit_of_field[d.name] = d end
  end
  for d in all do
    if d.kind == "field" and has_key(BARE_NUMBERS, d.type) and has_key(unit_of_field, d.name) and not has_key(PREPOSITIONS, d.name) and not promises_nothing(table_of_words, d.name) then
      local typed = unit_of_field[d.name]
      push(report, {path = d.path, line = d.line, check = "bare_beside_unit", what = "the field `" .. d.name .. "` is a bare `" .. d.type .. "` here and a `" .. typed.type .. "` at " .. typed.path .. ":" .. typed.line})
    end
  end
  return nil
end

function judge_no_values(all, report)
  local tag_types = {}
  for d in all do
    if d.kind == "type" and d.is_tags then tag_types[d.name] = true end
  end
  for d in all do
    if d.kind == "value" and d.annotated and not d.fn then
      local ws = split(d.name, "_")
      local is_none_word = has_key(NONE_WORDS, ws[1])
      local is_plain = d.type ~= "Bool" and not d.has_text and not starts_with(d.type, "[") and not starts_with(d.type, "List(") and d.owner ~= last_part(d.type) and not has_key(tag_types, last_part(d.type))
      if is_none_word and is_plain then push(report, {path = d.path, line = d.line, check = "no_value", what = "`" .. d.name .. "` means none and is a `" .. d.type .. "`: keep the case as a tag"}) end
    end
  end
  return nil
end

function self_test()
  local at = "cookbook:roc/plants/check_name_types/"
  local table_arg = "table=" .. at .. "table.txt"
  check_plants("check_name_types", "cookbook:roc/check_name_types.shale", CHECKS, {
    {glob = at .. "name_type.roc", args = {table_arg}, counts = {name_type = 6}, says = {"name_type.roc:3: name_type: `bull_dist` is `Geom.Along`, and a name ending `dist` is `Distance` here", "`in_2_frames` ends in `frames`"}},
    {glob = at .. "name_type.roc"},
    {glob = at .. "quiet_name_type.roc", args = {table_arg}},
    {glob = at .. "bare_beside_unit/*.roc", counts = {bare_beside_unit = 2}, says = {"Rider.roc:4: bare_beside_unit: the field `forward` is a bare `F64` here and a `Distance` at"}},
    {glob = at .. "quiet_bare/*.roc"},
    {glob = at .. "bare_any/*.roc", counts = {bare_beside_unit = 1}, says = {"the field `id` is a bare `U64` here"}},
    {glob = at .. "bare_any/*.roc", args = {"table=" .. at .. "table_any.txt"}},
    {glob = at .. "name_type.roc", args = {"table=" .. at .. "table_any.txt"}},
    {glob = at .. "no_value.roc", counts = {no_value = 3}, says = {"no_value.roc:3: no_value: `no_frames` means none and is a `Steps`"}},
    {glob = at .. "quiet_no_value.roc"},
    {glob = at .. "broken/*.roc", stops = true, says = {"refused: "}},
    {glob = at .. "quiet_name_type.roc", args = {"table=" .. at .. "no_such.txt"}, stops = true, says = {"no table"}},
    {glob = at .. "quiet_name_type.roc", args = {"table=" .. at .. "table_malformed.txt"}, stops = true, says = {"table_malformed.txt:2: expected"}},
    {glob = at .. "quiet_name_type.roc", args = {"table=" .. at .. "table_twice.txt"}, stops = true, says = {"`dist` is listed twice"}},
  })
  return nil
end

function run_check()
  local table_of_words = name_type_table(TABLE_FILE)
  local paths = glob(GLOB)
  local parsed = parse_roc_files(paths)
  local all = {}
  for f in parsed.files do
    for d in declarations_of(f) do push(all, d) end
  end
  local report = {}
  for d in all do
    if d.kind == "field" or d.kind == "value" then judge_name_type(d, table_of_words, report) end
  end
  judge_bare_fields(all, table_of_words, report)
  judge_no_values(all, report)
  local verdict = verdict_of("check_name_types", CHECKS, report, #paths)
  print_findings(verdict.summary, verdict.found)
  fail_if_refused("check_name_types", parsed.refused)
  return verdict
end

-- This `fail` stands at the top level so the summary is the last line a
-- caller reads: a stop inside a function prints the calls after it.
if SELF_TEST then
  self_test()
else
  local verdict = run_check()
  if #verdict.found > 0 then fail(verdict.summary) end
end
