-- What hunt_names' `stale_doc_name` reads: the names a file's comments put
-- in backticks, and whether each still names something in the code. A rename
-- leaves its comments behind (cookbook/roc/rename.shale counts them and
-- leaves them), so a doc that names a function by its old name is stale.
--
--   use("./doc_names.shale")
--   doc_names_in(src, sources)         each backticked name in a comment line
--   names_in_tree(nodes)               every name a file's tree holds
--   imports_in_tree(nodes)             the modules a file imports, by name
--   stale_doc_findings(path, src, nodes, seen)
--                                      each doc name that names nothing
--
-- Only a whole comment line is read (`#` or `##` first), and only a name a
-- reader can't take for a prose word: one of two words or more joined by
-- `_` (`two_opt`, `read_line!`), or a module's member
-- (`Route.two_opt`). A one-word name (`for`, `fold`) is often the
-- language's or the prose's, and is not judged. Nor is a name another
-- language's or library's API holds: one whose sentence names a source of
-- cookbook/words/cited_sources.txt before it ("Rust's `is_ascii_digit`",
-- "Zig `isDigit`, Rust `is_ascii_digit`"), the sentence read back across the
-- comment's lines to its last `.`, `?` or `!` or the comment's start.

-- A backticked doc name, a call's parentheses allowed after it:
-- `two_opt`, `read_line!`, `Route.two_opt(stops)`.
const DOC_NAME = "^(?:([A-Z][A-Za-z0-9]*)\\.)?([a-z][a-z0-9]*(?:_[a-z0-9]+)*!?)(?:\\(.*\\))?$"

-- A file's extensions, so `Screen.roc` is a file's name, not a member's.
const FILE_EXTENSIONS = {"roc", "md", "txt", "zig", "ts", "js", "mjs", "json", "shale", "html", "tsv"}

-- The text of the sentence before byte `at` of comment line `k` of `src`:
-- back across the comment lines above (their `#`s gone) until a `.`, `?` or
-- `!` that ends a sentence, a blank comment line, or the comment's start.
function sentence_before(src, k, at)
  local text = trim(re_replace(sub(trim(src[k]), 1, at - 1), "^#+", ""))
  local up = k - 1
  while re_find(text, "[.?!](\\s|$)") == nil and up >= 1 and starts_with(trim(src[up]), "#") do
    local above = trim(re_replace(trim(src[up]), "^#+", ""))
    if above == "" then break end
    text = above .. " " .. text
    up = up - 1
  end
  local ends = re_find_all(text, "[.?!](\\s|$)")
  if #ends == 0 then return text end
  return sub(text, ends[#ends].at + 1)
end

-- Whether a sentence names a source of `sources` (cited_sources.txt), as a
-- whole word or a possessive (`Rust`, `Rust's`, `Zig,`).
function cites_source(sentence, sources)
  for w in words(sentence) do
    local bare = re_replace(re_replace(w, "'s$|s'$", ""), "[,;:()\"]+", "")
    if has_key(sources, bare) then return true end
  end
  return false
end

-- Each backticked name in the comment lines of `src` (a file's lines), as
-- `{line, module, name, others}`, `module` "" for a bare name. A bare name of
-- one word is left out, as the header says, and so is a file's name. `others`
-- says a possessive stands before it (`Pipeline's`, `roc-ray's`, `the
-- rules' own`), or a source of `sources` before it in its sentence
-- (`cites_source`): it is another's name, which this file need not hold.
function doc_names_in(src, sources)
  local out = {}
  for k = 1, #src do
    local l = trim(src[k])
    if starts_with(l, "#") then
      for m in re_find_all(l, "`([^`]+)`") do
        local found = re_find(m.groups[1], DOC_NAME)
        if found ~= nil then
          local module = found.groups[1]
          local name = found.groups[2]
          -- What stands before it, the comment line above's end when it
          -- opens its line.
          local before = trim(re_replace(sub(l, 1, m.at - 1), "^#+", ""))
          if before == "" and k > 1 then before = trim(src[k - 1]) end
          local others = re_find(before .. " ", "(?:'s|s')(?: own)? $") ~= nil or cites_source(sentence_before(src, k, m.at), sources)
          local is_file = module ~= "" and has_item(FILE_EXTENSIONS, name)
          if (module ~= "" or contains(name, "_")) and not is_file then push(out, {line = k, module = module, name = name, others = others}) end
        end
      end
    end
  end
  return out
end

-- Every name a file's tree holds, as a set: what it declares, binds, calls,
-- each record field and method it names, and each symbol a platform's
-- `provides` gives the host (`"roc_plan": plan_for_host`), with and without
-- an effect's `!`.
function names_in_tree(nodes)
  local names = {}
  for n in nodes do
    for key in {"raw", "name", "field", "method", "symbol"} do
      local v = get(n, key, "")
      if starts_with(v, ".") then v = sub(v, 2) end
      if v ~= "" then
        names[v] = true
        if ends_with(v, "!") then names[sub(v, 1, #v - 1)] = true end
      end
    end
  end
  return names
end

-- The modules a file imports, by the name its code calls them (`Route`, and
-- `Stdout` for `pf.Stdout`), as a list.
function imports_in_tree(nodes)
  local out = {}
  for n in nodes do
    if n.kind == "s-import" then
      local parts = split(get(n, "raw", ""), ".")
      push(out, parts[#parts])
    end
  end
  return out
end

-- The names module `module` holds, or nil when they can't be known (a
-- builtin's module, a package's the run didn't read): such a module's names
-- can't be judged. They are `<folder><module>.roc`'s beside the file
-- (`folder` ends in its `/`, or is "" at the root), else those of the files
-- read that hold a module of that name, as a package's does
-- (`import game.SunPath`). `seen` is `{by_module, by_path}`: the names of
-- each module the run read, and each file's answer read here, `{found,
-- names}`.
function module_names(folder, module, seen)
  local path = folder .. module .. ".roc"
  if not has_key(seen.by_path, path) then
    seen.by_path[path] = {found = false}
    if exists(path) then
      local f = roc_tree({path})[1]
      if f.err == "" then seen.by_path[path] = {found = true, names = names_in_tree(f.nodes)} end
    end
  end
  if seen.by_path[path].found then return seen.by_path[path].names end
  return get(seen.by_module, module)
end

-- Each backticked name in a comment of the file at `path` that names nothing
-- there, as `{line, why}`, once a line. A bare name is judged against the
-- file's own names, those of `seen.known` (a set the caller adds, such as the
-- self-test's check names), and those of every module it imports
-- (`module_names`), and is left when an import's names can't be known or a
-- possessive or a cited source (`seen.sources`) names its owner; `Module.name` against that module's. The
-- file's own module may be named either way. A platform module's bare
-- `roc_` name is the host's (`roc_crashed`, `roc_alloc`: the symbols Roc's
-- host ABI has the host define, in Zig or C), which no Roc file holds, so
-- it is not judged.
function stale_doc_findings(path, src, nodes, seen)
  local out = {}
  local own = names_in_tree(nodes)
  local base = basename(path)
  local dir = sub(path, 1, #path - #base)
  local own_module = sub(base, 1, #base - 4)
  local imported = {}
  local all_imports_known = true
  local is_platform = false
  for n in nodes do
    if n.kind == "platform" then is_platform = true end
  end
  for module in imports_in_tree(nodes) do
    local names = module_names(dir, module, seen)
    if names == nil then all_imports_known = false else push(imported, names) end
  end
  local said = {}
  for d in doc_names_in(src, seen.sources) do
    local plain = ends_with(d.name, "!") and sub(d.name, 1, #d.name - 1) or d.name
    local names_something = false
    local host_symbol = is_platform and starts_with(plain, "roc_")
    local judged = not (d.module == "" and (d.others or not all_imports_known or host_symbol))
    if d.module == "" or d.module == own_module then
      if has_key(own, d.name) or has_key(own, plain) or has_key(seen.known, plain) then names_something = true end
      if d.module == "" then
        for names in imported do
          if has_key(names, d.name) or has_key(names, plain) then names_something = true end
        end
      end
    else
      local names = module_names(dir, d.module, seen)
      if names == nil then
        judged = false
      elseif has_key(names, d.name) or has_key(names, plain) then
        names_something = true
      end
    end
    local shown = d.module == "" and d.name or (d.module .. "." .. d.name)
    if judged and not names_something and not has_key(said, d.line .. "|" .. shown) then
      said[d.line .. "|" .. shown] = true
      local place = d.module == "" and "this file or its imports" or d.module
      push(out, {line = d.line, why = "a comment names `" .. shown .. "`, which names nothing in " .. place .. ": a rename left it behind, or it names what is gone"})
    end
  end
  return out
end
