-- This recipe finds calls nested three or more deep, like `f(g(h(x)))`, in
-- every .roc file of a tree. Such a call has to be read from the inside
-- out. The Roc style guide (roc-apps docs/roc-style.md) asks for code that
-- reads left to right instead: a method chain, a pipe, or a named middle
-- step. It is written in Roc, the app
-- cookbook/roc/find_calls_nested_three_deep/find_calls_nested_three_deep.roc, the modules beside it
-- (Nest, the rule; NestFinding; SelfTest, the plants' check) and the
-- cookbook's Roc library (cookbook/roc/lib/: Tree and Text, what it reads),
-- on Shale's Roc platform (roc_platform/README.md), reading each
-- file's syntax tree from Roc's own parser (`Shale.roc_tree!`); this file
-- is its launcher, so it is launched as every Shale recipe is:
--
--   cd <repo> && shale <shale>/cookbook/roc/find_calls_nested_three_deep.shale glob=chat/**/*.roc min=4
--   shale cookbook:roc/find_calls_nested_three_deep.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default;
--   min        the least depth to report, 3 by default;
--   house      with `house=0`, leave out what is only our house style
--              (cookbook/roc/house.shale), for another project's code;
--   loose      with `loose=1`, a record, list or tuple argument does not
--              reset the depth;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/find_calls_nested_three_deep/` at `min=3`.
--
-- A call's depth is one more than the deepest call among its arguments.
-- Some things pass their parts' depth through without adding a level:
-- whatever reads left to right (a method's receiver in `a.f().g()`, the
-- left side of `x |> f` and `x->f()`), a tag or nominal wrapper
-- (`Ok(...)`, `ChatPath.(...)`), `?`, parentheses, operators, field or
-- tuple access, and a string's interpolation. So `f(g(h(x) + 1))`,
-- `f(!g(h(x)))`, `f(g(h(x).a))` and `f("${g(h(x))}")` are each three deep.
-- A lambda argument starts again at zero, since its body is read on its
-- own, and so does a record, list or tuple argument, whose parts have names
-- or places, unless `loose=1`.
--
-- Each finding is the outermost call of one nest:
--   path:line:column: nested: depth N, <outermost> to <deepest>: <source line>
-- The column tells apart two nests on one line. The outermost and deepest
-- calls are named (`List.concat to Str.to_utf8`, or `.concat` for a method)
-- so that a nest spread over several lines says more than its first line.
-- The output is the count by depth, the findings, and the count again
-- (cookbook/findings.shale). Findings are a report: a caller holds their
-- count. Files that don't parse are listed after the findings, and then the
-- run fails.
--
-- `self_test=1`: a plant line ending `# depth N` must give one finding of
-- depth N, and one ending `# depth N, M` a finding for each, left to right;
-- an added `from A to B` means the finding must say `A to B`. No unmarked
-- line may give a finding, no two findings may print the same line, and a
-- `quiet_*.roc` plant may hold no mark.
--
-- **The launcher** hands every value it is given to roc_platform/run.shale in
-- the checkout this cookbook is in (the `cookbook` mount's parent), which
-- builds the Roc there (cached; the first build after a change to C Shale
-- compiles the platform's host, 25 to 50 s) and runs the program rooted
-- here, so `glob=` is this root's paths, as it was the Shale recipe's. A
-- value the Roc script reads no `Shale.arg!` of stops the run before
-- anything is built. Its output is the program's, then the launchers' own
-- stops when it stops. `reads=inputs` builds and runs nothing, and prints the
-- real path of each file the program is built from, one a line (run.shale's
-- header), for a caller's cache key. It is built with `opt=speed`: Roc's dev
-- build took 2.7 s of CPU over roc-apps where the Shale original took 1.7 s,
-- and the speed build takes 1.6 s, for about 14 s of build once, then
-- cached (measured on Roc nightly-2026-11-03-34bd006). Its goldens, the Shale original's output
-- on the plants, are held by cookbook/roc/find_calls_nested_three_deep/check_goldens.shale.
-- The house rule lives twice: in Roc here, and in cookbook/roc/house.shale,
-- which the other Shale recipes still read.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/roc/find_calls_nested_three_deep/find_calls_nested_three_deep.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE, "opt=speed"}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("find_calls_nested_three_deep: the Roc program stopped (exit " .. r.code .. ")") end
