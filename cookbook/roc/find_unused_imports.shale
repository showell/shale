-- This recipe finds import lines that the file never uses, since Roc doesn't
-- warn of one. It is written in Roc, the app
-- cookbook/roc/find_unused_imports/find_unused_imports.roc and the modules
-- beside it (Imports, the rule; SelfTest, the plants' run), on Shale's Roc
-- platform (roc_platform/README.md); this file is its launcher, so it is
-- launched as every Shale recipe is:
--
--   cd <repo> && shale <shale>/cookbook/roc/find_unused_imports.shale
--   shale cookbook:roc/find_unused_imports.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default; several globs may
--              be given, separated by commas;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/find_unused_imports/`.
--
-- The check:
--
--   unused_import  An `import` line whose name the file never refers to. The
--              name is the alias of `import pkg.Mod as M`, else the last part
--              of the module's path: `Mod` of `import pkg.Mod` and of
--              `import Mod`. A use is a value, tag or type whose first part
--              is that name: `Mod.name`, `Mod.Type`, `Mod.Tag(x)`, the
--              module's own type `Mod`, in an annotation, a pattern, an
--              expect or an interpolation alike. A name the line exposes
--              (`exposing [line!]`) and the file uses is a use of the line.
--              A file import, `import "page.html" as page : Str`, is used
--              when the file refers to `page`. An entry of a platform
--              header's `hosted { ... }` block uses the module it names
--              (`"sym": Host.f!` uses `Host`). A name in a comment or a
--              string is no use.
--
-- A method call never names its module, so a module whose only use is a
-- method on a value of its type is unused here, and Roc agrees: the method
-- resolves through the value's type without the import. A bare tag that
-- shares a module's name (`Other`, in an expression, a pattern or a tag union
-- type) is no use of the module, but a nominal type's name before its record
-- (`Point.{ x: 0 }`) is.
--
-- roc-ast drops the qualifier of a tag in a pattern (`Color.Red =>` comes as
-- `.Red`), so that name is read from the source at the pattern's column.
--
-- The output is the counts, one line per finding, and the counts again
-- (cookbook/findings.shale). The run fails if there are findings, or if
-- any file doesn't parse, and the files that do parse are judged either way.
--
-- **The launcher** hands every value it is given to roc_platform/run.shale in
-- the checkout this cookbook is in (the `cookbook` mount's parent), which
-- builds the Roc there (cached; the first build after a change to C Shale
-- compiles the platform's host, 25 to 50 s) and runs the program rooted
-- here, so `glob=` is this root's paths, as it was the Shale recipe's. A
-- value the Roc script reads no `Shale.arg!` of stops the run before
-- anything is built. Its output is the program's, then the launchers' own
-- stops when it stops. `reads=inputs` builds and runs nothing, and prints the
-- real path of each file the program is built from, one a line (run.shale's
-- header), for a caller's cache key. Its goldens, the Shale original's output
-- on the plants, are held by cookbook/roc/find_unused_imports/check_goldens.shale.
-- The rules live twice: here, in Roc, and in cookbook/roc/imports.shale,
-- which rewrite_method_calls.shale still reads.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/roc/find_unused_imports/find_unused_imports.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("find_unused_imports: the Roc program stopped (exit " .. r.code .. ")") end
