-- cookbook/roc/find_unused_imports/check_goldens.shale: find_unused_imports
-- (the Roc script beside this, find_unused_imports.roc, through its launcher
-- cookbook/roc/find_unused_imports.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/find_unused_imports/check_goldens.shale self_test=1
--   shale cookbook/roc/find_unused_imports/check_goldens.shale write=1
--
-- The cases are each plant row of the recipe's self-test (its glob), a few
-- globs of several plants at once, and `self_test=1`. The goldens were
-- written from the Shale original's output on them, and the port matched it
-- on other repositories' trees too (roc-chat, roc-markdown, roc-apps,
-- roc-syntax-color), which are left out because their code moves. `write=1`
-- writes the goldens again from the launcher, for a change meant to move
-- them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`).
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/roc/find_unused_imports.shale"
const GOLDENS = "cookbook/roc/find_unused_imports/goldens.txt"
const AT = "cookbook:roc/plants/find_unused_imports/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The globs, each a case: a plant's file or files, under AT.
const GLOBS = {
  "unused.roc",
  "unused_alias.roc",
  "unused_exposing.roc",
  "unused_file_import.roc",
  "unused_in_prose.roc",
  "unused_method_only.roc",
  "unused_tag_namesake.roc",
  "unused_beside_hosted.roc",
  "unused.roc," .. AT .. "unused_alias.roc",
  "quiet_qualified.roc",
  "quiet_annotation.roc",
  "quiet_expect.roc",
  "quiet_pattern_tag.roc",
  "quiet_tag.roc",
  "quiet_exposing.roc",
  "quiet_alias.roc",
  "quiet_interpolation.roc",
  "quiet_file_import.roc",
  "quiet_hosted.roc",
  "broken/*.roc",
  "*.roc",
  "**/*.roc",
  "quiet_tag.roc , " .. AT .. "unused.roc ,",
  "unused.roc," .. AT .. "unused.roc",
  "nothing_here/*.roc",
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at [^ ]+( \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: find_unused_imports: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- Each case, `{name, values}`: the values on the launcher's stdin.
function cases()
  local out = {}
  for g in GLOBS do push(out, {name = g, values = "glob=" .. AT .. g .. "\n"}) end
  push(out, {name = "self_test=1", values = "self_test=1\n"})
  return out
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = c.values, timeout_ms = 900000, whole = 8000000})
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
