-- Shorten long Roc lines by letting `roc fmt` lay them out. roc fmt never
-- wraps a line, but it puts the items of a record, list, call or lambda's
-- arguments one to a line when the last item has a trailing comma. For each
-- code line wider than `width`, this script adds that comma to the widest
-- group of two or more items that opens and closes on the line, runs roc
-- fmt, and repeats until no line changes; a folder still changing after 8
-- passes stops the run, naming its files. The passes work on a copy of the
-- folder's .roc files under `scratch:roc_commas_work/`, and the changed
-- files are written back only once the rewrite has finished, so a run that
-- stops, on a pass too many or on a budget, leaves the folder as it was.
-- Then it lists the lines still too wide: comment lines, and code lines with
-- no such group (a function type's arguments, which have no brackets). The
-- list is printed between its counts, as cookbook/roc/findings.shale
-- describes. It runs the Roc that the repository's roc-version file names.
--
-- With `tokens=N`, the script holds the folder to roc-style.md's stacking
-- rule, whose six tokens are `tokens=6`, whatever a line's width: a group of
-- three or more items and N or more tokens gets the trailing comma, and a
-- stacked group that should sit on one line loses it, which is how `roc fmt`
-- is asked to join it. A group and its tokens are read as stack.shale reads
-- them (cookbook/roc/groups.shale), so after `tokens=6` stack.shale finds no
-- group left to stack or to unstack. A line's outermost group goes first, and
-- the next pass reaches the groups inside it. A function type's arguments and
-- a row of literals are left alone, as stack.shale leaves them, and so is a
-- platform header's `targets:` section, which `roc fmt` lays out by itself.
--
--   cd <repo> && shale <shale>/cookbook/roc/roc_commas.shale dir=roc width=100
--   cd <repo> && shale <shale>/cookbook/roc/roc_commas.shale dir=roc tokens=6
--   shale cookbook:roc/roc_commas.shale self_test=1
--
-- `self_test=1` copies the plants in `cookbook/roc/plants/roc_commas/` to
-- `scratch:roc_commas/`, rewrites them there with `tokens=6` and the
-- self-test's Roc, and checks that the rewrite ends, that each plant comes
-- out as its `.want` file, and that no group is left to stack or to unstack.
-- `at_the_cap.roc` nests as deep as 8 passes reach, and `too_deep/` one group
-- deeper, which has to stop the rewrite, name its file and leave it as it was.
--
-- roc-apps' canvas_apps/safari, with its 70,000-byte lines of polygon data,
-- takes about 390,000,000 steps and 1.2 GB of arena.
--
-- budget: steps=1000000000 arena_bytes=2000000000 output_bytes=4000000 changes=5000

use("cookbook:roc/findings.shale")
use("cookbook:roc/pinned.shale")
use("cookbook:roc/groups.shale")
const SELF_TEST = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/roc_commas"
const DIR = SELF_TEST and "scratch:roc_commas" or arg("dir", "roc")
not_option("roc_commas", "dir", DIR)
const WIDTH = arg("width", 100)
const TOKENS = SELF_TEST and STACK_TOKENS or arg("tokens", 0)
const MAX_PASSES = 8
const ROC = roc_bin("roc_commas", SELF_TEST)

-- The position of the closing bracket that should get a trailing comma, or
-- 0 if there is none. Of the groups that open and close on the line, it is
-- the widest one with a comma directly inside it. A lambda's arguments,
-- `|a, b|`, count as a group; the pipe `|>` does not.
function closer_for_trailing_comma(line)
  local openers = {}
  local commas_inside = {}
  local best = 0
  local best_width = 0
  local in_string = false
  local i = 1
  while i <= #line do
    local c = sub(line, i, i)
    local closes_group = false
    if in_string then
      if c == "\\" then
        i = i + 1
      elseif c == "\"" then
        in_string = false
      end
    elseif c == "\"" then
      in_string = true
    elseif c == "#" then
      break
    elseif c == "(" or c == "{" or c == "[" then
      push(openers, i)
      push(commas_inside, 0)
    elseif c == "|" and sub(line, i + 1, i + 1) ~= ">" and sub(line, i - 1, i - 1) ~= "|" and sub(line, i + 1, i + 1) ~= "|" then
      if #openers > 0 and sub(line, openers[#openers], openers[#openers]) == "|" then
        closes_group = true
      else
        push(openers, i)
        push(commas_inside, 0)
      end
    elseif c == ")" or c == "}" or c == "]" then
      closes_group = #openers > 0
    elseif c == "," and #commas_inside > 0 then
      commas_inside[#commas_inside] = commas_inside[#commas_inside] + 1
    end
    if closes_group then
      local open = openers[#openers]
      if commas_inside[#commas_inside] > 0 and i - open > best_width then
        best = i
        best_width = i - open
      end
      openers = take(openers, #openers - 1)
      commas_inside = take(commas_inside, #commas_inside - 1)
    end
    i = i + 1
  end
  return best
end

-- The line with a trailing comma added, or nil when it has no group to take
-- one or its widest group already ends in a comma.
function line_with_trailing_comma(line)
  local at = closer_for_trailing_comma(line)
  if at == 0 then return nil end
  if ends_with(trim(sub(line, 1, at - 1)), ",") then return nil end
  -- The comma goes right after the last item, before any spaces fmt left there.
  local j = at - 1
  while j > 0 and sub(line, j, j) == " " do j = j - 1 end
  return sub(line, 1, j) .. "," .. sub(line, j + 1)
end

function is_comment(line)
  return starts_with(trim(line), "#")
end

function roc_files()
  local out = {}
  for e in walk_all(DIR) do
    if e.kind == "file" and ends_with(e.path, ".roc") then push(out, e.path) end
  end
  return out
end

-- The .roc files of DIR, each as its path inside DIR.
function roc_paths_in_dir()
  local out = {}
  for path in roc_files() do push(out, sub(path, #DIR + 2)) end
  return out
end

-- The rewrite works on a copy of the folder's .roc files, so a run that
-- stops, on a budget or a pass too many, leaves the folder as it was.
const WORK = SELF_TEST and "scratch:roc_commas_work/self_test" or "scratch:roc_commas_work/" .. re_replace(real(DIR), "[^A-Za-z0-9]", "_")

function fresh_work_copy(paths)
  if is_dir(WORK) then remove_tree(WORK) end
  mkdir(WORK)
  for p in paths do replace(WORK .. "/" .. p, read(DIR .. "/" .. p)) end
end

-- Writes each file the rewrite changed back to the folder. It reads them all
-- first and checks that what is left of the budgets covers every write, so
-- the folder gets all of the rewrite or none of it.
function write_back(paths)
  local changed = {}
  local bytes = 0
  for p in paths do
    local text = read(WORK .. "/" .. p)
    if text ~= read(DIR .. "/" .. p) then
      push(changed, {path = DIR .. "/" .. p, text = text})
      bytes = bytes + #text
    end
  end
  local left = budget()
  if left.changes < #changed + 1 or left.change_bytes < bytes or left.steps < 2 * bytes + 1000 * #changed + 100000 then
    fail("roc_commas: too little budget left to write the " .. #changed .. " changed files, so none was written")
  end
  for c in changed do replace(c.path, c.text) end
  print(#changed .. " files rewritten")
end

function run_roc_fmt()
  local r = run({ROC, "fmt", real(WORK)}, {timeout_ms = 60000, tail = 20})
  if r.code ~= 0 then
    print(r.out)
    fail("roc fmt failed")
  end
end

-- How many commas line `l` holds, not counting one that ends it. A group of
-- STACK_ITEMS items that opens and closes on the line holds STACK_ITEMS - 1 of
-- them at least, and a comma that ends the line is inside no such group, so a
-- line that fits with fewer has no group to stack. Counting is far cheaper
-- than reading the line's groups, and most of a data file's lines are like
-- `{ x: 0.5, y: 0.25 },`.
function commas_before_the_last(l)
  local commas = #split(l, ",") - 1
  if ends_with(trim_end(l), ",") then commas = commas - 1 end
  return commas
end

-- Line `l` with a trailing comma for its outermost group that should stack,
-- or else, when it is wider than WIDTH, for its widest group. nil when it
-- gets none.
function line_with_comma(l)
  local fits = line_width(l) <= WIDTH
  if fits and (TOKENS == 0 or commas_before_the_last(l) < STACK_ITEMS - 1) then return nil end
  if TOKENS > 0 then
    local g = group_to_stack(l, TOKENS, WIDTH)
    if g ~= nil then return with_trailing_comma(l, g) end
  end
  if not fits then return line_with_trailing_comma(l) end
  return nil
end

-- Takes the trailing comma from each group of the file at `path`, whose text
-- is `text`, that should unstack, adds one to each code line that should get
-- one, and returns how many groups and lines it changed.
function rewrite_trailing_commas(path, text)
  local ls = split(text, "\n")
  local unstacked = {}
  if TOKENS > 0 then unstacked = groups_to_unstack(ls, TOKENS, WIDTH) end
  ls = without_trailing_commas(ls, unstacked)
  local reachable = without_targets_section(ls)
  local changed = #unstacked
  for i = 1, #ls do
    if not is_comment(ls[i]) then
      local with_comma = line_with_comma(reachable[i])
      if with_comma ~= nil then
        ls[i] = with_comma
        changed = changed + 1
      end
    end
  end
  if changed > 0 then replace(path, join(ls, "\n")) end
  return changed
end

-- Rewrites commas and runs roc fmt, in the work copy, until a pass changes
-- nothing, and then writes the changed files back. Files still changing after
-- MAX_PASSES stop the run, since the list of long lines would otherwise judge
-- a rewrite that never finished.
function rewrite()
  local paths = roc_paths_in_dir()
  fresh_work_copy(paths)
  run_roc_fmt()
  local pass = 1
  local changed = 1
  local touched = {}
  -- A file's text when a pass last left it alone. A later pass would leave
  -- the same text alone again, so it is not read for groups a second time.
  local settled = {}
  while changed > 0 and pass <= MAX_PASSES do
    changed = 0
    touched = {}
    for p in paths do
      local text = read(WORK .. "/" .. p)
      if not has_key(settled, p) or settled[p] ~= text then
        local n = rewrite_trailing_commas(WORK .. "/" .. p, text)
        if n > 0 then
          changed = changed + n
          push(touched, DIR .. "/" .. p)
        else
          settled[p] = text
        end
      end
    end
    print("pass " .. pass .. ": " .. changed .. " trailing commas added or taken out")
    run_roc_fmt()
    pass = pass + 1
  end
  if changed > 0 then fail("roc_commas: still changing after " .. MAX_PASSES .. " passes, so no file was written: " .. join(touched, ", ")) end
  write_back(paths)
  remove_tree(WORK)
  return nil
end

function fresh_copies(plants)
  if is_dir(DIR) then remove_tree(DIR) end
  mkdir(DIR)
  for p in glob(plants .. "/*.roc") do replace(DIR .. "/" .. basename(p), read(p)) end
end

function self_test()
  fresh_copies(PLANTS)
  rewrite()
  local bad = 0
  for p in glob(PLANTS .. "/*.roc") do
    local name = basename(p)
    local want = PLANTS .. "/" .. sub(name, 1, #name - 4) .. ".want"
    local got = read(DIR .. "/" .. name)
    local ok = got == read(want)
    print((ok and "ok   " or "FAIL ") .. name .. ": comes out as its .want")
    if not ok then bad = bad + 1 end
    local reachable = without_targets_section(split(got, "\n"))
    for n = 1, #reachable do
      local l = reachable[n]
      if not is_comment(l) and group_to_stack(l, TOKENS, WIDTH) ~= nil then
        print("FAIL " .. name .. ":" .. n .. ": a group left to stack: " .. trim(l))
        bad = bad + 1
      end
    end
    for g in groups_to_unstack(split(got, "\n"), TOKENS, WIDTH) do
      print("FAIL " .. name .. ":" .. g.line .. ": a group left to unstack")
      bad = bad + 1
    end
  end
  if bad > 0 then fail(bad .. " checks failed") end
  if is_dir(WORK) then fail("roc_commas: a finished rewrite should remove its work copy, " .. WORK) end
  fresh_copies(PLANTS .. "/too_deep")
  local stopped = attempt(rewrite)
  local named = "still changing after " .. MAX_PASSES .. " passes, so no file was written: " .. DIR .. "/too_deep.roc"
  if stopped.ok or not contains(stopped.error, named) then fail("roc_commas: too_deep.roc should stop with `" .. named .. "`") end
  if read(DIR .. "/too_deep.roc") ~= read(PLANTS .. "/too_deep/too_deep.roc") then fail("roc_commas: a rewrite that stops should leave too_deep.roc as it was") end
  print("ok   too_deep.roc: stops naming its file, and is left as it was")
  remove_tree(WORK)
  print("PASS: the rewrite ends, every plant comes out as its .want, no group is left to stack or to unstack, and a rewrite past its passes stops naming its file and changes none")
end

if SELF_TEST then
  self_test()
else
  rewrite()
  local long_comments = 0
  local long_code = {}
  for path in roc_files() do
    local ls = split(read(path), "\n")
    for i = 1, #ls do
      local w = line_width(ls[i])
      if w > WIDTH then
        if is_comment(ls[i]) then
          long_comments = long_comments + 1
        else
          push(long_code, path .. ":" .. i .. " (" .. w .. "): " .. trim(sub(ls[i], 1, 140)))
        end
      end
    end
  end
  print_findings("still over " .. WIDTH .. ": " .. #long_code .. " code lines, " .. long_comments .. " comment lines", long_code)
end
