-- **A CALL NESTED THREE DEEP IS READ INSIDE OUT** (metal-vmm QUEUE 303,
-- from the Roc style review's S3): every call whose argument is a call
-- whose argument is a call, `f(g(h(x)))`, read from Roc's own parser's
-- tree (`roc_tree`, the Linux prelude's, over roc-ast at
-- `tools:roc-ast/bin/roc-ast`). roc-apps docs/roc-style.md, layout: write it left to right, a
-- method chain where the values carry methods, a pipe where the steps are
-- module functions, else a named middle step.
--
--   nested  a call `min` (3) or more deep, the outermost of each nest only:
--           `path:line:column: nested: depth N: <its first source line>`,
--           the column the call's own, so two nests on a line are two
--           findings told apart
--
-- **A CALL'S DEPTH** is 1 + the deepest call among its arguments. What
-- reads left to right is no level: a method's receiver (`a.f().g()`) and a
-- pipe's or an arrow call's left side (`x |> f`, `x->f()`) carry their
-- depth through. A tag or a nominal wrapper (`Ok(...)`, `ChatPath.(...)`),
-- `?` and parentheses are no call and pass their argument's depth through,
-- and so are an operator and a field's or a tuple's access: `f(g(h(x) +
-- 1))`, `f(g(h(x) ?? y))`, `f(!g(h(x)))` and `f(g(h(x).a))` are each three
-- deep, an operand or an accessed value being read inside out as an
-- argument is. A lambda argument starts again at 0: its body is read on its
-- own. A record, list or tuple argument starts again too (`f({ a: g(h(x))
-- })` names its parts), unless `loose=1`, which passes depth through them.
--
-- The count by depth first, then one line a finding, then the count again
-- (cookbook/roc/summed.shale). A file roc-ast refuses is a line of its
-- own, and fails the run after the rest are hunted.
--
--   cd <repo> && shale <shale>/cookbook/roc/nest_depth.shale glob=chat/**/*.roc min=4
--   shale cookbook:roc/nest_depth.shale self_test=1
--
-- `self_test=1` runs it at `min=3` over `cookbook/roc/plants/nest_depth/`:
-- a plant line ending `# depth N` must give one finding, of depth N, and
-- one ending `# depth N, M` a finding for each, left to right; no other
-- line gives any, and no two findings print the same line. A `quiet_*.roc`
-- plant holds no such mark.
-- budget: steps=100000000 arena_bytes=3000000000 output_bytes=4000000

const SELF = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/nest_depth/"
const GLOB = SELF and (PLANTS .. "*.roc") or arg("glob", "**/*.roc")
const LOOSE = arg("loose", "") == "1"
const MIN = SELF and 3 or arg("min", 3)
use("cookbook:roc/summed.shale")

-- What passes its parts' depth through unchanged: no call of its own.
-- `unary` is `!x` and `-x`; `receiver` is a field's access's value.
const PASS = {["e-arrow-call"] = true, ["e-question-suffix"] = true, ["e-nominal-apply"] = true, mapper = true, ["e-binop"] = true, unary = true, ["e-field-access"] = true, ["e-tuple-access"] = true, receiver = true}
const LOOSE_PASS = {["e-record"] = true, ["e-list"] = true, ["e-tuple"] = true, field = true}

function passes(k, loose)
  return has_key(PASS, k) or (loose and has_key(LOOSE_PASS, k))
end

function is_call(n)
  return n.kind == "e-apply" or n.kind == "e-method-call"
end

-- The call depth at node `i` of `ns`, kept in `memo` (-1 not yet known).
function cd(ns, memo, i, loose)
  if memo[i] >= 0 then return memo[i] end
  local n = ns[i]
  local k = n.kind
  local v = 0
  if k == "e-apply" then
    local best = 0
    for a in drop(n.kids, 1) do
      local x = cd(ns, memo, a, loose)
      if x > best then best = x end
    end
    -- A tag's payload (`Ok(...)`) is no call.
    if ns[n.kids[1]].kind == "e-tag" then v = best else v = 1 + best end
  elseif k == "e-method-call" then
    local recv = 0
    local best = 0
    for c in n.kids do
      if ns[c].kind == "receiver" then recv = cd(ns, memo, ns[c].kids[1], loose) end
      if ns[c].kind == "args" then
        for a in ns[c].kids do
          local x = cd(ns, memo, a, loose)
          if x > best then best = x end
        end
      end
    end
    v = 1 + best
    if recv > v then v = recv end
  elseif passes(k, loose) or (k == "e-tuple" and #n.kids == 1) then
    -- A one-item tuple is parentheses.
    for c in n.kids do
      local x = cd(ns, memo, c, loose)
      if x > v then v = x end
    end
  end
  memo[i] = v
  return v
end

-- `i` is the outermost of its nest unless, climbing through what passes
-- depth on, the first call above it is as deep.
function outermost(ns, memo, i, loose)
  local p = ns[i].parent
  while p > 0 do
    local k = ns[p].kind
    if is_call(ns[p]) then return cd(ns, memo, p, loose) < cd(ns, memo, i, loose) end
    if k == "receiver" or k == "args" or passes(k, loose) or k == "e-tuple" then
      p = ns[p].parent
    else
      return true
    end
  end
  return true
end

const paths = glob(GLOB)
local count = 0
local by = {}
local refused = 0
local said = {}
-- Each line's findings for the self-test, `path:line` -> `{col, depth}`
-- in column order, and each printed line, to catch two alike.
const at = {}
const printed = {}
for f in roc_tree(paths) do
  if f.err ~= "" then
    push(said, f.path .. ": roc-ast: " .. f.err)
    refused = refused + 1
  else
    local ns = f.nodes
    local memo = {}
    for n in ns do push(memo, -1) end
    local src = {}
    for i = 1, #ns do
      if is_call(ns[i]) and cd(ns, memo, i, LOOSE) >= MIN and outermost(ns, memo, i, LOOSE) then
        if #src == 0 then src = split(read(f.path), "\n") end
        local line = ns[i].line
        local d = cd(ns, memo, i, LOOSE)
        local l = f.path .. ":" .. line .. ":" .. ns[i].col .. ": nested: depth " .. d .. ": " .. trim(src[line])
        push(said, l)
        incr(printed, l)
        by[tostring(d)] = get(by, tostring(d), 0) + 1
        push_at(at, f.path .. ":" .. line, {col = ns[i].col, depth = d})
        count = count + 1
      end
    end
  end
end
local counts = {}
for k in sort(keys(by)) do push(counts, "depth " .. k .. " " .. by[k]) end
print_summed("nest_depth (Roc): " .. #paths .. " files; nested " .. count .. " (min " .. MIN .. ", " .. (LOOSE and "loose" or "strict") .. ")" .. (#counts > 0 and ("; " .. join(counts, ", ")) or ""), said)
if refused > 0 then fail("nest_depth: roc-ast refused " .. refused .. " files: a file that does not parse has no tree to hunt") end
if SELF then
  local wrong = {}
  local marks = 0
  for p in paths do
    local n = 0
    for l in lines(read(p)) do
      n = n + 1
      local m = re_find(l, "# depth ([0-9]+(?:, [0-9]+)*)$")
      local key = p .. ":" .. n
      local got = {}
      if has_key(at, key) then
        for g in sort(at[key], "col") do push(got, tostring(g.depth)) end
      end
      if m ~= nil then
        marks = marks + 1
        if starts_with(sub(p, #PLANTS + 1), "quiet_") then push(wrong, key .. ": a quiet plant holds a `# depth` mark") end
        local want = m.groups[1]
        if #got == 0 then push(wrong, key .. ": no finding, want depth " .. want)
        elseif join(got, ", ") ~= want then push(wrong, key .. ": depth " .. join(got, ", ") .. ", want " .. want) end
      elseif #got > 0 then
        push(wrong, key .. ": a finding (depth " .. join(got, ", ") .. ") on a line not marked for one")
      end
    end
  end
  for l in keys(printed) do
    if printed[l] > 1 then push(wrong, "two findings print the same line, " .. l) end
  end
  if marks == 0 then push(wrong, "no plant holds a `# depth` mark") end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("nest_depth self_test: " .. #wrong .. " plants wrong") end
  print("nest_depth (Roc) self_test: PASS (each marked line gives its depths left to right, the outermost only, no other line a finding, and no two findings print alike)")
end
