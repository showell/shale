-- This recipe writes the table of Roc's builtin functions that
-- rewrite_method_calls reads to tell a peer call, one whose first two
-- arguments are of one type, so no argument is the subject. A call's types
-- can't tell a type variable from a type, and a builtin's declaration can:
-- `List.concat : List(item), List(item) -> List(item)` takes peers, and
-- `List.fold : List(item), state, ...` doesn't, though `xs.fold([], f)`
-- passes two lists. For each function of two parameters or more declared
-- in a type's block of a pin's Builtin.roc, read by Roc's own parser
-- (`roc_tree`), the table says `peers` or `apart` (`peer_builtin_signatures`
-- in cookbook/roc/peer_calls.shale), and it is written to
-- cookbook/roc/builtin_signatures/<pin>.txt.
--
--   shale cookbook:roc/write_builtin_signatures.shale pin=nightly-2026-11-03-34bd006
--   shale cookbook:roc/write_builtin_signatures.shale pin=nightly-2026-11-03-34bd006 check=1
--   shale cookbook:roc/write_builtin_signatures.shale self_test=1
--
-- The arguments:
--   pin      the Roc nightly the table is for, SELF_TEST_PIN by default.
--   builtin  the pin's Builtin.roc, by default
--            `tools:roc-<hash>/src/build/roc/Builtin.roc`, <hash> the pin's
--            last part: roc-lang/roc at the pin's commit, fetched as
--            roc-apps' CLAUDE.md §1 says.
--   check    with `check=1`, nothing is written, and the run fails when the
--            table differs from what the Builtin.roc gives.
-- `self_test=1` reads the plant
-- cookbook/roc/plants/write_builtin_signatures/Builtin.roc, a few of the
-- real file's declarations, and holds what it gives to Builtin.want beside
-- it.
-- budget: steps=900000000 arena_bytes=1500000000

use("./pinned.shale")
use("./peer_calls.shale")

const SELF_TEST = arg("self_test", "") == "1"
const PIN = arg("pin", SELF_TEST_PIN)
const HASH = split(PIN, "-")[#split(PIN, "-")]
const BUILTIN = arg("builtin", "tools:roc-" .. HASH .. "/src/build/roc/Builtin.roc")
const CHECK = arg("check", "") == "1"
const PLANT = "cookbook:roc/plants/write_builtin_signatures/Builtin"
const TABLE = "cookbook:roc/builtin_signatures/" .. PIN .. ".txt"

-- The table's text for the Builtin.roc at `path`.
function table_text(path, pin)
  if not exists(path) then fail("write_builtin_signatures: no " .. path .. ": fetch roc-lang/roc at the commit of " .. pin .. " (roc-apps' CLAUDE.md §1), or name it with builtin=") end
  local f = roc_tree({path})[1]
  if f.err ~= "" then fail("write_builtin_signatures: roc-ast: " .. path .. ": " .. f.err) end
  local rows = peer_builtin_signatures(f)
  return "# Roc's builtin functions of two parameters or more, at " .. pin .. ": `peers` when the\n# first two have one type, `apart` when not. Written by\n# cookbook/roc/write_builtin_signatures.shale from that pin's Builtin.roc; not edited by hand.\n" .. join(rows, "\n") .. "\n"
end

if SELF_TEST then
  local got = table_text(PLANT .. ".roc", "the plant")
  if got ~= read(PLANT .. ".want") then
    print(got)
    fail("write_builtin_signatures: self-test: the plant's table is not Builtin.want (above, what it gave)")
  end
  print("write_builtin_signatures: self-test: the plant's table is Builtin.want, " .. #lines(trim(got)) - 3 .. " functions")
elseif CHECK then
  local got = table_text(BUILTIN, PIN)
  if not exists(TABLE) then fail("write_builtin_signatures: no " .. TABLE .. " to check") end
  if got ~= read(TABLE) then fail("write_builtin_signatures: " .. TABLE .. " is not what " .. BUILTIN .. " gives: write it again, without check=1") end
  print("write_builtin_signatures: " .. TABLE .. " is " .. BUILTIN .. "'s")
else
  local got = table_text(BUILTIN, PIN)
  replace(TABLE, got)
  print("write_builtin_signatures: " .. TABLE .. ", " .. #lines(trim(got)) - 3 .. " functions")
end
