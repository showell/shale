-- Compare two builds of a Roc archive (or of any object file objdump can
-- disassemble) and say whether they hold the same machine code, and if not,
-- where they first differ. Roc names each procedure `roc__p` or `roc__proc_`
-- followed by hex digits that change whenever the source's layout does, so a pure
-- reformat (roc fmt, a new comment, a renamed local) changes the archive's
-- bytes without changing its code. This script masks those names before
-- comparing the two disassemblies line by line.
--
--   cd <repo> && shale <shale>/cookbook/roc/same_code.shale old=<a.a> new=<b.a>
--
-- To get the old archive, build the old commit in a git worktree. The run
-- fails on an archive objdump can't disassemble (binutils' objdump doesn't
-- read wasm32), because two empty listings would compare as the same.
--
-- budget: steps=400000000 arena_bytes=2000000000

const OLD = arg("old", "")
const NEW = arg("new", "")

-- The line with each `roc__p<hex>` and `roc__proc_<hex>` written as `roc__pX`.
function with_roc_names_masked(line)
  if not contains(line, "roc__p") then return line end
  return re_replace(line, "roc__p(roc_)?[0-9a-f]+", "roc__pX")
end

-- The file's disassembly with Roc's names masked. The lines naming the file
-- itself are left out, and the addresses are kept, since the same code is
-- laid out at the same addresses.
function disassembly(path)
  local r = run({"objdump", "-dr", "--no-show-raw-insn", path}, {timeout_ms = 120000, whole = 64000000})
  if r.code ~= 0 then fail("objdump failed on " .. path .. " (code " .. r.code .. "), so it can't be compared: " .. trim(sub(r.out, 1, 200))) end
  local out = {}
  local instructions = 0
  for l in lines(r.out) do
    if not contains(l, "file format") and not starts_with(l, "In archive") then
      local masked = with_roc_names_masked(l)
      push(out, masked)
      if like(masked, "*:\t*") then instructions = instructions + 1 end
    end
  end
  if instructions == 0 then fail("objdump read no instructions from " .. path .. " (wasm32? binutils can't), so it can't be compared") end
  return out
end

if OLD == "" or NEW == "" then fail("same_code needs old=<archive> new=<archive>") end
local old_lines = disassembly(OLD)
local new_lines = disassembly(NEW)
for i = 1, min(#old_lines, #new_lines) do
  if old_lines[i] ~= new_lines[i] then
    print("DIFFERENT at line " .. i .. " of " .. #old_lines .. " and " .. #new_lines .. ":")
    print("  old: " .. old_lines[i])
    print("  new: " .. new_lines[i])
    fail("not the same code")
  end
end
if #old_lines ~= #new_lines then fail("DIFFERENT: " .. #old_lines .. " lines against " .. #new_lines) end
print("SAME: " .. #old_lines .. " lines of disassembly, Roc's hashed names masked")
