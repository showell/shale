-- cookbook/roc/find_extra_parens/check_goldens.shale: find_extra_parens (the
-- Roc script beside this, find_extra_parens.roc, through its launcher
-- cookbook/roc/find_extra_parens.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/find_extra_parens/check_goldens.shale self_test=1
--   shale cookbook/roc/find_extra_parens/check_goldens.shale write=1
--
-- The cases are the self-test's plants with and without `house=0`, the
-- edges' plants (comments beside the brackets, two findings on a line, a
-- unary and a `match`, which the tree gives no span, a CRLF file, a file
-- without its last newline, non-ASCII before an `if`) and the broken ones
-- with and without it, all of them at once, a glob that finds nothing, a
-- `house` that is neither 0 nor 1, `write=1` under `house=0`, `self_test=1`,
-- and **the rewrite itself**: `write=1` on a copy of every plant (with a
-- `roc-version`, the self-tests' pin), the copy's files after it held line
-- for line, a CR shown as `<CR>`. The goldens were written from the Shale
-- original's output on them, and the port matched it on other repositories'
-- trees too (roc-chat, roc-apps with and without `house=0`, roc-screensaver,
-- and `write=1` on copies of roc-apps and roc-screensaver, every file
-- rewritten alike), which are left out because their code moves. `write=1`
-- writes the goldens again from the launcher, for a change meant to move
-- them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude
-- included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000
use("cookbook:roc/pinned.shale")

const LAUNCHER = "cookbook/roc/find_extra_parens.shale"
const GOLDENS = "cookbook/roc/find_extra_parens/goldens.txt"
const AT = "cookbook:roc/plants/find_extra_parens/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The plant rows, as `{glob, args}`.
const ROWS = {
  {glob = "*.roc"},
  {glob = "*.roc", args = "house=0"},
  {glob = "edges/*.roc"},
  {glob = "edges/*.roc", args = "house=0"},
  {glob = "broken/*.roc"},
  {glob = "**/*.roc"},
  {glob = "**/*.roc", args = "house=0"},
  {glob = "nothing_here/*.roc"},
  {glob = "*.roc", args = "house=2"},
  {glob = "edges/*.roc", args = "write=1\nhouse=0"},
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: find_extra_parens: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- Each case, `{name, values}`: the values on the launcher's stdin; the
-- rewrite's case has `copy` too.
function cases()
  local out = {}
  for row in ROWS do
    local values = "glob=" .. AT .. row.glob .. "\n"
    local name = row.glob
    if has_key(row, "args") then
      values = values .. row.args .. "\n"
      name = name .. " " .. join(split(row.args, "\n"), " ")
    end
    push(out, {name = name, values = values})
  end
  push(out, {name = "self_test=1", values = "self_test=1\n"})
  push(out, {name = "write=1 on a copy of every plant", values = "write=1\n", copy = true})
  return out
end

-- The plants copied to a fresh folder, with the self-tests' `roc-version`.
function copy_plants()
  local dir = fresh_dir("scratch:", "parens-goldens")
  for p in glob(AT .. "**/*.roc") do
    local rel = sub(p, #AT + 1, #p)
    mkdir(dirname(dir .. "/" .. rel))
    replace(dir .. "/" .. rel, read(p))
  end
  replace(dir .. "/roc-version", SELF_TEST_PIN .. "\n")
  return dir
end

-- The copy's files after the rewrite, each `--- path` and its lines.
function copy_lines(dir)
  local ls = {}
  for p in glob(dir .. "/**/*.roc") do
    push(ls, "--- " .. sub(p, #dir + 2, #p))
    for l in lines(join(split(read(p), "\r"), "<CR>")) do push(ls, l) end
  end
  return ls
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local opts = {stdin = c.values, timeout_ms = 900000, whole = 8000000}
  local dir = nil
  if has_key(c, "copy") then
    dir = copy_plants()
    opts.cwd = dir
  end
  local r = run({"shale", real(LAUNCHER), "--args-stdin"}, opts)
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  if dir ~= nil then
    for l in copy_lines(dir) do push(ls, l) end
    remove_tree(dir)
  end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
