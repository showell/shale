-- cookbook/roc/wrap_long_lines/check_goldens.shale: wrap_long_lines (the
-- Roc script beside this, wrap_long_lines.roc, through its launcher
-- cookbook/roc/wrap_long_lines.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/wrap_long_lines/check_goldens.shale self_test=1
--   shale cookbook/roc/wrap_long_lines/check_goldens.shale write=1
--
-- wrap_long_lines rewrites folders in place and runs the Roc that the
-- `roc-version` where it starts names, and Shale's checkout has none, so
-- every case but the self-test runs in a copy: a fresh folder holding the
-- plants it names (`roc`, the self-test's plants, whose folder is the
-- recipe's default `dir`; `edges`, the edges' plants; `too_deep`, the plant
-- that never settles) and a `roc-version`, the self-tests' pin. The copy's
-- files after the run are held too, line for line. The cases are the
-- self-test's plants with the arguments moved (`tokens`, `width`,
-- `write=0`), the edges (a comment, numeric data and a string counted, a
-- line listed and cut, tabs, groups that join or stay stacked, lambdas and
-- a `where` clause, a folder inside the one named) with and without the
-- rule, two folders at once, a rewrite that never settles alone and after a
-- folder that does, a bad `write` and `dir`, a copy with no
-- `roc-version`, and `self_test=1`. The goldens were written from the Shale
-- original's output on them, and the port matched it on other
-- repositories' trees too (`write=1` on copies of roc-chat, roc-screensaver
-- and roc-apps' projects, every file rewritten alike), which are left out
-- because their code moves. `write=1` writes the goldens again from the
-- launcher, for a change meant to move them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude
-- included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000
use("cookbook:roc/pinned.shale")

const LAUNCHER = "cookbook/roc/wrap_long_lines.shale"
const GOLDENS = "cookbook/roc/wrap_long_lines/goldens.txt"
const AT = "cookbook:roc/plants/wrap_long_lines"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The cases, as `{copy, args}`: the plant folders copied, comma-separated,
-- and the launcher's values, a line each. `bare` leaves out the
-- `roc-version`.
const ROWS = {
  {copy = "roc", args = ""},
  {copy = "roc", args = "tokens=6"},
  {copy = "roc", args = "width=60"},
  {copy = "roc", args = "tokens=6\nwrite=0"},
  {copy = "edges", args = "dir=edges"},
  {copy = "edges", args = "dir=edges\ntokens=6"},
  {copy = "edges", args = "dir=edges\nwidth=80\ntokens=4"},
  {copy = "edges", args = "dir=edges\ntokens=6\nwrite=0"},
  {copy = "roc,edges", args = "dir=roc,edges\ntokens=6"},
  {copy = "too_deep", args = "dir=too_deep\ntokens=6"},
  {copy = "roc,too_deep", args = "dir=roc,too_deep\ntokens=6"},
  {copy = "roc", args = "write=2"},
  {copy = "roc", args = "dir=,"},
  {copy = "roc", args = "dir=-roc"},
  {copy = "roc", args = "tokens=6", bare = true},
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: wrap_long_lines: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- Each case, `{name, values, copy, bare}`: the values on the launcher's
-- stdin.
function cases()
  local out = {}
  for row in ROWS do
    local name = "copy=" .. row.copy
    if row.args ~= "" then name = name .. " " .. join(split(row.args, "\n"), " ") end
    local bare = get(row, "bare", false)
    if bare then name = name .. " (no roc-version)" end
    push(out, {name = name, values = row.args .. "\n", copy = row.copy, bare = bare})
  end
  push(out, {name = "self_test=1", values = "self_test=1\n", copy = "", bare = false})
  return out
end

-- The plant folder `name`'s files, as `{from, to}`: `roc` is the
-- self-test's plants (their `.roc` files alone), the others a folder of
-- the plants whole.
function plant_files(name)
  local out = {}
  if name == "roc" then
    for p in glob(AT .. "/*.roc") do push(out, {from = p, to = "roc/" .. basename(p)}) end
  else
    for p in glob(AT .. "/" .. name .. "/**/*.roc") do push(out, {from = p, to = name .. "/" .. sub(p, #AT + #name + 3)}) end
  end
  return out
end

-- The plant folders `names` copied to a fresh folder, with the self-tests'
-- `roc-version` unless `bare`.
function copy_plants(names, bare)
  local dir = fresh_dir("scratch:", "wrap-goldens")
  for name in split(names, ",") do
    for f in plant_files(name) do
      mkdir(dirname(dir .. "/" .. f.to))
      replace(dir .. "/" .. f.to, read(f.from))
    end
  end
  if not bare then replace(dir .. "/roc-version", SELF_TEST_PIN .. "\n") end
  return dir
end

-- The copy's files after the run, each `--- path` and its lines.
function copy_lines(dir)
  local ls = {}
  for p in glob(dir .. "/**/*.roc") do
    push(ls, "--- " .. sub(p, #dir + 2, #p))
    for l in lines(join(split(read(p), "\r"), "<CR>")) do push(ls, l) end
  end
  return ls
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local opts = {stdin = c.values, timeout_ms = 900000, whole = 8000000}
  local dir = nil
  if c.copy ~= "" then
    dir = copy_plants(c.copy, c.bare)
    opts.cwd = dir
  end
  local r = run({"shale", real(LAUNCHER), "--args-stdin"}, opts)
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  if dir ~= nil then
    for l in copy_lines(dir) do push(ls, l) end
    remove_tree(dir)
  end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
