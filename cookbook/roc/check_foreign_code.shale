-- This recipe reads another project's Roc code with every check that can matter
-- to it. It runs each recipe once over the whole tree, because `check_families`
-- and `check_boundaries` judge across folders, and with `house=0`, because our house
-- style is no fault in someone else's code. It only parses: it starts no Roc
-- compiler and runs nothing from the tree.
--
--   cd <their repo> && shale <shale>/cookbook/roc/check_foreign_code.shale
--   shale cookbook:roc/check_foreign_code.shale self_test=1
--
-- The arguments, each optional:
--   glob           the files to read, `**/*.roc` by default;
--   out            the folder for each recipe's whole output, `scratch:foreign`
--                  by default;
--   roles          for `check_families`, the project's file of type names each module
--                  declares for itself;
--   terms          for `find_unclear_names`, its file of fixed terms;
--   abbreviations  for `find_unclear_names`, its own file of abbreviations;
--   self_test      with `self_test=1`, check the plants in
--                  `cookbook/roc/plants/check_foreign_code/`.
--
-- It prints each recipe's summary, then the findings to read first, and names
-- any guide the tree has of its own, whose rules outrank ours. It fails if a
-- recipe stops before its summary, or if a file doesn't parse.
-- budget: output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const GLOB = arg("glob", "**/*.roc")
const OUT = arg("out", "scratch:foreign")
const ROLES = arg("roles", "")
const TERMS = arg("terms", "")
const ABBREVIATIONS = arg("abbreviations", "")
use("cookbook:roc/gate_recipe.shale")
use("cookbook:roc/house.shale")

const RECIPES = {"check_boundaries", "check_errors", "check_families", "hunt_names", "find_deep_calls", "find_extra_parens", "find_unclear_names", "check_stacking"}
const READ_FIRST = {"dead", "same_branches", "number_fallback", "placeholder", "set_fallback", "twin_name", "family", "unused_api"}
const GUIDES = {"docs/roc-style.md", "AGENTS.md", "CLAUDE.md", "CONTRIBUTING.md"}
const PLANTS = "cookbook:roc/plants/check_foreign_code"

function recipe_argv(recipe, glob, more)
  local argv = {"shale", real("cookbook:roc/" .. recipe .. ".shale"), "glob=" .. glob}
  for a in more do push(argv, a) end
  return argv
end

-- A project's own data, for the recipes that take it, and `house=0` for those
-- with house checks.
function foreign_args(recipe)
  local out = {}
  if has_key(HOUSE_CHECKS, recipe) then push(out, "house=0") end
  if recipe == "check_families" and ROLES ~= "" then push(out, "roles=" .. ROLES) end
  if recipe == "find_unclear_names" and TERMS ~= "" then push(out, "terms=" .. TERMS) end
  if recipe == "find_unclear_names" and ABBREVIATIONS ~= "" then push(out, "abbreviations=" .. ABBREVIATIONS) end
  return out
end

function lines_of_check(out, check)
  local found = {}
  for l in lines(out) do
    if contains(l, ": " .. check .. ": ") then push(found, l) end
  end
  return found
end

function sweep()
  mkdir(OUT)
  local refused = {}
  local first = {}
  for c in READ_FIRST do first[c] = {} end
  for recipe in RECIPES do
    local r = run(recipe_argv(recipe, GLOB, foreign_args(recipe)), {timeout_ms = 600000, whole = 16000000, want = "any"})
    replace(OUT .. "/" .. recipe .. ".txt", r.out)
    local summary = last_said(r.out)
    if not contains(summary, " files") then fail("check_foreign_code: " .. recipe .. " stopped before its summary: " .. trim(r.out)) end
    print(summary)
    for l in lines(r.out) do
      if starts_with(l, "refused: ") then push(refused, l) end
    end
    for c in READ_FIRST do
      for l in lines_of_check(r.out, c) do push(first[c], l) end
    end
  end
  print("")
  print("Read these first. Every recipe's whole output is in " .. OUT .. "/.")
  for c in READ_FIRST do
    for l in first[c] do print(l) end
  end
  for guide in GUIDES do
    if exists(guide) then print("This tree has its own guide, " .. guide .. ": a rule of ours left out above may be one of theirs, and theirs decide.") end
  end
  for l in unique(refused) do print(l) end
  if #refused > 0 then fail("check_foreign_code: roc-ast refused files, named above, which were judged by nothing") end
  return nil
end

function faults_of_house_run(recipe, glob)
  local faults = {}
  local on = run(recipe_argv(recipe, glob, {}), {timeout_ms = 120000, whole = 4000000, want = "any"})
  local off = run(recipe_argv(recipe, glob, {"house=0"}), {timeout_ms = 120000, whole = 4000000, want = "any"})
  for check in HOUSE_CHECKS[recipe] do
    if #lines_of_check(on.out, check) == 0 then push(faults, recipe .. ": `" .. check .. "` is silent by default") end
    if #lines_of_check(off.out, check) > 0 then push(faults, recipe .. ": `" .. check .. "` fires under house=0") end
  end
  if not contains(last_said(off.out), "left out as house style") then push(faults, recipe .. ": its summary under house=0 doesn't say so") end
  return faults
end

function faults_of_sweep()
  local faults = {}
  local r = run({"shale", real("cookbook:roc/check_foreign_code.shale"), "out=scratch:foreign_test"}, {cwd = PLANTS, timeout_ms = 120000, whole = 4000000, want = "any"})
  if r.code ~= 0 then push(faults, "the sweep exited " .. r.code) end
  for word in {": dead: `Style.leftover`", ": number_fallback: ", ": unused_api: `Shown.alone`", "its own guide, docs/roc-style.md"} do
    if not contains(r.out, word) then push(faults, "the sweep doesn't say `" .. word .. "`") end
  end
  if contains(r.out, ": paren_if: ") then push(faults, "the sweep prints a house check") end
  if contains(read("scratch:foreign_test/find_extra_parens.txt"), ": paren_if: ") then push(faults, "the sweep's own output holds a house check") end
  return faults
end

-- A platform's stacked `requires` is its own to choose, and an annotation it
-- doesn't dictate is not.
function faults_of_platform_names()
  local r = run(recipe_argv("check_stacking", PLANTS .. "/platform/main.roc", {}), {timeout_ms = 120000, whole = 4000000, want = "any"})
  local bare = lines_of_check(r.out, "stack")
  if #bare ~= 1 or not contains(bare[1], "main.roc:17:") then return {"check_stacking on the platform plant gives: " .. join(bare, " | ")} end
  return {}
end

function faults_of_rewrite_refusal()
  local faults = {}
  for recipe in {"check_stacking", "find_extra_parens"} do
    local r = run(recipe_argv(recipe, PLANTS .. "/Style.roc", {"house=0", "write=1"}), {timeout_ms = 120000, whole = 4000000, want = "any"})
    if r.code == 0 or not contains(r.out, "refuses house=0") then push(faults, recipe .. " accepts write=1 house=0") end
  end
  return faults
end

function self_test()
  local faults = {}
  for recipe in keys(HOUSE_CHECKS) do
    for f in faults_of_house_run(recipe, PLANTS .. "/*.roc") do push(faults, f) end
  end
  for f in faults_of_sweep() do push(faults, f) end
  for f in faults_of_platform_names() do push(faults, f) end
  for f in faults_of_rewrite_refusal() do push(faults, f) end
  for f in faults do print("FAIL " .. f) end
  if #faults > 0 then fail("check_foreign_code self_test: " .. #faults .. " wrong") end
  print("check_foreign_code self_test: PASS (each house check fires by default and not under house=0, and the sweep keeps what is real)")
  return nil
end

if SELF_TEST then self_test() else sweep() end
