-- cookbook/roc/find_calls_nested_three_deep/check_goldens.shale: find_calls_nested_three_deep (the Roc
-- script beside this, find_calls_nested_three_deep.roc, through its launcher
-- cookbook/roc/find_calls_nested_three_deep.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/find_calls_nested_three_deep/check_goldens.shale self_test=1
--   shale cookbook/roc/find_calls_nested_three_deep/check_goldens.shale write=1
--
-- The cases are each plant alone, all of them at several `min`s, `loose`
-- and `house` both ways, a bad `house`, a glob Shale refuses, an empty glob,
-- files that don't parse, and `self_test=1`. The goldens were written from
-- the Shale original's output on them, and the port matched it on other
-- repositories' trees too (roc-chat, roc-markdown, roc-syntax-color,
-- roc-apps, roc-screensaver, each at `min=3`, `min=4`, `loose=1` and
-- `house=0`), which are left out because their code moves. Two cases of the
-- original's are left out because only their stop's words differ: a `min`
-- that is no integer (the Roc says `find_calls_nested_three_deep: min=abc is not an
-- integer`) and a value the recipe reads no `arg` of (run.shale names it).
-- `write=1` writes the goldens again from the launcher, for a change meant
-- to move them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude
-- included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/roc/find_calls_nested_three_deep.shale"
const GOLDENS = "cookbook/roc/find_calls_nested_three_deep/goldens.txt"
const AT = "cookbook:roc/plants/find_calls_nested_three_deep/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

const PLANTS = {
  "nested.roc",
  "nested_interpolation.roc",
  "nested_lines.roc",
  "nested_operator.roc",
  "nested_outermost.roc",
  "nested_two.roc",
  "quiet_chain.roc",
  "quiet_operator.roc",
  "quiet_parts.roc",
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: find_calls_nested_three_deep: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- Each case, `{name, values}`: the values on the launcher's stdin, one a line.
function cases()
  local c = {}
  local all = "glob=" .. AT .. "*.roc"
  for p in PLANTS do push(c, {name = "plant " .. p, values = {"glob=" .. AT .. p}}) end
  push(c, {name = "plants *.roc", values = {all}})
  for m in {"0", "1", "2", "4", "5", "9"} do push(c, {name = "plants min=" .. m, values = {all, "min=" .. m}}) end
  push(c, {name = "plants loose=1", values = {all, "loose=1"}})
  push(c, {name = "plants loose=1 min=2", values = {all, "loose=1", "min=2"}})
  push(c, {name = "plants loose=0", values = {all, "loose=0"}})
  push(c, {name = "plants house=0", values = {all, "house=0"}})
  push(c, {name = "plants house=1", values = {all, "house=1"}})
  push(c, {name = "plants house=2", values = {all, "house=2"}})
  push(c, {name = "two globs", values = {"glob=" .. AT .. "nested.roc," .. AT .. "nested_two.roc"}})
  push(c, {name = "nothing", values = {"glob=" .. AT .. "nothing_here/*.roc"}})
  push(c, {name = "broken", values = {"glob=cookbook:roc/plants/find_unused_imports/broken/*.roc"}})
  push(c, {name = "broken and plants", values = {"glob=cookbook:roc/plants/**/*.roc", "min=4"}})
  push(c, {name = "self_test=1", values = {"self_test=1"}})
  return c
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = join(c.values, "\n") .. "\n", timeout_ms = 900000, whole = 8000000})
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
