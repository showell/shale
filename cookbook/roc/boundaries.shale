-- **A FUNCTION'S BOUNDARY, AND A PARAMETER THAT IS NONE** (metal-vmm QUEUE
-- 303, from the Roc style review's S6 and S7): every top-level and
-- module-member function (`f = |...| ...` outside any lambda) and every
-- reference to it, read from Roc's own parser's tree (`roc_tree`, the Linux
-- prelude's, over roc-ast at `tools:roc-ast/bin/roc-ast`). A finding
-- is a question for a reader, never a verdict:
--
--   single  a wrapper (a body of one statement of at most `nodes`, 24, of
--           the tree's nodes and at most `ways`, 2, ways through it: an
--           `if` and its `else`, or a `match` of two arms; the tree
--           measures it, so no layout of its lines changes the verdict)
--           with exactly one production reference outside its own body,
--           a call, which no `expect` and no test file reaches and no `##`
--           doc explains:
--           read better inline (roc-apps docs/roc-style.md, "A function
--           earns its boundary"). Quiet: a pure decision an `expect`
--           reaches, the public name a twin holds to its Zig (a test file
--           reaches it), a function passed as a value (`map_ok(Uid.to_str)`),
--           a question (`is_*`, `has_*`), whose name is the concept its
--           test stands for (`is_message`), and one whose `##` doc says
--           why it stands alone (a rule's one home), as the guide's
--           one-caller module is kept when its reason is written down.
--           **A RECURSION IS NO WRAPPER**: a function whose body
--           references itself cannot be read inline, and nor can an entry
--           into one, a wrapper whose body calls such a function: the
--           shape `fixed` and `entry` ask for, so the checks never
--           disagree. The guide calls this a rule of thumb, not a gate.
--   fixed   a parameter (a position, or a field of a record argument) that
--           every production call, two or more, fills with the same
--           **literal**: a number, a string, a character, a tag
--           (`Begin`, `Bool.true`) or a module's constant (`Limits.max`)
--           ("A parameter every caller passes the same value is no
--           parameter"): no parameter, or an entry function that takes
--           only what varies. A recursion's own calls count, and must pass
--           the same literal too. **CONTEXT PASSED DOWN IS NO
--           CONSTANT**: the same variable (`me`, `accounts`, `at`), field
--           (`req.me`) or call (`Host.list_srcs!({})`) at every call is the
--           caller's value handed on, never a finding.
--   entry   **A RECURSION'S START**: the same literal at every production
--           call, two or more, that the recursion's own calls vary (`at:
--           0` outside, `at + 1` inside). It is a parameter, as the
--           recursion needs it, so only `fixed`'s second half holds: an
--           entry function that takes only what varies (`count = |xs|
--           count_from(xs, 0)`). Where one is there already it is the one
--           outside call, fewer than two, and never judged. Its own calls
--           are no caller for `single`.
--   constant  a function of `{}` alone (its annotation's one argument, or
--           its lambda's one pattern, is `{}`) whose name has no `!`: it
--           gives the same value every call, and a constant says so
--           (`board = ...`, not `board = |{}| ...`). An effect needs the
--           call, and its `!` keeps it quiet. **A CONSTANT CANNOT BE
--           GENERIC**: an annotation whose return type holds a type
--           variable (`{} -> Viewer(id)`) keeps it quiet, as Roc refuses
--           that constant ("value is not polymorphic... make it a function
--           that takes {}"); an unannotated one shows no type, and fires.
--
-- **WHAT A COUNT COUNTS**: `single`'s one caller and `fixed`'s and `entry`'s calls are
-- those in the files the glob reads, and a finding says how many: a sweep
-- of one folder never sees a caller in its siblings.
--
-- **A REFERENCE** is a bare `name` in the defining file, `Type.name`
-- anywhere, or a method call `.name(...)`, attributed to every member of
-- that name: a function so reached by a name two types share is
-- ambiguous and judged by neither check. An arrow call's receiver
-- (`x->f(a)`) and a method's are the first argument. **A TEST FILE** is a
-- twin (`twin.roc`, a name ending `twin.roc`, a `twin/` folder), under
-- `test/`, or a spec app, a name ending `<Module>Spec.roc` (`BlitSpec.roc`,
-- a `main!` that grades `Blit`: roc-apps canvas_apps/safari/README.md, "The
-- map"): it reaches code as an `expect` does, so its references are no
-- production caller and its own functions are never judged. A finding
-- names its file and the definition's line.
--
-- One line a finding, `path:line: <check>: <why>`, then the counts.
--
--   cd <repo> && shale <shale>/cookbook/roc/boundaries.shale glob=chat/**/*.roc
--   shale cookbook:roc/boundaries.shale self_test=1
--
-- Read the whole tree, tests too: a twin's reference is what keeps a
-- function quiet. `self_test=1` runs it over `cookbook/roc/plants/
-- boundaries/`, each plant named for the check it holds: every check must
-- fire on its own plants and on no other, a `quiet_*.roc` plant on none
-- (`quiet_WalkSpec.roc` a test file among them).
-- budget: steps=800000000 arena_bytes=3000000000

const SELF = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/boundaries/"
const GLOB = SELF and (PLANTS .. "*.roc") or arg("glob", "**/*.roc")
const WAYS = arg("ways", 2)
const NODES = arg("nodes", 24)
const CHECKS = {"single", "fixed", "entry", "constant"}
-- Every file's nodes in one list, in order: `NODE[g]` a node of `roc_tree`,
-- `PATH[g]` its file, `BASE[g]` the index before its file's first node, so
-- a node's `parent` and `kids` are `BASE[g] +` theirs.
const NODE = {}
const PATH = {}
const BASE = {}
const SRC = {}
const OUTER = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

const found = {}
for c in CHECKS do found[c] = 0 end
const per_file = {}

function say(p, line, check, why)
  print(p .. ":" .. line .. ": " .. check .. ": " .. why)
  found[check] = found[check] + 1
  per_file[p .. "|" .. check] = true
  return nil
end

function children(g)
  local out = {}
  for k in NODE[g].kids do push(out, BASE[g] + k) end
  return out
end

function parent(g)
  local p = NODE[g].parent
  if p == 0 then return 0 end
  return BASE[g] + p
end

function kind(g)
  return NODE[g].kind
end

function raw(g)
  return get(NODE[g], "raw", "")
end

-- A node's source text, from its span (the end column one past the last),
-- squeezed to one line.
function text_of(path, g)
  local n = NODE[g]
  if n.line == 0 then return "?" end
  local src = SRC[path]
  if n.line == n.end_line then return sub(src[n.line], n.col, n.end_col - 1) end
  local parts = {trim(sub(src[n.line], n.col))}
  for l = n.line + 1, n.end_line - 1 do push(parts, trim(src[l])) end
  push(parts, trim(sub(src[n.end_line], 1, n.end_col - 1)))
  return join(parts, " ")
end

-- A literal: a string, a character, a number, a tag alone or a module's
-- constant (`Begin`, `Bool.true`, `Limits.max`).
function is_literal(s)
  local c = sub(s, 1, 1)
  if c == "\"" or c == "'" then return true end
  if re_find(s, "^-?[0-9]") ~= nil then return true end
  if re_find(s, "^[A-Z][A-Za-z0-9]*(\\.[a-z_][a-z0-9_]*)?$") ~= nil then return true end
  return false
end

-- A question's name: what it tests is a concept named, not a wrapper.
function is_question(name)
  return starts_with(name, "is_") or starts_with(name, "has_")
end

-- The header's test file, its one home.
function is_test_file(p)
  if re_find(basename(p), "[A-Z][A-Za-z0-9]*Spec\\.roc$") ~= nil then return true end
  return ends_with(p, "twin.roc") or contains(p, "/twin/") or contains(p, "/test/") or starts_with(p, "test/") or starts_with(p, "twin/")
end

-- A module type's name: its `s-type-decl`'s header's.
function type_name(g)
  local kids = children(g)
  if #kids == 0 then return "" end
  return get(NODE[kids[1]], "name", "")
end

-- ── the tree ─────────────────────────────────────────────────────────────

local fs = glob(GLOB)
local refused = 0
for f in roc_tree(fs) do
  if f.err ~= "" then
    print(f.path .. ": roc-ast: " .. f.err)
    refused = refused + 1
  else
    SRC[f.path] = split(read(f.path), "\n")
    local base = #NODE
    for n in f.nodes do
      push(NODE, n)
      push(PATH, f.path)
      push(BASE, base)
    end
  end
end
-- A file that does not parse would pass its references unread.
if refused > 0 then fail("boundaries: roc-ast refused " .. refused .. " files: a file that does not parse has no tree to hunt") end

-- **WHAT A NODE'S ANCESTORS SAY**, each node's from its parent's, once (a
-- parent comes before its children): `OUTER_ALL[g]` every ancestor a file,
-- statements, module type or its members; `OWNER[g]` the nearest module
-- type's name ("" for none); `CALLER[g]` the outermost declaration's name
-- ("?" for none); `IN_EXPECT[g]` inside an `expect`.
const OUTER_ALL = {}
const OWNER = {}
const CALLER = {}
const IN_EXPECT = {}
for g = 1, #NODE do
  local p = parent(g)
  if p == 0 then
    push(OUTER_ALL, true)
    push(OWNER, "")
    push(CALLER, "?")
    push(IN_EXPECT, false)
  else
    local kp = kind(p)
    push(OUTER_ALL, OUTER_ALL[p] and has_key(OUTER, kp))
    push(OWNER, kp == "s-type-decl" and type_name(p) or OWNER[p])
    local caller = CALLER[p]
    if caller == "?" and kp == "s-decl" then
      local pk = children(p)
      if #pk > 0 and kind(pk[1]) == "p-ident" then caller = raw(pk[1]) end
    end
    push(CALLER, caller)
    push(IN_EXPECT, IN_EXPECT[p] or kp == "s-expect")
  end
end

-- How many `##` lines stand just above the function at `line`, over its
-- annotation (`name : ...`, one line or several) when it has one.
function doc_lines(src, name, line)
  local top = line - 1
  local k = top
  while k >= 1 and k > line - 12 and trim(src[k]) ~= "" and not starts_with(trim(src[k]), "#") do
    if starts_with(trim(src[k]), name .. " :") then top = k - 1 end
    k = k - 1
  end
  local n = 0
  while top >= 1 and starts_with(trim(src[top]), "##") do
    n = n + 1
    top = top - 1
  end
  return n
end

-- The nodes of the subtree at `g`, itself first, in order.
function subtree(g)
  local out = {g}
  local i = 1
  while i <= #out do
    for k in children(out[i]) do push(out, k) end
    i = i + 1
  end
  return out
end

-- **WHETHER THE LAMBDA AT `g` IS A WRAPPER**, `{wrapper, size}`, `size`
-- what a finding says of it. Its body is one statement (a block of one, or
-- an expression), measured by the tree's nodes (`NODES`), never its lines,
-- so `stack.shale write=1` laying a call's record out a field a line
-- changes nothing. A body that decides is measured by its ways too
-- (`WAYS`): one, and one more for each `if` and for each `match` arm past
-- its first. A decision's arms are its rule, and only a two-way choice
-- reads as a wrapper; an `else if` chain or a nested `if` is a rule of its
-- own however few lines it is written on.
function wrapper_size(g)
  local kids = children(g)
  local body = kids[#kids]
  if kind(body) == "e-block" then
    local stmts = {}
    for k in children(body) do
      if kind(k) == "statements" then stmts = children(k) end
    end
    if #stmts ~= 1 then return {wrapper = false, size = #stmts .. " statements"} end
    body = stmts[1]
  end
  local all = subtree(body)
  local ways = 1
  for k in all do
    if kind(k) == "e-if-then-else" then ways = ways + 1 end
    if kind(k) == "branches" then
      local arms = children(k)
      ways = ways + #arms - 1
    end
  end
  local small = #all <= NODES
  if ways > 1 then return {wrapper = small and ways <= WAYS, size = "a decision of " .. ways .. " ways, " .. #all .. " nodes"} end
  return {wrapper = small, size = "one expression of " .. #all .. " nodes"}
end

-- The function type of the annotation just above the declaration at `g`,
-- by its name, or 0 for none.
function anno_fn(g, name)
  local p = parent(g)
  if p == 0 then return 0 end
  local before = 0
  local prev = 0
  for k in children(p) do
    if k == g then before = prev end
    prev = k
  end
  if before == 0 or kind(before) ~= "s-type-anno" or get(NODE[before], "name", "") ~= name then return 0 end
  local ty = children(before)
  if #ty == 0 or kind(ty[1]) ~= "ty-fn" then return 0 end
  return ty[1]
end

-- **WHETHER THE DECLARATION AT `g` TAKES `{}` ALONE AND COULD BE A
-- CONSTANT**: its lambda's one pattern is an empty record, or its
-- annotation has an empty record as its one argument; and no type variable
-- (`ty-var`) is in the annotation's return type, which a constant cannot
-- hold. Unannotated, its type is not seen, so it counts.
function takes_unit(g, name)
  local unit = false
  local lam = children(g)[2]
  for k in children(lam) do
    if kind(k) == "args" then
      local ps = children(k)
      if #ps == 1 and kind(ps[1]) == "p-record" and #children(ps[1]) == 0 then unit = true end
    end
  end
  local fn = anno_fn(g, name)
  if fn == 0 then return unit end
  local parts = children(fn)
  if #parts == 2 and kind(parts[1]) == "ty-record" and #children(parts[1]) == 0 then unit = true end
  if not unit then return false end
  for k in subtree(parts[#parts]) do
    if kind(k) == "ty-var" then return false end
  end
  return true
end

-- ── pass 1: the functions ────────────────────────────────────────────────
-- By key `owner|name`, the owner a module type's name, or `@path` for a
-- top-level one.
local defs = {}
local members = {}
for g = 1, #NODE do
  if kind(g) == "s-decl" then
    local kids = children(g)
    if #kids > 1 and kind(kids[1]) == "p-ident" and kind(kids[2]) == "e-lambda" then
      local path = PATH[g]
      local owner = OWNER[g] ~= "" and OWNER[g] or ("@" .. path)
      if OUTER_ALL[g] then
        local n = NODE[g]
        local name = raw(kids[1])
        local key = owner .. "|" .. name
        local size = wrapper_size(kids[2])
        defs[key] = {key = key, path = path, owner = owner, name = name, line = n.line, last = n.end_line, wrapper = size.wrapper, size = size.size, doc = doc_lines(SRC[path], name, n.line), prod = 0, tests = 0, expects = 0, callers = {}, calls = {}, self_calls = {}, values = 0, ambiguous = false, recursive = false, entry = false, unit = takes_unit(g, name)}
        if sub(owner, 1, 1) ~= "@" then
          if not has_key(members, name) then members[name] = {} end
          push(members[name], key)
        end
      end
    end
  end
end

-- ── pass 2: the references ───────────────────────────────────────────────
-- A call is `{path, line, args, pre}`: `args` the argument nodes, `pre` an
-- arrow or method call's receiver, the hidden first argument (0 for none). A
-- reference with no call is the function passed as a value. A reference
-- inside its own body makes it a recursion.
function note(def, ctx, call)
  if ctx.path == def.path and ctx.line >= def.line and ctx.line <= def.last then
    def.recursive = true
    if call ~= nil then push(def.self_calls, call) end
    return nil
  end
  if is_test_file(ctx.path) then
    def.tests = def.tests + 1
  elseif ctx.expect then
    def.expects = def.expects + 1
  else
    def.prod = def.prod + 1
    push(def.callers, ctx.path .. ":" .. ctx.line .. " in " .. ctx.caller)
    if call == nil then def.values = def.values + 1 else push(def.calls, call) end
  end
  return nil
end

for g = 1, #NODE do
  local k0 = kind(g)
  if k0 == "e-ident" or k0 == "e-method-call" then
    local path = PATH[g]
    local owner = OWNER[g]
    local ctx = {path = path, line = NODE[g].line, expect = IN_EXPECT[g], caller = CALLER[g]}
    local call = nil
    local target = ""
    local method = false
    if k0 == "e-ident" then
      target = raw(g)
      -- The head of an apply: its siblings are the arguments.
      local p = parent(g)
      if p ~= 0 and kind(p) == "e-apply" then
        local kids = children(p)
        if kids[1] == g then
          call = {path = path, line = ctx.line, args = drop(kids, 1), pre = 0}
          -- `x->f(a)`: the apply is the arrow call's second child.
          local gp = parent(p)
          if gp ~= 0 and kind(gp) == "e-arrow-call" then
            local gk = children(gp)
            if gk[2] == p then call.pre = gk[1] end
          end
        end
      end
    else
      target = sub(get(NODE[g], "method", ""), 2)
      method = true
      local args = {}
      local pre = 0
      for k in children(g) do
        if kind(k) == "receiver" then pre = children(k)[1] end
        if starts_with(kind(k), "args") then args = children(k) end
      end
      call = {path = path, line = ctx.line, args = args, pre = pre}
    end
    if target ~= "" then
      if method then
        local ks = get(members, target, {})
        for key in ks do
          note(defs[key], ctx, call)
          if #ks > 1 then defs[key].ambiguous = true end
        end
      elseif contains(target, ".") then
        local parts = split(target, ".")
        local key = parts[#parts - 1] .. "|" .. parts[#parts]
        if has_key(defs, key) then note(defs[key], ctx, call) end
      else
        local key = ""
        if owner ~= "" and has_key(defs, owner .. "|" .. target) then key = owner .. "|" .. target
        elseif has_key(defs, "@" .. path .. "|" .. target) then key = "@" .. path .. "|" .. target
        else
          for m in get(members, target, {}) do
            if defs[m].path == path then key = m end
          end
        end
        if key ~= "" then note(defs[key], ctx, call) end
      end
    end
  end
end

-- **AN ENTRY INTO A RECURSION**: a function holding a production call of a
-- recursive one.
local by_path = {}
for key in keys(defs) do push_at(by_path, defs[key].path, defs[key]) end
for key in keys(defs) do
  local worker = defs[key]
  if worker.recursive then
    for c in worker.calls do
      for d in get(by_path, c.path, {}) do
        if c.line >= d.line and c.line <= d.last then d.entry = true end
      end
    end
  end
end

-- ── the checks ───────────────────────────────────────────────────────────

function shown_name(def)
  if sub(def.owner, 1, 1) == "@" then return def.name end
  return def.owner .. "." .. def.name
end

-- A call's arguments by position, `pre` first: a record argument's fields
-- as `N.field`, so `{ needle, at: 0 }` is judged field by field.
function arg_texts(call)
  local out = {}
  local list = {}
  if call.pre ~= 0 then push(list, call.pre) end
  for a in call.args do push(list, a) end
  local n = 0
  for a in list do
    n = n + 1
    if kind(a) == "e-record" then
      for f in children(a) do
        local fname = kind(f) == "field" and get(NODE[f], "field", "") or ""
        if fname ~= "" then
          local v = children(f)
          out[n .. "." .. fname] = #v > 0 and text_of(call.path, v[1]) or fname
        end
      end
    else
      out[tostring(n)] = text_of(call.path, a)
    end
  end
  return out
end

-- No argument's text: the marker of a slot whose calls differ.
const DIFFERS = "\n differs"

-- **EACH SLOT'S ONE TEXT ACROSS `calls`**, by `arg_texts`'s keys: the text
-- every call gives it, or `DIFFERS`. `fixed` and `entry` both ask it.
function same_slots(calls)
  local seen = {}
  local first = true
  for c in calls do
    local a = arg_texts(c)
    if first then
      for k in keys(a) do seen[k] = a[k] end
      first = false
    else
      for k in keys(seen) do
        if seen[k] ~= DIFFERS and (not has_key(a, k) or a[k] ~= seen[k]) then seen[k] = DIFFERS end
      end
      for k in keys(a) do
        if not has_key(seen, k) then seen[k] = DIFFERS end
      end
    end
  end
  return seen
end

for key in sort(keys(defs)) do
  local def = defs[key]
  local judged = not def.ambiguous and not is_test_file(def.path)
  if judged and def.prod == 1 and def.values == 0 and def.expects == 0 and def.tests == 0 and def.doc == 0 and def.wrapper and not def.recursive and not def.entry and not is_question(def.name) then
    say(def.path, def.line, "single", "`" .. shown_name(def) .. "` (" .. def.size .. ") has one caller in the " .. #fs .. " files read, " .. def.callers[1] .. ", and no expect, test or doc: read it inline there, or say why it stands alone")
  end
  if judged and #def.calls >= 2 and def.values == 0 then
    -- The outside calls alone, then with its own: a slot the outside calls
    -- agree on is `fixed` when its own calls agree too, else `entry`.
    local outside = same_slots(def.calls)
    local every = {}
    for c in def.calls do push(every, c) end
    for c in def.self_calls do push(every, c) end
    local all = same_slots(every)
    local own = #def.self_calls > 0 and (" and " .. #def.self_calls .. " of its own") or ""
    for k in sort(keys(outside)) do
      local v = outside[k]
      if v ~= DIFFERS and is_literal(v) then
        local said = "`" .. shown_name(def) .. "`'s argument " .. k .. " is `" .. v .. "` in all " .. #def.calls .. " production calls"
        if all[k] ~= DIFFERS then
          say(def.path, def.line, "fixed", said .. own .. " in the " .. #fs .. " files read: no parameter, or an entry function that takes only what varies")
        else
          say(def.path, def.line, "entry", said .. " in the " .. #fs .. " files read, and its own calls vary it: an entry function that takes only what varies and passes `" .. v .. "` itself, its one outside call")
        end
      end
    end
  end
  if def.unit and not contains(def.name, "!") and not is_test_file(def.path) then
    say(def.path, def.line, "constant", "`" .. shown_name(def) .. "` takes `{}` alone and names no effect, so it gives the same value every call: a constant (`" .. def.name .. " = ...`), or a `!` if it has an effect")
  end
end

local total = 0
for k in keys(defs) do total = total + 1 end
local counts = {}
for c in CHECKS do push(counts, c .. " " .. found[c]) end
print("boundaries (Roc): " .. #fs .. " files, " .. total .. " functions; " .. join(counts, ", "))

if SELF then
  local wrong = {}
  for c in CHECKS do
    local planted = 0
    for p in fs do
      local base = sub(p, #PLANTS + 1)
      local mine = base == c .. ".roc" or starts_with(base, c .. "_")
      if mine then planted = planted + 1 end
      local fired = has_key(per_file, p .. "|" .. c)
      if mine and not fired then push(wrong, "`" .. c .. "` does not fire on its plant " .. p) end
      if fired and not mine then push(wrong, "`" .. c .. "` fires on " .. p .. ", another check's plant") end
    end
    if planted == 0 then push(wrong, "`" .. c .. "` has no plant") end
  end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("boundaries self_test: " .. #wrong .. " plants wrong") end
  print("boundaries (Roc) self_test: PASS (each check fires on its plants alone, the quiet_ plants on none)")
end
