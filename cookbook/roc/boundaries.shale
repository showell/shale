-- This recipe asks of every function in a tree of .roc files whether its
-- boundary earns its keep, and whether each of its parameters is really a
-- parameter. It reads each file's syntax tree from Roc's own parser
-- (cookbook/roc/parsed.shale), and it checks the functions defined at the
-- top level of a file or as members of a module type, not those inside
-- another function. A finding is a question for a reader, not a verdict.
--
--   cd <repo> && shale <shale>/cookbook/roc/boundaries.shale glob=chat/**/*.roc
--   shale cookbook:roc/boundaries.shale self_test=1
--
-- The arguments:
--   glob   the files to read, `**/*.roc` by default. Read the whole tree,
--          tests too, because a test that reaches a function keeps it
--          quiet, and calls are counted only in the files read;
--   ways   the most ways through a body that `single` still calls a
--          wrapper, 2 by default;
--   nodes  the most syntax-tree nodes in such a body, 24 by default;
--   types  with `types=1`, Roc's checker gives the types
--          (cookbook/roc/types.shale), which `bool_param` needs. It is off
--          by default, and needs the tree's `roc-version` file;
--   root   with `types=1`, the app that imports the files read, or several
--          apps separated by commas (`root=a.roc,b.roc`).
--
-- The checks, each from the Roc style guide (roc-apps docs/roc-style.md):
--
--   single      A small function with exactly one production call, and no
--               `expect`, test file or `##` doc comment that reaches or
--               explains it, would read better inline at that call ("A
--               function earns its boundary"; the guide calls it a rule of
--               thumb). Its body must be one statement of at most `nodes`
--               nodes and `ways` ways through: an `if` adds a way, and a
--               `match` adds one for each arm past its first. A function
--               passed as a value (`map_ok(Uid.to_str)`), a question named
--               `is_*` or `has_*`, a recursive function and an entry into
--               one (see `entry`) are quiet.
--   fixed       Every production call, two or more, passes the same
--               literal for one parameter, or for one field of a record
--               argument. A literal is a number, a string, a character, a
--               tag (`Begin`, `Bool.True`) or a module's constant
--               (`Limits.max`). "A parameter every caller passes the same
--               value is no parameter": drop it, or add an entry function
--               that takes only what varies. A recursive function's calls
--               to itself must pass the same literal too. The same variable
--               or call at every call site (`me`, `req.me`,
--               `Host.list_srcs!({})`) is the caller's own value handed on,
--               and is not a literal. A library's API keeps its parameters
--               whatever this tree's callers pass, so `fixed` skips a
--               module type's member in a file under a `lib/` folder, or in
--               a module exposed by a `package` or `platform` header in the
--               `main.roc` beside it. A file's own top-level functions there
--               are checked.
--   entry       Every production call, two or more, passes the same literal
--               for a parameter that the recursive function's own calls
--               vary (`at: 0` outside, `at + 1` inside). The recursion
--               needs the parameter, so the fix is an entry function that
--               takes only what varies and passes the literal itself
--               (`count = |xs| count_from(xs, 0)`). That entry function
--               makes the one outside call, so it does not fire again.
--   constant    A function whose one argument is `{}`, by its annotation or
--               its lambda's pattern, and whose name has no `!`, gives the
--               same value at every call, so it can be a constant
--               (`board = ...`, not `board = |{}| ...`). A function with an
--               effect needs a `!` in its name. Roc refuses a generic
--               constant, so a function whose annotated return type holds a
--               type variable (`{} -> Viewer(id)`) is quiet. An unannotated
--               function's type is unknown, so it is checked.
--   dead        A top-level or member function that nothing reaches in the
--               files read: no production call, no `expect`, no test file, and
--               no reference to it as a value, a record's shorthand
--               (`{ helper }`) included. Its calls to itself don't count. A
--               top-level function is private to its file, even in a package,
--               and a member of a module no package exposes has no caller to
--               come. Left alone are the names something else calls: what an
--               app's header provides, what a platform requires and provides,
--               and a method Roc calls by name (`is_eq`, `to_hash`).
--   unused_api  The same, for a member of a module its package or platform
--               exposes, a member under a `lib/` folder, or a name a `module`
--               header exposes. The callers of a public name are mostly
--               outside the tree, so this is a question and not a verdict, and
--               it has its own count. A member only an `expect` reaches is in
--               neither.
--   same_branches  An `if` whose two branches are the same text, braces aside
--               (`if m.over { m } else m`). The condition decides nothing, so
--               a rule was lost, or the `if` should go.
--   bool_param  With `types=1` only: a parameter whose type is `Bool` is
--               passed `Bool.True`, `Bool.False`, `True` or `False` by some
--               call. "A flag a caller passes is a tag", named for what it
--               means (`Loud`, not `Bool.True`). Every call counts, from an
--               `expect`, a test file or the function itself too. A
--               function with one parameter is quiet, as that parameter is
--               the value it converts (`bool : Bool -> JsonOut`), and so is
--               a field of a record argument.
--
-- A reference to a function is its bare name in the file that defines it,
-- `Type.name` anywhere, the type read through the file's `import ... as`, or
-- a method call `.name(...)`. The receiver of a method call or of an arrow call (`x->f(a)`) is its first argument. A
-- method call counts for every module type with a member of that name, so
-- a member whose name another type's member shares is ambiguous, and only
-- `constant` checks it. A test file is a file whose name ends in
-- `twin.roc`, a file under a `twin/` or `test/` folder, or a spec app,
-- named for its module followed by `Spec.roc` (`BlitSpec.roc`). Its
-- references count as an `expect`'s do, never as production calls, and
-- its own functions are not checked.
--
-- Each finding is one line, `path:line: <check>: <why>`, where the line is
-- the function's definition, and the findings are followed by a summary
-- line of the counts. Files that don't parse are listed after the summary,
-- with the files no root reaches under `types=1`, and then the run fails.
--
-- `self_test=1` checks the plants in `cookbook/roc/plants/boundaries/`.
-- Each plant is named for the check it holds (`fixed_string.roc` holds
-- `fixed`), and each check must fire on its own plants and on no others; a
-- `quiet_*.roc` plant must give no finding. `dead` and `unused_api` are judged
-- only under `dead/`, since nothing calls the other plants. The plants under `typed/` are
-- type modules checked with the types under the app `QuietApp.roc`, and
-- their names are read in snake case (`BoolParam.roc` as `bool_param`).
-- The rest are checked without types. The self-test fails if roc-types is
-- not installed.
-- budget: steps=800000000 arena_bytes=3000000000

const SELF_TEST = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/boundaries/"
const TYPED_PLANTS = PLANTS .. "typed/"
const GLOB = SELF_TEST and (PLANTS .. "**/*.roc") or arg("glob", "**/*.roc")
const MAX_WAYS = arg("ways", 2)
const MAX_NODES = arg("nodes", 24)
const DEAD_PLANTS = PLANTS .. "dead/"
const CHECKS = {"single", "fixed", "entry", "constant", "bool_param", "dead", "unused_api", "same_branches"}
use("cookbook:roc/headers.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/pinned.shale")
use("cookbook:roc/types.shale")
const TYPES_ARG = arg("types", "0")
if TYPES_ARG ~= "0" and TYPES_ARG ~= "1" then fail("boundaries: types must be 0 (the default) or 1, not " .. TYPES_ARG) end
const USE_TYPES = SELF_TEST or TYPES_ARG == "1"
const ROOT = SELF_TEST and (TYPED_PLANTS .. "QuietApp.roc") or arg("root", "")
-- The pinned Roc defines `Bool := [False, True]`.
const BOOL_LITERALS = {["Bool.True"] = true, ["Bool.False"] = true, True = true, False = true}

-- Every file's syntax-tree nodes in one list, so that one index names a
-- node anywhere. `NODE_PATH[g]` is node g's file. A node's `parent` and
-- `kids` count from its own file's first node, so `NODE_OFFSET[g]` is
-- added to them.
const NODES = {}
const NODE_PATH = {}
const NODE_OFFSET = {}
const SOURCE_LINES = {}
-- Each file's `header_names`, and the module each of its import aliases
-- stands for, by `path|alias`.
const HEADER_NAMES = {}
const IMPORT_ALIASES = {}
-- The kinds of node that can hold a top-level function: a file, its
-- statements, a module type's declaration, and the block of its members.
const TOP_LEVEL_KINDS = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

const finding_counts = {}
for c in CHECKS do finding_counts[c] = 0 end
-- The self-test's record of which checks fired on which files, by `path|check`.
const fired = {}

function report(path, line, check, why)
  -- The other plants exist to be read by the other checks, and nothing calls them.
  if SELF_TEST and (check == "dead" or check == "unused_api") and not starts_with(path, DEAD_PLANTS) then return nil end
  print(path .. ":" .. line .. ": " .. check .. ": " .. why)
  finding_counts[check] = finding_counts[check] + 1
  fired[path .. "|" .. check] = true
  return nil
end

function children(g)
  local out = {}
  for k in NODES[g].kids do push(out, NODE_OFFSET[g] + k) end
  return out
end

function parent(g)
  local p = NODES[g].parent
  if p == 0 then return 0 end
  return NODE_OFFSET[g] + p
end

function kind(g)
  return NODES[g].kind
end

function raw_text(g)
  return get(NODES[g], "raw", "")
end

-- Node g's source text, squeezed onto one line. A node's end column is one
-- past its last character.
function source_text(path, g)
  local n = NODES[g]
  if n.line == 0 then return "?" end
  local src = SOURCE_LINES[path]
  if n.line == n.end_line then return sub(src[n.line], n.col, n.end_col - 1) end
  local parts = {trim(sub(src[n.line], n.col))}
  for l = n.line + 1, n.end_line - 1 do push(parts, trim(src[l])) end
  push(parts, trim(sub(src[n.end_line], 1, n.end_col - 1)))
  return join(parts, " ")
end

function is_literal(s)
  local c = sub(s, 1, 1)
  if c == "\"" or c == "'" then return true end
  if re_find(s, "^-?[0-9]") ~= nil then return true end
  if re_find(s, "^[A-Z][A-Za-z0-9]*(\\.[a-z_][a-z0-9_]*)?$") ~= nil then return true end
  return false
end

function is_question_name(name)
  return starts_with(name, "is_") or starts_with(name, "has_")
end

function is_test_file(path)
  if re_find(basename(path), "[A-Z][A-Za-z0-9]*Spec\\.roc$") ~= nil then return true end
  return ends_with(path, "twin.roc") or contains(path, "/twin/") or contains(path, "/test/") or starts_with(path, "test/") or starts_with(path, "twin/")
end

-- Whether a function is part of a library's API: a module type's member in a
-- file under a `lib/` folder, or in a module its package or platform exposes,
-- or a name its own `module` header exposes.
function is_library_api(func)
  if has_key(HEADER_NAMES[func.path].exposed, func.name) then return true end
  if sub(func.owner, 1, 1) == "@" then return false end
  local p = func.path
  if starts_with(p, "lib/") or contains(p, "/lib/") or contains(p, ":lib/") then return true end
  return is_exposed_module(p)
end

-- The name in the header of the module type declared at `g`.
function type_decl_name(g)
  local kids = children(g)
  if #kids == 0 then return "" end
  return get(NODES[kids[1]], "name", "")
end

-- ── the syntax trees ─────────────────────────────────────────────────────

const ROC_FILES = glob(GLOB)
local untyped_plants = {}
if SELF_TEST then
  for p in ROC_FILES do
    if not starts_with(p, TYPED_PLANTS) then untyped_plants[p] = true end
  end
end
local checker_types = USE_TYPES and roc_types_for_files("boundaries", ROOT, roc_bin("boundaries", SELF_TEST), ROC_FILES, untyped_plants) or {real = {}, pats = {}, exprs = {}, unreached = {}}
local parsed = parse_roc_files(ROC_FILES)
for f in parsed.files do
  SOURCE_LINES[f.path] = split(read(f.path), "\n")
  HEADER_NAMES[f.path] = header_names(f.nodes)
  local offset = #NODES
  for n in f.nodes do
    push(NODES, n)
    push(NODE_PATH, f.path)
    push(NODE_OFFSET, offset)
  end
end

-- What each node's ancestors say, worked out from its parent's, which
-- comes before it in the list:
--   AT_TOP_LEVEL[g]    every ancestor is of a kind in `TOP_LEVEL_KINDS`;
--   OWNER_TYPE[g]      the name of the nearest module type around it, or "";
--   ENCLOSING_DECL[g]  the name of the outermost declaration around it, or "?";
--   IN_EXPECT[g]       it is inside an `expect`.
const AT_TOP_LEVEL = {}
const OWNER_TYPE = {}
const ENCLOSING_DECL = {}
const IN_EXPECT = {}
for g = 1, #NODES do
  local p = parent(g)
  if p == 0 then
    push(AT_TOP_LEVEL, true)
    push(OWNER_TYPE, "")
    push(ENCLOSING_DECL, "?")
    push(IN_EXPECT, false)
  else
    local parent_kind = kind(p)
    push(AT_TOP_LEVEL, AT_TOP_LEVEL[p] and has_key(TOP_LEVEL_KINDS, parent_kind))
    push(OWNER_TYPE, parent_kind == "s-type-decl" and type_decl_name(p) or OWNER_TYPE[p])
    local enclosing = ENCLOSING_DECL[p]
    if enclosing == "?" and parent_kind == "s-decl" then
      local pattern = children(p)
      if #pattern > 0 and kind(pattern[1]) == "p-ident" then enclosing = raw_text(pattern[1]) end
    end
    push(ENCLOSING_DECL, enclosing)
    push(IN_EXPECT, IN_EXPECT[p] or parent_kind == "s-expect")
  end
end

-- How many `##` lines stand just above the function defined at `line`,
-- or above its annotation (`name : ...`, on one line or several) if it
-- has one.
function doc_comment_lines(src, name, line)
  local top = line - 1
  local k = top
  while k >= 1 and k > line - 12 and trim(src[k]) ~= "" and not starts_with(trim(src[k]), "#") do
    if starts_with(trim(src[k]), name .. " :") then top = k - 1 end
    k = k - 1
  end
  local n = 0
  while top >= 1 and starts_with(trim(src[top]), "##") do
    n = n + 1
    top = top - 1
  end
  return n
end

-- The nodes of the subtree at `g`, `g` first.
function subtree_nodes(g)
  local out = {g}
  local i = 1
  while i <= #out do
    for k in children(out[i]) do push(out, k) end
    i = i + 1
  end
  return out
end

-- Whether the body of the lambda at `g` is small enough for `single` to
-- call it a wrapper, as `is_wrapper`, and its size in words for the
-- finding, as `size`. A wrapper's body is one statement: a block of one,
-- or an expression. Its size counts syntax-tree nodes, so the layout of
-- its lines changes nothing. It has one way through it, and one more for
-- each `if` and for each `match` arm past the first. So only a two-way
-- choice reads as a wrapper, and an `else if` chain or a nested `if` is a
-- rule of its own however few lines it takes.
function body_measure(g)
  local kids = children(g)
  local body = kids[#kids]
  if kind(body) == "e-block" then
    local statements = {}
    for k in children(body) do
      if kind(k) == "statements" then statements = children(k) end
    end
    if #statements ~= 1 then return {is_wrapper = false, size = #statements .. " statements"} end
    body = statements[1]
  end
  local all = subtree_nodes(body)
  local ways = 1
  for k in all do
    if kind(k) == "e-if-then-else" then ways = ways + 1 end
    if kind(k) == "branches" then ways = ways + #children(k) - 1 end
  end
  local small = #all <= MAX_NODES
  if ways > 1 then return {is_wrapper = small and ways <= MAX_WAYS, size = "a decision of " .. ways .. " ways, " .. #all .. " nodes"} end
  return {is_wrapper = small, size = "one expression of " .. #all .. " nodes"}
end

-- The function type in the annotation just before the declaration at `g`,
-- if that annotation is for `name`, or 0.
function annotation_function_type(g, name)
  local p = parent(g)
  if p == 0 then return 0 end
  local before = 0
  local prev = 0
  for k in children(p) do
    if k == g then before = prev end
    prev = k
  end
  if before == 0 or kind(before) ~= "s-type-anno" or get(NODES[before], "name", "") ~= name then return 0 end
  local ty = children(before)
  if #ty == 0 or kind(ty[1]) ~= "ty-fn" then return 0 end
  return ty[1]
end

-- Whether the function declared at `g` takes `{}` alone, by its lambda's
-- one pattern or its annotation's one argument, and could be a constant:
-- an annotated return type holding a type variable (`ty-var`) rules that
-- out.
function takes_empty_record_alone(g, name)
  local takes_it = false
  local lambda = children(g)[2]
  for k in children(lambda) do
    if kind(k) == "args" then
      local patterns = children(k)
      if #patterns == 1 and kind(patterns[1]) == "p-record" and #children(patterns[1]) == 0 then takes_it = true end
    end
  end
  local fn_type = annotation_function_type(g, name)
  if fn_type == 0 then return takes_it end
  local parts = children(fn_type)
  if #parts == 2 and kind(parts[1]) == "ty-record" and #children(parts[1]) == 0 then takes_it = true end
  if not takes_it then return false end
  for k in subtree_nodes(parts[#parts]) do
    if kind(k) == "ty-var" then return false end
  end
  return true
end

-- The parameter patterns of the lambda at `g`, by position.
function lambda_params(g)
  for k in children(g) do
    if kind(k) == "args" then return children(k) end
  end
  return {}
end

-- ── pass 1: the functions ────────────────────────────────────────────────

-- Each function by `owner|name`, where the owner is its module type's name,
-- or `@path` for a file's own top-level function.
const FUNCTIONS = {}
-- The keys of the module types' members, by name.
const MEMBER_KEYS = {}
for g = 1, #NODES do
  if kind(g) == "s-decl" then
    local kids = children(g)
    if #kids > 1 and kind(kids[1]) == "p-ident" and kind(kids[2]) == "e-lambda" and AT_TOP_LEVEL[g] then
      local path = NODE_PATH[g]
      local owner = OWNER_TYPE[g] ~= "" and OWNER_TYPE[g] or ("@" .. path)
      local n = NODES[g]
      local name = raw_text(kids[1])
      local key = owner .. "|" .. name
      local body = body_measure(kids[2])
      FUNCTIONS[key] = {
        key = key, path = path, owner = owner, name = name, line = n.line, end_line = n.end_line,
        is_wrapper = body.is_wrapper, size = body.size, doc_lines = doc_comment_lines(SOURCE_LINES[path], name, n.line),
        takes_empty_record_alone = takes_empty_record_alone(g, name), params = lambda_params(kids[2]),
        prod_refs = 0, value_refs = 0, expect_refs = 0, test_refs = 0, prod_callers = {},
        prod_calls = {}, self_calls = {}, test_calls = {}, mentions = 0,
        is_ambiguous = false, is_recursive = false, is_entry = false,
      }
      if sub(owner, 1, 1) ~= "@" then
        if not has_key(MEMBER_KEYS, name) then MEMBER_KEYS[name] = {} end
        push(MEMBER_KEYS[name], key)
      end
    end
  end
end

-- ── pass 2: the references ───────────────────────────────────────────────

-- A call is `{path, line, args, receiver}`, where `args` are the argument
-- nodes and `receiver` is an arrow or method call's receiver, which is
-- the first argument, or 0 for none.

-- The call whose head is the identifier at `g`, or nil if it heads none.
function call_headed_by(g)
  local apply = parent(g)
  if apply == 0 or kind(apply) ~= "e-apply" then return nil end
  local kids = children(apply)
  if kids[1] ~= g then return nil end
  local call = {path = NODE_PATH[g], line = NODES[g].line, args = drop(kids, 1), receiver = 0}
  -- In `x->f(a)`, the apply `f(a)` is the arrow call's second child.
  local arrow = parent(apply)
  if arrow ~= 0 and kind(arrow) == "e-arrow-call" then
    local arrow_kids = children(arrow)
    if arrow_kids[2] == apply then call.receiver = arrow_kids[1] end
  end
  return call
end

function method_call(g)
  local args = {}
  local receiver = 0
  for k in children(g) do
    if kind(k) == "receiver" then receiver = children(k)[1] end
    if starts_with(kind(k), "args") then args = children(k) end
  end
  return {path = NODE_PATH[g], line = NODES[g].line, args = args, receiver = receiver}
end

-- The key of the function that the name at `g` refers to, or "".
function referenced_key(g, name)
  local path = NODE_PATH[g]
  if contains(name, ".") then
    local parts = split(name, ".")
    local owner = parts[#parts - 1]
    local key = get(IMPORT_ALIASES, path .. "|" .. owner, owner) .. "|" .. parts[#parts]
    return has_key(FUNCTIONS, key) and key or ""
  end
  local owner = OWNER_TYPE[g]
  if owner ~= "" and has_key(FUNCTIONS, owner .. "|" .. name) then return owner .. "|" .. name end
  if has_key(FUNCTIONS, "@" .. path .. "|" .. name) then return "@" .. path .. "|" .. name end
  local key = ""
  for m in get(MEMBER_KEYS, name, {}) do
    if FUNCTIONS[m].path == path then key = m end
  end
  return key
end

-- A reference within the function's own lines makes it recursive. Any
-- other is from a test file, from an `expect`, or from production, and
-- `call` is nil when the function is passed as a value.
function record_reference(func, ref, call)
  if ref.path == func.path and ref.line >= func.line and ref.line <= func.end_line then
    func.is_recursive = true
    if call ~= nil then push(func.self_calls, call) end
    return nil
  end
  local from_test_file = is_test_file(ref.path)
  if (from_test_file or ref.in_expect) and call ~= nil then push(func.test_calls, call) end
  if from_test_file then
    func.test_refs = func.test_refs + 1
  elseif ref.in_expect then
    func.expect_refs = func.expect_refs + 1
  else
    func.prod_refs = func.prod_refs + 1
    push(func.prod_callers, ref.path .. ":" .. ref.line .. " in " .. ref.enclosing)
    if call == nil then func.value_refs = func.value_refs + 1 else push(func.prod_calls, call) end
  end
  return nil
end

function reference_at(g)
  return {path = NODE_PATH[g], line = NODES[g].line, in_expect = IN_EXPECT[g], enclosing = ENCLOSING_DECL[g]}
end

-- A name that may reach a member by a way this recipe can't follow: an alias
-- of a type, or a name an import exposes. It keeps every member of that name
-- out of `dead`, and counts as no call for the other checks.
function note_mention(name)
  for key in get(MEMBER_KEYS, name, {}) do FUNCTIONS[key].mentions = FUNCTIONS[key].mentions + 1 end
  return nil
end

function last_dotted_part(name)
  local parts = split(name, ".")
  return parts[#parts]
end

for g = 1, #NODES do
  if kind(g) == "s-import" and has_key(NODES[g], "alias") then
    IMPORT_ALIASES[NODE_PATH[g] .. "|" .. NODES[g].alias] = last_dotted_part(raw_text(g))
  end
end

for g = 1, #NODES do
  local node_kind = kind(g)
  if node_kind == "e-method-call" then
    local name = sub(get(NODES[g], "method", ""), 2)
    if name ~= "" then
      local call = method_call(g)
      local keys_of_name = get(MEMBER_KEYS, name, {})
      for key in keys_of_name do
        record_reference(FUNCTIONS[key], reference_at(g), call)
        if #keys_of_name > 1 then FUNCTIONS[key].is_ambiguous = true end
      end
    end
  elseif node_kind == "e-ident" then
    local name = raw_text(g)
    local key = name ~= "" and referenced_key(g, name) or ""
    if key ~= "" then record_reference(FUNCTIONS[key], reference_at(g), call_headed_by(g)) end
    if key == "" and contains(name, ".") then note_mention(last_dotted_part(name)) end
  elseif node_kind == "field" and #children(g) == 0 and kind(parent(g)) == "e-record" then
    -- `{ helper }` names `helper` with no identifier node. The field has no
    -- span, so its record says where it is.
    local key = referenced_key(g, get(NODES[g], "field", ""))
    if key ~= "" then record_reference(FUNCTIONS[key], reference_at(parent(g)), nil) end
  elseif node_kind == "text" and has_key(NODES[g], "value") and kind(parent(g)) == "exposed-lower-ident" then
    note_mention(NODES[g].value)
  end
end

-- A function holding a production call of a recursive function is an
-- entry into the recursion.
local functions_by_path = {}
for key in keys(FUNCTIONS) do push_at(functions_by_path, FUNCTIONS[key].path, FUNCTIONS[key]) end
for key in keys(FUNCTIONS) do
  local recursive = FUNCTIONS[key]
  if recursive.is_recursive then
    for c in recursive.prod_calls do
      for f in get(functions_by_path, c.path, {}) do
        if c.line >= f.line and c.line <= f.end_line then f.is_entry = true end
      end
    end
  end
end

-- ── the checks ───────────────────────────────────────────────────────────

function display_name(func)
  if sub(func.owner, 1, 1) == "@" then return func.name end
  return func.owner .. "." .. func.name
end

-- A call's argument texts by position ("1", "2", ...), the receiver first.
-- A record argument gives its fields instead, as "N.field", so that
-- `{ needle, at: 0 }` is judged field by field.
function argument_texts(call)
  local out = {}
  local list = {}
  if call.receiver ~= 0 then push(list, call.receiver) end
  for a in call.args do push(list, a) end
  local n = 0
  for a in list do
    n = n + 1
    if kind(a) == "e-record" then
      for f in children(a) do
        local field_name = kind(f) == "field" and get(NODES[f], "field", "") or ""
        if field_name ~= "" then
          local value = children(f)
          out[n .. "." .. field_name] = #value > 0 and source_text(call.path, value[1]) or field_name
        end
      end
    else
      out[tostring(n)] = source_text(call.path, a)
    end
  end
  return out
end

-- No argument's text can be this, so it marks a slot where calls differ.
const DIFFERS = "\n differs"

-- For each argument slot of `calls`, by `argument_texts`'s keys, the text
-- every call gives it, or `DIFFERS`.
function agreed_argument_texts(calls)
  local agreed = {}
  local first = true
  for c in calls do
    local texts = argument_texts(c)
    if first then
      for k in keys(texts) do agreed[k] = texts[k] end
      first = false
    else
      for k in keys(agreed) do
        if agreed[k] ~= DIFFERS and (not has_key(texts, k) or texts[k] ~= agreed[k]) then agreed[k] = DIFFERS end
      end
      for k in keys(texts) do
        if not has_key(agreed, k) then agreed[k] = DIFFERS end
      end
    end
  end
  return agreed
end

function concatenated(lists)
  local out = {}
  for l in lists do
    for x in l do push(out, x) end
  end
  return out
end

function reads_better_inline(func)
  return func.prod_refs == 1 and func.value_refs == 0 and func.expect_refs == 0 and func.test_refs == 0 and func.doc_lines == 0 and func.is_wrapper and not func.is_recursive and not func.is_entry and not is_question_name(func.name)
end

const FILES_READ = " in the " .. #ROC_FILES .. " files read"

-- A function something outside the files calls: what its header dictates, or
-- a member Roc calls by name.
function is_called_from_outside(func)
  if sub(func.owner, 1, 1) == "@" then return has_key(HEADER_NAMES[func.path].dictated, func.name) end
  return has_key(LANGUAGE_FIXED_NAMES, func.name)
end

function has_no_caller(func)
  return func.prod_refs == 0 and func.expect_refs == 0 and func.test_refs == 0 and func.mentions == 0
end

-- The text of one branch of an `if`, its braces left out when it holds one
-- statement.
function branch_text(path, g)
  if kind(g) == "e-block" then
    for k in children(g) do
      if kind(k) == "statements" and #children(k) == 1 then return source_text(path, children(k)[1]) end
    end
  end
  return source_text(path, g)
end

for key in sort(keys(FUNCTIONS)) do
  local func = FUNCTIONS[key]
  local name = display_name(func)
  local judged = not func.is_ambiguous and not is_test_file(func.path)
  if not is_test_file(func.path) and has_no_caller(func) and not is_called_from_outside(func) then
    if is_library_api(func) then
      report(func.path, func.line, "unused_api", "`" .. name .. "` is exposed, and nothing" .. FILES_READ .. " calls or tests it: API with no user here, or left behind?")
    else
      report(func.path, func.line, "dead", "`" .. name .. "` has no caller" .. FILES_READ .. ", and no expect or test reaches it: delete it, or say who calls it")
    end
  end
  if judged and reads_better_inline(func) then
    report(func.path, func.line, "single", "`" .. name .. "` (" .. func.size .. ") has one caller" .. FILES_READ .. ", " .. func.prod_callers[1] .. ", and no expect, test or doc: read it inline there, or say why it stands alone")
  end
  if judged and #func.prod_calls >= 2 and func.value_refs == 0 then
    -- A slot the production calls agree on is `fixed` if the function's
    -- own calls agree with them too, and `entry` if they vary it.
    local outside = agreed_argument_texts(func.prod_calls)
    local all = agreed_argument_texts(concatenated({func.prod_calls, func.self_calls}))
    local own = #func.self_calls > 0 and (" and " .. #func.self_calls .. " of its own") or ""
    for k in sort(keys(outside)) do
      local v = outside[k]
      if v ~= DIFFERS and is_literal(v) then
        local said = "`" .. name .. "`'s argument " .. k .. " is `" .. v .. "` in all " .. #func.prod_calls .. " production calls"
        if all[k] ~= DIFFERS then
          if not is_library_api(func) then report(func.path, func.line, "fixed", said .. own .. FILES_READ .. ": no parameter, or an entry function that takes only what varies") end
        else
          report(func.path, func.line, "entry", said .. FILES_READ .. ", and its own calls vary it: an entry function that takes only what varies and passes `" .. v .. "` itself, its one outside call")
        end
      end
    end
  end
  if func.takes_empty_record_alone and not contains(func.name, "!") and not is_test_file(func.path) then
    report(func.path, func.line, "constant", "`" .. name .. "` takes `{}` alone and names no effect, so it gives the same value every call: a constant (`" .. func.name .. " = ...`), or a `!` if it has an effect")
  end
  if judged and #func.params > 1 and has_key(checker_types.real, func.path) then
    local every = concatenated({func.prod_calls, func.self_calls, func.test_calls})
    for i = 1, #func.params do
      local param = func.params[i]
      local ty = kind(param) == "p-ident" and roc_type_at(checker_types, "pat", func.path, NODES[param]) or nil
      if ty == "Bool" then
        local literal_calls = {}
        for c in every do
          local v = get(argument_texts(c), tostring(i), "")
          if has_key(BOOL_LITERALS, v) then push(literal_calls, c.path .. ":" .. c.line .. " `" .. v .. "`") end
        end
        if #literal_calls > 0 then report(func.path, func.line, "bool_param", "`" .. name .. "`'s parameter " .. i .. ", `" .. raw_text(param) .. "`, is a `Bool` (the checker's type) passed as a literal at " .. #literal_calls .. " of its " .. #every .. " calls (" .. join(take(literal_calls, 3), ", ") .. (#literal_calls > 3 and ", ..." or "") .. "): a flag a caller passes is a tag, named for what it means (roc-apps docs/roc-style.md)") end
      end
    end
  end
end

for g = 1, #NODES do
  if kind(g) == "e-if-then-else" and not is_test_file(NODE_PATH[g]) then
    local kids = children(g)
    local shown = #kids == 3 and branch_text(NODE_PATH[g], kids[2]) or "?"
    if shown ~= "?" and shown == branch_text(NODE_PATH[g], kids[3]) then
      report(NODE_PATH[g], NODES[g].line, "same_branches", "both branches of this `if` are `" .. sub(shown, 1, 40) .. "`: the condition decides nothing")
    end
  end
end

local counts = {}
for c in CHECKS do push(counts, c .. " " .. finding_counts[c]) end
print("boundaries (Roc): " .. #ROC_FILES .. " files, " .. #keys(FUNCTIONS) .. " functions; " .. join(counts, ", "))
fail_if_refused("boundaries", parsed.refused, checker_types.unreached)

-- A plant's file name as the self-test reads it. A typed plant is a type
-- module, so `typed/BoolParam.roc` reads as `bool_param.roc`, and so does a
-- plant under `dead/`, as a package's header names its modules.
function plant_check_name(p)
  if starts_with(p, TYPED_PLANTS) or starts_with(p, DEAD_PLANTS) then return snake_case_plant_name(basename(p)) end
  return basename(p)
end

if SELF_TEST then
  local wrong = {}
  for c in CHECKS do
    local planted = 0
    for p in ROC_FILES do
      local base = plant_check_name(p)
      local planted_here = base == c .. ".roc" or starts_with(base, c .. "_")
      if planted_here then planted = planted + 1 end
      local fired_here = has_key(fired, p .. "|" .. c)
      if planted_here and not fired_here then push(wrong, "`" .. c .. "` does not fire on its plant " .. p) end
      if fired_here and not planted_here then push(wrong, "`" .. c .. "` fires on " .. p .. ", another check's plant") end
    end
    if planted == 0 then push(wrong, "`" .. c .. "` has no plant") end
  end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("boundaries self_test: " .. #wrong .. " plants wrong") end
  print("boundaries (Roc) self_test: PASS (each check fires on its plants alone, the quiet_ plants on none)")
end
