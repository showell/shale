-- A library for rewrite_method_calls, loaded with
-- `use("./peer_calls.shale")`: which calls are peer calls. A method call
-- names a subject, so a symmetric function, one where no argument is the
-- subject, is called through its module: `U64.max(a, b)`, `Str.concat(a,
-- b)`, `List.map2(xs, ys, f)`. The symmetric functions are a list of names,
-- cookbook/roc/symmetric_functions.txt, and a call of one is a peer call
-- when its first two arguments' types have one head, as roc-types writes
-- them at the call with each alias read through to what it names (a `Hue :
-- U32` is a `U32`), so an app's `concat : Doc, Str -> Doc` is none. A
-- function off the list (`starts_with`, a unit's `plus`) keeps its method
-- call, whatever its arguments. A tree `t` here is the recipe's:
-- `t.nodes`, each `{kind, raw, name, method, span, has_span, kids, parent}`,
-- and `t.text`.

-- A type's name as roc-types writes it: `U64`, `List`, `Shelf.Book`.
const PEER_TYPE_NAME = "[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*"

-- The name roc-types gives the type declared at node `i`: the names of the
-- declarations around it and its own, joined by dots (`Peers.Hue` for a
-- `Hue` declared in `Peers`'s block).
function peer_declared_name(t, i)
  local names = {}
  local at = i
  while at > 0 do
    local n = t.nodes[at]
    if n.kind == "s-type-decl" then push(names, t.nodes[n.kids[1]].name) end
    at = n.parent
  end
  local out = {}
  local k = #names
  while k > 0 do
    push(out, names[k])
    k = k - 1
  end
  return join(out, ".")
end

-- Every alias the trees declare (`Hue : U32`, never `:=` or `::`), by the
-- name roc-types gives it, to the text of the type it names. An alias with
-- parameters (`Parcel(others) : ...`) is left out: reading it through
-- would need its arguments bound.
function peer_aliases(trees)
  local out = {}
  for p in sort(keys(trees)) do
    local t = trees[p]
    for i = 1, #t.nodes do
      local n = t.nodes[i]
      if n.kind == "s-type-decl" and #n.kids == 2 then
        local header = t.nodes[n.kids[1]]
        local target = t.nodes[n.kids[2]]
        local bare = header.kind == "header" and (#header.kids == 0 or #t.nodes[header.kids[1]].kids == 0)
        if bare and header.has_span and target.has_span and trim(sub(t.text, header.span.to, target.span.from - 1)) == ":" then
          out[peer_declared_name(t, i)] = sub(t.text, target.span.from, target.span.to - 1)
        end
      end
    end
  end
  return out
end

-- The type `ty` with every alias in it read through, its spaces made one.
function peer_resolved(ty, aliases, depth)
  local out = {}
  local at = 1
  local changed = false
  for m in re_find_all(ty, PEER_TYPE_NAME) do
    push(out, sub(ty, at, m.at - 1))
    if has_key(aliases, m.text) then
      push(out, aliases[m.text])
      changed = true
    else
      push(out, m.text)
    end
    at = m.at + #m.text
  end
  push(out, sub(ty, at))
  local s = re_replace(trim(join(out, "")), "\\s+", " ")
  if changed and depth < 8 then return peer_resolved(s, aliases, depth + 1) end
  return s
end

-- The module a value of the resolved type `ty` takes its methods from, the
-- type's head (`List` for `List(U8)`, `Shelf.Book`), or "" for a type that
-- has none to call through: a type variable, a record, a tuple, a tag
-- union or a function.
function peer_module_of(ty)
  local depth = 0
  for i = 1, #ty - 1 do
    local ch = sub(ty, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    local two = sub(ty, i, i + 1)
    if depth == 0 and (two == "->" or two == "=>") then return "" end
  end
  local m = re_find(ty, "^" .. PEER_TYPE_NAME)
  if m == nil then return "" end
  return m.text
end

-- Whether two arguments, of the types `a` and `b` as roc-types gives them
-- ("" where it gives none), are peers, values of one type: `{peers, type,
-- module}`, `peers` when both types, their aliases read through, have one
-- head to call through (`peer_module_of`: `List(U64)` and `List(Str)` are
-- peers to `map2`), `type` the first's resolved and `module` that head.
function peer_verdict(a, b, aliases)
  if a == "" or b == "" then return {peers = false, type = "", module = ""} end
  local ra = peer_resolved(a, aliases, 0)
  local m = peer_module_of(ra)
  return {peers = m ~= "" and m == peer_module_of(peer_resolved(b, aliases, 0)), type = ra, module = m}
end

-- The symmetric functions in `text`, cookbook/roc/symmetric_functions.txt:
-- a set of names, one a line, `#` lines its comments.
function peer_symmetric_table(text)
  local out = {}
  for l in lines(text) do
    local w = trim(l)
    if w ~= "" and not starts_with(w, "#") then
      if re_find(w, "^[a-z][a-z0-9_]*!?$") == nil then fail("peer_calls: symmetric_functions.txt: `" .. w .. "` is not a function's name") end
      out[w] = true
    end
  end
  return out
end

-- A type's text for a finding: a long one by its head alone (`List(...)`).
function peer_short_type(ty)
  if #ty <= 40 then return ty end
  local m = peer_module_of(ty)
  return m == "" and (sub(ty, 1, 37) .. "...") or (m .. "(...)")
end

-- The method calls in tree `t` of a function in the set `symmetric` that
-- pass an argument, `x.max(y)`, each
-- `{node, recv, first, fn, spanned}`: `recv` is the receiver's node, `first`
-- the first argument's, and `spanned` whether every argument has a span,
-- so its text can be moved.
function peer_method_calls(t, symmetric)
  local out = {}
  for i = 1, #t.nodes do
    local n = t.nodes[i]
    if n.kind == "e-method-call" and #n.kids == 2 and t.nodes[n.kids[1]].kind == "receiver" and #t.nodes[n.kids[1]].kids == 1 then
      local args = t.nodes[n.kids[2]]
      local fn = starts_with(n.method, ".") and sub(n.method, 2) or n.method
      if args.kind == "args" and #args.kids > 0 and has_key(symmetric, fn) then
        local spanned = t.nodes[t.nodes[n.kids[1]].kids[1]].has_span
        for a in args.kids do
          if not t.nodes[a].has_span then spanned = false end
        end
        push(out, {node = i, recv = t.nodes[n.kids[1]].kids[1], first = args.kids[1], fn = fn, spanned = spanned})
      end
    end
  end
  return out
end
