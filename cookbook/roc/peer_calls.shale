-- A library for rewrite_method_calls, loaded with
-- `use("./peer_calls.shale")`: which calls are peer calls. A method call
-- names a subject, so a function whose first two arguments are peers,
-- values of one type, as in `U64.max(a, b)`, `Str.concat(a, b)` or an app's
-- `relative(a : Color, b : Color)`, is called through its module: no
-- argument is the subject. The types are the checker's, as roc-types writes
-- them at the call, and an alias is read through to what it names, so a
-- `Hue : U32` and a `U32` are one type. A builtin's own declaration has the
-- last word, since a call's types can't tell a type variable from a type:
-- `List.fold : List(item), state, ...` takes no peers, though
-- `xs.fold([], f)` passes two lists. Those declarations are a table per Roc
-- pin, cookbook/roc/builtin_signatures/<pin>.txt, which
-- cookbook/roc/write_builtin_signatures.shale writes from the pin's
-- Builtin.roc (`peer_builtin_signatures`). A tree `t` here is the recipe's:
-- `t.nodes`, each `{kind, raw, name, method, span, has_span, kids, parent}`,
-- and `t.text`.

-- A type's name as roc-types writes it: `U64`, `List`, `Shelf.Book`.
const PEER_TYPE_NAME = "[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*"

-- The name roc-types gives the type declared at node `i`: the names of the
-- declarations around it and its own, joined by dots (`Peers.Hue` for a
-- `Hue` declared in `Peers`'s block).
function peer_declared_name(t, i)
  local names = {}
  local at = i
  while at > 0 do
    local n = t.nodes[at]
    if n.kind == "s-type-decl" then push(names, t.nodes[n.kids[1]].name) end
    at = n.parent
  end
  local out = {}
  local k = #names
  while k > 0 do
    push(out, names[k])
    k = k - 1
  end
  return join(out, ".")
end

-- Every alias the trees declare (`Hue : U32`, never `:=` or `::`), by the
-- name roc-types gives it, to the text of the type it names. An alias with
-- parameters (`Parcel(others) : ...`) is left out: reading it through
-- would need its arguments bound.
function peer_aliases(trees)
  local out = {}
  for p in sort(keys(trees)) do
    local t = trees[p]
    for i = 1, #t.nodes do
      local n = t.nodes[i]
      if n.kind == "s-type-decl" and #n.kids == 2 then
        local header = t.nodes[n.kids[1]]
        local target = t.nodes[n.kids[2]]
        local bare = header.kind == "header" and (#header.kids == 0 or #t.nodes[header.kids[1]].kids == 0)
        if bare and header.has_span and target.has_span and trim(sub(t.text, header.span.to, target.span.from - 1)) == ":" then
          out[peer_declared_name(t, i)] = sub(t.text, target.span.from, target.span.to - 1)
        end
      end
    end
  end
  return out
end

-- The type `ty` with every alias in it read through, its spaces made one.
function peer_resolved(ty, aliases, depth)
  local out = {}
  local at = 1
  local changed = false
  for m in re_find_all(ty, PEER_TYPE_NAME) do
    push(out, sub(ty, at, m.at - 1))
    if has_key(aliases, m.text) then
      push(out, aliases[m.text])
      changed = true
    else
      push(out, m.text)
    end
    at = m.at + #m.text
  end
  push(out, sub(ty, at))
  local s = re_replace(trim(join(out, "")), "\\s+", " ")
  if changed and depth < 8 then return peer_resolved(s, aliases, depth + 1) end
  return s
end

-- The module a value of the resolved type `ty` takes its methods from, the
-- type's head (`List` for `List(U8)`, `Shelf.Book`), or "" for a type that
-- has none to call through: a type variable, a record, a tuple, a tag
-- union or a function.
function peer_module_of(ty)
  local depth = 0
  for i = 1, #ty - 1 do
    local ch = sub(ty, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    local two = sub(ty, i, i + 1)
    if depth == 0 and (two == "->" or two == "=>") then return "" end
  end
  local m = re_find(ty, "^" .. PEER_TYPE_NAME)
  if m == nil then return "" end
  return m.text
end

-- Whether two arguments, of the types `a` and `b` as roc-types gives them
-- ("" where it gives none), are peers: `{peers, type, module}`, `type`
-- the first's with its aliases read through and `module` what it calls
-- through (`peer_module_of`).
function peer_verdict(a, b, aliases)
  if a == "" or b == "" then return {peers = false, type = "", module = ""} end
  local ra = peer_resolved(a, aliases, 0)
  return {peers = ra == peer_resolved(b, aliases, 0), type = ra, module = peer_module_of(ra)}
end

-- Whether the builtin `module.fn`'s declaration says its first two
-- parameters are apart, in `builtins`, a table `peer_builtin_table` read.
function peer_is_apart(builtins, module, fn)
  return get(builtins, module .. "." .. fn, "") == "apart"
end

-- The table of builtin declarations in `text`, a builtin_signatures file:
-- `Type.fn` to `peers` or `apart`, a line each, `#` lines its comments.
function peer_builtin_table(text)
  local out = {}
  for l in lines(text) do
    if l ~= "" and not starts_with(l, "#") then
      local f = split(l, "\t")
      if #f ~= 2 or (f[2] ~= "peers" and f[2] ~= "apart") then fail("peer_calls: a builtin signature line that is not `Type.fn<TAB>peers` or `apart`: " .. l) end
      out[f[1]] = f[2]
    end
  end
  return out
end

-- The shape of the type at node `i` of roc_tree's `nodes`, every type
-- variable as `*`, so `List(a)` and `List(b)` are one shape and `state` is
-- another than `List(item)`.
function peer_shape(nodes, i)
  local n = nodes[i]
  local head = n.kind == "ty-var" and "*" or (n.kind .. " " .. get(n, "name", ""))
  local parts = {}
  for k in n.kids do push(parts, peer_shape(nodes, k)) end
  return head .. "(" .. join(parts, ",") .. ")"
end

-- Each function of two parameters or more that the roc_tree file `f` (a
-- Builtin.roc) declares inside a type's block, as a line `Type.fn<TAB>peers`
-- or `apart`, sorted: `Type` the innermost declaration's name, as roc-types
-- writes a builtin type (`U8`, never `Num.U8`), and `peers` when the first
-- two parameters have one shape (`peer_shape`). A name twice (SHA256's
-- and BLAKE3's `Digest.is_eq`) is one row when the two agree, and stops
-- the run when they don't.
function peer_builtin_signatures(f)
  local seen = {}
  local out = {}
  for i = 1, #f.nodes do
    local n = f.nodes[i]
    if n.kind == "s-type-anno" then
      local fn = 0
      for k in n.kids do
        if fn == 0 and f.nodes[k].kind == "ty-fn" then fn = k end
      end
      local up = n.parent
      while up > 0 and f.nodes[up].kind ~= "s-type-decl" do up = f.nodes[up].parent end
      if fn > 0 and #f.nodes[fn].kids >= 3 and up > 0 then
        local key = f.nodes[f.nodes[up].kids[1]].name .. "." .. n.name
        local kids = f.nodes[fn].kids
        local row = key .. "\t" .. (peer_shape(f.nodes, kids[1]) == peer_shape(f.nodes, kids[2]) and "peers" or "apart")
        if has_key(seen, key) and seen[key] ~= row then fail("peer_calls: " .. f.path .. " declares " .. key .. " twice, its parameters peers in one and apart in the other") end
        if not has_key(seen, key) then push(out, row) end
        seen[key] = row
      end
    end
  end
  return sort(out)
end

-- A type's text for a finding: a long one by its head alone (`List(...)`).
function peer_short_type(ty)
  if #ty <= 40 then return ty end
  local m = peer_module_of(ty)
  return m == "" and (sub(ty, 1, 37) .. "...") or (m .. "(...)")
end

-- The method calls in tree `t` that pass an argument, `x.fn(y, ...)`, each
-- `{node, recv, first, fn, spanned}`: `recv` is the receiver's node, `first`
-- the first argument's, and `spanned` whether every argument has a span,
-- so its text can be moved.
function peer_method_calls(t)
  local out = {}
  for i = 1, #t.nodes do
    local n = t.nodes[i]
    if n.kind == "e-method-call" and #n.kids == 2 and t.nodes[n.kids[1]].kind == "receiver" and #t.nodes[n.kids[1]].kids == 1 then
      local args = t.nodes[n.kids[2]]
      if args.kind == "args" and #args.kids > 0 then
        local spanned = t.nodes[t.nodes[n.kids[1]].kids[1]].has_span
        for a in args.kids do
          if not t.nodes[a].has_span then spanned = false end
        end
        push(out, {node = i, recv = t.nodes[n.kids[1]].kids[1], first = args.kids[1], fn = starts_with(n.method, ".") and sub(n.method, 2) or n.method, spanned = spanned})
      end
    end
  end
  return out
end
