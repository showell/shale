-- This recipe checks that modules which look alike are spelled alike, and
-- that one type name means one thing. It is written in Roc, the app
-- cookbook/roc/check_families/check_families.roc and the modules beside it
-- (Family and Twin, the checks; Declarations and Tree, what they read; Text,
-- Finding and SelfTest), on Shale's Roc platform (roc_platform/README.md);
-- this file is its launcher, so it is launched as every Shale recipe is:
--
--   cd <repo> && shale <shale>/cookbook/roc/check_families.shale
--   shale cookbook:roc/check_families.shale self_test=1
--
-- The arguments:
--   glob       the files to check, `**/*.roc` by default;
--   roles      a project's file of type names, one a line, that each module
--              may declare for itself, as `Id` in `Message.Id`: read with its
--              module it is a two-part name, so `twin_name` leaves it alone;
--   self_test  with `self_test=1`, check the plants in
--              `cookbook/roc/plants/check_families/`.
--
-- The checks:
--
--   family     Modules whose names end in the same word form a family when
--              there are three or more (`CatSighting`, `TreeSighting`,
--              `RailSighting`). A public name that more than half of a
--              family's members have is the family's, and each member
--              without it is a finding. A member that differs for a good
--              reason says so by naming the missing name in the `##` doc
--              above its type, or in the file's opening comment.
--   twin_name  One public type name declared in two modules with different
--              shapes, such as `Cat.Pose` and `Geom.Pose`: one word, two
--              meanings. It is reported once, at its first declaration, with
--              the others listed. Twins of one shape are copies, as when a
--              package can't import its platform's type, so they are no
--              finding. A shape ignores what a name is qualified by, and the
--              order of fields and tags. A namespace module
--              (`Collider := [].{ ... }`) builds a type and declares none, and
--              so does an alias of the twin (`Pose : Geom.Pose`). App files are
--              left out, because every app declares what its platform asks for.
--
-- `twin_name` sees only the files read, so give it the whole tree: run by
-- folder, it misses twins in two folders.
--
-- A module is a file that declares a type named for itself, and its public
-- names are that type's members. The output is the counts, one line per
-- finding, and the counts again (cookbook/findings.shale). The run fails if
-- there are findings, or if any file doesn't parse, and the files that do
-- parse are judged either way.
--
-- **The launcher** hands every value it is given to roc_platform/run.shale in
-- the checkout this cookbook is in (the `cookbook` mount's parent), which
-- builds the Roc there (cached; the first build after a change to C Shale
-- compiles the platform's host, 25 to 50 s) and runs the program rooted
-- here, so `glob=` and `roles=` are this root's paths, as they were the Shale
-- recipe's. A value the Roc script reads no `Shale.arg!` of stops the run
-- before anything is built. Its output is the program's, then the launchers'
-- own stops when it stops. `reads=inputs` builds and runs nothing, and prints
-- the real path of each file the program is built from, one a line
-- (run.shale's header), for a caller's cache key. Its goldens, the Shale
-- original's output on the plants, are held by
-- cookbook/roc/check_families/check_goldens.shale.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/roc/check_families/check_families.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("check_families: the Roc program stopped (exit " .. r.code .. ")") end
