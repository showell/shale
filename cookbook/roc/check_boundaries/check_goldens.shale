-- cookbook/roc/check_boundaries/check_goldens.shale: check_boundaries (the
-- Roc script beside this, check_boundaries.roc, through its launcher
-- cookbook/roc/check_boundaries.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/check_boundaries/check_goldens.shale self_test=1
--   shale cookbook/roc/check_boundaries/check_goldens.shale write=1
--
-- The cases are the self-test's plants (cookbook/roc/plants/check_boundaries/),
-- all at once, by folder and with each argument's values and refusals
-- (`house`, `ways`, `nodes`, `types`, `test_reach`, `clients`, `tests`, a
-- glob named twice, a glob that finds nothing); the edges' plants
-- (cookbook/roc/plants/check_boundaries_edges/: argument texts of every
-- kind, branches alike over lines, docs above annotations, questions and
-- constants, owners nested and shared, references through an alias, an
-- expect and a value, the headers' and folders' APIs, test files, a client
-- and a gate, a file that does not parse); the typed edges under the types,
-- run from their own folder, whose roc-version pins their Roc (a flag passed
-- at five calls, a module no root reaches, no root, a root named twice);
-- and `self_test=1`. The goldens were written from the Shale original's
-- output on them, and the port matched it on other repositories' trees too
-- (roc-chat, roc-apps, roc-screensaver, with and without the types), which
-- are left out because their code moves. `write=1` writes the goldens again
-- from the launcher, for a change meant to move them: `git diff` shows what
-- moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude or
-- a library included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/roc/check_boundaries.shale"
const GOLDENS = "cookbook/roc/check_boundaries/goldens.txt"
const PLANTS = "cookbook:roc/plants/check_boundaries/"
const EDGES = "cookbook:roc/plants/check_boundaries_edges/"
const TYPED = "cookbook/roc/plants/check_boundaries_edges/typed"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The rows run from the checkout's root, as `{name, values}`: each value a
-- line, `@` standing for the plants' folder and `%` for the edges'.
const ROWS = {
  {"plants", {"glob=@**/*.roc"}},
  {"plants test_reach=dead", {"glob=@**/*.roc", "test_reach=dead"}},
  {"plants top", {"glob=@*.roc"}},
  {"plants dead with clients and gates", {"glob=@dead/**/*.roc", "clients=@dead/clients/*.roc", "tests=@dead/gates/*.roc", "test_reach=dead"}},
  {"plants dead alone", {"glob=@dead/**/*.roc"}},
  {"plants typed untyped", {"glob=@typed/*.roc"}},
  {"plants house=0", {"glob=@*.roc", "house=0"}},
  {"plants house=1", {"glob=@single*.roc", "house=1"}},
  {"plants house=2", {"glob=@*.roc", "house=2"}},
  {"plants house=2 nothing found", {"glob=@quiet_single_doc.roc", "house=2"}},
  {"plants ways=1", {"glob=@*single*.roc", "ways=1"}},
  {"plants ways=3 nodes=8", {"glob=@*single*.roc", "ways=3", "nodes=8"}},
  {"plants nodes=0", {"glob=@*single*.roc", "nodes=0"}},
  {"plants types=2", {"glob=@*.roc", "types=2"}},
  {"plants test_reach=all", {"glob=@*.roc", "test_reach=all"}},
  {"plants a glob twice", {"glob=@single.roc,@single.roc,@fixed_string.roc"}},
  {"plants clients twice", {"glob=@dead/*.roc", "clients=@dead/clients/*.roc,@dead/clients/*.roc", "tests=@dead/gates/*.roc"}},
  {"nothing", {"glob=@nothing_here/*.roc"}},
  {"edges top", {"glob=%*.roc"}},
  {"edges", {"glob=%**/*.roc"}},
  {"edges with clients and gates", {"glob=%**/*.roc", "clients=%clients/*.roc", "tests=%gates/*.roc"}},
  {"edges with clients and gates, test_reach=dead", {"glob=%**/*.roc", "clients=%clients/*.roc", "tests=%gates/*.roc", "test_reach=dead"}},
  {"edges calls", {"glob=%calls.roc"}},
  {"edges branches", {"glob=%branches.roc"}},
  {"edges docs", {"glob=%docs.roc"}},
  {"edges names", {"glob=%names.roc"}},
  {"edges owners", {"glob=%owners.roc"}},
  {"edges references", {"glob=%references.roc,%Shapes.roc"}},
  {"edges api and app", {"glob=%api.roc,%app.roc"}},
  {"edges test files", {"glob=%*Spec.roc,%*twin.roc,%twin/*.roc,%test/*.roc,%calls.roc,%Shapes.roc"}},
  {"edges lib", {"glob=%lib/*.roc"}},
  {"edges pkg", {"glob=%pkg/*.roc", "clients=%clients/*.roc"}},
  {"edges every file a client", {"glob=%*.roc", "clients=%*.roc"}},
  {"edges house=0 nodes=40 ways=4", {"glob=%**/*.roc", "house=0", "nodes=40", "ways=4"}},
  {"edges broken", {"glob=%broken/*.roc"}},
  {"edges broken among others", {"glob=%broken/*.roc,%calls.roc"}},
  {"edges types=1 with no roc-version", {"glob=%*.roc", "types=1"}},
}
-- The typed edges' rows, run from their folder.
const TYPED_ROWS = {
  {"glob=*.roc", "types=1", "root=EdgeApp.roc"},
  {"glob=Flags.roc", "types=1", "root=EdgeApp.roc"},
  {"glob=Flags.roc", "types=1", "root=EdgeApp.roc,EdgeApp.roc"},
  {"glob=*.roc", "types=1"},
  {"glob=*.roc", "types=0"},
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: check_boundaries: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- A row's values, each `@` and `%` made the folder it stands for.
function spelled(values)
  local out = {}
  for v in values do push(out, re_replace(re_replace(v, "@", PLANTS), "%", EDGES)) end
  return join(out, "\n") .. "\n"
end

-- Each case, `{name, values, cwd}`: the values on the launcher's stdin, and
-- the folder it runs in.
function cases()
  local out = {}
  for row in ROWS do push(out, {name = row[1], values = spelled(row[2]), cwd = "."}) end
  for row in TYPED_ROWS do
    push(out, {name = "in edges/typed: " .. join(row, " "), values = join(row, "\n") .. "\n", cwd = TYPED})
  end
  push(out, {name = "self_test=1", values = "self_test=1\n", cwd = "."})
  return out
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local r = run({"shale", real(LAUNCHER), "--args-stdin"}, {stdin = c.values, cwd = c.cwd, timeout_ms = 900000, whole = 8000000})
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
