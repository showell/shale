-- **A FAILURE SAID BY ITS TAGS, IN PLACE** (metal-vmm QUEUE 303, from the
-- Roc style review's S9 and S5): Roc's errors as roc-apps
-- docs/roc-style.md ("Errors and failure") writes them, read from Roc's
-- own parser's tree (`roc_tree`, the Linux prelude's, over roc-ast at
-- `tools:roc-ast/bin/roc-ast`), so a comment or a string never counts. A
-- finding is a question for a reader, never a verdict:
--
--   error_alias   a function whose result holds a `Try` whose error names
--                 an alias of tags (`ReadError : [Missing, Failed]`, or
--                 `Accounts.Unreadable`, a module type's), not the tags
--                 written in place: "a `Try`'s error lists the tags that
--                 function can return, in place; no shared error alias",
--                 since an alias of several makes every caller of each
--                 handle a tag that can't happen. The name is looked up in
--                 the files hunted (bare in its own file, qualified by its
--                 module type or file anywhere), through an alias of an
--                 alias. Quiet: an error that is no tag union (a record
--                 carried as an early answer, `Chat.Answer`; a `Str`), an
--                 alias in an argument (a handler's input,
--                 `fail_unreadable! : Try(a, Unreadable) => ...`), an
--                 error left to inference (`_`) or a type variable
--                 (`Try(a, e)`). A name declared outside the files hunted
--                 cannot be judged: the counts line names each.
--   optional_tag  a tag named as an optional (cookbook/words/optionals.txt:
--                 `Some`, `None`, `Nothing`, ...), which says only that a
--                 value may be missing: "a value that may be absent is
--                 tagged by what it is, and its absence by why"
--                 (`[Latest(Message), NoMessage]`). Each type that names
--                 one is a finding; a pattern or an expression only where
--                 no type of the files hunted names the tag (an `Err(None)`
--                 whose error is inferred), once a file. A tag is matched
--                 whole: `NoneChosen` is no `None`.
--
-- Only a top-level or module-member annotation is read (a local's is its
-- definition's). One line a finding, `path:line: <check>: <why>`, then the
-- counts.
--
--   cd <repo> && shale <shale>/cookbook/roc/errors.shale glob=chat/**/*.roc
--   shale cookbook:roc/errors.shale self_test=1
--
-- `self_test=1` runs it over `cookbook/roc/plants/errors/`, each plant
-- named for the check it holds: every check must fire on its own plants and
-- on no other, a `quiet_*.roc` plant on none.
-- budget: steps=400000000 arena_bytes=1500000000

const SELF = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/errors/"
const GLOB = SELF and (PLANTS .. "*.roc") or arg("glob", "**/*.roc")
const CHECKS = {"error_alias", "optional_tag"}
const OUTER = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

-- A word table of cookbook/words/, the hunts' one home for them: a word a
-- line, `--` starting a note.
function word_table(file)
  local t = {}
  for l in lines(read("cookbook:words/" .. file)) do
    local w = trim(split(l, "--")[1])
    if contains(w, " ") or has_key(t, w) then fail("errors: cookbook/words/" .. file .. ": `" .. w .. "` is no single new word") end
    if w ~= "" then t[w] = true end
  end
  return t
end
const OPTIONALS = word_table("optionals.txt")

const found = {}
for c in CHECKS do found[c] = 0 end
const per_file = {}

function say(p, line, check, why)
  print(p .. ":" .. line .. ": " .. check .. ": " .. why)
  found[check] = found[check] + 1
  per_file[p .. "|" .. check] = true
  return nil
end

-- Every file's tree as one list `N`, each node's `parent` and `kids`
-- moved to their place in it (`parent` 0 for a root), and `FILE` the path
-- of each.
const paths = glob(GLOB)
const N = {}
const FILE = {}
do
  local refused = {}
  for f in roc_tree(paths) do
    if f.err ~= "" then push(refused, f.err) end
    local base = #N
    for n in f.nodes do
      local ks = {}
      for k in n.kids do push(ks, k + base) end
      n.kids = ks
      if n.parent > 0 then n.parent = n.parent + base end
      push(N, n)
      push(FILE, f.path)
    end
  end
  -- A file that does not parse has no tree: hunting the rest would pass it
  -- unread.
  if #refused > 0 then fail("errors: roc-ast refused " .. #refused .. " files: " .. join(refused, "; ")) end
end

function kids(at)
  return N[at].kids
end

-- The last node of the subtree at `at`: nodes run in source order, each
-- before its kids.
function last_of(at)
  local i = at
  while #N[i].kids > 0 do i = N[i].kids[#N[i].kids] end
  return i
end

function kind(at)
  return N[at].kind
end

function nm(at)
  return get(N[at], "name", "")
end

function raw(at)
  return get(N[at], "raw", "")
end

-- A node's line; one with no span of its own is placed by the first below
-- it that has one.
function line(at)
  local i = at
  while i <= #N and N[i].line == 0 do i = i + 1 end
  return i <= #N and N[i].line or "?"
end

-- The tags of a `ty-tag-union`, by name (`Some` of `Some(U64)` too).
function union_tags(at)
  local out = {}
  for t in kids(at) do
    if kind(t) == "tags" then
      for g in kids(t) do
        if kind(g) == "ty-apply" then push(out, nm(kids(g)[1])) else push(out, nm(g)) end
      end
    end
  end
  return out
end

-- ── error_alias: a function's result, its every `Try` ────────────────────

-- Whether node `at` sits where a top-level or module member's annotation
-- does, from the kinds above it.
function is_outer(at)
  local p = N[at].parent
  while p > 0 do
    if not has_key(OUTER, kind(p)) then return false end
    p = N[p].parent
  end
  return true
end

-- **EVERY TYPE DECLARED IN THE FILES HUNTED**, by the names a `Try` may
-- give it, each the node of what it is declared as: `QUAL` by its
-- qualified name (the module types around it, `Stored.Problem`, and for a
-- file's top level the file's own, `Access.Answer`), `BARE` by file and
-- bare name (`Problem` inside Stored.roc).
const QUAL = {}
const BARE = {}
-- The name a type declaration at `at` declares, or "".
function decl_name(at)
  local ks = kids(at)
  if kind(at) ~= "s-type-decl" or #ks < 2 then return "" end
  return nm(ks[1])
end

for i = 1, #N do
  local n = decl_name(i)
  if n ~= "" then
    local up = {n}
    local p = N[i].parent
    while p > 0 do
      if decl_name(p) ~= "" then push(up, decl_name(p)) end
      p = N[p].parent
    end
    local chain = {}
    for k = #up, 1, -1 do push(chain, up[k]) end
    local at = kids(i)[2]
    QUAL[join(chain, ".")] = at
    if #chain == 1 then
      local base = split(FILE[i], "/")
      base = base[#base]
      QUAL[sub(base, 1, #base - 4) .. "." .. n] = at
    end
    BARE[FILE[i] .. "|" .. n] = at
  end
end

-- What the error named `n` in `file` is: `union` (an alias of tags, `[A,
-- B]`, followed through an alias of an alias), `other` (a record, a
-- builtin like `Str`, an empty module type) or `unknown` (declared outside
-- the files hunted).
const BUILTIN = {Str = true, Bool = true, U8 = true, U16 = true, U32 = true, U64 = true, U128 = true, I8 = true, I16 = true, I32 = true, I64 = true, I128 = true, F32 = true, F64 = true, Dec = true, List = true, Dict = true, Set = true, Box = true}
function error_kind(file, n, hops)
  if has_key(BUILTIN, n) then return "other" end
  local at = get(BARE, file .. "|" .. n) or get(QUAL, n)
  if at == nil then return "unknown" end
  if kind(at) == "ty-tag-union" then return #union_tags(at) > 0 and "union" or "other" end
  if kind(at) == "ty" and nm(at) ~= "" and hops < 8 then return error_kind(file, nm(at), hops + 1) end
  return "other"
end

-- The errors named by a type declared outside the files hunted, which
-- `error_alias` cannot judge, by name: said in the counts, never dropped.
const unjudged = {}

for i = 1, #N do
  if kind(i) == "s-type-anno" and is_outer(i) then
    local ks = kids(i)
    if #ks > 0 and kind(ks[1]) == "ty-fn" then
      local parts = kids(ks[1])
      local res = parts[#parts]
      for j = res, last_of(res) do
        if kind(j) == "ty-apply" then
          local tk = kids(j)
          if #tk == 3 and nm(tk[1]) == "Try" then
            local e = tk[3]
            local n = nm(e)
            if n ~= "" and kind(e) == "ty" then
              local ek = error_kind(FILE[i], n, 0)
              if ek == "union" then say(FILE[i], line(i), "error_alias", "`" .. nm(i) .. "` fails with `" .. n .. "`, a shared alias of tags: list the tags it can return in place, or leave the error to inference (`_`)") end
              if ek == "unknown" then unjudged[n] = get(unjudged, n, 0) + 1 end
            end
          end
        end
      end
    end
  end
end

-- ── optional_tag ─────────────────────────────────────────────────────────

-- The optional tags each type names, by tag, and the expressions' and
-- patterns' by file and tag.
const typed = {}
const used = {}
for i = 1, #N do
  local k = kind(i)
  if k == "ty-tag-union" then
    for t in union_tags(i) do
      if has_key(OPTIONALS, t) then
        typed[t] = true
        say(FILE[i], line(i), "optional_tag", "`" .. t .. "` names an optional: tag what the value is, and its absence by why (`[Latest(Message), NoMessage]`)")
      end
    end
  elseif k == "e-tag" or k == "p-tag" then
    local n = raw(i)
    local key = FILE[i] .. "|" .. n
    if has_key(OPTIONALS, n) and not has_key(used, key) then used[key] = {path = FILE[i], line = line(i), tag = n} end
  end
end
for key in sort(keys(used)) do
  local u = used[key]
  if not has_key(typed, u.tag) then say(u.path, u.line, "optional_tag", "`" .. u.tag .. "` names an optional, and no type here says what it is: tag the value by what it is, and its absence by why") end
end

local counts = {}
for c in CHECKS do push(counts, c .. " " .. found[c]) end
local unseen = {}
for n in sort(keys(unjudged)) do push(unseen, n .. " (" .. unjudged[n] .. ")") end
local unseen_said = #unseen > 0 and ("; error_alias not judged, declared outside the files hunted: " .. join(unseen, ", ")) or ""
print("errors (Roc): " .. #paths .. " files; " .. join(counts, ", ") .. unseen_said)

if SELF then
  local wrong = {}
  for c in CHECKS do
    local planted = 0
    for p in paths do
      local base = sub(p, #PLANTS + 1)
      local mine = base == c .. ".roc" or starts_with(base, c .. "_")
      if mine then planted = planted + 1 end
      local fired = has_key(per_file, p .. "|" .. c)
      if mine and not fired then push(wrong, "`" .. c .. "` does not fire on its plant " .. p) end
      if fired and not mine then push(wrong, "`" .. c .. "` fires on " .. p .. ", another check's plant") end
    end
    if planted == 0 then push(wrong, "`" .. c .. "` has no plant") end
  end
  -- A plant's every error is declared beside it: one left unjudged would
  -- pass quiet without the rule being asked.
  for n in sort(keys(unjudged)) do push(wrong, "`error_alias` cannot judge `" .. n .. "`, declared in no plant") end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("errors self_test: " .. #wrong .. " plants wrong") end
  print("errors (Roc) self_test: PASS (each check fires on its plants alone, the quiet_ plants on none)")
end
