-- A Roc file's parse tree (from `roc_tree`) is a list of nodes, each
-- `{kind, parent, kids, line, column, end_line, end_column, depth}` plus attributes
-- such as `name` and `raw`, and a node's index is its place in the list. This
-- library reads the things the naming recipes share out of that tree: a
-- type written as Roc writes it, a name's words, and the list of what a file
-- declares.
--
--   use("cookbook:roc/declared.shale")
--   declarations_of(file)         each type, value and record field declared
--   render_type(tree, at)         the type at node `at`, as text
--   name_words(name)              a name's words, lowercased
--   comment_on_line(l)            the text of the comment on line `l`
--   last_part(type_name)          a dotted type's last part
--   module_name(path), is_app(f)  a file's module, and whether it is an app
--   opening_comment(src)          the comment lines that open a file
--   word_set(path)                a word list, such as one in cookbook/words
--   namespace_instructions(file), taken_word_kinds(file), list_name_kinds(file)
--                                 the word lists that hold more than words
--   span_text(src, tree, at)      a node's source text
--   union_shape, argument_shape, mentioned_type_names
--                                 what a type in the tree holds
--   previous_sibling, calls_itself
--                                 where a node sits, and what a definition calls
--   camel_case(ws), tag_first_word(tag)
--                                 words into a type's name, and a tag's first word
--   first_argument, success_type, list_element, element_word
--                                 the parts of a type written as text
--   project_terms(path), list_name_finding(subject, w)
--                                 hunt_names' `singular_list`: a project's
--                                 terms, and what a list's name says
--   is_letter_of_set(name, siblings)
--                                 a field's letter that `short_name` passes
--   short_binding_findings(file)  `short_name`'s one-letter locals, parameters
--                                 and match bindings
--   reads_as_maker(def, ws, signature, facts, prepositions)
--                                 what `phrase_name` passes as a maker
--   file_definitions(f, src, known, facts)
--                                 hunt_names' definition records of a file

-- The kinds of node a definition may sit in and still be top-level or a
-- module type's member, which `associated` holds. Inside any other kind,
-- such as a lambda's block, a definition is local.
const OUTER_KINDS = {file = true, statements = true, ["s-type-decl"] = true, associated = true}

function children(tree, at)
  return tree[at].kids
end

function attribute(tree, at, name)
  return get(tree[at], name, "")
end

-- A dotted type's last part.
function last_part(type_name)
  local parts = split(type_name, ".")
  return parts[#parts]
end

-- The type at `at`, as Roc writes it: `List(U8)`, `{ id : U8 }`, `[A, B]`,
-- `(U8 -> Bool)`. The tree does not say which arrow a function type has,
-- so both come out as `->`. With `as_shape`, each name is cut to its last part
-- and fields and tags are sorted, so two copies of a type read alike.
function render_type(tree, at, as_shape?)
  local kind = tree[at].kind
  local kids = children(tree, at)
  local name = attribute(tree, at, "name")
  if kind == "ty-apply" then
    local args = {}
    for c in drop(kids, 1) do push(args, render_type(tree, c, as_shape)) end
    return render_type(tree, kids[1], as_shape) .. "(" .. join(args, ", ") .. ")"
  end
  if kind == "ty-fn" then
    local args = {}
    for c in take(kids, #kids - 1) do push(args, render_type(tree, c, as_shape)) end
    return "(" .. join(args, ", ") .. " -> " .. render_type(tree, kids[#kids], as_shape) .. ")"
  end
  if kind == "ty-record" or kind == "ty-tuple" or kind == "tags" then
    local parts = {}
    for c in kids do push(parts, render_type(tree, c, as_shape)) end
    if as_shape and kind ~= "ty-tuple" then sort(parts) end
    if kind == "ty-record" then return "{ " .. join(parts, ", ") .. " }" end
    if kind == "ty-tuple" then return "(" .. join(parts, ", ") .. ")" end
    return join(parts, ", ")
  end
  if kind == "ty-tag-union" then return "[" .. render_type(tree, kids[1], as_shape) .. "]" end
  if kind == "anno-record-field" then return name .. " : " .. render_type(tree, kids[1], as_shape) end
  if name ~= "" then return as_shape and last_part(name) or name end
  -- An inferred type, as in `name : _`.
  if kind == "_" then return "_" end
  local raw = attribute(tree, at, "raw")
  if raw ~= "" then return raw end
  return "(" .. kind .. ")"
end

-- A name's words, lowercased: a type's split at its capitals (`NodeInfo`
-- gives `node`, `info`), a field's at its underscores.
function name_words(name)
  local out = {}
  local current = ""
  for i = 1, #name do
    local c = sub(name, i, i)
    if c == "_" then
      if current ~= "" then push(out, lower(current)) end
      current = ""
    elseif c ~= lower(c) and current ~= "" then
      push(out, lower(current))
      current = c
    else
      current = current .. c
    end
  end
  if current ~= "" then push(out, lower(current)) end
  return out
end

-- The comment lines directly above line `line` of `src`, lowercased and
-- joined: a declaration's doc.
function doc_above(src, line)
  local parts = {}
  local k = line - 1
  while k >= 1 and starts_with(trim(src[k]), "#") do
    push(parts, lower(trim(src[k])))
    k = k - 1
  end
  return join(parts, " ")
end

-- The line of the declaration that the record field at `at` belongs to:
-- the nearest top-level or member annotation or type declaration above it,
-- as `declaration_line` records it. It is "" when an expression, pattern
-- or definition lies between them, since the field is then a local's.
function field_declaration_line(tree, declaration_line, at)
  local k = tree[at].parent
  while k ~= 0 do
    local kind = tree[k].kind
    if starts_with(kind, "e-") or starts_with(kind, "p-") or kind == "s-decl" then return "" end
    if kind == "s-type-anno" or kind == "s-type-decl" then return declaration_line[k] end
    k = tree[k].parent
  end
  return ""
end

-- The text after the `#` that starts line `l`'s comment, or nil when it has
-- none. A `#` inside a string or a character is not a comment, and a line
-- of a `\\` multiline string has no comment at all.
function comment_on_line(l)
  if starts_with(trim(l), "\\\\") then return nil end
  local i = 1
  local n = #l
  while i <= n do
    local c = sub(l, i, i)
    if c == "\"" or c == "'" then
      i = i + 1
      while i <= n and sub(l, i, i) ~= c do
        if sub(l, i, i) == "\\" then i = i + 1 end
        i = i + 1
      end
    elseif c == "#" then
      return sub(l, i + 1)
    end
    i = i + 1
  end
  return nil
end

-- The module a .roc file holds, by its file name.
function module_name(path)
  local base = basename(path)
  return sub(base, 1, #base - 4)
end

-- Whether the parsed file `f` is an app, with an `app` header.
function is_app(f)
  for n in f.nodes do
    if n.kind == "app" then return true end
  end
  return false
end

-- The comment lines that open a file, from its lines `src`, trimmed.
function opening_comment(src)
  local out = {}
  local k = 1
  while k <= #src and starts_with(trim(src[k]), "#") do
    push(out, trim(src[k]))
    k = k + 1
  end
  return out
end

-- The lines of a word list, with any note after `--` cut off.
function word_list_lines(path)
  local out = {}
  for l in lines(read(path)) do push(out, trim(split(l, "--")[1])) end
  return out
end

-- A list of one word per line, as a set. A word listed twice, or a line of
-- two words, fails the run.
function word_set(path)
  if not exists(path) then fail("no word list " .. path) end
  local set = {}
  for word in word_list_lines(path) do
    if contains(word, " ") or has_key(set, word) then fail(path .. ": `" .. word .. "` is no single new word") end
    if word ~= "" then set[word] = true end
  end
  return set
end

-- cookbook/words/namespaces.txt has a prefix per line followed by the
-- namespace's own instructions (`port in out`). The result maps each prefix
-- to the set of its instructions: `{port = {["in"] = true, out = true}}`.
function namespace_instructions(file)
  local by_prefix = {}
  for l in word_list_lines("cookbook:words/" .. file) do
    local ws = words(l)
    if #ws > 0 then
      if has_key(by_prefix, ws[1]) then fail("hunt_names: cookbook/words/" .. file .. ": `" .. ws[1] .. "` twice") end
      by_prefix[ws[1]] = set_of(drop(ws, 1))
    end
  end
  return by_prefix
end

-- cookbook/words/taken.txt has a word per line followed by its kind, `roc`
-- or `cardinal`. The result maps each word to its kind:
-- `{record = "roc", two = "cardinal"}`.
function taken_word_kinds(file)
  local kinds = {}
  for l in word_list_lines("cookbook:words/" .. file) do
    local ws = words(l)
    if #ws > 0 then
      if #ws ~= 2 or (ws[2] ~= "roc" and ws[2] ~= "cardinal") or has_key(kinds, ws[1]) then fail("hunt_names: cookbook/words/" .. file .. ": `" .. join(ws, " ") .. "` is no new word with its kind, `roc` or `cardinal`") end
      kinds[ws[1]] = ws[2]
    end
  end
  return kinds
end

-- cookbook/words/list_names.txt has a word per line followed by its kind,
-- `many`, `one`, `after`, `accumulator` or `adjective`. The result maps each
-- word to its kind.
function list_name_kinds(file)
  local kinds = {}
  for l in word_list_lines("cookbook:words/" .. file) do
    local ws = words(l)
    if #ws > 0 then
      local kind_known = #ws == 2 and has_item({"many", "one", "after", "accumulator", "adjective"}, ws[2])
      if not kind_known or has_key(kinds, ws[1]) then fail("hunt_names: cookbook/words/" .. file .. ": `" .. join(ws, " ") .. "` is no new word with its kind, `many`, `one`, `after`, `accumulator` or `adjective`") end
      kinds[ws[1]] = ws[2]
    end
  end
  return kinds
end

-- The name of the type declaration around node `at`, or "" at the top level.
function owner_of(tree, at)
  local k = tree[at].parent
  while k ~= 0 do
    if tree[k].kind == "s-type-decl" then return attribute(tree, children(tree, k)[1], "name") end
    k = tree[k].parent
  end
  return ""
end

-- Whether the node is a string with something in it: `""` spans two columns.
function is_text(node)
  return node.kind == "e-string" and (node.end_line > node.line or node.end_column - node.column > 2)
end

-- The record for the annotation at `i`, or nil when it is only a `where`
-- clause. `type` is its whole type. `has_text` says its definition is a string
-- with something in it. A function also has `result`, what it returns, and
-- `first`, its first argument's type.
function annotated_value(path, tree, i)
  local kids = children(tree, i)
  if #kids == 0 or tree[kids[1]].kind == "where" then return nil end
  local record = {path = path, line = tree[i].line, kind = "value", name = attribute(tree, i, "name"), owner = owner_of(tree, i), annotated = true, fn = false, has_text = false, type = render_type(tree, kids[1])}
  record.result = record.type
  if tree[kids[1]].kind == "ty-fn" then
    local parts = children(tree, kids[1])
    record.fn = true
    record.result = render_type(tree, parts[#parts])
    record.first = #parts > 1 and render_type(tree, parts[1]) or ""
  end
  return record
end

-- The record for the type declared at `i`. `underlying` is the type it is
-- built on, `shape` the same as `render_type` gives a shape, and `is_nominal`
-- says it is declared with `:=` or `::`, not as an alias with `:`; `is_fn`
-- that it is built on a function type.
function declared_type(path, src, tree, i)
  local kids = children(tree, i)
  local name = attribute(tree, kids[1], "name")
  if name == "" then return nil end
  local record = {path = path, line = tree[i].line, kind = "type", name = name, owner = owner_of(tree, i), underlying = "", shape = "", is_nominal = false, is_tags = false, is_fn = false}
  if #kids > 1 and tree[kids[2]].kind ~= "associated" then
    record.is_fn = tree[kids[2]].kind == "ty-fn"
    local between = sub(src[tree[kids[1]].end_line], tree[kids[1]].end_column, tree[kids[1]].end_column + 3)
    record.is_nominal = contains(between, ":=") or contains(between, "::")
    record.underlying = render_type(tree, kids[2])
    record.shape = render_type(tree, kids[2], true)
    record.is_tags = tree[kids[2]].kind == "ty-tag-union"
  end
  return record
end

-- Everything the parsed file `f` declares at its top level or as a module
-- type's member, in file order. Each record is `{path, line, kind, name,
-- owner}`, where `owner` is the type it is a member of, or "" at the top
-- level, and `kind` is one of these:
--   value  an annotation, or a definition with no annotation just above it
--          (`annotated` false, and `fn` true when its value is a lambda);
--   field  a record field in a type or an annotation, with its `type`;
--   type   a type declaration (see `declared_type`).
function declarations_of(f)
  local tree = f.nodes
  local src = split(read(f.path), "\n")
  local out = {}
  -- Each node is outer when it and every ancestor sit in OUTER_KINDS, and
  -- its `declaration_line` is its line when it is an outer annotation or
  -- type declaration, else "". A parent comes before its children.
  local outer = {}
  local declaration_line = {}
  local annotated_names = {}
  for i = 1, #tree do
    local node = tree[i]
    local parent = node.parent
    push(outer, parent == 0 or (outer[parent] and has_key(OUTER_KINDS, tree[parent].kind)))
    local kind = node.kind
    push(declaration_line, (outer[i] and (kind == "s-type-anno" or kind == "s-type-decl")) and tostring(node.line) or "")
    if outer[i] and kind == "s-type-decl" then
      local record = declared_type(f.path, src, tree, i)
      if record ~= nil then push(out, record) end
    end
    if kind == "anno-record-field" and field_declaration_line(tree, declaration_line, i) ~= "" then
      push(out, {path = f.path, line = node.line, kind = "field", name = attribute(tree, i, "name"), owner = owner_of(tree, i), type = render_type(tree, children(tree, i)[1])})
    end
    if outer[i] and kind == "s-type-anno" then
      local record = annotated_value(f.path, tree, i)
      if record ~= nil then
        push(out, record)
        annotated_names[record.owner .. "." .. record.name] = record
      end
    end
    if outer[i] and kind == "s-decl" then
      local kids = children(tree, i)
      if #kids > 0 and tree[kids[1]].kind == "p-ident" then
        local name = attribute(tree, kids[1], "raw")
        local owner = owner_of(tree, i)
        if has_key(annotated_names, owner .. "." .. name) then
          annotated_names[owner .. "." .. name].has_text = #kids > 1 and is_text(tree[kids[2]])
        else
          push(out, {path = f.path, line = node.line, kind = "value", name = name, owner = owner, annotated = false, fn = #kids > 1 and tree[kids[2]].kind == "e-lambda", type = "", result = ""})
        end
      end
    end
  end
  return out
end

-- The source text of the node at `at`, from the file's lines `src`. A
-- node's end column is one past its last character.
function span_text(src, tree, at)
  local node = tree[at]
  if node.line == 0 then return "" end
  if node.line == node.end_line then return sub(src[node.line], node.column, node.end_column - 1) end
  local parts = {sub(src[node.line], node.column)}
  for l = node.line + 1, node.end_line - 1 do push(parts, src[l]) end
  push(parts, sub(src[node.end_line], 1, node.end_column - 1))
  return join(parts, "\n")
end

-- The tags of the tag union at `at`, as `{names, payload}`: `names` lists
-- the tag names (`Unpinned` for `Unpinned(Str)` too), and `payload` says
-- whether any tag carries one.
function union_shape(tree, at)
  local shape = {names = {}, payload = false}
  for t in children(tree, at) do
    if tree[t].kind == "tags" then
      for tag in children(tree, t) do
        local name = attribute(tree, tag, "name")
        if tree[tag].kind == "ty-apply" then
          shape.payload = true
          name = attribute(tree, children(tree, tag)[1], "name")
        end
        if name ~= "" then push(shape.names, name) end
      end
    end
  end
  return shape
end

-- An argument's type, as `command_tense` and `mixed_tense` need it:
-- `{union}` for a tag union written in place, `{ref}` for a named type
-- (its last part: `ChatState.PinEdit` gives `PinEdit`), or `{}`. A
-- `List(T)` gives the shape of `T`, with `list` set.
function argument_shape(tree, at)
  local kind = tree[at].kind
  if kind == "ty-tag-union" then return {union = union_shape(tree, at)} end
  if kind == "ty-apply" then
    local kids = children(tree, at)
    if #kids == 2 and attribute(tree, kids[1], "name") == "List" then
      local element = argument_shape(tree, kids[2])
      element.list = true
      return element
    end
    return {}
  end
  local name = attribute(tree, at, "name")
  if name == "" then return {} end
  local parts = split(name, ".")
  return {ref = parts[#parts]}
end

-- The names of the types the type at `at` mentions, added to the set
-- `into`, each by its last part (`Draw.RoundedRectangle` gives
-- `RoundedRectangle`).
function mentioned_type_names(tree, at, into)
  local name = attribute(tree, at, "name")
  if starts_with(tree[at].kind, "ty") and name ~= "" then
    local parts = split(name, ".")
    into[parts[#parts]] = true
  end
  for c in children(tree, at) do mentioned_type_names(tree, c, into) end
  return into
end

-- Whether the definition at `at` mentions `name` in its body, as an
-- identifier (`name`, `Tree.name`) or a method call (`x.name(...)`). A
-- node's descendants follow it in the tree, each deeper than it.
function calls_itself(tree, at, name)
  local j = at + 1
  while j <= #tree and tree[j].depth > tree[at].depth do
    local node = tree[j]
    if node.kind == "e-ident" then
      local raw = attribute(tree, j, "raw")
      if raw == name or ends_with(raw, "." .. name) then return true end
    end
    if node.kind == "e-method-call" and attribute(tree, j, "method") == name then return true end
    j = j + 1
  end
  return false
end

-- The sibling just before the node at `at`, or 0.
function previous_sibling(tree, at)
  local parent = tree[at].parent
  if parent == 0 then return 0 end
  local previous = 0
  for k in tree[parent].kids do
    if k == at then return previous end
    previous = k
  end
  return 0
end

-- Words joined as one type name: `rounded`, `rectangle` gives
-- `RoundedRectangle`.
function camel_case(ws)
  local out = ""
  for w in ws do out = out .. upper(sub(w, 1, 1)) .. sub(w, 2) end
  return out
end

-- A tag's first word, lowercased: `Unpinned` gives `unpinned`, `AddedTo`
-- gives `added`.
function tag_first_word(tag)
  local word = lower(sub(tag, 1, 1))
  local k = 2
  while k <= #tag and sub(tag, k, k) == lower(sub(tag, k, k)) do
    word = word .. sub(tag, k, k)
    k = k + 1
  end
  return word
end

-- The first argument in a function type's argument text, `a, b`.
function first_argument(args)
  local depth = 0
  for i = 1, #args do
    local ch = sub(args, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    if depth == 0 and ch == "," then return trim(sub(args, 1, i - 1)) end
  end
  return trim(args)
end

-- `Try(Fraction, [OutOfRange])` gives `Fraction`, and any other type itself.
function success_type(type_text)
  local text = trim(type_text)
  if starts_with(text, "Try(") and ends_with(text, ")") then return first_argument(sub(text, 5, #text - 1)) end
  return text
end

-- The element type's text of a `List(...)` or a `Try` of one, else nil.
function list_element(type_text)
  local text = success_type(type_text)
  if starts_with(text, "List(") and ends_with(text, ")") then return sub(text, 6, #text - 1) end
  return nil
end

-- The last word of `element`, a type's text, or "" for one with no name:
-- `Shapes.RoundShape(a)` gives `shape`.
function element_word(element)
  local head = re_find(element, "^[A-Za-z0-9_.]+")
  if head == nil then return "" end
  local type_words = name_words(last_part(head.text))
  return #type_words > 0 and type_words[#type_words] or ""
end

-- ── what `singular_list` reads of a name, for hunt_names ─────────────────
--
-- hunt_names judges a list's name here, beside the readings of a type it
-- needs, since a library's functions can't call another library's. The word
-- tables come in as `w`, `{list_names, taken, verbs, prepositions, plain,
-- participles, ed_verbs, terms}`, as hunt_names loads them.

-- Whether a field of one letter is a coordinate (`x`, `y`, `z`, and `w`
-- beside `x` and `y`), a colour's channel (`r`, `g`, `b`, and `a` beside
-- them) or a triangle's corner (`a`, `b` and `c`, all three), by `siblings`,
-- the set of its record's fields: hunt_names' `short_name` passes these.
function is_letter_of_set(name, siblings)
  if has_item({"x", "y", "z"}, name) or (name == "w" and has_key(siblings, "x") and has_key(siblings, "y")) then return true end
  if has_item({"a", "b", "c"}, name) and has_key(siblings, "a") and has_key(siblings, "b") and has_key(siblings, "c") then return true end
  return has_item({"r", "g", "b", "a"}, name) and has_key(siblings, "r") and has_key(siblings, "g") and has_key(siblings, "b")
end

-- The list methods whose one-line lambda is a loop's body, so its
-- parameters are loop variables (`xs.map(|x| x * 2)`, `List.walk(xs, 0, |n,
-- x| n + x)`).
const LOOP_METHODS = {map = true, map2 = true, map3 = true, map_with_index = true, map_try = true, keep_if = true, drop_if = true, keep_oks = true, keep_errs = true, walk = true, walk_backwards = true, walk_until = true, walk_with_index = true, walk_try = true, any = true, all = true, count_if = true, find_first = true, find_last = true, find_first_index = true, find_last_index = true, sort_with = true, join_map = true, ["for_each!"] = true, ["for_each_try!"] = true, ["walk!"] = true, ["walk_try!"] = true}
const PATTERN_HOLDERS = {args = true, field = true, ["p-record"] = true, ["p-tuple"] = true, ["p-list"] = true, ["p-tag"] = true, ["p-as"] = true}

-- The last node of the subtree at `at`: the tree is in order, each subtree
-- running on while the depth is deeper than its root's.
function subtree_end(tree, at)
  local stop = at
  while stop < #tree and tree[stop + 1].depth > tree[at].depth do stop = stop + 1 end
  return stop
end

-- Whether the lambda at `at` is a loop's body: on one line, and the direct
-- argument of a list method (LOOP_METHODS), as a method call or a module's
-- (`List.map(xs, |x| ...)`).
function is_loop_lambda(tree, at)
  local lambda = tree[at]
  if lambda.line ~= lambda.end_line then return false end
  local holder = tree[lambda.parent]
  if holder.kind == "args" and tree[holder.parent].kind == "e-method-call" then
    return has_key(LOOP_METHODS, re_replace(get(tree[holder.parent], "method", ""), "^\\.", ""))
  end
  if holder.kind ~= "e-apply" or holder.kids[1] == at then return false end
  local callee = tree[holder.kids[1]]
  if callee.kind ~= "e-ident" then return false end
  local parts = split(get(callee, "raw", ""), ".")
  return #parts == 2 and parts[1] == "List" and has_key(LOOP_METHODS, parts[2])
end

-- The name a node binds, `""` for none: a pattern's name, a record's pun
-- (`{ x }`), a list's rest (`.. as rest`) and a `var`.
function bound_name(tree, at)
  local n = tree[at]
  if n.kind == "p-ident" then return get(n, "raw", "") end
  if n.kind == "field" and tree[n.parent].kind == "p-record" and #n.kids == 0 then return get(n, "name", "") end
  if n.kind == "p-list-rest" or n.kind == "s-var" then return get(n, "name", "") end
  return ""
end

-- The names bound beside the binding at `at` in one pattern: a lambda's
-- parameters, a record's fields, a tuple's or a tag's parts. A record's
-- field renamed (`{ y: q }`) binds its pattern, beside the record's others.
function bound_siblings(tree, holder)
  local out = {}
  for k in tree[holder].kids do
    local name = bound_name(tree, k)
    if name ~= "" then out[name] = true end
    if tree[k].kind == "field" then
      for j in tree[k].kids do
        local inner = bound_name(tree, j)
        if inner ~= "" then out[inner] = true end
      end
    end
  end
  return out
end

-- Whether a definition at `at` is top-level or a module type's member, its
-- ancestors all OUTER_KINDS: hunt_names judges its name as a definition.
function is_outer_definition(tree, at)
  local up = tree[at].parent
  while up > 0 do
    if not has_key(OUTER_KINDS, tree[up].kind) then return false end
    up = tree[up].parent
  end
  return true
end

-- hunt_names' `short_name` for what a file binds inside its definitions: each
-- local, parameter, match binding, record destructuring and `var` whose name
-- (past a `$` or `_`, before a `!`) is one letter, as `{line, why}`. These
-- pass: a loop variable (a `for`'s binding, a `var` a `while` tests, the
-- parameters of a loop's one-line lambda, `is_loop_lambda`), a coordinate
-- (`x`, `y`, `z`, and `w` beside `x` and `y`), a colour's channels (`r`, `g`,
-- `b` together, and `a` beside them) and a triangle's corners (`a`, `b` and
-- `c` destructured from one record). Top-level and member names are the
-- definition's, judged there; a `$name = ...` reassigns its `var`.
function short_binding_findings(file)
  local tree = file.nodes
  local tested = {}
  local vars = {}
  for i = 1, #tree do
    local n = tree[i]
    if n.kind == "s-while" and #n.kids > 0 then
      for j = n.kids[1], subtree_end(tree, n.kids[1]) do
        if tree[j].kind == "e-ident" then tested[get(tree[j], "raw", "")] = true end
      end
    end
    if n.kind == "s-var" then vars[get(n, "name", "")] = true end
  end
  local found = {}
  for i = 1, #tree do
    local name = bound_name(tree, i)
    local letters = re_replace(re_replace(name, "^[$_]+", ""), "!$", "")
    if #letters == 1 then
      local n = tree[i]
      -- Up through the pattern to what binds it, and the pattern it sits in.
      local holder = n.parent
      if n.kind == "p-ident" and tree[holder].kind == "field" then holder = tree[holder].parent end
      local binder = n.parent
      while binder > 0 and has_key(PATTERN_HOLDERS, tree[binder].kind) do binder = tree[binder].parent end
      local binder_kind = n.kind == "s-var" and "s-var" or tree[binder].kind
      local siblings = n.kind == "s-var" and {} or bound_siblings(tree, holder)
      local is_record = tree[holder].kind == "p-record"
      local skip = false
      if binder_kind == "s-decl" and (is_outer_definition(tree, binder) or (starts_with(name, "$") and has_key(vars, name))) then skip = true end
      if binder_kind == "s-var" and has_key(tested, name) then skip = true end
      if binder_kind == "s-for" then skip = true end
      if binder_kind == "e-lambda" and is_loop_lambda(tree, binder) then skip = true end
      if is_letter_of_set(letters, siblings) and not (has_item({"a", "b", "c"}, letters) and not is_record and not (has_key(siblings, "r") and has_key(siblings, "g") and has_key(siblings, "b"))) then skip = true end
      if not skip then
        local what = "the binding"
        if binder_kind == "s-decl" then what = "the local" end
        if binder_kind == "e-lambda" then what = "the parameter" end
        if binder_kind == "branch" then what = "the match binding" end
        if binder_kind == "s-var" then what = "the var" end
        push(found, {line = n.line, why = what .. " `" .. name .. "` is one letter: name what it holds"})
      end
    end
  end
  return found
end

-- Whether a word reads as a past participle: an irregular one of
-- participles.txt, or a word past three letters ending in `ed` that
-- ed_verbs.txt doesn't list.
function reads_as_participle(word, participles, ed_verbs)
  if has_key(participles, word) then return true end
  return #word > 3 and ends_with(word, "ed") and not has_key(ed_verbs, word)
end

-- A project's own terms, from hunt_names' `terms=` file, none for "": a term
-- a line, its words joined by `_`, then after a `:` the element type of the
-- list it names. `route: Stop` says a `List(Stop)` is a route, and `two_opt`
-- alone is a name read as one word. Gives `{lists, words}`: each term's
-- element type ("" for none) and its words.
function project_terms(path)
  local terms = {lists = {}, words = {}}
  if path == "" then return terms end
  if not exists(path) then fail("hunt_names: terms=" .. path .. ": no such file") end
  for l in word_list_lines(path) do
    if l ~= "" then
      local parts = split(l, ":")
      local term = trim(parts[1])
      local element = #parts > 1 and trim(parts[2]) or ""
      local bad_element = element ~= "" and re_find(element, "^[A-Z][A-Za-z0-9]*$") == nil
      if #parts > 2 or re_find(term, "^[a-z][a-z0-9]*(_[a-z0-9]+)*$") == nil or bad_element or has_key(terms.lists, term) then fail("hunt_names: " .. path .. ": `" .. l .. "` is no new term, `word` or `word: Type`") end
      terms.lists[term] = element
      terms.words[term] = split(term, "_")
    end
  end
  return terms
end

-- `ws` with each run of words that spells a term joined into one word, the
-- longest term first: `two`, `opt`, `stops` gives `two_opt`, `stops`.
function joined_terms(ws, terms)
  local out = {}
  local k = 1
  while k <= #ws do
    local taken = 1
    for term in keys(terms.words) do
      local tw = terms.words[term]
      if #tw > taken and k + #tw - 1 <= #ws then
        local same = true
        for j = 1, #tw do
          if ws[k + j - 1] ~= tw[j] then same = false end
        end
        if same then taken = #tw end
      end
    end
    local run = {}
    for j = k, k + taken - 1 do push(run, ws[j]) end
    push(out, join(run, "_"))
    k = k + taken
  end
  return out
end

-- The word of a name that says what it is, by index in `ws`: the one before
-- the first preposition or word list_names.txt calls `after`, past the name's
-- first word (`trees_in_view` and `corners_ahead` give `trees` and `corners`),
-- else the last. Digits alone are no word (`corner_2`).
function head_word_at(ws, w)
  for k = 2, #ws do
    if has_key(w.prepositions, ws[k]) or get(w.list_names, ws[k], "") == "after" then return k - 1 end
  end
  local at = #ws
  while at > 1 and re_find(ws[at], "^[0-9]+$") ~= nil do at = at - 1 end
  return at
end

-- Whether a word reads as a plural. An `s` doesn't make one in `class`, in a
-- word list_names.txt calls `one` (`axis`), or after letters that are no word
-- (`pts`); after one letter it does (`xs`).
function reads_as_plural(word, w)
  if get(w.list_names, word, "") == "one" then return false end
  if not ends_with(word, "s") or ends_with(word, "ss") then return false end
  local stem = sub(word, 1, #word - 1)
  return #stem == 1 or re_find(stem, "[aeiouy]") ~= nil
end

function plural_of(word)
  if ends_with(word, "y") and re_find(word, "[aeiou]y$") == nil then return sub(word, 1, #word - 1) .. "ies" end
  if re_find(word, "(s|x|z|ch|sh)$") ~= nil then return word .. "es" end
  return word .. "s"
end

-- The plural of what a list of `element` holds, for a name to say it, or ""
-- when the element has no word of its own: a type variable, a number, text.
function held_plural(element, w)
  local held = element_word(element)
  if held == "" or re_find(element, "^[A-Z]") == nil or has_key(w.plain, element) then return "" end
  return plural_of(held)
end

-- The names `singular_list` offers for `bare`, whose head word is at `at` in
-- `ws`: the plural of what the list holds put after the head, as in
-- `herd_cows`, or the head's own plural when the element is that word, a
-- number or text; else the name with `_list`.
function honest_list_names(bare, ws, at, element, w)
  local held = held_plural(element, w)
  local says_what_it_holds = held ~= "" and element_word(element) ~= ws[at]
  local plural_words = {}
  for k = 1, #ws do
    if k ~= at then
      push(plural_words, ws[k])
    elseif says_what_it_holds then
      push(plural_words, ws[k])
      push(plural_words, held)
    else
      push(plural_words, plural_of(ws[k]))
    end
  end
  return "`" .. join(plural_words, "_") .. "`, or `" .. bare .. "_list`"
end

-- What a name whose type says many says of one, `{check, why}`, or nil:
-- hunt_names' `singular_list`, and its `phrase_name` for a list that is no
-- function and starts with a preposition. `subject` is `{name, kind,
-- is_function, first, gives}`, `kind` being what the finding calls it.
function list_name_finding(subject, w)
  local element = list_element(subject.gives)
  if element == nil or element == "U8" then return nil end
  local bare = ends_with(subject.name, "!") and sub(subject.name, 1, #subject.name - 1) or subject.name
  if #bare < 2 or get(w.taken, bare, "") == "cardinal" or get(w.list_names, bare, "") == "accumulator" then return nil end
  local ws = joined_terms(split(bare, "_"), w.terms)
  local says = subject.is_function and "gives" or "holds"
  local opening = "the " .. subject.kind .. " `" .. subject.name .. "` " .. says .. " `" .. subject.gives .. "`"
  local at = head_word_at(ws, w)
  local head = ws[at]
  if head == "list" or reads_as_plural(head, w) then return nil end
  local term_element = get(w.terms.lists, head)
  if term_element ~= nil and term_element ~= "" and last_part(re_find(element, "^[A-Za-z0-9_.]*").text) == term_element then return nil end
  -- A term alone names an act, as a verb does (`two_opt`).
  if term_element == "" and subject.is_function and #ws == 1 then return nil end
  local starts_with_act = subject.is_function and has_key(w.verbs, ws[1]) and get(w.list_names, ws[1], "") ~= "one"
  -- A function that gives its first argument's type is a changed copy,
  -- whatever its first word (`two_opt`, `coalesce`). Its object may be one
  -- element of the list (`set_run : List(Run), Run -> List(Run)`): the verb's
  -- object, not the list, is what its last word names.
  local is_changed_copy = subject.is_function and subject.first == subject.gives
  if is_changed_copy and #ws > 1 then return nil end
  if element_word(element) ~= head then
    if get(w.list_names, head, "") == "many" or reads_as_participle(head, w.participles, w.ed_verbs) then return nil end
    if is_changed_copy or (starts_with_act and #ws == 1) then return nil end
  end
  -- A list named from a preposition needs its noun, not a plural: a
  -- function so named is judged at its definition.
  if has_key(w.prepositions, ws[1]) and not subject.is_function then return {check = "phrase_name", why = opening .. " and starts with a preposition, `" .. ws[1] .. "`: bare, it hides what it holds; name the thing (`trees_in_view`, not `in_view`)"} end
  if get(w.list_names, head, "") == "adjective" then
    local held = held_plural(element, w)
    local example = held ~= "" and (" (`" .. head .. "_" .. held .. "`)") or ""
    return {check = "singular_list", why = opening .. " but the word that counts, `" .. head .. "`, is an adjective: the name has no noun; say what the list holds" .. example}
  end
  return {check = "singular_list", why = opening .. " but reads as one thing, `" .. head .. "`: " .. honest_list_names(bare, ws, at, element, w)}
end

-- ── what `phrase_name` reads of a type, for hunt_names ───────────────────

-- The first words `phrase_name` lets a constructor start with. They are the
-- ones constructors use in safari, roc-chat and roc-markdown: `Clock.at_step`,
-- `Dm.between`, `SignedIn.by_session`, `MdText.for_input`, `Name.of_strict`,
-- `Directory.with_founder`. `from` has a wider rule of its own,
-- `is_from_conversion`.
const CONSTRUCTOR_WORDS = {at = true, between = true, by = true, ["for"] = true, of = true, with = true}
const CONVERSION_WORDS = {into = true, to = true}
const CHANGED_COPY_WORDS = {with = true, without = true}

-- Whether `type_text` names the module `def` is in, a type declared in it, or
-- the type `def` is a member of. Type arguments don't count:
-- `Bike.Motion(others)` is `Bike.Motion`. A type declared in the file is its
-- own written bare too, as a member of the module's type names one declared
-- beside it (`Budget` in `MdText := [].{ Budget : ... }`). `facts` is the
-- tables `file_definitions` fills.
function is_own_type(def, type_text, facts)
  local head = re_find(type_text, "^[A-Za-z0-9_.]+")
  if head == nil then return false end
  local parts = split(head.text, ".")
  local module = module_name(def.path)
  if #parts == 1 and has_key(facts.type_names, def.path .. "|" .. parts[1]) then return true end
  return parts[1] == module or parts[1] == def.owner or parts[#parts] == def.owner
end

-- Whether `type_text` names its module's own type anywhere in it. Only a
-- capital starts a type, so a field that shares a file's name is no mention.
function mentions_own_type(def, type_text, facts)
  for found in re_find_all(type_text, "\\b[A-Z][A-Za-z0-9_.]*") do
    if is_own_type(def, found.text, facts) then return true end
  end
  return false
end

-- Whether the file at `path` declares one type, `[].{ ... }`, which holds the
-- module's functions and has no values of its own.
function has_no_type_of_its_own(path, facts)
  local declared = get(facts.type_kinds, path, {})
  return #declared == 1 and declared[1]
end

-- Whether a function named `ws`, whose first word is `from`, reads as a
-- conversion: `phrase_name` in hunt_names' header.
function is_from_conversion(def, ws, signature, facts, prepositions)
  if mentions_own_type(def, signature.first, facts) or mentions_own_type(def, success_type(signature.result), facts) then return true end
  return signature.known and has_no_type_of_its_own(def.path, facts) and #ws > 1 and not has_key(prepositions, ws[2])
end

-- Whether a function named `ws`, whose first word is a preposition, reads as a
-- constructor, a conversion or a changed copy: `phrase_name` in hunt_names'
-- header. `signature` is `{first, result, known}` as hunt_names reads it.
function reads_as_maker(def, ws, signature, facts, prepositions)
  local word = ws[1]
  if has_key(CONVERSION_WORDS, word) then return true end
  if has_key(CHANGED_COPY_WORDS, word) and signature.result == signature.first then return true end
  if word == "from" then return is_from_conversion(def, ws, signature, facts, prepositions) end
  return has_key(CONSTRUCTOR_WORDS, word) and is_own_type(def, success_type(signature.result), facts)
end

-- ── what hunt_names reads of each definition ─────────────────────────────

-- hunt_names judges each top-level and module-member definition from the
-- record these read out of a file. `facts` is the tables the read fills for
-- the checks judged over the whole tree: `keywords`, each file's `#
-- keywords:` words by path; `unions`, each type declaration's tag union by
-- the type's name; `bool_aliases`, the names of aliases of `Bool`;
-- `type_kinds`, each type a file declares, by path, as whether it is
-- `[].{ ... }`, an empty union with members; `type_names`, each type name a
-- file declares as a set of `path|Name`; and `names`, each type and record
-- field name `container` checks, `{path, line, name, words, is_field, doc,
-- ...}`, `doc` the comment lines above its declaration, lowercased.

-- The keywords a file declares in a comment line `# keywords: for, on`,
-- added to `facts.keywords`.
function note_declared_keywords(path, src, facts)
  for l in src do
    local found = re_find(trim(l), "^# keywords: (.*)$")
    if found ~= nil then
      for w in split(found.groups[1], ",") do
        if trim(w) ~= "" then push_at(facts.keywords, path, lower(trim(w))) end
      end
    end
  end
  return nil
end

-- Notes what the type declaration at `i` declares: its tag union in
-- `facts.unions`, its kind in `facts.type_kinds`, its name in `facts.names`,
-- and in `facts.bool_aliases` when it is an alias of `Bool`, under its bare
-- name and, for a module type's member, `Owner.Name` as the checker writes
-- it.
function note_type_declaration(path, src, tree, i, facts)
  local kids = children(tree, i)
  local declared = #kids > 0 and attribute(tree, kids[1], "name") or ""
  if declared == "" then return nil end
  local line = tostring(tree[i].line)
  local is_union = #kids > 1 and tree[kids[2]].kind == "ty-tag-union"
  if is_union then facts.unions[declared] = union_shape(tree, kids[2]) end
  push_at(facts.type_kinds, path, is_union and #facts.unions[declared].names == 0 and tree[kids[#kids]].kind == "associated")
  facts.type_names[path .. "|" .. declared] = true
  push(facts.names, {path = path, line = line, name = declared, words = name_words(declared), is_field = false, doc = doc_above(src, tree[i].line)})
  if #kids > 1 and tree[kids[2]].kind == "ty" and attribute(tree, kids[2], "name") == "Bool" then
    facts.bool_aliases[declared] = true
    local parent = tree[i].parent
    if parent > 0 and tree[parent].kind == "associated" and tree[parent].parent > 0 then
      local owner_kids = children(tree, tree[parent].parent)
      local owner = #owner_kids > 0 and attribute(tree, owner_kids[1], "name") or ""
      if owner ~= "" then facts.bool_aliases[owner .. "." .. declared] = true end
    end
  end
  return nil
end

-- Whether a `##` doc stands directly above line `line` of `src`: the
-- answer a definition gives `world_verb`.
function has_doc_above(src, line)
  return line > 1 and starts_with(trim(src[line - 1]), "##")
end

-- The top-level annotation at `i`, as a definition record, or nil when it
-- is only a `where` clause. `whole` is its type rendered, and `result` the
-- type it returns. A function's record also has `arity` and `first` (its
-- first argument's type), and an effect's has `types`, the type names its
-- annotation mentions, and `args`, each argument's `argument_shape`.
-- `callback` says it takes an effectful function, an argument whose source
-- holds `=>`.
function annotation_definition(path, src, tree, i)
  local def = {path = path, line = tostring(tree[i].line), name = attribute(tree, i, "name"), owner = owner_of(tree, i), annotation = true, fn = false, callback = false, paired = false}
  local kids = children(tree, i)
  if #kids == 0 or tree[kids[1]].kind == "where" then return nil end
  def.whole = render_type(tree, kids[1])
  def.result = def.whole
  if tree[kids[1]].kind == "ty-fn" then
    local parts = children(tree, kids[1])
    local is_effect = ends_with(def.name, "!")
    def.fn = true
    def.arity = #parts - 1
    def.result = render_type(tree, parts[#parts])
    def.first = #parts > 1 and render_type(tree, parts[1]) or ""
    def.argument_types = {}
    if is_effect then
      def.types = mentioned_type_names(tree, kids[1], {})
      def.args = {}
    end
    for a in take(parts, #parts - 1) do
      push(def.argument_types, render_type(tree, a))
      if contains(span_text(src, tree, a), "=>") then def.callback = true end
      if is_effect then push(def.args, argument_shape(tree, a)) end
    end
  end
  return def
end

-- The top-level definition `name = ...` at `i`, as a definition record, or
-- nil when its pattern is not a plain name. `lambda` says its value is a
-- lambda, `callback` that a lambda argument's name ends in `!`, `recurses`
-- (for a name ending in a word of `recursion_suffixes`) that it calls
-- itself, `typed` is the checker's type when there is one, and `parameters`
-- holds `{name, line, typed}` for each lambda argument, `name` "" for one
-- that is a pattern rather than a plain name. `pattern_types` is the
-- checker's type of each plain-name pattern, by its node's index as text.
function value_definition(path, tree, i, pattern_types, recursion_suffixes)
  local kids = children(tree, i)
  if #kids == 0 or tree[kids[1]].kind ~= "p-ident" then return nil end
  local def = {path = path, line = tostring(tree[i].line), name = attribute(tree, kids[1], "raw"), owner = owner_of(tree, i), annotation = false, fn = false, callback = false, paired = false}
  if #kids > 1 and tree[kids[2]].kind == "e-lambda" then
    def.lambda = true
    def.parameters = {}
    for part in children(tree, kids[2]) do
      if tree[part].kind == "args" then
        for a in children(tree, part) do
          if ends_with(attribute(tree, a, "raw"), "!") then def.callback = true end
          local parameter = {name = tree[a].kind == "p-ident" and attribute(tree, a, "raw") or "", line = tostring(tree[a].line)}
          if parameter.name ~= "" and has_key(pattern_types, tostring(a)) then parameter.typed = pattern_types[tostring(a)] end
          push(def.parameters, parameter)
        end
      end
    end
  end
  local ws = split(ends_with(def.name, "!") and sub(def.name, 1, #def.name - 1) or def.name, "_")
  if #ws > 1 and has_key(recursion_suffixes, ws[#ws]) then def.recurses = calls_itself(tree, i, def.name) end
  if has_key(pattern_types, tostring(kids[1])) then def.typed = pattern_types[tostring(kids[1])] end
  return def
end

-- Whether the definition record `def`, read at `i`, is a top-level name
-- that its file's header dictates, one of `dictated`.
function is_dictated(tree, i, def, dictated)
  return has_key(dictated, def.name) and owner_of(tree, i) == ""
end

-- Every top-level and module-member annotation and definition in the
-- parsed file `f`, whose source lines are `src`, as definition records
-- `{path, line, name, annotation, fn, callback, paired, ...}`, leaving out
-- the names its header dictates, `known.dictated`. A definition whose
-- annotation is just above it is `paired`, and the annotation then gets
-- `has_def`, the definition's `typed` and its `callback`. `known` also
-- holds `pattern_types` and `recursion_suffixes`, as `value_definition`
-- takes them. Along the way this fills `facts`.
function file_definitions(f, src, known, facts)
  local definitions = {}
  local path = f.path
  local tree = f.nodes
  note_declared_keywords(path, src, facts)
  -- Each node is outer when it and every ancestor sit in OUTER_KINDS, and
  -- its `declaration_line` is its line when it is an outer annotation or
  -- type declaration, else "". A parent comes before its children.
  local outer = {}
  local declaration_line = {}
  -- The definition record of each annotation, by the node's index.
  local annotation_records = {}
  for i = 1, #tree do
    local node = tree[i]
    local parent = node.parent
    push(outer, parent == 0 or (outer[parent] and has_key(OUTER_KINDS, tree[parent].kind)))
    local kind = node.kind
    push(declaration_line, (outer[i] and (kind == "s-type-anno" or kind == "s-type-decl")) and tostring(node.line) or "")
    if outer[i] and kind == "s-type-decl" then note_type_declaration(path, src, tree, i, facts) end
    if kind == "anno-record-field" then
      local at = field_declaration_line(tree, declaration_line, i)
      local field = attribute(tree, i, "name")
      if at ~= "" and field ~= "" then
        local named = {path = path, line = tostring(node.line), name = field, words = name_words(field), is_field = true, doc = doc_above(src, tonumber(at))}
        local siblings = {}
        for k in children(tree, node.parent) do siblings[attribute(tree, k, "name")] = true end
        named.letter_of_set = is_letter_of_set(field, siblings)
        local field_type = children(tree, i)[1]
        named.gives = render_type(tree, field_type)
        named.is_function = tree[field_type].kind == "ty-fn"
        named.first = ""
        if named.is_function then
          local parts = children(tree, field_type)
          named.gives = render_type(tree, parts[#parts])
          named.first = #parts > 1 and render_type(tree, parts[1]) or ""
        end
        push(facts.names, named)
      end
    end
    if outer[i] and kind == "s-type-anno" then
      local def = annotation_definition(path, src, tree, i)
      if def ~= nil then def.has_doc = has_doc_above(src, tree[i].line) end
      if def ~= nil and not is_dictated(tree, i, def, known.dictated) then
        push(definitions, def)
        annotation_records[tostring(i)] = def
      end
    end
    if outer[i] and kind == "s-decl" then
      local def = value_definition(path, tree, i, known.pattern_types, known.recursion_suffixes)
      if def ~= nil then def.has_doc = has_doc_above(src, tree[i].line) end
      if def ~= nil and not is_dictated(tree, i, def, known.dictated) then
        local above = get(annotation_records, tostring(previous_sibling(tree, i)))
        if above ~= nil and above.name == def.name then
          def.paired = true
          above.has_def = true
          if has_key(def, "typed") then above.typed = def.typed end
          if def.callback then above.callback = true end
          above.parameters = get(def, "parameters", {})
        end
        push(definitions, def)
      end
    end
  end
  return definitions
end
