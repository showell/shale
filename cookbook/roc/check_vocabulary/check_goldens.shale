-- cookbook/roc/check_vocabulary/check_goldens.shale: check_vocabulary (the Roc
-- script beside this, check_vocabulary.roc, through its launcher
-- cookbook/roc/check_vocabulary.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/roc/check_vocabulary/check_goldens.shale self_test=1
--   shale cookbook/roc/check_vocabulary/check_goldens.shale write=1
--
-- The cases are each plant row of the recipe's self-test (its glob and its
-- arguments), the plants all at once with each words file, the edges plant
-- (a name's and a comment's words split at their edges) with each words
-- file that parses, a glob that finds nothing, a glob Shale refuses, and
-- `self_test=1`. The goldens were written from the Shale original's output
-- on them, and the port matched it on other repositories' trees too
-- (roc-chat and roc-apps' safari with their own words files, roc-chat,
-- roc-apps and roc-screensaver with a words file that retires common words),
-- which are left out because their code moves. Only a value the recipe reads
-- no `arg` of is left out of the original's cases, since run.shale names it
-- in other words. `write=1` writes the goldens again from the launcher, for
-- a change meant to move them: `git diff` shows what moved.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time, the
-- platform's lock), the `called from` lines, and the launchers' own stops
-- (run.shale's `run: ...`, this recipe's launcher's). A stop's line is held
-- by its words, not its place (`── stop: <words>`), a place in a prelude
-- included.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/roc/check_vocabulary.shale"
const GOLDENS = "cookbook/roc/check_vocabulary/goldens.txt"
const AT = "cookbook:roc/plants/check_vocabulary/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- The words files below AT that parse, and those that stop the run.
const GOOD_WORDS = {"words.txt", "words_edges.txt", "words_crlf.txt", "words_empty.txt"}
const BAD_WORDS = {"no_such.txt", "words_malformed.txt", "words_twice.txt", "words_both.txt", "words_both_order.txt", "words_upper.txt", "words_twice_line.txt", "words_space_comma.txt"}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local place = "^── stopped at (the [A-Za-z]+ prelude|the prelude|[^ ]+)(:[0-9]+:[0-9]+)?( \\(in `[^`]*`\\))?: "
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), place, "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: check_vocabulary: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- A case: its name, the glob below AT, and the words file below AT ("" for
-- none).
function case_of(glob, words)
  local values = {"glob=" .. AT .. glob}
  local name = glob
  if words ~= "" then
    push(values, "words=" .. AT .. words)
    name = name .. " words=" .. words
  end
  return {name = name, values = values}
end

-- Each case, `{name, values}`: the values on the launcher's stdin, one a line.
function cases()
  local c = {}
  for plant in {"names.roc", "names_unseen.roc", "comments.roc", "clean.roc", "broken/*.roc"} do push(c, case_of(plant, "words.txt")) end
  push(c, case_of("clean.roc", ""))
  for words in BAD_WORDS do push(c, case_of("clean.roc", words)) end
  for words in GOOD_WORDS do
    push(c, case_of("*.roc", words))
    push(c, case_of("edges.roc", words))
  end
  push(c, case_of("**/*.roc", "words.txt"))
  push(c, case_of("nothing_here/*.roc", "words.txt"))
  push(c, {name = "a glob Shale refuses", values = {"glob=/etc/*.roc", "words=" .. AT .. "words.txt"}})
  push(c, {name = "a glob Shale refuses, no words", values = {"glob=/etc/*.roc"}})
  push(c, {name = "a bad words file and a glob Shale refuses", values = {"glob=/etc/*.roc", "words=" .. AT .. "words_malformed.txt"}})
  push(c, {name = "self_test=1", values = {"self_test=1"}})
  return c
end

-- One case's run, as its golden section: `=== <name> (exit N)` and its body.
function section(c)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = join(c.values, "\n") .. "\n", timeout_ms = 900000, whole = 8000000})
  local ls = {"=== " .. c.name .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for c in cases() do push(all, section(c).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for c in cases() do
    n = n + 1
    local got = section(c)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      local shown = 0
      print("FAIL " .. head)
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. c.name .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
