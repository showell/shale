-- **THREE OR MORE, ONE A LINE** (metal-vmm QUEUE 296): any list, record,
-- tuple, call's arguments, tag payload or lambda's arguments holding three
-- or more items on one line is a finding, `path:line: stack: ...`, and so
-- is a line wider than `width` (100) with nothing to stack, `long: ...`.
--
--   cd <repo> && shale <shale>/cookbook/roc/stack.shale glob=chat/**/*.roc
--   cd <repo> && shale <shale>/cookbook/roc/stack.shale glob=chat/**/*.roc write=1
--   shale cookbook:roc/stack.shale self_test=1
--
-- **THE REWRITE** (`write=1`) gives each such group a trailing comma after
-- its last item, outermost first, and runs `roc fmt` on the files it
-- changed, which lays a group with a trailing comma out one item a line;
-- then again, until a pass changes nothing. A long line with no group of
-- three gets its widest group of two, as `roc_commas.shale` does. A second
-- run changes nothing. **STRINGS AND COMMENTS ARE NEVER TOUCHED**: the
-- scan steps over `"..."` (escapes and all), `'x'`, a `\\` line and a `#`
-- comment, so a comma or bracket in one is no item. A `where` clause's
-- items are its method constraints (`k.is_eq : k, k -> Bool` is one), and
-- a record or list pattern's rest (`..`) is no item. What it can't reach is
-- listed: a long line with no group, and **A FUNCTION TYPE'S THREE OR MORE
-- ARGUMENTS**, bare (`three : U8, U8, U8 -> U8`) or in parentheses
-- (`apply : (U8, U8, U8 -> U8) -> U8`), a finding of its own that no comma
-- stacks: Roc refuses a trailing one there (`U8, U8, U8, -> U8` and
-- `(A, B => C,)` do not parse), so a function type's arguments are never
-- given one, on a long line either.
--
-- **ROC IS THE TREE'S OWN PIN**: `write=1` runs `tools:roc-<pin>/roc`,
-- the pin read from the `roc-version` file where the run starts (the
-- repository's root), and stops before any change with no `roc-version`
-- there: `roc fmt`'s layout moves between nightlies, so a tree is laid out
-- only by the Roc it is built with, never by whichever `roc` is on PATH.
--
-- `self_test=1` reads `cookbook/roc/plants/stack/`: each plant named for
-- what it holds must give a finding of its kind, and a `clean*.roc` none.
-- Then it copies the plants to `scratch:stack/` and rewrites them there
-- with `SELF_TEST_PIN`'s Roc: the rewrite must end, a second one change
-- nothing, and every file still parse (`roc fmt` takes them all).
--
-- budget: steps=900000000 arena_bytes=2000000000

const SELF = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/stack"
const SCRATCH = "scratch:stack"
const GLOB = SELF and (PLANTS .. "/*.roc") or arg("glob", "**/*.roc")
const WIDTH = arg("width", 100)
const WRITE = arg("write", "") == "1"
const SELF_TEST_PIN = "nightly-2026-10-30-0602c5f"
const PASSES = 12
const OPENERS = {["("] = ")", ["{"] = "}", ["["] = "]"}
const CLOSERS = {[")"] = true, ["}"] = true, ["]"] = true}

-- A line's width, a tab four columns.
function width(l)
  return #l + 3 * (#split(l, "\t") - 1)
end

-- The last character before `i` that is not a space, or "".
function before(l, i)
  local j = i - 1
  while j > 0 and sub(l, j, j) == " " do j = j - 1 end
  if j == 0 then return "" end
  return sub(l, j, j)
end

-- One group closed: its items, by the commas at its depth. A last item
-- that is a rest pattern (`{ a, b, .. }`, `[x, .. as more]`) is no item:
-- it names nothing that would stack. Parentheses holding an arrow at
-- their own depth are a function type (`(A, B => C)`), whose arguments
-- take no trailing comma: `fn_type`.
function close_group(l, open, close, commas, last_comma, depth, arrow)
  local inner = trim(sub(l, open + 1, close - 1))
  local trailing = ends_with(inner, ",")
  local items = commas + 1
  if trailing then items = commas end
  if inner == "" then items = 0 end
  local last = trim(sub(l, last_comma + 1, close - 1))
  if not trailing and commas > 0 and (last == ".." or starts_with(last, ".. as ")) then items = items - 1 end
  return {open = open, close = close, items = items, trailing = trailing, depth = depth, fn_type = arrow and sub(l, open, open) == "("}
end

-- A method constraint's start (`k.is_eq :`), after a comma in a `where`
-- clause's brackets: only these commas part its items, the rest are its
-- constraints' own (`k.is_eq : k, k -> Bool` is one item).
const CONSTRAINT = "^ *[a-z_][A-Za-z0-9_]*\\.[a-z_][A-Za-z0-9_]*!? *:"

-- **THE GROUPS THAT OPEN AND CLOSE ON `l`**, each `{open, close, items,
-- trailing, depth, fn_type}`: brackets and a lambda's `|...|`, items counted by the
-- commas at the group's own depth, and in a `where [...]` by its method
-- constraints. Strings, characters and the comment are stepped over. A
-- group that runs onto another line is no group here.
function groups(l)
  local out = {}
  if starts_with(trim(l), "\\\\") then return out end
  -- The open groups, innermost last: where each opened, what closes it,
  -- its commas so far and the last one's place, whether it is a `where`
  -- clause's brackets, and whether a ` ->` or ` =>` is at its own depth
  -- (an arrow call, `x->f()`, has no space before it).
  local open = {}
  local i = 1
  local n = #l
  while i <= n do
    local c = sub(l, i, i)
    if c == "\"" then
      i = i + 1
      while i <= n and sub(l, i, i) ~= "\"" do
        if sub(l, i, i) == "\\" then i = i + 1 end
        i = i + 1
      end
    elseif c == "'" then
      i = i + 1
      while i <= n and sub(l, i, i) ~= "'" do
        if sub(l, i, i) == "\\" then i = i + 1 end
        i = i + 1
      end
    elseif c == "#" then
      break
    elseif has_key(OPENERS, c) then
      push(open, {at = i, kind = OPENERS[c], commas = 0, last = i, arrow = false, where = c == "[" and (trim(sub(l, 1, i - 1)) == "where" or ends_with(trim(sub(l, 1, i - 1)), " where"))})
    elseif (c == "-" or c == "=") and sub(l, i + 1, i + 1) == ">" and sub(l, i - 1, i - 1) == " " and #open > 0 then
      open[#open].arrow = true
      i = i + 1
    elseif c == "|" and sub(l, i + 1, i + 1) ~= ">" and sub(l, i + 1, i + 1) ~= "|" and sub(l, i - 1, i - 1) ~= "|" then
      if #open > 0 and open[#open].kind == "|" then
        local g = open[#open]
        push(out, close_group(l, g.at, i, g.commas, g.last, #open - 1, g.arrow))
        open = take(open, #open - 1)
      else
        local b = before(l, i)
        if b == "" or b == "=" or b == "(" or b == "," or b == "[" or b == "{" or b == ":" then
          push(open, {at = i, kind = "|", commas = 0, last = i, arrow = false, where = false})
        end
      end
    elseif has_key(CLOSERS, c) then
      -- Pop to the opener this closes; one left open by a `|` that was
      -- no lambda is dropped with it.
      while #open > 0 and open[#open].kind ~= c do open = take(open, #open - 1) end
      if #open > 0 then
        local g = open[#open]
        push(out, close_group(l, g.at, i, g.commas, g.last, #open - 1, g.arrow))
        open = take(open, #open - 1)
      end
    elseif c == "," and #open > 0 then
      local g = open[#open]
      if not g.where or re_find(sub(l, i + 1), CONSTRAINT) ~= nil then
        g.commas = g.commas + 1
        g.last = i
      end
    end
    i = i + 1
  end
  return out
end

-- The group to stack on `l`: the outermost (then widest) of three or more
-- items with no trailing comma; else, on a line over WIDTH, the widest of
-- two or more. Never a function type's arguments. nil when there is none.
function pick(l)
  local best = nil
  for g in groups(l) do
    if g.items >= 3 and not g.trailing and not g.fn_type then
      if best == nil or g.depth < best.depth or (g.depth == best.depth and g.close - g.open > best.close - best.open) then best = g end
    end
  end
  if best ~= nil or width(l) <= WIDTH then return best end
  for g in groups(l) do
    if g.items >= 2 and not g.trailing and not g.fn_type then
      if best == nil or g.close - g.open > best.close - best.open then best = g end
    end
  end
  return best
end

-- `l` with a comma after the last item of `g`, before the spaces that
-- `roc fmt` puts there.
function with_comma(l, g)
  local j = g.close - 1
  while j > g.open and sub(l, j, j) == " " do j = j - 1 end
  return sub(l, 1, j) .. "," .. sub(l, j + 1)
end

function snip(l, g)
  local s = sub(l, g.open, g.close)
  if #s > 60 then s = sub(s, 1, 57) .. "..." end
  return s
end

-- The bare arguments of an annotation on `l` (`name : A, B, C -> R`),
-- counted by the commas outside any bracket before the first arrow outside
-- one: `{items, what}`, or nil when `l` is no annotation of a function.
function bare_args(l)
  local m = re_find(trim(l), "^[a-z_][A-Za-z0-9_]*!? : (.*)$")
  if m == nil then return nil end
  local ty = m.groups[1]
  local depth = 0
  local commas = 0
  for i = 1, #ty do
    local c = sub(ty, i, i)
    if has_key(OPENERS, c) then depth = depth + 1 end
    if has_key(CLOSERS, c) then depth = depth - 1 end
    if depth == 0 and c == "," then commas = commas + 1 end
    if depth == 0 and (sub(ty, i, i + 1) == "->" or sub(ty, i, i + 1) == "=>") then
      local what = trim(sub(ty, 1, i - 1))
      if #what > 60 then what = sub(what, 1, 57) .. "..." end
      return {items = commas + 1, what = what}
    end
  end
  return nil
end

-- Every finding in the files, `{path, line, kind, what}`.
function findings(files)
  local out = {}
  for p in files do
    local ls = split(read(p), "\n")
    for i = 1, #ls do
      local g = nil
      local fn_type = nil
      for h in groups(ls[i]) do
        if h.items >= 3 and not h.trailing and not h.fn_type and (g == nil or h.depth < g.depth) then g = h end
        if h.items >= 3 and h.fn_type and (fn_type == nil or h.depth < fn_type.depth) then fn_type = h end
      end
      local bare = bare_args(ls[i])
      if fn_type ~= nil and (bare == nil or bare.items < 3) then bare = {items = fn_type.items, what = snip(ls[i], fn_type)} end
      if g ~= nil then
        push(out, {path = p, line = i, kind = "stack", what = g.items .. " items in " .. snip(ls[i], g)})
      elseif bare ~= nil and bare.items >= 3 then
        push(out, {path = p, line = i, kind = "stack", what = bare.items .. " bare arguments in " .. bare.what .. ", which no comma stacks: take a record (roc-style.md, Name what travels together)"})
      elseif width(ls[i]) > WIDTH then
        local why = starts_with(trim(ls[i]), "#") and "a comment" or (pick(ls[i]) ~= nil and "a group of two to stack" or "nothing to stack")
        push(out, {path = p, line = i, kind = "long", what = width(ls[i]) .. " columns, " .. why})
      end
    end
  end
  return out
end

function roc_bin()
  local pin = SELF_TEST_PIN
  if not SELF then
    if not exists("roc-version") then fail("stack: no roc-version where the run starts: run it from the repository's root, whose roc-version pins its Roc") end
    pin = trim(read("roc-version"))
  end
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("stack: no " .. roc .. ": install Roc " .. pin .. " into ~/tools/roc-" .. pin .. "/ (roc-apps's toolchain release carries it)") end
  return real(roc)
end

-- `roc fmt` on `files`: the run's answer, its code not 0 for a file that
-- does not parse.
function fmt(files)
  local argv = {roc_bin(), "fmt"}
  for p in files do push(argv, real(p)) end
  return run(argv, {timeout_ms = 120000, tail = 20})
end

-- **THE REWRITE**, pass after pass until one changes nothing: the groups
-- given a trailing comma in the first pass.
function rewrite(files)
  local first = 0
  local pass = 1
  local changed = 1
  while changed > 0 and pass <= PASSES do
    changed = 0
    local touched = {}
    for p in files do
      local ls = split(read(p), "\n")
      local n = 0
      for i = 1, #ls do
        if not starts_with(trim(ls[i]), "#") then
          local g = pick(ls[i])
          if g ~= nil then
            ls[i] = with_comma(ls[i], g)
            n = n + 1
          end
        end
      end
      if n > 0 then
        replace(p, join(ls, "\n"))
        push(touched, p)
        changed = changed + n
      end
    end
    print("pass " .. pass .. ": " .. changed .. " groups given a trailing comma, in " .. #touched .. " files")
    if pass == 1 then first = changed end
    if #touched > 0 then
      local r = fmt(touched)
      if r.code ~= 0 then
        print(r.out)
        fail("roc fmt failed")
      end
    end
    pass = pass + 1
  end
  if changed > 0 then fail("still changing after " .. PASSES .. " passes") end
  return first
end

function self_test()
  local files = glob(GLOB)
  local seen = {}
  for f in findings(files) do
    local name = sub(f.path, #PLANTS + 2)
    seen[name] = (has_key(seen, name) and seen[name] or "") .. f.kind .. " "
  end
  local bad = 0
  for p in files do
    local name = sub(p, #PLANTS + 2)
    local want = starts_with(name, "long") and "long" or "stack"
    local got = has_key(seen, name) and seen[name] or ""
    local clean = starts_with(name, "clean")
    local ok = (clean and got == "") or (not clean and contains(got, want))
    print((ok and "ok   " or "FAIL ") .. name .. ": " .. (got == "" and "no finding" or got))
    if not ok then bad = bad + 1 end
  end
  if bad > 0 then fail(bad .. " plants wrong") end
  if is_dir(SCRATCH) then remove_tree(SCRATCH) end
  mkdir(SCRATCH)
  local copies = {}
  for p in files do
    local to = SCRATCH .. "/" .. sub(p, #PLANTS + 2)
    replace(to, read(p))
    push(copies, to)
  end
  rewrite(copies)
  local again = rewrite(copies)
  if again > 0 then fail("stack: a second rewrite gave " .. again .. " more trailing commas") end
  local r = fmt(copies)
  if r.code ~= 0 then
    print(r.out)
    fail("stack: a rewritten plant no longer parses")
  end
  print("PASS: every plant gives its finding, the clean ones none; the rewrite ends, a second changes nothing, and every plant parses")
end

if SELF then
  self_test()
elseif WRITE then
  roc_bin()
  local files = glob(GLOB)
  rewrite(files)
  local left = findings(files)
  for f in left do print(f.path .. ":" .. f.line .. ": " .. f.kind .. ": " .. f.what) end
  print(#left .. " left, each a line the rewrite can't reach")
else
  local files = glob(GLOB)
  local all = findings(files)
  local stack = 0
  for f in all do
    print(f.path .. ":" .. f.line .. ": " .. f.kind .. ": " .. f.what)
    if f.kind == "stack" then stack = stack + 1 end
  end
  print(#all .. " findings in " .. #files .. " files: " .. stack .. " to stack, " .. (#all - stack) .. " long")
end
