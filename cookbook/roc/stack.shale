-- This recipe finds groups in .roc files laid out against the stacking rule,
-- and with `write=1` lays them out by it. A group is a list, record, tuple,
-- call's arguments, tag payload or lambda's arguments. A group of three or
-- more items and six or more tokens stacks, one item a line. Any other group
-- sits on one line while that line fits `width`. The rule and what counts as
-- a token are in cookbook/roc/groups.shale.
--
--   cd <repo> && shale <shale>/cookbook/roc/stack.shale glob=chat/**/*.roc
--   cd <repo> && shale <shale>/cookbook/roc/stack.shale glob=chat/**/*.roc write=1
--   shale cookbook:roc/stack.shale self_test=1
--
-- The arguments:
--   glob   the files to check, `**/*.roc` by default;
--   skip   files the glob finds to leave out, by path, comma-separated, for
--          tables of data that read better side by side;
--   width  the widest a line may be, 100 by default, a tab counting four;
--   tokens the tokens from which a group stacks, 6 by default;
--   house  with `house=0`, leave out every finding here, as the stacking rule
--          is our house style (cookbook/roc/house.shale);
--   write  with `write=1`, rewrite the files (see below).
--
-- A group on one line that should stack is a finding, `path:line: stack: ...`,
-- left to right. A stacked group that should sit on one line is a finding,
-- `path:line: unstack: ...`, at the line it opens on. A line wider than `width`
-- with nothing to stack by the rule is a finding too, of one of two kinds. It
-- is `wide string` when
-- it would fit `width` if the text of each string literal on it counted as
-- empty, because Roc has no short way to split a string. Otherwise it is
-- `long`. Roc's own parser says which columns are a string's text, so the
-- code in an interpolation (`"${...}"`) counts, a comment counts, and so does
-- a string in an `import` or the file's header, which has no such node. The
-- output is the counts, the findings, and the counts again
-- (cookbook/roc/findings.shale). A file with a line wider than `width` that
-- roc-ast refuses keeps that line as `long`, and the run fails, naming it, as
-- it does for an app's or platform's file that roc-ast refuses.
--
-- A stacked group stays stacked, with no finding, when its joined line would
-- be wider than `width`, or when it holds a comment, a `\\` string, a blank
-- line, a block's statements, or a group that stays stacked.
--
-- Some groups are not findings, or get special advice:
--   - A list or tuple whose items are all literals (numbers, plain strings,
--     characters, bare tags) is a table's row, like `[0, 0, 0]` or
--     `(0.0, 0.0, 1.5)`, and is read at a glance. It is no finding while
--     its line fits `width`. A call's arguments are never a row.
--   - A group of three or more `Bool`s or Bool literals is told that a flag
--     a caller passes should be a tag, as roc-style.md says, whatever its
--     tokens.
--   - When a function's annotation (`name : A, B, C -> R`) is a finding for
--     its arguments, the function's lambda arguments on the next line are
--     not reported again.
--   - The annotation of a name its file's header dictates is no finding for
--     its arguments, as the platform chose them: what an app's header
--     provides, and what a platform's header requires and provides
--     (cookbook/roc/headers.shale). Nor are that name's lambda arguments.
--   - The items of a `where` clause are its method constraints, so
--     `k.is_eq : k, k -> Bool` is one item, and a record or list pattern's
--     rest (`..`) is no item.
-- Strings, characters, `\\` multiline strings and `#` comments are skipped,
-- so a comma or bracket inside one is no item.
--
-- With `write=1`, the recipe gives each group that should stack a trailing
-- comma after its last item, outermost first, takes the trailing comma from
-- each group that should unstack, and runs `roc fmt` on the files it changed,
-- which stacks a group with a trailing comma and joins a group without one. On
-- a long line with no group to stack by the rule, the widest group of two or
-- more items gets the comma, as roc_commas.shale does. This repeats until a
-- pass changes nothing, so a second run changes nothing either. The recipe then
-- prints the findings left, which the rewrite can't reach: long lines, and
-- the arguments of a function type, bare (`three : U8, U8, U8 -> U8`) or in
-- parentheses (`(U8, U8, U8 -> U8)`), because Roc refuses a trailing comma
-- there.
--
-- `roc fmt`'s layout changes between Roc nightlies, so `write=1` runs the
-- Roc the tree is built with: `tools:roc-<pin>/roc`, the pin read from the
-- `roc-version` file in the directory the run starts in, normally the
-- repository's root. Without that file it stops before changing anything
-- (cookbook/roc/pinned.shale).
--
-- `self_test=1` checks the plants in `cookbook/roc/plants/stack/`. Each
-- plant must give a finding of the kind its name starts with (`long`,
-- `wide`, `unstack`, or else `stack`), a `long` plant no `wide string` and a
-- `wide` plant no `long`, and a `clean*.roc` plant none. A plant line ending
-- `# findings N` must give exactly N findings, and with `advice W` after
-- it each of them must contain the word W. Then the test copies the plants
-- to `scratch:stack/` and rewrites them there with the self-test's Roc:
-- the rewrite must end, a second rewrite must change nothing, every file must
-- still parse, and a plant with a `.want` file must come out as it.
--
-- budget: steps=900000000 arena_bytes=2000000000 output_bytes=4000000

const SELF_TEST = arg("self_test", "") == "1"
const PLANTS = "cookbook:roc/plants/stack"
const SCRATCH = "scratch:stack"
const GLOB = SELF_TEST and (PLANTS .. "/*.roc") or arg("glob", "**/*.roc")
const SKIP = arg("skip", "")
const WIDTH = arg("width", 100)
const WRITE = arg("write", "") == "1"

-- The files the glob finds, less the ones `skip` names. A name in `skip` that
-- the glob doesn't find stops the run, so a renamed file can't go unchecked.
function chosen_files()
  local found = glob(GLOB)
  if SKIP == "" then return found end
  local skipped = {}
  for name in split(SKIP, ",") do skipped[name] = false end
  local kept = {}
  for f in found do
    if has_key(skipped, f) then skipped[f] = true else push(kept, f) end
  end
  for name in keys(skipped) do
    if not skipped[name] then fail("stack: skip names " .. name .. ", which the glob doesn't find") end
  end
  return kept
end
use("cookbook:roc/pinned.shale")
use("cookbook:roc/findings.shale")
use("cookbook:roc/groups.shale")
use("cookbook:roc/parsed.shale")
use("cookbook:roc/headers.shale")
use("cookbook:roc/house.shale")
const TOKENS = arg("tokens", STACK_TOKENS)
const MAX_PASSES = 12
const STRING_TEXT = {["e-string-part"] = true, ["p-string-text"] = true}

-- Text cut to 60 characters for a finding line.
function shortened(s)
  if #s > 60 then return sub(s, 1, 57) .. "..." end
  return s
end

-- If line `l` is a function's annotation (`name : A, B, C -> R`), its
-- arguments before the first arrow, counted by the commas outside any
-- brackets: `{items, shown, text, name}`, where `shown` is `text`
-- shortened. nil when `l` annotates no function.
function annotation_arguments(l)
  local m = re_find(trim(l), "^[a-z_][A-Za-z0-9_]*!? : (.*)$")
  if m == nil then return nil end
  local type_text = m.groups[1]
  local depth = 0
  local commas = 0
  for i = 1, #type_text do
    local c = sub(type_text, i, i)
    if has_key(OPENERS, c) then depth = depth + 1 end
    if has_key(CLOSERS, c) then depth = depth - 1 end
    if depth == 0 and c == "," then commas = commas + 1 end
    if depth == 0 and (sub(type_text, i, i + 1) == "->" or sub(type_text, i, i + 1) == "=>") then
      local text = trim(sub(type_text, 1, i - 1))
      return {items = commas + 1, shown = shortened(text), text = text, name = split(trim(l), " :")[1]}
    end
  end
  return nil
end

-- Whether every comma-separated item of `text` is `Bool` or a Bool
-- literal, like `Bool, Bool, Bool` or `Bool.true, Bool.false, Bool.true`.
const FLAGS = {Bool = true, ["Bool.true"] = true, ["Bool.false"] = true, ["Bool.True"] = true, ["Bool.False"] = true}
function are_all_flags(text)
  for item in split(text, ",") do
    if not has_key(FLAGS, trim(item)) then return false end
  end
  return true
end

const FLAG_ADVICE = ": a flag a caller passes is a tag, not a Bool (roc-apps docs/roc-style.md)"

-- The finding for a function type's arguments, which can't take a
-- trailing comma. The advice is a record for values that travel together,
-- or a tag for a run of flags.
function function_type_finding(path, line, items, shown, text)
  local advice = are_all_flags(text) and FLAG_ADVICE or ": take a record (roc-apps docs/roc-style.md, Name what travels together)"
  return {path = path, line = line, kind = "stack", what = items .. " bare arguments in " .. shown .. ", which no comma stacks" .. advice}
end

-- Whether any line of the file at `p` is wider than WIDTH.
function has_wide_line(p)
  for l in lines(read(p)) do
    if line_width(l) > WIDTH then return true end
  end
  return false
end

-- The columns that strings' text takes up in `files`, by Roc's parser, as
-- `{columns, refused}`. `columns[path]` maps a line's number, as text, to
-- those columns. Only a file with a wide line is parsed, so a tree of short
-- lines never needs roc-ast. `refused` is parse_roc_files' list.
function string_columns_in(files)
  local wide_files = {}
  for p in files do
    if has_wide_line(p) then push(wide_files, p) end
  end
  local columns = {}
  if #wide_files == 0 then return {columns = columns, refused = {}} end
  local parsed = parse_roc_files(wide_files)
  for f in parsed.files do
    local ls = split(read(f.path), "\n")
    local by_line = {}
    for n in f.nodes do
      if has_key(STRING_TEXT, n.kind) then
        if n.line ~= n.end_line then fail("stack: " .. f.path .. ":" .. n.line .. ": a run of string text crosses a line") end
        incr(by_line, "" .. n.line, line_width(sub(ls[n.line], n.col, n.end_col - 1)))
      end
    end
    columns[f.path] = by_line
  end
  return {columns = columns, refused = parsed.refused}
end

-- The finding for line `i` of `p`, wider than WIDTH with nothing else found
-- on it. `string_columns` is the columns of strings' text on that file's
-- lines, by line number.
function wide_line_finding(p, i, l, string_columns)
  local width = line_width(l)
  local without_strings = width - get(string_columns, "" .. i, 0)
  if without_strings <= WIDTH then
    return {path = p, line = i, kind = "wide string", what = width .. " columns, " .. without_strings .. " without its strings"}
  end
  local why = starts_with(trim(l), "#") and "a comment" or (group_to_stack(l, TOKENS, WIDTH) ~= nil and "a group to stack" or "nothing to stack")
  return {path = p, line = i, kind = "long", what = width .. " columns, " .. why}
end

function concat_lists(a, b)
  local out = {}
  for x in a do push(out, x) end
  for x in b do push(out, x) end
  return out
end

-- The names the headers of `files` dictate, by path, as `{names, refused}`.
-- Only an app's or a platform's file is parsed, so a tree of modules needs no
-- roc-ast for this.
function dictated_names_in(files)
  local headed = {}
  for p in files do
    local word = header_word(read(p))
    if word == "app" or word == "platform" then push(headed, p) end
  end
  local names = {}
  if #headed == 0 then return {names = names, refused = {}} end
  local parsed = parse_roc_files(headed)
  for f in parsed.files do names[f.path] = header_names(f.nodes).dictated end
  return {names = names, refused = parsed.refused}
end

-- Every finding in `files`, as `{found, refused}`: `found` holds each as
-- `{path, line, kind, what}`, and `refused` the files roc-ast refused.
function findings_in(files)
  local out = {}
  local strings = string_columns_in(files)
  local dictated = dictated_names_in(files)
  for p in files do
    local ls = split(read(p), "\n")
    local string_columns = get(strings.columns, p, {})
    local dictated_here = get(dictated.names, p, {})
    -- The function whose annotation on the line before was a finding for
    -- its arguments, or "". Its lambda's arguments are not reported again.
    local annotated_fn = ""
    for i = 1, #ls do
      local found_on_line = 0
      local skip_lambda = annotated_fn ~= "" and starts_with(trim(ls[i]), annotated_fn .. " = |")
      annotated_fn = ""
      for g in sort(groups_on_line(ls[i]), "open") do
        local inner = sub(ls[i], g.open + 1, g.close - 1)
        if g.items >= 3 and g.fn_type then
          local arguments = split(split(inner, "->")[1], "=>")[1]
          push(out, function_type_finding(p, i, g.items, shortened(sub(ls[i], g.open, g.close)), arguments))
          found_on_line = found_on_line + 1
        elseif skip_lambda and sub(ls[i], g.open, g.open) == "|" then
          skip_lambda = false
        else
          local are_flags = g.items >= 3 and not g.trailing and are_all_flags(inner)
          if are_flags or should_stack(ls[i], g, TOKENS, WIDTH) then
            local advice = are_flags and FLAG_ADVICE or ""
            push(out, {path = p, line = i, kind = "stack", what = g.tokens .. " tokens in " .. shortened(sub(ls[i], g.open, g.close)) .. advice})
            found_on_line = found_on_line + 1
          end
        end
      end
      local annotation = annotation_arguments(ls[i])
      if annotation ~= nil and annotation.items >= 3 then
        annotated_fn = annotation.name
        if not has_key(dictated_here, annotation.name) then
          push(out, function_type_finding(p, i, annotation.items, annotation.shown, annotation.text))
          found_on_line = found_on_line + 1
        end
      end
      if found_on_line == 0 and line_width(ls[i]) > WIDTH then
        push(out, wide_line_finding(p, i, ls[i], string_columns))
      end
    end
    for g in groups_to_unstack(ls, TOKENS, WIDTH) do
      push(out, {path = p, line = g.line, kind = "unstack", what = g.tokens .. " tokens in " .. shortened(trim(group_on_one_line(ls, g)))})
    end
  end
  return {found = out, refused = unique(concat_lists(strings.refused, dictated.refused))}
end

-- Runs `roc fmt` on `files`. The result's code is not 0 when a file does
-- not parse.
function roc_fmt(files)
  local argv = {roc_bin("stack", SELF_TEST), "fmt"}
  for p in files do push(argv, real(p)) end
  return run(argv, {timeout_ms = 120000, tail = 20})
end

-- Rewrites `files` pass after pass until a pass changes nothing, and
-- returns how many groups the first pass changed. A pass takes the trailing
-- comma from each group that should unstack and gives one to each line's group
-- that should stack, and `roc fmt` lays out the result.
function rewrite_trailing_commas(files)
  local first_pass_count = 0
  local pass = 1
  local changed = 1
  while changed > 0 and pass <= MAX_PASSES do
    changed = 0
    local touched = {}
    for p in files do
      local ls = split(read(p), "\n")
      local unstacked = groups_to_unstack(ls, TOKENS, WIDTH)
      ls = without_trailing_commas(ls, unstacked)
      local n = #unstacked
      for i = 1, #ls do
        if not starts_with(trim(ls[i]), "#") then
          local g = group_to_stack(ls[i], TOKENS, WIDTH)
          if g ~= nil then
            ls[i] = with_trailing_comma(ls[i], g)
            n = n + 1
          end
        end
      end
      if n > 0 then
        replace(p, join(ls, "\n"))
        push(touched, p)
        changed = changed + n
      end
    end
    print("pass " .. pass .. ": " .. changed .. " groups rewritten, in " .. #touched .. " files")
    if pass == 1 then first_pass_count = changed end
    if #touched > 0 then
      local r = roc_fmt(touched)
      if r.code ~= 0 then
        print(r.out)
        fail("roc fmt failed")
      end
    end
    pass = pass + 1
  end
  if changed > 0 then fail("still changing after " .. MAX_PASSES .. " passes") end
  return first_pass_count
end

function self_test()
  local files = chosen_files()
  local kinds_by_plant = {}
  local count_by_line = {}
  local whats_by_line = {}
  local judged = findings_in(files)
  fail_if_refused("stack", judged.refused)
  for f in judged.found do
    local name = sub(f.path, #PLANTS + 2)
    kinds_by_plant[name] = get(kinds_by_plant, name, " ") .. f.kind .. " "
    incr(count_by_line, f.path .. ":" .. f.line)
    push_at(whats_by_line, f.path .. ":" .. f.line, f.what)
  end
  local bad = 0
  for p in files do
    local n = 0
    for l in lines(read(p)) do
      n = n + 1
      local mark = re_find(l, "# findings ([0-9]+)(?: advice ([a-z]+))?$")
      if mark ~= nil then
        local got = get(count_by_line, p .. ":" .. n, 0)
        local ok = got == tonumber(mark.groups[1])
        local word = get(mark.groups, 2, "")
        if word ~= nil and word ~= "" then
          for what in get(whats_by_line, p .. ":" .. n, {}) do
            if not contains(what, word) then ok = false end
          end
        end
        print((ok and "ok   " or "FAIL ") .. sub(p, #PLANTS + 2) .. ":" .. n .. ": " .. got .. " findings, want " .. mark.groups[1])
        if not ok then bad = bad + 1 end
      end
    end
  end
  for p in files do
    local name = sub(p, #PLANTS + 2)
    local is_long = starts_with(name, "long")
    local is_wide = starts_with(name, "wide")
    local want = is_long and "long" or (is_wide and "wide string" or (starts_with(name, "unstack") and "unstack" or "stack"))
    local got = get(kinds_by_plant, name, "")
    local clean = starts_with(name, "clean")
    local ok = (clean and got == "") or (not clean and contains(got, " " .. want .. " "))
    if is_long and contains(got, "wide string") then ok = false end
    if is_wide and contains(got, "long") then ok = false end
    print((ok and "ok   " or "FAIL ") .. name .. ": " .. (got == "" and "no finding" or got))
    if not ok then bad = bad + 1 end
  end
  if bad > 0 then fail(bad .. " plants wrong") end
  if is_dir(SCRATCH) then remove_tree(SCRATCH) end
  mkdir(SCRATCH)
  local copies = {}
  for p in files do
    local to = SCRATCH .. "/" .. sub(p, #PLANTS + 2)
    replace(to, read(p))
    push(copies, to)
  end
  rewrite_trailing_commas(copies)
  local again = rewrite_trailing_commas(copies)
  if again > 0 then fail("stack: a second rewrite changed " .. again .. " more groups") end
  local r = roc_fmt(copies)
  if r.code ~= 0 then
    print(r.out)
    fail("stack: a rewritten plant no longer parses")
  end
  for want in glob(PLANTS .. "/*.want") do
    local name = sub(basename(want), 1, #basename(want) - 5)
    local ok = read(SCRATCH .. "/" .. name .. ".roc") == read(want)
    print((ok and "ok   " or "FAIL ") .. name .. ".roc: comes out as its .want")
    if not ok then bad = bad + 1 end
  end
  if bad > 0 then fail(bad .. " plants came out wrong") end
  print("PASS: every plant gives its finding, the clean ones none; the rewrite ends, a second changes nothing, every plant parses and comes out as its .want")
end

function finding_line(f)
  return f.path .. ":" .. f.line .. ": " .. f.kind .. ": " .. f.what
end

if SELF_TEST then
  self_test()
elseif WRITE then
  refuse_house_rewrite("stack")
  -- Stop before any change if the tree's Roc is missing.
  roc_bin("stack", SELF_TEST)
  local files = chosen_files()
  rewrite_trailing_commas(files)
  local left = {}
  local judged = findings_in(files)
  for f in judged.found do push(left, finding_line(f)) end
  print_findings(#left .. " left, each a line the rewrite can't reach", left)
  fail_if_refused("stack", judged.refused)
else
  local files = chosen_files()
  local all = {}
  local count_by_kind = {}
  local judged = findings_in(files)
  for f in judged.found do
    if not is_left_out("stack", f.kind) then
      push(all, finding_line(f))
      incr(count_by_kind, f.kind)
    end
  end
  local counts = get(count_by_kind, "stack", 0) .. " to stack, " .. get(count_by_kind, "unstack", 0) .. " to unstack, " .. get(count_by_kind, "long", 0) .. " long, " .. get(count_by_kind, "wide string", 0) .. " wide string" .. house_note("stack")
  print_findings(#all .. " findings in " .. #files .. " files: " .. counts, all)
  fail_if_refused("stack", judged.refused)
end
