-- cookbook/roc/find_unclear_names/compare_with_original.shale: the Roc port of
-- find_unclear_names (find_unclear_names.roc, beside this) held to its Shale
-- original (cookbook/roc/find_unclear_names.shale), line for line and exit
-- code for exit code, on the same input. From the shale checkout's root:
--
--   shale cookbook/roc/find_unclear_names/compare_with_original.shale
--   shale cookbook/roc/find_unclear_names/compare_with_original.shale cases=trees opt=speed runs=3
--
-- The cases: `plants`, each row of the original's self-test (its glob and its
-- arguments) run by both; `self_test`, each one's own `self_test=1`; `trees`,
-- roc-chat's app, roc-markdown's package and roc-apps' Safari. `cases=` names
-- some (commas between), all three unset. `opt=speed` runs the port built
-- with Roc's `--opt=speed`; `runs=N` runs each case N times and says the
-- fastest wall time of each, and the port's program alone (the launcher's
-- `-- run` phase).
--
-- What is held: the exit codes, and the output with each runner's own lines
-- left out: Shale's `──` report lines (budgets, used, steps, time), the
-- `called from` lines, and the launcher's own stop. A stop's line is held
-- by its words, not its place (`── stopped at <place>: fail: <words>`), since
-- the two stop in different files.
-- budget: programs=400 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const PORT = "cookbook/roc/find_unclear_names/find_unclear_names.roc"
const ORIGINAL = "cookbook/roc/find_unclear_names.shale"
const AT = "cookbook:roc/plants/find_unclear_names/"
const CASES = arg("cases", "plants,self_test,trees")
const OPT = arg("opt", "dev")
const RUNS = arg("runs", 1)

-- The original's self-test rows, as `{glob, args}`.
const ROWS = {
  {glob = "pure_mutator.roc"},
  {glob = "quiet_pure_mutator.roc"},
  {glob = "terms.roc"},
  {glob = "terms.roc", args = "terms=" .. AT .. "terms.txt"},
  {glob = "terms.roc", args = "terms=" .. AT .. "no_such.txt"},
  {glob = "abbreviation.roc"},
  {glob = "quiet_abbreviation.roc"},
  {glob = "abbreviation.roc", args = "abbreviations=" .. AT .. "project_words.txt"},
  {glob = "short_words/*.roc"},
  {glob = "quiet_short_words/*.roc"},
  {glob = "short_words/*.roc", args = "accepted=" .. AT .. "project_terms.txt"},
  {glob = "quiet_short_words/*.roc", args = "accepted=" .. AT .. "project_terms.txt"},
  {glob = "quiet_short_words/*.roc", args = "accepted=" .. AT .. "no_reason.txt"},
  {glob = "quiet_abbreviation.roc", args = "abbreviations=" .. AT .. "no_such.txt"},
  {glob = "long_abbreviations/*.roc"},
  {glob = "long_abbreviations/*.roc", args = "accepted=" .. AT .. "project_args.txt"},
  {glob = "quiet_long_abbreviations/*.roc"},
  {glob = "common_words/*.roc"},
  {glob = "quiet_common_words/*.roc"},
  {glob = "tags.roc"},
  {glob = "quiet_tags.roc"},
  {glob = "module_doc/*.roc"},
  {glob = "quiet_module_doc/*.roc"},
  {glob = "module_doc_private/*.roc"},
  {glob = "broken/*.roc"},
  {glob = "tags.roc", args = "house=0"},
}

const TREES = {
  {name = "roc-chat app", glob = "repos:roc-chat/app/**/*.roc"},
  {name = "roc-markdown package", glob = "repos:roc-markdown/package/**/*.roc"},
  {name = "roc-apps safari", glob = "repos:roc-apps/canvas_apps/safari/**/*.roc"},
  {name = "roc-chat app, house=0", glob = "repos:roc-chat/app/**/*.roc", args = "house=0"},
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at [^ ]+( \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- The fastest of RUNS runs of `argv`, with the program's own time when the
-- launcher says it (`-- run N ms`).
function fastest(argv, values)
  local best = nil
  for k = 1, RUNS do
    local r = run(argv, {stdin = values, timeout_ms = 900000, whole = 8000000})
    local program = re_find(r.out, "\n-- run ([0-9]+) ms")
    r.program_ms = program == nil and -1 or parse_int(program.group)
    if best == nil or r.ms < best.ms then best = r end
  end
  return best
end

-- Both runs of one case, held to each other: a line of verdict, and the
-- differences under it (the first five).
function compare(name, values)
  local original = fastest({"shale", ORIGINAL, "--args-stdin"}, values)
  local port_values = "script=" .. PORT .. "\nopt=" .. OPT .. "\ntiming=1\n" .. values
  local port = fastest({"shale", "roc_platform/run.shale", "--args-stdin"}, port_values)
  local a = body(original.out)
  local b = {}
  for l in body(port.out) do
    if not starts_with(l, "-- ") then push(b, l) end
  end
  local differ = 0
  local shown = {}
  for k = 1, max(#a, #b) do
    local x = get(a, k, "<none>")
    local y = get(b, k, "<none>")
    if x ~= y then
      differ = differ + 1
      if differ <= 5 then push(shown, "  line " .. k .. ":\n    shale: " .. x .. "\n    roc:   " .. y) end
    end
  end
  if original.code ~= port.code then differ = differ + 1 end
  local verdict = differ == 0 and "SAME" or "DIFFER"
  print(verdict .. "  " .. name .. ": " .. #a .. " lines, exit " .. original.code .. " / " .. port.code .. "; shale " .. original.ms .. " ms (cpu " .. original.cpu_ms .. "), roc " .. port.ms .. " ms (cpu " .. port.cpu_ms .. ", program " .. port.program_ms .. " ms)")
  for s in shown do print(s) end
  return differ == 0
end

local wrong = 0
local cases = set_of(split(CASES, ","))
if has_key(cases, "plants") then
  for row in ROWS do
    local values = "glob=" .. AT .. row.glob .. "\n"
    local name = row.glob
    if has_key(row, "args") then
      values = values .. row.args .. "\n"
      name = name .. " " .. row.args
    end
    if not compare(name, values) then wrong = wrong + 1 end
  end
end
if has_key(cases, "self_test") then
  if not compare("self_test=1", "self_test=1\n") then wrong = wrong + 1 end
end
if has_key(cases, "trees") then
  for t in TREES do
    local values = "glob=" .. t.glob .. "\n"
    if has_key(t, "args") then values = values .. t.args .. "\n" end
    if not compare(t.name, values) then wrong = wrong + 1 end
  end
end
if wrong > 0 then fail("compare_with_original: " .. wrong .. " cases differ") end
print("compare_with_original: every case the same")
