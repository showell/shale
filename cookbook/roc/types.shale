-- A library for the Roc recipes that check types, loaded with
-- `use("cookbook:roc/types.shale")`. It runs roc-types, Shale's tool that
-- asks Roc's own type checker for the type of every expression and pattern
-- in an app, and reads what the tool prints. The tool's source is
-- tools/roc_types, and `shale tools/roc_types/install.shale` installs it
-- under the `tools` mount. Its output format is described at the top of
-- tools/roc_types/main.zig; this file reads version 1 of that format.

const ROC_TYPES_EXE = "tools:roc-types/bin/roc-types"
const ROC_TYPES_FORMAT = "1"

-- A type's text with roc-types' escapes of `\`, tab, newline and carriage
-- return undone.
function unescape_roc_type(s)
  local out = {}
  local i = 1
  while i <= #s do
    local ch = sub(s, i, i)
    if ch == "\\" and i < #s then
      local esc = sub(s, i + 1, i + 1)
      if esc == "t" then
        push(out, "\t")
      elseif esc == "n" then
        push(out, "\n")
      elseif esc == "r" then
        push(out, "\r")
      elseif esc == "\\" then
        push(out, "\\")
      else
        fail("`roc_types`: a type with a bad escape, `\\" .. esc .. "`: " .. s)
      end
      i = i + 2
    else
      if ch == "\\" then fail("`roc_types`: a type ending in a lone `\\`: " .. s) end
      push(out, ch)
      i = i + 1
    end
  end
  return join(out, "")
end

-- Reads `r`, the result of running roc-types on `root`, into the record
-- `roc_types` returns. `roc` is the OS path of the Roc compiler the tree is
-- built with. The pin in roc-types' first line is checked against it before
-- anything else, because the errors (or the silence) of a checker from
-- another Roc version say nothing about this tree.
function parse_roc_types_output(r, root, roc)
  local all = lines(r.out)
  local head = ""
  if #all > 0 then head = all[1] end
  if not starts_with(head, "roc-types ") then fail("`roc_types`: no `roc-types " .. ROC_TYPES_FORMAT .. "` header (" .. root .. ", the first line `" .. head .. "`): an older roc-types, or not roc-types; Shale's `shale tools/roc_types/install.shale` installs the one this reads") end
  local said = words(head)
  if #said < 2 or said[2] ~= ROC_TYPES_FORMAT then fail("`roc_types`: roc-types' header is `" .. head .. "`, not format " .. ROC_TYPES_FORMAT .. "'s, the one this reads: Shale's `shale tools/roc_types/install.shale` installs the matching roc-types") end
  if #said ~= 3 then fail("`roc_types`: a header that is not `roc-types <N> <pin>`: " .. head) end
  local own = "tools:roc-" .. said[3] .. "/roc"
  if not exists(own) or real(own) ~= roc then fail("`roc_types`: roc-types reads Roc " .. said[3] .. ", and " .. root .. "'s tree is built with " .. roc .. ": its types would be another compiler's. Install the roc-types of the tree's pin (Shale's tools/roc_types), or move the tree to " .. said[3]) end
  if r.ended ~= "exit" or r.code ~= 0 then
    local why = slice(all, 2, 61)
    if #all > 61 then push(why, "(" .. (#all - 61) .. " lines more)") end
    fail("`roc_types`: roc-types " .. root .. " " .. (r.ended == "exit" and ("exited " .. r.code) or r.ended) .. ", what it said:\n" .. join(why, "\n"))
  end
  local out = {pin = said[3], paths = {}, modules = {}, warnings = {}}
  local path = ""
  for k = 2, #all do
    local l = all[k]
    if starts_with(l, "== ") then
      path = sub(l, 4)
      if not starts_with(path, "/") then fail("`roc_types`: line " .. k .. ", a module path that is not absolute: " .. path) end
      if has_key(out.modules, path) then fail("`roc_types`: line " .. k .. ", module " .. path .. " twice") end
      out.modules[path] = {}
      push(out.paths, path)
    elseif path == "" then
      push(out.warnings, l)
    elseif starts_with(l, "t\t") then
      local f = split(l, "\t")
      if #f ~= 8 then fail("`roc_types`: line " .. k .. ", a record of " .. #f .. " fields, not 8: " .. l) end
      if f[2] ~= "expr" and f[2] ~= "pat" then fail("`roc_types`: line " .. k .. ", a record of kind `" .. f[2] .. "`") end
      local ty = f[8]
      if find(ty, "\\") ~= nil then ty = unescape_roc_type(ty) end
      local span = {}
      for x in slice(f, 4, 7) do
        local n = parse_int(x)
        if n == nil then fail("`roc_types`: line " .. k .. ", a span's number `" .. x .. "`") end
        push(span, n)
      end
      push(out.modules[path], {kind = f[2], tag = f[3], line = span[1], col = span[2], end_line = span[3], end_col = span[4], type = ty})
    else
      fail("`roc_types`: line " .. k .. " is no record of roc-types' format: " .. l)
    end
  end
  return out
end

-- The types of every module reachable from the app `root`, as roc-types
-- reports them. `roc` is the OS path of the tree's Roc compiler, as
-- `roc_bin` in cookbook/roc/pinned.shale gives it. The result is a record:
--   paths: each module's real, absolute path, in roc-types' order;
--   modules: for each path, a list of `{kind, tag, line, col, end_line,
--     end_col, type}`, where `kind` is "expr" or "pat". The list is in the
--     checker's pre-order, so when several nodes share a region, the
--     outermost comes first;
--   warnings: the lines roc-types printed before the first module;
--   pin: the Roc version roc-types was built from.
-- The run fails, showing what roc-types said, when the checker rejects the
-- app (a type error, a module left unchecked, a file that isn't an app),
-- because the types would then be guesses. It also fails when roc-types is
-- missing, prints a format this file doesn't read, or was built for a Roc
-- version other than `roc`'s.
function roc_types(root, roc)
  if not exists(ROC_TYPES_EXE) then fail("`roc_types`: no " .. ROC_TYPES_EXE .. ": Shale's `shale tools/roc_types/install.shale` installs it") end
  return parse_roc_types_output(run({real(ROC_TYPES_EXE), real(root)}, {timeout_ms = 300000, whole = 64000000}), root, roc)
end

-- The app paths in a recipe's `root=` argument, which may list several,
-- `root=a.roc,b.roc`, when no one app imports every file the recipe checks.
-- `who` names the recipe in the failure when `root=` is empty.
function roc_types_roots(who, root)
  local out = {}
  for r in split(root, ",") do
    if trim(r) ~= "" then push(out, trim(r)) end
  end
  if #out == 0 then fail(who .. ": types=1 needs root=, an app (or several, `root=a.roc,b.roc`) importing the files of the glob: roc-types reads an app, and a type module only through one") end
  return out
end

-- The key under which `roc_types_hunted` stores the type at a region of a
-- file, given the file's real path and anything with the region's
-- `line, col, end_line, end_col`.
function roc_types_region_key(real_path, region)
  return real_path .. "|" .. region.line .. ":" .. region.col .. ":" .. region.end_line .. ":" .. region.end_col
end

-- The types a recipe needs for the files `paths`, gathered by running
-- `roc_types` on each app named in `root` (see `roc_types_roots`). `who`
-- names the recipe in failures. The result is a record:
--   pats, exprs: the type of each pattern and expression, by
--     `roc_types_region_key`. When several nodes share a region, the
--     outermost one's type is kept, and when two apps reach one module,
--     the first app's types are kept;
--   real: for each file of `paths` that some app reaches, its real path;
--   unreached: a line `not reached by <root>: <path>` for each file of
--     `paths` that no app reaches, except those in the set `exempt`.
-- A recipe checks an unreached file without types and passes `unreached`
-- to `fail_if_refused` (cookbook/roc/parsed.shale), which lists those
-- files after the findings and fails the run.
function roc_types_hunted(who, root, roc, paths, exempt)
  local roots = roc_types_roots(who, root)
  local pats = {}
  local exprs = {}
  local reached = {}
  for one in roots do
    local got = roc_types(one, roc)
    for path in got.paths do
      if not has_key(reached, path) then
        reached[path] = true
        for rec in got.modules[path] do
          local key = roc_types_region_key(path, rec)
          if rec.kind == "pat" then
            if not has_key(pats, key) then pats[key] = rec.type end
          elseif not has_key(exprs, key) then
            exprs[key] = rec.type
          end
        end
      end
    end
    for l in got.warnings do print(who .. ": roc-types " .. one .. ": " .. l) end
  end
  local reals = {}
  local unreached = {}
  for p in paths do
    local r = real(p)
    if has_key(reached, r) then
      reals[p] = r
    elseif not has_key(exempt, p) then
      push(unreached, "not reached by " .. join(roots, ",") .. ": " .. p)
    end
  end
  return {pats = pats, exprs = exprs, real = reals, unreached = unreached}
end

-- The type of the roc_tree node `n` in the file `path`, from the result of
-- `roc_types_hunted`, or nil where the checker gave none. `kind` is "pat"
-- or "expr".
function roc_type_at(types, kind, path, n)
  return get(kind == "pat" and types.pats or types.exprs, roc_types_region_key(types.real[path], n))
end

-- The parts of a type's text, `{fn, effect, result, args}`. A type is a
-- function when an arrow appears outside every bracket, after any `where`
-- clause is dropped. For a function, `fn` is true, `effect` says whether
-- the arrow is `=>`, `args` is the text before the arrow and `result` the
-- text after it. For any other type, `result` is the whole type and `args`
-- is empty.
function roc_type_shape(ty)
  local depth = 0
  local body = ty
  for i = 1, #ty do
    local ch = sub(ty, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    if depth == 0 and sub(ty, i, i + 6) == " where " then
      body = sub(ty, 1, i - 1)
      break
    end
  end
  depth = 0
  for i = 1, #body - 1 do
    local ch = sub(body, i, i)
    if ch == "(" or ch == "[" or ch == "{" then depth = depth + 1 end
    if ch == ")" or ch == "]" or ch == "}" then depth = depth - 1 end
    local two = sub(body, i, i + 1)
    if depth == 0 and (two == "->" or two == "=>") then
      return {fn = true, effect = two == "=>", result = trim(sub(body, i + 2)), args = trim(sub(body, 1, i - 1))}
    end
  end
  return {fn = false, effect = false, result = trim(body), args = ""}
end

-- A typed plant's file name converted to the snake_case of an ordinary
-- plant, `QuestionInferred.roc` to `question_inferred.roc`. A typed plant
-- is a type module, which Roc names in CamelCase, and a self-test chooses
-- the check that judges a plant by the start of its snake_case name.
function roc_plant_name(base)
  local out = ""
  for i = 1, #base do
    local ch = sub(base, i, i)
    if re_find(ch, "^[A-Z]$") ~= nil then
      if i > 1 then out = out .. "_" end
      out = out .. lower(ch)
    else
      out = out .. ch
    end
  end
  return out
end
