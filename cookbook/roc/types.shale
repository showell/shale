-- A library for a Shale script that runs roc-types, the tool that asks Roc's
-- own type checker for the type of every expression and pattern in an app,
-- loaded with `use("cookbook:roc/types.shale")`. The tool's home is its own
-- repo, https://github.com/showell/roc-types, whose install.shale installs it
-- under the `tools` mount. Its output format is that repo's FORMAT.md, of
-- which this names the version. roc-apps' tools/quality.shale runs it and
-- keeps a few modules' records; the Roc recipes read its output with
-- cookbook/roc/lib/RocTypes.roc.

const ROC_TYPES_EXE = "tools:roc-types/bin/roc-types"
const ROC_TYPES_FORMAT = "1"

-- The checker for the compiler `roc`: the one installed for that compiler's
-- pin, `tools:roc-types-<pin>/bin/roc-types`, as compilers sit side by side,
-- or else the default. Its output's first line names the pin it was built
-- for, which a reader holds to the tree's.
function roc_types_exe(roc)
  local m = re_find(roc, "/roc-([^/]+)/roc$")
  if m ~= nil then
    local own = "tools:roc-types-" .. m.groups[1] .. "/bin/roc-types"
    if exists(own) then return own end
  end
  return ROC_TYPES_EXE
end

-- roc-types' output `text` with the records of some modules alone: those
-- whose path is in the set `opts.only`, or starts with `opts.under`. The
-- first line, the lines before the first module and every module's `== `
-- line are kept, so the modules reached stay whole. Gives `{text, paths}`,
-- `paths` every module's path in order. It finds the module lines by text,
-- not line by line, so it costs a few steps a module.
function roc_types_keeping(text, opts)
  local only = nil
  local under = nil
  if has_key(opts, "only") then only = opts.only end
  if has_key(opts, "under") then under = opts.under end
  local nl = find(text, "\n")
  if nl == nil then return {text = text, paths = {}} end
  local at = find(text, "\n== ")
  local out = {sub(text, 1, at == nil and #text or at)}
  local paths = {}
  while at ~= nil do
    local line_end = find(text, "\n", at + 1)
    if line_end == nil then line_end = #text + 1 end
    local path = sub(text, at + 4, line_end - 1)
    local next = find(text, "\n== ", line_end)
    push(paths, path)
    push(out, "== " .. path .. "\n")
    local keep = (only ~= nil and has_key(only, path)) or (under ~= nil and starts_with(path, under))
    if keep and line_end <= #text then
      local body = sub(text, line_end + 1, next == nil and #text or next)
      if body ~= "" and not ends_with(body, "\n") then body = body .. "\n" end
      push(out, body)
    end
    at = next
  end
  return {text = join(out, ""), paths = paths}
end
