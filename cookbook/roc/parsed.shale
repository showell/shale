-- The Roc recipes (hunt_names, find_deep_calls and the rest) check every .roc
-- file in a tree, and some files may not parse. This library lets a recipe
-- check the files that do parse, print what it found, and then fail with a
-- list of the files it couldn't parse and why.

-- The files that parse, and a `path: reason` line for each that doesn't.
function parse_roc_files(paths)
  local files = {}
  local refused = {}
  for f in roc_tree(paths) do
    if f.err == "" then
      push(files, f)
    elseif starts_with(f.err, f.path) then
      push(refused, f.err)
    else
      push(refused, f.path .. ": " .. f.err)
    end
  end
  return {files = files, refused = refused}
end

-- A recipe calls this after printing what it found. It lists the files
-- that didn't parse, and the files no root imports (which were checked
-- without their types), then fails.
function fail_if_refused(who, refused, unreached?)
  local missed = unreached or {}
  if #refused == 0 and #missed == 0 then return nil end
  for r in refused do print("refused: " .. r) end
  for m in missed do print(m) end
  local why = {}
  if #refused > 0 then push(why, "roc-ast refused " .. #refused .. " files (named above), which have no tree to judge") end
  if #missed > 0 then push(why, #missed .. " files (named above) are reached by no root of the types, so were judged without them") end
  fail(who .. ": " .. join(why, "; ") .. "; every other file was judged")
end
