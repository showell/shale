-- **A BUILD ON GITHUB, NOT ON THE BOX**: a `workflow_dispatch` workflow
-- (shale's .github/workflows/test.yml: `zig build test`) dispatched for
-- `ref` and its run's URL and id said at once, then checked by that id:
-- its status, or when it is done PASS or FAIL with its wall time, and a
-- failure's last 40 log lines (`gh run view --log-failed`), failing the
-- launch. The workflow runs on no push and no PR: only when this asks.
--
--   cd <repo> && shale cookbook:gh_build.shale ref=my-branch
--   shale cookbook:gh_build.shale run=40518919602
--   shale cookbook:gh_build.shale ref=master wait=yes
--
-- `repo` is showell/<repo> (default shale), `ref` the branch, tag or
-- commit the workflow checks out (default the branch checked out here),
-- `workflow` its file (default test.yml). A dispatch is 3 or 4 programs
-- and a few seconds; `run=<id>` is one look, no waiting. **`wait=yes`**
-- dispatches and polls every `every` seconds (default 15) until the run
-- is done: it is for a background task, whose exit says the verdict. Each
-- look is one program and a run holds 64 (`runs_most`), so a wait is at
-- most about 55 looks: 13 minutes at 15 s.
--
-- budget: steps=50000000

const REPO = arg("repo", "shale")
const REF = arg("ref", "")
const WORKFLOW = arg("workflow", "test.yml")
const WAIT = arg("wait", "no")
const RUN = arg("run", "")
const EVERY = arg("every", 15)

not_option("gh_build", "repo", REPO)
not_option("gh_build", "ref", REF)
not_option("gh_build", "workflow", WORKFLOW)
not_option("gh_build", "run", RUN)
if WAIT ~= "yes" and WAIT ~= "no" then fail("gh_build: `wait` is yes or no, not " .. WAIT) end
const SLUG = "showell/" .. REPO

-- A `gh` program's output, trimmed; its failure fails the launch. `USED.n`
-- counts them against the run's 64 (`runs_most`).
const USED = {n = 0}
function gh(argv)
  USED.n = USED.n + 1
  local r = run(argv, {tail = 40, timeout_ms = 60000})
  if not has_key(r, "code") or r.code ~= 0 then fail("gh_build: `" .. join(argv, " ") .. "` failed:\n" .. r.out) end
  return trim(r.out)
end

-- **GITHUB'S REST API, NEVER ITS GRAPHQL**: `gh workflow run` and `gh run
-- list` ask GraphQL, which a Claude Code session is refused; `gh api` on
-- the REST paths works wherever `gh` does.

-- The newest dispatched run's id, or "" when there is none.
function newest()
  return gh({"gh", "api", "repos/" .. SLUG .. "/actions/workflows/" .. WORKFLOW .. "/runs?event=workflow_dispatch&per_page=1", "-q", ".workflow_runs[0].id // \"\""})
end

-- The workflow dispatched on `ref`, and its run's id once listed.
function dispatch(ref)
  local before = newest()
  -- The workflow's own file is the default branch's; `ref` is its input,
  -- the commit it checks out.
  local home = gh({"gh", "api", "repos/" .. SLUG, "-q", ".default_branch"})
  gh({"gh", "api", "-X", "POST", "repos/" .. SLUG .. "/actions/workflows/" .. WORKFLOW .. "/dispatches", "-f", "ref=" .. home, "-f", "inputs[ref]=" .. ref})
  -- The dispatch answers before the run is listed: a new id is this one.
  local id = before
  local looks = 0
  while id == before do
    looks = looks + 1
    if looks > 10 then fail("gh_build: no new " .. WORKFLOW .. " run listed for " .. SLUG .. " after 10 looks") end
    sleep(2000)
    id = newest()
  end
  return id
end

-- "status conclusion seconds url", conclusion "-" while it runs;
-- the seconds from its start to its end, or to now while it runs
-- (`updatedAt` stands still then).
const SAY = "\"\\(.status) \\(.conclusion // \"-\") \\((if .status == \"completed\" then (.updated_at | fromdate) else now end) - (.run_started_at | fromdate) | floor) \\(.html_url)\""
function look(id)
  local w = {}
  for x in words(gh({"gh", "api", "repos/" .. SLUG .. "/actions/runs/" .. id, "-q", SAY})) do push(w, x) end
  return {id = id, status = w[1], conclusion = w[2], secs = w[3], url = w[4]}
end

-- A run's verdict: its status while it runs, PASS, or FAIL with its log's
-- tail, failing the launch.
function verdict(v)
  if v.status ~= "completed" then
    print(v.status .. " after " .. v.secs .. " s: " .. v.url .. " (run " .. v.id .. ")")
  elseif v.conclusion == "success" then
    print("PASS in " .. v.secs .. " s: " .. v.url)
  else
    local r = run({"gh", "run", "view", v.id, "--repo", SLUG, "--log-failed"}, {tail = 40, timeout_ms = 60000})
    for l in lines(r.out) do print("   " .. sub(l, 1, 240)) end
    print("FAIL (" .. v.conclusion .. ") in " .. v.secs .. " s: " .. v.url)
    fail("gh_build: run " .. v.id .. " " .. v.conclusion)
  end
end

if RUN ~= "" then
  verdict(look(RUN))
else
  local ref = REF
  if ref == "" then
    ref = gh({"git", "branch", "--show-current"})
    if ref == "" then fail("gh_build: no branch checked out here: say `ref=`") end
  end
  local id = dispatch(ref)
  if WAIT == "no" then
    print("dispatched: https://github.com/" .. SLUG .. "/actions/runs/" .. id .. " (run " .. id .. ", " .. WORKFLOW .. " on " .. ref .. ")")
  else
    local v = look(id)
    print("waiting on " .. v.url .. " (" .. ref .. ")")
    while v.status ~= "completed" do
      -- One program is kept for a failure's log.
      if USED.n >= 63 then fail("gh_build: still " .. v.status .. " after " .. v.secs .. " s, and this run's 64 programs are spent: " .. v.url) end
      sleep(EVERY * 1000)
      v = look(id)
    end
    verdict(v)
  end
end
