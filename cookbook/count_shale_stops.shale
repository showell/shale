-- This recipe counts how an agent's Shale launches went, from a Claude Code
-- transcript: each Bash call's command and the answer it got, paired by the
-- call's id. A launch is a heredoc (`shale <<'TAG'`) or a script (`shale
-- path.shale`). Each ends one of four ways: it ran, Shale stopped it (`──
-- stopped at`), the gate refused the call before Shale saw it, or the
-- harness denied it. A stop by the script's own `fail` is a check's verdict,
-- counted apart; Shale's other stops are grouped by kind and by message,
-- with quoted values blanked so that one mistake made twice counts as one
-- line. The calls the heredocs make and the programs they `run` are counted
-- too: where the agent works, and where it trips.
--
-- With no `transcript=`, it reads the newest transcript under the
-- `projects:` mount. `since=` is an ISO time; only the calls from then on
-- count. `most=N` sets how many lines each list shows (20).
--
--   shale cookbook:count_shale_stops.shale
--   shale cookbook:count_shale_stops.shale since=2026-11-14T19:50
--
-- It is written in Roc, cookbook/count_shale_stops/count_shale_stops.roc and
-- the modules beside it (ShaleJson and JsonString, a line read as Shale's
-- `json_read` reads it; Transcript, the fields; Tally, the counts and
-- tables), on Shale's Roc platform (roc_platform/README.md); this file is
-- its launcher. It names the newest transcript itself, since the platform
-- gives no file's time, and hands that and the values it is given to
-- roc_platform/run.shale in the checkout this cookbook is in (the `cookbook`
-- mount's parent), which builds the Roc there (cached; the first build
-- after a change to C Shale compiles the platform's host, 25 to 50 s) and
-- runs the program rooted here, so a `transcript=` path is this root's.
--
-- It is built with `opt=speed`: every byte of a line that can hold a call
-- or an answer is read as JSON in Roc, and over a 180 MB transcript Roc's
-- dev build took 6.6 s of CPU where the Shale original, whose `json_read` is
-- C, took 1.9 s; the speed build takes 1.6 to 1.8 s, for about 30 s of build
-- once, then cached (measured on Roc nightly-2026-11-03-34bd006). Its goldens, the Shale original's output on the
-- plants, are held by cookbook/count_shale_stops/check_goldens.shale.
-- budget: programs=10

const SCRIPT = "cookbook/count_shale_stops/count_shale_stops.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))

-- Each value is read here by its name, so a misspelled one stops the run
-- before anything is built; `since` and `most` are handed on only when
-- given, so their defaults have one home, the Roc.
const TRANSCRIPT = arg("transcript", "")
const SINCE = arg("since", nil)
const MOST = arg("most", nil)

function newest_transcript()
  local best = nil
  local best_at = -1
  for p in glob("projects:*/*.jsonl") do
    local s = stat(p)
    if s.modified > best_at then
      best = p
      best_at = s.modified
    end
  end
  if best == nil then fail("count_shale_stops: no transcript under projects:") end
  return best
end

local path = TRANSCRIPT
if path == "" then path = newest_transcript() end
local values = {"script=" .. SCRIPT, "in=" .. real("."), "opt=speed", "transcript=" .. path}
if SINCE ~= nil then push(values, "since=" .. SINCE) end
if MOST ~= nil then push(values, "most=" .. MOST) end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 4000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("count_shale_stops: the Roc program stopped (exit " .. r.code .. ")") end
