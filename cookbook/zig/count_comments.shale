-- This recipe counts how much a Zig tree's comments say, and how loudly. For
-- each file it gives its code lines, its doc lines (`///`, `//!`), its plain
-- `//` lines, comment lines per 100 lines of code, words a comment line, and
-- the loud and dated comment lines. Run before and after a commit that
-- rewrites comments, it shows what the commit changed.
--
--   cd <repo> && shale <shale>/cookbook/zig/count_comments.shale
--   shale <shale>/cookbook/zig/count_comments.shale dir=zig:lib/std/zig files=AstGen.zig,Parse.zig,Zir.zig
--   cd <repo> && shale <shale>/cookbook/zig/count_comments.shale top=10
--
-- `files` is comma-separated globs under `dir` (default `.`, the root;
-- a mount works): default `src/**/*.zig,tools/*.zig,build.zig`. A glob's
-- `*` on the command line is the shell's unless quoted.
--
-- A line is code when it holds anything but a comment, a comment line
-- when it is only one (a comment after code counts as code). A loud line
-- holds `**`, a heading of two upper-case words or more (`THE HUNT`), or a
-- `──` banner. A dated line names a QUEUE or
-- FEEDBACK item, a date (`2026-10-20`), or a person (`Steve`, `the box`,
-- `CC`). The table is the loudest first, `top` rows of it (default all),
-- then the whole's totals.
--
-- It is written in Roc, cookbook/zig/count_comments/count_comments.roc, run
-- on Shale's Roc platform (roc_platform/README.md); this file is its
-- launcher. It hands the values it is given to roc_platform/run.shale in the
-- checkout this cookbook is in (the `cookbook` mount's parent), which builds
-- the Roc there (cached; the first build after a change to C Shale compiles
-- the platform's host, 25 to 50 s) and runs the program rooted here, so
-- `dir` and `files` are this root's paths. It is built with `opt=speed`:
-- the recipe looks at each byte of each comment line, and Roc's dev build
-- runs it about 60 times slower (3 s against 50 ms over Shale's legacy Zig
-- source), while the speed build costs about 7 s once, then is cached. Its
-- goldens, the Shale original's
-- output on the plants, are held by
-- cookbook/zig/count_comments/check_goldens.shale.
-- budget: programs=10

const SCRIPT = "cookbook/zig/count_comments/count_comments.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))

-- Each value is handed on only when it was given, so the defaults have one
-- home, the Roc. Each is read here by its name, so a misspelled one stops the
-- run before anything is built.
const DIR = arg("dir", nil)
const FILES = arg("files", nil)
const TOP = arg("top", nil)
local values = {"script=" .. SCRIPT, "in=" .. real("."), "opt=speed"}
if DIR ~= nil then push(values, "dir=" .. DIR) end
if FILES ~= nil then push(values, "files=" .. FILES) end
if TOP ~= nil then push(values, "top=" .. TOP) end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 600000, whole = 4000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("count_comments: the Roc program stopped (exit " .. r.code .. ")") end
