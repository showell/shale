-- This script checks that a top-level Zig constant holds the same bytes after
-- a refactor. It compiles the constant as `rev` had it and as the file has it
-- now into a throwaway test beside the file, and Zig compares the two byte for
-- byte. That judges what the constant is, not how it is written, which suits a
-- page's text spliced from shared parts (`a ++ shared.js ++ b`) or a rewritten
-- table.
--
-- The test takes its imports from the file as it is now, so a part the new text
-- names is found. A constant of the same file that the old text names is not
-- found: copy it in, or judge that one too. A constant is found as `const x =`
-- or `pub const x =`, so a refactor may add or drop the `pub`.
--
--   cd <repo>/<dir> && shale <shale>/cookbook/zig/check_const_unchanged.shale path=src/x.zig name=page [rev=HEAD]
--   shale cookbook:zig/check_const_unchanged.shale self_test=1

const SELF_TEST = arg("self_test", "") == "1"
const PATH = arg("path", "")
const NAME = arg("name", "")
const REV = arg("rev", "HEAD")
not_option("check_const_unchanged", "rev", REV)
if not SELF_TEST and (PATH == "" or NAME == "") then fail("check_const_unchanged: path= name= [rev=]") end

-- Where `text` starts a line of `source`, or nil.
function line_start(source, text)
  if starts_with(source, text) then return 1 end
  local newline = find(source, "\n" .. text)
  if newline == nil then return nil end
  return newline + 1
end

-- Gives the lines of `name`'s declaration in `source`, declared `pub` under the
-- name `new_name`. The constant ends at the `;` of a one-line declaration, or
-- else at a `;` alone on its line. `where` says what `source` is, for a stop.
function constant_as(source, name, new_name, where)
  local declaration = "const " .. name .. " ="
  local start = line_start(source, declaration)
  if start == nil then
    local after_pub = line_start(source, "pub " .. declaration)
    if after_pub == nil then fail("check_const_unchanged: no `" .. declaration .. "` or `pub " .. declaration .. "` in " .. where) end
    start = after_pub + 4
  end
  local text = sub(source, start)
  local closing_line = find(text, "\n;\n")
  local semicolon = find(text, ";\n")
  local last = nil
  if closing_line ~= nil then last = closing_line + 2 end
  if semicolon ~= nil and not contains(sub(text, 1, semicolon), "\n") then last = semicolon + 1 end
  if last == nil then fail("check_const_unchanged: `" .. declaration .. "` has no end in " .. where) end
  return substitute(sub(text, 1, last), declaration, "pub const " .. new_name .. " =")
end

function import_lines(source)
  local imports = {}
  for line in lines(source) do
    if (starts_with(line, "const ") or starts_with(line, "pub const ")) and contains(line, "@import(") then push(imports, line) end
  end
  return join(imports, "\n")
end

-- Judges `name` in the file `path` of the checkout `dir`, against `rev`.
function judge(dir, path, name, rev)
  local at = path_under(dir, path)
  local prefix_from_repo_top = trim(must(run({"git", "rev-parse", "--show-prefix"}, {cwd = dir, timeout_ms = 10000, whole = 4096})).out)
  local old_source = must(run({"git", "show", rev .. ":" .. prefix_from_repo_top .. path}, {cwd = dir, timeout_ms = 30000, whole = 16777216})).out
  local new_source = read(at)
  local test_path = path_under(dirname(at), "zz_const_judge_test.zig")
  if exists(test_path) then fail("check_const_unchanged: " .. test_path .. " is there already: a judge left behind? remove it") end
  create(test_path, import_lines(new_source) .. "\nconst zz_testing = @import(\"std\").testing;\n" ..
    constant_as(old_source, name, "zz_was", path .. " at " .. rev) .. constant_as(new_source, name, "zz_is", path) ..
    "test \"" .. name .. " is the same bytes as at " .. rev .. "\" { try zz_testing.expectEqualStrings(zz_was, zz_is); }\n")
  local result = run({"zig", "test", real(test_path)}, {timeout_ms = 300000, tail = 8000})
  remove(test_path)
  if result.code ~= 0 then
    print(result.out)
    fail("check_const_unchanged: `" .. name .. "` in " .. path .. " is not the bytes it was at " .. rev)
  end
  print("check_const_unchanged: `" .. name .. "` in " .. path .. " is the same bytes as at " .. rev)
  return nil
end

function expect(what, got, want)
  if got ~= want then fail("check_const_unchanged: " .. what .. ": got `" .. got .. "`, wanted `" .. want .. "`") end
end

function expect_stop(what, stopped, says)
  if stopped.ok or not contains(stopped.error, says) then fail("check_const_unchanged: " .. what .. " should stop saying `" .. says .. "`") end
end

function git_in(dir, words_of_git)
  local argv = {"git", "-c", "user.email=t@t", "-c", "user.name=t"}
  for w in words_of_git do push(argv, w) end
  must(run(argv, {cwd = dir, timeout_ms = 30000, tail = 5}))
end

function self_test()
  -- Finding it: either form, first in the file or below, on one line or more.
  local want = "pub const zz = \"x\";\n"
  expect("a const that opens the file", constant_as("const page = \"x\";\n", "page", "zz", "f"), want)
  expect("a pub const that opens the file", constant_as("pub const page = \"x\";\n", "page", "zz", "f"), want)
  expect("a const below", constant_as("const a = 1;\nconst page = \"x\";\nconst b = 2;\n", "page", "zz", "f"), want)
  expect("a pub const below", constant_as("const a = 1;\npub const page = \"x\";\nconst b = 2;\n", "page", "zz", "f"), want)
  expect("a pub const on several lines", constant_as("pub const page = \"x\" ++\n    \"y\"\n;\n", "page", "zz", "f"), "pub const zz = \"x\" ++\n    \"y\"\n;\n")
  local neither = "no `const page =` or `pub const page =` in f"
  expect_stop("no such constant", attempt(constant_as, "const a = 1;\n", "page", "zz", "f"), neither)
  expect_stop("a longer name", attempt(constant_as, "pub const pages = 1;\n", "page", "zz", "f"), neither)
  expect_stop("a constant with no end", attempt(constant_as, "pub const page = 1", "page", "zz", "f"), "`const page =` has no end in f")

  -- Judged by Zig: dropping the `pub` and moving the text behind a `pub` import
  -- keeps the bytes; the same declarations with one byte changed do not.
  local dir = fresh_dir("scratch:", "check_const_unchanged")
  git_in(dir, {"init", "-q"})
  replace(dir .. "/x.zig", "pub const page = \"ab\";\n")
  git_in(dir, {"add", "x.zig"})
  git_in(dir, {"commit", "-q", "-m", "base"})
  replace(dir .. "/parts.zig", "pub const a = \"ab\";\npub const c = \"ac\";\n")
  replace(dir .. "/x.zig", "pub const parts = @import(\"parts.zig\");\nconst page = parts.a;\n")
  judge(dir, "x.zig", "page", "HEAD")
  replace(dir .. "/x.zig", "pub const parts = @import(\"parts.zig\");\npub const page = parts.c;\n")
  expect_stop("a changed constant", attempt(judge, dir, "x.zig", "page", "HEAD"), "`page` in x.zig is not the bytes it was at HEAD")
  expect("the throwaway test", tostring(exists(dir .. "/zz_const_judge_test.zig")), "false")
  remove_tree(dir)
  print("check_const_unchanged self_test: PASS (const and pub const found and judged, same bytes pass, changed bytes and a missing constant stop)")
  return nil
end

if SELF_TEST then
  self_test()
else
  judge("", PATH, NAME, REV)
end
