-- This script lists the .zig files over a thousand lines in the repos we work
-- in, longest first. `over=N` sets another limit. Run it from the folder that
-- holds the repos:
--   cd ~/showell_repos && shale <shale>/cookbook/zig/list_long_files.shale [over=N]
--
-- It is written in Roc, cookbook/zig/list_long_files/list_long_files.roc,
-- run on Shale's Roc platform (roc_platform/README.md); this file is its
-- launcher. It hands the values it is given to roc_platform/run.shale in the
-- checkout this cookbook is in (the `cookbook` mount's parent), which builds
-- the Roc there (cached; the first build after a change to C Shale compiles
-- the platform's host, 25 to 50 s) and runs the program rooted here, so the
-- repos are this root's folders. Its goldens, the Shale original's output on
-- the plants, are held by cookbook/zig/list_long_files/check_goldens.shale.
-- budget: programs=10

const SCRIPT = "cookbook/zig/list_long_files/list_long_files.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))

-- `over` is handed on only when it was given, so its default has one home,
-- the Roc. It is read here by its name, so a misspelled value stops the run
-- before anything is built.
const OVER = arg("over", nil)
local values = {"script=" .. SCRIPT, "in=" .. real(".")}
if OVER ~= nil then push(values, "over=" .. OVER) end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 600000, whole = 4000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("list_long_files: the Roc program stopped (exit " .. r.code .. ")") end
