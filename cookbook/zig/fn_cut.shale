-- This script says what a piece of a long Zig function would need if it were
-- cut out into a function of its own. For lines `first` to `last` of function
-- `fn` in `path`, it prints three lists:
--
-- - takes: the locals and parameters declared before the range that it reads,
--   which become the new function's parameters or a context's fields;
-- - writes: those it assigns (`x = ...`, `x +=`), which become pointers or fields;
-- - gives: the locals it declares that the function uses after it, which the
--   new function hands back.
--
-- It reads Zig's tokens: a name is an identifier not after a `.`, and a
-- declaration is `const x`, `var x`, a `|x|` capture or a parameter. A name
-- declared again inside the range counts as the range's own.
--
--   cd <repo> && shale <shale>/cookbook/zig/fn_cut.shale path=src/x.zig fn=main first=120 last=180

const PATH = arg("path", "")
const FN = arg("fn", "")
const FIRST = parse_int(arg("first", "0"))
const LAST = parse_int(arg("last", "0"))
const ASSIGNMENT_TAGS = {"equal", "plus_equal", "minus_equal", "plus_percent_equal"}
if PATH == "" or FN == "" or FIRST == 0 or LAST == 0 then fail("fn_cut: path= fn= first= last=") end

-- Gives whether the identifier at `tokens[k]` declares its name, in a function
-- whose signature starts at `signature_line`.
function is_declaration(tokens, k, signature_line)
  local tag_before = tokens[k - 1].tag
  local tag_after = tokens[k + 1].tag
  return tag_before == "keyword_const" or tag_before == "keyword_var" or
    (tag_before == "pipe" and (tag_after == "pipe" or tag_after == "comma")) or
    (tag_before == "asterisk" and k > 2 and tokens[k - 2].tag == "pipe") or
    (tag_before == "comma" and tag_after == "pipe") or
    (tokens[k].line == signature_line and tag_after == "colon")
end

local target = nil
for declaration in zig_decls(PATH) do if declaration.name == FN then target = declaration end end
if target == nil then fail("fn_cut: no top-level `" .. FN .. "` in " .. PATH) end
if FIRST < target.first or LAST > target.last then fail("fn_cut: " .. FIRST .. ".." .. LAST .. " is not inside " .. FN .. " (" .. target.first .. ".." .. target.last .. ")") end

local tokens = zig_tokens(PATH)
local line_declared_before = {}
local names_declared_before = {}
local declared_inside = {}
local used_inside = {}
local assigned_inside = {}
local used_after = {}
for k = 1, #tokens do
  local token = tokens[k]
  local name = token.text
  if token.line >= target.first and token.line <= target.last and token.tag == "identifier" and (k == 1 or tokens[k - 1].tag ~= "period") then
    if is_declaration(tokens, k, target.first) then
      if token.line < FIRST then
        if not has_key(line_declared_before, name) then
          line_declared_before[name] = token.line
          push(names_declared_before, name)
        end
      elseif token.line <= LAST then
        declared_inside[name] = true
      end
    elseif token.line >= FIRST and token.line <= LAST then
      used_inside[name] = true
      if has_item(ASSIGNMENT_TAGS, tokens[k + 1].tag) then assigned_inside[name] = true end
    elseif token.line > LAST then
      used_after[name] = true
    end
  end
end

local takes = {}
local writes = {}
for name in names_declared_before do
  if has_key(used_inside, name) and not has_key(declared_inside, name) then
    local entry = name .. ":" .. line_declared_before[name]
    if has_key(assigned_inside, name) then push(writes, entry) else push(takes, entry) end
  end
end
local gives = {}
for name in keys(declared_inside) do
  if has_key(used_after, name) then push(gives, name) end
end
sort(gives)
print(FN .. " " .. FIRST .. ".." .. LAST .. " of " .. target.first .. ".." .. target.last)
print("takes (" .. #takes .. ", read only): " .. join(takes, " "))
print("writes (" .. #writes .. ", assigned in the range): " .. join(writes, " "))
print("gives (" .. #gives .. ", used after it): " .. join(gives, " "))
