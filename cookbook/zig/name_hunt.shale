-- **AWKWARD NAMES, A QUESTION EACH** (metal-vmm QUEUE 256): heuristic
-- hunts over Zig's tokens for names that say something other than what
-- the code does. A finding is a question for a reader, never a verdict:
--
--   state_effect  a function with effects (it takes `io`, an `Io` or a
--                 store) named as a state, not a verb: `held*`, a past
--                 participle first (`loaded`, `kept`), `done`, `ready`
--   question      `is*`, `has*`, `can*`, `should*` that returns no bool,
--                 or a bool named as a state (`marked`): ask it, `isSigned`
--   vague         a name of nothing but vague words: `handle`,
--                 `process`, `doIt`, `handleData`, `manageStuff`
--   name_type     a `*count` parameter that is no integer, a `*path` one
--                 that is no string or path type
--   negative      a bool parameter named `no*`/`not*`, a fn `isNot*`
--   noun_effect   a function with effects whose first word is no verb this
--                 knows: a plain noun (`links`, `session`), which reads as
--                 a value, not an act
--
-- One line a finding, `path:line: <check>: <why>`, then the counts.
--
--   cd <repo> && shale <shale>/cookbook/zig/name_hunt.shale glob=src/**/*.zig
--   shale cookbook:zig/name_hunt.shale self_test=1
--
-- **THE WORDS** it judges by are cookbook/words/'s tables, the Roc hunt's
-- too: participles.txt (English's irregular ones; the rule takes `-ed`),
-- ed_verbs.txt (the rule's exceptions), vague.txt and verbs.txt. `words=1`
-- gives the census instead of the findings: every first word a function
-- with effects (as `state_effect` decides) starts with, its count and its
-- verdict, `verb`, `participle`, `vague`, `asks` (`is*`, `has*`) or
-- `refused` (no word of the tables: what `noun_effect` fires on), then the
-- totals. A missing verb shows there as `refused` before it is taken for a
-- noun.
--
-- `self_test=1` runs it over `cookbook/zig/plants/name_hunt/`, each plant
-- named for the check it holds (`question.zig`, `question_irregular.zig`):
-- every check must fire on its own plants and on no other, a `quiet_*.zig`
-- plant on none, and the census must give a known word of the plants each
-- verdict but `asks`. `glob2=` is a second glob.
--
-- budget: steps=900000000 arena_bytes=4000000000

const SELF = arg("self_test", "") == "1"
const GLOB = SELF and "cookbook:zig/plants/name_hunt/*.zig" or arg("glob", "src/**/*.zig")
const GLOB2 = arg("glob2", "")
const CHECKS = {"state_effect", "question", "vague", "name_type", "negative", "noun_effect", "preposition_split"}

const WORDS = arg("words", "") == "1"

-- A word table of cookbook/words/, the name hunts' one home for them: a
-- word a line, `--` starting a note. A word twice, or a line of two, is a
-- mistake in the table: it fails.
function word_table(file)
  local t = {}
  for l in lines(read("cookbook:words/" .. file)) do
    local w = trim(split(l, "--")[1])
    if contains(w, " ") or has_key(t, w) then fail("name_hunt: cookbook/words/" .. file .. ": `" .. w .. "` is no single new word") end
    if w ~= "" then t[w] = true end
  end
  return t
end

const VERBS = word_table("verbs.txt")
const PARTICIPLES = word_table("participles.txt")
const ED_VERBS = word_table("ed_verbs.txt")
const VAGUE = word_table("vague.txt")
const PREPS = word_table("prepositions.txt")
-- Each file's names that end in a preposition, by the words before it:
-- `path|base` -> {line, preps (prep -> {name, arity})}.
const SPLITS = {}
const ENTRY = {handle = true, run = true}
const INTS = {usize = true, isize = true, comptime_int = true}

-- A Zig name's words, lower case: `handleData` and `handle_data` both
-- `{handle, data}`.
function words_of(name)
  local s = re_replace(name, "([A-Z])", "_\\1")
  local got = {}
  for w in split(lower(s), "_") do
    if w ~= "" then push(got, w) end
  end
  return got
end

function is_participle(w)
  if has_key(PARTICIPLES, w) then return true end
  return #w > 3 and ends_with(w, "ed") and not has_key(ED_VERBS, w)
end

-- A verb that reads as a participle would make its functions states.
for w in keys(VERBS) do
  if is_participle(w) then fail("name_hunt: `" .. w .. "` is in cookbook/words/verbs.txt and reads as a participle") end
end

-- What an effect's first word says, as the Roc hunt judges it:
-- `participle` (a state: `state_effect` fires), `verb`, `vague`, `asks`
-- (`is`, `has`: `question` judges it), or `refused`, which `noun_effect`
-- fires on.
function verdict(w)
  if is_participle(w) then return "participle" end
  if has_key(VERBS, w) then return "verb" end
  if has_key(VAGUE, w) then return "vague" end
  if w == "is" or w == "has" then return "asks" end
  return "refused"
end

function is_int(t)
  if has_key(INTS, t) then return true end
  return re_match(t, "^[ui][0-9]+$")
end

-- The text of `toks[a..b]`, joined.
function text_of(toks, a, b)
  local got = {}
  for k = a, b do
    push(got, toks[k].text)
    if starts_with(toks[k].tag, "keyword_") then push(got, " ") end
  end
  return join(got, "")
end

const found = {}
for c in CHECKS do found[c] = 0 end
const per_file = {}
-- Each first word an effect starts with, by word: `{word, count,
-- verdict}`, for the census (`words=1`).
const census = {}

function say(p, line, check, why)
  if not WORDS then print(p .. ":" .. line .. ": " .. check .. ": " .. why) end
  found[check] = found[check] + 1
  per_file[p .. "|" .. check] = true
  return nil
end

-- One file's findings.
function hunt(p)
  local toks = zig_tokens(p)
  local n = #toks
  for k = 1, n - 2 do
    if toks[k].tag == "keyword_fn" and toks[k + 1].tag == "identifier" and toks[k + 2].tag == "l_paren" then
      local name = toks[k + 1].text
      local line = toks[k].line
      -- The parameters, `{name, type}`, split at their own depth's commas.
      local params = {}
      local j = k + 3
      local depth = 1
      local pname = nil
      local tfrom = 0
      while j <= n and depth > 0 do
        local u = toks[j]
        if u.tag == "l_paren" or u.tag == "l_brace" or u.tag == "l_bracket" then depth = depth + 1 end
        if u.tag == "r_paren" or u.tag == "r_brace" or u.tag == "r_bracket" then depth = depth - 1 end
        if depth == 1 and u.tag == "colon" and toks[j - 1].tag == "identifier" then
          pname = toks[j - 1].text
          tfrom = j + 1
        end
        if (depth == 1 and u.tag == "comma") or depth == 0 then
          if pname ~= nil then push(params, {name = pname, type = text_of(toks, tfrom, j - 1)}) end
          pname = nil
        end
        j = j + 1
      end
      -- The return type: from `)` to the body's `{` or the `;`.
      local rfrom = j
      while j <= n and toks[j].tag ~= "l_brace" and toks[j].tag ~= "semicolon" do j = j + 1 end
      local ret = text_of(toks, rfrom, j - 1)
      local ws = words_of(name)

      local effect = false
      for q in params do
        if q.name == "io" or contains(q.type, "Io") or contains(lower(q.type), "store") then effect = true end
      end
      if effect and #ws > 0 then
        if not has_key(census, ws[1]) then census[ws[1]] = {word = ws[1], count = 0, verdict = verdict(ws[1])} end
        census[ws[1]].count = census[ws[1]].count + 1
        if census[ws[1]].verdict == "refused" then
          if has_key(PREPS, ws[1]) then say(p, line, "noun_effect", "`" .. name .. "` has effects (takes io or a store) but starts with a preposition, `" .. ws[1] .. "`: an effect is named for its act")
          else say(p, line, "noun_effect", "`" .. name .. "` has effects (takes io or a store) but its first word, `" .. ws[1] .. "`, is no verb: it reads as a value, not an act") end
        end
      end
      local gives_bool = ret == "bool" or ret == "!bool"
      if gives_bool and #ws > 0 and is_participle(ws[1]) then say(p, line, "question", "`" .. name .. "` gives a bool but is named as a state, `" .. ws[1] .. "`: ask it (`is*`, `has*`)") end
      if effect and not gives_bool and #ws > 0 and is_participle(ws[1]) then say(p, line, "state_effect", "`" .. name .. "` has effects (takes io or a store) but is named as a state, `" .. ws[1] .. "`: a verb says what it does") end

      if #ws > 1 and (ws[1] == "is" or ws[1] == "has" or ws[1] == "can" or ws[1] == "should") and not contains(ret, "bool") and ret ~= "" then say(p, line, "question", "`" .. name .. "` asks a question but returns `" .. ret .. "`") end

      local all_vague = #ws > 0
      for w in ws do
        if not has_key(VAGUE, w) then all_vague = false end
      end
      -- A lone `handle` or `run` is an entry point's convention, not vague.
      if #ws == 1 and has_key(ENTRY, ws[1]) then all_vague = false end
      if all_vague then say(p, line, "vague", "`" .. name .. "` is only vague words: what does it handle, and how?") end

      for q in params do
        local qw = words_of(q.name)
        local last = ""
        if #qw > 0 then last = qw[#qw] end
        local t = q.type
        if last == "count" and not is_int(t) then say(p, line, "name_type", "`" .. name .. "`'s `" .. q.name .. "` is a count of type `" .. t .. "`") end
        if last == "path" and not contains(t, "u8") and not contains(t, "Path") and not contains(t, "anytype") then say(p, line, "name_type", "`" .. name .. "`'s `" .. q.name .. "` is a path of type `" .. t .. "`") end
        if t == "bool" and (qw[1] == "no" or qw[1] == "not") and #qw > 1 then say(p, line, "negative", "`" .. name .. "`'s `" .. q.name .. "` is a negative flag: `" .. q.name .. " = false` reads twice") end
      end
      if #ws > 1 and has_key(PREPS, ws[#ws]) then
        local key = p .. "|" .. join(take(ws, #ws - 1), "_")
        if not has_key(SPLITS, key) then SPLITS[key] = {path = p, line = line, base = name, preps = {}} end
        if not has_key(SPLITS[key].preps, ws[#ws]) then SPLITS[key].preps[ws[#ws]] = {name = name, arity = #params} end
      end
      if #ws > 2 and ws[1] == "is" and ws[2] == "not" then say(p, line, "negative", "`" .. name .. "` asks a negative: `!" .. name .. "(...)` reads twice") end
    end
  end
  return nil
end

-- Two opposite prepositions on one noun name a matched pair on purpose
-- (`insert_before` and `insert_after`): no split.
const OPPOSITES = {["after|before"] = true, ["from|to"] = true, ["with|without"] = true, ["over|under"] = true, ["into|onto"] = false}

-- One noun given different trailing prepositions in one file, less the
-- house's recursion worker (a `*From` taking more parameters than its
-- siblings: its `from` names the index it resumes at).
function report_splits()
  for key in sort(keys(SPLITS)) do
    local s = SPLITS[key]
    local least = -1
    for prep in keys(s.preps) do
      local a = s.preps[prep].arity
      if least < 0 or a < least then least = a end
    end
    local kept = {}
    local kept_preps = {}
    for prep in sort(keys(s.preps)) do
      local e = s.preps[prep]
      if not (prep == "from" and e.arity > least) then
        push(kept, e.name)
        push(kept_preps, prep)
      end
    end
    if #kept > 1 and not (#kept == 2 and get(OPPOSITES, join(kept_preps, "|"), false)) then say(s.path, s.line, "preposition_split", "`" .. join(kept, "`, `") .. "`: one noun, " .. #kept .. " prepositions in one file: one relation keeps one preposition, or the names say how they differ") end
  end
  return nil
end

local files = 0
for p in glob(GLOB) do
  files = files + 1
  hunt(p)
  yield()
end
if GLOB2 ~= "" then
  for p in glob(GLOB2) do
    files = files + 1
    hunt(p)
    yield()
  end
end

report_splits()

local counts = {}
for c in CHECKS do push(counts, c .. " " .. found[c]) end
if WORDS then
  local rows = {}
  local by = {}
  local total = 0
  for w in keys(census) do
    push(rows, census[w])
    by[census[w].verdict] = get(by, census[w].verdict, 0) + census[w].count
    total = total + census[w].count
  end
  sort(rows, {{key = "count", desc = true}, "word"})
  for r in rows do print(pad(r.count, -4) .. " " .. pad(r.word, 12) .. " " .. r.verdict) end
  local verdicts = {}
  for v in {"verb", "participle", "vague", "asks", "refused"} do push(verdicts, v .. " " .. get(by, v, 0)) end
  print("name_hunt census: " .. files .. " files; " .. total .. " effects, " .. #rows .. " first words; effects by verdict: " .. join(verdicts, ", "))
else
  print("name_hunt: " .. files .. " files; " .. join(counts, ", "))
end

if SELF then
  -- Every plant is judged before a failure stops the run, so one run shows
  -- each plant that is wrong.
  local wrong = {}
  for c in CHECKS do
    for p in glob(GLOB) do
      local base = sub(p, #"cookbook:zig/plants/name_hunt/" + 1)
      local mine = base == c .. ".zig" or starts_with(base, c .. "_")
      local fired = has_key(per_file, p .. "|" .. c)
      if mine and not fired then push(wrong, "`" .. c .. "` does not fire on its plant " .. p) end
      if fired and not mine then push(wrong, "`" .. c .. "` fires on " .. p .. ", another check's plant") end
    end
  end
  -- The census: a known word of the plants in each verdict.
  for want in {{word = "read", verdict = "verb"}, {word = "held", verdict = "participle"}, {word = "process", verdict = "vague"}, {word = "links", verdict = "refused"}} do
    local got = get(census, want.word)
    if got == nil then push(wrong, "the census has no `" .. want.word .. "`")
    elseif got.verdict ~= want.verdict then push(wrong, "the census calls `" .. want.word .. "` " .. got.verdict .. ", not " .. want.verdict) end
  end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail("name_hunt self_test: " .. #wrong .. " plants wrong") end
  print("name_hunt self_test: PASS (each check fires on its plants alone, the quiet_ plants on none, and the census gives each verdict its known word)")
end
