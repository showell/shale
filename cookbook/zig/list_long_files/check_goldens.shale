-- cookbook/zig/list_long_files/check_goldens.shale: list_long_files (the Roc
-- script beside this, list_long_files.roc, through its launcher
-- cookbook/zig/list_long_files.shale) held to its goldens, goldens.txt
-- beside this, line for line and exit code for exit code. From the shale
-- checkout's root:
--
--   shale cookbook/zig/list_long_files/check_goldens.shale self_test=1
--   shale cookbook/zig/list_long_files/check_goldens.shale write=1
--
-- Each case runs the launcher in cookbook/zig/plants/list_long_files/, a
-- folder of small repos (its README says what each file plants), as the
-- recipe runs from the folder that holds the repos. The goldens were written
-- once the port matched the Shale original's output on every case here but
-- `over=abc`, whose stop has the Roc's own words (the original's was `arg`'s),
-- and on the box's own repos too, which are left out because their code moves.
-- A stop is held by its words alone (`── stop: <words>`). The runners' own
-- lines are left out: Shale's `──` report lines and the launchers' stops
-- after the program's. `write=1` writes the goldens again, for a change
-- meant to move them: `git diff` shows what moved.
-- budget: programs=40 steps=50000000 output_bytes=1000000

const LAUNCHER = "cookbook/zig/list_long_files.shale"
const GOLDENS = "cookbook/zig/list_long_files/goldens.txt"
const PLANTS = "cookbook/zig/plants/list_long_files"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- Each case's values, one a line, as the launcher's stdin.
const CASES = {
  "",
  "over=4",
  "over=3",
  "over=0",
  "over=-1",
  "over=6",
  "over=abc",
}

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at (?:the (?:Linux )?prelude:[0-9]+:[0-9]+|[^ ]+)(?: \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: list_long_files: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- One case's run in the plants, as its golden section: `=== <values> (exit
-- N)` and its body.
function section(values)
  local r = run({"shale", real(LAUNCHER), "--args-stdin"}, {cwd = PLANTS, stdin = values .. "\n", timeout_ms = 600000, whole = 1000000})
  local ls = {"=== " .. join(lines(values), " ") .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for values in CASES do push(all, section(values).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  for values in CASES do
    local got = section(values)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      print("FAIL " .. head)
      local shown = 0
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. head .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. #CASES .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. #CASES .. " cases match " .. GOLDENS)
end
