-- **A ZIG FILE TIDIED AFTER A MOVE**: its first block of top-level `const`
-- lines ordered, `@import`s first (each in the order it had), then the
-- aliases; and a section banner (`// ──`) with nothing under it, only blank
-- lines before the next banner or the end, removed.
--
--   cd <repo> && shale <shale>/cookbook/zig/zig_tidy.shale path=src/x.zig

const P = arg("path", "")
if P == "" then fail("zig_tidy: give path=src/x.zig") end

local l = lines(read(P))
-- The first block of `const ` lines: an alias (`const x = y.z;`) that
-- comes before the import it names (`const y = @import(...)`) moves to just
-- after it; every other line keeps its place, so an alias already beside
-- what it aliases (`const linux = std.os.linux;` under `std`) stays.
local first = 1
while first <= #l and not starts_with(l[first], "const ") and not starts_with(l[first], "pub const ") do first = first + 1 end
if first <= #l then
  local i = first
  local block = {}
  while i <= #l and (starts_with(l[i], "const ") or starts_with(l[i], "pub const ")) do
    push(block, l[i])
    i = i + 1
  end
  -- Where each name is declared in the block.
  local at = {}
  for k = 1, #block do
    local m = re_find(block[k], "const ([A-Za-z_][A-Za-z0-9_]*) ")
    if m ~= nil then at[m.group] = k end
  end
  local waiting = {}
  local ordered = {}
  local moved = 0
  for k = 1, #block do
    local m = re_find(block[k], "= ([A-Za-z_][A-Za-z0-9_]*)\\.")
    local root = nil
    if m ~= nil and not contains(block[k], "@import(") then root = m.group end
    if root ~= nil and has_key(at, root) and at[root] > k then
      if not has_key(waiting, root) then waiting[root] = {} end
      push(waiting[root], block[k])
      moved = moved + 1
    else
      push(ordered, block[k])
      local d = re_find(block[k], "const ([A-Za-z_][A-Za-z0-9_]*) ")
      if d ~= nil and has_key(waiting, d.group) then
        for w in waiting[d.group] do push(ordered, w) end
        waiting[d.group] = {}
      end
    end
  end
  if moved > 0 then
    edit(P, join(block, "\n") .. "\n", join(ordered, "\n") .. "\n")
    print(P .. ": " .. moved .. " aliases moved after the imports they name")
  end
end

-- Banners with nothing under them.
l = lines(read(P))
local keep = {}
local dropped = 0
for i = 1, #l do
  local drop = false
  if starts_with(l[i], "// ──") then
    local j = i + 1
    while j <= #l and trim(l[j]) == "" do j = j + 1 end
    if j > #l or starts_with(l[j], "// ──") then drop = true end
  end
  if drop then
    dropped = dropped + 1
  else
    push(keep, l[i])
  end
end
if dropped > 0 then
  -- A dropped banner's blank line after it goes too: no two blank lines left.
  local out = {}
  for x in keep do
    if not (x == "" and #out > 0 and out[#out] == "") then push(out, x) end
  end
  local text = join(out, "\n")
  if not ends_with(text, "\n") then text = text .. "\n" end
  replace(P, text)
  print(P .. ": " .. dropped .. " banners with nothing under them removed")
end
