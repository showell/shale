-- This script checks that a top-level Zig constant holds the same bytes after
-- a refactor. It compiles the constant as `rev` had it and as the file has it
-- now into a throwaway test beside the file, and Zig compares the two byte for
-- byte. That judges what the constant is, not how it is written, which suits a
-- page's text spliced from shared parts (`a ++ shared.js ++ b`) or a rewritten
-- table.
--
-- The test takes its imports from the file as it is now, so a part the new text
-- names is found. A constant of the same file that the old text names is not
-- found: copy it in, or judge that one too. A `pub const` is not found either.
--
--   cd <repo>/<dir> && shale <shale>/cookbook/zig/const_judge.shale path=src/x.zig name=page [rev=HEAD]

const PATH = arg("path", "")
const NAME = arg("name", "")
const REV = arg("rev", "HEAD")
not_option("const_judge", "rev", REV)
if PATH == "" or NAME == "" then fail("const_judge: path= name= [rev=]") end

-- Gives the lines of `const NAME =` in `source`, declared `pub` under the name
-- `new_name`. The constant ends at the `;` of a one-line declaration, or else
-- at a `;` alone on its line.
function constant_as(source, new_name)
  local declaration = "const " .. NAME .. " ="
  local before = find(source, "\n" .. declaration)
  if before == nil then
    if starts_with(source, declaration) then before = 0 else fail("const_judge: no `" .. declaration .. "` in " .. new_name) end
  end
  local text = sub(source, before + 1)
  local closing_line = find(text, "\n;\n")
  local semicolon = find(text, ";\n")
  local last = nil
  if closing_line ~= nil then last = closing_line + 2 end
  if semicolon ~= nil and not contains(sub(text, 1, semicolon), "\n") then last = semicolon + 1 end
  if last == nil then fail("const_judge: `" .. declaration .. "` has no end in " .. new_name) end
  return substitute(sub(text, 1, last), declaration, "pub const " .. new_name .. " =")
end

function import_lines(source)
  local imports = {}
  for line in lines(source) do
    if starts_with(line, "const ") and contains(line, "@import(") then push(imports, line) end
  end
  return join(imports, "\n")
end

local prefix_from_repo_top = trim(must(run({"git", "rev-parse", "--show-prefix"}, {timeout_ms = 10000, whole = 4096})).out)
local old_source = must(run({"git", "show", REV .. ":" .. prefix_from_repo_top .. PATH}, {timeout_ms = 30000, whole = 16777216})).out
local new_source = read(PATH)

local test_path = path_under(dirname(PATH), "zz_const_judge_test.zig")
if exists(test_path) then fail("const_judge: " .. test_path .. " is there already: a judge left behind? remove it") end
create(test_path, import_lines(new_source) .. "\nconst zz_testing = @import(\"std\").testing;\n" ..
  constant_as(old_source, "zz_was") .. constant_as(new_source, "zz_is") ..
  "test \"" .. NAME .. " is the same bytes as at " .. REV .. "\" { try zz_testing.expectEqualStrings(zz_was, zz_is); }\n")
local result = run({"zig", "test", test_path}, {timeout_ms = 300000, tail = 8000})
remove(test_path)
if result.code ~= 0 then
  print(result.out)
  fail("const_judge: `" .. NAME .. "` in " .. PATH .. " is not the bytes it was at " .. REV)
end
print("const_judge: `" .. NAME .. "` in " .. PATH .. " is the same bytes as at " .. REV)
