-- This script prints a map of a Zig file: each top-level function, type and
-- test, with its first line and its length up to the next one, and then how
-- many of the file's lines are tests. A constant that is not a type is left out.
--   cd <repo> && shale <shale>/cookbook/zig/map_file.shale path=src/x.zig

const LONGEST_SHOWN = 90

function is_test(text)
  return re_find(text, "^test ") ~= nil
end

function is_mapped(line)
  if is_test(line) then return true end
  if re_find(line, "^(pub fn|fn|pub const|const|pub var|var) ") == nil then return false end
  return re_find(line, "fn |= struct|= enum|= union") ~= nil
end

local source = lines(read(arg("path", "")))
local mapped = {}
for number = 1, #source do
  if is_mapped(source[number]) then
    push(mapped, {line = number, text = sub(source[number], 1, LONGEST_SHOWN)})
  end
end

local rows = {}
local test_lines = 0
local first_test = 0
for k = 1, #mapped do
  local next_line = #source + 1
  if k < #mapped then next_line = mapped[k + 1].line end
  local length = next_line - mapped[k].line
  if is_test(mapped[k].text) then
    test_lines = test_lines + length
    if first_test == 0 then first_test = mapped[k].line end
  end
  push(rows, {line = mapped[k].line, lines = length, decl = mapped[k].text})
end
print(table(rows, {"line", "lines", "decl"}))
print(#source .. " lines; tests " .. test_lines .. "; the first test at line " .. first_test)
