-- **A PAGE FETCHED, AND WHAT IT SAID THAT MATTERS**: `http_get` (the
-- Linux prelude's, by `curl`) from a launch line: the status, how long it
-- took, and the body's first `head` lines, or its lines holding `grep`'s
-- literals. A status other than `status` (default 200) fails the launch.
-- The escape behind a release's checks (2026-10-23: `/version`, a page's
-- `Begin Game`, a wait for a new commit to serve).
--
--   shale cookbook:http.shale url=https://dogpark.lynrummy.com/version
--   shale cookbook:http.shale url=https://dogpark.lynrummy.com/ grep=Begin,Game
--   shale cookbook:http.shale url=https://dogpark.lynrummy.com/version wait=5419352 minutes=10
--   shale cookbook:http.shale url=https://chat.example/api/v1/messages json=messages.1.id
--
-- **`json`** reads the body as JSON (`json_read`) and prints the value at a
-- dotted path, a list's items by number from 1 (`messages.1.id`); `json=.`
-- is the whole body, compact. A path that is not there fails, naming the
-- part that was not.
--
-- `bearer` is a Shale path (through a mount) whose file holds a token,
-- sent as `Authorization: Bearer` and never shown. **`wait`**: fetch every
-- `every` seconds (default 10) until the body holds that literal, for at
-- most `minutes` (default 10); a failed fetch meanwhile (the server
-- restarting) is said and tried again. Each try is one program (the
-- fetch; the wait between is `sleep`, none) and a run holds 64
-- (`runs_most`), so a wait is at most 64 fetches: `minutes * 60 / every`
-- under 64.
--
-- budget: steps=50000000

const URL = arg("url", "")
const GREP = arg("grep", "")
const HEAD = arg("head", 20)
const STATUS = arg("status", 200)
const BEARER = arg("bearer", "")
const WAIT = arg("wait", "")
const MINUTES = arg("minutes", 10)
const EVERY = arg("every", 10)
const JSON = arg("json", "")

-- What `json` walks: a table, or a scalar (whose `tostring` is itself),
-- and a table a map when `keys` takes it.
function text_of(v) return tostring(v) end
function keys_of(v) return keys(v) end

if URL == "" then fail("http: say `url=`") end
local opts = {}
if BEARER ~= "" then opts.bearer = BEARER end

local r = nil
if WAIT == "" then
  r = http_get(URL, opts)
else
  local tries = 0
  local most = MINUTES * 60 // EVERY + 1
  -- A fetch a try: said here, not by the runs budget halfway.
  if most > 64 then fail("http: a wait of " .. most .. " fetches, and a run holds 64 programs: raise `every` or lower `minutes`") end
  while true do
    tries = tries + 1
    local got = attempt(http_get, URL, opts)
    if got.ok and contains(got.value.body, WAIT) then
      r = got.value
      break
    end
    local said = "status " .. (got.ok and got.value.status or "none: " .. tostring(got.error))
    if tries >= most then fail("http: " .. URL .. " never held `" .. WAIT .. "` in " .. MINUTES .. " minutes (" .. tries .. " fetches; the last: " .. said .. ")") end
    print("waiting (" .. tries .. "): " .. sub(said, 1, 160))
    sleep(EVERY * 1000)
  end
end

local body = lines(r.body)
if JSON ~= "" then
  local v = json_read(r.body)
  local walked = ""
  if JSON ~= "." then
    for part in split(JSON, ".") do
      local n = parse_int(part)
      local next = nil
      local table = not attempt(text_of, v).ok
      local map = table and attempt(keys_of, v).ok
      if table and not map and n ~= nil then
        if n >= 1 and n <= #v then next = v[n] end
      elseif map and has_key(v, part) then
        next = v[part]
      end
      if next == nil then fail("http: the body has no `" .. part .. "`" .. (walked == "" and "" or " in `" .. walked .. "`")) end
      v = next
      walked = walked == "" and part or walked .. "." .. part
    end
  end
  local shown = v
  if not attempt(text_of, v).ok then shown = json_write(v) end
  print("json: " .. JSON .. " = " .. sub(tostring(shown), 1, 2000))
elseif GREP ~= "" then
  local held = 0
  for l in body do
    for w in split(GREP, ",") do
      if w ~= "" and contains(l, w) then
        held = held + 1
        print("grep: " .. sub(l, 1, 240))
        break
      end
    end
  end
  if held == 0 then print("grep: no line holds " .. GREP) end
else
  for i = 1, #body do
    if i > HEAD then
      print("   ... " .. (#body - HEAD) .. " more lines (head=" .. HEAD .. ")")
      break
    end
    print("   " .. sub(body[i], 1, 240))
  end
end
print("── " .. r.status .. " in " .. r.ms .. " ms: " .. URL)
if r.status ~= STATUS then fail("http: " .. URL .. " answered " .. r.status .. ", not " .. STATUS) end
