-- This recipe removes a finished lane: a linked worktree or a standalone
-- clone in the folder it runs from (`~/build/lanes` on the box), and the
-- lane's branch once it is merged. It removes nothing unless
-- `retire_checkout.shale` says CLEAR first.
--
--   cd ~/build/lanes && shale cookbook:remove_lane.shale dir=apps-list
--   cd ~/build/lanes && shale cookbook:remove_lane.shale dirs=apps-list,x86-mod
--   shale cookbook:remove_lane.shale self_test=1
--
-- The rule: a lane is removed only after `retire_checkout` clears it. A bare
-- `git worktree remove` lets an unpushed commit or a link into the lane go
-- with it. This recipe makes the check and the removal one launch, so the
-- check can't be skipped.
--
-- In order:
--
-- 1. **Fetch** the lane's origin (`git_fetch(lane, {remote = "origin",
--    prune = true})`, from the lane, whose refs a worktree shares with its
--    main checkout, so a fetch over ssh runs unconfined), so the checks
--    below see the remote as it is, not as the last fetch saw it. **A repo
--    with no remote at all** (safari-walk's) has nothing to fetch: the
--    run says so, and every "merged" below is judged against the repo's
--    local main branch (`main` or `master`, whichever it has:
--    `local_main_branch.shale`) in place of origin's default, and there is
--    no remote branch to settle. A repo with remotes but none named
--    `origin` is refused, nothing removed.
-- 2. **Run `retire_checkout.shale dir=<lane>`** as a child run from the
--    same folder: its checks are its own, never copied here. Anything but a
--    plain `CLEAR: <lane> can be deleted` stops the run with nothing
--    removed: BLOCKED with its reasons, and a CLEAR with a check SKIPPED
--    too, since a check that didn't run is not a check passed.
-- 3. **Remove the lane.** A worktree goes by `git -C <main> worktree remove
--    <lane>` (never `--force`: git refuses a worktree with changes, which
--    the check has just said there are none of). **A worktree holding an
--    initialized submodule** git will not remove without `--force`
--    ("working trees containing submodules cannot be moved or removed"),
--    since the submodule's repository lives in the worktree's own admin
--    folder and goes with it. It is removed with `--force` only when, by
--    `submodule_check`: the lane's branch (or detached HEAD) is merged, by
--    the rule of 4; every submodule (`git submodule status --recursive`)
--    is at the commit the lane records, with no change, untracked file or
--    stash in it; and each one's HEAD and local branches are all on one of
--    its remotes, so nothing that goes with the admin folder is anywhere
--    alone. Otherwise the run stops naming why, with nothing removed or
--    deleted, its remote branch included. A clone's folder is
--    deleted whole, after its remote branch (5) is dealt with, since that
--    push is made from the clone.
-- 4. **Delete the lane's local branch** (a worktree's, in its main
--    checkout) when it is merged: its tip an ancestor of origin's default
--    branch (`git merge-base --is-ancestor`, as `prune_merged_branches.shale`
--    judges), or each of its commits past it a patch the default already
--    has (`git cherry`, by patch-id), as a lane rebased onto the default
--    and fast-forwarded leaves it; never by its name. A branch with a
--    commit whose patch the default lacks, or with a merge commit past it
--    (no patch to compare), is kept, said with its count of such commits;
--    `retire_checkout` has already said each of them is on a remote. The
--    default branch itself is never deleted, nor a detached HEAD's commit,
--    which has no branch. **A branch parked as a tag** is deleted unmerged
--    (`git branch -D`): one whose every commit on no remote branch a
--    remote's tag holds, by `remote_tags.shale`'s rule (origin asked for
--    each tag holding the lane's commits before step 2), said as `deleted local x: 3 commits on origin's tag
--    parked/x`. One with a commit only here never gets this far:
--    `retire_checkout` blocks it.
-- 5. **Delete its remote branch** (`git_push(lane, {delete = branch})`,
--    from the lane before it goes, so a push over ssh runs unconfined) when
--    one is left on origin and is merged, by the same rule; else it is
--    kept, said.
--
-- Each step prints one line, and the last line is the outcome: `removed:
-- <lane> (...)` naming what was deleted and what was kept.
--
-- `self_test=1` plants a main checkout with a bare origin, and one with no
-- remote, their lanes in a
-- scratch root, and a mounts file of its own (`build:`, `tools:` and
-- `memory:` in the scratch folder, `cookbook:` this one), so
-- `retire_checkout` checks the plants and nothing of the box. A lane with an
-- unpushed commit is refused and left whole, its branch too; a merged lane
-- is removed with its branch here and on origin; a lane pushed and not
-- merged is removed and its branch kept on both sides; a lane rebased onto
-- main (its commits picked there under new hashes) is removed with its
-- branch on both sides; a lane with one of its two commits picked is
-- removed and its branch kept; a lane parked as a tag pushed to origin
-- (never as a branch) is removed with its local branch, and one whose tag
-- is only local, or on origin a commit behind its tip, is refused and left
-- whole; a merged clone is deleted with its remote branch. Of the remoteless repo's lanes, one merged into its local main
-- is removed with its branch, and one a commit past it is refused and left
-- whole. Of a third repo's lanes, each holding a submodule: one merged
-- and clean is removed with its branch; one pushed and not merged, and one
-- merged whose submodule has a local commit on no remote, are refused and
-- left whole. The child run is given its root as `SHALE_ROOT`, so the self-test
-- passes under a parent run that sets its own.
--
-- budget: steps=2000000000 reads=1000000 programs=2000

use("./local_main_branch.shale")
use("./remote_tags.shale")

const DIR = arg("dir", "")
const DIRS = arg("dirs", "")
const SELF_TEST = arg("self_test", 0)

function git(dir_os, args)
  local argv = {"git", "-c", "user.email=t@t", "-c", "user.name=t", "-C", dir_os}
  for a in args do push(argv, a) end
  return run(argv, {timeout_ms = 60000, whole = 4000000, want = "nonzero: said by the caller"})
end

-- As `git`, stopping the run when git exits nonzero.
function git_ok(dir_os, args)
  local r = git(dir_os, args)
  if r.code ~= 0 then fail("remove_lane: `git -C " .. dir_os .. " " .. join(args, " ") .. "` exited " .. r.code .. ": " .. trim(r.out)) end
  return r
end

-- origin's default branch's name, from `origin/HEAD`, asked of origin when
-- the checkout has no note of it (git_remote_head from `repo`, the lane's
-- Shale path: `ls-remote --symref`, unconfined over ssh, then origin/HEAD
-- set); nil when it can't be known.
function default_branch(dir_os, repo)
  local ref = git(dir_os, {"symbolic-ref", "--short", "refs/remotes/origin/HEAD"})
  if ref.code ~= 0 then return git_remote_head(repo, "origin") end
  local said = trim(ref.out)
  if not starts_with(said, "origin/") then return nil end
  return sub(said, #"origin/" + 1, #said)
end

-- What a lane's branch is judged merged against: `{name, ref, shown,
-- why}` (`ref` whole, so a tag of the same name never stands in for it),
-- its name `""` (and `why` the reason) when it can't be known. With an origin,
-- origin's default branch (`origin/<name>`); with no remote at all, the
-- repo's local main branch (`local_main_branch.shale`).
function lane_base(repo_os, path, has_origin)
  if has_origin then
    local main = default_branch(repo_os, path)
    if main == nil then return {name = "", why = "origin's default branch is not known here"} end
    return {name = main, ref = "refs/remotes/origin/" .. main, shown = "origin/" .. main, why = "origin's default branch"}
  end
  local m = local_main_branch(repo_os)
  if m.name == "" then return {name = "", why = "the repo has no remote, and " .. m.why} end
  return {name = m.name, ref = "refs/heads/" .. m.name, shown = "local " .. m.name, why = "the repo's local main branch"}
end

function commits(n)
  if n == 1 then return "1 commit" end
  return n .. " commits"
end

-- Whether `ref` is merged into `upstream` (origin/main, or a remoteless
-- repo's local main): {merged, why}. Merged is its tip an ancestor of
-- upstream, or every commit past it a patch upstream already has (`git cherry`, by patch-id): a lane rebased onto
-- the default branch and fast-forwarded there leaves its old branch with
-- the same patches under other hashes. A merge commit past it has no patch
-- `git cherry` can judge, so it keeps the branch.
function merged_into(dir_os, ref, upstream, shown)
  if git(dir_os, {"merge-base", "--is-ancestor", ref, upstream}).code == 0 then return {merged = true, why = "merged into " .. shown} end
  local n = parse_int(trim(git_ok(dir_os, {"rev-list", "--count", ref, "--not", upstream}).out))
  local merges = parse_int(trim(git_ok(dir_os, {"rev-list", "--count", "--merges", ref, "--not", upstream}).out))
  if merges > 0 then return {merged = false, why = commits(n) .. " not in " .. shown .. ", " .. merges .. " of them a merge, which has no patch to compare"} end
  local missing = 0
  for l in lines(git_ok(dir_os, {"cherry", upstream, ref}).out) do
    if starts_with(l, "+ ") then missing = missing + 1 end
  end
  if missing == 0 then return {merged = true, why = "rebased into " .. shown .. ", each of its " .. commits(n) .. " there by its patch"} end
  if missing == n then return {merged = false, why = commits(n) .. " not in " .. shown} end
  return {merged = false, why = commits(missing) .. " of " .. n .. " not in " .. shown .. ", the rest there by their patches"}
end

-- `retire_checkout.shale dir=<dir>` as a child run from the root, with
-- `env` its environment's additions; its output printed. Stops unless the
-- verdict is a plain CLEAR.
function require_clear(root, dir, env)
  -- The child's root is named, never left to its folder: a `SHALE_ROOT`
  -- in this run's environment (a harness may set one) would outrank `cwd`.
  local child_env = {SHALE_ROOT = real(root)}
  for k in keys(env) do child_env[k] = env[k] end
  local r = run({"shale", real("cookbook:retire_checkout.shale"), "dir=" .. dir}, {cwd = root, env = child_env, timeout_ms = 300000, whole = 4000000, want = "nonzero: BLOCKED, said by the caller"})
  local verdict = ""
  local stop = ""
  for l in lines(r.out) do
    if starts_with(l, "── stopped at ") then stop = l end
    if not starts_with(l, "──") then print(l) end
    if starts_with(l, "CLEAR: ") or starts_with(l, "BLOCKED: ") then verdict = l end
  end
  if starts_with(verdict, "BLOCKED: ") then fail("remove_lane: " .. dir .. " is BLOCKED (the reasons above); nothing removed") end
  if r.code ~= 0 then fail("remove_lane: retire_checkout gave no verdict on " .. dir .. ", it exited " .. r.code .. " (`" .. stop .. "`); nothing removed") end
  if verdict ~= "CLEAR: " .. dir .. " can be deleted" then fail("remove_lane: " .. dir .. " is not plainly CLEAR (`" .. verdict .. "`): a check that didn't run is not a check passed; nothing removed") end
  return nil
end

-- What happens to a branch: deleted when merged, else kept. `where` is
-- "local" (the branch in `dir_os`) or "remote" (its branch on origin,
-- deleted by `git_push` from `push_from`, the lane's Shale path, so a push
-- over ssh runs unconfined). `base` is what merged means (`lane_base`).
-- Gives the line said.
-- `cover`, for a local branch, is what its remote tags hold (`tags_cover`):
-- an unmerged branch they hold wholly is deleted.
function settle_branch(dir_os, branch, base, where, push_from?, cover?)
  if base.name == "" then return "kept " .. where .. " " .. branch .. ": " .. base.why end
  if branch == base.name then return "kept " .. where .. " " .. branch .. ": " .. base.why end
  local ref = branch
  if where == "remote" then ref = "origin/" .. branch end
  local m = merged_into(dir_os, ref, base.ref, base.shown)
  if not m.merged and where == "local" and cover ~= nil and cover.alone == 0 and cover.covered > 0 then
    git_ok(dir_os, {"branch", "-D", branch})
    return "deleted local " .. branch .. ": " .. commits(cover.covered) .. " on " .. cover.said
  end
  if not m.merged then return "kept " .. where .. " " .. branch .. ": " .. m.why end
  if where == "remote" then git_push(push_from, {delete = branch}) else git_ok(dir_os, {"branch", "-D", branch}) end
  return "deleted " .. where .. " " .. branch .. ": " .. m.why
end

-- A step's line, said now and kept for the outcome.
function say(said, line)
  print("remove_lane: " .. line)
  push(said, line)
  return nil
end

function has_remote_branch(dir_os, branch)
  return git(dir_os, {"rev-parse", "-q", "--verify", "refs/remotes/origin/" .. branch}).code == 0
end

function submodules(n)
  if n == 1 then return "submodule" end
  return "submodules"
end

-- The lane's initialized submodules, when it holds any, checked as the
-- header's step 3 says: `{count, said}`, `said` the removal's words.
-- Stops the run, naming why, when one would be lost with the worktree.
-- `lane_os` is the worktree, `repo_os` its main checkout, `base` what
-- merged means (`lane_base`).
function submodule_check(lane_os, repo_os, branch, base)
  local subs = {}
  for l in lines(git_ok(lane_os, {"submodule", "status", "--recursive"}).out) do
    if l ~= "" and not starts_with(l, "-") then
      local m = re_find(l, "^(.)[0-9a-f]+ (\\S+)")
      if m == nil then fail("remove_lane: `git submodule status` said a line it can't read: `" .. l .. "`; nothing removed") end
      push(subs, {mark = m.groups[1], path = m.groups[2]})
    end
  end
  if #subs == 0 then return {count = 0, said = ""} end
  local why = "it holds " .. #subs .. " initialized " .. submodules(#subs) .. ", which git removes only by `--force`, and "
  local stop = "; nothing removed"
  if base.name == "" then fail("remove_lane: " .. lane_os .. ": " .. why .. base.why .. stop) end
  local ref = branch
  if ref == "" then ref = trim(git_ok(lane_os, {"rev-parse", "HEAD"}).out) end
  local named = branch
  if branch == "" then named = "detached HEAD" end
  local m = merged_into(repo_os, ref, base.ref, base.shown)
  if not m.merged then fail("remove_lane: " .. lane_os .. ": " .. why .. "its " .. named .. " is not merged: " .. m.why .. stop) end
  for s in subs do
    if s.mark ~= " " then fail("remove_lane: " .. lane_os .. ": " .. why .. "its submodule " .. s.path .. " is not at the commit the lane records (`" .. s.mark .. "` in `git submodule status`)" .. stop) end
    local sub_os = lane_os .. "/" .. s.path
    local dirty = trim(git_ok(sub_os, {"status", "--porcelain"}).out)
    if dirty ~= "" then fail("remove_lane: " .. lane_os .. ": " .. why .. "its submodule " .. s.path .. " has changes: " .. sub(dirty, 1, 200) .. stop) end
    if trim(git_ok(sub_os, {"stash", "list"}).out) ~= "" then fail("remove_lane: " .. lane_os .. ": " .. why .. "its submodule " .. s.path .. " has a stash" .. stop) end
    if #git_remotes(sub_os) == 0 then fail("remove_lane: " .. lane_os .. ": " .. why .. "its submodule " .. s.path .. " has no remote, so its commits may be nowhere else" .. stop) end
    local alone = parse_int(trim(git_ok(sub_os, {"rev-list", "--count", "HEAD", "--branches", "--not", "--remotes"}).out))
    if alone > 0 then fail("remove_lane: " .. lane_os .. ": " .. why .. "its submodule " .. s.path .. " has " .. commits(alone) .. " on no remote" .. stop) end
  end
  return {count = #subs, said = " by `--force`, its " .. #subs .. " " .. submodules(#subs) .. " clean, each commit on a remote, its " .. named .. " " .. m.why}
end

-- The removal of the lane `dir` in the root `cfg.root`, `cfg.env` the
-- child run's environment. Gives the outcome line.
function remove_lane(cfg)
  local dir = cfg.dir
  while ends_with(dir, "/") do dir = sub(dir, 1, #dir - 1) end
  if dir == "" then fail("remove_lane: name the lane, `dir=<lane>`, a folder in the root (run from the folder that holds the lanes)") end
  if starts_with(dir, "/") or starts_with(dir, "~") or contains(dir, ":") or contains(dir, "..") or contains(dir, "/") then fail("remove_lane: `dir=" .. dir .. "` must be a folder in the root, by its name (`dir=apps-list`): run from the folder that holds it") end
  local path = path_under(cfg.root, dir)
  if not exists(path) then fail("remove_lane: there is no folder " .. path) end
  local lane_os = real(path)
  local is_clone = exists(path .. "/.git/HEAD")
  local is_worktree = not is_clone and exists(path .. "/.git")
  if not is_clone and not is_worktree then fail("remove_lane: " .. path .. " is not a git checkout; nothing removed") end
  local repo_os = lane_os
  if is_worktree then
    local common = trim(git_ok(lane_os, {"rev-parse", "--path-format=absolute", "--git-common-dir"}).out)
    repo_os = common
    if ends_with(repo_os, "/.git") then repo_os = sub(repo_os, 1, #repo_os - 5) end
  end
  local branch = trim(git_ok(lane_os, {"branch", "--show-current"}).out)
  local remotes = git_remotes(repo_os)
  local has_origin = has_item(remotes, "origin")
  if #remotes > 0 and not has_origin then fail("remove_lane: " .. repo_os .. " has remotes but no `origin` (" .. join(remotes, ", ") .. "): which one its branches are judged against is not known; nothing removed") end
  if has_origin then
    -- From the lane, whose refs are its main checkout's: git_fetch runs a
    -- fetch over ssh unconfined, which a plain `run` of git cannot.
    git_fetch(path, {remote = "origin", prune = true})
    print("remove_lane: fetched origin in " .. repo_os)
  else
    print("remove_lane: " .. repo_os .. " has no remote: nothing fetched, and its branch is judged merged against its local main branch")
  end
  -- A tag holding the lane's commits is asked of origin here, a run of its
  -- own (a child run cannot fetch over ssh), and recorded for
  -- retire_checkout to read (`remote_tags.shale`).
  if has_origin and branch ~= "" then
    for l in tags_record(path, lane_os, "origin", "HEAD") do print("remove_lane: asked origin for the tag " .. l) end
  end
  require_clear(cfg.root, dir, cfg.env)
  local main = lane_base(repo_os, path, has_origin)
  local no_remote_said = "no remote branch " .. branch .. " on origin"
  if not has_origin then no_remote_said = "no remote: the repo has none" end
  local said = {}
  if is_worktree then
    -- The remote branch is settled while the lane is there to push from,
    -- and said after the removal, in the outcome's order.
    local subs = submodule_check(lane_os, repo_os, branch, main)
    local remote_said = no_remote_said
    if branch ~= "" and has_remote_branch(repo_os, branch) then remote_said = settle_branch(repo_os, branch, main, "remote", path) end
    local cover = nil
    if branch ~= "" and has_origin then cover = tags_cover(lane_os, "refs/heads/" .. branch) end
    if subs.count > 0 then
      git_ok(repo_os, {"worktree", "remove", "--force", lane_os})
    else
      git_ok(repo_os, {"worktree", "remove", lane_os})
    end
    say(said, "removed the worktree " .. lane_os .. " of " .. repo_os .. subs.said)
    if branch == "" then
      say(said, "no branch: its HEAD was detached")
    else
      say(said, settle_branch(repo_os, branch, main, "local", nil, cover))
      say(said, remote_said)
    end
  else
    if branch == "" then
      say(said, "no branch: its HEAD was detached")
    elseif has_remote_branch(lane_os, branch) then
      say(said, settle_branch(lane_os, branch, main, "remote", path))
    else
      say(said, no_remote_said)
    end
    remove_tree(path)
    say(said, "deleted the clone " .. lane_os .. ", its local branches with it")
  end
  return "removed: " .. dir .. " (" .. join(said, "; ") .. ")"
end

-- The self-test's plants, under a fresh scratch folder T: `origin.git` (a
-- bare origin), `main` (the lanes' main checkout, outside the root),
-- `lanes/` (the root), and `build/`, `tools/` and `memory/` for the mounts
-- file `mounts`.

function expect(what, got, want)
  if got ~= want then fail("remove_lane self_test: " .. what .. " is `" .. tostring(got) .. "`, should be `" .. tostring(want) .. "`") end
  return nil
end

function commit_file(os, file, text)
  must(run({"touch", os .. "/" .. file}, {timeout_ms = 10000, whole = 10000}))
  git_ok(os, {"add", "-A"})
  git_ok(os, {"commit", "-q", "-m", "add " .. file .. ": " .. text})
  return nil
end

function branch_there(os, ref)
  return git(os, {"rev-parse", "-q", "--verify", ref}).code == 0
end

function self_test()
  local T = fresh_dir("scratch:", "remove_lane_self_test")
  local Tos = real(T)
  for d in {"lanes", "build", "tools", "memory"} do mkdir(T .. "/" .. d) end
  -- `main` holds the main checkout, whose .git the lanes' git reads: a
  -- program runs confined to the root and the mounts, as the box's lanes
  -- reach theirs through the `repos` mount.
  create(T .. "/mounts", "cookbook = " .. real("cookbook:") .. " ro\nbuild = " .. Tos .. "/build\ntools = " .. Tos .. "/tools ro\nmemory = " .. Tos .. "/memory ro\nmain = " .. Tos .. "/main ro\nsolo = " .. Tos .. "/solo ro\nsuper = " .. Tos .. "/super ro\n")
  local env = {SHALE_MOUNTS = Tos .. "/mounts"}
  local L = T .. "/lanes"
  local Los = real(L)
  must(run({"git", "init", "-q", "--bare", "-b", "main", Tos .. "/origin.git"}, {timeout_ms = 30000, whole = 10000}))
  must(run({"git", "clone", "-q", Tos .. "/origin.git", Tos .. "/main"}, {timeout_ms = 30000, whole = 10000}))
  local M = Tos .. "/main"
  commit_file(M, "README.md", "first")
  git_push(T .. "/main", {to = "main"})
  git_ok(M, {"remote", "set-head", "origin", "--auto"})
  -- A lane with a commit on no remote.
  git_ok(M, {"worktree", "add", "-q", "-b", "unpushed", Los .. "/unpushed"})
  commit_file(Los .. "/unpushed", "a.txt", "unpushed")
  -- A lane pushed and merged into main.
  git_ok(M, {"worktree", "add", "-q", "-b", "merged", Los .. "/merged"})
  commit_file(Los .. "/merged", "b.txt", "merged")
  git_push(L .. "/merged", {branch = "merged"})
  git_ok(M, {"merge", "-q", "--ff-only", "merged"})
  git_push(T .. "/main", {to = "main"})
  -- A lane pushed and not merged.
  git_ok(M, {"worktree", "add", "-q", "-b", "pushed", Los .. "/pushed"})
  commit_file(Los .. "/pushed", "c.txt", "pushed")
  git_push(L .. "/pushed", {branch = "pushed"})
  -- A lane pushed, then rebased onto main: both its commits picked there.
  git_ok(M, {"worktree", "add", "-q", "-b", "rebased", Los .. "/rebased"})
  commit_file(Los .. "/rebased", "e.txt", "rebased, first")
  commit_file(Los .. "/rebased", "f.txt", "rebased, second")
  git_push(L .. "/rebased", {branch = "rebased"})
  -- A lane pushed, one of its two commits picked onto main.
  git_ok(M, {"worktree", "add", "-q", "-b", "partly", Los .. "/partly"})
  commit_file(Los .. "/partly", "g.txt", "partly, picked")
  commit_file(Los .. "/partly", "h.txt", "partly, not picked")
  git_push(L .. "/partly", {branch = "partly"})
  -- Lanes parked as tags, never pushed as branches: one whose tag at its
  -- tip is on origin, one whose tag is only local, one whose tag on origin
  -- is a commit behind its tip.
  for name in {"parked", "parked-local", "parked-older"} do
    local lane = Los .. "/" .. name
    git_ok(M, {"worktree", "add", "-q", "-b", name, lane})
    commit_file(lane, name .. "-1.txt", name .. ", first")
    if name == "parked-older" then git_ok(lane, {"tag", "parked/" .. name}) end
    commit_file(lane, name .. "-2.txt", name .. ", second")
    if name ~= "parked-older" then git_ok(lane, {"tag", "-a", "-m", "parked", "parked/" .. name}) end
    if name ~= "parked-local" then git_push(L .. "/" .. name, {tag = "parked/" .. name}) end
  end
  -- main moves on first, so each commit picked onto it gets a new hash
  -- (picked onto its own parent within the second, it would keep its own).
  commit_file(M, "x.txt", "main moves on")
  git_ok(M, {"cherry-pick", "rebased~1", "rebased", "partly~1"})
  git_push(T .. "/main", {to = "main"})
  expect("rebased: its tip not an ancestor of main", git(M, {"merge-base", "--is-ancestor", "rebased", "main"}).code == 0, false)
  -- A clone on a branch pushed and merged.
  must(run({"git", "clone", "-q", Tos .. "/origin.git", Los .. "/clone"}, {timeout_ms = 30000, whole = 10000}))
  git_ok(Los .. "/clone", {"checkout", "-q", "-b", "cloned"})
  commit_file(Los .. "/clone", "d.txt", "cloned")
  git_push(L .. "/clone", {branch = "cloned"})
  git_push(L .. "/clone", {to = "main"})

  -- A main checkout with no remote at all, and two lanes of it: one merged
  -- into its local main, one a commit past it.
  local S = Tos .. "/solo"
  must(run({"git", "init", "-q", "-b", "main", S}, {timeout_ms = 30000, whole = 10000}))
  commit_file(S, "README.md", "solo, first")
  git_ok(S, {"worktree", "add", "-q", "-b", "solo-merged", Los .. "/solo-merged"})
  commit_file(Los .. "/solo-merged", "s.txt", "solo, merged")
  git_ok(S, {"merge", "-q", "--ff-only", "solo-merged"})
  git_ok(S, {"worktree", "add", "-q", "-b", "solo-ahead", Los .. "/solo-ahead"})
  commit_file(Los .. "/solo-ahead", "t.txt", "solo, ahead")
  -- A repo with an origin whose lanes each hold a submodule, initialized:
  -- one merged, one pushed and not merged, one merged whose submodule has
  -- a local branch a commit past its remote.
  local U = Tos .. "/subrepo"
  must(run({"git", "init", "-q", "-b", "main", U}, {timeout_ms = 30000, whole = 10000}))
  commit_file(U, "lib.txt", "the submodule, first")
  local P = Tos .. "/super"
  must(run({"git", "init", "-q", "--bare", "-b", "main", Tos .. "/super.git"}, {timeout_ms = 30000, whole = 10000}))
  must(run({"git", "clone", "-q", Tos .. "/super.git", P}, {timeout_ms = 30000, whole = 10000}))
  git_ok(P, {"-c", "protocol.file.allow=always", "submodule", "add", "-q", U, "lib"})
  git_ok(P, {"commit", "-q", "-m", "a submodule"})
  git_push(T .. "/super", {to = "main"})
  git_ok(P, {"remote", "set-head", "origin", "--auto"})
  for name in {"subs-merged", "subs-unmerged", "subs-alone"} do
    git_ok(P, {"worktree", "add", "-q", "-b", name, Los .. "/" .. name})
    git_ok(Los .. "/" .. name, {"-c", "protocol.file.allow=always", "submodule", "update", "--init", "-q"})
    commit_file(Los .. "/" .. name, name .. ".txt", name)
    git_push(L .. "/" .. name, {branch = name})
  end
  git_ok(P, {"merge", "-q", "--ff-only", "subs-merged"})
  git_ok(P, {"merge", "-q", "--no-edit", "subs-alone"})
  git_push(T .. "/super", {to = "main"})
  local alone_lib = Los .. "/subs-alone/lib"
  git_ok(alone_lib, {"checkout", "-q", "-b", "side"})
  commit_file(alone_lib, "side.txt", "the submodule, a local commit")
  git_ok(alone_lib, {"checkout", "-q", "-"})

  local a = attempt(remove_lane, {root = L, dir = "unpushed", env = env})
  expect("unpushed: refused", a.ok, false)
  expect("unpushed: the refusal says BLOCKED", contains(a.error, "remove_lane: unpushed is BLOCKED"), true)
  expect("unpushed: still there", exists(L .. "/unpushed/a.txt"), true)
  expect("unpushed: its branch still there", branch_there(M, "refs/heads/unpushed"), true)
  print("refused as it should be: " .. a.error)

  local merged = remove_lane({root = L, dir = "merged", env = env})
  expect("merged: gone", exists(L .. "/merged"), false)
  expect("merged: its local branch gone", branch_there(M, "refs/heads/merged"), false)
  expect("merged: its branch on origin gone", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/heads/merged"}).code == 0, false)
  print(merged)

  local pushed = remove_lane({root = L, dir = "pushed", env = env})
  expect("pushed: gone", exists(L .. "/pushed"), false)
  expect("pushed: its local branch kept", branch_there(M, "refs/heads/pushed"), true)
  expect("pushed: its branch on origin kept", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/heads/pushed"}).code == 0, true)
  expect("pushed: the outcome says why kept", contains(pushed, "kept local pushed: 1 commit not in origin/main"), true)
  print(pushed)

  local rebased = remove_lane({root = L, dir = "rebased", env = env})
  expect("rebased: gone", exists(L .. "/rebased"), false)
  expect("rebased: its local branch gone", branch_there(M, "refs/heads/rebased"), false)
  expect("rebased: its branch on origin gone", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/heads/rebased"}).code == 0, false)
  expect("rebased: the outcome says by patch", contains(rebased, "deleted remote rebased: rebased into origin/main, each of its 2 commits there by its patch"), true)
  print(rebased)

  local partly = remove_lane({root = L, dir = "partly", env = env})
  expect("partly: gone", exists(L .. "/partly"), false)
  expect("partly: its local branch kept", branch_there(M, "refs/heads/partly"), true)
  expect("partly: its branch on origin kept", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/heads/partly"}).code == 0, true)
  expect("partly: the outcome says why kept", contains(partly, "kept remote partly: 1 commit of 2 not in origin/main, the rest there by their patches"), true)
  print(partly)

  for name in {"parked-local", "parked-older"} do
    local r = attempt(remove_lane, {root = L, dir = name, env = env})
    expect(name .. ": refused", r.ok, false)
    expect(name .. ": the refusal says BLOCKED", contains(r.error, "remove_lane: " .. name .. " is BLOCKED"), true)
    expect(name .. ": still there", exists(L .. "/" .. name .. "/" .. name .. "-2.txt"), true)
    expect(name .. ": its branch still there", branch_there(M, "refs/heads/" .. name), true)
    print("refused as it should be: " .. r.error)
  end
  local parked = remove_lane({root = L, dir = "parked", env = env})
  expect("parked: gone", exists(L .. "/parked"), false)
  expect("parked: its local branch gone", branch_there(M, "refs/heads/parked"), false)
  expect("parked: its tag on origin kept", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/tags/parked/parked"}).code == 0, true)
  expect("parked: the outcome names the tag", contains(parked, "deleted local parked: 2 commits on origin's tag parked/parked"), true)
  print(parked)

  local clone = remove_lane({root = L, dir = "clone", env = env})
  expect("clone: gone", exists(L .. "/clone"), false)
  expect("clone: its branch on origin gone", git(Tos .. "/origin.git", {"rev-parse", "-q", "--verify", "refs/heads/cloned"}).code == 0, false)
  print(clone)

  local unmerged = attempt(remove_lane, {root = L, dir = "subs-unmerged", env = env})
  expect("subs-unmerged: refused", unmerged.ok, false)
  expect("subs-unmerged: the refusal says not merged", contains(unmerged.error, "it holds 1 initialized submodule, which git removes only by `--force`, and its subs-unmerged is not merged: 1 commit not in origin/main; nothing removed"), true)
  expect("subs-unmerged: still there", exists(L .. "/subs-unmerged/subs-unmerged.txt"), true)
  expect("subs-unmerged: its branch on origin kept", git(Tos .. "/super.git", {"rev-parse", "-q", "--verify", "refs/heads/subs-unmerged"}).code == 0, true)
  print("refused as it should be: " .. unmerged.error)

  local alone = attempt(remove_lane, {root = L, dir = "subs-alone", env = env})
  expect("subs-alone: refused", alone.ok, false)
  expect("subs-alone: the refusal names the submodule's commit", contains(alone.error, "its submodule lib has 1 commit on no remote; nothing removed"), true)
  expect("subs-alone: still there", exists(L .. "/subs-alone/lib/lib.txt"), true)
  expect("subs-alone: its branch on origin kept", git(Tos .. "/super.git", {"rev-parse", "-q", "--verify", "refs/heads/subs-alone"}).code == 0, true)
  print("refused as it should be: " .. alone.error)

  local subs = remove_lane({root = L, dir = "subs-merged", env = env})
  expect("subs-merged: gone", exists(L .. "/subs-merged"), false)
  expect("subs-merged: unregistered", contains(git_ok(P, {"worktree", "list"}).out, "subs-merged"), false)
  expect("subs-merged: its local branch gone", branch_there(P, "refs/heads/subs-merged"), false)
  expect("subs-merged: its branch on origin gone", git(Tos .. "/super.git", {"rev-parse", "-q", "--verify", "refs/heads/subs-merged"}).code == 0, false)
  expect("subs-merged: the outcome says how", contains(subs, " by `--force`, its 1 submodule clean, each commit on a remote, its subs-merged merged into origin/main"), true)
  print(subs)

  local ahead = attempt(remove_lane, {root = L, dir = "solo-ahead", env = env})
  expect("solo-ahead: refused", ahead.ok, false)
  expect("solo-ahead: the refusal says BLOCKED", contains(ahead.error, "remove_lane: solo-ahead is BLOCKED"), true)
  expect("solo-ahead: still there", exists(L .. "/solo-ahead/t.txt"), true)
  expect("solo-ahead: its branch still there", branch_there(S, "refs/heads/solo-ahead"), true)
  print("refused as it should be: " .. ahead.error)

  local solo = remove_lane({root = L, dir = "solo-merged", env = env})
  expect("solo-merged: gone", exists(L .. "/solo-merged"), false)
  expect("solo-merged: its branch gone", branch_there(S, "refs/heads/solo-merged"), false)
  expect("solo-merged: the outcome says local main", contains(solo, "deleted local solo-merged: merged into local main; no remote: the repo has none"), true)
  print(solo)

  remove_tree(T)
  print("remove_lane self_test: PASS (a merged lane holding a clean submodule removed by --force, and an unmerged one and one whose submodule has a commit alone refused; a remoteless repo's merged lane removed with its branch and its unmerged one refused; an unpushed lane refused and left whole; a merged lane removed with its branch here and on origin; a pushed, unmerged lane removed and its branch kept; a rebased lane removed with its branch on both sides; a partly picked lane's branch kept; a lane parked as a tag on origin removed with its branch, and one whose tag is only local or behind its tip refused; a merged clone deleted with its remote branch)")
  return nil
end

-- Several lanes in one launch (`dirs=a,b,c`): each is removed as `dir=`
-- removes it, in turn, and one refused stops none of the others. The
-- outcome is each lane's line, then a count; the run fails when any was
-- refused, naming them.
function remove_lanes(names)
  local refused = {}
  for name in names do
    local r = attempt(remove_lane, {root = ".", dir = name, env = {}})
    if r.ok then
      print(r.value)
    else
      push(refused, name)
      print("refused: " .. name .. ": " .. r.error)
    end
  end
  print("remove_lane: " .. (#names - #refused) .. " of " .. #names .. " removed")
  if #refused > 0 then fail("remove_lane: refused " .. #refused .. ": " .. join(refused, ", ")) end
  return nil
end

if SELF_TEST == 1 then
  self_test()
elseif DIRS ~= "" then
  if DIR ~= "" then fail("remove_lane: give `dir=` or `dirs=`, not both") end
  local names = {}
  for n in split(DIRS, ",") do
    if trim(n) ~= "" then push(names, trim(n)) end
  end
  remove_lanes(names)
else
  print(remove_lane({root = ".", dir = DIR, env = {}}))
end
