-- This recipe runs a program and prints what it said that matters. It takes
-- one command line, or several joined by `&&` and run in order until one
-- fails, and prints for each how it ended, how long it took, the lines
-- holding `grep`'s literals and its last lines. The whole output is kept in
-- `log`. The default log is .zig-cache/run.log under `dir`, and only where
-- that folder is already (a Zig checkout, which ignores it); elsewhere (an
-- essay repo, a memory folder) nothing is written, and the last line says
-- so. It is `run` from a launch line, for `roc check`, a `zig build` with a
-- log and a timing, a bench binary, `gh run` or `node`. Inside a heredoc,
-- call the prelude's `report_run(argv, opts)`, which this recipe is a
-- launch line for: the same verdict, with no child run.
--
--   cd <repo> && shale cookbook:run.shale --args-stdin <<'ARGS'
--   cmd=roc check roc/Game.roc && roc test roc/Game.roc && roc fmt --check roc/
--   grep=error,warning
--   ARGS
--
-- `cmd` is split on `&&`, each part on spaces (no quoting: a word with a
-- space needs a script of its own); a program named through a mount
-- (`zig:zig`) runs by its OS path. `dir` is where each runs, `minutes`
-- the time each gets, `tail` the last lines printed of each (more for a
-- failure), `grep` comma-separated literals, `most` the most grep lines
-- printed of each. `want=tag: why` runs a program `run` refuses (a shell,
-- an interpreter such as `node`, a text tool), logged as `run` logs it.
-- The launch fails when a command does, naming it, so a chain in a
-- shell's `&&` stops as this one does.
--
-- budget: steps=400000000 arena_bytes=1000000000

const CMD = arg("cmd", "")
const DIR = arg("dir", ".")
const MINUTES = arg("minutes", 10)
const TAIL = arg("tail", 10)
const GREP = arg("grep", "")
const MOST = arg("most", 60)
const LOG = arg("log", "")
const WANT = arg("want", "")

if trim(CMD) == "" then fail("run: say `cmd=`, the command line (with spaces: on stdin, `--args-stdin`)") end

-- Where the whole output goes, `report_run`'s rule: `log=`, else
-- .zig-cache/run.log where that folder is, else nowhere ("").
local log_path = "auto"
if LOG ~= "" then log_path = path_under(DIR, LOG) end
local wanted = {}
for w in split(GREP, ",") do if w ~= "" then push(wanted, w) end end

-- Each command in order through the prelude's `report_run`, which prints
-- its verdict and stops the launch on the first that fails.
local k = 0
local r = nil
for part in split(CMD, "&&") do
  k = k + 1
  local argv = {}
  for w in words(part) do push(argv, w) end
  if #argv == 0 then fail("run: an empty command in `" .. CMD .. "`") end
  local opts = {cwd = DIR, timeout_ms = MINUTES * 60000, shown = trim(part), grep = wanted, tail = TAIL, most = MOST, log = log_path, append_log = k > 1}
  if WANT ~= "" then opts.want = WANT end
  r = report_run(argv, opts)
end
print(report_run_kept(r.log))
