-- cookbook/c/hunt_names/check_goldens.shale: hunt_names (the Roc script
-- beside this, hunt_names.roc, through its launcher
-- cookbook/c/hunt_names.shale) held to its goldens, goldens.txt beside this,
-- line for line and exit code for exit code. From the shale checkout's root:
--
--   shale cookbook/c/hunt_names/check_goldens.shale self_test=1
--   shale cookbook/c/hunt_names/check_goldens.shale write=1
--
-- The launcher builds in the checkout the `cookbook` mount names, so from a
-- lane's worktree the mount is pointed at the worktree first: a mounts file
-- with its `cookbook` line the worktree's, named by SHALE_MOUNTS for the call.
--
-- The cases are the self-test, then `dir=` each plant folder of
-- cookbook/c/plants/ (map_file's breaks among them, each a stop;
-- hunt_names_edges, the cases a line reader could read wrong: keyword-led
-- and pointer locals, array and wrapped parameters, a head and body on one
-- line, bounds with units, an abbreviation in five names, folders named
-- `out`), then a folder that is not there. The goldens were written from the Shale
-- original's output on them, and the port matched the original on Shale's
-- own C too (`dir=` c, c/host, c/script, c/foundation and c/tests), which is
-- left out because that code moves. The folder that is not there stops the
-- run in the original walk's words as `fail` says them (`file_system: ...`
-- was the original's class): its golden is the port's.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines, the `called from` lines, and the
-- launchers' own stops (run.shale's `run: ...`, this recipe's launcher's). A
-- stop's line is held by its words, not its place (`── stop: <words>`).
-- `write=1` writes the goldens again from the launcher, for a change meant
-- to move them: `git diff` shows what moved.
-- budget: programs=100 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/c/hunt_names.shale"
const GOLDENS = "cookbook/c/hunt_names/goldens.txt"
const PLANTS = "cookbook/c/plants/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- Each case's values, one a line, as the launcher's stdin.
function cases()
  local c = {"self_test=1"}
  for d in {"hunt_names", "hunt_names_edges", "map_file", "map_file/breaks", "find_clones", "find_dead_code", "find_dead_code_edges", "list_deep_nesting", "list_long_functions"} do
    push(c, "dir=" .. PLANTS .. d)
  end
  push(c, "dir=" .. PLANTS .. "nowhere")
  return c
end

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at (?:the (?:Linux )?prelude:[0-9]+:[0-9]+|[^ ]+)(?: \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: hunt_names: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- One case's run, as its golden section: `=== <values> (exit N)` and its
-- body.
function section(values)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = values .. "\n", timeout_ms = 900000, whole = 4000000})
  local ls = {"=== " .. join(lines(values), " ") .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for values in cases() do push(all, section(values).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for values in cases() do
    n = n + 1
    local got = section(values)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      print("FAIL " .. head)
      local shown = 0
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. head .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
