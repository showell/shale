-- cookbook/c/map_file/check_goldens.shale: map_file (the Roc script beside
-- this, map_file.roc, through its launcher cookbook/c/map_file.shale) held to
-- its goldens, goldens.txt beside this, line for line and exit code for exit
-- code. From the shale checkout's root:
--
--   shale cookbook/c/map_file/check_goldens.shale self_test=1
--   shale cookbook/c/map_file/check_goldens.shale write=1
--
-- The cases are the self-test, each plant file mapped (the shape breaks
-- among them, each a stop), each plant folder split as a tree (map_file's
-- own stops at its first break), and the two ways of giving neither or both
-- of `file=` and `tree=`. The goldens were written from the Shale original's
-- output on them, and the port matched the original on Shale's own C too
-- (`tree=c`, `tree=c/host`, and `file=` each of c/'s 99 files), which is left
-- out because that code moves. A case left out: a `file=` that is not there,
-- whose stop has the Roc's own words (the original's was `read`'s).
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines, the `called from` lines, and the
-- launchers' own stops (run.shale's `run: ...`, this recipe's launcher's). A
-- stop's line is held by its words, not its place (`── stop: <words>`).
-- `write=1` writes the goldens again from the launcher, for a change meant
-- to move them: `git diff` shows what moved.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/c/map_file.shale"
const GOLDENS = "cookbook/c/map_file/goldens.txt"
const PLANTS = "cookbook/c/plants/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- Each case's values, one a line, as the launcher's stdin.
function cases()
  local c = {"self_test=1", "", "file=" .. PLANTS .. "map_file/kinds.c\ntree=" .. PLANTS .. "map_file"}
  for f in {"map_file/kinds.h", "map_file/kinds.c", "find_dead_code/lib.c", "find_dead_code/lib.h", "find_dead_code/main.c", "find_dead_code/test.h", "find_dead_code/vec.h", "find_clones/clones.c", "list_deep_nesting/depths.c", "list_long_functions/lengths.c"} do
    push(c, "file=" .. PLANTS .. f)
  end
  for f in {"bad_generator.c", "bad_test.c", "column0.c", "in_body.c", "indented.c", "no_endif.h", "no_guard.h", "unclosed.c", "wrapped_head.c"} do
    push(c, "file=" .. PLANTS .. "map_file/breaks/" .. f)
  end
  for d in {"map_file", "map_file/breaks", "find_dead_code", "find_clones", "hunt_names", "list_deep_nesting", "list_long_functions"} do
    push(c, "tree=" .. PLANTS .. d)
  end
  return c
end

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at (?:the (?:Linux )?prelude:[0-9]+:[0-9]+|[^ ]+)(?: \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: map_file: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- One case's run, as its golden section: `=== <values> (exit N)` and its
-- body.
function section(values)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = values .. "\n", timeout_ms = 900000, whole = 4000000})
  local ls = {"=== " .. join(lines(values), " ") .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for values in cases() do push(all, section(values).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for values in cases() do
    n = n + 1
    local got = section(values)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      print("FAIL " .. head)
      local shown = 0
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. head .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
