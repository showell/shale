-- cookbook/c/list_long_functions/check_goldens.shale: list_long_functions
-- (the Roc script beside this, list_long_functions.roc, through its
-- launcher cookbook/c/list_long_functions.shale) held to its goldens,
-- goldens.txt beside this, line for line and exit code for exit code. From
-- the shale checkout's root:
--
--   shale cookbook/c/list_long_functions/check_goldens.shale self_test=1
--   shale cookbook/c/list_long_functions/check_goldens.shale write=1
--
-- The cases are the self-test, then each plant folder (map_file's breaks
-- among them, each a stop) at the default threshold, `tests=1`, `over=3`,
-- `over=4`, `over=6 tests=1` and `over=1000`. The goldens were written from
-- the Shale original's output on them, and the port matched the original on
-- Shale's own C too (`dir=c` alone, with `tests=1` and with `over=40`,
-- `dir=c/host`, and `dir=c/script tests=1 over=20`), which is left out
-- because that code moves. Cases left out: a value that is no integer and a
-- `dir=` that is not there, whose stops have the Roc's own words.
--
-- What is held: the exit code, and the output with each runner's own lines
-- left out: Shale's `──` report lines, the `called from` lines, and the
-- launchers' own stops (run.shale's `run: ...`, this recipe's launcher's). A
-- stop's line is held by its words, not its place (`── stop: <words>`).
-- `write=1` writes the goldens again from the launcher, for a change meant
-- to move them: `git diff` shows what moved.
-- budget: programs=200 steps=200000000 arena_bytes=1000000000 output_bytes=1000000

const LAUNCHER = "cookbook/c/list_long_functions.shale"
const GOLDENS = "cookbook/c/list_long_functions/goldens.txt"
const PLANTS = "cookbook/c/plants/"
const SELF_TEST = arg("self_test", "") == "1"
const WRITE = arg("write", "") == "1"
if SELF_TEST == WRITE then fail("check_goldens: self_test=1 holds the goldens, write=1 writes them; one of the two") end

-- Each case's values, one a line, as the launcher's stdin.
function cases()
  local c = {"self_test=1"}
  for d in {"list_long_functions", "list_deep_nesting", "find_clones", "find_dead_code", "hunt_names", "map_file/breaks", "map_file"} do
    for v in {"", "\ntests=1", "\nover=3", "\nover=4", "\nover=6\ntests=1", "\nover=1000"} do push(c, "dir=" .. PLANTS .. d .. v) end
  end
  return c
end

-- A run's output with each runner's own lines left out, and a stop's line
-- cut to its words.
function body(out)
  local kept = {}
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then
      local words_of = re_replace(re_replace(l, " \\([0-9]+ steps\\)$", ""), "^── stopped at (?:the (?:Linux )?prelude:[0-9]+:[0-9]+|[^ ]+)(?: \\(in `[^`]*`\\))?: ", "")
      if not starts_with(words_of, "fail: run: ") and not starts_with(words_of, "fail: list_long_functions: the Roc program stopped") then push(kept, "── stop: " .. words_of) end
    elseif not starts_with(l, "── ") and not starts_with(l, "   called from") then
      push(kept, l)
    end
  end
  return kept
end

-- One case's run, as its golden section: `=== <values> (exit N)` and its
-- body.
function section(values)
  local r = run({"shale", LAUNCHER, "--args-stdin"}, {stdin = values .. "\n", timeout_ms = 900000, whole = 4000000})
  local ls = {"=== " .. join(lines(values), " ") .. " (exit " .. r.code .. ")"}
  for l in body(r.out) do push(ls, l) end
  return {text = join(ls, "\n"), ms = r.ms}
end

-- The goldens' sections by their first line.
function golden_sections()
  local by = {}
  local head = nil
  local ls = {}
  for l in lines(read(GOLDENS)) do
    if starts_with(l, "=== ") then
      if head ~= nil then by[head] = join(ls, "\n") end
      head = l
      ls = {l}
    else
      push(ls, l)
    end
  end
  if head ~= nil then by[head] = join(ls, "\n") end
  return by
end

if WRITE then
  local all = {}
  for values in cases() do push(all, section(values).text) end
  replace(GOLDENS, join(all, "\n") .. "\n")
  print("check_goldens: wrote " .. #all .. " cases to " .. GOLDENS)
else
  local golden = golden_sections()
  local wrong = 0
  local n = 0
  for values in cases() do
    n = n + 1
    local got = section(values)
    local head = lines(got.text)[1]
    local want = get(golden, head, nil)
    if want == nil then
      -- The head holds the exit code, so a changed code is a missing head.
      print("FAIL " .. head .. ": no golden of that name and exit code")
      wrong = wrong + 1
    elseif want ~= got.text then
      local a = lines(want)
      local b = lines(got.text)
      print("FAIL " .. head)
      local shown = 0
      for k = 1, max(#a, #b) do
        local x = get(a, k, "<none>")
        local y = get(b, k, "<none>")
        if x ~= y and shown < 5 then
          print("  line " .. k .. ":\n    golden: " .. x .. "\n    got:    " .. y)
          shown = shown + 1
        end
      end
      wrong = wrong + 1
    else
      print("ok   " .. head .. " (" .. got.ms .. " ms)")
    end
  end
  if wrong > 0 then fail("check_goldens: " .. wrong .. " of " .. n .. " cases differ from " .. GOLDENS) end
  print("check_goldens: all " .. n .. " cases match " .. GOLDENS)
end
