-- Maps a file of Shale's C: each top-level item, one a line, as
-- `first-last kind name`, from the splitter the C recipes share, which
-- reads the dialect c/check_discipline.shale holds (cookbook/c/items/, a Roc
-- package; its Item.roc has the kinds and what each item carries).
--
--   shale cookbook:c/map_file.shale file=c/script/vm.c
--   shale cookbook:c/map_file.shale tree=c         every .c and .h under c/
--                                                  (c/out left out) split,
--                                                  each line accounted for
--   shale cookbook:c/map_file.shale self_test=1    the plants
--
-- `tree=` splits every file and proves the split: each line is in exactly
-- one item, or blank, or a `//` comment line between items, and it prints
-- one line, the files, lines and items by kind. A line the dialect does not
-- account for stops the run naming its file and line, in either mode.
--
-- `self_test=1` maps the plants in cookbook/c/plants/map_file/ (a header and
-- a .c file holding an item of each kind) and holds each to its map, its
-- comments, heads, bodies and uses, then splits each plant in breaks/,
-- which must stop naming its file and the line it breaks.
--
-- It is written in Roc, the app cookbook/c/map_file/map_file.roc and
-- SelfTest beside it, over the splitter package cookbook/c/items/, on
-- Shale's Roc platform (roc_platform/README.md); this file is its launcher.
-- It hands every value it is given to roc_platform/run.shale in the checkout
-- this cookbook is in (the `cookbook` mount's parent), which builds the Roc
-- there (cached; the first build after a change to C Shale compiles the
-- platform's host, 25 to 50 s) and runs the program rooted here, so `file=`
-- and `tree=` are this root's paths. A value the Roc reads no `Shale.arg!` of
-- stops the run before anything is built. `reads=inputs` builds and runs
-- nothing, and prints the real path of each file the program is built from
-- (run.shale's header). It is built with `opt=speed`: the masker reads a
-- line a byte at a time, and Roc's dev build took 0.6 s of CPU over
-- `tree=c` where the Shale original took 0.15 s; the speed build takes
-- 0.08 s, for about 12 s of build once, then cached (measured on Roc
-- nightly-2026-11-03-34bd006). A stop in a speed
-- build names the platform's driver, not the Roc's line. Its goldens, the
-- Shale original's output on the plants, are held by
-- cookbook/c/map_file/check_goldens.shale. The Shale splitter it was
-- ported from is c/build/c_items.shale now, the fast tier's discipline's.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/c/map_file/map_file.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE, "opt=speed"}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("map_file: the Roc program stopped (exit " .. r.code .. ")") end
