-- Hunts Shale's C for names that break c/docs/style.md's "Names" or say
-- too little, from the splitter the C recipes share (cookbook/c/items/, a
-- Roc package). A finding is a question for a reader, never a verdict.
-- The first version is small, each check narrow enough that its findings
-- are worth reading:
--
--   type_case       a type (a struct, union, typedef or tagged enum) not
--                   `PascalCase`; an anonymous enum is constants, no type
--   function_case   a function not `snake_case`
--   constant_case   an enum's constant not `UPPER_SNAKE`
--   zig_bound       a constant or macro with Zig's bound words, `MOST` or
--                   `LEAST`: C's are `_MAX` and `_MIN`
--   bound_order     a constant or macro whose `MAX` or `MIN` is not its last
--                   word (`STORE_MAX_NAME`, not `STORE_NAME_MAX`), a unit
--                   after it (`_MS`, `_BYTES`) left alone
--   vague           a function named of nothing but cookbook/words/vague.txt's
--                   words (`handle_data`); a lone `run` or `handle` is an
--                   entry point's, and a piece's noun before a vague word
--                   (`json_value`, `vm_run`) is no finding
--   do_word         a function with the word `do` in its name, which says
--                   only that it acts
--   vague_local     a local or parameter named only `data`, `info`, `tmp`,
--                   `temp`, `stuff`, `thing`, `things`, `misc`, `util`,
--                   `helper`, `obj` or `handle`
--   container_type  a type named of nothing but container words
--                   (cookbook/words/containers.txt, and `data`, `info`):
--                   `Entry`, `NodeInfo`; a type is named for what it holds
--   abbreviation    a top-level name with a word of
--                   cookbook/words/c_abbreviations.txt whose spelled-out
--                   word another top-level name of the tree uses: one thing,
--                   two spellings (`bi_split` beside `builtin_scan`); one
--                   finding a file and abbreviation, naming its names
--
-- One line a finding, `path:line: check: why`, then the counts by check and
-- by folder.
--
--   shale cookbook:c/hunt_names.shale             over c/
--   shale cookbook:c/hunt_names.shale dir=c/host
--   shale cookbook:c/hunt_names.shale self_test=1
--
-- `self_test=1` runs it over cookbook/c/plants/hunt_names/, each plant named
-- for the check it holds (`do_word.c`), each near miss in `quiet_<check>.c`,
-- and holds the findings to the plants' list exactly: every check fires on
-- its own plant and on no other, and a quiet plant on none.
--
--
-- It is written in Roc, the app cookbook/c/hunt_names/hunt_names.roc and
-- the modules beside it (Checks, a file's checks; Names and Declared, a
-- name's words and cases and the names a function declares; Abbreviation,
-- the tree's names; SelfTest, the plants' check), over the splitter package
-- cookbook/c/items/, on Shale's Roc platform (roc_platform/README.md); this
-- file is its launcher. It hands every value it is given to
-- roc_platform/run.shale in the checkout this cookbook is in (the `cookbook`
-- mount's parent), which builds the Roc there (cached; the first build after
-- a change to C Shale compiles the platform's host, 25 to 50 s) and runs the
-- program rooted here, so `dir=` is this root's path, and the word tables
-- are read through the `cookbook` mount. A value the Roc reads no
-- `Shale.arg!` of stops the run before anything is built. `reads=inputs`
-- builds and runs nothing, and prints the real path of each file the
-- program is built from (run.shale's header). It is built with
-- `opt=speed`, as the other C recipes are: the splitter's masker reads a
-- line a byte at a time, which Roc's dev build does several times slower
-- than the Shale original's regular expressions; a stop in a speed build
-- names the platform's driver, not the Roc's line. Its goldens, the Shale
-- original's output on the plants, are held by
-- cookbook/c/hunt_names/check_goldens.shale.
-- budget: programs=10 output_bytes=8000000

const SCRIPT = "cookbook/c/hunt_names/hunt_names.roc"
const CHECKOUT = dirname(dirname(real("cookbook:README.md")))
const HERE = real(".")

-- `self_test` is read here by name, as the cookbook's full tier finds the
-- recipes it runs `self_test=1` of. `arg_names()` is every value given; the
-- rest are read by a name made as the run goes, so Shale's own check cannot
-- see them: run.shale holds them to the script's reads.
const SELF_TEST = arg("self_test", "")
local values = {"script=" .. SCRIPT, "in=" .. HERE, "opt=speed"}
if SELF_TEST ~= "" then push(values, "self_test=" .. SELF_TEST) end
for name in arg_names() do
  if name ~= "self_test" then push(values, name .. "=" .. arg(name, "")) end
end
local r = run({"shale", "--root", CHECKOUT, CHECKOUT .. "/roc_platform/run.shale", "--args-stdin"}, {stdin = join(values, "\n") .. "\n", timeout_ms = 1800000, whole = 8000000})
print(trim_end(r.out))
if r.code ~= 0 then fail("hunt_names: the Roc program stopped (exit " .. r.code .. ")") end
