-- This recipe runs a build on GitHub instead of on the box. It dispatches a
-- `workflow_dispatch` workflow for `ref`, and says the run's URL and id at
-- once. Given that id, it checks the run: its status, or once the run is
-- done, PASS or FAIL with its wall time, and for a failure the last 40 log
-- lines (`gh run view --log-failed`), failing the launch. Shale's workflows
-- never run on a push, a PR or a schedule, only when asked:
--   test.yml     Zig Shale's `zig build test` in legacy_zig/ (the default);
--   c-full.yml   C Shale's full tier, `shale c/build.shale full=1`, on a
--                runner that builds its first `shale` from C; its PASS
--                says the tier's own last lines (`PASS full` and its wall
--                time), and its whole output is the run's `c-full-log`
--                artifact (`gh run download <id> -n c-full-log`).
--
--   cd <repo> && shale cookbook:build_on_github.shale ref=my-branch
--   shale cookbook:build_on_github.shale workflow=c-full.yml ref=my-branch
--   shale cookbook:build_on_github.shale workflow=c-full.yml ref=my-branch plants=all
--   shale cookbook:build_on_github.shale run=40518919602
--   shale cookbook:build_on_github.shale ref=master wait=yes
--
-- **gh runs confined** (Landlock, c/host/host_confine.c), so its own
-- configuration under the home, and the token in it, is closed to it. Its
-- token comes from `token`, a file in a secrets mount (`keys:github-token`
-- unless named), handed to each `gh` as GH_TOKEN by `run`'s `secrets`
-- (scrubbed from what it prints, a part of it too), and its configuration
-- folder (GH_CONFIG_DIR) is the host's, an empty one of the run's own: a
-- script's `env` sets neither, and `gh auth` is refused. The token needs
-- Actions read and write on the repo, for the dispatch and the logs.
--
-- `repo` is showell/<repo> (default shale), `ref` the branch, tag or
-- commit the workflow checks out (default the branch checked out here),
-- `workflow` its file (default test.yml), `plants` c-full.yml's `plants`
-- input (`all` runs every plant; unset, none). A dispatch is 3 or 4 programs
-- and a few seconds; `run=<id>` is one look, no waiting. `wait=yes`
-- dispatches and polls every `every` seconds (default 15) until the run
-- is done: it is for a background task, whose exit says the verdict. Each
-- look is one program, so a wait is at most the run's `programs` budget of
-- looks (1,000 unset, about four hours at 15 s).
--
-- budget: steps=50000000

const REPO = arg("repo", "shale")
const REF = arg("ref", "")
const WORKFLOW = arg("workflow", "test.yml")
const WAIT = arg("wait", "no")
const RUN = arg("run", "")
const EVERY = arg("every", 15)
const PLANTS = arg("plants", "")
const TOKEN = arg("token", "keys:github-token")

not_option("build_on_github", "repo", REPO)
not_option("build_on_github", "ref", REF)
not_option("build_on_github", "workflow", WORKFLOW)
not_option("build_on_github", "run", RUN)
if WAIT ~= "yes" and WAIT ~= "no" then fail("build_on_github: `wait` is yes or no, not " .. WAIT) end
if PLANTS ~= "" and (PLANTS ~= "all" or WORKFLOW ~= "c-full.yml") then fail("build_on_github: `plants` is `all`, for workflow=c-full.yml alone, not " .. PLANTS .. " for " .. WORKFLOW) end
const SLUG = "showell/" .. REPO

-- A `gh` program's output, trimmed; its failure fails the launch. `USED.n`
-- counts them, for the summary.
const USED = {n = 0}
function gh(argv)
  USED.n = USED.n + 1
  local o = {tail = 40, timeout_ms = 60000}
  if argv[1] == "gh" then o.secrets = {GH_TOKEN = TOKEN} end
  local r = run(argv, o)
  if not has_key(r, "code") or r.code ~= 0 then fail("build_on_github: `" .. join(argv, " ") .. "` failed:\n" .. r.out) end
  return trim(r.out)
end

-- These calls use GitHub's REST API. `gh workflow run` and `gh run list`
-- ask GraphQL, which a Claude Code session is refused; `gh api` on
-- the REST paths works wherever `gh` does.

-- The newest dispatched run's id, or "" when there is none.
function newest_run_id()
  return gh({"gh", "api", "repos/" .. SLUG .. "/actions/workflows/" .. WORKFLOW .. "/runs?event=workflow_dispatch&per_page=1", "-q", ".workflow_runs[0].id // \"\""})
end

-- The workflow dispatched on `ref`, and its run's id once listed.
function dispatch(ref)
  local before = newest_run_id()
  -- The workflow's own file is the default branch's; `ref` is its input,
  -- the commit it checks out.
  local home = gh({"gh", "api", "repos/" .. SLUG, "-q", ".default_branch"})
  local argv = {"gh", "api", "-X", "POST", "repos/" .. SLUG .. "/actions/workflows/" .. WORKFLOW .. "/dispatches", "-f", "ref=" .. home, "-f", "inputs[ref]=" .. ref}
  if PLANTS ~= "" then
    push(argv, "-f")
    push(argv, "inputs[plants]=" .. PLANTS)
  end
  gh(argv)
  -- The dispatch answers before the run is listed: a new id is this one.
  local id = before
  local looks = 0
  while id == before do
    looks = looks + 1
    if looks > 10 then fail("build_on_github: no new " .. WORKFLOW .. " run listed for " .. SLUG .. " after 10 looks") end
    sleep(2000)
    id = newest_run_id()
  end
  return id
end

-- "status conclusion seconds url path", conclusion "-" while it runs;
-- the seconds from its start to its end, or to now while it runs
-- (`updatedAt` stands still then); `path` the workflow's file.
const SAY = "\"\\(.status) \\(.conclusion // \"-\") \\((if .status == \"completed\" then (.updated_at | fromdate) else now end) - (.run_started_at | fromdate) | floor) \\(.html_url) \\(.path)\""
function look(id)
  local w = {}
  for x in words(gh({"gh", "api", "repos/" .. SLUG .. "/actions/runs/" .. id, "-q", SAY})) do push(w, x) end
  return {id = id, status = w[1], conclusion = w[2], secs = w[3], url = w[4], path = (#w >= 5 and w[5]) or ""}
end

-- A run's verdict: its status while it runs, PASS, or FAIL with its log's
-- tail, failing the launch.
function verdict(v)
  if v.status ~= "completed" then
    print(v.status .. " after " .. v.secs .. " s: " .. v.url .. " (run " .. v.id .. ")")
  elseif v.conclusion == "success" then
    -- c-full.yml's PASS says the tier's own verdict and wall time, from its log.
    if ends_with(v.path, "/c-full.yml") then
      local r = run({"gh", "run", "view", v.id, "--repo", SLUG, "--log"}, {tail = 4, timeout_ms = 60000, re = "PASS full$|full tier: [0-9]+ s of wall time", secrets = {GH_TOKEN = TOKEN}})
      for l in lines(r.out) do print("   " .. sub(l, 1, 240)) end
    end
    print("PASS in " .. v.secs .. " s: " .. v.url)
  else
    local r = run({"gh", "run", "view", v.id, "--repo", SLUG, "--log-failed"}, {tail = 40, timeout_ms = 60000, secrets = {GH_TOKEN = TOKEN}})
    for l in lines(r.out) do print("   " .. sub(l, 1, 240)) end
    print("FAIL (" .. v.conclusion .. ") in " .. v.secs .. " s: " .. v.url)
    fail("build_on_github: run " .. v.id .. " " .. v.conclusion)
  end
end

if RUN ~= "" then
  verdict(look(RUN))
else
  local ref = REF
  if ref == "" then
    ref = gh({"git", "branch", "--show-current"})
    if ref == "" then fail("build_on_github: no branch checked out here: say `ref=`") end
  end
  local id = dispatch(ref)
  if WAIT == "no" then
    print("dispatched: https://github.com/" .. SLUG .. "/actions/runs/" .. id .. " (run " .. id .. ", " .. WORKFLOW .. " on " .. ref .. ")")
  else
    local v = look(id)
    print("waiting on " .. v.url .. " (" .. ref .. ")")
    while v.status ~= "completed" do
      -- One program is kept for a failure's log.
      if budget().programs < 2 then fail("build_on_github: still " .. v.status .. " after " .. v.secs .. " s, and this run's `programs` budget is spent (`--budget programs=N` raises it): " .. v.url) end
      sleep(EVERY * 1000)
      v = look(id)
    end
    verdict(v)
  end
end
