-- Tests the time-history library on canned `run` results:
--
--   shale cookbook:test_times.shale self_test=1
--
-- `timed_run` itself, over a real program and a real `build:` mount, is
-- src/shale_cli_test.zig's.

use("cookbook:times.shale")

function ran(cpu_ms)
  return {ended = "exit", code = 0, cpu_ms = cpu_ms, ms = cpu_ms + 7}
end

function expect(what, got, want)
  if got ~= want then fail("times: " .. what .. ": got `" .. got .. "`, wanted `" .. want .. "`") end
end

function stage_count(path, stage)
  local n = 0
  for row in times_rows(path) do
    if row.stage == stage then n = n + 1 end
  end
  return n
end

function reads_broken(path)
  return times_rows(path)
end

if not arg("self_test", false) then fail("test_times: only `self_test=1`, there is nothing else to check") end

-- What is said, at and around each edge: half as much again, and a second.
expect("the example", times_change("build.sh safari", 35000, 192000), "build.sh safari: 192 s, was 35 s (5.5x)")
expect("1.5x slower", times_change("s", 2000, 3000), "s: 3.0 s, was 2.0 s (1.5x)")
expect("under 1.5x slower", times_change("s", 2000, 2999), "")
expect("1.5x faster", times_change("s", 3000, 2000), "s: 2.0 s, was 3.0 s (1.5x faster)")
expect("under 1.5x faster", times_change("s", 3000, 2001), "")
expect("a second more", times_change("s", 1000, 2000), "s: 2.0 s, was 1.0 s (2.0x)")
expect("under a second more", times_change("s", 1000, 1999), "")
expect("a large ratio under a second", times_change("s", 10, 900), "")
expect("no change", times_change("s", 5000, 5000), "")
expect("from nothing", times_change("s", 0, 2000), "s: 2.0 s, was 0.0 s")
expect("to nothing", times_change("s", 2000, 0), "s: 0.0 s, was 2.0 s")
expect("the seconds' edge", times_seconds(9949) .. " " .. times_seconds(9950) .. " " .. times_seconds(10000), "9.9 s 10.0 s 10 s")

expect("a cold run's line", times_cold_line("s", ran(192000)), "s: cold, 192 s, not judged")

-- The middle: a lone slow run is not the usual time, three in five are.
expect("the middle of two", tostring(times_middle({35000, 192000})), "35000")
expect("the middle of three", tostring(times_middle({192000, 35000, 40000})), "40000")

local dir = fresh_dir("scratch:", "times")
local p = dir .. "/check.tsv"

-- The first run has nothing to be compared with, and is kept.
expect("the first run", times_note(p, "build", ran(35000)), "")
expect("what it kept", tostring(stage_count(p, "build")), "1")
expect("the second run", times_note(p, "build", ran(192000)), "build: 192 s, was 35 s (5.5x)")
-- One slow run left the usual time alone.
expect("after one slow run", times_note(p, "build", ran(35000)), "")

-- A run that failed counts for nothing, either side of a compare.
expect("a failed run", times_note(p, "build", {ended = "exit", code = 1, cpu_ms = 500000, ms = 500000}), "")
expect("a run timed out", times_note(p, "build", {ended = "timeout", cpu_ms = 500000, ms = 500000}), "")
expect("they were not kept", tostring(stage_count(p, "build")), "3")

-- Stages are held apart, and each keeps its last five.
expect("another stage's first run", times_note(p, "test", ran(90000)), "")
for i = 1, 7 do times_note(p, "build", ran(35000 + i)) end
expect("five kept", tostring(stage_count(p, "build")), "5")
expect("the other stage kept", tostring(stage_count(p, "test")), "1")
local oldest = 0
for row in times_rows(p) do
  if row.stage == "build" and oldest == 0 then oldest = row.cpu_ms end
end
expect("the oldest went", tostring(oldest), "35003")

-- The file reads as a table: a header, then a line a time.
local text = lines(read(p))
expect("the header", text[1], "when\tstage\tcpu_ms\tms")
expect("its fields", tostring(#split(text[2], "\t")), "4")

-- A file that is not this shape stops the run, and is left as it was.
local broken = dir .. "/broken.tsv"
replace(broken, "when\tstage\tcpu_ms\tms\nnot a row\n")
expect("a broken row", attempt(reads_broken, broken).error, "times: " .. broken .. ":2 is not four fields: not a row")
replace(broken, "someone else's file\n")
expect("a foreign file", attempt(reads_broken, broken).error, "times: " .. broken .. " does not start with its header")

-- The book and the stage are names.
expect("a plain book", times_path("safari"), "build:times/safari.tsv")
expect("a book with a path", attempt(times_path, "a/b").class, "fail")
expect("a book with a mount", attempt(times_path, "m:b").class, "fail")

remove_tree(dir)
print("times self_test: PASS (each edge of a change, the middle, failed runs, stages apart, five kept, a broken file stops)")
