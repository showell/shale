-- **A SEALED VALUE IS MADE BY ITS CHECK ALONE** (metal-vmm QUEUE 250): a
-- value checked once and passed on as a type only its check can make, so a
-- caller that skips the check does not compile. Zig has no private fields,
-- so such a type carries a seal, a field of size zero that only its own
-- file sets:
--
--     pub const Id = struct { text: []const u8, id_seal: Seal = undefined };
--
-- is wrong (a default makes the seal anyone's); it is
--
--     const Seal = struct {};
--     pub const Id = struct {
--         text: []const u8,
--         id_seal: Seal,
--         pub fn of(s: []const u8) ?Id { ...; return .{ .text = s, .id_seal = .{} }; }
--     };
--
-- A literal without the seal does not compile; this refuses one that sets
-- it, `.id_seal =` read from Zig's tokens (a string or a comment is never
-- code), anywhere but the seal's own file, its tests too.
--
--   shale cookbook:sealed.shale dir=zig-server/src seals=id_seal:player.zig,uid_seal:users.zig
--
-- A seal's file is named from `dir`. One line a finding, then PASS or a FAIL
-- that stops the run. What it cannot see: `@bitCast`, `std.mem.zeroes` or
-- `undefined` for a whole value; each is a review's to refuse.

const DIR = arg("dir", "")
const SEALS = arg("seals", "")

if DIR == "" or SEALS == "" then fail("sealed: say `dir=<tree>` and `seals=field:file,...`") end
-- `dir=.` is the root, whose paths carry no folder before them.
const PREFIX = DIR == "." and "" or DIR .. "/"

local owner = {}
for s in split(SEALS, ",") do
  local parts = split(trim(s), ":")
  if #parts ~= 2 or parts[1] == "" or parts[2] == "" then fail("sealed: `" .. s .. "` is not `field:file`") end
  if not exists(PREFIX .. parts[2]) then fail("sealed: " .. parts[1] .. "'s file " .. PREFIX .. parts[2] .. " is not there") end
  owner[parts[1]] = parts[2]
end

-- The seals `path` sets outside their own file, a line each; how many.
function scan(path, rel, owner)
  -- Zig's tokens only for a file that names a seal at all.
  local text = read(path)
  local named = false
  for field in keys(owner) do
    if find(text, field) ~= nil then named = true end
  end
  if not named then return 0 end
  local found = 0
  local p2 = nil
  local p1 = nil
  for t in zig_tokens(path) do
    if p2 ~= nil and p2.tag == "period" and p1.tag == "identifier" and t.tag == "equal" and has_key(owner, p1.text) and owner[p1.text] ~= rel then
      print("FAIL " .. rel .. ":" .. t.line .. ": sets `" .. p1.text .. "`, which only " .. owner[p1.text] .. " may")
      found = found + 1
    end
    p2 = p1
    p1 = t
  end
  return found
end

local found = 0
local files = 0
for e in walk_all(DIR, {like = "*.zig"}) do
  if e.kind == "file" then
    files = files + 1
    found = found + scan(e.path, sub(e.path, #PREFIX + 1), owner)
    -- A file's tokens are done with: a tree of any size fits.
    yield()
  end
end
if found > 0 then fail("sealed: FAIL: " .. found .. " seal(s) set outside their file: make the value with its check") end
print("sealed: PASS (" .. files .. " files)")
