-- **A ZULIP TOPIC, READ**: the newest `num` messages (default 100) of
-- one stream's topic, oldest first, each as its sender and its markdown as
-- written. The API key stays in a secrets mount: `run`'s `secrets` gives it
-- to curl alone, which reads it from its environment (`--variable`), so no
-- script sees it and it never reaches the output.
--
--   shale cookbook:zulip.shale site=roc.zulipchat.com email=you@example.com key=keys:roc_zulip_api_key stream=beginners topic=roc style guide
--
-- (A value with a space works on the launch line only through
-- `--args-stdin`, one `NAME=VALUE` a line.) `site` is the realm's host,
-- `email` the account the key belongs to, `key` a secrets-mount path to a
-- file holding only the key. The body lands in a folder of this run's own
-- under `scratch:` first, removed after; a status other than 200, or a `result` other than `success`,
-- fails the launch with Zulip's own message.
--
-- budget: steps=50000000 arena_bytes=500000000

const SITE = arg("site", "")
const EMAIL = arg("email", "")
const KEY = arg("key", "")
const STREAM = arg("stream", "")
const TOPIC = arg("topic", "")
const NUM = arg("num", 100)

if SITE == "" or EMAIL == "" or KEY == "" or STREAM == "" or TOPIC == "" then
  fail("zulip: site=, email=, key=keys:<file>, stream= and topic= are each needed")
end

-- A JSON string's quotes and backslashes escaped, for the narrow.
function quoted(s)
  return "\"" .. substitute(substitute(s, "\\", "\\\\"), "\"", "\\\"") .. "\""
end

local scratch = fresh_dir("scratch:", "zulip")
local BODY = scratch .. "/topic.json"
local narrow = "[{\"operator\":\"channel\",\"operand\":" .. quoted(STREAM) .. "},{\"operator\":\"topic\",\"operand\":" .. quoted(TOPIC) .. "}]"
local r = run({"curl", "-sS", "-G", "https://" .. SITE .. "/api/v1/messages",
  "--variable", "%ZULIP_KEY",
  "--expand-user", EMAIL .. ":{{ZULIP_KEY}}",
  "--data-urlencode", "narrow=" .. narrow,
  "--data-urlencode", "anchor=newest",
  "--data-urlencode", "num_before=" .. NUM,
  "--data-urlencode", "num_after=0",
  "--data-urlencode", "apply_markdown=false",
  "-o", real(BODY), "-w", "%{http_code}"},
  {timeout_ms = 60000, whole = 2000, secrets = {ZULIP_KEY = KEY}})
if r.code ~= 0 then remove_tree(scratch) fail("zulip: curl exited " .. r.code .. ": " .. r.out) end

local j = json_read(read(BODY))
remove_tree(scratch)
if r.out ~= "200" or j.result ~= "success" then
  fail("zulip: " .. SITE .. " answered " .. r.out .. ": " .. get(j, "msg", "(no message)"))
end

local reach = ", the newest " .. NUM
if j.found_oldest then reach = ", from the first" end
print("#" .. STREAM .. " > " .. TOPIC .. ": " .. #j.messages .. " messages" .. reach)
for m in j.messages do
  print("---- " .. m.sender_full_name .. " (message " .. m.id .. ")")
  print(m.content)
end
