-- c/check_discipline.shale: holds the C under c/ to the rules C itself won't,
-- the ones of c/docs/style.md a line-by-line reading can hold:
--   alloc:      no malloc, free, calloc or realloc (nor aligned_alloc, strdup,
--               strndup) outside c/foundation/arena.h;
--   raw index:  no `[i]` index of anything (a slice's `ptr`, a field, a local
--               array), and no `*(s.ptr + i)`, outside c/foundation/slice.h:
--               `at(s, i)`, or `at_unchecked(s, i, "why")` where a loop has
--               proved its bounds; an array's size in its declaration
--               (`char digits[20];`) is no index;
--   mem arithmetic: no `+` or `-` in a mem* call's arguments
--               (`memcpy(b->ptr + n, ...)`) outside c/foundation/, where each
--               such call has a `DRAGON:` in the comment block above it; a
--               checked part (`&at(s, i)`, a SLICE_SUB's `ptr`) needs neither;
--   slice args: no `++`, `--`, `=` or call in a SLICE_SUB's arguments, which
--               it evaluates more than once;
--   must use:   a function returning `Status` is `STATUS_MUST_USE`, so GCC
--               refuses an answer left unused;
--   fail brace: no `run_fail(` whose string literal holds `{` or `}`: a stop
--               whose Zig format escapes a brace goes through `run_failf` or
--               `path_fail`, so an arena that refuses shows the raw format,
--               as Zig's does (docs/C-SEAMS.md, "A stop is err.h's
--               `RunCtx`"); the call's literal on its own line is judged;
--   cstr:       no `char *` parameter or field in a header without its length:
--               a field `ptr` with `size_t len` on the next line, or a
--               `// cstr: <why>` on the line itself;
--   one per line: no two declarations in one statement (`int a, b;`);
--   wrapped:    a declaration with `=` ends its line, with `;` (or `{`, for
--               an initializer of a line an item);
--   brace:      an opening brace ends the line that opens it, never a line of
--               its own, and `else` follows its `}` on the same line;
--   tab:        no tab: four spaces a level;
--   comment:    `//` comments, `/* */` only inside a macro (a line ending `\`);
--   top level:  a line at column 0 starts one of the openings in TOP below
--               (`int main(` the command's, c/shale.c, or a test fixture's), or closes one,
--               so a reader splits a file into its items;
--   inline:     a function in a header is `static inline`;
--   header:     a header's first line is `// <its name>: `, its guard
--               `SHALE_<NAME>_H`, and its last line `#endif`;
--   return size: no function returns a struct of 9 to 15 bytes by value,
--               which TCC 0.9.27 miscompiles when the return goes straight
--               into a call as its argument (style.md, "Declarations"); the
--               C's code is held to it, and c/tests/canaries/, the
--               compiler's canaries, which hold that shape on purpose, is
--               not.
--
-- The comment rules judge a comment: consecutive lines that are whole `//`
-- comment lines, or whole `/* */` lines inside a macro, one kind at a time;
-- a blank line or a line of code ends it.
--   comment wrap:  no `//` comment line runs past 80 columns (a UTF-8
--               character one column). A comment after code on its line is
--               not judged, since the code sets that line's width, and
--               neither is a macro's `/* */` line, padded out to its `\`;
--   dragon remedy: every `DRAGON:` is followed, in its own comment and
--               before the next `DRAGON:`, by a line that starts
--               `REMEDY:`; a `REMEDY:` mid-line answers nothing. A
--               `DRAGON:` in backticks names the marker and is none;
--   zig cite:   no comment cites a Zig file's line (`vm.zig:123`), after
--               code or not; a string's text is not a comment's.
-- **The comment rules are held folder by folder.** The check reports every
-- comment finding, each file's under a line with its count, then a line a
-- folder with its count by rule, and fails on them only in the folders HELD
-- names (`c/foundation`, `c/script`, `c/host`, `c/tests`, or `c/shale.c`).
-- A folder goes into HELD once its comments are clean; a HELD entry that
-- holds no C file stops the check. Every other rule fails wherever it
-- breaks.
--
-- Strings, character literals and comments are not code, so a word in one
-- never counts. A file is judged by its own name (arena.h, slice.h), so the
-- plants below are judged as any file is.
--
-- The return size is the one rule a line can't show, since a type's size is
-- the compiler's to say. Every function starts at column 0 with `static`, so
-- the lines that do are every function there is; a `VEC_DEFINE` or
-- `MAP_DEFINE` line adds the functions it makes (`_make`, `_pop`,
-- `_value_at`). Their return types go into a probe, c/out/returns/probe.c,
-- that includes every module (PROBE_MODULES) and copies in the typedefs of
-- the files it can't include (c/shale.c, which has a `main`, and the tests,
-- each a unit of its own), each file's names given a prefix of its own; TCC
-- runs it, and it prints each type's size. A pointer, an enum or a scalar
-- is at most 8 bytes, so the probe decides those too. It costs about a
-- tenth of a second.
--
-- `self_test=1` writes one plant of each rule, and lines that must pass
-- beside them, to c/out/discipline/ (plant.h and outside.h judged as any
-- file outside the foundation, inside.h as one in it, returns.c through the
-- probe, comments.c for the comment rules), and fails unless exactly the
-- plants are caught.
--
-- Run from the repository's root: shale c/check_discipline.shale
-- budget: steps=100000000

const ALLOC = [=[\b(malloc|free|calloc|realloc|aligned_alloc|strdup|strndup)\s*\(]=]
-- An index: a `[` after a name, a `)` or a `]`, read after each array
-- declaration's size is taken out (ARRAY_DECL); and a pointer's sum deref'd.
const INDEX = [=[[\w)\]]\s*\[]=]
const PTR_SUM = [=[\*\s*\(\s*[A-Za-z_][A-Za-z0-9_.>-]*ptr\s*\+]=]
const ARRAY_DECL = [=[\b(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)(\s+\**\s*\w+)\s*\[[^\]]*\]]=]
const MEM_CALL = [=[\bmem(cpy|move|set|cmp)\s*\(]=]
const SLICE_CALL = [=[\bSLICE_SUB\s*\(]=]
const STATUS_FN = [=[\bstatic\s+(inline\s+)?Status\s+[\w#]+\s*\(]=]
const CHAR_PARAM = [=[[(,]\s*(const\s+)?char\s*\*\s*\w+\s*[,)]]=]
const CHAR_FIELD = [=[^\s*(const\s+)?char\s*\*\s*\w+\s*;]=]
const LEN_FIELD = [=[^\s*size_t\s+len\s*;]=]
-- A declaration whose first declarator is followed by a comma, read after
-- every parenthesized and braced group is emptied.
const TWO_DECLS = [=[^\s*(static\s+)?(const\s+)?(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)\s+\**\s*\w+\s*(\[\w*\])?\s*(=[^,;]*)?,]=]
const DECL_INIT = [=[^\s*(static\s+)?(const\s+)?(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)\s+\**\s*\w+\s*(\[\w*\])?\s*=]=]
-- A UTF-8 continuation byte, which starts no column.
const UTF8_CONT = "[\x80-\xbf]"
-- A Zig file's line cited: `vm.zig:123`, `src/script/vm.zig:1`.
const ZIG_CITE = [=[[\w/.-]*\w\.zig:\d+]=]
-- The comment rules, reported everywhere and held only in HELD's folders.
const COMMENT_RULES = {"comment wrap", "dragon remedy", "zig cite"}
-- The folders (or c/shale.c) whose comment findings fail the check. A sweep
-- adds its folder here once the folder is clean.
const HELD = {"c/foundation", "c/gate", "c/host", "c/script", "c/shale.c", "c/shale_gate.c", "c/tests"}
const TOP = {"//", "#", "static inline ", "static ", "typedef ", "enum ", "SLICE_TYPE(", "VEC_DEFINE(", "MAP_DEFINE(", "TEST(", "TEST_MAIN(", "TEST_PART(", "TEST_PARTS_MAIN(", "_Static_assert(", "int main(", "}", ")"}

-- The line's code: its strings and character literals emptied, its comments cut.
function code_of(line)
  local s = line
  if find(s, "\"") ~= nil then s = re_replace(s, [=["(\\.|[^"\\])*"]=], [=[""]=]) end
  if find(s, "'") ~= nil then s = re_replace(s, [=['(\\.|[^'\\])*']=], "''") end
  if find(s, "/*") ~= nil then s = re_replace(s, [=[/\*[^*]*\*/]=], "") end
  local cut = find(s, "//")
  if cut ~= nil then s = sub(s, 1, cut - 1) end
  return s
end

-- `code` with every parenthesized and braced group made a bare `0`,
-- innermost first, so an outer group empties after its inner ones.
function flattened(code)
  local s = code
  local before = ""
  while s ~= before do
    before = s
    s = re_replace(s, [=[\([^(){}]*\)]=], "0")
    s = re_replace(s, [=[\{[^(){}]*\}]=], "0")
  end
  return s
end

function opens_top(raw)
  for t in TOP do
    if starts_with(raw, t) then return true end
  end
  return false
end

-- The text inside the parentheses that open at `open` in `code`, to their
-- matching close (or the line's end).
function args_at(code, open)
  local depth = 0
  local i = open
  while i <= #code do
    local c = sub(code, i, i)
    if c == "(" then
      depth = depth + 1
    elseif c == ")" then
      depth = depth - 1
      if depth == 0 then return sub(code, open + 1, i - 1) end
    end
    i = i + 1
  end
  return sub(code, open + 1)
end

-- The argument texts of every call in `code` that `pattern` (ending in its
-- `(`) starts.
function calls_args(code, pattern)
  local found = {}
  for m in re_find_all(code, pattern) do push(found, args_at(code, m.at + #m.text - 1)) end
  return found
end

-- Whether the comment block directly above line `n` holds a `DRAGON:`.
function dragon_above(all, n)
  local k = n - 1
  while k >= 1 do
    local t = trim(all[k])
    if not (starts_with(t, "//") or starts_with(t, "/*")) then return false end
    if find(t, "DRAGON:") ~= nil then return true end
    k = k - 1
  end
  return false
end

-- Whether a SLICE_SUB's arguments do what it can't evaluate twice: an
-- increment, a decrement, an assignment or a call.
function slice_args_bad(args)
  if find(args, "++") ~= nil or find(args, "--") ~= nil then return true end
  local plain = re_replace(args, "[=!<>]=", "")
  if find(plain, "=") ~= nil then return true end
  return re_find(args, [=[\w\s*\(]=]) ~= nil
end

-- How many columns `raw` takes: its bytes, a UTF-8 continuation byte
-- counting none, so a banner's `─` is one column, not three.
function columns(raw)
  return #re_replace(raw, UTF8_CONT, "")
end

-- The break of a `DRAGON:` at line `n` that its comment answers with no
-- `REMEDY:` line, `mid` saying whether one came mid-line instead.
function dragon_unanswered(p, n, mid)
  local why = "a `DRAGON:` with no `REMEDY:` line after it in its comment"
  if mid then why = "a `DRAGON:` whose `REMEDY:` is mid-line: it starts a line of its own" end
  return {path = p, line = n, rule = "dragon remedy", text = why}
end

-- The Zig `file.zig:N` the comment on `raw` cites, or nil: the whole line
-- when `whole` says it is a comment line, else what follows its code's `//`
-- (or `/*`), its strings emptied first, so a message's text never counts.
function zig_cited(raw, whole)
  local text = raw
  if not whole then
    local s = raw
    if find(s, "\"") ~= nil then s = re_replace(s, [=["(\\.|[^"\\])*"]=], [=[""]=]) end
    local at = find(s, "//")
    if at == nil then at = find(s, "/*") end
    if at == nil then return nil end
    text = sub(s, at)
  end
  local m = re_find(text, ZIG_CITE)
  if m == nil then return nil end
  return m.text
end

-- Whether the string literals in the arguments that open at `from` in
-- `raw` (just past a `(`) hold a brace, read to the call's close.
function literal_braced(raw, from)
  local depth = 1
  local in_str = false
  local i = from
  while i <= #raw do
    local c = sub(raw, i, i)
    if in_str then
      if c == "\\" then
        i = i + 1
      elseif c == "\"" then
        in_str = false
      elseif c == "{" or c == "}" then
        return true
      end
    elseif c == "\"" then
      in_str = true
    elseif c == "(" then
      depth = depth + 1
    elseif c == ")" then
      depth = depth - 1
      if depth == 0 then return false end
    end
    i = i + 1
  end
  return false
end

-- Whether a `run_fail(` call on `raw`, outside a string, a character literal
-- and a comment, has a brace in a string literal of its arguments.
function fail_braced(raw)
  local in_str = false
  local i = 1
  while i <= #raw do
    local c = sub(raw, i, i)
    if in_str then
      if c == "\\" then
        i = i + 1
      elseif c == "\"" then
        in_str = false
      end
    elseif c == "\"" then
      in_str = true
    elseif c == "'" then
      if sub(raw, i + 1, i + 1) == "\\" then i = i + 1 end
      i = i + 2
    elseif c == "/" and sub(raw, i, i + 1) == "//" then
      return false
    elseif c == "r" and sub(raw, i, i + 8) == "run_fail(" and (i == 1 or re_find(sub(raw, i - 1, i - 1), "\\w") == nil) then
      if literal_braced(raw, i + 9) then return true end
    end
    i = i + 1
  end
  return false
end

-- Each break of the rules in the file at `p`, as {path, line, rule, text}.
-- `in_foundation` says whether it is judged as a foundation header.
function check_file(p, in_foundation)
  local name = basename(p)
  local header = ends_with(p, ".h")
  local all = lines(read(p))
  local found = {}
  if header then
    local guard = "#ifndef SHALE_" .. upper(sub(name, 1, #name - 2)) .. "_H"
    if #all == 0 or not starts_with(all[1], "// " .. name .. ": ") then
      push(found, {path = p, line = 1, rule = "header", text = "the first line is not `// " .. name .. ": ...`"})
    end
    if #grep(p, guard) == 0 then
      push(found, {path = p, line = 1, rule = "header", text = "no `" .. guard .. "`"})
    end
    if #all == 0 or all[#all] ~= "#endif" then
      push(found, {path = p, line = #all, rule = "header", text = "the last line is not `#endif`"})
    end
  end
  local n = 0
  -- The comment the line before was in: its kind ("//", "/*" or "" for
  -- none), and the line of its `DRAGON:` still waiting for a `REMEDY:` line
  -- (0 for none), with whether a `REMEDY:` came mid-line instead.
  local unit_kind = ""
  local dragon = 0
  local remedy_mid = false
  for raw in all do
    n = n + 1
    local code = code_of(raw)
    local trimmed = trim(code)
    -- Each rule's patterns run only on a line holding a literal every match
    -- of them holds (a `[` for an index, `mem` for a mem* call): the regexes
    -- are most of the check's time, and the literal is a necessary condition,
    -- so the answer is the same.
    if name ~= "arena.h" and (find(code, "alloc") ~= nil or find(code, "free") ~= nil or find(code, "dup") ~= nil) and re_find(code, ALLOC) ~= nil then
      push(found, {path = p, line = n, rule = "alloc", text = raw})
    end
    local indexed = find(code, "[") ~= nil and re_find(re_replace(code, ARRAY_DECL, "\\1\\2"), INDEX) ~= nil
    if name ~= "slice.h" and (indexed or (find(code, "ptr") ~= nil and re_find(code, PTR_SUM) ~= nil)) then
      push(found, {path = p, line = n, rule = "raw index", text = raw})
    end
    if find(code, "mem") ~= nil then
      for args in calls_args(code, MEM_CALL) do
        if re_find(re_replace(args, "->", "."), "[+-]") ~= nil and not (in_foundation and dragon_above(all, n)) then
          push(found, {path = p, line = n, rule = "mem arithmetic", text = raw})
        end
      end
    end
    if find(code, "SLICE_SUB") ~= nil then
      for args in calls_args(code, SLICE_CALL) do
        if slice_args_bad(args) then push(found, {path = p, line = n, rule = "slice args", text = raw}) end
      end
    end
    if find(code, "Status") ~= nil and re_find(code, STATUS_FN) ~= nil then
      push(found, {path = p, line = n, rule = "must use", text = raw})
    end
    if find(code, "run_fail(") ~= nil and fail_braced(raw) then
      push(found, {path = p, line = n, rule = "fail brace", text = raw})
    end
    if header and find(code, "char") ~= nil and find(raw, "// cstr: ") == nil then
      local paired = false
      if re_find(code, CHAR_FIELD) ~= nil and re_find(code, "\\bptr\\s*;") ~= nil and n < #all then
        paired = re_find(all[n + 1], LEN_FIELD) ~= nil
      end
      if not paired and (re_find(code, CHAR_PARAM) ~= nil or re_find(code, CHAR_FIELD) ~= nil) then
        push(found, {path = p, line = n, rule = "cstr", text = raw})
      end
    end
    if find(code, ",") ~= nil and re_find(flattened(code), TWO_DECLS) ~= nil then
      push(found, {path = p, line = n, rule = "one per line", text = raw})
    end
    if find(code, "=") ~= nil and re_find(code, DECL_INIT) ~= nil then
      local tail = trim(re_replace(code, "\\\\\\s*$", ""))
      if not ends_with(tail, ";") and not ends_with(tail, "{") then
        push(found, {path = p, line = n, rule = "wrapped", text = raw})
      end
    end
    if trimmed == "{" or starts_with(trimmed, "else") then
      push(found, {path = p, line = n, rule = "brace", text = raw})
    end
    if find(raw, "\t") ~= nil then
      push(found, {path = p, line = n, rule = "tab", text = raw})
    end
    if find(raw, "/*") ~= nil and not ends_with(raw, "\\") then
      push(found, {path = p, line = n, rule = "comment", text = raw})
    end
    if raw ~= "" and not starts_with(raw, " ") and not opens_top(raw) then
      push(found, {path = p, line = n, rule = "top level", text = raw})
    end
    if header and find(raw, "{") ~= nil and re_find(raw, [=[^[A-Za-z_].*\w\s*\(.*\)\s*\{]=]) ~= nil and not starts_with(raw, "static inline ") and not starts_with(raw, "#") then
      push(found, {path = p, line = n, rule = "inline", text = raw})
    end
    -- The comment rules. A line whose code is empty (or a macro's `\`
    -- alone) may be a whole comment line, of one kind or the other.
    local kind = ""
    if trimmed == "" or trimmed == "\\" then
      local t = trim_start(raw)
      if starts_with(t, "//") then
        kind = "//"
      elseif starts_with(t, "/*") then
        kind = "/*"
      end
      if kind ~= "" then
        if kind == "//" and #raw > 80 then
          local width = columns(raw)
          if width > 80 then push(found, {path = p, line = n, rule = "comment wrap", text = width .. " columns"}) end
        end
        if kind ~= unit_kind and dragon ~= 0 then
          push(found, dragon_unanswered(p, dragon, remedy_mid))
          dragon = 0
        end
        local body = trim_start(sub(t, 3))
        if starts_with(body, "REMEDY:") then
          dragon = 0
        else
          if find(body, "DRAGON:") ~= nil and find(body, "`DRAGON:`") == nil then
            if dragon ~= 0 then push(found, dragon_unanswered(p, dragon, remedy_mid)) end
            dragon = n
            remedy_mid = false
          end
          if dragon ~= 0 and find(body, "REMEDY:") ~= nil then remedy_mid = true end
        end
      end
    end
    if kind == "" and dragon ~= 0 then
      push(found, dragon_unanswered(p, dragon, remedy_mid))
      dragon = 0
    end
    unit_kind = kind
    if find(raw, ".zig:") ~= nil then
      local cited = zig_cited(raw, kind ~= "")
      if cited ~= nil then push(found, {path = p, line = n, rule = "zig cite", text = "cites `" .. cited .. "`"}) end
    end
  end
  if dragon ~= 0 then push(found, dragon_unanswered(p, dragon, remedy_mid)) end
  return found
end

-- The C files under `dir`, the build's output left out.
function c_files(dir)
  local files = {}
  for p in glob(dir .. "/**/*") do
    if (ends_with(p, ".c") or ends_with(p, ".h")) and not starts_with(p, "c/out/") then push(files, p) end
  end
  sort(files)
  return files
end

-- Each break of the line rules in `files`. A yield after each file lets go
-- of what reading it made, so the run holds one file's lines at a time.
function check_files(files)
  local found = {}
  for p in files do
    for f in check_file(p, starts_with(p, "c/foundation/")) do push(found, f) end
    yield()
  end
  return found
end

-- ── The comment rules' report ──────────────────────────────────────────

-- The folder HELD names a file by: `c/<folder>` for a file below one, the
-- file itself for one directly in c/ (c/shale.c).
function folder_of(p)
  local parts = split(p, "/")
  if #parts > 2 then return parts[1] .. "/" .. parts[2] end
  return p
end

-- HELD as a set, each entry one of the folders `files` are in, or the check
-- stops: a misspelt entry would hold nothing.
function held_folders(files)
  local folders = {}
  for p in files do folders[folder_of(p)] = true end
  for h in HELD do
    if not has_key(folders, h) then fail("HELD in c/check_discipline.shale names `" .. h .. "`, which holds no C file: a folder is `c/<folder>`, or `c/shale.c`") end
  end
  return set_of(HELD)
end

-- `l`'s items joined with ", ", or "no folder" for none.
function join_or_none(l)
  if #l == 0 then return "no folder" end
  return join(l, ", ")
end

-- The comment findings outside HELD, each file's under a line with its
-- count, then a line for each folder of `files` not held, with its count
-- by rule (0 too), so the tail of the output sizes each folder's sweep.
function report_comments(reported, files, held_set)
  local by_file = {}
  local file_order = {}
  for f in reported do
    if not has_key(by_file, f.path) then push(file_order, f.path) end
    push_at(by_file, f.path, f)
  end
  local by_folder = {}
  for p in file_order do
    print("── " .. p .. ": " .. #by_file[p] .. " comment findings")
    for f in by_file[p] do
      print(f.path .. ":" .. f.line .. ": " .. f.rule .. ": " .. f.text)
      local key = folder_of(f.path)
      if not has_key(by_folder, key) then by_folder[key] = {} end
      incr(by_folder[key], f.rule)
    end
  end
  local folder_set = {}
  for p in files do
    if not has_key(held_set, folder_of(p)) then folder_set[folder_of(p)] = true end
  end
  local folders = keys(folder_set)
  sort(folders)
  for key in folders do
    if not has_key(by_folder, key) then by_folder[key] = {} end
    local parts = {}
    local total = 0
    for rule in COMMENT_RULES do
      local k = get(by_folder[key], rule, 0)
      total = total + k
      push(parts, rule .. " " .. k)
    end
    print("comments, reported (not held): " .. key .. ": " .. total .. " (" .. join(parts, ", ") .. ")")
  end
  return nil
end

-- ── Return sizes, through a probe ──────────────────────────────────────

-- The modules the probe includes, in an order that compiles as one unit
-- (c/shale.c's, then the host's pieces it doesn't run). A module missing
-- from it stops the check, so a new one can't go unjudged.
const PROBE_MODULES = {
  "c/foundation/test.h", "c/script/run.h", "c/host/store.c", "c/host/path_run.c", "c/script/regex.c",
  "c/script/builtins.c", "c/script/builtins_text.c", "c/script/builtins_store.c", "c/script/builtins_walk.c",
  "c/script/builtins_change.c", "c/script/vm.c", "c/host/mounts.c", "c/host/paths.c", "c/host/undo.c",
  "c/host/spawn_argv.c", "c/host/spawn.c", "c/host/keep.c", "c/host/job_record.c", "c/host/jobs.c", "c/host/host_run.c",
  "c/host/host_jobs.c", "c/host/host_procs.c", "c/host/host_json.c", "c/host/host_text.c", "c/host/flat_tree.c", "c/host/zig_wire.c", "c/host/zig_ast.c",
  "c/host/host_zig.c", "c/host/host_call.c", "c/gate/gate.c",
}
const PROBE_DIR = "c/out/returns"
-- The compiler's canaries: each holds a shape a rule forbids, to see the
-- compiler still get it wrong, so the return sizes don't judge them.
const CANARIES = "c/tests/canaries/"
const RETURN_WHY = "TCC 0.9.27 miscompiles a struct of 9 to 15 bytes returned straight into a call (c/docs/style.md, Declarations)"

-- A column-0 `static` line's function, as {type, name}, or nil when the line
-- declares no function (a variable, `void`, a function pointer).
function returned_by(raw)
  local s = code_of(raw)
  s = re_replace(s, [=[^static\s+(inline\s+)?(STATUS_MUST_USE\s+)?]=], "")
  local open = find(s, "(")
  if open == nil then return nil end
  local eq = find(s, "=")
  if eq ~= nil and eq < open then return nil end
  local m = re_find(trim(sub(s, 1, open - 1)), [=[^(.*[\s*])([A-Za-z_]\w*)$]=])
  if m == nil then return nil end
  local ty = trim(m.groups[1])
  if ty == "void" or ty == "" then return nil end
  return {type = ty, name = m.groups[2]}
end

-- Every function the files return a value from, as {type, fn, path, line}:
-- each column-0 `static` function, and the functions each `VEC_DEFINE` and
-- `MAP_DEFINE` line makes.
function returns_of(files)
  local found = {}
  for p in files do
    local n = 0
    for raw in lines(read(p)) do
      n = n + 1
      if starts_with(raw, "static ") then
        local f = returned_by(raw)
        if f ~= nil then push(found, {type = f.type, fn = f.name, path = p, line = n}) end
      elseif starts_with(raw, "VEC_DEFINE(") or starts_with(raw, "MAP_DEFINE(") then
        local m = re_find(raw, [=[^(VEC|MAP)_DEFINE\(\s*(\w+)\s*,\s*([^)]*\S)\s*\)]=])
        if m == nil then fail(p .. ":" .. n .. ": a `_DEFINE(` line this check can't read: " .. raw) end
        local name = m.groups[2]
        push(found, {type = name, fn = name .. "_make", path = p, line = n})
        if m.groups[1] == "VEC" then
          push(found, {type = m.groups[3], fn = name .. "_pop", path = p, line = n})
          push(found, {type = name .. "Items", fn = name .. "_items", path = p, line = n})
        else
          push(found, {type = m.groups[3], fn = name .. "_value_at", path = p, line = n})
        end
      end
    end
  end
  return found
end

-- The column-0 items of the file at `p` that define a type named in `wanted`
-- (a set), as {name, text}: a `typedef` to its closing `} Name;`, or a
-- `_DEFINE(` line. The probe copies them from a file it can't include.
function typedefs_in(p, wanted)
  local items = {}
  local all = lines(read(p))
  local i = 1
  while i <= #all do
    local raw = all[i]
    if starts_with(raw, "typedef ") then
      local first = i
      if not ends_with(trim(code_of(raw)), ";") then
        i = i + 1
        while i <= #all and not starts_with(all[i], "}") do i = i + 1 end
        if i > #all then fail(p .. ":" .. first .. ": a `typedef` with no `}` at column 0 to close it") end
      end
      local m = re_find(code_of(all[i]), [=[(\w+)\s*;\s*$]=])
      if m ~= nil and has_key(wanted, m.group) then
        push(items, {name = m.group, text = join(slice(all, first, i), "\n")})
      end
    elseif starts_with(raw, "VEC_DEFINE(") or starts_with(raw, "MAP_DEFINE(") or starts_with(raw, "SLICE_TYPE(") then
      local m = re_find(raw, [=[^\w+\(\s*(\w+)]=])
      if m ~= nil and has_key(wanted, m.group) then push(items, {name = m.group, text = raw}) end
    end
    i = i + 1
  end
  return items
end

-- `text` with each name `names` maps made what it maps it to, whole words
-- alone.
function renamed(text, names)
  local s = text
  for k in keys(names) do
    if find(s, k) ~= nil then s = re_replace(s, "\\b" .. k .. "\\b", names[k]) end
  end
  return s
end

-- Each of the `outside` files' own `#include`s of another of them, as a map
-- of lists. A file a unit includes also sees what that unit included before
-- it, so a part of a test binary (c/tests/ran_tests.c's) reaches ran.c's
-- types through the binary.
function include_edges(outside)
  local outside_set = set_of(outside)
  local edges = {}
  for p in outside do edges[p] = {} end
  for p in outside do
    local before = {}
    for g in grep(p, "#include \"") do
      local m = re_find(g.text, [=[^#include "([^"]+)"]=])
      if m ~= nil then
        local q = path_normal(dirname(p) .. "/" .. m.group)
        if has_key(outside_set, q) then
          push(edges[p], q)
          for b in before do push(edges[q], b) end
          push(before, q)
        end
      end
    end
  end
  return edges
end

-- `p` and the outside files it includes, directly or through another of
-- them, in the order the probe must copy their typedefs: each after what it
-- includes. `seen` and `order` gather across calls.
function includes_first(p, edges, seen, order)
  if has_key(seen, p) then return nil end
  seen[p] = true
  for q in edges[p] do includes_first(q, edges, seen, order) end
  push(order, p)
  return nil
end

-- How the probe copies the typedefs of the files it can't include. Each
-- test is its own translation unit, so two may define one name two ways:
-- the `k`th file's names are made `probe<k>_<name>` in the probe, and each
-- file's map (`names[p]`) covers its own names and those of the outside
-- files it includes. Gives {items, names}: the copied items, renamed, in an
-- order that compiles, and the maps.
function outside_plan(outside, wanted)
  local edges = include_edges(outside)
  local seen = {}
  local order = {}
  for p in outside do includes_first(p, edges, seen, order) end
  local names = {}
  local items = {}
  local k = 0
  for p in order do
    k = k + 1
    local own = typedefs_in(p, wanted)
    local map = {}
    -- What the files it includes define, then its own, which win.
    local reach = {}
    local reach_order = {}
    includes_first(p, edges, reach, reach_order)
    for q in reach_order do
      if q ~= p then
        for n in keys(names[q]) do map[n] = names[q][n] end
      end
    end
    for item in own do
      map[item.name] = "probe" .. k .. "_" .. item.name
      if not starts_with(item.text, "typedef ") and not starts_with(item.text, "SLICE_TYPE(") then
        map[item.name .. "Items"] = "probe" .. k .. "_" .. item.name .. "Items"
      end
    end
    names[p] = map
    for item in own do push(items, "// from " .. p .. "\n" .. renamed(item.text, map)) end
  end
  return {items = items, names = names}
end

-- The probe's source: every module, the copied items, and a `main` printing
-- `<k> <size>` for each of `types`.
function probe_source(types, items)
  local up = ""
  for k in split(PROBE_DIR, "/") do up = up .. "../" end
  local src = {"// probe.c: written by c/check_discipline.shale, the size of each type a function returns.", "#define _GNU_SOURCE", "#include <stdio.h>"}
  for m in PROBE_MODULES do push(src, "#include \"" .. up .. m .. "\"") end
  for item in items do push(src, item) end
  push(src, "int main(void) {")
  local k = 0
  for ty in types do
    k = k + 1
    push(src, "    printf(\"%d %zu\\n\", " .. k .. ", sizeof(" .. ty .. "));")
  end
  push(src, "    return 0;")
  push(src, "}")
  return join(src, "\n") .. "\n"
end

-- Whether the probe reaches the file at `p` through its includes: a piece of
-- c/foundation, c/script, c/host or c/gate. The rest (c/shale.c,
-- c/shale_gate.c, the tests, a plant) have their typedefs copied in.
function probe_reaches(p)
  return starts_with(p, "c/foundation/") or starts_with(p, "c/script/") or starts_with(p, "c/host/") or starts_with(p, "c/gate/")
end

-- Each function of `files` that returns a struct of 9 to 15 bytes, as a
-- break {path, line, rule, text}, in `found`, beside how many functions and
-- types were sized.
function check_returns(files)
  local judged = {}
  for p in files do
    if not starts_with(p, CANARIES) then push(judged, p) end
  end
  files = judged
  local rets = returns_of(files)
  local wanted = {}
  for r in rets do
    for w in re_find_all(r.type, [=[[A-Za-z_]\w*]=]) do wanted[w.text] = true end
  end
  local outside = {}
  for p in files do
    if not probe_reaches(p) then push(outside, p) end
  end
  local plan = outside_plan(outside, wanted)
  -- Each return's type as the probe spells it, its file's names renamed.
  local types = {}
  local index = {}
  for r in rets do
    r.sized = r.type
    if has_key(plan.names, r.path) then r.sized = renamed(r.type, plan.names[r.path]) end
    if not has_key(index, r.sized) then
      push(types, r.sized)
      index[r.sized] = #types
    end
  end
  if exists(PROBE_DIR) then remove_tree(PROBE_DIR) end
  mkdir(PROBE_DIR)
  local probe = PROBE_DIR .. "/probe.c"
  create(probe, probe_source(types, plan.items))
  local r = run({"tcc", "-Ic/foundation", "-run", probe}, {timeout_ms = 30000, tail = 1000})
  if get(r, "code", -1) ~= 0 then fail("the return-size probe " .. probe .. " did not compile and run under tcc:\n" .. r.out) end
  local size = {}
  for l in lines(r.out) do
    local m = re_find(l, "^(\\d+) (\\d+)$")
    if m ~= nil then size[m.groups[1]] = parse_int(m.groups[2]) end
  end
  local found = {}
  for f in rets do
    local k = "" .. index[f.sized]
    if not has_key(size, k) then fail("the return-size probe printed no size for `" .. f.type .. "`:\n" .. r.out) end
    local n = size[k]
    if n >= 9 and n <= 15 then
      push(found, {path = f.path, line = f.line, rule = "return size", text = "`" .. f.fn .. "` returns `" .. f.type .. "`, " .. n .. " bytes: " .. RETURN_WHY})
    end
  end
  remove_tree(PROBE_DIR)
  return {found = found, functions = #rets, types = #types}
end

-- The C files the probe must include: each module under c/script, c/host
-- and c/gate, each of them in PROBE_MODULES, or the check stops.
function probe_modules_hold(files)
  local module_set = set_of(PROBE_MODULES)
  for p in files do
    local module = ends_with(p, ".c") and (starts_with(p, "c/script/") or starts_with(p, "c/host/") or starts_with(p, "c/gate/"))
    if module and not has_key(module_set, p) then fail(p .. " is a module the return-size probe doesn't include: add it to PROBE_MODULES in c/check_discipline.shale") end
  end
  return nil
end

-- The plants in `p` caught, judged as a foundation header or not: exactly
-- `want`, each "line rule", or the run fails. Gives how many.
function plants_hold(p, in_foundation, want)
  local got = {}
  for f in check_file(p, in_foundation) do push(got, f.line .. " " .. f.rule) end
  -- A `DRAGON:`'s break is found where its comment ends, after the lines
  -- between, so the two are compared in one order.
  sort(got)
  sort(want)
  if join(got, ", ") ~= join(want, ", ") then
    fail("the discipline check's self-test caught " .. join(got, ", ") .. " in " .. p .. "; it should catch exactly " .. join(want, ", "))
  end
  return #want
end

-- The comment rules' plants, written to `p`: each line with the rules it
-- breaks (none for a near miss that must pass). Gives how many plants.
function comment_plants_hold(p)
  local plants = {
    {t = "// comments.c: the comment rules' plants, and the near misses beside them.", r = {}},
    -- The wrap: 81 columns breaks it; 80 passes, in ASCII or in `─`s of
    -- three bytes each; a message, a trailing comment and a macro's
    -- `/* */` are not judged.
    {t = "    // " .. rep("x", 74), r = {"comment wrap"}},
    {t = "    // " .. rep("x", 73), r = {}},
    {t = "// " .. rep("─", 77), r = {}},
    {t = "static const Str LONG = S(\"" .. rep("y", 80) .. "\");", r = {}},
    {t = "static int long_enough_to_pass_eighty_columns(void) { return 0; } // a trailing comment", r = {}},
    {t = "#define M(x) \\", r = {}},
    {t = "    /* " .. rep("z", 80) .. " */ \\", r = {}},
    {t = "    (x)", r = {}},
    -- A `DRAGON:` wants a `REMEDY:` line after it in its own comment.
    {t = "// DRAGON: a plant that nothing answers.", r = {"dragon remedy"}},
    {t = "static int a1;", r = {}},
    {t = "// DRAGON: a plant whose answer is mid-line. REMEDY: here.", r = {"dragon remedy"}},
    {t = "static int a2;", r = {}},
    {t = "// DRAGON: a plant answered in the next comment.", r = {"dragon remedy"}},
    {t = "", r = {}},
    {t = "// REMEDY: too late, since the blank line ended the comment.", r = {}},
    {t = "static int a3;", r = {}},
    {t = "// DRAGON: the first of two, which the one remedy can't answer.", r = {"dragon remedy"}},
    {t = "// DRAGON: the second of two.", r = {}},
    {t = "// REMEDY: the second's alone.", r = {}},
    {t = "static int a4;", r = {}},
    {t = "    // DRAGON: answered, as a near miss.", r = {}},
    {t = "    // It runs on a line or two.", r = {}},
    {t = "    // REMEDY: on a line of its own, in the same comment.", r = {}},
    {t = "static int a5;", r = {}},
    {t = "#define N(x) \\", r = {}},
    {t = "    /* DRAGON: a macro's, answered. */ \\", r = {}},
    {t = "    /* REMEDY: on a line of its own. */ \\", r = {}},
    {t = "    (x)", r = {}},
    {t = "#define P(x) \\", r = {}},
    {t = "    /* DRAGON: a macro's, unanswered. */ \\", r = {"dragon remedy"}},
    {t = "    (x)", r = {}},
    {t = "// The DRAGONs above, and a `DRAGON:` in backticks, mark nothing.", r = {}},
    {t = "static const Str MARK = S(\"DRAGON: in a string\");", r = {}},
    -- A Zig citation breaks the last rule in a comment, never in a string.
    {t = "// A comment citing vm.zig:123 breaks it.", r = {"zig cite"}},
    {t = "static int a6; // so does src/script/vm.zig:9 in a trailing one", r = {"zig cite"}},
    {t = "    /* as does a macro's lex.zig:40 */ \\", r = {"zig cite"}},
    {t = "// Naming vm.zig alone, or vm.zig: with no line, passes.", r = {}},
    {t = "static const Str CITE = S(\"a // b vm.zig:5\");", r = {}},
  }
  local text = {}
  local want = {}
  local n = 0
  for plant in plants do
    n = n + 1
    push(text, plant.t)
    for rule in plant.r do push(want, n .. " " .. rule) end
  end
  create(p, join(text, "\n") .. "\n")
  local held = plants_hold(p, false, want)
  -- The texts that tell a sweep what to fix.
  local said = {}
  for f in check_file(p, false) do said[f.line .. " " .. f.rule] = f.text end
  local want_said = {
    {k = "2 comment wrap", text = "81 columns"},
    {k = "10 dragon remedy", text = "a `DRAGON:` with no `REMEDY:` line after it in its comment"},
    {k = "12 dragon remedy", text = "a `DRAGON:` whose `REMEDY:` is mid-line: it starts a line of its own"},
    {k = "35 zig cite", text = "cites `vm.zig:123`"},
    {k = "36 zig cite", text = "cites `src/script/vm.zig:9`"},
  }
  for w in want_said do
    if said[w.k] ~= w.text then fail("the discipline check's self-test said `" .. said[w.k] .. "` for " .. w.k .. " in " .. p .. "; it should say `" .. w.text .. "`") end
  end
  return held
end

function self_test()
  local dir = "c/out/discipline"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir)
  -- The return sizes first, as the check runs them, while the arena is fresh.
  local rp = dir .. "/returns.c"
  create(rp, [=[// returns.c: the return-size rule's plants: lines 23 to 26 break it, the rest pass.
typedef struct {
    uint32_t a;
    uint32_t b;
} Eight;
typedef struct {
    uint8_t b[9];
} Nine;
typedef struct {
    uint32_t a;
    uint32_t b;
    uint32_t c;
} Twelve;
typedef struct {
    uint8_t b[15];
} Fifteen;
typedef struct {
    uint64_t a;
    uint64_t b;
} Sixteen;
typedef enum { RET_A, RET_B } RetKind;
SLICE_TYPE(Twelves, Twelve);
static Nine nine(void) { Nine n = {{0}}; return n; }
static Twelve twelve(void) { Twelve t = {1, 2, 3}; return t; }
static inline Fifteen fifteen(void) { Fifteen f = {{0}}; return f; }
VEC_DEFINE(TwelveVec, Twelve)
static Eight eight(void) { Eight e = {1, 2}; return e; }
static inline Sixteen sixteen(void) { Sixteen s = {1, 2}; return s; }
static Twelves twelves(Twelve *t) { Twelves s = {t, 1}; return s; }
static RetKind kind(void) { return RET_B; }
static uint32_t word(void) { return 1; }
static Twelve *twelve_at(Twelve *t) { return t; }
static const Str NOT_A_FUNCTION = S("(");
static void nothing(void) {}
static STATUS_MUST_USE Status checked(void) { return OK; }
]=])
  local got = {}
  for f in check_returns({rp}).found do push(got, f.line .. " " .. f.text) end
  local want_returns = {
    "23 `nine` returns `Nine`, 9 bytes: " .. RETURN_WHY,
    "24 `twelve` returns `Twelve`, 12 bytes: " .. RETURN_WHY,
    "25 `fifteen` returns `Fifteen`, 15 bytes: " .. RETURN_WHY,
    "26 `TwelveVec_pop` returns `Twelve`, 12 bytes: " .. RETURN_WHY,
  }
  if join(got, "\n") ~= join(want_returns, "\n") then
    fail("the discipline check's self-test caught, in " .. rp .. ":\n" .. join(got, "\n") .. "\nit should catch exactly:\n" .. join(want_returns, "\n"))
  end
  local caught = #want_returns
  local p = dir .. "/plant.h"
  create(p, [=[// The discipline check's plants: lines 3 to 17 break a rule or two each.
#include "slice.h"
static inline void *grab(size_t n) { return malloc(n); }
static inline char first(Str s) { return s.ptr[0]; }
static inline char second(Str s) { return *(s.ptr + 1); }
static inline void name_it(const char *name) { (void)name; }
    const char *label;
    size_t a, b;
    uint64_t x = f(1, 2), y = 3;
static inline void allman(void)
{
    else {
]=] .. "\tint tabbed;\n" .. [=[
    /* a block comment */
void bare(void);
int not_inline(int x) {
    Status s = vec_grow_raw(a, &p,
static inline int ok_after_plants(void) { return 0; }
    static const Str names[2] = {
    Budgets b = budgets_default(); \
    int count;
static inline void give_back(Arena *a, void *p) { arena_free(a, p, 1); }
// a comment that says malloc(n) and s.ptr[0] and (const char *x) and int a, b;
static inline char first_ok(Str s) { return at(s, 0); }
static inline const char *said(void) { return "free(p) and s.ptr[0], int a, b;"; }
static inline void with_reason(const char *file) { (void)file; } // cstr: __FILE__
typedef struct {
    const char *ptr;
    size_t len;
} Good;
static inline char unchecked(Str s) { return at_unchecked(s, 0, "s is not empty"); }
static inline int calls(int a, int b) { int x = g(a, b); int ys[2] = {a, b}; Str s = (Str){"", 0}; return x + (int)sizeof ys + (int)s.len; }
    } else if (x) {
#define TWO(a, b) \
    /* inside a macro */ \
    (a + b)
TEST_MAIN(
)
]=])
  local want = {"1 header", "1 header", "38 header", "3 alloc", "4 raw index", "5 raw index", "6 cstr", "7 cstr", "8 one per line", "9 one per line",
    "11 brace", "11 top level", "12 brace", "13 tab", "13 top level", "14 comment", "15 top level", "16 top level", "16 inline", "17 one per line", "17 wrapped"}
  caught = caught + plants_hold(p, false, want)
  local outside = dir .. "/outside.h"
  create(outside, [=[// outside.h: the bounds, Status and stop plants: lines 4 to 11 break one each.
#ifndef SHALE_OUTSIDE_H
#define SHALE_OUTSIDE_H
static inline uint32_t first_slot(MapCore *m) { return m->index[0]; }
static inline char from_array(void) { char cs[4] = {0}; return cs[1]; }
static inline void shift(Str *keys, size_t n) { memmove(keys, keys + 1, n * sizeof(Str)); }
static inline Bytes bumped(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k++, 3); }
static inline Bytes called(Bytes b) { return SLICE_SUB(Bytes, b, f(1), 3); }
static inline Bytes assigned(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k = 1, 3); }
static inline Status dropped(Buf *b) { return buf_byte(b, 'x'); }
static inline STATUS_MUST_USE Status braced(RunCtx *r, Pos p) { return run_fail(r, p, CLASS_FAIL, S("`f` is {not} a map")); }
static inline STATUS_MUST_USE Status formatted(RunCtx *r, Pos p) { return run_failf(r, p, CLASS_FAIL, S("`{s}` {{a}}"), MSG_ARGS(MSG_FROM_HOST(S("f")))); }
// A comment's run_fail(r, p, CLASS_FAIL, S("{")) is no call.
static inline STATUS_MUST_USE Status plain_fail(RunCtx *r, Pos p) { if (r == NULL) { return run_fail(r, p, CLASS_FAIL, S("no map (')')")); } return OK; } // S("{")
static inline Str named(void) { return S("run_fail(\"{\")"); }
static inline STATUS_MUST_USE Status kept(Buf *b) { return buf_byte(b, 'x'); }
static inline Bytes plain(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k, k + 1); }
static inline bool compared(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k == 0 ? 0 : 1, 3).len >= 1; }
static inline void copy_checked(Bytes d, Str s) { memcpy(&at(d, 0), s.ptr, s.len); }
static inline void through_arrow(Buf *b, Str s) { memcpy(b->ptr, s.ptr, s.len); }
static inline char declared(void) { char cs[4] = {0}; Bytes all = {cs, 4}; return at(all, 1); }
#endif
]=])
  caught = caught + plants_hold(outside, false, {"4 raw index", "5 raw index", "6 mem arithmetic", "7 slice args", "8 slice args", "9 slice args", "10 must use", "11 fail brace"})
  local inside = dir .. "/inside.h"
  create(inside, [=[// inside.h: the foundation's mem arithmetic: line 4 breaks it, line 7 passes.
#ifndef SHALE_INSIDE_H
#define SHALE_INSIDE_H
static inline void shift(uint64_t *xs, size_t n) { memmove(xs, xs + 1, n); }
// DRAGON: bounds. A plant, the marker a foundation call's arithmetic needs.
// REMEDY: the self-test writes it, and nothing calls it.
static inline void marked(uint64_t *xs, size_t n) { memmove(xs, xs + 1, n); }
#endif
]=])
  caught = caught + plants_hold(inside, true, {"4 mem arithmetic"})
  caught = caught + comment_plants_hold(dir .. "/comments.c")
  remove_tree(dir)
  print("PASS self-test: " .. caught .. " plants caught, every other line passed")
end

if arg("self_test", 0) == 1 then
  self_test()
else
  local files = c_files("c")
  probe_modules_hold(files)
  local held_set = held_folders(files)
  local sized = check_returns(files)
  yield()
  local all_found = check_files(files)
  for f in sized.found do push(all_found, f) end
  local comment_set = set_of(COMMENT_RULES)
  local found = {}
  local reported = {}
  for f in all_found do
    if has_key(comment_set, f.rule) and not has_key(held_set, folder_of(f.path)) then push(reported, f) else push(found, f) end
  end
  report_comments(reported, files, held_set)
  for f in found do print(f.path .. ":" .. f.line .. ": " .. f.rule .. ": " .. f.text) end
  if #found > 0 then fail(#found .. " breaks of the C's discipline in " .. #files .. " files") end
  print("PASS discipline: " .. #files .. " files; " .. sized.functions .. " functions' returns sized, " .. sized.types .. " types, none of 9 to 15 bytes; the comment rules held in " .. join_or_none(HELD) .. ", " .. #reported .. " findings reported outside them")
end
