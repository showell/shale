-- c/check_discipline.shale: holds the C under c/ to the rules C itself won't,
-- the ones of c/docs/style.md a line-by-line reading can hold:
--   alloc:      no malloc, free, calloc or realloc (nor aligned_alloc, strdup,
--               strndup) outside c/foundation/arena.h;
--   raw index:  no `[i]` index of anything (a slice's `ptr`, a field, a local
--               array), and no `*(s.ptr + i)`, outside c/foundation/slice.h:
--               `at(s, i)`, or `at_unchecked(s, i, "why")` where a loop has
--               proved its bounds; an array's size in its declaration
--               (`char digits[20];`) is no index;
--   mem arithmetic: no `+` or `-` in a mem* call's arguments
--               (`memcpy(b->ptr + n, ...)`) outside c/foundation/, where each
--               such call has a `DRAGON:` in the comment block above it; a
--               checked part (`&at(s, i)`, a SLICE_SUB's `ptr`) needs neither;
--   slice args: no `++`, `--`, `=` or call in a SLICE_SUB's arguments, which
--               it evaluates more than once;
--   must use:   a function returning `Status` is `STATUS_MUST_USE`, so GCC
--               refuses an answer left unused;
--   cstr:       no `char *` parameter or field in a header without its length:
--               a field `ptr` with `size_t len` on the next line, or a
--               `// cstr: <why>` on the line itself;
--   one per line: no two declarations in one statement (`int a, b;`);
--   wrapped:    a declaration with `=` ends its line, with `;` (or `{`, for
--               an initializer of a line an item);
--   brace:      an opening brace ends the line that opens it, never a line of
--               its own, and `else` follows its `}` on the same line;
--   tab:        no tab: four spaces a level;
--   comment:    `//` comments, `/* */` only inside a macro (a line ending `\`);
--   top level:  a line at column 0 starts one of the openings in TOP below,
--               or closes one, so a reader splits a file into its items;
--   inline:     a function in a header is `static inline`;
--   header:     a header's first line is `// <its name>: `, its guard
--               `SHALE_<NAME>_H`, and its last line `#endif`.
-- Strings, character literals and comments are not code, so a word in one
-- never counts. A file is judged by its own name (arena.h, slice.h), so the
-- plants below are judged as any file is.
--
-- `self_test=1` writes one plant of each rule, and lines that must pass
-- beside them, to c/out/discipline/ (plant.h and outside.h judged as any
-- file outside the foundation, inside.h as one in it), and fails unless
-- exactly the plants are caught.
--
-- Run from the repository's root: shale c/check_discipline.shale
-- budget: steps=100000000

const ALLOC = [=[\b(malloc|free|calloc|realloc|aligned_alloc|strdup|strndup)\s*\(]=]
-- An index: a `[` after a name, a `)` or a `]`, read after each array
-- declaration's size is taken out (ARRAY_DECL); and a pointer's sum deref'd.
const INDEX = [=[[\w)\]]\s*\[]=]
const PTR_SUM = [=[\*\s*\(\s*[A-Za-z_][A-Za-z0-9_.>-]*ptr\s*\+]=]
const ARRAY_DECL = [=[\b(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)(\s+\**\s*\w+)\s*\[[^\]]*\]]=]
const MEM_CALL = [=[\bmem(cpy|move|set|cmp)\s*\(]=]
const SLICE_CALL = [=[\bSLICE_SUB\s*\(]=]
const STATUS_FN = [=[\bstatic\s+(inline\s+)?Status\s+[\w#]+\s*\(]=]
const CHAR_PARAM = [=[[(,]\s*(const\s+)?char\s*\*\s*\w+\s*[,)]]=]
const CHAR_FIELD = [=[^\s*(const\s+)?char\s*\*\s*\w+\s*;]=]
const LEN_FIELD = [=[^\s*size_t\s+len\s*;]=]
-- A declaration whose first declarator is followed by a comma, read after
-- every parenthesized and braced group is emptied.
const TWO_DECLS = [=[^\s*(static\s+)?(const\s+)?(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)\s+\**\s*\w+\s*(\[\w*\])?\s*(=[^,;]*)?,]=]
const DECL_INIT = [=[^\s*(static\s+)?(const\s+)?(int|char|bool|size_t|uintptr_t|u?int\d+_t|[A-Z]\w*)\s+\**\s*\w+\s*(\[\w*\])?\s*=]=]
const TOP = {"//", "#", "static inline ", "static ", "typedef ", "enum ", "SLICE_TYPE(", "VEC_DEFINE(", "MAP_DEFINE(", "TEST(", "TEST_MAIN(", "_Static_assert(", "int main(", "}", ")"}

-- The line's code: its strings and character literals emptied, its comments cut.
function code_of(line)
  local s = re_replace(line, [=["(\\.|[^"\\])*"]=], [=[""]=])
  s = re_replace(s, [=['(\\.|[^'\\])*']=], "''")
  s = re_replace(s, [=[/\*[^*]*\*/]=], "")
  local cut = find(s, "//")
  if cut ~= nil then s = sub(s, 1, cut - 1) end
  return s
end

-- `code` with every parenthesized and braced group made a bare `0`,
-- innermost first, so an outer group empties after its inner ones.
function flattened(code)
  local s = code
  local before = ""
  while s ~= before do
    before = s
    s = re_replace(s, [=[\([^(){}]*\)]=], "0")
    s = re_replace(s, [=[\{[^(){}]*\}]=], "0")
  end
  return s
end

function opens_top(raw)
  for t in TOP do
    if starts_with(raw, t) then return true end
  end
  return false
end

-- The text inside the parentheses that open at `open` in `code`, to their
-- matching close (or the line's end).
function args_at(code, open)
  local depth = 0
  local i = open
  while i <= #code do
    local c = sub(code, i, i)
    if c == "(" then
      depth = depth + 1
    elseif c == ")" then
      depth = depth - 1
      if depth == 0 then return sub(code, open + 1, i - 1) end
    end
    i = i + 1
  end
  return sub(code, open + 1)
end

-- The argument texts of every call in `code` that `pattern` (ending in its
-- `(`) starts.
function calls_args(code, pattern)
  local found = {}
  for m in re_find_all(code, pattern) do push(found, args_at(code, m.at + #m.text - 1)) end
  return found
end

-- Whether the comment block directly above line `n` holds a `DRAGON:`.
function dragon_above(all, n)
  local k = n - 1
  while k >= 1 do
    local t = trim(all[k])
    if not (starts_with(t, "//") or starts_with(t, "/*")) then return false end
    if find(t, "DRAGON:") ~= nil then return true end
    k = k - 1
  end
  return false
end

-- Whether a SLICE_SUB's arguments do what it can't evaluate twice: an
-- increment, a decrement, an assignment or a call.
function slice_args_bad(args)
  if find(args, "++") ~= nil or find(args, "--") ~= nil then return true end
  local plain = re_replace(args, "[=!<>]=", "")
  if find(plain, "=") ~= nil then return true end
  return re_find(args, [=[\w\s*\(]=]) ~= nil
end

-- Each break of the rules in the file at `p`, as {path, line, rule, text}.
-- `in_foundation` says whether it is judged as a foundation header.
function check_file(p, in_foundation)
  local name = basename(p)
  local header = ends_with(p, ".h")
  local all = lines(read(p))
  local found = {}
  if header then
    local guard = "#ifndef SHALE_" .. upper(sub(name, 1, #name - 2)) .. "_H"
    if #all == 0 or not starts_with(all[1], "// " .. name .. ": ") then
      push(found, {path = p, line = 1, rule = "header", text = "the first line is not `// " .. name .. ": ...`"})
    end
    if #grep(p, guard) == 0 then
      push(found, {path = p, line = 1, rule = "header", text = "no `" .. guard .. "`"})
    end
    if #all == 0 or all[#all] ~= "#endif" then
      push(found, {path = p, line = #all, rule = "header", text = "the last line is not `#endif`"})
    end
  end
  local n = 0
  for raw in all do
    n = n + 1
    local code = code_of(raw)
    local trimmed = trim(code)
    if name ~= "arena.h" and re_find(code, ALLOC) ~= nil then
      push(found, {path = p, line = n, rule = "alloc", text = raw})
    end
    if name ~= "slice.h" and (re_find(re_replace(code, ARRAY_DECL, "\\1\\2"), INDEX) ~= nil or re_find(code, PTR_SUM) ~= nil) then
      push(found, {path = p, line = n, rule = "raw index", text = raw})
    end
    for args in calls_args(code, MEM_CALL) do
      if re_find(re_replace(args, "->", "."), "[+-]") ~= nil and not (in_foundation and dragon_above(all, n)) then
        push(found, {path = p, line = n, rule = "mem arithmetic", text = raw})
      end
    end
    for args in calls_args(code, SLICE_CALL) do
      if slice_args_bad(args) then push(found, {path = p, line = n, rule = "slice args", text = raw}) end
    end
    if re_find(code, STATUS_FN) ~= nil then
      push(found, {path = p, line = n, rule = "must use", text = raw})
    end
    if header and find(raw, "// cstr: ") == nil then
      local paired = false
      if re_find(code, CHAR_FIELD) ~= nil and re_find(code, "\\bptr\\s*;") ~= nil and n < #all then
        paired = re_find(all[n + 1], LEN_FIELD) ~= nil
      end
      if not paired and (re_find(code, CHAR_PARAM) ~= nil or re_find(code, CHAR_FIELD) ~= nil) then
        push(found, {path = p, line = n, rule = "cstr", text = raw})
      end
    end
    if re_find(flattened(code), TWO_DECLS) ~= nil then
      push(found, {path = p, line = n, rule = "one per line", text = raw})
    end
    if re_find(code, DECL_INIT) ~= nil then
      local tail = trim(re_replace(code, "\\\\\\s*$", ""))
      if not ends_with(tail, ";") and not ends_with(tail, "{") then
        push(found, {path = p, line = n, rule = "wrapped", text = raw})
      end
    end
    if trimmed == "{" or starts_with(trimmed, "else") then
      push(found, {path = p, line = n, rule = "brace", text = raw})
    end
    if find(raw, "\t") ~= nil then
      push(found, {path = p, line = n, rule = "tab", text = raw})
    end
    if find(raw, "/*") ~= nil and not ends_with(raw, "\\") then
      push(found, {path = p, line = n, rule = "comment", text = raw})
    end
    if raw ~= "" and not starts_with(raw, " ") and not opens_top(raw) then
      push(found, {path = p, line = n, rule = "top level", text = raw})
    end
    if header and re_find(raw, [=[^[A-Za-z_].*\w\s*\(.*\)\s*\{]=]) ~= nil and not starts_with(raw, "static inline ") and not starts_with(raw, "#") then
      push(found, {path = p, line = n, rule = "inline", text = raw})
    end
  end
  return found
end

-- The C files under `dir`, the build's output left out.
function c_files(dir)
  local files = {}
  for p in glob(dir .. "/**/*") do
    if (ends_with(p, ".c") or ends_with(p, ".h")) and not starts_with(p, "c/out/") then push(files, p) end
  end
  sort(files)
  return files
end

function check_files(files)
  local found = {}
  for p in files do
    for f in check_file(p, starts_with(p, "c/foundation/")) do push(found, f) end
  end
  return found
end

-- The plants in `p` caught, judged as a foundation header or not: exactly
-- `want`, each "line rule", or the run fails. Gives how many.
function plants_hold(p, in_foundation, want)
  local got = {}
  for f in check_file(p, in_foundation) do push(got, f.line .. " " .. f.rule) end
  if join(got, ", ") ~= join(want, ", ") then
    fail("the discipline check's self-test caught " .. join(got, ", ") .. " in " .. p .. "; it should catch exactly " .. join(want, ", "))
  end
  return #want
end

function self_test()
  local dir = "c/out/discipline"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir)
  local p = dir .. "/plant.h"
  create(p, [=[// The discipline check's plants: lines 3 to 17 break a rule or two each, the rest pass.
#include "slice.h"
static inline void *grab(size_t n) { return malloc(n); }
static inline char first(Str s) { return s.ptr[0]; }
static inline char second(Str s) { return *(s.ptr + 1); }
static inline void name_it(const char *name) { (void)name; }
    const char *label;
    size_t a, b;
    uint64_t x = f(1, 2), y = 3;
static inline void allman(void)
{
    else {
]=] .. "\tint tabbed;\n" .. [=[
    /* a block comment */
void bare(void);
int not_inline(int x) {
    Status s = vec_grow_raw(a, &p,
static inline int ok_after_plants(void) { return 0; }
    static const Str names[2] = {
    Budgets b = budgets_default(); \
    int count;
static inline void give_back(Arena *a, void *p) { arena_free(a, p, 1); }
// a comment that says malloc(n) and s.ptr[0] and (const char *x) and int a, b;
static inline char first_ok(Str s) { return at(s, 0); }
static inline const char *said(void) { return "free(p) and s.ptr[0], int a, b;"; }
static inline void with_reason(const char *file) { (void)file; } // cstr: __FILE__
typedef struct {
    const char *ptr;
    size_t len;
} Good;
static inline char unchecked(Str s) { return at_unchecked(s, 0, "s is not empty"); }
static inline int calls(int a, int b) { int x = g(a, b); int ys[2] = {a, b}; Str s = (Str){"", 0}; return x + (int)sizeof ys + (int)s.len; }
    } else if (x) {
#define TWO(a, b) \
    /* inside a macro */ \
    (a + b)
TEST_MAIN(
)
]=])
  local want = {"1 header", "1 header", "38 header", "3 alloc", "4 raw index", "5 raw index", "6 cstr", "7 cstr", "8 one per line", "9 one per line",
    "11 brace", "11 top level", "12 brace", "13 tab", "13 top level", "14 comment", "15 top level", "16 top level", "16 inline", "17 one per line", "17 wrapped"}
  local caught = plants_hold(p, false, want)
  local outside = dir .. "/outside.h"
  create(outside, [=[// outside.h: the discipline check's plants for the bounds and Status rules; lines 4 to 10 break one each, the rest pass.
#ifndef SHALE_OUTSIDE_H
#define SHALE_OUTSIDE_H
static inline uint32_t first_slot(MapCore *m) { return m->index[0]; }
static inline char from_array(void) { char cs[4] = {0}; return cs[1]; }
static inline void shift(Str *keys, size_t n) { memmove(keys, keys + 1, n * sizeof(Str)); }
static inline Bytes bumped(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k++, 3); }
static inline Bytes called(Bytes b) { return SLICE_SUB(Bytes, b, f(1), 3); }
static inline Bytes assigned(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k = 1, 3); }
static inline Status dropped(Buf *b) { return buf_byte(b, 'x'); }
static inline STATUS_MUST_USE Status kept(Buf *b) { return buf_byte(b, 'x'); }
static inline Bytes plain(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k, k + 1); }
static inline bool compared(Bytes b, size_t k) { return SLICE_SUB(Bytes, b, k == 0 ? 0 : 1, 3).len >= 1; }
static inline void copy_checked(Bytes d, Str s) { memcpy(&at(d, 0), s.ptr, s.len); }
static inline void through_arrow(Buf *b, Str s) { memcpy(b->ptr, s.ptr, s.len); }
static inline char declared(void) { char cs[4] = {0}; Bytes all = {cs, 4}; return at(all, 1); }
#endif
]=])
  caught = caught + plants_hold(outside, false, {"4 raw index", "5 raw index", "6 mem arithmetic", "7 slice args", "8 slice args", "9 slice args", "10 must use"})
  local inside = dir .. "/inside.h"
  create(inside, [=[// inside.h: the mem arithmetic rule as the foundation is held to it: line 4 breaks it, line 6 passes by its DRAGON.
#ifndef SHALE_INSIDE_H
#define SHALE_INSIDE_H
static inline void shift(uint64_t *xs, size_t n) { memmove(xs, xs + 1, n); }
// DRAGON: bounds. A plant: the marker that lets a foundation call do its own arithmetic.
static inline void marked(uint64_t *xs, size_t n) { memmove(xs, xs + 1, n); }
#endif
]=])
  caught = caught + plants_hold(inside, true, {"4 mem arithmetic"})
  remove_tree(dir)
  print("PASS self-test: " .. caught .. " plants caught, every other line passed")
end

if arg("self_test", 0) == 1 then
  self_test()
else
  local files = c_files("c")
  local found = check_files(files)
  for f in found do print(f.path .. ":" .. f.line .. ": " .. f.rule .. ": " .. f.text) end
  if #found > 0 then fail(#found .. " breaks of the C's discipline in " .. #files .. " files") end
  print("PASS discipline: " .. #files .. " files")
end
