   aim = "counted_repetition_is_the_part_written_out,control_escapes_are_the_control_bytes_alone_and_in_a_class,a_class_holds_a_shorthand_an_escaped_byte_and_a_range_whose_end_is_escaped,compile_and_cache_put_leave_nothing_behind_when_the_arena_refuses,a_search_that_skips_finds_what_one_examining_every_position_finds_from_every_start,every_refusal_of_the_reader_says_zigs_text_at_zigs_byte,nocase_folds_bytes_and_classes_before_negation", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "if (regex_set_has(first, str_byte(rest, i))) return from + i;", new = "if (regex_set_has(first, str_byte(rest, i))) return from + i + 1;"},
  {name = "a state forgets its loops' bits",
   aim = "an_empty_turn_ends_its_loop_as_a_backtrackers_does", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "return at(p->base, pc) + k;", new = "return at(p->base, pc) + 0 * k;"},
  {name = "a count's optional copies are one short",
   aim = "counted_repetition_is_the_part_written_out", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "for (size_t k = least; k < most; k++) TRY(RegexNodeVec_push(&list, rest));", new = "for (size_t k = least + 1; k < most; k++) TRY(RegexNodeVec_push(&list, rest));"},
}

-- The `test "` lines of a Zig test file.
function zig_test_count(src)
  local n = 0
  for l in lines(read(src)) do
    if starts_with(l, "test \"") then n = n + 1 end
  end
  return n
end

function regex_block(t)
  local regex_tests = test_count("c/tests/test_regex.c")
  if regex_tests ~= REGEX_TESTS then fail("c/tests/test_regex.c has " .. regex_tests .. " TEST(s), and REGEX_TESTS says " .. REGEX_TESTS) end
  local regex_zig = zig_test_count("src/script/regex_test.zig")
  if regex_zig ~= REGEX_ZIG_TESTS then fail("src/script/regex_test.zig has " .. regex_zig .. " tests, and REGEX_ZIG_TESTS says " .. REGEX_ZIG_TESTS .. ": port the new one to c/tests/test_regex.c") end
  print("regex: " .. regex_tests .. " C tests, " .. regex_zig .. " of them regex_test.zig's")
  if not t.full then return nil end
  run_plants(t, "regex plants", REGEX_PLANTS)
  return nil
end
-- ── end of c/script/regex's block ──────────────────────────────────────

-- ── The command: c/shale.c and c/script's parser ───────────────────────
-- test_lex.c and test_parse.c run in the foundation's block with every test
-- file. Here: c/gen_preludes.shale writes the preludes the C `shale`
-- embeds, then c/shale.c is built under each of `t.builds` (tcc in the fast
-- tier, release and asan added in the full), and each binary's `--check` is
-- held to a script that parses and one that stops. In the full tier: the
-- faults below planted in a copy of c/script, each caught by its test file.

const PARSE_PLANTS = {
  {name = "a `break` outside a loop words its stop its own way",
   aim = "statements_hold_their_own_rules", dir = "script", file = "parse.h", caught_by = "test_parse",
   old = [=[S("`break` outside a loop")]=], new = [=[S("`break` is outside a loop")]=]},
}

-- The C `shale` under `build`, at c/out/<build>/shale (under `release`, the
-- one -O2 link, the binary the differ judges), then its `--check` of one
-- script that parses and one that stops, each held to Zig's exact report.
function build_command(t, build)
  local dir = OUT .. "/" .. build
  mkdir(dir)
  local bin = dir .. "/shale"
  local argv = {"tcc", "-std=c11", "-Wall", "-Werror", "-I" .. FOUNDATION}
  if build ~= "tcc" then argv = gcc_flags(build, FOUNDATION) end
  for a in {"-I" .. OUT .. "/gen", "-Ic", "c/shale.c", "-o", bin} do push(argv, a) end
  local c = run_in(t, "command " .. build, argv, {timeout_ms = 120000, tail = 40})
  if c.code ~= 0 then fail("`" .. build .. "` could not compile c/shale.c:\n" .. c.out) end
  local good = OUT .. "/command/good.shale"
  local bad = OUT .. "/command/bad.shale"
  if exists(OUT .. "/command") then remove_tree(OUT .. "/command") end
  mkdir(OUT .. "/command")
  create(good, "function f(x) return x end\nprint(f(trim(\" a \")))\n")
  create(bad, "print(1)\nlocal x = 1 @ 2\n")
  create(OUT .. "/command/mounts", "")
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(OUT .. "/command/mounts")}
  local g = run_in(t, "command " .. build, {bin, "--check", good}, {timeout_ms = 20000, tail = 10, env = env, want = WANT})
  if g.code ~= 0 or trim(g.out) ~= "── checked: it parses and compiles; nothing ran" then fail("`" .. build .. "`'s shale --check of a script that parses said:\n" .. g.out) end
  local b = run_in(t, "command " .. build, {bin, "--check", bad}, {timeout_ms = 20000, tail = 10, env = env, want = WANT})
  local said = "── stopped at " .. bad .. ":2:13: syntax: a character no token starts with, `@` (0 steps)\n── used: 0 of 5000000 steps, 0 of 10000 reads, 0 of 67108864 read bytes, 0 of 65536 output bytes"
  if b.code ~= 1 or trim(b.out) ~= said then fail("`" .. build .. "`'s shale --check of a script that stops said:\n" .. b.out) end
  return nil
end

function command_block(t)
  print(trim(must(run_in(t, "command preludes", {"shale", "c/gen_preludes.shale"}, {timeout_ms = 60000, tail = 5})).out))
  for b in t.builds do
    build_command(t, b)
    print("command " .. b .. ": c/out/" .. b .. "/shale built; its --check holds a script that parses and one that stops")
  end
  if not t.full then return nil end
  run_plants(t, "parse plants", PARSE_PLANTS)
  return nil
end
-- ── end of the command's block ─────────────────────────────────────────

-- ── The VM: c/script's values, compiler, VM and core builtins ──────────
-- test_vm.c runs in the foundation's block with every test file. Here, in
-- both tiers: its count held to VM_TESTS, then each command binary the
-- command's block built runs scripts that use only what the C runs, its
-- output, report and exit held to the installed Zig `shale`'s on the same
-- script, the oracle. In the full tier: the faults below planted in a copy
-- of c/script, each caught by test_vm.c under asan.

const VM_TESTS = 15
const VM_SCRIPTS = {
  {name = "runs", argv = {"--verbose"}, source = "function f(x) return x end\nprint(f(trim(\" a \")), #\"abc\" * 2, upper(\"x\") .. 1)\nlocal t = {3, 1, 2}\nprint(join(sort(t), \",\"))\n"},
  {name = "stops", argv = {}, source = "function g(n) return h(n) end\nfunction h(n) return n // 0 end\nprint(attempt(g, 1).error)\ng(2)\n"},
  {name = "budget", argv = {"--budget", "steps=500"}, source = "local s = \"\"\nwhile true do s = s .. \"x\" end\n"},
}
const VM_PLANTS = {
  {name = "an attempt catches a budget",
   aim = "a_budget_is_never_caught", dir = "script", file = "vm.c", caught_by = "test_vm",
   old = "if (s.cls == CLASS_BUDGET || r->unported) return OK;", new = "if (r->unported) return OK;"},
  {name = "an attempt leaves its call in the trail",
   aim = "attempt_makes_a_stop_a_value_and_the_run_goes_on", dir = "script", file = "vm.c", caught_by = "test_vm",
   old = "        r->ctx.calls.len = i - 1;", new = "        (void)0;"},
  {name = "`%` keeps the dividend's sign",
   aim = "division_floors_and_an_overflow_stops", dir = "script", file = "run.h", caught_by = "test_vm",
   old = "if (got != 0 && ((got < 0) != (b < 0))) got += b;", new = "if (0) got += b;"},
  {name = "a chain never grows in place",
   aim = "a_chain_grows_its_string_in_place", dir = "script", file = "run.h", caught_by = "test_vm",
   old = "bool in_place = same && total <= r->tail_cap;", new = "bool in_place = false;"},
  {name = "the output budget writes nothing of what overflows",
   aim = "the_output_budget_writes_what_fits", dir = "script", file = "run.h", caught_by = "test_vm",
   old = "if (buf_str(&r->out, str_sub(bytes, 0, room)) != OK)", new = "if (buf_str(&r->out, str_sub(bytes, 0, 0)) != OK)"},
}

function vm_block(t)
  local n = test_count("c/tests/test_vm.c")
  if n ~= VM_TESTS then fail("c/tests/test_vm.c has " .. n .. " TEST(s), and VM_TESTS says " .. VM_TESTS) end
  local dir = OUT .. "/vm"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir)
  create(dir .. "/mounts", "")
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(dir .. "/mounts"), SHALE_NOW = "1700000000"}
  for s in VM_SCRIPTS do
    local file = dir .. "/" .. s.name .. ".shale"
    create(file, s.source)
    local zig_argv = {"shale"}
    for w in s.argv do push(zig_argv, w) end
    push(zig_argv, file)
    local z = run_in(t, "vm", zig_argv, {timeout_ms = 20000, whole = 100000, env = env})
    for b in t.builds do
      local argv = {OUT .. "/" .. b .. "/shale"}
      for w in s.argv do push(argv, w) end
      push(argv, file)
      local c = run_in(t, "vm", argv, {timeout_ms = 20000, whole = 100000, env = env, want = WANT})
      if get(c, "code", -1) ~= z.code or c.out ~= z.out then
        fail("`" .. b .. "`'s shale ran " .. s.name .. ".shale unlike Zig's:\n--- zig (" .. z.code .. ")\n" .. z.out .. "\n--- c (" .. get(c, "code", -1) .. ")\n" .. c.out)
      end
    end
  end
  print("vm: " .. n .. " C tests; " .. #VM_SCRIPTS .. " scripts run as Zig runs them, under " .. #t.builds .. " build(s)")
  if not t.full then return nil end
  run_plants(t, "vm plants", VM_PLANTS)
  return nil
end
-- ── end of the VM's block ──────────────────────────────────────────────

-- ── The host's process plumbing, c/host ─────────────────────────────────
-- keep.c, job_record.c and spawn.c, apart from the foundation and the
-- script. In both tiers: each c/tests/host/test_*.c under each of
-- `t.builds`, held to its `TEST(` count, the spawn fixture built for each
