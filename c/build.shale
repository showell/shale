   aim = "only_the_last_allocation_grows_in_place", file = "arena.h", caught_by = "test_arena",
   old = "if (!arena_is_last(a, p, old_len)) return new_len <= old_len;", new = "if (!arena_is_last(a, p, old_len)) return true;"},
