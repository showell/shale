  {name = "the drain waits for the pipe to close",
   aim = "attack_a_grandchild_holding_the_pipe_after_its_leader_exits_never_holds_run", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (l.exited && (l.out_r < 0 || now >= l.drain_until)) break;", new = "(void)now; if (l.exited && l.out_r < 0) break;"},
  {name = "a sink's stop leaves the program running",
   aim = "a_sink_that_stops_ends_the_programs_group_and_reaps_it_before_the_stop_is_said", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "            if (!l.exited) {\n                kill(-pid, SIGKILL);\n                wait4(pid, &l.raw, 0, NULL);\n            }", new = "            (void)0;"},
  {name = "a TERM to shale is taken for a timeout",
   aim = "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back,attack_a_term_or_hup_the_program_sends_its_parent_mid_run_ends_its_group", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "            l->why = SPAWN_INTERRUPTED;", new = "            l->why = SPAWN_TIMEOUT;"},
  {name = "shale's mask is not put back",
   aim = "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back,a_sink_that_stops_ends_the_programs_group_and_reaps_it_before_the_stop_is_said,attack_a_term_or_hup_the_program_sends_its_parent_mid_run_ends_its_group", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (f->masked) sigprocmask(SIG_SETMASK, &f->old_mask, NULL);", new = "(void)f->old_mask;"},
  {name = "SIGPIPE keeps its default, and a stdin no one reads kills shale",
   aim = "attack_a_program_that_never_reads_its_stdin_leaves_shale_standing", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "sigaction(SIGPIPE, &act, NULL);", new = "(void)act;"},
}

-- `ms` and `cpu_ms` may differ from Zig's by this much, or a fifth of Zig's,
-- whichever is more: two runs of one program never take the same time.
const HOST_MS_SLACK = 250

-- The programs run both ways: the fixture's verb and arguments, `run`'s
-- `timeout_ms` and `tail`. A `grandchild N` line's pid is masked.
const HOST_VS_ZIG = {
  {args = {"lines", "3"}, timeout_ms = 10000, tail = 5},
  {args = {"exit", "7"}, timeout_ms = 10000, tail = 5},
  {args = {"kill-self"}, timeout_ms = 10000, tail = 5},
  {args = {"ignore-term", "20000"}, timeout_ms = 300, tail = 5},
  {args = {"sleep", "20000"}, timeout_ms = 0, tail = 5},
  {args = {"sleep", "300"}, timeout_ms = 10000, tail = 5},
  {args = {"burn", "300"}, timeout_ms = 10000, tail = 5},
  {args = {"burn-child", "300"}, timeout_ms = 10000, tail = 5},
  {args = {"spill-lines", "200000"}, timeout_ms = 60000, tail = 3},
  {args = {"spill", "2000000"}, timeout_ms = 60000, tail = 3},
  {args = {"grandchild-exit", "1000"}, timeout_ms = 10000, tail = 5},
  {args = {"grandchild-stay", "20000"}, timeout_ms = 300, tail = 5},
  {args = {"signal-parent", "15", "20000"}, timeout_ms = 30000, tail = 5},
}

-- The `-D` that tells spawn's tests where `build`'s fixture is. A program
-- includes the c/host files it needs by their relative paths (one
-- translation unit), so a plant's copy is found beside its test's copy.
function host_define(build)
  return "-DSPAWN_FIXTURE=\"" .. HOST_OUT .. "/" .. build .. "/spawn_fixture\""
end

-- A fixture or probe of c/tests/host compiled with GCC's release flags to
-- `bin`.
function host_compile(t, phase, src, bin)
  mkdir(dirname(bin))
  local argv = gcc_flags("release", FOUNDATION)
  for a in {host_define("release"), src, "-o", bin} do push(argv, a) end
  local c = run_in(t, phase, argv, {timeout_ms = 120000, tail = 40})
  if c.code ~= 0 then fail("could not compile " .. src .. ":\n" .. c.out) end
  return nil
end

-- The fields of the probe's first line, as a map.
function probe_fields(line)
  local f = {}
  for w in words(line) do
    local eq = find(w, "=")
    f[sub(w, 1, eq - 1)] = sub(w, eq + 1)
  end
  return f
end

function masked_pids(s)
  return re_replace(s, "grandchild \\d+", "grandchild N")
end

-- Whether two times agree within HOST_MS_SLACK or a fifth of Zig's.
function near(c, z)
  local d = c - z
  if d < 0 then d = -d end
  local slack = z // 5
  if slack < HOST_MS_SLACK then slack = HOST_MS_SLACK end
  return d <= slack
end

-- The programs of HOST_VS_ZIG whose two runs never overlap: those that burn
-- CPU, where two at once on the box's two cores moved `ms` by up to 73 ms
-- (serial, 22), and the one that signals its parent (shale itself, under
-- Zig's `run`). The others only wait, so their two runs wait side by side.
const HOST_VS_ZIG_ALONE = {"burn", "burn-child", "spill", "spill-lines", "signal-parent"}

-- The probe's run of one program: as a job, started before Zig's `run` of
-- it, or after it for one of HOST_VS_ZIG_ALONE, then waited for. Gives
-- {code, out}.
function probe_start(pargv, log)
  if exists(log) then remove(log) end
  if exists(log .. ".job") then remove(log .. ".job") end
  return job_start(pargv, {log = log, want = HOST_WANT})
end

function probe_finish(job, log, what)
  local w = job_wait(job, {timeout_ms = 120000})
  if w.ended ~= "exited" then
    job_stop(job)
    fail("vs zig `" .. what .. "`: the probe ended " .. w.ended)
  end
  return {code = get(w, "code", -1), out = read(log)}
end

-- Each of HOST_VS_ZIG run by this script's `run` (Zig's) and by the probe
-- (the C's spawn and keep), side by side where both only wait
-- (HOST_VS_ZIG_ALONE), every field compared. Gives the lines to report.
function host_vs_zig(t)
  local t0 = clock_ms()
  local fixture = HOST_OUT .. "/release/spawn_fixture"
  local probe = HOST_OUT .. "/release/spawn_probe"
  host_compile(t, "host vs zig", HOST_PROBE, probe)
  local said = {}
  local k = 0
  for c in HOST_VS_ZIG do
    k = k + 1
    local argv = {real(fixture)}
    for a in c.args do push(argv, a) end
    local pargv = {real(probe), "" .. c.timeout_ms, "" .. c.tail}
    for a in argv do push(pargv, a) end
    local what = join(c.args, " ")
    local log = HOST_OUT .. "/vs_zig_" .. k .. ".log"
    local alone = has_item(HOST_VS_ZIG_ALONE, c.args[1])
    local job = nil
    if not alone then job = probe_start(pargv, log) end
    local z = attempt(run_in, t, "host vs zig", argv, {timeout_ms = c.timeout_ms, tail = c.tail, want = HOST_WANT})
    if alone then job = probe_start(pargv, log) end
    local p = probe_finish(job, log, what)
    if p.code ~= 0 then fail("vs zig `" .. what .. "`: the probe exited " .. p.code .. ":\n" .. p.out) end
    local nl = find(p.out, "\n")
    local f = probe_fields(sub(p.out, 1, nl - 1))
    local c_out = masked_pids(sub(p.out, nl + 1))
    if not z.ok then
      -- Zig's `run` stops the script when shale itself is told to stop.
      local said_z = "`run`: shale was told to stop (TERM or HUP) while `" .. argv[1] .. "` ran; it was ended"
      if find(z.error, said_z) == nil then fail("vs zig `" .. what .. "`: Zig's run stopped otherwise: " .. z.error) end
      if f.ended ~= "interrupted" then fail("vs zig `" .. what .. "`: Zig was interrupted, the C ended " .. f.ended) end
      push(said, "  same: " .. what .. ": interrupted, Zig's stop said; the C " .. f.ms .. " ms")
    else
      local r = z.value
      local z_code = "-"
      if has_key(r, "code") then z_code = "" .. r.code end
      local diffs = {}
      if f.ended ~= r.ended then push(diffs, "ended " .. f.ended .. " vs " .. r.ended) end
      if f.code ~= z_code then push(diffs, "code " .. f.code .. " vs " .. z_code) end
      for k in {"total_lines", "matched_lines", "kept_lines"} do
        if parse_int(f[k]) ~= r[k] then push(diffs, k .. " " .. f[k] .. " vs " .. r[k]) end
      end
      if c_out ~= masked_pids(r.out) then push(diffs, "out:\n" .. c_out .. "\nvs Zig's:\n" .. r.out) end
      if not near(parse_int(f.ms), r.ms) then push(diffs, "ms " .. f.ms .. " vs " .. r.ms) end
      if not near(parse_int(f.cpu_ms), r.cpu_ms) then push(diffs, "cpu_ms " .. f.cpu_ms .. " vs " .. r.cpu_ms) end
      if #diffs > 0 then fail("vs zig `" .. what .. "`: " .. join(diffs, "; ")) end
      push(said, "  same: " .. what .. ": " .. r.ended .. " " .. z_code .. ", " .. r.total_lines .. " lines; ms " .. f.ms .. " vs " .. r.ms .. ", cpu_ms " .. f.cpu_ms .. " vs " .. r.cpu_ms)
    end
  end
  phase_wall(t, "host vs zig", clock_ms() - t0)
  return said
end

function host_block(t)
  local tests = {}
  for p in glob("c/tests/host/test_*.c") do push(tests, p) end
  sort(tests)
  for b in t.builds do
    local phase = "host " .. b
    host_compile(t, phase, HOST_FIXTURE, HOST_OUT .. "/" .. b .. "/spawn_fixture")
    local total = 0
    for src in tests do total = total + test_file(t, phase, b, src, {host_define(b)}) end
    print("host " .. said_of_build(b, #tests, total))
  end
  if not t.full then return nil end
  run_plants(t, "host plants", HOST_PLANTS, {host_define("asan")})
  local vs = host_vs_zig(t)
  print("host vs zig: " .. #vs .. " of " .. #HOST_VS_ZIG .. " programs answered the same")
  for l in vs do print(l) end
  return nil
end
-- ── end of the host's block ─────────────────────────────────────────────

-- ── c/host's store, paths and undo journal: their own block ──────────────
-- c/tests/store/test_store.c (the store) and test_paths.c (the mounts, the
-- path hook, the secrets rule, the journal), each under every build of
-- `t.builds`, held to its `TEST(` count and to STORE_TESTS. The Zig test
-- files they port are held to STORE_ZIG_TESTS, so a Zig test added there is
-- one the C has yet to port. In the full tier: the faults below planted in
-- a copy of c/, c/tests/store copied whole beside it (its fixture.c reaches
-- the copy's c/host), each caught by its `aim` tests under asan.

const STORE_TESTS = {["c/tests/store/test_store.c"] = 14, ["c/tests/store/test_paths.c"] = 22}
const STORE_ZIG_TESTS = {["src/shale_abs_path_test.zig"] = 3, ["src/shale_undo_test.zig"] = 4, ["src/shale_ro_links_test.zig"] = 8}
const STORE_PLANTS = {
  {name = "a folder that begins with a mount's name is in it", file = "mounts.c", dir = "host", caught_by = "store/test_paths",
   aim = "a_folder_that_only_begins_with_another_s_name_is_not_in_it",
   old = "return str_starts_with(abs, dir) && (abs.len == dir.len || str_byte(abs, dir.len) == '/');", new = "return str_starts_with(abs, dir);"},
  {name = "a link in a path is followed", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "the_store_follows_no_link_to_a_file_to_a_folder_in_the_middle_in_a_mount_out_of_the_root",
   old = "if (S_ISLNK(st.st_mode)) {", new = "if (0 && S_ISLNK(st.st_mode)) {"},
  {name = "a secrets mount's own name is let through", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "secrets_mounts_no_read_listing_change_path_or_argument_reaches_a_token_by_the_mount_or_another_way",
   old = "    if (m->secrets) {\n        return path_fail(", new = "    if (0 && m->secrets) {\n        return path_fail("},
  {name = "the root's way into a secrets folder is let through", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "secrets_mounts_no_read_listing_change_path_or_argument_reaches_a_token_by_the_mount_or_another_way",
   old = "        if (mounts_in_folder(abs, dir)) {\n            return path_fail(r, pos, CLASS_REFUSED, S(\"\\\"{s}\\\" is in the mount", new = "        if (0 && mounts_in_folder(abs, dir)) {\n            return path_fail(r, pos, CLASS_REFUSED, S(\"\\\"{s}\\\" is in the mount"},
  {name = "a `..` in a root path is let through to the name check", file = "path_run.c", dir = "host", caught_by = "store/test_paths",
   aim = "every_way_out_of_the_root_is_refused_before_the_store_is_asked",
   old = "        if (str_eq(part, S(\"..\"))) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"`{s}`: ", new = "        if (0) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"`{s}`: "},
  {name = "an absolute path gets the empty part's stop", file = "path_run.c", dir = "host", caught_by = "store/test_paths",
   aim = "every_way_out_of_the_root_is_refused_before_the_store_is_asked",
   old = "if (str_byte(rel, 0) == '/') return path_absolute_stop(r, pos, who, rel);", new = "(void)path_absolute_stop;"},
  {name = "a `..` in a mount's path is let through to the name check", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "mounts_a_mounts_paths_real_an_unknown_mount_or_a_missing_folder_named_the_files_mistakes_by_line",
   old = "        if (str_eq(part, S(\"..\"))) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"\\\"{s}\\\" climbs out of its mount", new = "        if (0) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"\\\"{s}\\\" climbs out of its mount"},
  {name = "a read-only mount is read-only only by its name", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "ro_mounts_every_change_through_one_is_refused_before_anything_is_written_a_read_works",
   old = "if (named || (under && !paths_under_writable_within(h, r, pos, abs, dir))) {", new = "if (named || (0 && under && !paths_under_writable_within(h, r, pos, abs, dir))) {"},
  {name = "a path is journaled at each change", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "undo_each_path_is_journaled_once_before_its_first_change_as_a_file_s_bytes_a_folder_or_nothing_there",
   old = "if (str_eq(at(h->journal, k).abs, abs)) return OK;", new = "(void)k;"},
  {name = "the journal takes a file past its room", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "undo_a_change_past_the_journal_s_room_a_file_it_cannot_read_a_path_neither_file_nor_folder_and_one_it_cannot_look_at_are_refused",
   old = "if ((uint64_t)st.st_size > room) {", new = "if (0 && (uint64_t)st.st_size > room) {"},
  {name = "the one check lets a host text name a secrets folder", file = "path_run.c", dir = "host", caught_by = "store/test_paths",
   aim = "the_secrets_rule_s_one_check_a_host_text_naming_a_secrets_folder_ends_the_process",
   old = "            if (names) {", new = "            if (0 && names) {"},
  {name = "an argument's link to a secrets folder is not followed", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "secrets_mounts_no_read_listing_change_path_or_argument_reaches_a_token_by_the_mount_or_another_way",
   old = "            if (mounts_in_folder(rp, dir)) {", new = "            if (0 && mounts_in_folder(rp, dir)) {"},
  {name = "an absolute path in a secrets folder names the mount above it", file = "paths.c", dir = "host", caught_by = "store/test_paths",
   aim = "an_absolute_path_s_stop_a_path_in_a_secrets_mount_s_folder_names_neither_the_mount_nor_its_folder",
   old = "if (m->secrets && mounts_in_folder(abs, mounts_trim_slash(m->dir))) return OK;", new = "(void)m;"},
  {name = "Wyhash's first secret is off by one", file = "store.c", dir = "host", caught_by = "store/test_store",
   aim = "wyhash_its_test_vectors",
   old = "0xa0761d6478bd642full", new = "0xa0761d6478bd642eull"},
  {name = "case tells two names apart", file = "store.c", dir = "host", caught_by = "store/test_store",
   aim = "case_does_not_tell_two_names_apart_and_the_first_case_is_kept",
   old = "if (p >= 'A' && p <= 'Z') p = (uint8_t)(p + 32);", new = "(void)0;"},
  {name = "a NUL inside a path reaches the kernel", file = "store.c", dir = "host", caught_by = "store/test_store",
   aim = "a_path_with_a_nul_inside_is_refused_before_any_call",
   old = "if (s.len > 0 && memchr(s.ptr, 0, s.len) != NULL) return STORE_BAD_PATH_NAME;", new = "(void)0;"},
  {name = "the metal host's depth is one deeper", file = "store.c", dir = "host", caught_by = "store/test_store",
   aim = "a_path_the_bare_metal_host_could_not_hold_is_refused_measured_as_it_would_spell_it",
   old = "if (depth > STORE_MAX_DEPTH) return STORE_PATH_TOO_DEEP;", new = "if (depth > STORE_MAX_DEPTH + 1) return STORE_PATH_TOO_DEEP;"},
  {name = "a refused rename leaves its sibling", file = "store.c", dir = "host", caught_by = "store/test_store",
   aim = "a_replace_onto_a_folder_fails_and_leaves_no_temporary_file_beside_it",
   old = "if (e != STORE_OK && from != NULL) unlink(from);", new = "(void)from;"},}

-- One store plant, the `k`th, as `start_plant` makes one, but with
-- c/tests/store copied whole beside the copy of c/, so its fixture.c reaches
-- the copy's c/host. `finish_plant` judges it.
function store_start_plant(t, p, k)
  local dir = OUT .. "/plants/store-" .. k
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/tests")
  for d in PLANT_DIRS do
    if exists("c/" .. d) then copy("c/" .. d, dir .. "/" .. d) end
  end
  copy("c/tests/store", dir .. "/tests/store")
  local file = dir .. "/" .. p.dir .. "/" .. p.file
  replace(file, replaced_once(read(file), p.old, p.new, p.name))
  local bin = dir .. "/bin/" .. basename(p.caught_by)
  compile_to(t, "store plants", "asan", dir .. "/tests/" .. p.caught_by .. ".c", dir .. "/foundation", bin)
  local log = dir .. "/run.log"
  local job = job_start({real(bin)}, {log = log, env = {TEST_ONLY = p.aim}, want = WANT})
  return {job = job, log = log, dir = dir, p = p}
end

function store_block(t)
  local tests = {}
  for src in keys(STORE_TESTS) do push(tests, src) end
  sort(tests)
  for src in tests do
    if test_count(src) ~= STORE_TESTS[src] then fail(src .. " has " .. test_count(src) .. " TEST(s), and STORE_TESTS says " .. STORE_TESTS[src]) end
  end
  for z in keys(STORE_ZIG_TESTS) do
    local n = zig_test_count(z)
    if n ~= STORE_ZIG_TESTS[z] then fail(z .. " has " .. n .. " tests, and STORE_ZIG_TESTS says " .. STORE_ZIG_TESTS[z] .. ": port the new one to c/tests/store") end
  end
  for b in t.builds do
    local total = 0
    for src in tests do total = total + test_file(t, "store " .. b, b, src) end
    print("store " .. said_of_build(b, #tests, total))
  end
  if not t.full then return nil end
  -- Two at a time, as `run_plants` runs them: each plant's tests run while
  -- the next one compiles.
  local t0 = clock_ms()
  local said = {}
  local pending = nil
  local k = 0
  for p in STORE_PLANTS do
    k = k + 1
    local started = store_start_plant(t, p, k)
    if pending ~= nil then push(said, finish_plant(pending)) end
    pending = started
  end
  if pending ~= nil then push(said, finish_plant(pending)) end
  phase_wall(t, "store plants", clock_ms() - t0)
  print("store plants: " .. #said .. " of " .. #STORE_PLANTS .. " caught")
  for l in said do print(l) end
  return nil
end
-- ── end of the store's block ─────────────────────────────────────────────

-- ── The phases' times ───────────────────────────────────────────────────

function seconds(ms)
  return (ms // 1000) .. "." .. ((ms % 1000) // 100) .. " s"
end

-- The table of each phase's programs, wall time and CPU time.
function report_phases(t)
  local rows = {}
  local ms = 0
  local cpu = 0
  for name in t.phase_order do
    local ph = t.phases[name]
    local shown = name
    if get(ph, "overlapped", false) then shown = name .. " *" end
    push(rows, {phase = shown, programs = ph.programs, wall = seconds(ph.ms), cpu = seconds(ph.cpu_ms)})
    ms = ms + ph.ms
    cpu = cpu + ph.cpu_ms
  end
  push(rows, {phase = "all", programs = "", wall = seconds(ms), cpu = seconds(cpu)})
  print(table(rows, {"phase", "programs", "wall", "cpu"}))
  if t.full then print("* its runs overlap: its wall is the clock's, and its programs and CPU count only those run in the foreground, not its jobs") end
  return nil
end

-- ── The run ─────────────────────────────────────────────────────────────

local t = {full = arg("full", 0) == 1, builds = {"tcc"}, phases = {}, phase_order = {}}
t.gcc = version_of({"gcc", "--version"})
local tcc = version_of({"tcc", "-v"})
if t.gcc == nil then fail("gcc is not installed: `sudo apt install gcc` (it builds the release and the sanitizers)") end
print("gcc: " .. t.gcc)
print("tcc: " .. (tcc or "MISSING"))
if tcc == nil then t.builds = {} end
if t.full then
  push(t.builds, "release")
  push(t.builds, "asan")
end
t.tests = {}
for p in glob("c/tests/test_*.c") do push(t.tests, p) end
sort(t.tests)

-- The blocks, in order.
foundation_block(t)
discipline_block(t)
regex_block(t)
command_block(t)
vm_block(t)
host_block(t)
store_block(t)

report_phases(t)
if tcc == nil then
  fail("tcc is not installed, so the inner loop did not run: `sudo apt install tcc` (Ubuntu noble's tcc 0.9.27+git20200814)")
end
if t.full then print("PASS full") else print("PASS fast (full=1 adds GCC release, ASan and the plants)") end
