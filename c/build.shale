-- c/build.shale: the C's builds and the checks that hold its tests honest,
-- in two tiers.
--
--   shale c/build.shale          the fast tier, the inner loop between edits:
--                                tcc runs every test file, each held to its
--                                `TEST(` count (test_spawn's quick tests
--                                alone: SLOW_TESTS wait out real time),
--                                then the discipline check and its
--                                self-test, the command under tcc, and each
--                                block's counts.
--   shale c/build.shale full=1   the full tier, before a merge: the fast tier,
--                                then GCC's -O2 for its warnings and ASan for
--                                the tests, and every block's full-only
--                                checks: the harness fixture, the compiler's
--                                refusals, and every planted fault.
--
-- **The builds.** `tcc` runs each test file (`tcc -run`). `release` is
-- -std=c11 -O2 -Wall -Wextra -Werror for its warnings alone: each test file
-- (the unity build's translation units, so every module's code) is compiled
-- with `-c`, never linked or run, since -Warray-bounds and -Wrestrict fire
-- only with the optimizer on and `-fsyntax-only` skips them; c/shale.c alone
-- is linked at -O2, the binary the differ judges. `asan` is -O0 with
-- -fsanitize=address,undefined, and runs every test file.
--
-- Every check runs in exactly one tier, and the full tier runs both.
--
-- **The pool.** In the full tier the GCC compiles of every block in POOLED
-- run before any test, two at a time, the longest first: each such block
-- runs once with `stage=plan` to say its compiles, c/build/pool.shale runs
-- them all, and the block then runs with `stage=prebuilt` on what the pool
-- built (c/build/lib.shale, "The pool").
--
-- **The blocks.** Each part of the C has a block, a script of its own in
-- c/build/ (BLOCKS below, run in order), and this script runs each in turn:
-- one script would pass the 64 KiB a Shale script may be. A block's script
-- `use`s c/build/lib.shale, the helpers every block shares, through a mount
-- named `build` that this script writes and hands it (`SHALE_MOUNTS`): `use`
-- takes a mount's path, never the root's. So a block runs from here, not by
-- hand. A block takes `t`, the run: `t.full` says which tier runs, and
-- `t.builds` lists the builds to run under, `{"tcc"}` in the fast tier and
-- `{"tcc", "release", "asan"}` in the full. It runs its fast checks always
-- and its others under `if t.full then`. A new block is a script in c/build/
-- and its name in BLOCKS. `run_in(t, phase, argv, opts)` runs a program and
-- charges its time to `phase`; each block writes its phases to
-- c/out/phases/, and the table at the end prints every phase's programs,
-- wall time and CPU time, so a slow run says where its time went.
-- `test_file(t, phase, build, src, extra?)` takes one test file through a
-- build: run and held to its count, or for `release` compiled for its
-- warnings. The C is a unity build: a test file `#include`s the `.c` files
-- it needs, so each test file is one compile, under tcc or GCC alike.
--
-- Plants are one-time proofs that a test can see its fault, so they live in
-- the full tier alone: a change that adds or moves a test or a plant runs
-- `full=1` before it merges. A block's plants are a list it hands to
-- `run_plants(t, phase, plants, extra?)`, each planted in a copy of
-- c/foundation, c/script and c/host (`dir` names the folder), and each
-- naming in `aim` the tests that catch it: its test file runs those alone
-- (`TEST_ONLY`, test.h), so a plant costs its own tests, not the file's.
--
-- It reads each compiler's version first. A compiler that is missing fails the
-- run, loud, after everything it can run has run.
--
-- `binary=release|tcc to=<OS path>` builds the C `shale` alone, no tier
-- (c/build/binary.shale): what bench/baseline.shale times.
--
-- Run from the repository's root: shale c/build.shale [full=1]
-- budget: programs=100 arena_bytes=268435456

const OUT = "c/out"
const BLOCKS = {"foundation", "discipline", "regex", "command", "ran", "vm", "host", "store", "builtins", "host_builtins", "host_procs", "host_text", "host_zig", "gate"}
-- The blocks whose GCC compiles the full tier's pool builds (c/build/pool.shale
-- and lib.shale's "The pool"): each runs first with `stage=plan`, then with
-- `stage=prebuilt`. A block left out compiles its own.
const POOLED = {"foundation", "command", "ran", "host", "store", "builtins", "host_zig", "gate"}

-- The first line a compiler says of its version, or nil when it is missing.
function version_of(argv)
  local r = attempt(run, argv, {timeout_ms = 10000, head = 1})
  if not r.ok then return nil end
  if r.value.code ~= 0 then return nil end
  -- `head` adds a line saying how many it left out; the version is the first.
  return trim(lines(r.value.out)[1])
end

-- ── The phases' times ───────────────────────────────────────────────────

function seconds(ms)
  return (ms // 1000) .. "." .. ((ms % 1000) // 100) .. " s"
end

-- The table of each phase's programs, wall time and CPU time, every block's
-- in BLOCKS' order, as each wrote them to c/out/phases.
function report_phases(full)
  local rows = {}
  local ms = 0
  local cpu = 0
  local order = {}
  if full then push(order, "pool") end
  for b in BLOCKS do push(order, b) end
  for b in order do
    local p = json_read(read(OUT .. "/phases/" .. b .. ".json"))
    for name in p.order do
      local ph = p.phases[name]
      local shown = name
      if get(ph, "overlapped", false) then shown = name .. " *" end
      push(rows, {phase = shown, programs = ph.programs, wall = seconds(ph.ms), cpu = seconds(ph.cpu_ms)})
      ms = ms + ph.ms
      cpu = cpu + ph.cpu_ms
    end
  end
  push(rows, {phase = "all", programs = "", wall = seconds(ms), cpu = seconds(cpu)})
  print(table(rows, {"phase", "programs", "wall", "cpu"}))
  if full then
    print("* its runs overlap: its wall is the clock's, and its CPU every program's, two at a time as jobs (c/build/job.shale) or in the foreground; host vs zig's probes alone are left out")
    print("gcc compiles: every pooled block's compiles, run before any test; each one's CPU, and its count, is in its block's phase")
  end
  return nil
end

-- ── The run ─────────────────────────────────────────────────────────────

local full = arg("full", 0) == 1
local gcc = version_of({"gcc", "--version"})
local tcc = version_of({"tcc", "-v"})
if gcc == nil then fail("gcc is not installed: `sudo apt install gcc` (it builds the release and the sanitizers)") end
print("gcc: " .. gcc)
print("tcc: " .. (tcc or "MISSING"))
local builds = {}
if tcc ~= nil then push(builds, "tcc") end
if full then
  push(builds, "release")
  push(builds, "asan")
end
local said_builds = "none"
if #builds > 0 then said_builds = join(builds, ",") end

-- The `build` mount, c/build: a block reads its library there. The outer
-- run's `tools` mount goes with it, when there is one: the Zig tools' block
-- speaks to its zig-ast.
mkdir(OUT)
local mounts = OUT .. "/build.mounts"
local mount_line = "build = " .. real("c/build") .. " ro\n"
local tools = attempt(real, "tools:.")
if tools.ok then mount_line = mount_line .. "tools = " .. tools.value .. " ro tools\n" end
if exists(mounts) then replace(mounts, mount_line) else create(mounts, mount_line) end
-- Each run's phases, plans and compiles are its own: a binary a block takes
-- from the pool was built in this run.
for d in {"phases", "plan", "jobs", "plants"} do
  if exists(OUT .. "/" .. d) then remove_tree(OUT .. "/" .. d) end
end

-- The block `b` run (c/build/<b>.shale) with `args`; its output printed
-- unless `quiet` and it passed.
function run_block(b, args, mounts, quiet)
  local argv = {"shale", "c/build/" .. b .. ".shale"}
  for a in args do push(argv, a) end
  local r = run(argv, {timeout_ms = 900000, tail = 2000, env = {SHALE_MOUNTS = real(mounts)}, not_re = "^── (budgets from the script's header|time: )"})
  local failed = get(r, "code", -1) ~= 0
  if trim(r.out) ~= "" and (failed or not quiet) then print(trim(r.out)) end
  if failed then fail("the " .. b .. " block (c/build/" .. b .. ".shale " .. join(args, " ") .. ") failed: its output is above") end
  return nil
end

-- `binary=release` or `binary=tcc` builds the C `shale` alone, installed at
-- `to` (an OS path), and runs no tier: bench/baseline.shale's release and
-- debug builds (c/build/binary.shale).
local binary = arg("binary", "")
if binary ~= "" then
  if binary == "tcc" and tcc == nil then fail("binary=tcc: tcc is not installed (`sudo apt install tcc`)") end
  run_block("binary", {"build=" .. binary, "to=" .. arg("to", "")}, mounts, false)
  return nil
end

local said_full = "0"
if full then said_full = "1" end
local block_args = {"full=" .. said_full, "builds=" .. said_builds}
if full then
  -- The pool: each pooled block's plan, then every compile of them at once.
  for b in POOLED do run_block(b, {"full=1", "builds=" .. said_builds, "stage=plan"}, mounts, true) end
  run_block("pool", {"blocks=" .. join(POOLED, ",")}, mounts, false)
end
for b in BLOCKS do
  local args = block_args
  if full and has_item(POOLED, b) then args = {"full=1", "builds=" .. said_builds, "stage=prebuilt"} end
  run_block(b, args, mounts, false)
end

report_phases(full)
if tcc == nil then
  fail("tcc is not installed, so the inner loop did not run: `sudo apt install tcc` (Ubuntu noble's tcc 0.9.27+git20200814)")
end
if full then print("PASS full") else print("PASS fast (full=1 adds GCC release, ASan and the plants)") end
