   aim = "an_index_past_32_bits_traps_and_never_wraps_into_range", file = "slice.h", caught_by = "test_slice",
   old = "static inline size_t slice_check(uint64_t i,", new = "static inline size_t slice_check(uint32_t i,"},
  {name = "str_sub is a macro again, its arguments evaluated more than once",
   aim = "str_sub_evaluates_each_argument_once", file = "slice.h", caught_by = "test_slice",
   old = "#define str_sub(s, from, to) str_sub_at((s), (from), (to), __FILE__, __LINE__)", new = "#define str_sub(s, from, to) SLICE_SUB(Str, s, from, to)"},
  {name = "a view of the buffer itself is not rebased after the growth",
   aim = "appending_a_view_of_itself_past_ARENA_BIG_copies_what_it_held", file = "buf.h", caught_by = "test_buf",
