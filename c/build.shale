-- c/build.shale: the C's builds and the checks that hold its tests honest,
-- in two tiers.
--
--   shale c/build.shale          the fast tier, the inner loop between edits:
--                                tcc runs every test file, each held to its
--                                `TEST(` count (test_spawn's quick tests
--                                alone: SLOW_TESTS wait out real time),
--                                then the discipline check and its
--                                self-test, the command under tcc, and each
--                                block's counts.
--   shale c/build.shale full=1   the full tier, before a merge: the fast tier,
--                                then GCC's -O2 for its warnings and ASan for
--                                the tests, and every block's full-only
--                                checks: the harness fixture, the compiler's
--                                refusals, and every planted fault; then the
--                                golden tests (tests/golden.shale) and the
--                                cookbook's self-tests under the -O2 binary,
--                                c/out/release/shale, every cookbook file's
--                                `--check`, and Shale's docs' citations
--                                (tools/doc_check.shale).
--
-- **The builds.** `tcc` runs each test file (`tcc -run`). `release` is
-- -std=c11 -O2 -Wall -Wextra -Werror for its warnings alone: each test file
-- (the unity build's translation units, so every module's code) is compiled
-- with `-c`, never linked or run, since -Warray-bounds and -Wrestrict fire
-- only with the optimizer on and `-fsyntax-only` skips them; c/shale.c alone
-- is linked at -O2, the binary the golden tests judge. `asan` is -O0 with
-- -fsanitize=address,undefined, and runs every test file.
--
-- Every check runs in exactly one tier, and the full tier runs both.
--
-- **The pool.** In the full tier the GCC compiles of every block in POOLED
-- run before any test, two at a time, the longest first: each such block
-- runs once with `stage=plan` to say its compiles, c/build/pool.shale runs
-- them all, and the block then runs with `stage=prebuilt` on what the pool
-- built (c/build/lib.shale, "The pool").
--
-- **The blocks.** Each part of the C has a block, a script of its own in
-- c/build/ (BLOCKS below, run in order), and this script runs each in turn:
-- one script would pass the 64 KiB a Shale script may be. A block's script
-- `use`s c/build/lib.shale, the helpers every block shares, through a mount
-- named `build` that this script writes and hands it (`SHALE_MOUNTS`): `use`
-- takes a mount's path, never the root's. So a block runs from here, not by
-- hand. A block takes `t`, the run: `t.full` says which tier runs, and
-- `t.builds` lists the builds to run under, `{"tcc"}` in the fast tier and
-- `{"tcc", "release", "asan"}` in the full. It runs its fast checks always
-- and its others under `if t.full then`. A new block is a script in c/build/
-- and its name in BLOCKS. `run_in(t, phase, argv, opts)` runs a program and
-- charges its time to `phase`; each block writes its phases to
-- c/out/phases/, and the table at the end prints every phase's programs,
-- wall time and CPU time, so a slow run says where its time went.
-- `test_file(t, phase, build, src, extra?)` takes one test file through a
-- build: run and held to its count, or for `release` compiled for its
-- warnings. The C is a unity build: a test file `#include`s the `.c` files
-- it needs, so each test file is one compile, under tcc or GCC alike.
--
-- Plants are one-time proofs that a test can see its fault, so they live in
-- the full tier alone, and run only when asked: `full=1 plants=due` runs
-- those whose text, file or tests' files changed since each was last caught
-- (lib.shale, "Proofs"), and `full=1 plants=all` runs every one, after a
-- change a proof cannot see: the compilers, test.h, or c/build's plant
-- machinery. A plain `full=1` runs none. A block's plants are a list it hands to
-- `run_plants(t, phase, plants, extra?)`, each planted in a copy of
-- c/foundation, c/script and c/host (`dir` names the folder), and each
-- naming in `aim` the tests that catch it: its test file runs those alone
-- (`TEST_ONLY`, test.h), so a plant costs its own tests, not the file's.
--
-- It reads each compiler's version first. A compiler that is missing fails the
-- run, loud, after everything it can run has run.
--
-- `binary=release|tcc to=<path>` builds the C `shale` alone, no tier
-- (c/build/binary.shale): what bench/baseline.shale times. `to` is a Shale
-- path (`scratch:x/shale`, `c/out/x/shale`), or an absolute OS path.
--
-- `refreeze=<block>/<name>,...` (or `<block>`) writes the named scripts'
-- frozen outputs (c/tests/frozen, lib.shale's "Frozen outputs") from the
-- first build's run, in a tier that runs as ever: a deliberate change's
-- refreeze, whose commit says why.
--
-- Run from the repository's root: shale c/build.shale [full=1 [plants=due|all]] [refreeze=...]
-- budget: programs=500 arena_bytes=268435456

const OUT = "c/out"
const BLOCKS = {"foundation", "discipline", "regex", "command", "ran", "vm", "host", "file_system", "builtins", "host_builtins", "host_procs", "host_text", "host_zig", "gate"}
-- The blocks whose GCC compiles the full tier's pool builds (c/build/pool.shale
-- and lib.shale's "The pool"): each runs first with `stage=plan`, then with
-- `stage=prebuilt`. A block left out compiles its own.
const POOLED = {"foundation", "command", "ran", "host", "file_system", "builtins", "host_zig", "gate"}

-- The first line a compiler says of its version, or nil when it is missing.
function version_of(argv)
  local r = attempt(run, argv, {timeout_ms = 10000, head = 1})
  if not r.ok then return nil end
  if r.value.code ~= 0 then return nil end
  -- `head` adds a line saying how many it left out; the version is the first.
  return trim(lines(r.value.out)[1])
end

-- ── The phases' times ───────────────────────────────────────────────────

function seconds_of(ms)
  return (ms // 1000) .. "." .. ((ms % 1000) // 100) .. " s"
end

-- The table of each phase's programs, wall time and CPU time, every block's
-- in BLOCKS' order, as each wrote them to c/out/phases; `plants` is the
-- run's `plants=` (empty for none).
function report_phases(full, plants)
  local rows = {}
  local ms = 0
  local cpu = 0
  local order = {}
  if full then push(order, "pool") end
  for b in BLOCKS do push(order, b) end
  if full then
    push(order, "golden")
    push(order, "cookbook")
    push(order, "recipes")
    push(order, "docs")
  end
  for b in order do
    local p = json_read(read(OUT .. "/phases/" .. b .. ".json"))
    for name in p.order do
      local ph = p.phases[name]
      local shown = name
      if get(ph, "overlapped", false) then shown = name .. " *" end
      push(rows, {phase = shown, programs = ph.programs, wall = seconds_of(ph.ms), cpu = seconds_of(ph.cpu_ms)})
      ms = ms + ph.ms
      cpu = cpu + ph.cpu_ms
    end
  end
  push(rows, {phase = "all", programs = "", wall = seconds_of(ms), cpu = seconds_of(cpu)})
  print(table(rows, {"phase", "programs", "wall", "cpu"}))
  if full then
    local ran = 0
    local skipped = 0
    for b in BLOCKS do
      local pl = get(json_read(read(OUT .. "/phases/" .. b .. ".json")), "plants", {ran = 0, skipped = 0})
      ran = ran + pl.ran
      skipped = skipped + pl.skipped
    end
    if plants == "" then
      print("plants: none run (`plants=due` runs those whose proof is stale, `plants=all` every one)")
    else
      print("plants: " .. ran .. " ran, " .. skipped .. " skipped as already proven (`plants=all` runs every one)")
    end
  end
  if full then
    print("* its runs overlap: its wall is the clock's, and its CPU every program's, two at a time as jobs (c/build/job.shale) or in the foreground")
    print("gcc compiles: every pooled block's compiles, run before any test; each one's CPU, and its count, is in its block's phase")
  end
  return nil
end

-- ── The run ─────────────────────────────────────────────────────────────

local full = arg("full", 0) == 1
local gcc = version_of({"gcc", "--version"})
local tcc = version_of({"tcc", "-v"})
if gcc == nil then fail("gcc is not installed: `sudo apt install gcc` (it builds the release and the sanitizers)") end
print("gcc: " .. gcc)
print("tcc: " .. (tcc or "MISSING"))
local builds = {}
if tcc ~= nil then push(builds, "tcc") end
if full then
  push(builds, "release")
  push(builds, "asan")
end
local said_builds = "none"
if #builds > 0 then said_builds = join(builds, ",") end

-- The `build` mount, c/build: a block reads its library there. `cookbook`,
-- this tree's own, is the discipline check's: its masker is
-- cookbook/c/items.shale, and the discipline block maps every C file with
-- cookbook/c/map_file.shale. The outer
-- run's `tools` mount goes with it, when there is one: the Zig tools' block
-- speaks to its zig-ast, and the host text block to its roc-ast and go-ast.
mkdir(OUT)
local mounts = OUT .. "/build.mounts"
local mount_line = "build = " .. real("c/build") .. " ro\ncookbook = " .. real("cookbook") .. " ro\n"
local tools = attempt(real, "tools:.")
if tools.ok then mount_line = mount_line .. "tools = " .. tools.value .. " ro tools\n" end
if exists(mounts) then replace(mounts, mount_line) else create(mounts, mount_line) end
-- Each run's phases, plans and compiles are its own: a binary a block takes
-- from the pool was built in this run.
for d in {"phases", "plan", "jobs", "plants"} do
  if exists(OUT .. "/" .. d) then remove_tree(OUT .. "/" .. d) end
end
-- No plant runs unless asked (Steve, 2026-11-18: a refactor's care goes into
-- reading it, not into re-proving tests). `plants=due` runs the plants whose
-- proof is stale (c/build/lib.shale, "Proofs"); `plants=all` forgets every
-- proof and runs each one.
local plants = arg("plants", "")
if plants ~= "" and ((plants ~= "all" and plants ~= "due") or not full) then fail("plants=" .. plants .. ": `due` or `all`, with full=1") end
if exists(OUT .. "/plants_mode") then remove(OUT .. "/plants_mode") end
if plants ~= "" then create(OUT .. "/plants_mode", plants .. "\n") end
if plants == "all" and exists(OUT .. "/proofs") then remove_tree(OUT .. "/proofs") end

-- The block `b` run (c/build/<b>.shale) with `args`; its output printed
-- unless `quiet` and it passed.
function run_block(b, args, mounts, quiet)
  local argv = {"shale", "c/build/" .. b .. ".shale"}
  for a in args do push(argv, a) end
  local r = run(argv, {timeout_ms = 900000, tail = 2000, env = {SHALE_MOUNTS = real(mounts)}, not_re = "^── (budgets from the script's header|time: )"})
  local failed = get(r, "code", -1) ~= 0
  if trim(r.out) ~= "" and (failed or not quiet) then print(trim(r.out)) end
  if failed then fail("the " .. b .. " block (c/build/" .. b .. ".shale " .. join(args, " ") .. ") failed: its output is above") end
  return nil
end

-- `binary=release` or `binary=tcc` builds the C `shale` alone, installed at
-- `to`, and runs no tier: bench/baseline.shale's release and debug builds
-- (c/build/binary.shale). `to` is a Shale path, through this run's mounts
-- (the block's own are only `build`, `cookbook` and `tools`), or an absolute
-- OS path, as bench/baseline.shale's `{prefix}` is; the block is handed the
-- OS path. Without `to`, the binary stays where it is built,
-- c/out/<binary>/shale.
local binary = arg("binary", "")
local to = arg("to", "")
if binary ~= "" then
  if binary == "tcc" and tcc == nil then fail("binary=tcc: tcc is not installed (`sudo apt install tcc`)") end
  if to == "" then to = "c/out/" .. binary .. "/shale" end
  if not starts_with(to, "/") then to = real(to) end
  run_block("binary", {"build=" .. binary, "to=" .. to}, mounts, false)
  return nil
end
if to ~= "" then fail("to=" .. to .. ": only with `binary=release` or `binary=tcc`") end

local said_full = "0"
if full then said_full = "1" end
local block_args = {"full=" .. said_full, "builds=" .. said_builds}
-- The blocks with frozen outputs, which alone take `refreeze=`.
const FROZEN_BLOCKS = {"vm", "host_text", "host_zig", "gate"}
local refreeze = arg("refreeze", "")
for w in split(refreeze, ",") do
  local b = split(trim(w), "/")[1]
  if trim(w) ~= "" and not has_item(FROZEN_BLOCKS, b) then fail("refreeze=" .. refreeze .. ": `" .. trim(w) .. "` is no block with frozen outputs (" .. join(FROZEN_BLOCKS, ", ") .. ")") end
end
-- A block's own arguments, `refreeze=` to the blocks that take it.
function args_of(b, args, refreeze)
  if refreeze == "" or not has_item(FROZEN_BLOCKS, b) then return args end
  local out = {}
  for a in args do push(out, a) end
  push(out, "refreeze=" .. refreeze)
  return out
end
if full then
  -- The pool: each pooled block's plan, then every compile of them at once.
  for b in POOLED do run_block(b, args_of(b, {"full=1", "builds=" .. said_builds, "stage=plan"}, refreeze), mounts, true) end
  run_block("pool", {"blocks=" .. join(POOLED, ",")}, mounts, false)
end
for b in BLOCKS do
  local args = block_args
  if full and has_item(POOLED, b) then args = {"full=1", "builds=" .. said_builds, "stage=prebuilt"} end
  run_block(b, args_of(b, args, refreeze), mounts, false)
end

-- The golden tests (tests/golden.shale): every input the harness collects,
-- frozen with its output, held under the -O2 binary the command block
-- built. It runs with the box's own mounts, not the blocks' `build` mount,
-- and its time is a phase of its own.
if full then
  local g = run({"shale", "tests/golden.shale", "bin=" .. OUT .. "/release/shale"}, {timeout_ms = 900000, tail = 60, not_re = "^── (budgets from the script's header|time: )"})
  print(trim(g.out))
  if get(g, "code", -1) ~= 0 then fail("the golden tests (tests/golden.shale bin=" .. OUT .. "/release/shale) failed: their output is above") end
  mkdir(OUT .. "/phases")
  local text = json_write({order = {"golden"}, phases = {golden = {programs = 1, ms = g.ms, cpu_ms = get(g, "cpu_ms", 0)}}})
  local file = OUT .. "/phases/golden.json"
  if exists(file) then replace(file, text) else create(file, text) end
end

-- The cookbook's self-tests, live, as Zig Shale's `cookbook-test` step ran
-- them (legacy_zig/build.zig): every recipe under cookbook/ that reads `arg("self_test"`,
-- in sorted order, run from this tree with `self_test=1` by the binary under
-- test, first on PATH so a self-test's child runs are the same binary, under
-- a mounts file of `cookbook` (this tree's, read-only), `tools` (the box's,
-- or an empty folder) and `scratch` (a fresh folder, removed after). Each
-- says `ok` with its last line, or FAIL with its last 30; a failure is named
-- by recipe once all have run. The goldens freeze no recipe: a recipe and
-- its self-test change together.
const PATH_FRONT = [=[d="$1"; shift; PATH="$d:$PATH"; export PATH; exec "$@"]=]

function cookbook_self_tests(bin)
  local dir = OUT .. "/cookbook-test"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/scratch")
  local tools = attempt(real, "tools:.")
  local tools_path = ""
  if tools.ok then
    tools_path = tools.value
  else
    mkdir(dir .. "/tools")
    tools_path = real(dir .. "/tools")
  end
  create(dir .. "/mounts", "cookbook = " .. real("cookbook") .. " ro\ntools = " .. tools_path .. " ro tools\nscratch = " .. real(dir .. "/scratch") .. "\n")
  local recipes = {}
  for p in glob("cookbook/**/*.shale") do
    if contains(read(p), "arg(\"self_test\"") then push(recipes, p) end
  end
  sort(recipes)
  if #recipes == 0 then fail("cookbook-test: no recipe in cookbook/ reads arg(\"self_test\")") end
  local bad = {}
  local ms = 0
  local cpu = 0
  local env = {SHALE_MOUNTS = real(dir .. "/mounts")}
  -- A script cannot read PATH, so `sh` puts the binary's folder before the
  -- inherited one, as build.zig's step does: a recipe still finds `zig`.
  local front = {"sh", "-c", PATH_FRONT, "cookbook-test", real(dirname(bin)), real(bin)}
  for r in recipes do
    local argv = {}
    for a in front do push(argv, a) end
    push(argv, r)
    push(argv, "self_test=1")
    local got = run(argv, {timeout_ms = 600000, tail = 30, env = env, want = "c-tests: the binary under test, first on the inherited PATH, runs the cookbook's self-tests"})
    ms = ms + got.ms
    cpu = cpu + get(got, "cpu_ms", 0)
    local out = trim(got.out)
    if get(got, "code", -1) == 0 then
      local ls = lines(out)
      print("cookbook-test: ok   " .. r .. ": " .. get(ls, #ls, ""))
    else
      print("cookbook-test: FAIL " .. r .. ", its last lines:")
      for l in lines(out) do print("    " .. l) end
      push(bad, r)
    end
    yield()
  end
  remove_tree(dir)
  if #bad > 0 then fail("cookbook-test: self-test failed: " .. join(bad, " ")) end
  print("cookbook-test: " .. #recipes .. " recipes' self-tests passed")
  return {ms = ms, cpu_ms = cpu, programs = #recipes}
end

if full then
  local c = cookbook_self_tests(OUT .. "/release/shale")
  local text = json_write({order = {"cookbook"}, phases = {cookbook = c}})
  local file = OUT .. "/phases/cookbook.json"
  if exists(file) then replace(file, text) else create(file, text) end
end

-- Every .shale file under cookbook/ held to `shale --check` under the -O2
-- binary: it parses and compiles, plants included (none is meant not to
-- parse), each with the cookbook's own mounts, so a recipe that no self-test
-- runs still cannot rot unseen. A file that fails is named; the count is
-- printed.
function recipes_check(bin)
  local dir = OUT .. "/recipes-check"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/scratch")
  create(dir .. "/mounts", "cookbook = " .. real("cookbook") .. " ro\nscratch = " .. real(dir .. "/scratch") .. "\n")
  local env = {SHALE_MOUNTS = real(dir .. "/mounts"), SHALE_PRELUDE = ""}
  local ms = 0
  local cpu = 0
  local files = sort(glob("cookbook/**/*.shale"))
  local bad = {}
  for p in files do
    local got = run({real(bin), "--check", p}, {timeout_ms = 20000, tail = 5, env = env, want = "c-tests: the binary under test checks that a recipe parses"})
    ms = ms + got.ms
    cpu = cpu + get(got, "cpu_ms", 0)
    if get(got, "code", -1) ~= 0 then
      print("recipes: FAIL " .. p .. ": " .. trim(got.out))
      push(bad, p)
    end
  end
  remove_tree(dir)
  if #bad > 0 then fail("recipes: " .. #bad .. " of " .. #files .. " cookbook files do not parse: " .. join(bad, " ")) end
  print("recipes: " .. #files .. " cookbook files parse and compile")
  return {ms = ms, cpu_ms = cpu, programs = #files}
end

if full then
  local c = recipes_check(OUT .. "/release/shale")
  local text = json_write({order = {"recipes"}, phases = {recipes = c}})
  local file = OUT .. "/phases/recipes.json"
  if exists(file) then replace(file, text) else create(file, text) end
end

-- Shale's docs' citations, by tools/doc_check.shale under the -O2 binary:
-- its fixtures first, then every path and name this checkout's docs cite,
-- resolved here (`self=.`) and in the siblings the `repos` mount reaches.
-- A finding fails the run, named.
function docs_check(bin)
  local ms = 0
  local cpu = 0
  local budgets = {"--budget", "arena_bytes=2000000000", "--budget", "steps=1000000000", "--budget", "reads=1000000", "--budget", "read_bytes=2000000000", "--budget", "output_bytes=8000000"}
  for args in {{"self_test=1", "self=."}, {"self=.", "at=repos:", "only=shale"}} do
    local argv = {real(bin)}
    for a in budgets do push(argv, a) end
    push(argv, "tools/doc_check.shale")
    for a in args do push(argv, a) end
    local got = run(argv, {timeout_ms = 120000, tail = 30, want = "c-tests: the binary under test checks the docs' citations"})
    ms = ms + got.ms
    cpu = cpu + get(got, "cpu_ms", 0)
    if get(got, "code", -1) ~= 0 then
      print(trim(got.out))
      fail("docs: tools/doc_check.shale " .. join(args, " ") .. " failed: its output is above")
    end
    local ls = lines(trim(got.out))
    print("docs: " .. get(ls, #ls, ""))
  end
  return {ms = ms, cpu_ms = cpu, programs = 2}
end

if full then
  local d = docs_check(OUT .. "/release/shale")
  local text = json_write({order = {"docs"}, phases = {docs = d}})
  local file = OUT .. "/phases/docs.json"
  if exists(file) then replace(file, text) else create(file, text) end
end

report_phases(full, plants)
if tcc == nil then
  fail("tcc is not installed, so the inner loop did not run: `sudo apt install tcc` (Ubuntu noble's tcc 0.9.27+git20200814)")
end
if full then print("PASS full") else print("PASS fast (full=1 adds GCC release, ASan and the plants)") end
