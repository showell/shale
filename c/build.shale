  {name = "the arena's stop words its message its own way",
   aim = "every_budget_stop_says_what_zig_says,a_message_the_arena_refuses_falls_back_to_zigs_fallback,run_oom_is_the_arena_budget_with_its_function_and_trail", file = "err.h", caught_by = "test_err",
   old = "case BUDGET_ARENA: return S(\"the arena budget ran out\");", new = "case BUDGET_ARENA: return S(\"the arena budget is spent\");"},
  {name = "the calls are reported outermost first",
   aim = "a_report_gives_the_calls_innermost_first", file = "err.h", caught_by = "test_err",
   old = "const Call c = at(s->trail, k - 1);", new = "const Call c = at(s->trail, s->trail.len - k);"},
  {name = "a failed EXPECT passes", file = "test.h", caught_by = "harness",
   old = "if (!(cond)) test_fail(__FILE__, __LINE__, S(#cond));", new = "if (0 && !(cond)) test_fail(__FILE__, __LINE__, S(#cond));"},
  {name = "a failure loses its line", file = "test.h", caught_by = "harness",
   old = "(int)t->current.len, t->current.ptr, file, line,", new = "(int)t->current.len, t->current.ptr, file, line * 0,"},
  {name = "TEST_ONLY runs every test", file = "test.h", caught_by = "harness",
   old = "if (only_env != NULL && !test_named(only, c->name)) continue;", new = "(void)test_named;"},
  {name = "TEST_ONLY lets a name no test has through", file = "test.h", caught_by = "harness",
   old = "if (only_env != NULL && !test_all_named(cases, only, &missing)) {", new = "if (0 && !test_all_named(cases, only, &missing)) {"},
