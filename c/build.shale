   aim = "at_traps_one_past_the_end_and_far_past_it,at_traps_on_an_empty_slice,at_traps_on_a_slice_cut_shorter_than_its_memory,a_bad_index_with_no_trap_ends_the_process,SLICE_SUB_keeps_the_type_and_its_bounds,str_byte_reads_bytes_unsigned", file = "slice.h", caught_by = "test_slice",
