  {name = "setting a key again is dropped",
   aim = "setting_a_key_again_keeps_its_place", file = "map.h", caught_by = "test_map",
   old = "            at(vals, e) = v;                                                                 \\\n            return OK;", new = "            (void)vals;                                                                      \\\n            return OK;"},
