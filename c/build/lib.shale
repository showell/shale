-- c/build/lib.shale: what every block of c/build.shale shares: running a
-- program charged to a phase, the builds' flags, a test file taken through a
-- build and held to its count, and the plants. A block's script `use`s it
-- through the `build` mount c/build.shale gives it.

const FOUNDATION = "c/foundation"
const OUT = "c/out"
const WANT = "c-tests: the build's own test binary, made under c/out"

-- ── The run: its programs, charged to phases ────────────────────────────

-- `programs` programs charged to `phase` of the run `t`, with their wall
-- and CPU times.
function charge(t, phase, programs, ms, cpu_ms)
  if not has_key(t.phases, phase) then
    push(t.phase_order, phase)
    t.phases[phase] = {programs = 0, ms = 0, cpu_ms = 0}
  end
  local ph = t.phases[phase]
  ph.programs = ph.programs + programs
  ph.ms = ph.ms + ms
  ph.cpu_ms = ph.cpu_ms + cpu_ms
  return nil
end

-- `run`, its time charged to `phase` of the run `t`.
function run_in(t, phase, argv, opts)
  local r = run(argv, opts)
  charge(t, phase, 1, r.ms, get(r, "cpu_ms", 0))
  return r
end

-- ── Jobs: two programs at a time ─────────────────────────────────────────
-- The box has two cores, so two compiles at once take about half the wall
-- time of two in turn. A job's CPU time is not in this run's `run`s, so
-- each job is c/build/job.shale running the program under `run` and
-- writing `run`'s answer, `cpu_ms` among it, which is charged to the
-- program's phase.

-- `argv` started as a job, `opts` its `timeout_ms` and `env` and `want` if
-- given; its spec and answer are files named `name` in `dir`.
function job_run_start(dir, name, argv, opts)
  mkdir(dir)
  local spec = dir .. "/" .. name .. ".json"
  local s = {argv = argv, timeout_ms = opts.timeout_ms}
  if has_key(opts, "env") then s.env = opts.env end
  if has_key(opts, "want") then s.want = opts.want end
  for f in {spec, spec .. ".answer", spec .. ".log", spec .. ".log.job"} do
    if exists(f) then remove(f) end
  end
  create(spec, json_write(s))
  local job = job_start({"shale", "c/build/job.shale", "spec=" .. spec}, {log = spec .. ".log"})
  return {job = job, spec = spec, argv = argv}
end

-- A job of `job_run_start` waited for, its CPU time charged to `phase`.
-- Gives `run`'s answer, {ended, code (absent past the timeout), ms, cpu_ms,
-- out}.
function job_run_finish(t, phase, started)
  local w = job_wait(started.job, {timeout_ms = 900000})
  if w.ended ~= "exited" or get(w, "code", -1) ~= 0 then
    job_stop(started.job)
    fail("the job for `" .. join(started.argv, " ") .. "` ended " .. w.ended .. ":\n" .. read(started.spec .. ".log"))
  end
  local a = json_read(read(started.spec .. ".answer"))
  charge(t, phase, 1, 0, a.cpu_ms)
  return a
end

-- Which of `running` ({at, started}) has ended, waiting until one has:
-- its place in the list, looked for every 50 ms. A look at one job costs
-- about 70 steps and 1.3 KB of the arena (a record's read holds its length,
-- since adaf04d), so a pool of 150 s takes about 400,000 of its 5,000,000
-- steps and 8 MB of its 256 MiB arena, with no yield.
function first_ended(running)
  while true do
    local k = 0
    for r in running do
      k = k + 1
      if not job_alive(r.started.job) then return k end
    end
    sleep(50)
  end
  return 0
end

-- Each of `specs` ({name, argv, opts}, as `job_run_start` takes them) run
-- as a job, two at a time, under `phase`, the jobs' files in `dir`: as
-- either ends, the next starts, so a long compile holds one slot alone. The
-- phase's wall grows by what the clock saw. Gives the answers in `specs`'
-- order.
function run_jobs(t, phase, dir, specs)
  local t0 = clock_ms()
  local answers = {}
  for s in specs do push(answers, false) end
  local running = {}
  local at = 0
  for s in specs do
    at = at + 1
    if #running == 2 then
      local k = first_ended(running)
      answers[running[k].at] = job_run_finish(t, phase, running[k].started)
      if k == 1 then running = {running[2]} else running = {running[1]} end
    end
    push(running, {at = at, started = job_run_start(dir, s.name, s.argv, s.opts)})
  end
  for r in running do answers[r.at] = job_run_finish(t, phase, r.started) end
  charge(t, phase, 0, clock_ms() - t0, 0)
  t.phases[phase].overlapped = true
  return answers
end

-- ── The pool: every block's compiles, two at a time ─────────────────────
-- In the full tier, c/build.shale runs each block of its POOLED list twice.
-- First with `stage=plan`: the block runs no program but its cheap setup,
-- and each compile it would start is recorded in `t.planned` and written to
-- c/out/plan/<block>.json. c/build/pool.shale then runs every plan's
-- compiles as jobs, two at a time, the longest first, before any test runs,
-- so neither core idles while one block's lone compile runs. Then each
-- block runs with `stage=prebuilt`: a compile is the answer the pool wrote,
-- held to the argv the plan gave (a binary built from other flags is never
-- run), its CPU charged to the block's phase. A block run alone, and every
-- block in the fast tier, has `stage = "all"` and compiles its own.

-- The answer the pool wrote for `s` ({name, argv}), its CPU charged to
-- `phase`. A compile no plan named, or one whose argv the plan gave
-- otherwise, stops the run: the binary there is not this run's.
function prebuilt_answer(t, phase, s)
  local spec = OUT .. "/jobs/" .. s.name .. ".json"
  if not exists(spec) or not exists(spec .. ".answer") then
    fail("the pool built no `" .. s.name .. "`: a block's `stage=prebuilt` run compiled what its `stage=plan` run did not plan")
  end
  if json_write(json_read(read(spec)).argv) ~= json_write(s.argv) then
    fail("the pool built `" .. s.name .. "` from another argv than this run's:\n" .. join(s.argv, " "))
  end
  local a = json_read(read(spec .. ".answer"))
  charge(t, phase, 1, 0, a.cpu_ms)
  return a
end

-- Each of `specs` ({name, argv, opts}, as `run_jobs` takes them) compiled
-- as `t.stage` says: recorded for the pool in a plan (giving nil, so the
-- caller runs nothing after it), taken from the pool's answers when
-- prebuilt, or run two at a time here (`run_jobs`). Gives the answers in
-- `specs`' order.
function compile_jobs(t, phase, specs)
  if t.stage == "plan" then
    for s in specs do push(t.planned, s) end
    return nil
  end
  if t.stage == "prebuilt" then
    local answers = {}
    for s in specs do push(answers, prebuilt_answer(t, phase, s)) end
    return answers
  end
  -- One compile alone has nothing to overlap, so it runs in the foreground.
  if #specs == 1 then return {run_in(t, phase, specs[1].argv, {timeout_ms = specs[1].opts.timeout_ms, whole = 60000})} end
  return run_jobs(t, phase, OUT .. "/jobs", specs)
end

-- The flags of a GCC build, `include` the foundation's folder.
function gcc_flags(build, include)
  local f = {"gcc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-I" .. include}
  if build == "release" then
    push(f, "-O2")
  else
    push(f, "-O0")
    push(f, "-g")
    push(f, "-fsanitize=address,undefined")
    push(f, "-fno-sanitize-recover=all")
    push(f, "-fno-omit-frame-pointer")
  end
  return f
end

-- A program at `bin` run, as {code, out}, `env` added to its environment if
-- given; a run past its timeout has no code, so it is a failure, said as one.
function run_binary(t, phase, bin, env?)
  local o = {timeout_ms = 180000, whole = 200000, want = WANT}
  if env ~= nil then o.env = env end
  local r = run_in(t, phase, {bin}, o)
  if not has_key(r, "code") then return {code = -1, out = r.out .. "\n(" .. r.ended .. ")"} end
  return {code = r.code, out = r.out}
end

-- The flags of the tcc build, `include` the foundation's folder.
function tcc_flags(include)
  return {"tcc", "-std=c11", "-Wall", "-Werror", "-I" .. include}
end

-- The argv that compiles `src` under `build` (`tcc` or a GCC build) over
-- `include` to `bin`: `extra` flags (a block's `-D`s) before `src`, and
-- `mode` (`-c`) after it when given. Makes `bin`'s folder.
function compile_argv(build, src, include, bin, extra?, mode?)
  mkdir(dirname(bin))
  local argv = nil
  if build == "tcc" then argv = tcc_flags(include) else argv = gcc_flags(build, include) end
  if extra ~= nil then
    for f in extra do push(argv, f) end
  end
  push(argv, src)
  if mode ~= nil then push(argv, mode) end
  push(argv, "-o")
  push(argv, bin)
  return argv
end

-- The argv that compiles the C `shale`, c/shale.c, under `build` to `bin`:
-- the command's block builds it so, and c/build/binary.shale, which
-- bench/baseline.shale times, builds it the same way.
function command_argv(build, bin)
  return compile_argv(build, "c/shale.c", FOUNDATION, bin, {"-I" .. OUT .. "/gen", "-Ic"})
end

-- Compiles `src` under `build` (`compile_argv`). A compile that fails stops
-- the run, naming it.
function compile_to(t, phase, build, src, include, bin, extra?, mode?)
  local argv = compile_argv(build, src, include, bin, extra, mode)
  local c = run_in(t, phase, argv, {timeout_ms = 120000, tail = 40})
  if c.code ~= 0 then fail("`" .. build .. "` could not compile " .. src .. ":\n" .. c.out) end
  return nil
end

-- `compile_to`, then the binary run, as {code, out}.
function compile_and_run(t, phase, build, src, include, bin, extra?)
  compile_to(t, phase, build, src, include, bin, extra)
  return run_binary(t, phase, bin)
end

-- The names of a test file's `TEST(`s, in order: the count its run must
-- print, and what `TEST_ONLY` may name.
function case_names(src)
  local names = {}
  for l in lines(read(src)) do
    if starts_with(l, "TEST(") then
      local m = re_find(l, "^TEST\\((\\w+)\\)")
      if m == nil then fail(src .. ": a `TEST(` line whose name this can't read: " .. l) end
      push(names, m.group)
    end
  end
  return names
end

function test_count(src)
  return #case_names(src)
end

-- The tests that wait out real time (deadlines, a TERM's grace, a CPU
-- burn), most of a second each: in a file here, every `attack_` test and
-- each one `waits` names. The fast tier runs the file's other tests alone,
-- and the full tier the whole file.
const SLOW_TESTS = {
  {file = "c/tests/host/test_spawn.c", waits = {
    "a_deadline_ends_it_a_signal_of_its_own_is_said_and_not_found_is_an_answer",
    "cpu_ms_counts_what_a_program_burns_a_child_waited_for_included_and_none_it_sleeps",
    "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back",
  }},
  -- Its attacks wait for a job's group to end, to the grace and past it.
  {file = "c/tests/host/test_jobs.c", waits = {}},
  -- Its attack waits out a TERM's grace before the KILL.
  {file = "c/tests/host_builtins/test_host_procs.c", waits = {}},
}

-- ── Binaries of several parts ───────────────────────────────────────────
-- A test file that ends with `TEST_PART(` is a part (test.h): it has no
-- `main`, and runs in the binary of TEST_BINARIES that includes it, which
-- ends with `TEST_PARTS_MAIN(` and prints each part's count in a line of
-- its own (c/build/ran.shale runs them). Its plants still name the part
-- as `caught_by`: `plant_copy` builds the part's binary.

const TEST_BINARIES = {"c/tests/ran_tests.c"}

-- Whether the test file `src` is a part of a binary of several.
function is_test_part(src)
  for l in lines(read(src)) do
    if starts_with(l, "TEST_PART(") then return true end
  end
  return false
end

-- The parts of the binary `src`, in its order: each `#include` of a
-- `test_*.c`, under `src`'s folder. A file with no `TEST_PARTS_MAIN(` has
-- none.
function test_parts(src)
  local text = read(src)
  local parts = {}
  local is_binary = false
  for l in lines(text) do
    if starts_with(l, "TEST_PARTS_MAIN(") then is_binary = true end
    local m = re_find(l, "^#include \"([\\w/]+\\.c)\"")
    if m ~= nil and starts_with(basename(m.group), "test_") then push(parts, path_normal(dirname(src) .. "/" .. m.group)) end
  end
  if not is_binary then return {} end
  return parts
end

-- The binary of TEST_BINARIES that `part` is a part of, or nil.
function binary_of(part)
  for b in TEST_BINARIES do
    if has_item(test_parts(b), part) then return b end
  end
  return nil
end

-- What a test file's run must print, `{text, n}`: for a file of its own,
-- `<src>: <n> tests passed`; for a binary, that line for each part. With
-- `quick`, each file's quick cases alone run (`quick_cases`), and a part
-- none of whose cases run says nothing.
function said_by(src, quick?)
  local files = test_parts(src)
  if #files == 0 then files = {src} end
  local said = {}
  local n = 0
  for f in files do
    local names = case_names(f)
    if quick ~= nil and quick then names = quick_cases(f, names) end
    if #names > 0 then push(said, f .. ": " .. #names .. " tests passed") end
    n = n + #names
  end
  return {text = join(said, "\n"), n = n}
end

-- A test file's run held to its count: it exited 0 and said exactly what
-- `said` (`said_by`) says. Gives the count.
function held_to(build, src, r, said)
  if r.code ~= 0 then fail("`" .. build .. "`: " .. src .. " exited " .. r.code .. ":\n" .. r.out) end
  if trim(r.out) ~= said.text then fail("`" .. build .. "`: " .. src .. " should run " .. said.n .. " TEST(s), saying\n" .. said.text .. "\nand its run said:\n" .. r.out) end
  return said.n
end

-- A part run as a file of its own stops the run: it has no `main`.
function not_a_part(src)
  if is_test_part(src) then fail(src .. " is a part (`TEST_PART(`): it runs in " .. (binary_of(src) or "no binary of TEST_BINARIES") .. ", not alone") end
  return nil
end

-- The names of `src`'s tests the fast tier runs: all of them, but for a file
-- of SLOW_TESTS its tests that don't wait. A `waits` name that names no test
-- stops the run, so the list can't go stale.
function quick_cases(src, all)
  for s in SLOW_TESTS do
    if s.file == src then
      for w in s.waits do
        if not has_item(all, w) then fail("SLOW_TESTS names `" .. w .. "`, and " .. src .. " has no such test") end
      end
      local quick = {}
      for c in all do
        if not starts_with(c, "attack_") and not has_item(s.waits, c) then push(quick, c) end
      end
      return quick
    end
  end
  return all
end

-- One test file under tcc, run and held to its count (in the fast tier, a
-- SLOW_TESTS file's quick tests alone). Gives how many tests ran.
function tcc_test(t, phase, src, extra?)
  not_a_part(src)
  local argv = tcc_flags(FOUNDATION)
  if extra ~= nil then
    for f in extra do push(argv, f) end
  end
  push(argv, "-run")
  push(argv, src)
  local o = {timeout_ms = 180000, tail = 40, want = WANT}
  local said = said_by(src)
  if not t.full then
    local quick = said_by(src, true)
    if quick.n < said.n then
      local names = {}
      local files = test_parts(src)
      if #files == 0 then files = {src} end
      for f in files do
        for c in quick_cases(f, case_names(f)) do push(names, c) end
      end
      o.env = {TEST_ONLY = join(names, ",")}
    end
    said = quick
  end
  local r = run_in(t, phase, argv, o)
  if not has_key(r, "code") then r = {code = -1, out = r.out .. "\n(" .. r.ended .. ")"} end
  return held_to("tcc", src, r, said)
end

-- The test files `srcs` through `build`: under tcc each run and held to its
-- count (`tcc_test`); under `release` each compiled with `-c` for -O2's
-- warnings; under asan each built, then run and held to its count. The GCC
-- compiles run two at a time (`run_jobs`); the tests run one at a time, since
-- some hold a deadline to the millisecond. `extra` flags go to every
-- compiler. Gives how many tests ran.
function test_files(t, phase, build, srcs, extra?)
  local total = 0
  if build == "tcc" and t.stage == "plan" then return 0 end
  if build == "tcc" then
    for src in srcs do total = total + tcc_test(t, phase, src, extra) end
    return total
  end
  local specs = {}
  local bins = {}
  for src in srcs do
    not_a_part(src)
    local name = sub(basename(src), 1, #basename(src) - 2)
    local bin = OUT .. "/" .. build .. "/" .. name
    local argv = nil
    if build == "release" then
      argv = compile_argv(build, src, FOUNDATION, bin .. ".o", extra, "-c")
    else
      argv = compile_argv(build, src, FOUNDATION, bin, extra)
    end
    push(specs, {name = build .. "-" .. name, argv = argv, opts = {timeout_ms = 120000}})
    push(bins, bin)
  end
  local answers = compile_jobs(t, phase, specs)
  if answers == nil then return 0 end
  local i = 0
  for a in answers do
    i = i + 1
    if get(a, "code", -1) ~= 0 then fail("`" .. build .. "` could not compile " .. srcs[i] .. ":\n" .. a.out) end
  end
  if build == "release" then return 0 end
  i = 0
  for src in srcs do
    i = i + 1
    total = total + held_to(build, src, run_binary(t, phase, bins[i]), said_by(src))
  end
  return total
end

-- One test file through `build`, as `test_files` takes a list.
function test_file(t, phase, build, src, extra?)
  return test_files(t, phase, build, {src}, extra)
end

-- What a line of a build's tests says it did.
function said_of_build(build, files, tests)
  if build == "release" then return build .. ": " .. files .. " files compiled at -O2 with no warning" end
  return build .. ": " .. tests .. " tests in " .. files .. " files passed"
end

-- ── Plants ───────────────────────────────────────────────────────────────

-- `text` with `old`, which must be there exactly once, made `new`.
function replaced_once(text, old, new, what)
  local i = find(text, old)
  if i == nil then fail("plant `" .. what .. "`: its text is not in the foundation") end
  if find(text, old, i + 1) ~= nil then fail("plant `" .. what .. "`: its text is in the foundation twice") end
  return sub(text, 1, i - 1) .. new .. sub(text, i + #old)
end

-- The names of the tests a run's output says failed, or what ended it.
function caught_how(out)
  local names = {}
  for l in lines(out) do
    local m = re_find(l, "^FAIL (\\w+)")
    if m ~= nil then push(names, m.group) end
    if find(l, "ERROR: AddressSanitizer") ~= nil then push(names, "AddressSanitizer") end
    if find(l, "ERROR: LeakSanitizer") ~= nil then push(names, "the leaks a failed test leaves") end
    if find(l, "runtime error:") ~= nil then push(names, "UndefinedBehaviorSanitizer") end
    if l == "(timeout)" then push(names, "its timeout") end
  end
  if #names == 0 then return "its exit" end
  return join(unique(names), ", ")
end

-- The harness fixture's runs at `bin` and what each must print and exit:
-- the whole file, exactly its .expected; then `TEST_ONLY` naming a passing
-- case and a failing one, one passing case, and a name no case has.
function harness_cases()
  local file = "c/tests/fixtures/harness_fails.c"
  return {
    {only = "", code = 1, out = read("c/tests/fixtures/harness_fails.expected")},
    {only = "passes,eq_fails", code = 1, out = "  3 is 3, 4 is 4\nFAIL eq_fails (" .. file .. ":17): 3 == 4\n" .. file .. ": 1 of 2 tests failed\n"},
    {only = "passes", code = 0, out = file .. ": 1 tests passed\n"},
    {only = "passes,nope", code = 1, out = file .. ": no test named `nope`\n"},
  }
end

-- Whether every run of `harness_cases` printed and exited as it must.
function harness_holds(t, phase, bin)
  for c in harness_cases() do
    local env = nil
    if c.only ~= "" then env = {TEST_ONLY = c.only} end
    local r = run_binary(t, phase, bin, env)
    if r.code ~= c.code or r.out ~= c.out then return false end
  end
  return true
end

-- The folders of c/ a plant copies, so every relative `#include` between
-- them reaches the copy.
const PLANT_DIRS = {"foundation", "script", "host", "gate"}

-- One plant, the `k`th of `phase`, in its own copy of the C: `p.file` in
-- `p.dir` (`foundation` unless named; `script`, `host`) has its `old` made
-- `new`, in copies of PLANT_DIRS laid out as c/ is, so a relative
-- `#include` (`../script/cli.h`, `../../host/keep.c`) reaches the copy. The
-- test file `p.caught_by`, a path under c/tests (`test_parse`,
-- `host/test_keep`), is copied to its place beside them (with its whole
-- folder, when it is in one, so a fixture there reaches the copy's c/host),
-- compiled under `p.build` with `extra` flags if given, and its `p.aim`
-- tests alone are started as a job (`finish_plant` judges it), so the next
-- plant's compile runs while this one's tests wait. `harness` is the
-- fixture, compiled from its own path so the file names in its .expected
-- hold, and judged here. Gives {line} for a plant judged, else {job, ...}.
--
-- A plant's build is tcc unless it names `build = "asan"`: tcc compiles a
-- unity build about ten times faster than GCC at -O0 with the sanitizers,
-- and a plant whose aimed test fails by its own EXPECT is caught the same
-- under either. A fault only a sanitizer sees (a read past an end, an
-- overflow) names asan. In the full tier an asan plant's copy is made and
-- its compile planned in the block's `stage=plan` run, so the pool builds
-- it beside the other compiles; the `stage=prebuilt` run takes that copy
-- and that binary (`plant_job_name`, `compile_jobs`).
function start_plant(t, phase, p, k, extra?)
  local dir = plant_dir(phase, k)
  local pooled = get(p, "build", "tcc") == "asan" and p.caught_by ~= "harness" and t.stage ~= "all"
  if pooled and t.stage == "prebuilt" then
    if not exists(dir) then fail("plant `" .. p.name .. "`: its `stage=plan` run made no copy at " .. dir) end
  else
    plant_copy(dir, p)
  end
  if p.caught_by == "harness" then
    local bin = dir .. "/bin/harness_fails"
    compile_to(t, phase, "asan", "c/tests/fixtures/harness_fails.c", dir .. "/foundation", bin)
    if harness_holds(t, phase, bin) then fail("plant `" .. p.name .. "` was not caught: the harness fixture printed what it expects") end
    remove_tree(dir)
    return {line = "  caught: " .. p.name .. " (" .. p.file .. "), by the harness fixture"}
  end
  local src = dir .. "/tests/" .. plant_test_file(p)
  local bin = dir .. "/bin/" .. sub(basename(src), 1, #basename(src) - 2)
  if pooled then
    local argv = compile_argv("asan", src, dir .. "/foundation", bin, extra)
    local answers = compile_jobs(t, phase, {{name = plant_job_name(phase, k), argv = argv, opts = {timeout_ms = 120000}}})
    if answers == nil then return nil end
    if get(answers[1], "code", -1) ~= 0 then fail("`asan` could not compile " .. src .. ":\n" .. answers[1].out) end
  else
    compile_to(t, phase, get(p, "build", "tcc"), src, dir .. "/foundation", bin, extra)
  end
  local job = job_run_start(dir, "run", {bin}, {timeout_ms = 60000, env = {TEST_ONLY = p.aim}, want = WANT})
  return {job = job, dir = dir, p = p, phase = phase}
end

-- The folder of the `k`th plant of `phase`: every block's plants have
-- their own, since a plan makes its asan plants' copies before any runs.
function plant_dir(phase, k)
  return OUT .. "/plants/" .. re_replace(phase, "\\W", "_") .. "-" .. k
end

function plant_job_name(phase, k)
  return "plant-" .. re_replace(phase, "\\W", "_") .. "-" .. k
end

-- The copy of the C at `dir` that plant `p` is made in, as `start_plant`
-- says: PLANT_DIRS, `p.file` with its fault, and the test file it names.
function plant_copy(dir, p)
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/tests")
  for d in PLANT_DIRS do
    if exists("c/" .. d) then copy("c/" .. d, dir .. "/" .. d) end
  end
  local file = dir .. "/" .. get(p, "dir", "foundation") .. "/" .. p.file
  replace(file, replaced_once(read(file), p.old, p.new, p.name))
  if p.caught_by == "harness" then return nil end
  plant_aim_holds(p)
  local files = {"c/tests/" .. plant_test_file(p)}
  for f in test_parts(files[1]) do push(files, f) end
  for f in files do
    local rel = sub(f, #"c/tests/" + 1)
    if find(rel, "/") ~= nil then
      local d = dirname(rel)
      if not exists(dir .. "/tests/" .. d) then copy("c/tests/" .. d, dir .. "/tests/" .. d) end
    else
      copy(f, dir .. "/tests/" .. rel)
    end
  end
  -- The run fixture the parts of ran_tests.c share.
  copy("c/tests/ran.c", dir .. "/tests/ran.c")
  return nil
end

-- Plant `p`'s `aim` held to its test file: named, and every name a test of
-- `caught_by`. In a binary of several parts, TEST_ONLY takes any part's
-- case, so the aim is held to the part's own here.
function plant_aim_holds(p)
  if not has_key(p, "aim") then fail("plant `" .. p.name .. "` names no `aim`, the tests of " .. p.caught_by .. " that catch it") end
  local names = case_names("c/tests/" .. p.caught_by .. ".c")
  for a in split(p.aim, ",") do
    if not has_item(names, a) then fail("plant `" .. p.name .. "`'s aim names `" .. a .. "`, a test " .. p.caught_by .. " doesn't have") end
  end
  return nil
end

-- The test file plant `p` builds, under c/tests: its `caught_by`'s, or for
-- a part, its binary's.
function plant_test_file(p)
  local part = "c/tests/" .. p.caught_by .. ".c"
  local b = binary_of(part)
  if b == nil then b = part end
  return sub(b, #"c/tests/" + 1)
end

-- A started plant's run waited for and judged: its aimed tests must fail.
-- Gives the line to report.
function finish_plant(t, started)
  if has_key(started, "line") then return started.line end
  local p = started.p
  local a = job_run_finish(t, started.phase, started.job)
  local out = a.out
  local code = get(a, "code", -1)
  if a.ended == "timeout" then out = out .. "\n(timeout)" end
  if find(out, ": no test named `") ~= nil then fail("plant `" .. p.name .. "`'s aim names a test " .. p.caught_by .. " doesn't have:\n" .. out) end
  if a.ended == "exit" and code == 0 then fail("plant `" .. p.name .. "` was not caught: " .. p.caught_by .. "'s " .. p.aim .. " passed with it in " .. p.file) end
  remove_tree(started.dir)
  return "  caught: " .. p.name .. " (" .. p.file .. "), by " .. basename(p.caught_by) .. ": " .. caught_how(out)
end

-- The wall clock in milliseconds, for a phase whose programs overlap, so
-- the sum of their times is not its time.
function clock_ms()
  return parse_int(trim(must(run({"date", "+%s%3N"}, {timeout_ms = 5000, head = 1})).out))
end

-- `phase`'s wall time made `ms`, what the clock saw, for a phase whose runs
-- overlapped; its CPU time stays the foreground programs' alone.
function phase_wall(t, phase, ms)
  t.phases[phase].ms = ms
  t.phases[phase].overlapped = true
  return nil
end

-- ── Proofs: a plant runs once, until what it stands on changes ──────────
-- A plant is a one-time proof that its aimed tests can see its fault. Each
-- block's plants that were caught are kept in c/out/proofs/<phase>.json
-- (not tracked; each run that runs a plant rewrites it): a plant's proof is
-- its own text (every field, and the block's `extra` flags) and the git
-- hash of each file it stands on (`plant_files`). A plant whose proof is
-- the one kept is skipped as already proven; any change to its text, its
-- file or its tests' files runs it again. What a proof cannot see (another
-- file its tests reach, the compilers, this harness) is `plants=all`'s, on
-- c/build.shale's line, which forgets every proof.

const PROOFS = "c/out/proofs"

-- The files plant `p`'s proof stands on: the file it plants its fault in,
-- and the test file of its aimed tests and the binary it builds (the same
-- file, but for a part); for the harness fixture's plants, the fixture and
-- its .expected.
function plant_files(p)
  local files = {"c/" .. get(p, "dir", "foundation") .. "/" .. p.file}
  if p.caught_by == "harness" then
    push(files, "c/tests/fixtures/harness_fails.c")
    push(files, "c/tests/fixtures/harness_fails.expected")
    return files
  end
  push(files, "c/tests/" .. p.caught_by .. ".c")
  local b = "c/tests/" .. plant_test_file(p)
  if not has_item(files, b) then push(files, b) end
  return files
end

-- Plant `p`'s text held to the tree, whether it runs or is skipped: its
-- `old` is in its file exactly once, and its aim names its tests. A plant
-- that went stale fails here, loud, never skipped as proven.
function plant_text_holds(p)
  local file = "c/" .. get(p, "dir", "foundation") .. "/" .. p.file
  if not exists(file) then fail("plant `" .. p.name .. "`: its file " .. file .. " is not there") end
  replaced_once(read(file), p.old, p.new, p.name)
  if p.caught_by ~= "harness" then plant_aim_holds(p) end
  return nil
end

-- The git hash of each of `files`, by path, in one `git hash-object`.
function file_hashes(t, phase, files)
  local argv = {"git", "hash-object", "--"}
  for f in files do push(argv, f) end
  local r = must(run_in(t, phase, argv, {timeout_ms = 30000, whole = 1000000}))
  local hs = lines(trim(r.out))
  if #hs ~= #files then fail("`git hash-object` gave " .. #hs .. " hashes for " .. #files .. " files") end
  local by = {}
  local i = 0
  for f in files do
    i = i + 1
    by[f] = hs[i]
  end
  return by
end

-- Plant `p`'s proof: its fields, sorted, `extra`, and each of its files'
-- hashes in `hashes`.
function plant_proof(p, hashes, extra)
  local ks = keys(p)
  sort(ks)
  local ls = {}
  for k in ks do push(ls, k .. "=" .. p[k]) end
  local flags = {}
  if extra ~= nil then flags = extra end
  push(ls, "extra=" .. join(flags, " "))
  for f in plant_files(p) do push(ls, f .. "@" .. hashes[f]) end
  return join(ls, "\n")
end

function proofs_file(phase)
  return PROOFS .. "/" .. re_replace(phase, "\\W", "_") .. ".json"
end

-- The proofs kept for `phase`, by plant name; none when there is no file.
function proofs_kept(phase)
  local f = proofs_file(phase)
  if not exists(f) then return {} end
  return json_read(read(f))
end

-- Which of `plants` must run: each held to the tree (`plant_text_holds`),
-- then due unless its proof is the one kept. Gives {due, proofs}, `due`
-- each due plant's {p, k} (`k` its place among `plants`, its folder's
-- name), `proofs` every plant's proof by name.
function plants_due(t, phase, plants, extra)
  local kept = proofs_kept(phase)
  local files = {}
  for p in plants do
    plant_text_holds(p)
    for f in plant_files(p) do
      if not has_item(files, f) then push(files, f) end
    end
  end
  local hashes = {}
  if #files > 0 then hashes = file_hashes(t, phase, files) end
  local due = {}
  local proofs = {}
  local k = 0
  for p in plants do
    k = k + 1
    if has_key(proofs, p.name) then fail("two plants of `" .. phase .. "` are named `" .. p.name .. "`: a plant's proof is kept by its name") end
    proofs[p.name] = plant_proof(p, hashes, extra)
    if get(kept, p.name, "") ~= proofs[p.name] then push(due, {p = p, k = k}) end
  end
  return {due = due, proofs = proofs}
end

-- Each of `plants` under `phase` that is due (`plants_due`), with `extra`
-- flags if given, two at a time: each plant's tests run while the next one
-- compiles. Prints how many ran and were caught and how many were skipped
-- as already proven, then each run one's line, in order, and keeps every
-- plant's proof. In a block's `stage=plan` run it makes the due asan
-- plants' copies and plans their compiles, and runs nothing.
function run_plants(t, phase, plants, extra?)
  local d = plants_due(t, phase, plants, extra)
  if t.stage == "plan" then
    for x in d.due do
      if get(x.p, "build", "tcc") == "asan" and x.p.caught_by ~= "harness" then start_plant(t, phase, x.p, x.k, extra) end
    end
    return nil
  end
  local t0 = clock_ms()
  local said = {}
  local pending = nil
  for x in d.due do
    local started = start_plant(t, phase, x.p, x.k, extra)
    if pending ~= nil then push(said, finish_plant(t, pending)) end
    pending = started
  end
  if pending ~= nil then push(said, finish_plant(t, pending)) end
  -- Every plant due was caught (one that wasn't stopped the run), and the
  -- rest kept their proofs: every plant is proven now.
  mkdir(PROOFS)
  local f = proofs_file(phase)
  if exists(f) then replace(f, json_write(d.proofs)) else create(f, json_write(d.proofs)) end
  phase_wall(t, phase, clock_ms() - t0)
  local skipped = #plants - #d.due
  t.plants.ran = t.plants.ran + #d.due
  t.plants.skipped = t.plants.skipped + skipped
  print(phase .. ": " .. #d.due .. " ran, each caught; " .. skipped .. " skipped as already proven")
  for l in said do print(l) end
  return nil
end

-- The `test "` lines of a Zig test file.
function zig_test_count(src)
  local n = 0
  for l in lines(read(src)) do
    if starts_with(l, "test \"") then n = n + 1 end
  end
  return n
end

-- ── A block's run ──────────────────────────────────────────────────────

-- The run `t` a block's checks take: `full` the tier, `builds` the builds'
-- names as c/build.shale passes them (`tcc,release,asan`, or `none`), and
-- `stage` the pool's (`all` unless given; see "The pool" above).
function block_start(full, builds, stage?)
  local list = {}
  if builds ~= "none" then list = split(builds, ",") end
  local s = stage
  if s == nil then s = "all" end
  if not has_item({"all", "plan", "prebuilt"}, s) then fail("stage=" .. s .. ": a block's stage is all, plan or prebuilt") end
  return {full = full, builds = list, stage = s, planned = {}, phases = {}, phase_order = {}, plants = {ran = 0, skipped = 0}}
end

-- The block's phases written to c/out/phases/<name>.json, for c/build.shale's
-- table of every block's phases, with how many of its plants ran and how
-- many were skipped as already proven; in a plan, its compiles to
-- c/out/plan/<name>.json, for c/build/pool.shale.
function block_end(t, name)
  if t.stage == "plan" then
    mkdir(OUT .. "/plan")
    local plan = OUT .. "/plan/" .. name .. ".json"
    if exists(plan) then remove(plan) end
    create(plan, json_write(t.planned))
    return nil
  end
  mkdir(OUT .. "/phases")
  local file = OUT .. "/phases/" .. name .. ".json"
  local text = json_write({order = t.phase_order, phases = t.phases, plants = t.plants})
  if exists(file) then replace(file, text) else create(file, text) end
  return nil
end
