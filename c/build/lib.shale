-- c/build/lib.shale: what every block of c/build.shale shares: running a
-- program charged to a phase, the builds' flags, a test file taken through a
-- build and held to its count, and the plants. A block's script `use`s it
-- through the `build` mount c/build.shale gives it.

const FOUNDATION = "c/foundation"
const OUT = "c/out"
const WANT = "c-tests: the build's own test binary, made under c/out"

-- ── The run: its programs, charged to phases ────────────────────────────

-- `run`, its time charged to `phase` of the run `t`.
function run_in(t, phase, argv, opts)
  local r = run(argv, opts)
  if not has_key(t.phases, phase) then
    push(t.phase_order, phase)
    t.phases[phase] = {programs = 0, ms = 0, cpu_ms = 0}
  end
  local ph = t.phases[phase]
  ph.programs = ph.programs + 1
  ph.ms = ph.ms + r.ms
  ph.cpu_ms = ph.cpu_ms + get(r, "cpu_ms", 0)
  return r
end

-- The flags of a GCC build, `include` the foundation's folder.
function gcc_flags(build, include)
  local f = {"gcc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-I" .. include}
  if build == "release" then
    push(f, "-O2")
  else
    push(f, "-O0")
    push(f, "-g")
    push(f, "-fsanitize=address,undefined")
    push(f, "-fno-sanitize-recover=all")
    push(f, "-fno-omit-frame-pointer")
  end
  return f
end

-- A program at `bin` run, as {code, out}, `env` added to its environment if
-- given; a run past its timeout has no code, so it is a failure, said as one.
function run_binary(t, phase, bin, env?)
  local o = {timeout_ms = 60000, whole = 200000, want = WANT}
  if env ~= nil then o.env = env end
  local r = run_in(t, phase, {bin}, o)
  if not has_key(r, "code") then return {code = -1, out = r.out .. "\n(" .. r.ended .. ")"} end
  return {code = r.code, out = r.out}
end

-- Compiles `src` under the GCC build `build` over `include` to `bin`;
-- `extra` flags (a block's `-D`s) go before `src`, and `mode` (`-c`) after
-- it when given. A compile that fails stops the run, naming it.
function compile_to(t, phase, build, src, include, bin, extra?, mode?)
  mkdir(dirname(bin))
  local argv = gcc_flags(build, include)
  if extra ~= nil then
    for f in extra do push(argv, f) end
  end
  push(argv, src)
  if mode ~= nil then push(argv, mode) end
  push(argv, "-o")
  push(argv, bin)
  local c = run_in(t, phase, argv, {timeout_ms = 120000, tail = 40})
  if c.code ~= 0 then fail("`" .. build .. "` could not compile " .. src .. ":\n" .. c.out) end
  return nil
end

-- `compile_to`, then the binary run, as {code, out}.
function compile_and_run(t, phase, build, src, include, bin, extra?)
  compile_to(t, phase, build, src, include, bin, extra)
  return run_binary(t, phase, bin)
end

-- The names of a test file's `TEST(`s, in order: the count its run must
-- print, and what `TEST_ONLY` may name.
function case_names(src)
  local names = {}
  for l in lines(read(src)) do
    if starts_with(l, "TEST(") then
      local m = re_find(l, "^TEST\\((\\w+)\\)")
      if m == nil then fail(src .. ": a `TEST(` line whose name this can't read: " .. l) end
      push(names, m.group)
    end
  end
  return names
end

function test_count(src)
  return #case_names(src)
end

-- A test file's run held to its count: it exited 0 and said exactly that
-- its `n` tests passed. Gives the count.
function held_to(build, src, r, n)
  if r.code ~= 0 then fail("`" .. build .. "`: " .. src .. " exited " .. r.code .. ":\n" .. r.out) end
  local said = src .. ": " .. n .. " tests passed"
  if trim(r.out) ~= said then fail("`" .. build .. "`: " .. src .. " should run " .. n .. " TEST(s), and its run said:\n" .. r.out) end
  return n
end

-- The tests that wait out real time (deadlines, a TERM's grace, a CPU
-- burn), most of a second each: in a file here, every `attack_` test and
-- each one `waits` names. The fast tier runs the file's other tests alone,
-- and the full tier the whole file.
const SLOW_TESTS = {
  {file = "c/tests/host/test_spawn.c", waits = {
    "a_deadline_ends_it_a_signal_of_its_own_is_said_and_not_found_is_an_answer",
    "cpu_ms_counts_what_a_program_burns_a_child_waited_for_included_and_none_it_sleeps",
    "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back",
  }},
}

-- The names of `src`'s tests the fast tier runs: all of them, but for a file
-- of SLOW_TESTS its tests that don't wait. A `waits` name that names no test
-- stops the run, so the list can't go stale.
function quick_cases(src, all)
  for s in SLOW_TESTS do
    if s.file == src then
      for w in s.waits do
        if not has_item(all, w) then fail("SLOW_TESTS names `" .. w .. "`, and " .. src .. " has no such test") end
      end
      local quick = {}
      for c in all do
        if not starts_with(c, "attack_") and not has_item(s.waits, c) then push(quick, c) end
      end
      return quick
    end
  end
  return all
end

-- One test file through `build`: under tcc run and held to its count (in the
-- fast tier, a SLOW_TESTS file's quick tests alone); under `release`
-- compiled with `-c` for -O2's warnings; under asan built and run, held to
-- its count. `extra` flags go to every compiler. Gives how many tests ran.
function test_file(t, phase, build, src, extra?)
  local name = sub(basename(src), 1, #basename(src) - 2)
  local bin = OUT .. "/" .. build .. "/" .. name
  local all = case_names(src)
  if build == "tcc" then
    local argv = {"tcc", "-std=c11", "-Wall", "-Werror", "-I" .. FOUNDATION}
    if extra ~= nil then
      for f in extra do push(argv, f) end
    end
    push(argv, "-run")
    push(argv, src)
    local o = {timeout_ms = 60000, tail = 40, want = WANT}
    local n = #all
    if not t.full then
      local quick = quick_cases(src, all)
      if #quick < #all then o.env = {TEST_ONLY = join(quick, ",")} end
      n = #quick
    end
    local r = run_in(t, phase, argv, o)
    if not has_key(r, "code") then r = {code = -1, out = r.out .. "\n(" .. r.ended .. ")"} end
    return held_to(build, src, r, n)
  end
  if build == "release" then
    compile_to(t, phase, build, src, FOUNDATION, bin .. ".o", extra, "-c")
    return 0
  end
  return held_to(build, src, compile_and_run(t, phase, build, src, FOUNDATION, bin, extra), #all)
end

-- What a line of a build's tests says it did.
function said_of_build(build, files, tests)
  if build == "release" then return build .. ": " .. files .. " files compiled at -O2 with no warning" end
  return build .. ": " .. tests .. " tests in " .. files .. " files passed"
end

-- ── Plants ───────────────────────────────────────────────────────────────

-- `text` with `old`, which must be there exactly once, made `new`.
function replaced_once(text, old, new, what)
  local i = find(text, old)
  if i == nil then fail("plant `" .. what .. "`: its text is not in the foundation") end
  if find(text, old, i + 1) ~= nil then fail("plant `" .. what .. "`: its text is in the foundation twice") end
  return sub(text, 1, i - 1) .. new .. sub(text, i + #old)
end

-- The names of the tests a run's output says failed, or what ended it.
function caught_how(out)
  local names = {}
  for l in lines(out) do
    local m = re_find(l, "^FAIL (\\w+)")
    if m ~= nil then push(names, m.group) end
    if find(l, "ERROR: AddressSanitizer") ~= nil then push(names, "AddressSanitizer") end
    if find(l, "ERROR: LeakSanitizer") ~= nil then push(names, "the leaks a failed test leaves") end
    if find(l, "runtime error:") ~= nil then push(names, "UndefinedBehaviorSanitizer") end
    if l == "(timeout)" then push(names, "its timeout") end
  end
  if #names == 0 then return "its exit" end
  return join(unique(names), ", ")
end

-- The harness fixture's runs at `bin` and what each must print and exit:
-- the whole file, exactly its .expected; then `TEST_ONLY` naming a passing
-- case and a failing one, one passing case, and a name no case has.
function harness_cases()
  local file = "c/tests/fixtures/harness_fails.c"
  return {
    {only = "", code = 1, out = read("c/tests/fixtures/harness_fails.expected")},
    {only = "passes,eq_fails", code = 1, out = "  3 is 3, 4 is 4\nFAIL eq_fails (" .. file .. ":16): 3 == 4\n" .. file .. ": 1 of 2 tests failed\n"},
    {only = "passes", code = 0, out = file .. ": 1 tests passed\n"},
    {only = "passes,nope", code = 1, out = file .. ": no test named `nope`\n"},
  }
end

-- Whether every run of `harness_cases` printed and exited as it must.
function harness_holds(t, phase, bin)
  for c in harness_cases() do
    local env = nil
    if c.only ~= "" then env = {TEST_ONLY = c.only} end
    local r = run_binary(t, phase, bin, env)
    if r.code ~= c.code or r.out ~= c.out then return false end
  end
  return true
end

-- The folders of c/ a plant copies, so every relative `#include` between
-- them reaches the copy.
const PLANT_DIRS = {"foundation", "script", "host"}

-- One plant, the `k`th of `phase`, in its own copy of the C: `p.file` in
-- `p.dir` (`foundation` unless named; `script`, `host`) has its `old` made
-- `new`, in copies of PLANT_DIRS laid out as c/ is, so a relative
-- `#include` (`../script/cli.h`, `../../host/keep.c`) reaches the copy. The
-- test file `p.caught_by`, a path under c/tests (`test_parse`,
-- `host/test_keep`), is copied to its place beside them and compiled under
-- the asan build with `extra` flags if given, and its `p.aim` tests alone
-- are started as a job (`finish_plant` judges it), so the next plant's
-- compile runs while this one's tests wait. `harness` is the fixture,
-- compiled from its own path so the file names in its .expected hold, and
-- judged here. Gives {line} for a plant judged, else {job, ...}.
function start_plant(t, phase, p, k, extra?)
  local dir = OUT .. "/plants/" .. k
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/tests")
  for d in PLANT_DIRS do
    if exists("c/" .. d) then copy("c/" .. d, dir .. "/" .. d) end
  end
  local file = dir .. "/" .. get(p, "dir", "foundation") .. "/" .. p.file
  replace(file, replaced_once(read(file), p.old, p.new, p.name))
  if p.caught_by == "harness" then
    local bin = dir .. "/bin/harness_fails"
    compile_to(t, phase, "asan", "c/tests/fixtures/harness_fails.c", dir .. "/foundation", bin)
    if harness_holds(t, phase, bin) then fail("plant `" .. p.name .. "` was not caught: the harness fixture printed what it expects") end
    remove_tree(dir)
    return {line = "  caught: " .. p.name .. " (" .. p.file .. "), by the harness fixture"}
  end
  if not has_key(p, "aim") then fail("plant `" .. p.name .. "` names no `aim`, the tests of " .. p.caught_by .. " that catch it") end
  local src = dir .. "/tests/" .. p.caught_by .. ".c"
  mkdir(dirname(src))
  copy("c/tests/" .. p.caught_by .. ".c", src)
  local bin = dir .. "/bin/" .. basename(p.caught_by)
  compile_to(t, phase, "asan", src, dir .. "/foundation", bin, extra)
  local log = dir .. "/run.log"
  local job = job_start({real(bin)}, {log = log, env = {TEST_ONLY = p.aim}, want = WANT})
  return {job = job, log = log, dir = dir, p = p}
end

-- A started plant's run waited for and judged: its aimed tests must fail.
-- Gives the line to report.
function finish_plant(started)
  if has_key(started, "line") then return started.line end
  local p = started.p
  local w = job_wait(started.job, {timeout_ms = 60000})
  local out = read(started.log)
  local code = get(w, "code", -1)
  if w.ended == "timeout" then
    job_stop(started.job)
    out = out .. "\n(timeout)"
  end
  if w.ended ~= "exited" and w.ended ~= "timeout" then fail("plant `" .. p.name .. "`: its run ended " .. w.ended) end
  if find(out, ": no test named `") ~= nil then fail("plant `" .. p.name .. "`'s aim names a test " .. p.caught_by .. " doesn't have:\n" .. out) end
  if w.ended == "exited" and code == 0 then fail("plant `" .. p.name .. "` was not caught: " .. p.caught_by .. "'s " .. p.aim .. " passed with it in " .. p.file) end
  remove_tree(started.dir)
  return "  caught: " .. p.name .. " (" .. p.file .. "), by " .. basename(p.caught_by) .. ": " .. caught_how(out)
end

-- The wall clock in milliseconds, for a phase whose programs overlap, so
-- the sum of their times is not its time.
function clock_ms()
  return parse_int(trim(must(run({"date", "+%s%3N"}, {timeout_ms = 5000, head = 1})).out))
end

-- `phase`'s wall time made `ms`, what the clock saw, for a phase whose runs
-- overlapped; its CPU time stays the foreground programs' alone.
function phase_wall(t, phase, ms)
  t.phases[phase].ms = ms
  t.phases[phase].overlapped = true
  return nil
end

-- Each of `plants` under `phase`, with `extra` flags if given, two at a time:
-- each plant's tests run while the next one compiles. Prints how many were
-- caught, then each one's line, in order.
function run_plants(t, phase, plants, extra?)
  local t0 = clock_ms()
  local said = {}
  local pending = nil
  local k = 0
  for p in plants do
    k = k + 1
    local started = start_plant(t, phase, p, k, extra)
    if pending ~= nil then push(said, finish_plant(pending)) end
    pending = started
  end
  if pending ~= nil then push(said, finish_plant(pending)) end
  phase_wall(t, phase, clock_ms() - t0)
  print(phase .. ": " .. #said .. " of " .. #plants .. " caught")
  for l in said do print(l) end
  return nil
end

-- The `test "` lines of a Zig test file.
function zig_test_count(src)
  local n = 0
  for l in lines(read(src)) do
    if starts_with(l, "test \"") then n = n + 1 end
  end
  return n
end

-- ── A block's run ──────────────────────────────────────────────────────

-- The run `t` a block's checks take: `full` the tier, `builds` the builds'
-- names as c/build.shale passes them (`tcc,release,asan`, or `none`).
function block_start(full, builds)
  local list = {}
  if builds ~= "none" then list = split(builds, ",") end
  return {full = full, builds = list, phases = {}, phase_order = {}}
end

-- The block's phases written to c/out/phases/<name>.json, for c/build.shale's
-- table of every block's phases.
function block_end(t, name)
  mkdir(OUT .. "/phases")
  local file = OUT .. "/phases/" .. name .. ".json"
  local text = json_write({order = t.phase_order, phases = t.phases})
  if exists(file) then replace(file, text) else create(file, text) end
  return nil
end
