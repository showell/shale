-- c/build/discipline.shale: the discipline block.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")
use("cookbook:c/items.shale")

-- ── The discipline block ────────────────────────────────────────────────

const CANARY = "c/tests/canaries/tcc_struct_return.c"

-- What the canary prints when a compiler gets both shapes right.
const CANARY_RIGHT = "returned straight into a call: 0 of 5 wrong; kept in a local first: 0 of 5 wrong"

-- The canary under tcc, in both tiers: TCC 0.9.27 must still get a 12-byte
-- return passed straight into a call wrong, and the same return kept in a
-- local right. The day it gets both right, the rule the discipline check
-- holds (style.md, "Declarations") can be retired, and this says so.
function canary_tcc(t)
  local argv = tcc_flags(FOUNDATION)
  push(argv, "-run")
  push(argv, CANARY)
  local r = must(run_in(t, "discipline", argv, {timeout_ms = 30000, tail = 5}))
  local said = trim(r.out)
  if said == CANARY_RIGHT then
    fail("the canary " .. CANARY .. " found TCC right: a 12-byte struct returned straight into a call now arrives as made, so the 9-to-15-byte rule in c/docs/style.md (\"Declarations\") and its check in c/check_discipline.shale can be retired, with this canary")
  end
  if re_find(said, "^returned straight into a call: [1-5] of 5 wrong; kept in a local first: 0 of 5 wrong$") == nil then
    fail("the canary " .. CANARY .. " under tcc said what it shouldn't: the straight shape wrong and the local one right is TCC 0.9.27's bug, and it said:\n" .. said)
  end
  return "canary tcc: " .. said .. ", TCC 0.9.27's bug, still there"
end

-- The canary under GCC, in the full tier: both shapes right.
function canary_gcc(t)
  local bin = OUT .. "/canary/tcc_struct_return"
  compile_to(t, "discipline", "release", CANARY, FOUNDATION, bin)
  local r = run_binary(t, "discipline", bin)
  if r.code ~= 0 or trim(r.out) ~= CANARY_RIGHT then fail("the canary " .. CANARY .. " under GCC exited " .. r.code .. " and said:\n" .. r.out) end
  return "canary gcc: " .. CANARY_RIGHT
end

-- Each line of `p` in exactly one of `items`, or blank, or a `//` comment
-- line between them, or the build stops naming the line. Gives the count of
-- lines.
function accounted(p, items)
  local all = lines(read(p))
  local owner = {}
  for it in items do
    local k = it.first
    while k <= it.last do
      if has_key(owner, "" .. k) then fail(p .. ":" .. k .. ": in two items, `" .. owner["" .. k] .. "` and `" .. it.name .. "`") end
      owner["" .. k] = it.name
      k = k + 1
    end
  end
  local n = 0
  for raw in all do
    n = n + 1
    if not has_key(owner, "" .. n) and raw ~= "" and not starts_with(raw, "//") then fail(p .. ":" .. n .. ": in no item: " .. raw) end
  end
  return n
end

-- Every .c and .h under c/ (c/out left out) split by
-- cookbook/c/items.shale and accounted for, in one line. It was
-- `cookbook:c/map_file.shale tree=c`, until map_file was ported to Roc,
-- whose build (the platform's host after every change to C Shale, 25 to
-- 50 s) is no fast tier's: this is the Shale splitter that
-- c/check_discipline.shale reads with, proven here, and the Roc splitter
-- (cookbook/c/items/) is held to its goldens in the full tier.
function split_tree()
  local files = {}
  for e in walk_all("c", {kind = "file", skip = "out"}) do
    if ends_with(e.path, ".c") or ends_with(e.path, ".h") then push(files, e.path) end
  end
  sort(files)
  local total = 0
  local count = 0
  for p in files do
    local items = c_items(p)
    total = total + accounted(p, items)
    count = count + #items
    yield()
  end
  return "PASS c items: " .. #files .. " files under c, " .. total .. " lines, each in one item or between them; " .. count .. " items"
end

-- c/check_discipline.shale over the C, then its own self-test, in both
-- tiers; then every C file split into its items by cookbook/c/items.shale,
-- each line accounted for, so a file the splitter can't read fails the
-- build; then the canary, under tcc in both and GCC in the full.
function discipline_block(t)
  print(trim(must(run_in(t, "discipline", {"shale", "c/check_discipline.shale"}, {timeout_ms = 60000, tail = 20})).out))
  print(trim(must(run_in(t, "discipline", {"shale", "c/check_discipline.shale", "self_test=1"}, {timeout_ms = 60000, tail = 20})).out))
  print(split_tree())
  print(canary_tcc(t))
  if t.full then print(canary_gcc(t)) end
  return nil
end

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"))
discipline_block(t)
block_end(t, "discipline")
