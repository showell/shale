-- c/build/host_builtins.shale: the host builtins' block, c/host's `run`,
-- `sleep` and jobs in the C VM's host (host.c, host_refusals.c,
-- host_write_gate.c, host_run_secrets.c, host_run.c, jobs.c, host_jobs.c).
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The host builtins: their own block ──────────────────────────────────
-- c/tests/host_builtins/test_host_run.c and test_run_guards.c (the guards
-- before and while a program runs), held here to HOST_BUILTINS_TESTS: parts
-- of c/tests/ran_tests.c, which the ran block runs under every build and
-- holds to their `TEST(` counts. They run sources as the C `shale` does
-- (c/tests/ran.c), and their job tests run c/out/tcc/shale as the reaper,
-- which the command's block built. In the full tier: the
-- faults below planted in a copy of c/ (`run_plants`), each caught by its
-- `aim` tests.

const HOST_BUILTINS_TESTS = {["c/tests/host_builtins/test_host_run.c"] = 14, ["c/tests/host_builtins/test_run_guards.c"] = 14}
const HOST_BUILTINS_PLANTS = {
  {name = "a program runs unconfined", file = "spawn_child.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_program_writes_and_reads_only_where_the_mounts_allow",
   old = "    if (c->confine_fd >= 0) {\n        if (prctl(", new = "    if (0) {\n        if (prctl("},
  {name = "a read-only mount is a program's to write", file = "host_confine.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_program_writes_and_reads_only_where_the_mounts_allow",
   old = "m->access == MOUNT_READ_ONLY ? LANDLOCK_READ_RIGHTS : handled;", new = "handled;"},
  {name = "a truncate is outside the ruleset", file = "landlock.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_program_writes_and_reads_only_where_the_mounts_allow",
   old = "    if (abi >= 3) all |= LANDLOCK_TRUNCATE;\n", new = ""},
  {name = "a secrets folder inside the root is a program's to read", file = "host_confine.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_program_by_a_secret_s_path_is_the_secrets_guard_s_before_git_is_asked",
   old = "    if (leaks) {\n", new = "    if (0) {\n"},
  {name = "a confined program cannot move a file between folders", file = "landlock.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "git_commits_in_a_mount_and_a_build_writes_its_out_folder_confined",
   old = "    if (abi >= 2) all |= LANDLOCK_REFER;\n", new = ""},
  {name = "a script's NUL is made an OS string", file = "host.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_nul_in_an_argument_an_env_a_secrets_name_or_a_secret_is_refused_before_any_guard",
   old = "    if (os_str_of(s, out)) return OK;\n", new = "    out->s = s;\n    return OK;\n"},
  {name = "a git that cannot start is a program it does not track", file = "host_refusals.c", dir = "host", caught_by = "host_builtins/test_run_guards",
   aim = "a_git_that_cannot_start_is_said_not_taken_for_a_program_it_does_not_track",
   old = "    if (got != SPAWN_OK) {\n        Str why", new = "    if (0) {\n        Str why"},
  {name = "a secret's start at a read's end is passed on raw", file = "host_run_secrets.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "the_scrubber_holds_back_a_secret_split_across_reads_and_widens_an_overlap",
   old = "if (host_is_proper_prefix(rest, at(s->secrets, k).value)) return true;", new = "if (0 && host_is_proper_prefix(rest, at(s->secrets, k).value)) return true;"},
  {name = "a secret inside another is not widened over", file = "host_run_secrets.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "the_scrubber_holds_back_a_secret_split_across_reads_and_widens_an_overlap",
   old = "if (j + o.len > *end) *end = j + o.len;", new = "(void)end;"},
  {name = "a want lets `grep` run", file = "host_refusals.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "run_refuses_each_bad_call_with_its_message",
   old = "    HostRefusedGroups refused = {HOST_REFUSED, sizeof HOST_REFUSED / sizeof *HOST_REFUSED};\n    for (int pass", new = "    HostRefusedGroups refused = {HOST_REFUSED, sizeof HOST_REFUSED / sizeof *HOST_REFUSED};\n    if (has_want) return OK;\n    for (int pass"},
  {name = "a version suffix is kept on argv[0]", file = "host_refusals.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "run_refuses_each_bad_call_with_its_message",
   old = "        b = str_sub(b, 0, dot - 1);", new = "        break;"},
  {name = "the output is charged a step a byte", file = "host_run.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "run_charges_its_output_a_step_per_16_bytes",
   old = "    TRY(builtin_charge_bytes(r, pos, sinks.out.bytes));", new = "    TRY(run_charge(r, pos, sinks.out.bytes));"},
  {name = "a stream past the cap is taken for the values' arena", file = "host_run.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "a_stream_past_the_arena_budget_stops_on_it_and_the_program_is_ended",
   old = "    case SPAWN_SINK_STOPPED: return host_stream_refused(r, pos, sa, most);", new = "    case SPAWN_SINK_STOPPED: return run_values_oom(r, pos);"},
  {name = "a cpu budget's stop leaves out how the program ended", file = "host_run.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "a_cpu_budget_stops_naming_the_stage_and_how_the_program_ended",
   old = "    bool failed = o->ended != SPAWN_EXIT || o->code != 0;", new = "    bool failed = false;"},
  {name = "the time line's share is of the programs alone", file = "host.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "the_time_line_keeps_the_slowest_three_and_both_ends_of_a_long_argv",
   old = "    uint64_t whole = t->run_ms + t->wait_ms + t->sleep_ms;", new = "    uint64_t whole = t->run_ms;"},
  {name = "a stopped run passes by the jobs it started", file = "host_jobs.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "a_job_runs_past_its_start_is_waited_for_and_a_stopped_run_ends_the_rest",
   old = "        if (!host_started_running(a, j)) continue;", new = "        if (1 || !host_started_running(a, j)) continue;"},
  {name = "a job's exit code is not read from its record", file = "host_jobs.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "a_job_runs_past_its_start_is_waited_for_and_a_stopped_run_ends_the_rest",
   old = "    return host_jobs_result(r, pos, S(\"exited\"), rec->has_exit, rec->exit, rec->has_signal, rec->signal, out);", new = "    return host_jobs_result(r, pos, S(\"exited\"), false, 0, rec->has_signal, rec->signal, out);"},
  {name = "a job's record is read into a buffer the arena keeps", file = "jobs.c", dir = "host", caught_by = "host_builtins/test_host_run",
   aim = "a_poll_of_job_alive_holds_the_arena_flat",
   old = "    arena_free(a, buf, room.len);", new = "    (void)room;"},
}

function host_builtins_block(t)
  local tests = {}
  for src in keys(HOST_BUILTINS_TESTS) do push(tests, src) end
  sort(tests)
  for src in tests do
    if test_count(src) ~= HOST_BUILTINS_TESTS[src] then fail(src .. " has " .. test_count(src) .. " TEST(s), and HOST_BUILTINS_TESTS says " .. HOST_BUILTINS_TESTS[src]) end
  end
  print("host builtins: " .. #tests .. " file(s) of C tests, run in c/tests/ran_tests.c")
  if not t.full then return nil end
  run_plants(t, "host builtins plants", HOST_BUILTINS_PLANTS)
  return nil
end
-- ── end of the host builtins' block ─────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"), arg("stage", "all"))
host_builtins_block(t)
block_end(t, "host_builtins")
