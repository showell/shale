-- c/build/host.shale: the host's block, c/host's process plumbing.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The host's process plumbing, c/host ─────────────────────────────────
-- keep.c, job_record.c, spawn.c and jobs.c, apart from the foundation and the
-- script. In both tiers: each c/tests/host/test_*.c under each of
-- `t.builds`, held to its `TEST(` count, the spawn fixture built for each
-- first (with GCC's release flags: it is a program the tests run, not a
-- test). In the full tier: each fault in HOST_PLANTS caught by the test file
-- it names, then spawn and the keep against this script's own `run`, Zig's,
-- on the same programs (`HOST_VS_ZIG`): every field the same, `cpu_ms`
-- within HOST_MS_SLACK, and `ms` within it too, but for a program that
-- burns CPU (HOST_VS_ZIG_CPU), whose `ms` is no less than its `cpu_ms`.

const HOST_OUT = "c/out/host"
const HOST_FIXTURE = "c/tests/host/fixtures/spawn_fixture.c"
const HOST_PROBE = "c/tests/host/fixtures/spawn_probe.c"
const HOST_WANT = "c-tests: the host's own test fixture and probe, built under c/out/host"

-- Each fault planted in a copy of c/host, as PLANTS are in the foundation.
const HOST_PLANTS = {
