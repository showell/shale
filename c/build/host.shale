-- c/build/host.shale: the host's block, c/host's process plumbing.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The host's process plumbing, c/host ─────────────────────────────────
-- keep.c, job_record.c, spawn.c and jobs.c, apart from the foundation and the
-- script. In both tiers: each c/tests/host/test_*.c under each of
-- `t.builds`, held to its `TEST(` count, the spawn fixture built for each
-- first (with GCC's release flags: it is a program the tests run, not a
-- test). In the full tier: each fault in HOST_PLANTS caught by the test file
-- it names.

const HOST_OUT = "c/out/host"
const HOST_FIXTURE = "c/tests/host/fixtures/spawn_fixture.c"

-- Each fault planted in a copy of c/host, as PLANTS are in the foundation.
const HOST_PLANTS = {
  {name = "a line exactly `width` long is cut",
   aim = "head_and_tail_and_the_filter_against_the_oracle_on_3000_random_outputs,a_long_line_keeps_both_ends_and_says_how_much_is_left_out", dir = "host", file = "keep.c", caught_by = "host/test_keep",
   old = "if (l.len <= width && !over) {", new = "if (l.len < width && !over) {"},

  {name = "a line past KEEP_LINE_MAX is kept whole",
   aim = "the_edges", dir = "host", file = "keep.c", caught_by = "host/test_keep",
   old = "if (piece_len > room) k->line_over = true;", new = "if (0 && piece_len > room) k->line_over = true;"},
  {name = "the context before a match is passed newest first",
   aim = "head_and_tail_and_the_filter_against_the_oracle_on_3000_random_outputs,an_arena_refused_anywhere_stops_and_never_answers_wrong", dir = "host", file = "keep.c", caught_by = "host/test_keep",
   old = "            KeepSlot *s = &at(k->back, k->back_at);\n            k->back_at = (k->back_at + 1) % k->back.len;", new = "            KeepSlot *s = &at(k->back, (k->back_at + k->back_len - 1) % k->back.len);"},
  {name = "a record's key given twice is read",
   aim = "an_argv_with_a_newline_or_a_backslash_reads_back_and_none_overrides_a_key", dir = "host", file = "job_record.c", caught_by = "host/test_job_record",
   old = "if (at(seen, i)) return false;", new = "if (0 && at(seen, i)) return false;"},
  {name = "a number may start with `_`",
   aim = "a_number_takes_a_sign_and_inner_underscores_and_nothing_else", dir = "host", file = "job_record.c", caught_by = "host/test_job_record",
   old = "if (at(digits, 0) == '_' || at(digits, digits.len - 1) == '_') return false;", new = "if (at(digits, digits.len - 1) == '_') return false;"},
  {name = "a record whose pgid is not its pid is read",
   aim = "a_record_whose_pgid_is_not_its_pid_is_none_so_no_other_group_is_signalled", dir = "host", file = "job_record.c", caught_by = "host/test_job_record",
   old = "return r->pid > 0 && r->pgid == r->pid;", new = "return r->pid > 0 && r->pgid > 0;"},
  -- Aimed at a test that sends signal 0 alone, so the plant signals nobody.
  {name = "a pgid below 2 is signalled",
   aim = "a_pgid_below_2_is_refused_before_any_kill_and_a_real_group_is_signalled", dir = "host", file = "pgroup.c", caught_by = "host/test_jobs",
   old = "    if (pgid < 2) return false;\n    return kill(-pgid, sig) == 0;", new = "    return kill(-pgid, sig) == 0;"},
  {name = "the record's temp file follows a link planted there",
   aim = "a_link_planted_at_the_records_temp_file_is_replaced_never_followed", dir = "host", file = "jobs.c", caught_by = "host/test_jobs",
   old = "    unlink(tmp);\n    int fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644);", new = "    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);"},
  {name = "a child's /dev/null reaches its program",
   aim = "the_reaper_holds_0_1_2_and_its_started_pipe_alone,the_job_holds_0_1_and_2_alone_no_dev_null_or_log_fd_leaks_into_it", dir = "host", file = "spawn_child.c", caught_by = "host/test_jobs",
   old = "null_fd = open(\"/dev/null\", O_RDWR | O_CLOEXEC);", new = "null_fd = open(\"/dev/null\", O_RDWR);"},
  {name = "the log's fd reaches the job",
   aim = "the_job_holds_0_1_and_2_alone_no_dev_null_or_log_fd_leaks_into_it", dir = "host", file = "jobs.c", caught_by = "host/test_jobs",
   old = "int log_fd = open(log, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);", new = "int log_fd = open(log, O_WRONLY | O_CREAT | O_TRUNC, 0644);"},
  {name = "the job's leader exits and its group gets no TERM",
   aim = "attack_what_a_jobs_leader_leaves_in_its_group_is_gone_once_its_end_is_written_by_term_or_by_kill_at_the_grace", dir = "host", file = "jobs.c", caught_by = "host/test_jobs",
   old = "    }\n    pgroup_signal(r.pgid, SIGTERM);\n    int raw = 0;", new = "    }\n    int raw = 0;"},
  {name = "the job's group gets no KILL at the grace",
   aim = "attack_what_a_jobs_leader_leaves_in_its_group_is_gone_once_its_end_is_written_by_term_or_by_kill_at_the_grace", dir = "host", file = "jobs.c", caught_by = "host/test_jobs",
   old = "            pgroup_kill_left(pgid);\n            killed = true;", new = "            killed = true;"},
  {name = "the job's end is written before its group is empty",
   aim = "attack_what_a_jobs_leader_leaves_in_its_group_is_gone_once_its_end_is_written_by_term_or_by_kill_at_the_grace", dir = "host", file = "jobs.c", caught_by = "host/test_jobs",
   old = "    jobs_end_group(r.pgid, JOBS_GROUP_GRACE_MS);\n", new = ""},
  {name = "the deadline passes a millisecond late",
   aim = "attack_the_deadline_and_the_grace_to_the_millisecond", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (!exited && !has_termed && now >= deadline) {", new = "if (!exited && !has_termed && now > deadline) {"},
  {name = "the KILL reaches the leader alone, not its group",
   aim = "attack_a_grandchild_that_ignores_term_ends_with_the_group_at_the_deadline", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "    if (step.kill) {\n        pgroup_kill_left(l->pid);", new = "    if (step.kill) {\n        kill(l->pid, SIGKILL);"},
  {name = "the drain waits for the pipe to close",
   aim = "attack_a_process_that_left_the_group_holding_the_pipe_never_holds_run", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (l.exited && (l.out_r < 0 || now >= l.drain_until)) break;", new = "(void)now; if (l.exited && l.out_r < 0) break;"},
  {name = "a sink's stop leaves the program running",
   aim = "a_sink_that_stops_ends_the_programs_group_and_reaps_it_before_the_stop_is_said", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "            if (!l.exited) {\n                pgroup_signal(pid, SIGKILL);\n                spawn_reap(pid, &l.raw, NULL);\n            }", new = "            (void)0;"},
  {name = "a TERM to shale is taken for a timeout",
   aim = "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back,attack_a_term_or_hup_the_program_sends_its_parent_mid_run_ends_its_group", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "        l->why = SPAWN_INTERRUPTED;", new = "        l->why = SPAWN_TIMEOUT;"},
  {name = "the leader's exit leaves what it started in its group running",
   aim = "attack_a_grandchild_holding_the_pipe_after_its_leader_exits_is_ended_before_run_returns", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "        if (!l->has_termed) {\n            pgroup_signal(l->pid, SIGTERM);", new = "        if (0) {\n            pgroup_signal(l->pid, SIGTERM);"},
  {name = "a TERM read after the leader exits is dropped",
   aim = "attack_a_term_to_shale_after_its_program_exits_while_the_output_drains_still_stops_the_run", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "    if (!l->has_why) {\n        l->has_why = true;", new = "    if (!l->exited && !l->has_why) {\n        l->has_why = true;"},
  {name = "the wait falls to 0 once the drain is over, the group still there",
   aim = "attack_the_deadline_and_the_grace_to_the_millisecond", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (exited && now < drain_until && drain_until - now < w) w = drain_until - now;", new = "if (exited && spawn_sat_sub(drain_until, now) < w) w = spawn_sat_sub(drain_until, now);"},
  {name = "shale's mask is not put back",
   aim = "a_term_to_shale_while_a_program_runs_ends_its_group_and_says_so_and_the_mask_is_put_back,a_sink_that_stops_ends_the_programs_group_and_reaps_it_before_the_stop_is_said,attack_a_term_or_hup_the_program_sends_its_parent_mid_run_ends_its_group", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "if (f->masked) sigprocmask(SIG_SETMASK, &f->old_mask, NULL);", new = "(void)f->old_mask;"},
  {name = "SIGPIPE keeps its default, and a stdin no one reads kills shale",
   aim = "attack_a_program_that_never_reads_its_stdin_leaves_shale_standing", dir = "host", file = "spawn.c", caught_by = "host/test_spawn",
   old = "sigaction(SIGPIPE, &act, NULL);", new = "(void)act;"},
}

-- The `-D` that tells spawn's tests where `build`'s fixture is. A program
-- includes the c/host files it needs by their relative paths (one
-- translation unit), so a plant's copy is found beside its test's copy.
function host_define(build)
  return "-DSPAWN_FIXTURE=\"" .. HOST_OUT .. "/" .. build .. "/spawn_fixture\""
end

-- A fixture or probe of c/tests/host compiled with GCC's release flags to
-- `bin`, as the job `name` (`compile_jobs`, so in the full tier the pool
-- builds it).
function host_compile(t, phase, name, src, bin)
  mkdir(dirname(bin))
  local argv = gcc_flags("release", FOUNDATION)
  for a in {host_define("release"), src, "-o", bin} do push(argv, a) end
  local answers = compile_jobs(t, phase, {{name = name, argv = argv, opts = {timeout_ms = COMPILE_TIMEOUT_MS}}})
  if answers == nil then return nil end
  compile_held("release", src, answers[1])
  return nil
end

function host_block(t)
  local tests = {}
  for p in glob("c/tests/host/test_*.c") do push(tests, p) end
  sort(tests)
  for b in t.builds do
    local phase = "host " .. b
    host_compile(t, phase, "host-fixture-" .. b, HOST_FIXTURE, HOST_OUT .. "/" .. b .. "/spawn_fixture")
    print("host " .. said_of_build(b, #tests, test_files(t, phase, b, tests, {host_define(b)})))
  end
  if not t.full then return nil end
  run_plants(t, "host plants", HOST_PLANTS, {host_define("asan")})
  return nil
end
-- ── end of the host's block ─────────────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"), arg("stage", "all"))
host_block(t)
block_end(t, "host")
