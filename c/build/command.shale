-- c/build/command.shale: the command's block, c/shale.c and c/script's parser.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The command: c/shale.c and c/script's parser ───────────────────────
-- test_lex.c and test_parse.c run in the foundation's block with every test
-- file. Here: c/gen_preludes.shale writes the preludes the C `shale`
-- embeds, then c/shale.c is built under each of `t.builds` (tcc in the fast
-- tier, release and asan added in the full), and each binary's `--check` is
-- held to a script that parses and one that stops, its `--help` and `-h` to
-- the installed Zig `shale`'s, and its `--version` to its build's mode. In
-- the full tier: the faults below planted in a copy of c/script, each caught
-- by its test file.

const PARSE_PLANTS = {
  {name = "a `break` outside a loop words its stop its own way",
   aim = "statements_hold_their_own_rules", dir = "script", file = "parse_stmt.h", caught_by = "test_parse",
   old = [=[S("`break` outside a loop")]=], new = [=[S("`break` is outside a loop")]=]},
}

-- The C `shale` under each of `t.builds`, at c/out/<build>/shale (under
-- `release`, the one -O2 link, the binary the differ judges), compiled two
-- at a time (`compile_jobs`).
function build_commands(t)
  local specs = {}
  for b in t.builds do
    local argv = command_argv(b, OUT .. "/" .. b .. "/shale")
    push(specs, {name = "command-" .. b, argv = argv, opts = {timeout_ms = 120000}})
  end
  local answers = compile_jobs(t, "command builds", specs)
  if answers == nil then return nil end
  local i = 0
  for a in answers do
    i = i + 1
    if get(a, "code", -1) ~= 0 then fail("`" .. t.builds[i] .. "` could not compile c/shale.c:\n" .. a.out) end
  end
  return nil
end

-- The C `shale` under `build`: its `--check` of one script that parses and
-- one that stops, each held to Zig's exact report.
function check_command(t, build)
  local bin = OUT .. "/" .. build .. "/shale"
  local good = OUT .. "/command/good.shale"
  local bad = OUT .. "/command/bad.shale"
  if exists(OUT .. "/command") then remove_tree(OUT .. "/command") end
  mkdir(OUT .. "/command")
  create(good, "function f(x) return x end\nprint(f(trim(\" a \")))\n")
  create(bad, "print(1)\nlocal x = 1 @ 2\n")
  create(OUT .. "/command/mounts", "")
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(OUT .. "/command/mounts")}
  local g = run_in(t, "command " .. build, {bin, "--check", good}, {timeout_ms = 20000, tail = 10, env = env, want = WANT})
  if g.code ~= 0 or trim(g.out) ~= "── checked: it parses and compiles; nothing ran" then fail("`" .. build .. "`'s shale --check of a script that parses said:\n" .. g.out) end
  local b = run_in(t, "command " .. build, {bin, "--check", bad}, {timeout_ms = 20000, tail = 10, env = env, want = WANT})
  local said = "── stopped at " .. bad .. ":2:13: syntax: a character no token starts with, `@` (0 steps)\n── used: 0 of 5000000 steps, 0 of 10000 reads, 0 of 67108864 read bytes, 0 of 65536 output bytes"
  if b.code ~= 1 or trim(b.out) ~= said then fail("`" .. build .. "`'s shale --check of a script that stops said:\n" .. b.out) end
  return nil
end

-- The C `shale` under `build`, its stdout refusing every write (full, a
-- broken pipe, closed: c/tests/fixtures/stdout_to.c): it says `shale:
-- stdout: <error>` last and exits 1, and a run that stops still says its
-- report and puts back what it changed first. Gives how many runs.
function check_stdout_failed(t, build)
  local dir = OUT .. "/command/stdout"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir .. "/root")
  local fx = dir .. "/stdout_to"
  must(run_in(t, "command " .. build, {"tcc", "-std=c11", "-Wall", "-Werror", "-I" .. FOUNDATION, "-o", fx, "c/tests/fixtures/stdout_to.c"}, {timeout_ms = 30000, tail = 10}))
  local bin = real(OUT .. "/" .. build .. "/shale")
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(OUT .. "/command/mounts")}
  local cases = {
    {how = "full", argv = {"-e", "print(1)"}, said = "shale: stdout: NoSpaceLeft"},
    {how = "broken", argv = {"-e", "print(1)"}, said = "shale: stdout: BrokenPipe"},
    {how = "closed", argv = {"-e", "print(1)"}, said = "shale: stdout: NotOpenForWriting"},
    {how = "full", argv = {"--version"}, said = "shale: stdout: NoSpaceLeft"},
    {how = "full", argv = {"--undo-on-stop", "-e", "create(\"x.txt\", \"a\")\nprint(1)\nfail(\"no\")\n"},
     said = "── stopped at -e:3:1: fail: no (34 steps)\n── used: 34 of 5000000 steps, 1 of 10000 reads, 0 of 67108864 read bytes, 2 of 65536 output bytes\n── undone: 1 path(s) the run changed put back\nshale: stdout: NoSpaceLeft"},
  }
  for c in cases do
    local argv = {real(fx), c.how, bin}
    for w in c.argv do push(argv, w) end
    local r = run_in(t, "command " .. build, argv, {timeout_ms = 20000, whole = 10000, cwd = dir .. "/root", env = env, want = WANT})
    if get(r, "code", -1) ~= 1 or trim(r.out) ~= c.said then
      fail("`" .. build .. "`'s shale " .. join(c.argv, " ") .. " with its stdout " .. c.how .. " exited " .. get(r, "code", -1) .. " and said:\n" .. r.out .. "\nnot exit 1 and:\n" .. c.said)
    end
  end
  if exists(dir .. "/root/x.txt") then fail("`" .. build .. "`'s shale --undo-on-stop with its stdout full left x.txt: the undo did not run") end
  remove_tree(dir)
  return #cases
end

-- The OS path of the `shale` the help is held to, its links resolved:
-- `--help` names the checkout its binary runs from. It is this checkout's
-- Zig build, `zig-out/bin/shale`, when there is one: built from this tree's
-- src/, so a change to the usage text in both is held here before either is
-- installed. A checkout with no Zig build (a fresh lane's fast tier) holds
-- it to the installed `shale`, the last build installed, and says so.
function zig_shale_path(t)
  if exists("zig-out/bin/shale") then return {path = real("zig-out/bin/shale"), what = "this checkout's Zig"} end
  local which = must(run_in(t, "command help", {"which", "shale"}, {timeout_ms = 5000, tail = 1}))
  return {path = trim(must(run_in(t, "command help", {"readlink", "-f", trim(which.out)}, {timeout_ms = 5000, tail = 1})).out), what = "the installed shale"}
end

-- `argv` run by the binary at OS path `bin`, copied first to `place`
-- (`<checkout>/zig-out/bin/shale`), the place `--help` measures from.
function help_run(t, bin, place, argv, env)
  if exists(place) then remove(place) end
  must(run_in(t, "command help", {"cp", bin, real(dirname(place)) .. "/shale"}, {timeout_ms = 10000, tail = 5}))
  local full = {real(place)}
  for w in argv do push(full, w) end
  return run_in(t, "command help", full, {timeout_ms = 20000, whole = 100000, env = env, want = WANT})
end

-- The C `shale` under `build`: its `--help` and `-h` held to Zig's, byte for
-- byte, from a checkout that holds the docs and from a folder that does not,
-- over mounts of every kind (a secrets mount's folder never shown) and over a
-- mounts file that is missing (a parse error's words are mounts.c's tests'
-- to hold); and its `--version` to its build's mode.
function check_help(t, build, zig)
  local dir = OUT .. "/command/help"
  if exists(dir) then remove_tree(dir) end
  for d in {"/in/zig-out/bin", "/in/docs", "/out/zig-out/bin", "/plain", "/lib", "/tc", "/fake-keys-7q2x"} do mkdir(dir .. d) end
  create(dir .. "/in/docs/SHALE-AGENTS.md", "")
  local d = real(dir)
  create(dir .. "/all.mounts", "plain = " .. d .. "/plain\nlib = " .. d .. "/lib/ ro\ntc = " .. d .. "/tc ro tools\nkeys = " .. d .. "/fake-keys-7q2x secrets\n")
  create(dir .. "/none.mounts", "")
  local c_bin = real(OUT .. "/" .. build .. "/shale")
  local cases = {
    {place = "/in", mounts = "all", argv = {"--help"}},
    {place = "/in", mounts = "none", argv = {"-h"}},
    {place = "/out", mounts = "all", argv = {"--help"}},
    {place = "/out", mounts = "bad", argv = {"--help"}},
  }
  for c in cases do
    local env = {SHALE_MOUNTS = d .. "/" .. c.mounts .. ".mounts", HOME = d}
    local place = dir .. c.place .. "/zig-out/bin/shale"
    local z = help_run(t, zig, place, c.argv, env)
    local got = help_run(t, c_bin, place, c.argv, env)
    local said = c.place .. " " .. c.mounts .. " " .. join(c.argv, " ")
    if get(got, "code", -1) ~= z.code or got.out ~= z.out then
      fail("`" .. build .. "`'s shale " .. said .. " said unlike Zig's:\n--- zig (" .. z.code .. ")\n" .. z.out .. "\n--- c (" .. get(got, "code", -1) .. ")\n" .. got.out)
    end
    if find(z.out, "fake-keys-7q2x") ~= nil then fail("Zig's shale " .. said .. " named the secrets mount's folder") end
  end
  local v = run_in(t, "command help", {c_bin, "--version"}, {timeout_ms = 10000, whole = 1000, want = WANT})
  local mode = "Debug"
  if build == "release" then
    mode = "ReleaseSafe"
    local zv = run_in(t, "command help", {"shale", "--version"}, {timeout_ms = 10000, whole = 1000})
    if zv.out ~= v.out then fail("`release`'s shale --version said " .. v.out .. ", and Zig's " .. zv.out) end
  end
  if v.code ~= 0 or v.out ~= "shale " .. mode .. "\n" then fail("`" .. build .. "`'s shale --version said " .. v.out .. ", not shale " .. mode) end
  return #cases
end

function command_block(t)
  print(trim(must(run_in(t, "command preludes", {"shale", "c/gen_preludes.shale"}, {timeout_ms = 60000, tail = 5})).out))
  build_commands(t)
  if t.stage == "plan" then return nil end
  local zig = zig_shale_path(t)
  for b in t.builds do
    check_command(t, b)
    local helps = check_help(t, b, zig.path)
    local failed = check_stdout_failed(t, b)
    print("command " .. b .. ": c/out/" .. b .. "/shale built; its --check holds a script that parses and one that stops; " .. helps .. " --help runs and --version as " .. zig.what .. "'s; " .. failed .. " runs whose stdout refuses its writes exit 1 and say so")
  end
  if not t.full then return nil end
  run_plants(t, "parse plants", PARSE_PLANTS)
  return nil
end
-- ── end of the command's block ─────────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"), arg("stage", "all"))
command_block(t)
block_end(t, "command")
