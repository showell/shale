   old = "    if (hook == NULL) c_bug(\"path_run: a PathRun", new = "    if (0) c_bug(\"path_run: a PathRun"},
  {name = "a root path's links are walked before its names are checked", file = "path_run.c", dir = "host", caught_by = "file_system/test_paths",
   aim = "a_root_path_s_names_are_the_core_s_to_check_before_the_hook_walks_its_links",
