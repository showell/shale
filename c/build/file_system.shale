   old = "        if (str_eq(part, S(\"..\"))) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"`{s}`: ", new = "        if (0) {\n            return path_fail(r, pos, CLASS_ARGUMENT, S(\"`{s}`: "},
