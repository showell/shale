-- c/build/file_system.shale: the file system's block, c/foundation's
-- path.h, c/host's file_system.c, paths and undo journal.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=100000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── c/host's file system, paths and undo journal: their own block ────────
-- c/tests/file_system/test_file_system.c (path.h and file_system.c) and
-- test_paths.c (the mounts, the path hook, the secrets rule, the journal),
-- each under every build of `t.builds`, held to its `TEST(` count and to
-- FILE_SYSTEM_TESTS. In the full tier: the faults below planted in a copy of c/,
-- c/tests/file_system copied whole beside it (its fixture.c reaches the
-- copy's c/host), each caught by its `aim` tests (`run_plants`).

const FILE_SYSTEM_TESTS = {["c/tests/file_system/test_file_system.c"] = 14, ["c/tests/file_system/test_paths.c"] = 31}
const FILE_SYSTEM_PLANTS = {
  {name = "a folder that begins with a mount's name is in it", file = "mounts.c", dir = "host", caught_by = "file_system/test_paths",
