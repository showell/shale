   old = "        if (mounts_in_folder(abs, at(sd, k).run_dir)) {\n            return path_fail(r, pos, CLASS_REFUSED, S(\"\\\"{s}\\\" is in the mount", new = "        if (0 && mounts_in_folder(abs, at(sd, k).run_dir)) {\n            return path_fail(r, pos, CLASS_REFUSED, S(\"\\\"{s}\\\" is in the mount"},
  {name = "a `..` in a root path is let through to the name check", file = "path_run.c", dir = "host", caught_by = "file_system/test_paths",
