   old = "        Str dir = paths_run_dir_of(h, r, m);\n        bool under", new = "        Str dir = S(\"\");\n        TRY(paths_cat(r, pos, paths_run_dir_of(h, r, m), S(\"\"), S(\"\"), &dir));\n        bool under"},
  {name = "the mounts file's line without `=` is quoted", file = "mounts.c", dir = "host", caught_by = "file_system/test_paths",
   aim = "secrets_mounts_the_mounts_file_s_mistakes_name_the_line_and_the_mount_never_the_line_s_text_a_path_or_a_word_after_one",
   old = "S(\"the line is not `name = value`\"), none);", new = "S(\"`{s}` is not `name = value`\"), MSG_ARGS(MSG_FROM_HOST(line)));"},
  {name = "the mounts file's name that is not one is quoted", file = "mounts.c", dir = "host", caught_by = "file_system/test_paths",
   aim = "secrets_mounts_the_mounts_file_s_mistakes_name_the_line_and_the_mount_never_the_line_s_text_a_path_or_a_word_after_one",
   old = "S(\"the name before `=` is not a mount's name: letters, digits, `_` and `-`\"), none);", new = "S(\"`{s}` is not a mount's name: letters, digits, `_` and `-`\"), MSG_ARGS(MSG_FROM_HOST(name)));"},
  {name = "the mounts file's word after a path is quoted", file = "mounts.c", dir = "host", caught_by = "file_system/test_paths",
   aim = "secrets_mounts_the_mounts_file_s_mistakes_name_the_line_and_the_mount_never_the_line_s_text_a_path_or_a_word_after_one",
   old = "S(\"only `ro`, `tools` and `secrets` may follow `{s}`'s path (and a path has no space)\"), MSG_ARGS(MSG_FROM_HOST(name)));", new = "S(\"`{s}` after `{s}`'s path: only `ro`, `tools` and `secrets` may follow it (and a path has no space)\"), MSG_ARGS(MSG_FROM_HOST(w), MSG_FROM_HOST(name)));"},
  {name = "the mounts file's relative value is quoted", file = "mounts.c", dir = "host", caught_by = "file_system/test_paths",
   aim = "secrets_mounts_the_mounts_file_s_mistakes_name_the_line_and_the_mount_never_the_line_s_text_a_path_or_a_word_after_one",
   old = "S(\"`{s}`'s value is relative: an absolute path, or one from `~/`\"), MSG_ARGS(MSG_FROM_HOST(name)));", new = "S(\"`{s}`'s value `{s}` is relative: an absolute path, or one from `~/`\"), MSG_ARGS(MSG_FROM_HOST(name), MSG_FROM_HOST(value)));"},
  {name = "Wyhash's first secret is off by one", file = "wyhash.h", caught_by = "file_system/test_file_system",
   aim = "wyhash_its_test_vectors",
   old = "0xa0761d6478bd642full", new = "0xa0761d6478bd642eull"},
  {name = "an OS string is made of a string with a NUL", file = "slice.h", caught_by = "file_system/test_file_system",
   aim = "an_os_string_holds_no_nul_and_its_c_string_refuses_only_a_path_past_path_max",
   old = "if (str_find_byte(s, 0) != NULL) return false; // nul: the maker's search", new = "(void)0;"},
  {name = "the metal host's depth is one deeper", file = "file_system.c", dir = "host", caught_by = "file_system/test_file_system",
   aim = "a_path_the_bare_metal_host_could_not_hold_is_refused_measured_as_it_would_spell_it",
   old = "if (depth > FILE_SYSTEM_DEPTH_MAX) return FILE_SYSTEM_PATH_TOO_DEEP;", new = "if (depth > FILE_SYSTEM_DEPTH_MAX + 1) return FILE_SYSTEM_PATH_TOO_DEEP;"},
  {name = "a refused rename leaves its sibling", file = "file_system.c", dir = "host", caught_by = "file_system/test_file_system",
   aim = "a_replace_onto_a_folder_fails_and_leaves_no_temporary_file_beside_it",
   old = "if (e != FILE_SYSTEM_OK && from != NULL) (void)unlink(from); // ignored: the rename's error is the answer", new = "(void)from;"},}

function file_system_block(t)
  local tests = {}
  for src in keys(FILE_SYSTEM_TESTS) do push(tests, src) end
  sort(tests)
  for src in tests do
    if test_count(src) ~= FILE_SYSTEM_TESTS[src] then fail(src .. " has " .. test_count(src) .. " TEST(s), and FILE_SYSTEM_TESTS says " .. FILE_SYSTEM_TESTS[src]) end
  end
  for b in t.builds do
    print("file_system " .. said_of_build(b, #tests, test_files(t, "file_system " .. b, b, tests)))
  end
  if not t.full then return nil end
  run_plants(t, "file_system plants", FILE_SYSTEM_PLANTS)
  return nil
end
-- ── end of the file system's block ───────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"), arg("stage", "all"))
file_system_block(t)
block_end(t, "file_system")
