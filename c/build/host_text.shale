-- c/build/host_text.shale: the block of the host's text calls,
-- c/host/host_json.c, c/host/host_text.c and c/host/flat_tree.c.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The host's text calls: json, re_lines, shale_tokens, roc_tree, go_tree ─
-- In both tiers: c/tests/text/test_host_text.c held to HOST_TEXT_TESTS (a
-- part of c/tests/ran_tests.c, which the ran block runs under each of
-- `t.builds` and holds to its `TEST(` count), then each command binary the
-- command's block built runs HOST_TEXT_SCRIPTS and HOST_TEXT_TREE_SCRIPTS
-- through the Linux prelude (the tree scripts with the real roc-ast and
-- go-ast under the `tools` mount), its output, report and exit held to its
-- frozen output (c/tests/frozen/host_text, lib.shale's "Frozen outputs").
-- A script marked `finishes` must end without a stop. In the full tier: the faults below
-- planted in a copy of c/, with c/tests/ran.c and c/tests/text beside it,
-- each caught by its `aim` tests.

const HOST_TEXT_TEST = "c/tests/text/test_host_text.c"
const HOST_TEXT_TESTS = 16

-- Each script's every stop is frozen, so a message, a charge or an order
-- the tests do not pin is judged here.
const HOST_TEXT_SCRIPTS = {
  {name = "json", source = [==[
local v = json_read("{\"a\": [1, -2, 3.5e2, true, \"x\\u00e9\\ud83d\\ude00\"], \"b\": null, \"c\": {}}")
print(json_write(v), json_write(json_read("[1,null]", {null = 0})), json_write({k = "q\"\\\t\r\x01"}))
for s in {"", "[1,", "{\"a\":1,}", "tru", "01", "1e", "\"\\x\"", "\"\\u12\"", "\"\\ud800\"", "\"\\udc00\"", "9223372036854775808", "[null]", "{\"a\":1,\"a\":2}", "1 2", "\"\x01\"", "\"\xff\"", "\"\\u+0e9\"", "\"\\u-001\""} do
  local r = attempt(json_read, s)
  print(r.ok, get(r, "error", ""))
end
for o in {{depth = 0}, {size = 3}, {depth = "x"}, {zz = 1}} do print(attempt(json_read, "[1,2]", o).error) end
print(attempt(json_read, 5).error, attempt(json_write, "\xff").error)
]==]},
  {name = "re_lines", source = [==[
local s = "alpha\nbeta\n\ngamma beta\nlast"
for m in re_lines(s, "beta") do print(m.line, m.text) end
for m in re_lines(s, "^$", {invert = true, nocase = true}) do print(m.line, m.text) end
print(#re_lines("", "x"), attempt(re_lines, s, "(").error, attempt(re_lines, s, "a", {foo = 1}).error)
print(attempt(re_lines, s, "a", {nocase = 1}).error, attempt(re_lines, s, "a", {1}).error, attempt(re_lines, 1, "a").error)
]==]},
  {name = "shale_tokens", source = [==[
create("t.shale", "local x = 1 -- one\nprint(\"hi\\n\", [=[raw]=])\n")
create("bad.shale", "local y = 3.5\n")
for t in shale_tokens("t.shale") do print(t.tag, t.text, t.line, t.start, t.stop) end
print(#shale_tokens("t.shale", {tag = "comment"}), attempt(shale_tokens, "t.shale", {tag = "eof"}).error)
print(attempt(shale_tokens, "t.shale", {tag = "zz"}).error, attempt(shale_tokens, "t.shale", {}).error)
print(attempt(shale_tokens, "bad.shale").error, attempt(shale_tokens, "nope.shale").error)
]==]},
}

const HOST_TEXT_PLANTS = {
  {name = "a newline counts as a column", file = "host_json.c", dir = "host", caught_by = "text/test_host_text",
   aim = "json_read_refuses_a_malformed_text_naming_its_byte_line_and_column",
   old = "        if (at(jr->s, k) == '\\n') {", new = "        if (0) {"},
  {name = "an array's null is refused with a value to stand in", file = "host_json.c", dir = "host", caught_by = "text/test_host_text",
   aim = "json_read_stands_a_value_in_for_null_and_stops_past_its_depth",
   old = "if (!jr->has_null) return json_fail_lit(", new = "if (1) return json_fail_lit("},
  {name = "a table that holds itself is written without end", file = "host_json.c", dir = "host", caught_by = "text/test_host_text",
   aim = "json_write_refuses_a_table_that_holds_itself",
   old = "if (depth_left == 0) return run_fail(", new = "if (depth_left == 0 && 0) return run_fail("},
  {name = "a line is searched for nothing", file = "host_text.c", dir = "host", caught_by = "text/test_host_text",
   aim = "re_lines_keeps_the_matching_lines_and_charges_each_search,re_lines_stops_one_past_the_step_budget",
   old = "        n++;\n        TRY(run_charge(r, pos, 1));", new = "        n++;"},
  {name = "an unknown option is an argument's stop", file = "host_text.c", dir = "host", caught_by = "text/test_host_text",
   aim = "re_lines_refuses_an_unknown_option_before_any_other",
   old = "return run_failf(r, pos, CLASS_FAIL, \"`re_lines` takes", new = "return run_failf(r, pos, CLASS_ARGUMENT, \"`re_lines` takes"},
  {name = "a token the tag leaves out is not charged", file = "host_text.c", dir = "host", caught_by = "text/test_host_text",
   aim = "shale_tokens_gives_each_token_comments_among_them_with_its_span",
   old = "        TRY(run_charge(r, pos, 1));\n        if (has_only && tok.tag != only) continue;", new = "        if (has_only && tok.tag != only) continue;\n        TRY(run_charge(r, pos, 1));"},
  {name = "the lexer's message is left out", file = "host_text.c", dir = "host", caught_by = "text/test_host_text",
   aim = "shale_tokens_stops_on_a_file_that_does_not_lex_naming_the_lexers_line",
   old = "run_unum(r, lx.err.line), S(\": \"), lx.err.message);", new = "run_unum(r, lx.err.line), S(\": \"), S(\"\"));"},
}

-- `roc_tree` and `go_tree` through the prelude: a refusal, a missing file and
-- the files after them each take its path through the host's reading. Each
-- script writes its own files, so each binary's run reads its own.
const HOST_TEXT_TREE_SCRIPTS = {
  {name = "roc_tree", finishes = true, source = [==[
create("a.roc", "module [x]\n\nx = 1 + 2\n")
create("bad.roc", "module [x]\n\nx = = 1\n")
create("empty.roc", "")
for f in roc_tree({"a.roc", "bad.roc", "gone.roc", "empty.roc", "a.roc"}) do
  print(f.path, #f.nodes, f.err)
  for n in f.nodes do print(n.kind, n.depth, n.parent, #n.kids, n.line, n.col, n.end_line, n.end_col, get(n, "raw", "")) end
end
print(#roc_tree({}))
]==]},
  {name = "go_tree", finishes = true, source = [==[
create("a.go", "package a\n\nfunc f(x int) int { return x + 1 }\n")
create("bad.go", "package a\nfunc (\n")
for f in go_tree({"a.go", "bad.go", "gone.go"}) do
  print(f.path, #f.nodes, f.err)
  for n in f.nodes do print(n.kind, n.depth, n.parent, #n.kids, n.line, n.col, get(n, "role", ""), get(n, "name", "")) end
end
]==]},
}

-- c/host/flat_tree.c's faults, planted under tcc with the block's own.
const HOST_TEXT_TREE_PLANTS = {
  {name = "a node's depth is its parent's", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "at(file->nodes, parent - 1).depth + 1;", new = "at(file->nodes, parent - 1).depth;"},
  {name = "a `-` in an attribute's name is kept", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "if (at(room, k) == '-') at(room, k) = '_';", new = "if (0) at(room, k) = '_';"},
  {name = "a number's `_` is refused", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "        if (c == '_') continue;\n", new = ""},
  {name = "a cut output refuses a line as a whole one does", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_ends_the_trees_at_a_line_that_does_not_read_in_a_cut_output",
   old = "if (ending == FLAT_WHOLE) {", new = "if (1) {"},
  {name = "the format is read as a prefix", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_reads_each_tools_header_as_its_own_and_refuses_another",
   old = "if (str_eq(first, S(FLAT_FORMAT))) {", new = "if (str_starts_with(first, S(FLAT_FORMAT))) {"},
  {name = "a file's nodes are not charged", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_stops_one_past_the_step_budget_at_a_files_nodes",
   old = "        TRY(run_charge(r, pos, f->nodes.len));\n", new = ""},
  {name = "the ending's word is checked only once the text is one", file = "flat_tree.c", dir = "host", caught_by = "text/test_host_text",
   aim = "flat_tree_refuses_its_arguments_first_to_last",
   old = [=[} else if (!str_eq(e->as.string, S("whole"))) {]=], new = [=[} else if (!str_eq(e->as.string, S("whole")) && at(args, 0).tag == VALUE_STRING) {]=]},
}

-- One script's run by `argv` in a folder of its own, `<script>-<who>`, which
-- holds a copy of the script: a script that writes files leaves each run
-- its own.
function host_text_run(t, dir, name, who, argv, env)
  local work = dir .. "/" .. name .. "-" .. who
  if exists(work) then remove_tree(work) end
  mkdir(work)
  copy(dir .. "/" .. name .. ".shale", work .. "/" .. name .. ".shale")
  return run_in(t, "host text", argv, {timeout_ms = 20000, whole = 200000, env = env, cwd = work, want = WANT})
end

-- Each script of `scripts` under each build's `shale`, over the mounts
-- `mounts` says, in a folder of its own, `dir`, held to its frozen output.
function host_text_scripts(t, dir, scripts, mounts, refreeze)
  if exists(dir) then remove_tree(dir) end
  mkdir(dir)
  create(dir .. "/mounts", mounts)
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(dir .. "/mounts"), SHALE_NOW = "1700000000"}
  for s in scripts do
    local file = s.name .. ".shale"
    create(dir .. "/" .. file, s.source)
    for b in t.builds do
      local c = host_text_run(t, dir, s.name, b, {real(OUT .. "/" .. b .. "/shale"), file}, env)
      if get(s, "finishes", false) and get(c, "code", -1) ~= 0 then fail("`" .. b .. "`'s shale ran " .. file .. " to a stop, so it judges nothing:\n" .. c.out) end
      frozen_held(t, "host_text", s.name, b, {code = get(c, "code", -1), out = c.out}, refreeze)
    end
  end
  return nil
end

-- The block's plants: the text calls' and the tree reader's.
function host_text_plants()
  local plants = {}
  for p in HOST_TEXT_PLANTS do push(plants, p) end
  for p in HOST_TEXT_TREE_PLANTS do push(plants, p) end
  return plants
end

function host_text_block(t, refreeze)
  local n = test_count(HOST_TEXT_TEST)
  if n ~= HOST_TEXT_TESTS then fail(HOST_TEXT_TEST .. " has " .. n .. " TEST(s), and HOST_TEXT_TESTS says " .. HOST_TEXT_TESTS) end
  host_text_scripts(t, OUT .. "/host_text", HOST_TEXT_SCRIPTS, "", refreeze)
  local tools = attempt(real, "tools:.")
  if not tools.ok then fail("the host text block needs the `tools` mount, where roc-ast and go-ast are installed") end
  host_text_scripts(t, OUT .. "/host_text_tree", HOST_TEXT_TREE_SCRIPTS, "tools = " .. tools.value .. " ro tools\n", refreeze)
  print("host text: " .. (#HOST_TEXT_SCRIPTS + #HOST_TEXT_TREE_SCRIPTS) .. " scripts held to their frozen output, under " .. #t.builds .. " build(s)")
  if not t.full then return nil end
  run_plants(t, "host text plants", host_text_plants())
  return nil
end
-- ── end of the host text block ──────────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"), arg("stage", "all"))
host_text_block(t, refreeze_of("host_text", arg("refreeze", "")))
block_end(t, "host_text")
