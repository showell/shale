-- c/build/gate_parity.shale: the gate's parity check, a library the gate's
-- block (c/build/gate.shale) uses: the C `shale-gate` and the Zig one
-- (tools/shale_gate.zig) run over the same hook inputs, each case's exit
-- code, what it said and the line it logged (the date aside) held equal.
--
-- The cases are every command and hook input tools/shale_gate_test.zig
-- names, read from its string literals (`passes(`, `refuses(`,
-- `gate.classify(`, `readHook(`, `wrapped(`), so a case added there is
-- judged here; then PARITY_COMMANDS and PARITY_HOOKS, what those leave open
-- (each refusal, the limits, std.json's grammar, a log line's cut), and the
-- cases made by size (the 1024-byte refusal's edge, 64 words, 4096 lines, a
-- megabyte of input). It goes when the Zig gate does.

const PARITY_WANT = "c-gate: a gate under test, the build's C or the Zig built for the parity"

-- Commands, each sent as Bash's in a hook.
const PARITY_COMMANDS = {
  "shale a'b", "shale a\"b", "shale a$b", "shale a`b", "shale a;b", "shale a|b", "shale a&b", "shale a<b",
  "shale a>b", "shale a(b", "shale a)b", "shale a*b", "shale a?b", "shale a\\b", "shale a\tb", "shale a\rb",
  "shale a.shale\r", "shale\ta", "  shale   a.shale  ", "cd x && shale", "cd x &&shale", "cd x && cd y && shale",
  "cd && shale", "/shale a", "/a/b/shale a", "/a/sh ale", "a/shale x", "/a/b$/shale", "shale --budget a=b",
  "shale --budget =", "shale --budget a=b;", "shale --budget --verbose", "shale -", "shale --", "shale -h",
  "<<'A'", "cd x && <<'A'\nA", "shale <<'A'\nA\n", "shale <<'A'\nA \n", "shale <<'A'\nA\t\n", "shale <<'A'\n A\nA",
  "shale <<'A_B'\nx\nA_B", "shale <<'A1'\nx\nA1", "shale <<''\n\n", "shale <<'A'b\nA", "shale x <<'A' y\nA",
  "shale <<'A'\n\n", "shale <<'A'\nA\nA\n", "shale <<'A'\n", "shale <<'A'\nA\n\n", "shale <<'A' \nA",
  "# want: a: b", "# want: a: b: c\nx", "# out-of-scope: a-1: t\ny", "#want: a: b", "# want:a: b",
  "# want: a:b", "# want: : b", "# out-of-scope: A: b", "## x", "# want: a: \t\r", "# want: 0-9: x\\y\tz\n\t\\",
  "shale a.shale\n\n\n", "shale a.shale\nx", "", "\n", "\nshale", " ", "shale", "shale ", "shale\n",
}

-- Hook inputs, raw.
const PARITY_HOOKS = {
  " \t\r\n{\"tool_name\":\"Read\"} \n", "", "[]", "\"x\"", "{}", "{\"tool_name\":\"Read\"} x", "{\"tool_name\":\"Read\"}{}",
  "{\"tool_name\":\"Read\",}", "{\"tool_name\":\"Read\",\"a\":[1,]}", "{\"tool_name\" \"Read\"}", "{'tool_name':\"Read\"}",
  "\xEF\xBB\xBF{\"tool_name\":\"Read\"}", "{\"tool_name\":\"Read\",\"tool_name\":\"Read\"}",
  "{\"tool_name\":\"Read\",\"x\":[{\"a\":1,\"b\":2,\"a\":3}]}", "{\"tool_name\":\"Read\",\"x\":{\"a\":1,\"\\u0061\":2}}",
  "{\"tool_name\":\"Read\",\"x\":{\"a\":1},\"y\":{\"a\":1}}",
  "{\"tool_name\":\"Read\",\"n\":[0,-0,1.5,-2e10,3E+2,4e-1,123456789012345678901234567890,1e999]}",
  "{\"tool_name\":\"Read\",\"n\":01}", "{\"tool_name\":\"Read\",\"n\":1.}", "{\"tool_name\":\"Read\",\"n\":.5}",
  "{\"tool_name\":\"Read\",\"n\":+1}", "{\"tool_name\":\"Read\",\"n\":1e}", "{\"tool_name\":\"Read\",\"n\":-}",
  "{\"tool_name\":\"Read\",\"l\":[true,false,null]}", "{\"tool_name\":\"Read\",\"l\":tru}", "{\"tool_name\":\"Read\",\"l\":True}",
  "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"\\u0041\\/\\\"\\\\\\b\\f\\n\\r\\t\\u00e9\\ud83d\\ude00\"}}",
  "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"shale a\\u0000b\"}}",
  "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"# want: n: a\\u0000b\\nx\"}}",
  "{\"tool_name\":\"Read\",\"s\":\"\\ud83d\"}", "{\"tool_name\":\"Read\",\"s\":\"\\ude00\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\\ud83d\\u0041\"}", "{\"tool_name\":\"Read\",\"s\":\"\\uD83D\\uDE00\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\\x41\"}", "{\"tool_name\":\"Read\",\"s\":\"\\u12g4\"}", "{\"tool_name\":\"Read\",\"s\":\"a\tb\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\x7F\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80\xF4\x8F\xBF\xBF\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\xC0\xAF\"}", "{\"tool_name\":\"Read\",\"s\":\"\xE0\x80\xAF\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\xED\xA0\x80\"}", "{\"tool_name\":\"Read\",\"s\":\"\xF4\x90\x80\x80\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\xF5\x80\x80\x80\"}", "{\"tool_name\":\"Read\",\"s\":\"\xC3\"}",
  "{\"tool_name\":\"Read\",\"s\":\"\x80\"}", "{\"tool_name\":\"Read\",\"s\":\"abc", "{\"tool_name\":\"Read\",\"\xFF\":1}",
  "{\"tool_name\":1}", "{\"tool_name\":\"Bash\",\"tool_input\":[]}", "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":1}}",
  "{\"tool_name\":\"Bash\",\"tool_input\":{\"x\":{\"command\":\"ls\"}}}", "{\"tool_name\":\"Bash\",\"x\":{\"tool_input\":{\"command\":\"ls\"}}}",
  "{\"tool_name\":\"Edit\",\"tool_input\":7}", "{\"tool_name\":\"bash\",\"tool_input\":{\"command\":\"ls\"}}",
  "{\"session_id\":7,\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"# want: s: t\\nx\"}}",
  "{\"session_id\":\"a\\tb\\\\c\\nd\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"# want: s: t\\nx\"}}",
  "{\"tool_input\":{\"command\":\"shale a\"},\"tool_name\":\"Monitor\"}",
  "{\"tool_name\":\"Monitor\",\"tool_input\":{\"command\":\"tail -f x\"}}",
  "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"shale a\",\"command\":\"ls\"}}",
}

-- A Zig string literal's text, its quotes off and its escapes read. An
-- escape this doesn't know stops the run, so no case is read wrong.
function parity_unescape(lit)
  local s = sub(lit, 2, #lit - 1)
  local out = ""
  local i = 1
  while i <= #s do
    local c = sub(s, i, i)
    if c ~= "\\" then
      local j = find(s, "\\", i)
      if j == nil then j = #s + 1 end
      out = out .. sub(s, i, j - 1)
      i = j
    else
      local e = sub(s, i + 1, i + 1)
      if e == "n" then
        out = out .. "\n"
      elseif e == "t" then
        out = out .. "\t"
      elseif e == "r" then
        out = out .. "\r"
      elseif e == "\\" or e == "\"" or e == "'" then
        out = out .. e
      else
        fail("gate parity: a Zig escape `\\" .. e .. "` this does not read, in " .. lit)
      end
      i = i + 2
    end
  end
  return out
end

-- The commands and hook inputs the Zig gate's test file names, read from its
-- string literals: {commands, hooks}.
function parity_test_inputs(src)
  local texts = lines(read(src))
  local by_line = {}
  for t in zig_tokens(src, {tag = "string_literal"}) do push_at(by_line, "" .. t.line, t.text) end
  local commands = {}
  local hooks = {}
  for n in keys(by_line) do
    local l = texts[parse_int(n)]
    local lits = by_line[n]
    if find(l, "readHook(") ~= nil or find(l, "wrapped(") ~= nil then
      push(hooks, parity_unescape(lits[#lits]))
    elseif find(l, "passes(") ~= nil or find(l, "refuses(") ~= nil or find(l, "gate.classify(") ~= nil then
      push(commands, parity_unescape(lits[1]))
    end
  end
  if #commands < 40 or #hooks < 10 then fail("gate parity: " .. src .. " gave " .. #commands .. " commands and " .. #hooks .. " hook inputs, fewer than it holds") end
  return {commands = commands, hooks = hooks}
end

-- `s` as a JSON string. A control byte other than a tab, a newline or a
-- return stops the run: no case here holds one.
function parity_quote(s)
  local out = substitute(s, "\\", "\\\\", {missing_ok = true})
  out = substitute(out, "\"", "\\\"", {missing_ok = true})
  out = substitute(out, "\n", "\\n", {missing_ok = true})
  out = substitute(out, "\t", "\\t", {missing_ok = true})
  out = substitute(out, "\r", "\\r", {missing_ok = true})
  if find(out, "\0") ~= nil or re_match(out, "[\x01-\x1f]") then fail("gate parity: a command with a control byte parity_quote does not write: " .. s) end
  return "\"" .. out .. "\""
end

-- The hook input of Bash's `cmd`, from session `session`.
function parity_hook(cmd, session)
  return "{\"session_id\":" .. parity_quote(session) .. ",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":" .. parity_quote(cmd) .. "}}"
end

-- Every case, as {name, input, home}: `home` is `dir` (a folder of the
-- run's), `file` (a file, so the log can't be written) or `none` (no HOME).
-- `forms` is the length of the forms every refusal names, so the cases at
-- the 1024-byte edge of a refusal's line are made from it.
function parity_cases(src, forms)
  local cases = {}
  local from = parity_test_inputs(src)
  local k = 0
  for c in from.commands do
    k = k + 1
    push(cases, {name = "zig test command " .. k, input = parity_hook(c, "s"), home = "dir"})
  end
  k = 0
  for h in from.hooks do
    k = k + 1
    push(cases, {name = "zig test hook " .. k, input = h, home = "dir"})
  end
  k = 0
  for c in PARITY_COMMANDS do
    k = k + 1
    push(cases, {name = "command " .. k, input = parity_hook(c, "s"), home = "dir"})
  end
  k = 0
  for h in PARITY_HOOKS do
    k = k + 1
    push(cases, {name = "hook " .. k, input = h, home = "dir"})
  end
  -- A plain word's refusal is `shale-gate: ` `w` `` ` is not a plain word; ``
  -- `only ` and the forms: the word at the line's 1024 bytes and either side.
  local edge = 1024 - (12 + 1 + 23 + 5 + forms)
  for d in {-1, 0, 1} do push(cases, {name = "a refusal of " .. (1024 + d) .. " bytes", input = parity_hook("shale $" .. rep("w", edge + d - 1), "s"), home = "dir"}) end
  push(cases, {name = "64 words", input = parity_hook("shale" .. rep(" w", 63), "s"), home = "dir"})
  push(cases, {name = "65 words", input = parity_hook("shale" .. rep(" w", 64), "s"), home = "dir"})
  push(cases, {name = "4096 lines", input = parity_hook("shale <<'T'" .. rep("\nx", 4095) .. "\nT", "s"), home = "dir"})
  push(cases, {name = "4096 lines and a newline", input = parity_hook("shale <<'T'" .. rep("\nx", 4095) .. "\nT\n", "s"), home = "dir"})
  push(cases, {name = "4097 lines", input = parity_hook("shale <<'T'" .. rep("\nx", 4096) .. "\nT", "s"), home = "dir"})
  push(cases, {name = "an escape's text past 2048 bytes", input = parity_hook("# want: long: " .. rep("t\\", 1500) .. "\nx", "s"), home = "dir"})
  for n in {4060, 4061, 4062, 4063, 4064} do push(cases, {name = "a session of " .. n .. " bytes then a tab", input = parity_hook("# want: cut: x\ny", rep("s", n) .. "\tq\\r"), home = "dir"}) end
  push(cases, {name = "an escape with no HOME", input = parity_hook("# want: t: x\ny", "s"), home = "none"})
  push(cases, {name = "a launch with no HOME", input = parity_hook("shale a.shale", "s"), home = "none"})
  push(cases, {name = "an escape whose log can't be written", input = parity_hook("# want: t: x\ny", "s"), home = "file"})
  push(cases, {name = "a refusal whose log can't be written", input = parity_hook("ls", "s"), home = "file"})
  local read = "{\"tool_name\":\"Read\"}"
  push(cases, {name = "a megabyte of input", input = read .. rep(" ", 1048576 - #read), home = "dir"})
  push(cases, {name = "a megabyte of input and a byte", input = read .. rep(" ", 1048577 - #read), home = "dir"})
  push(cases, {name = "a nesting 100000 deep", input = "{\"tool_name\":\"Read\",\"x\":" .. rep("[", 100000) .. rep("]", 100000) .. "}", home = "dir"})
  return cases
end

-- What the gate at OS path `bin` answers to `c`, under the folder `dir` its
-- HOME is made in: {code, out, log}, `log` what it appended to wants.tsv,
-- each line's date held to its shape and taken off.
function parity_answer(bin, dir, c)
  local argv = {bin}
  local env = {HOME = real(dir) .. "/home"}
  if c.home == "none" then
    argv = {"env", "-u", "HOME", bin}
    env = {}
  elseif c.home == "file" then
    env = {HOME = real(dir) .. "/a-file"}
  end
  local log = dir .. "/home/.local/state/shale/wants.tsv"
  local before = read_or(log, "")
  local r = run(argv, {stdin = c.input, env = env, timeout_ms = 20000, whole = 100000, want = PARITY_WANT})
  local after = read_or(log, "")
  local added = sub(after, #before + 1)
  local shown = {}
  for l in lines(added) do
    if not re_match(l, "^\\d\\d\\d\\d-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ\\t") then fail("gate parity: " .. bin .. " logged a line whose date is not YYYY-MM-DDTHH:MM:SSZ, for " .. c.name .. ": " .. sub(l, 1, 80)) end
    push(shown, sub(l, 21))
  end
  return {code = get(r, "code", -1), ended = r.ended, out = r.out, log = join(shown, "\n"), log_bytes = #added}
end

-- The gates at OS paths `zig_bin` and `c_bin` over every case, each with a
-- HOME of its own under `dir`. The first case whose answers differ stops the
-- run, showing both. Gives how many cases were held, and how many of them
-- each gate passed, refused and logged.
function parity_check(src, zig_bin, c_bin, dir)
  if exists(dir) then remove_tree(dir) end
  for side in {"zig", "c"} do
    mkdir(dir .. "/" .. side .. "/home")
    create(dir .. "/" .. side .. "/a-file", "not a folder\n")
  end
  -- The forms' length, from the Zig gate's refusal of `ls`.
  local probe = parity_answer(zig_bin, dir .. "/zig", {name = "the forms", input = parity_hook("ls", "s"), home = "dir"})
  local forms = #probe.out - #"shale-gate: `ls` is not `shale`; only \n"
  local cases = parity_cases(src, forms)
  local passed = 0
  local refused = 0
  local logged = 0
  for c in cases do
    local z = parity_answer(zig_bin, dir .. "/zig", c)
    local g = parity_answer(c_bin, dir .. "/c", c)
    if z.code ~= g.code or z.out ~= g.out or z.log ~= g.log then
      fail("gate parity: " .. c.name .. " answered unlike the Zig gate:\n--- input (" .. #c.input .. " bytes)\n" .. sub(c.input, 1, 600) .. "\n--- zig (" .. z.code .. ", " .. z.ended .. ")\n" .. z.out .. "log: " .. z.log .. "\n--- c (" .. g.code .. ", " .. g.ended .. ")\n" .. g.out .. "log: " .. g.log)
    end
    if z.code == 0 then passed = passed + 1 else refused = refused + 1 end
    if z.log_bytes > 0 then logged = logged + 1 end
  end
  remove_tree(dir)
  return {cases = #cases, passed = passed, refused = refused, logged = logged}
end
