-- c/build/regex.shale: c/script/regex's block.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── c/script/regex: its own block ──────────────────────────────────────
-- test_regex.c runs in the foundation's block with every test file. Here,
-- in both tiers: its count held to REGEX_TESTS, regex_test.zig's to
-- REGEX_ZIG_TESTS (a Zig test added is one the C has yet to port). In the
-- full tier: the faults below planted in a copy of c/script, each caught by
-- test_regex.c under asan (`run_plants`).

const REGEX_TESTS = 17
const REGEX_ZIG_TESTS = 10
const REGEX_PLANTS = {
  {name = "a split follows its less preferred way first",
   aim = "counted_repetition_is_the_part_written_out,sixteen_empty_loops_compile_and_a_seventeenth_is_refused_and_four_nested_but_not_five,compile_and_cache_put_leave_nothing_behind_when_the_arena_refuses,every_refusal_of_the_reader_says_its_text_at_its_byte,each_group_captures_its_own_part,an_empty_turn_ends_its_loop_as_a_backtrackers_does", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "second.pc = i.y;\n                at(sc->stack, top) = second;\n                top++;\n                t.pc = i.x;",
   new = "second.pc = i.x;\n                at(sc->stack, top) = second;\n                top++;\n                t.pc = i.y;"},
  {name = "the first bytes leave out a class's",
   aim = "counted_repetition_is_the_part_written_out,control_escapes_are_the_control_bytes_alone_and_in_a_class,a_class_holds_a_shorthand_an_escaped_byte_and_a_range_whose_end_is_escaped,a_search_that_skips_finds_what_one_examining_every_position_finds_from_every_start,a_pattern_that_can_match_nothing_or_begin_anywhere_skips_nothing_and_one_that_cannot_names_its_first_bytes,every_refusal_of_the_reader_says_its_text_at_its_byte,nocase_folds_bytes_and_classes_before_negation", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "regex_set_union(&got, &at(sets, i.x));", new = "(void)sets;"},
  {name = "the skip passes the byte a match begins at",
   aim = "counted_repetition_is_the_part_written_out,control_escapes_are_the_control_bytes_alone_and_in_a_class,a_class_holds_a_shorthand_an_escaped_byte_and_a_range_whose_end_is_escaped,compile_and_cache_put_leave_nothing_behind_when_the_arena_refuses,a_search_that_skips_finds_what_one_examining_every_position_finds_from_every_start,every_refusal_of_the_reader_says_its_text_at_its_byte,nocase_folds_bytes_and_classes_before_negation", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "if (regex_set_has(first, str_byte(rest, i))) return from + i;", new = "if (regex_set_has(first, str_byte(rest, i))) return from + i + 1;"},
  {name = "a state forgets its loops' bits",
   aim = "an_empty_turn_ends_its_loop_as_a_backtrackers_does", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "return at(p->base, pc) + k;", new = "return at(p->base, pc) + 0 * k;"},
  {name = "a count's optional copies are one short",
   aim = "counted_repetition_is_the_part_written_out", dir = "script", file = "regex.c", caught_by = "test_regex",
   old = "for (size_t k = least; k < most; k++) TRY(RegexNodeVec_push(&list, rest));", new = "for (size_t k = least + 1; k < most; k++) TRY(RegexNodeVec_push(&list, rest));"},
}

function regex_block(t)
  local regex_tests = test_count("c/tests/test_regex.c")
  if regex_tests ~= REGEX_TESTS then fail("c/tests/test_regex.c has " .. regex_tests .. " TEST(s), and REGEX_TESTS says " .. REGEX_TESTS) end
  local regex_zig = zig_test_count("src/script/regex_test.zig")
  if regex_zig ~= REGEX_ZIG_TESTS then fail("src/script/regex_test.zig has " .. regex_zig .. " tests, and REGEX_ZIG_TESTS says " .. REGEX_ZIG_TESTS .. ": port the new one to c/tests/test_regex.c") end
  print("regex: " .. regex_tests .. " C tests, " .. regex_zig .. " of them regex_test.zig's")
  if not t.full then return nil end
  run_plants(t, "regex plants", REGEX_PLANTS)
  return nil
end
-- ── end of c/script/regex's block ──────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"))
regex_block(t)
block_end(t, "regex")
