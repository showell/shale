-- c/build/host_tree.shale: the block of the host's tree readers,
-- c/host/flat_tree.c (`roc_tree` and `go_tree`).
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
-- budget: steps=40000000 programs=400 arena_bytes=268435456 changes=20000 change_bytes=1073741824

use("build:lib.shale")

-- ── The host's tree readers: roc_tree, go_tree ──────────────────────────
-- In both tiers: c/tests/text/test_flat_tree.c under each of `t.builds`,
-- held to its `TEST(` count and to HOST_TREE_TESTS, then each command binary
-- the command's block built runs HOST_TREE_SCRIPTS through the Linux prelude,
-- with the real roc-ast and go-ast under the `tools` mount, its output,
-- report and exit held to the installed Zig `shale`'s, the oracle. In the
-- full tier: the faults below planted in a copy of c/, each caught under tcc
-- by its `aim` tests.

const HOST_TREE_TEST = "c/tests/text/test_flat_tree.c"
const HOST_TREE_TESTS = 6

-- Each script's files are written by the script itself, so each binary's run
-- reads its own. A refusal, a missing file and the files after them are
-- each in the prelude's path through the host's reading.
const HOST_TREE_SCRIPTS = {
  {name = "roc_tree", source = [==[
create("a.roc", "module [x]\n\nx = 1 + 2\n")
create("bad.roc", "module [x]\n\nx = = 1\n")
create("empty.roc", "")
for f in roc_tree({"a.roc", "bad.roc", "gone.roc", "empty.roc", "a.roc"}) do
  print(f.path, #f.nodes, f.err)
  for n in f.nodes do print(n.kind, n.depth, n.parent, #n.kids, n.line, n.col, n.end_line, n.end_col, get(n, "raw", "")) end
end
print(#roc_tree({}))
]==]},
  {name = "go_tree", source = [==[
create("a.go", "package a\n\nfunc f(x int) int { return x + 1 }\n")
create("bad.go", "package a\nfunc (\n")
for f in go_tree({"a.go", "bad.go", "gone.go"}) do
  print(f.path, #f.nodes, f.err)
  for n in f.nodes do print(n.kind, n.depth, n.parent, #n.kids, n.line, n.col, get(n, "role", ""), get(n, "name", "")) end
end
]==]},
}

const HOST_TREE_PLANTS = {
  {name = "a node's depth is its parent's", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "at(file->nodes, parent - 1).depth + 1;", new = "at(file->nodes, parent - 1).depth;"},
  {name = "a `-` in an attribute's name is kept", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "if (at(room, k) == '-') at(room, k) = '_';", new = "if (0) at(room, k) = '_';"},
  {name = "a number's `_` is refused", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_reads_nodes_parents_depths_kids_spans_and_attributes_two_files_and_what_follows",
   old = "        if (c == '_') continue;\n", new = ""},
  {name = "a cut output refuses a line as a whole one does", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_ends_the_trees_at_a_line_that_does_not_read_in_a_cut_output",
   old = "if (ending == FLAT_WHOLE) {", new = "if (1) {"},
  {name = "the format is read as a prefix", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_reads_each_tools_header_as_its_own_and_refuses_another",
   old = "if (str_eq(first, S(FLAT_FORMAT))) {", new = "if (str_starts_with(first, S(FLAT_FORMAT))) {"},
  {name = "a file's nodes are not charged", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_stops_one_past_the_step_budget_at_a_files_nodes",
   old = "        TRY(run_charge(r, pos, f->nodes.len));\n", new = ""},
  {name = "the ending's word is checked only once the text is one", file = "flat_tree.c", dir = "host", caught_by = "text/test_flat_tree",
   aim = "flat_tree_refuses_its_arguments_in_zigs_order",
   old = [=[} else if (!str_eq(e->as.string, S("whole"))) {]=], new = [=[} else if (!str_eq(e->as.string, S("whole")) && at(args, 0).tag == VALUE_STRING) {]=]},
}

-- One script's run by `argv` in a folder of its own, `<script>-<who>`, which
-- holds a copy of the script: each run writes its own files.
function host_tree_run(t, dir, name, who, argv, env)
  local work = dir .. "/" .. name .. "-" .. who
  if exists(work) then remove_tree(work) end
  mkdir(work)
  copy(dir .. "/" .. name .. ".shale", work .. "/" .. name .. ".shale")
  return run_in(t, "host tree", argv, {timeout_ms = 60000, whole = 400000, env = env, cwd = work, want = WANT})
end

-- Each script of HOST_TREE_SCRIPTS under Zig's `shale` and each build's, with
-- the run's `tools` mount, where roc-ast and go-ast are installed.
function host_tree_scripts(t)
  local dir = OUT .. "/host_tree"
  if exists(dir) then remove_tree(dir) end
  mkdir(dir)
  local tools = attempt(real, "tools:.")
  if not tools.ok then fail("the host tree block needs the `tools` mount, where roc-ast and go-ast are installed") end
  create(dir .. "/mounts", "tools = " .. tools.value .. " ro tools\n")
  local env = {SHALE_PRELUDE = "", SHALE_MOUNTS = real(dir .. "/mounts"), SHALE_NOW = "1700000000"}
  for s in HOST_TREE_SCRIPTS do
    local file = s.name .. ".shale"
    create(dir .. "/" .. file, s.source)
    local z = host_tree_run(t, dir, s.name, "zig", {"shale", file}, env)
    if z.code ~= 0 then fail("Zig's shale ran " .. file .. " to a stop, so it judges nothing:\n" .. z.out) end
    for b in t.builds do
      local c = host_tree_run(t, dir, s.name, b, {real(OUT .. "/" .. b .. "/shale"), file}, env)
      if get(c, "code", -1) ~= z.code or c.out ~= z.out then
        fail("`" .. b .. "`'s shale ran " .. file .. " unlike Zig's:\n--- zig (" .. z.code .. ")\n" .. z.out .. "\n--- c (" .. get(c, "code", -1) .. ")\n" .. c.out)
      end
    end
  end
  return nil
end

function host_tree_block(t)
  local n = test_count(HOST_TREE_TEST)
  if n ~= HOST_TREE_TESTS then fail(HOST_TREE_TEST .. " has " .. n .. " TEST(s), and HOST_TREE_TESTS says " .. HOST_TREE_TESTS) end
  for b in t.builds do
    local total = test_file(t, "host tree " .. b, b, HOST_TREE_TEST)
    print("host tree " .. said_of_build(b, 1, total))
  end
  host_tree_scripts(t)
  print("host tree: " .. #HOST_TREE_SCRIPTS .. " scripts run as Zig runs them, under " .. #t.builds .. " build(s)")
  if not t.full then return nil end
  run_plants(t, "host tree plants", HOST_TREE_PLANTS)
  return nil
end
-- ── end of the host tree block ──────────────────────────────────────────

-- ── The run ─────────────────────────────────────────────────────────────

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"))
host_tree_block(t)
block_end(t, "host_tree")
