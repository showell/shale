-- c/build/surface.shale: the surface block, in both tiers.
-- c/build.shale runs it, with the `build` mount that `use` below reads; see
-- that file for the tiers and the blocks.
--
-- docs/SURFACE.txt, the frozen surface the C is held to, must be what
-- tools/surface.shale reads from the source today, as Zig's `zig build
-- surface-check` holds it: a change to what a script can observe fails here
-- until `shale tools/surface.shale write=1` has rewritten the file and its
-- diff is reviewed. It runs with no user prelude, as that step does.

use("build:lib.shale")

local t = block_start(arg("full", 0) == 1, arg("builds", "tcc"))
local r = run_in(t, "surface", {"shale", "tools/surface.shale"}, {timeout_ms = 120000, tail = 20, env = {SHALE_PRELUDE = ""}, not_re = "^── (budgets from the script's header|time: )"})
if get(r, "code", -1) ~= 0 then
  print(trim(r.out))
  fail("docs/SURFACE.txt is not what the source gives: regenerate it with `shale tools/surface.shale write=1` and review its diff")
end
print(trim(r.out))
block_end(t, "surface")
