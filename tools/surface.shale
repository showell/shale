-- surface.shale: Shale's frozen surface, read from its Zig source and its
-- preludes. The surface is every part of the language a script or a user can
-- observe: the builtins, the stop texts, the budgets, the CLI's flags and its
-- report lines, the mounts file and the gate. docs/SURFACE.txt holds what this
-- prints, so a change to what a script can observe shows in its diff. It is no
-- promise that the C matches the Zig (Steve, 2026-11-18): the golden tests
-- judge the C.
-- budget: steps=200000000 reads=2000 read_bytes=20000000 arena_bytes=300000000 output_bytes=200000 kept_bytes=268435456
--
-- From the checkout's root:
--   shale tools/surface.shale           fails unless docs/SURFACE.txt is what the source says
--   shale tools/surface.shale write=1   writes docs/SURFACE.txt from the source
--
-- C's fast tier (c/build/surface.shale) runs the first. A change to
-- what a script can observe changes the surface: rerun with write=1 and
-- review the diff of docs/SURFACE.txt beside the code's.

const TARGET = "docs/SURFACE.txt"

-- A Zig string literal, a char literal, and what opens either or a comment.
const ZSTR = [=["(?:\\.|[^"\\])*"]=]
const ZCHR = [=['(?:\\.|[^'\\])*']=]
const ZOPEN = [=["|'|//]=]

-- The files whose `refuse`, `said` and `say` make a refusal, not a stop.
const REFUSERS = {"cli.zig", "shale_gate.zig", "script_route.zig"}

-- A stop's class as a call's argument: `, .argument,`.
const CLASSES = [=[[(,] ?\.(syntax|refused|name|type|index|arithmetic|argument|budget|file_system|fail|host),]=]

-- The Zig files that make no observable text: tests, benches, fixtures and
-- generators.
const NOT_SURFACE = {"shale_fixture.zig", "shale_test_host.zig", "script_bench.zig", "shale_scale.zig", "gen.zig", "hunt.zig", "regex_judge.zig", "shale_edge_sites.zig"}

-- The preludes, each with the name a stop gives it.
const PRELUDES = {
  {path = "c/preludes/core.shale", module = "the prelude"},
  {path = "c/preludes/linux.shale", module = "the Linux prelude"},
  {path = "c/preludes/git.shale", module = "the git prelude"},
}

-- ── Reading Zig a line at a time ──

-- One line of Zig: its code, each string literal replaced by `"N"` (its
-- number, from `k0 + 1`), char literals by `'c'` and the comment cut; and
-- the literals' contents as the source writes them.
function zig_line(line, k0)
  local t = trim_start(line)
  if starts_with(t, "\\\\") then
    return {code = "\"" .. (k0 + 1) .. "\"", strs = {sub(t, 3)}}
  end
  local code = ""
  local strs = {}
  local pos = 1
  while true do
    local m = re_find(line, ZOPEN, {from = pos})
    if m == nil then
      code = code .. sub(line, pos)
      break
    end
    code = code .. sub(line, pos, m.at - 1)
    if m.text == "//" then break end
    local pat = ZSTR
    if m.text == "'" then pat = ZCHR end
    local s = re_find(line, pat, {from = m.at})
    if s == nil or s.at ~= m.at then
      code = code .. m.text
      pos = m.at + 1
    else
      if m.text == "\"" then
        push(strs, sub(s.text, 2, #s.text - 1))
        code = code .. "\"" .. (k0 + #strs) .. "\""
      else
        code = code .. "'c'"
      end
      pos = m.at + #s.text
    end
  end
  return {code = code, strs = strs}
end

-- `code` up to the `)` that closes its first `(`, or all of it.
function cut_call(code)
  local open = find(code, "(")
  if open == nil then return code end
  local d = 0
  local i = open
  while true do
    local m = re_find(code, "[()]", {from = i})
    if m == nil then return code end
    if m.text == "(" then d = d + 1 else d = d - 1 end
    if d == 0 then return sub(code, 1, m.at) end
    i = m.at + 1
  end
end

-- The call that starts at byte `from` of line `i`'s code, on as many lines
-- as it takes: `{code, strs}`, the placeholders numbering `strs`.
function zig_span(ls, i, from)
  local first = zig_line(ls[i], 0)
  local code = sub(first.code, from)
  local strs = {}
  for s in first.strs do push(strs, s) end
  local depth = #split(code, "(") - #split(code, ")")
  local j = i
  while depth > 0 and j < #ls and j < i + 40 do
    j = j + 1
    local z = zig_line(ls[j], #strs)
    for s in z.strs do push(strs, s) end
    code = code .. " " .. trim(z.code)
    depth = depth + #split(z.code, "(") - #split(z.code, ")")
  end
  return {code = cut_call(code), strs = strs}
end

-- A format string as it prints: `{{` and `}}` are one brace; `{s}`, `{d}`
-- and the rest stay, as the variable parts.
function unformat(s)
  return substitute(substitute(s, "{{", "{", {missing_ok = true}), "}}", "}", {missing_ok = true})
end

-- The texts a call's literals make, from byte `start` of its code to the
-- first `.{` (the format's arguments) after it: each literal one text, or,
-- where `++` joins them, one text with `{comptime}` for what is not a literal.
function texts_of(span, start, fmt)
  local code = span.code
  local stop = find(code, ".{", start)
  local region = sub(code, start)
  if stop ~= nil then region = sub(code, start, stop - 1) end
  local ms = re_find_all(region, [=["(\d+)"]=])
  local out = {}
  if #ms == 0 then return out end
  if contains(region, "++") then
    local t = ""
    local at = 1
    for m in ms do
      local gap = trim(substitute(substitute(sub(region, at, m.at - 1), "++", "", {missing_ok = true}), "(", "", {missing_ok = true}))
      if at > 1 and gap ~= "" and gap ~= ")" then t = t .. "{comptime}" end
      t = t .. span.strs[parse_int(m.group)]
      at = m.at + #m.text
    end
    local tail = trim(substitute(sub(region, at), "++", "", {missing_ok = true}))
    if tail ~= "" and tail ~= ")" and tail ~= "," and tail ~= ")," then t = t .. "{comptime}" end
    push(out, t)
  else
    for m in ms do push(out, span.strs[parse_int(m.group)]) end
  end
  if fmt then
    local f = {}
    for t in out do push(f, unformat(t)) end
    return f
  end
  return out
end

-- A call's code with its literals put back, cut to 80 bytes: how a call
-- whose text is computed is named in the list of them.
function head_of(span)
  local t = ""
  local at = 1
  for m in re_find_all(span.code, [=["(\d+)"]=]) do
    t = t .. sub(span.code, at, m.at - 1) .. "\"" .. span.strs[parse_int(m.group)] .. "\""
    at = m.at + #m.text
  end
  t = t .. sub(span.code, at)
  if #t > 80 then t = sub(t, 1, 77) .. "..." end
  return t
end

-- Whether a text says nothing fixed: only placeholders, or empty.
function only_placeholders(t)
  return trim(re_replace(t, [=[\{[a-z]*(?::[^}]*)?\}|\{comptime\}]=], "")) == ""
end

-- The calls on line `i` that make a text, each pushed to `r.msgs` as
-- `{kind, class, texts, head, fn}`:
--   `stop`: a run's stop (`fail`, `failf`, `failAt`, `refuse`, ...), its
--     class the call's `.class` (the lexer's: `refused` or `syntax` by its
--     flag);
--   `stop`, from a `Stop` made whole: `.class = .x` beside `.message = "..."`;
--   `refusal`: a command line's, the mounts', a prelude's (`refuse`, `said`,
--     `why = ...Print(...)`);
--   `report`: a line `print` or `writeAll` writes that starts `──` or
--     `shale`;
--   `output`: what a builtin writes to the script's output (`run.write`).
function scan_makers(r, ls, i, z, fn)
  local code = z.code
  local file = basename(r.path)
  if contains(code, "(") then
    for m in re_find_all(code, [=[(?:^|[^\w])(fail|failf|failAt|failLong|refuse|said|say)\(]=]) do
      local name = m.group
      local at = m.at + #m.text - #name - 1
      local before = sub(code, 1, at - 1)
      local skip = ends_with(trim_end(before), "fn") or (file == "shale_spawn.zig" and name == "fail")
      if not skip then
        local span = zig_span(ls, i, at)
        local kind = "stop"
        local class = ""
        local start = #name + 2
        -- A format takes its arguments as a tuple, `.{...}`, after the text.
        local fmt = contains(span.code, ".{")
        if file == "lex.zig" then
          local b = re_find(span.code, [=[\b(true|false)\b]=])
          if b ~= nil then
            if b.group == "true" then class = "refused" else class = "syntax" end
            start = b.at + #b.text
          else
            class = "syntax"
          end
        elseif file == "regex.zig" or (file == "shale_host_json.zig" and name == "failAt") then
          -- The regex's and the JSON reader's texts go into the builtin's
          -- own `argument` stop: `{s}` in "`re_find`'s pattern, at its byte
          -- {d}: {s}" and "`json_read`: {s} at byte {d} ...".
          class = "argument"
        elseif name == "refuse" or name == "said" or name == "say" then
          if has_item(REFUSERS, file) then
            kind = "refusal"
          else
            local c = re_find(span.code, CLASSES)
            if c == nil then
              kind = "none"
            else
              class = c.group
              start = c.at + #c.text
            end
          end
        else
          local c = re_find(span.code, CLASSES)
          if c ~= nil then
            class = c.group
            start = c.at + #c.text
          else
            class = "?"
          end
        end
        if kind ~= "none" then push(r.msgs, {kind = kind, class = class, texts = texts_of(span, start, fmt), head = head_of(span), fn = fn}) end
      end
    end
  end
  if contains(code, ".message = \"") and contains(code, ".class = .") then
    local c = re_find(code, [=[\.class = \.(\w+)]=])
    local mm = re_find(code, [=[\.message = "(\d+)"]=])
    if c ~= nil and mm ~= nil then push(r.msgs, {kind = "stop", class = c.group, texts = {z.strs[parse_int(mm.group)]}, head = "", fn = fn}) end
  end
  if contains(code, "why") and contains(code, "Print(") then
    local w = re_find(code, [=[why\b[^=]*= (?:try )?std\.fmt\.\w*Print\(]=])
    if w ~= nil then
      local span = zig_span(ls, i, w.at + find(w.text, "std.fmt") - 1)
      push(r.msgs, {kind = "refusal", class = "", texts = texts_of(span, 1, true), head = head_of(span), fn = fn})
    end
  end
  if contains(code, "print(\"") or contains(code, "writeAll(\"") then
    for m in re_find_all(code, [=[\b(print|writeAll)\("(\d+)"]=]) do
      local t = z.strs[parse_int(m.groups[2])]
      if starts_with(t, "──") or starts_with(t, "shale") then
        local span = zig_span(ls, i, m.at)
        push(r.msgs, {kind = "report", class = "", texts = texts_of(span, 1, m.groups[1] == "print"), head = "", fn = fn})
      end
    end
  end
  if contains(code, "run.write(") then
    local m = re_find(code, [=[run\.write\(]=])
    local span = zig_span(ls, i, m.at)
    push(r.msgs, {kind = "output", class = "", texts = texts_of(span, 1, true), head = head_of(span), fn = fn})
  end
end

-- ── One Zig file ──

-- Everything this tool reads from a Zig file, its tests passed by:
-- `fns` (each function's option keys and calls), `aliases` (`const x =
-- @import("f.zig")`), `specs` (the builtins it declares), `hosts` (the host
-- calls it dispatches), `msgs` (each call that makes a text) and `lines`.
function zig_scan(path)
  local ls = lines(read(path))
  local r = {fns = {}, aliases = {}, fnalias = {}, specs = {}, hosts = {}, msgs = {}, lines = ls, path = path}
  local file = basename(path)
  local in_test = false
  local fn = ""
  r.fns[""] = {keys = {}, calls = {}}
  for i = 1, #ls do
    local raw = ls[i]
    if in_test then
      if raw == "}" then in_test = false end
      continue
    end
    if starts_with(raw, "test \"") then
      in_test = true
      continue
    end
    local z = zig_line(raw, 0)
    local code = z.code
    local d = re_find(code, [=[^\s*(?:pub )?(?:inline )?fn (\w+)\(]=])
    if d ~= nil then
      fn = d.group
      if not has_key(r.fns, fn) then r.fns[fn] = {keys = {}, calls = {}} end
    end
    local f = r.fns[fn]
    if contains(code, "@import(") then
      local a = re_find(code, [=[const (\w+) = @import\("(\d+)"\)]=])
      if a ~= nil then r.aliases[a.groups[1]] = z.strs[parse_int(a.groups[2])] end
      for m in re_find_all(code, [=[@import\("(\d+)"\)\.(\w+)\(]=]) do
        push(f.calls, {file = z.strs[parse_int(m.groups[1])], fn = m.groups[2]})
      end
    end
    if contains(code, "(") then
      for m in re_find_all(code, [=[(?:^|[^\w.@])(\w+)\.(\w+)\(]=]) do
        push(f.calls, {alias = m.groups[1], fn = m.groups[2]})
      end
      for m in re_find_all(code, [=[(?:^|[^\w.@])(\w+)\(]=]) do
        push(f.calls, {file = file, fn = m.group})
      end
    end
    if contains(code, "eql(u8, k") then
      for m in re_find_all(code, [=[eql\(u8, (?:k|key), "(\d+)"\)]=]) do push(f.keys, z.strs[parse_int(m.group)]) end
    end
    if contains(code, "flagOption(") then
      for m in re_find_all(code, [=[flagOption\(run, pos, (?:"\d+"|[^,]+), "(\d+)"]=]) do push(f.keys, z.strs[parse_int(m.group)]) end
    end
    local fa = re_find(code, [=[^\s*(?:pub )?const (\w+) = (\w+)\.(\w+);]=])
    if fa ~= nil then r.fnalias[fa.groups[1]] = {alias = fa.groups[2], fn = fa.groups[3]} end
    if contains(code, "spec(.") then
      for m in re_find_all(code, [=[spec\(\.(\w+), (\d+), ([\w.]+), ([\w.]+)]=]) do
        push(r.specs, {name = m.groups[1], at_least = parse_int(m.groups[2]), at_most = m.groups[3], impl = m.groups[4]})
      end
    end
    if contains(code, "eql(u8, name, ") then
      for m in re_find_all(code, [=[eql\(u8, name, "(\d+)"\)]=]) do
        push(r.hosts, {name = z.strs[parse_int(m.group)], line = i, fn = fn})
      end
    end
    scan_makers(r, ls, i, z, fn)
  end
  return r
end

-- ── Options, through the calls ──

-- The option keys function `fn` of `file` reads, and every function it
-- reaches through its calls (in its file, or another's by an alias or an
-- `@import`), each once, sorted. `scans` maps a file's name to its scan.
function keys_reached(scans, file, fn)
  local seen = {}
  local found = {}
  local todo = {{file = file, fn = fn}}
  while #todo > 0 do
    local at = pop(todo)
    local id = at.file .. " " .. at.fn
    if has_key(seen, id) or not has_key(scans, at.file) then continue end
    seen[id] = true
    local s = scans[at.file]
    if not has_key(s.fns, at.fn) then
      -- `const runProgram = host_run.runProgram;`: the function is another file's.
      if has_key(s.fnalias, at.fn) and has_key(s.aliases, s.fnalias[at.fn].alias) then
        push(todo, {file = basename(s.aliases[s.fnalias[at.fn].alias]), fn = s.fnalias[at.fn].fn})
      end
      continue
    end
    local f = s.fns[at.fn]
    for k in f.keys do found[k] = true end
    for c in f.calls do
      if has_key(c, "alias") then
        if has_key(s.aliases, c.alias) then push(todo, {file = basename(s.aliases[c.alias]), fn = c.fn}) end
      else
        push(todo, {file = basename(c.file), fn = c.fn})
      end
    end
  end
  return sort(keys(found))
end

-- ── The preludes ──

-- A Shale string token's contents, as the source writes them.
function shale_string(text)
  if starts_with(text, "\"") or starts_with(text, "'") then return sub(text, 2, #text - 1) end
  local open = find(text, "[", 2)
  return sub(text, open + 1, #text - open)
end

-- The text a `fail(...)` makes, its `(` at token `open`.
function fail_text(toks, open)
  local d = 0
  local t = ""
  local in_expr = false
  local j = open
  while j <= #toks do
    local k = toks[j]
    if k.tag == "lparen" then d = d + 1 end
    if k.tag == "rparen" then
      d = d - 1
      if d == 0 then break end
    end
    if j > open then
      if d == 1 and k.tag == "string" then
        t = t .. shale_string(k.text)
        in_expr = false
      elseif d == 1 and k.tag == "dot_dot" then
        in_expr = false
      elseif not in_expr then
        t = t .. "{expr}"
        in_expr = true
      end
    end
    j = j + 1
  end
  return t
end

-- A prelude's top-level functions, in order: `{name, params, opts, hosts,
-- fails}`, `opts` the keys its `opts_only` calls name, `hosts` the host
-- calls it makes, `fails` the texts its `fail` calls make, `{expr}` for
-- what is not a literal.
function prelude_scan(path)
  local toks = {}
  for t in shale_tokens(path) do if t.tag ~= "comment" then push(toks, t) end end
  local fns = {}
  local depth = 0
  local cur = nil
  local i = 1
  while i <= #toks do
    local t = toks[i]
    if t.tag == "kw_function" and depth == 0 then
      local params = {}
      local j = i + 3
      while toks[j].tag ~= "rparen" do
        if toks[j].tag == "name" then
          local p = toks[j].text
          if toks[j + 1].tag == "question" then p = p .. "?" end
          push(params, p)
        end
        j = j + 1
      end
      cur = {name = toks[i + 1].text, params = params, opts = {}, hosts = {}, fails = {}}
      push(fns, cur)
      depth = 1
      i = j + 1
      continue
    end
    if t.tag == "kw_function" or t.tag == "kw_if" or t.tag == "kw_do" then depth = depth + 1 end
    if t.tag == "kw_end" then
      depth = depth - 1
      if depth == 0 then cur = nil end
    end
    if cur ~= nil and t.tag == "name" and i + 2 <= #toks and toks[i + 1].tag == "lparen" then
      if t.text == "opts_only" or t.text == "git_opts" then
        local j = i + 2
        while toks[j].tag ~= "lbrace" and toks[j].tag ~= "rparen" do j = j + 1 end
        while toks[j].tag ~= "rbrace" and toks[j].tag ~= "rparen" do
          if toks[j].tag == "string" then push(cur.opts, shale_string(toks[j].text)) end
          j = j + 1
        end
      elseif t.text == "host" and toks[i + 2].tag == "string" then
        push(cur.hosts, shale_string(toks[i + 2].text))
      elseif t.text == "fail" then
        push(cur.fails, fail_text(toks, i + 1))
      end
    end
    i = i + 1
  end
  return fns
end

-- ── Small helpers ──

-- An integer the Zig writes as `16 * 1024 * 1024` or `5_000_000`, or a name
-- in `consts`; nil for anything else.
function zig_int(e, consts)
  local n = 1
  for part in split(e, "*") do
    local p = substitute(trim(part), "_", "", {missing_ok = true})
    local v = parse_int(p)
    if v == nil and has_key(consts, trim(part)) then v = consts[trim(part)] end
    if v == nil then return nil end
    n = n * v
  end
  return n
end

-- The lines of a Zig file from the one declaring `fn name(` (the first
-- after `after`, a line holding it, when not "") to the `}` at its indent.
function zig_fn_lines(ls, name, after)
  local from = 1
  if after ~= "" then
    for i = 1, #ls do if contains(ls[i], after) then from = i break end end
  end
  local out = {}
  for i = from, #ls do
    if re_match(ls[i], "^\\s*(?:pub )?fn " .. name .. "\\(") then
      local indent = #ls[i] - #trim_start(ls[i])
      for j = i, #ls do
        push(out, ls[j])
        if j > i and #ls[j] - #trim_start(ls[j]) == indent and starts_with(trim(ls[j]), "}") then return out end
      end
      return out
    end
  end
  fail("surface: no `fn " .. name .. "` in the file")
end

-- Each text once, sorted, as `  <class>  <text>` lines.
function text_lines(rows)
  local seen = {}
  local out = {}
  for row in rows do
    local l = row
    if not has_key(seen, l) then
      seen[l] = true
      push(out, l)
    end
  end
  return sort(out)
end

-- ── The surface ──

local out = {}
local scans = {}
local files = {}
for p in glob("legacy_zig/src/**/*.zig") do
  if not ends_with(p, "_test.zig") and not has_item(NOT_SURFACE, basename(p)) then push(files, p) end
end
push(files, "legacy_zig/tools/shale_gate.zig")
for p in files do
  scans[basename(p)] = zig_scan(p)
  yield()
end

push(out, "# Shale's surface, generated by tools/surface.shale from the source: never edit it by hand.")
push(out, "#")
push(out, "# Every part of the language a script or a user can observe, read from the")
push(out, "# Zig source and the preludes: a record of the surface, whose diff shows")
push(out, "# what a change made observable. It is no promise that the C matches the")
push(out, "# Zig (Steve, 2026-11-18): the golden tests judge the C.")
push(out, "#")
push(out, "# Texts are as the source writes them, Zig's escapes kept (\\\" \\\\ \\n).")
push(out, "# The variable parts are marked: {s} {d} {t} {c} {any} (Zig's format, its")
push(out, "# {{ and }} shown as one brace), {comptime} for a part Zig joins at compile")
push(out, "# time, {expr} for a Shale expression a prelude's `fail` joins in.")
push(out, "# A section the source can't give mechanically is at the end, marked BY HAND.")
push(out, "")

-- The builtins.
local most_args = nil
for l in scans["builtins.zig"].lines do
  local m = re_find(l, [=[^pub const most_args = (\d+);]=])
  if m ~= nil then most_args = parse_int(m.group) end
end
local builtin_rows = {}
local n_builtins = 0
for name in sort(keys(scans)) do
  local s = scans[name]
  for sp in s.specs do
    local impl_file = name
    local impl = sp.impl
    local dot = find(impl, ".")
    if dot ~= nil then
      local alias = sub(impl, 1, dot - 1)
      if has_key(s.aliases, alias) then impl_file = basename(s.aliases[alias]) end
      impl = sub(impl, dot + 1)
    end
    -- `bi.most_args` is builtins.zig's `most_args`.
    local most = parse_int(sp.at_most)
    if most == nil and ends_with(sp.at_most, "most_args") then most = most_args end
    if most == nil then fail("surface: `" .. sp.name .. "` takes at most " .. sp.at_most .. ", which this tool cannot read") end
    local arity = sp.at_least .. ""
    if most ~= sp.at_least then arity = sp.at_least .. "-" .. most end
    if most == 255 then arity = sp.at_least .. "-any" end
    local opts = keys_reached(scans, impl_file, impl)
    push(builtin_rows, {name = sp.name, arity = arity, module = "core " .. strip_suffix(name, ".zig"), options = join(opts, ",")})
  end
end
sort(builtin_rows, "name")
n_builtins = #builtin_rows
-- Every member of `ast.Builtin` has its row, or this tool missed a form of
-- declaration.
local members = {}
local in_enum = false
for l in scans["ast.zig"].lines do
  if starts_with(l, "pub const Builtin = enum {") then in_enum = true
  elseif in_enum and starts_with(l, "};") then in_enum = false
  elseif in_enum then
    local m = re_find(l, [=[^\s+(\w+),]=])
    if m ~= nil then push(members, m.group) end
  end
end
local declared = {}
for b in builtin_rows do declared[b.name] = true end
for m in members do
  if not has_key(declared, m) then fail("surface: the builtin `" .. m .. "` is in ast.Builtin, and this tool found no `spec(.` for it") end
end
if #members ~= n_builtins then fail("surface: ast.Builtin has " .. #members .. " builtins, and this tool found " .. n_builtins) end
push(out, "## The core's builtins (" .. #builtin_rows .. "): name, arity, module, the option keys it reads")
for b in builtin_rows do
  local o = b.options
  if o == "" then o = "-" end
  push(out, "  " .. pad(b.name, 16) .. " " .. pad(b.arity, 6) .. " " .. pad(b.module, 22) .. " " .. o)
end
push(out, "")

-- The host calls, Linux's.
local host_rows = {}
for name in sort(keys(scans)) do
  local s = scans[name]
  for h in s.hosts do
    -- The function that does the call: the first a `return` names on its
    -- line or the six after it.
    local target = nil
    for j = h.line, min(h.line + 6, #s.lines) do
      local z = zig_line(s.lines[j], 0)
      local m = re_find(z.code, [=[return (?:@import\("(\d+)"\)\.|(\w+)\.)?(\w+)\(]=])
      if m ~= nil then
        local tf = name
        if m.groups[1] ~= "" then tf = basename(z.strs[parse_int(m.groups[1])]) end
        if m.groups[2] ~= "" and has_key(s.aliases, m.groups[2]) then tf = basename(s.aliases[m.groups[2]]) end
        target = {file = tf, fn = m.groups[3]}
        break
      end
    end
    local opts = "?"
    if target ~= nil then
      opts = join(keys_reached(scans, target.file, target.fn), ",")
      if opts == "" then opts = "-" end
    end
    push(host_rows, {name = h.name, module = strip_suffix(name, ".zig"), options = opts})
  end
end
-- A call dispatched twice (the Linux host's `call`, then its module's) is
-- its module's.
local host_by = {}
for h in host_rows do
  if not has_key(host_by, h.name) or host_by[h.name].module == "shale_host_linux" then host_by[h.name] = h end
end
push(out, "## The Linux host's calls, `host(name, ...)`: name, module, the option keys it reads (? where the call is inline)")
local n_host = 0
for name in sort(keys(host_by)) do
  local h = host_by[name]
  n_host = n_host + 1
  push(out, "  " .. pad(h.name, 16) .. " " .. pad(h.module, 22) .. " " .. h.options)
end
push(out, "")

-- The preludes' functions.
local prelude_fails = {}
local n_prelude = 0
local hc = {}
for name in keys(host_by) do hc[name] = host_by[name].options end
for pr in PRELUDES do
  local fns = prelude_scan(pr.path)
  push(out, "## " .. pr.module .. "'s functions (" .. #fns .. "), " .. pr.path .. ": signature; options; the host calls it makes")
  for f in fns do
    n_prelude = n_prelude + 1
    local o = {}
    for k in f.opts do o[k] = true end
    for h in f.hosts do
      if has_key(hc, h) and hc[h] ~= "-" and hc[h] ~= "?" then
        for k in split(hc[h], ",") do o[k] = true end
      end
    end
    local os = join(sort(keys(o)), ",")
    if os == "" then os = "-" end
    local hs = join(unique(f.hosts), ",")
    if hs == "" then hs = "-" end
    push(out, "  " .. f.name .. "(" .. join(f.params, ", ") .. ")  opts: " .. os .. "  host: " .. hs)
    for t in f.fails do push(prelude_fails, "  fail  " .. t .. "    [" .. pr.module .. "'s " .. f.name .. "]") end
  end
  push(out, "")
  yield()
end

-- The language's own names.
local lex = scans["lex.zig"].lines
local kws = {}
for l in lex do
  for m in re_find_all(l, [=[\.\{ "(\w+)", \.kw_]=]) do push(kws, m.group) end
end
local reserved = {}
for l in scans["parse.zig"].lines do
  local m = re_find(l, [=[^const (reserved_call|use_statement) = "(\w+)";]=])
  if m ~= nil then push(reserved, m.groups[2]) end
end
push(out, "## The language's own calls, no builtin's (parse.zig reserved_call, use_statement)")
push(out, "  " .. join(sort(reserved), " "))
push(out, "")
push(out, "## The keywords (" .. #kws .. ")")
push(out, "  " .. join(sort(kws), " "))
push(out, "")
local parse_lines = scans["parse.zig"].lines
local lua = {}
local in_lua = false
for l in parse_lines do
  if starts_with(l, "const lua_names") then in_lua = true
  elseif in_lua and starts_with(l, "});") then in_lua = false
  elseif in_lua then
    local z = zig_line(l, 0)
    if #z.strs == 2 then push(lua, "  " .. pad(z.strs[1], 12) .. " " .. z.strs[2]) end
  end
end
push(out, "## Lua's names, refused by name (" .. #lua .. "): the name, its message")
for l in lua do push(out, l) end
push(out, "")

-- The stops.
local n_stops = 0
local computed = {}
local secrets = {}
push(out, "## Every stop's class, and its message's text, by the module that makes it")
for name in sort(keys(scans)) do
  local s = scans[name]
  local rows = {}
  for m in s.msgs do
    if m.kind == "stop" then
      if #m.texts == 0 or (#m.texts == 1 and only_placeholders(m.texts[1])) then
        push(computed, "  " .. strip_suffix(name, ".zig") .. " (in " .. m.fn .. "): " .. m.class .. ": " .. m.head)
      end
      for t in m.texts do
        if not only_placeholders(t) then
          push(rows, pad(m.class, 10) .. " " .. t)
          if contains(lower(t), "secret") then push(secrets, "  " .. pad(strip_suffix(name, ".zig"), 18) .. " " .. pad(m.class, 10) .. " " .. t) end
        end
      end
    end
  end
  local tl = text_lines(rows)
  if #tl > 0 then
    push(out, "### " .. strip_suffix(name, ".zig") .. " (" .. #tl .. ")")
    for t in tl do push(out, "  " .. t) end
    n_stops = n_stops + #tl
  end
end
local pf = text_lines(prelude_fails)
push(out, "### the preludes' `fail`s (" .. #pf .. ")")
for t in pf do push(out, t) end
n_stops = n_stops + #pf
push(out, "")

push(out, "## The stops that speak of secrets (the secrets rule's messages, from the list above)")
for t in text_lines(secrets) do push(out, t) end
push(out, "")

-- The budgets.
local interp_lines = scans["interp.zig"].lines
local consts = {}
local fields = {}
local in_b = false
local doc = ""
for l in interp_lines do
  if starts_with(l, "pub const Budgets = struct {") then in_b = true
  elseif in_b and starts_with(l, "};") then in_b = false
  elseif in_b then
    local c = re_find(l, [=[^\s+pub const (\w+)(?:: \w+)? = ([\w *]+);]=])
    local f = re_find(l, [=[^\s+(\w+): \w+ = ([\w *]+),]=])
    local d = re_find(l, [=[^\s+/// (.*)$]=])
    if c ~= nil then
      consts[c.groups[1]] = zig_int(c.groups[2], consts)
      doc = ""
    elseif f ~= nil then
      local first = doc
      local stop = find(doc, ". ")
      if stop ~= nil then first = sub(doc, 1, stop) end
      push(fields, {name = f.groups[1], default = zig_int(f.groups[2], consts), doc = first})
      doc = ""
    elseif d ~= nil then
      doc = trim(doc .. " " .. d.group)
    end
  end
end
local cli = scans["cli.zig"].lines
local cli_defaults = {}
local settable = {}
for l in cli do
  if starts_with(l, "pub const defaults: interp.Budgets") then
    for m in re_find_all(l, [=[\.(\w+) = ([\d_ *]+)]=]) do cli_defaults[m.groups[1]] = zig_int(m.groups[2], consts) end
  end
  if starts_with(l, "const settable = ") then settable = zig_line(l, 0).strs end
end
push(out, "## The budgets (" .. #fields .. "): name, the core's default, the CLI's, whether `--budget` sets it, what it counts")
for f in fields do
  local c = f.default
  if has_key(cli_defaults, f.name) then c = cli_defaults[f.name] end
  local flag = "no"
  if has_item(settable, f.name) then flag = "--budget" end
  local dv = f.default
  if dv == nil then dv = "?" end
  if c == nil then c = "?" end
  push(out, "  " .. pad(f.name, 14) .. " " .. pad(dv, 10) .. " " .. pad(c, 10) .. " " .. pad(flag, 8) .. " " .. f.doc)
end
for k in sort(keys(consts)) do push(out, "  const " .. k .. " = " .. consts[k]) end
push(out, "  the names `--budget` and a `-- budget:` line take: " .. join(settable, " "))
push(out, "")
local diag_lines = scans["diag.zig"].lines
local budget_enum = {}
local in_e = false
for l in diag_lines do
  if starts_with(l, "pub const Budget = enum {") then in_e = true
  elseif in_e and starts_with(l, "};") then in_e = false
  elseif in_e then
    local m = re_find(l, [=[^\s+(\w+),$]=])
    if m ~= nil then push(budget_enum, m.group) end
  end
end
local stop_text = {}
for l in zig_fn_lines(interp_lines, "budgetStop", "") do
  local z = zig_line(l, 0)
  local m = re_find(z.code, [=[^\s+\.(\w+) => ]=])
  if m ~= nil then
    local ts = {}
    for t in z.strs do push(ts, unformat(t)) end
    stop_text[m.group] = ts
  end
end
push(out, "## The budgets a stop names (" .. #budget_enum .. "), `budget <name>`, each with its message (a second text is what it says when its own text could not be made)")
for b in budget_enum do
  local ts = get(stop_text, b, {"(no message in budgetStop)"})
  push(out, "  " .. pad(b, 13) .. " " .. join(ts, "  ||  "))
end
push(out, "")
push(out, "## The stop's report, as the CLI writes it (cli.zig printReport)")
for l in zig_fn_lines(cli, "printReport", "") do push(out, "  " .. l) end
push(out, "## The past-half rule (cli.zig pastHalf)")
for l in zig_fn_lines(cli, "pastHalf", "") do push(out, "  " .. l) end
push(out, "## The header's budgets line (cli.zig printHeaderBudgets)")
for l in zig_fn_lines(cli, "printHeaderBudgets", "") do push(out, "  " .. l) end
push(out, "")

-- The CLI.
push(out, "## The CLI's usage (cli.zig usage)")
local in_u = false
for l in cli do
  if starts_with(l, "pub const usage =") then in_u = true
  elseif in_u and starts_with(trim(l), ";") then in_u = false
  elseif in_u then push(out, "  " .. sub(trim_start(l), 3)) end
end
local flags = {}
for name in {"cli.zig", "script_runner.zig"} do
  for l in scans[name].lines do
    local z = zig_line(l, 0)
    if contains(z.code, "eql(u8, a") or contains(z.code, "eql(u8, argv[1]") then
      for t in z.strs do if starts_with(t, "-") then flags[t] = true end end
    end
  end
end
push(out, "## The flags the CLI reads (cli.zig parse, script_runner.zig main)")
push(out, "  " .. join(sort(keys(flags)), " "))
local envs = {}
for name in sort(keys(scans)) do
  for l in scans[name].lines do
    if contains(l, "environ_map.get(\"") then
      for m in re_find_all(l, [=[environ_map\.get\("(\w+)"\)]=]) do envs[m.group] = true end
    end
  end
end
push(out, "## The environment the CLI reads")
push(out, "  " .. join(sort(keys(envs)), " "))
push(out, "")
local n_refusals = 0
for name in {"cli.zig", "script_runner.zig", "shale_host_setup.zig", "shale_host_linux.zig", "shale_host_jobs.zig", "script.zig", "script_route.zig", "builtins_change.zig"} do
  local s = scans[name]
  for kind in {"refusal", "report", "output"} do
    local rows = {}
    for m in s.msgs do
      if m.kind == kind then
        if #m.texts == 0 then push(computed, "  " .. strip_suffix(name, ".zig") .. " (in " .. m.fn .. "): " .. kind .. ": " .. m.head) end
        for t in m.texts do push(rows, t) end
      end
    end
    local tl = text_lines(rows)
    if #tl > 0 then
      push(out, "## " .. strip_suffix(name, ".zig") .. "'s " .. kind .. " texts (" .. #tl .. ")")
      for t in tl do push(out, "  " .. t) end
      if kind == "refusal" then n_refusals = n_refusals + #tl end
    end
  end
end
push(out, "## The time line's rule (shale_host_linux.zig Time)")
local hl = scans["shale_host_linux.zig"].lines
for fname in {"worthSaying", "print", "seconds", "keepEnds"} do
  for l in zig_fn_lines(hl, fname, "pub const Time = struct") do push(out, "  " .. l) end
end
for l in hl do
  if contains(l, "const top_most =") or contains(l, "const argv_most =") or contains(l, "const elided =") then push(out, "  " .. l) end
end
push(out, "")

-- The mounts file.
push(out, "## The mounts file (shale_host_setup.zig parseMounts, loadMounts)")
local setup = scans["shale_host_setup.zig"].lines
local words = {}
for l in setup do
  local z = zig_line(l, 0)
  if contains(z.code, "eql(u8, w, ") then for t in z.strs do words[t] = true end end
  if contains(l, ".config/shale/mounts") and contains(l, "Print(") then push(out, "  the file unless SHALE_MOUNTS: " .. z.strs[1]) end
end
push(out, "  the words after a mount's path: " .. join(sort(keys(words)), " "))
push(out, "")

-- The gate.
push(out, "## The gate (legacy_zig/tools/shale_gate.zig): its forms, its refusals and its messages")
local gate = scans["shale_gate.zig"]
for l in gate.lines do
  local z = zig_line(l, 0)
  if starts_with(l, "pub const forms = ") then push(out, "  forms: " .. z.strs[1]) end
end
for l in zig_fn_lines(gate.lines, "refuse", "") do push(out, "  " .. l) end
local grows = {}
for m in gate.msgs do for t in m.texts do push(grows, t) end end
local gl = text_lines(grows)
for t in gl do push(out, "  " .. t) end
n_refusals = n_refusals + #gl
for l in gate.lines do
  if contains(l, "'\\'', '\"', '$'") then push(out, "  not a plain word: " .. trim(l)) end
end
push(out, "")

-- What the source did not give.
push(out, "## Calls that make a text the source does not spell out (computed): listed so the gap shows")
for t in text_lines(computed) do push(out, t) end
push(out, "")
local hand = read("tools/surface_by_hand.txt")
for l in lines(hand) do push(out, l) end
push(out, "")
push(out, "## The counts")
push(out, "  builtins " .. n_builtins .. ", host calls " .. n_host .. ", prelude functions " .. n_prelude)
push(out, "  stop texts " .. n_stops .. ", refusal texts " .. n_refusals .. ", budgets " .. #fields .. " (" .. #budget_enum .. " a stop names), flags " .. count(flags))

local text = join(out, "\n") .. "\n"
if arg("write", false) then
  replace(TARGET, text)
  print("surface: wrote " .. TARGET .. ", " .. #out .. " lines")
else
  local was = read_or(TARGET, "")
  if was ~= text then
    local a = lines(was)
    local b = lines(text)
    local i = 1
    while i <= #a and i <= #b and a[i] == b[i] do i = i + 1 end
    print("surface: " .. TARGET .. " differs from the source at line " .. i)
    print("  file:   " .. get(a, i, "(the end)"))
    print("  source: " .. get(b, i, "(the end)"))
    fail("surface: " .. TARGET .. " is stale: rerun `shale tools/surface.shale write=1` and review its diff")
  end
  print("surface: " .. TARGET .. " matches the source, " .. #out .. " lines")
end
