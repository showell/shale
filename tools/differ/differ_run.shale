-- tools/differ/differ_run.shale: the differ's run, which tools/differ.shale
-- launches with the `differ` mount its library is read through (`use` takes
-- a mount's path). tools/differ.shale's header is the differ's
-- documentation: the arguments, the inputs, the runs, the comparison and the
-- report.
--
-- budget: programs=200000 steps=2000000000 reads=2000000 read_bytes=8000000000 arena_bytes=1500000000 changes=500000 change_bytes=4000000000 output_bytes=4000000 kept_bytes=268435456

use("differ:lib.shale")

local DIFFER = arg("base", "build:differ")
local old = arg("old", "")
local new = arg("new", "")
local only = arg("only", "")
local predict = arg("predict", "")
local keep_all = arg("keep", 0)
local list_only = arg("list", 0)
local reuse = arg("reuse", 0)
local check_only = arg("check", 0)
if list_only == 0 and (old == "" or new == "") then fail("differ: name both binaries, old=<path> new=<path> (Shale paths)") end

-- Runs with one base share its inputs, its work folder and its kept trees,
-- so a second run at once removes what the first is reading, and both judge
-- the wreck: another `shale` running a differ.shale with this run's base
-- (`base=`, build:differ unset) stops this one before it touches anything.
-- A run with another base shares nothing and goes on. (`procs` never lists
-- this run or what started it, so a plant that runs the differ is not one.)
for p in procs() do
  if p.name == "shale" and re_find(p.args, "(?:^| )[^ ]*tools/differ\\.shale(?: |$)") ~= nil then
    local m = re_find(p.args, " base=([^ ]+)")
    local theirs = "build:differ"
    if m ~= nil then theirs = m.group end
    if theirs == DIFFER then fail("differ: another differ is running, and the two would share " .. DIFFER .. ": wait for it, or give this one its own `base=` (pid " .. p.pid .. ": " .. p.args .. ")") end
  end
end

local got = collect(DIFFER)
local inputs = {}
for inp in got.inputs do
  if only == "" or contains(inp.id, only) or contains(inp.origin, only) then push(inputs, inp) end
end
local by_source = {}
for inp in inputs do incr(by_source, inp.source) end
local src_rows = {}
for s in keys(by_source) do push(src_rows, {source = s, inputs = by_source[s]}) end
print("── " .. #inputs .. " inputs (" .. got.dups .. " repeated sources counted once)")
print(table(src_rows, {"source", "inputs"}))
print("── " .. surface_status())
if list_only == 1 then
  local l = {}
  for inp in inputs do push(l, join({inp.id, inp.source, inp.origin, #inp.steps .. " step(s)"}, "\t")) end
  replace_or_create(DIFFER .. "/inputs.tsv", join(l, "\n") .. "\n")
  print("── the list: " .. DIFFER .. "/inputs.tsv")
  return
end

mkdir(DIFFER .. "/reports")
if reuse == 0 and exists(DIFFER .. "/keep") then remove_tree(DIFFER .. "/keep") end
local cfg = harness(DIFFER, "cookbook", check_only == 1)
mounts_files(cfg, inputs)

local started = clock()
local phase_ms = {old_a = 0, old_b = 0, new = 0}
local per_ms = {}
local phases = {{side = "old_a", bin = old}, {side = "old_b", bin = old}, {side = "new", bin = new}}
if reuse == 1 then phases = {} end
for phase in phases do
  install(phase.bin, cfg)
  local t = 0
  for inp in inputs do
    local ms = launch(cfg, inp, side_dir(cfg, inp.id, phase.side))
    t = t + ms
    per_ms[inp.id .. " " .. phase.side] = ms
    yield()
  end
  phase_ms[phase.side] = t
  print("── " .. phase.side .. ": " .. t .. " ms in the binary's runs")
end

-- A failure is confirmed by a third run of the oracle before it counts: two
-- runs that agree by chance (a race with a 10 ms deadline) are not yet a
-- deterministic oracle.
install(old, cfg)
local rows = {}
local counts = {pass = 0, fail = 0, nondet = 0}
local by_area = {}
local nondet = {}
local arena = {stop = 0, kept = 0, reads = 0, either = 0, stop_ids = {}, kept_ids = {}, read_ids = {}}
local pred = {hit = 0, missed = 0, extra = 0}
local extra_ids = {}
local missed_ids = {}
for inp in inputs do
  local row = {id = inp.id, source = inp.source, origin = inp.origin, verdict = "", arena = "", area = "", what = "", where = "", old = "", new = ""}
  local text = read(inp.text_path)
  local ao = layout_observer(side_dir(cfg, inp.id, "old_a"), #inp.steps, text)
  if ao.stop then
    arena.stop = arena.stop + 1
    row.arena = "stop"
    push(arena.stop_ids, inp.id .. " " .. inp.origin)
  end
  if ao.kept ~= "" then
    arena.kept = arena.kept + 1
    row.arena = row.arena .. " " .. ao.kept
    push(arena.kept_ids, ao.kept .. " stop: " .. inp.id .. " " .. inp.origin)
  end
  if ao.reads then
    arena.reads = arena.reads + 1
    row.arena = row.arena .. " reads"
    push(arena.read_ids, inp.id .. " " .. inp.origin)
  end
  row.arena = trim(row.arena)
  local by_class = ao.stop or ao.kept ~= "" or ao.reads
  if by_class then arena.either = arena.either + 1 end
  local judge = {class = by_class, digits = ao.reads}
  local twice = differ_sides(cfg, inp, "old_a", "old_b", judge)
  local d = nil
  if twice == nil then
    d = differ_sides(cfg, inp, "old_a", "new", judge)
    if d ~= nil then
      launch(cfg, inp, side_dir(cfg, inp.id, "old_c"))
      local third = differ_sides(cfg, inp, "old_a", "old_c", judge)
      if third ~= nil then
        twice = third
        twice.what = twice.what .. " (on a third run)"
      end
    end
  end
  if twice ~= nil then
    row.verdict = "nondet"
    row.what = twice.what
    row.where = twice.where
    row.old = clip(twice.a)
    row.new = clip(twice.b)
    push(nondet, inp.id .. " " .. inp.origin .. ": " .. twice.what .. " " .. twice.where .. ": `" .. clip(twice.a) .. "` then `" .. clip(twice.b) .. "`")
  else
    if d == nil then
      row.verdict = "pass"
    else
      row.verdict = "fail"
      row.area = area_of(inp, d, text)
      row.what = d.what
      row.where = d.where
      row.old = clip(d.a)
      row.new = clip(d.b)
      push_at(by_area, row.area, row)
    end
    if predict ~= "" then
      local p = oracle_holds(cfg, inp, predict)
      if p and d ~= nil then pred.hit = pred.hit + 1 end
      if p and d == nil then
        pred.missed = pred.missed + 1
        push(missed_ids, inp.id .. " " .. inp.origin)
      end
      if not p and d ~= nil then
        pred.extra = pred.extra + 1
        push(extra_ids, inp.id .. " " .. inp.origin)
      end
    end
  end
  if keep_all == 0 and reuse == 0 and row.verdict == "pass" then remove_tree(DIFFER .. "/keep/" .. inp.id) end
  counts[row.verdict] = counts[row.verdict] + 1
  push(rows, row)
  yield()
end

-- The TSV: a row an input.
const COLUMNS = {"id", "source", "origin", "verdict", "arena", "area", "what", "where", "old", "new"}
local stamp = substitute(substitute(date(now()), ":", ""), "-", "")
local tsv = DIFFER .. "/reports/" .. stamp .. ".tsv"
local mode = ""
if check_only == 1 then mode = ", every step as --check" end
local body = {"# differ: old " .. old .. ", new " .. new .. mode, join(COLUMNS, "\t")}
for row in rows do
  local f = {}
  for c in COLUMNS do push(f, substitute(tostring(row[c]), "\t", " ", {missing_ok = true})) end
  push(body, join(f, "\t"))
end
create(tsv, join(body, "\n") .. "\n")

print("")
print("── failures by the area most likely responsible")
if counts.fail == 0 then print("  none") end
for a in sort(keys(by_area)) do
  print(a .. ": " .. #by_area[a])
  for row in take(by_area[a], 8) do
    print("  " .. row.id .. " " .. row.origin .. ": " .. row.what .. " " .. row.where)
    print("      old: " .. row.old)
    print("      new: " .. row.new)
  end
  if #by_area[a] > 8 then print("  ... and " .. (#by_area[a] - 8) .. " more (the TSV)") end
end
if #nondet > 0 then
  print("")
  print("── nondeterministic under the oracle alone (a finding of the harness; not judged): " .. #nondet)
  for l in nondet do print("  " .. l) end
end
if predict ~= "" then
  print("")
  print("── predicted by `" .. predict .. "` in the oracle's output: " .. pred.hit .. " failed as predicted, " .. pred.missed .. " predicted and passed, " .. pred.extra .. " failed unpredicted")
  for l in take(missed_ids, 10) do print("  predicted, passed: " .. l) end
  for l in take(extra_ids, 10) do print("  failed, unpredicted: " .. l) end
end
print("")
print("── judged by class (the arena's layouts are outside the surface; their numbers let go): " .. arena.either .. " inputs, " .. arena.stop .. " stopping on the arena budget, " .. arena.kept .. " on the kept or machine budget, " .. arena.reads .. " reading `arena_bytes`")
for l in arena.stop_ids do print("  arena stop: " .. l) end
for l in arena.kept_ids do print("  " .. l) end
for l in arena.read_ids do print("  reads arena_bytes: " .. l) end
print("── wall: " .. (clock() - started) .. " s in all; in the binaries' runs, old " .. phase_ms.old_a .. " + " .. phase_ms.old_b .. " ms, new " .. phase_ms.new .. " ms")
print("── " .. tsv)
print("── " .. #inputs .. " inputs: " .. counts.pass .. " pass, " .. counts.fail .. " fail, " .. counts.nondet .. " nondeterministic")
if counts.fail > 0 then fail("differ: " .. counts.fail .. " inputs differ from the oracle") end
