-- The differ's plant for the kept and machine budgets (tools/differ.shale,
-- `layout_observer`): an input whose oracle stops on `budget kept` or
-- `budget machine` is judged by class, its step count let go and its class,
-- place and message held; an ordinary input's step count is still held.
--
--   cd <shale> && shale tools/differ/plants/kept_class.shale shale=<path>
--
-- `shale` is a Shale path to a `shale` binary, the oracle and the binary
-- under test both; `base` is the differ's folder (build:differ unset). The
-- plant runs the differ on one input, keeping its trees, then changes the
-- kept `new` side's stderr and judges again (`reuse=1`), the side put back
-- between changes:
--   the kept stop (src/script/yield_test.zig:75, which stops on `budget
--   kept` under the default kept budget):
--   1. its `(N steps)` and `── used:` digits changed: it passes, judged by
--      class, a kept stop;
--   2. a word of its message changed: it fails, on stderr;
--   3. its class changed to `budget machine`: it fails, on stderr;
--   an ordinary stop (tools/differ/stops/type_add_string.shale):
--   4. its `(N steps)` changed: it fails, on stderr.

local bin = arg("shale", "")
if bin == "" then fail("kept_class plant: name the binary, shale=<path> (a Shale path)") end
const BASE = arg("base", "build:differ")
const KEPT_INPUT = "src/script/yield_test.zig:75"
const PLAIN_INPUT = "stops/type_add_string.shale"

function differ(bin, only, more)
  local argv = {"shale", "tools/differ.shale", "old=" .. bin, "new=" .. bin, "only=" .. only, "base=" .. BASE}
  for a in more do push(argv, a) end
  return run(argv, {timeout_ms = 120000, tail = 40})
end

function verdict(r)
  for l in lines(r.out) do
    if starts_with(l, "── 1 inputs: ") then return l end
  end
  return "(no verdict: " .. trim(r.out) .. ")"
end

function passes(r)
  return r.code == 0 and contains(r.out, "── 1 inputs: 1 pass,")
end

function fails_on_stderr(r)
  return r.code ~= 0 and contains(r.out, "── 1 inputs: 0 pass, 1 fail,") and contains(r.out, ": stderr line 1")
end

local wrong = {}
function check(wrong, held, what)
  print((held and "ok    " or "FAIL  ") .. what)
  if not held then push(wrong, what) end
  return nil
end

-- The one input's kept `new` stderr, after a first run with `keep=1`.
function kept_err(bin, only, wrong)
  local first = differ(bin, only, {"keep=1"})
  check(wrong, passes(first), only .. " as the oracle left it: passes (" .. verdict(first) .. ")")
  local ids = ls(BASE .. "/keep")
  if #ids ~= 1 then fail("kept_class plant: " .. #ids .. " inputs kept for " .. only .. ", not one") end
  return {path = BASE .. "/keep/" .. ids[1] .. "/new/1.err", out = first.out}
end

-- `err` with its stop's `(N steps)` and the `── used:` line's step counts
-- one more.
function more_steps(err)
  local m = re_find(err, "\\(([0-9]+) steps\\)")
  if m == nil then fail("kept_class plant: the stop has no `(N steps)`: " .. err) end
  local n = tostring(parse_int(m.group) + 1)
  local out = substitute(err, "(" .. m.group .. " steps)", "(" .. n .. " steps)")
  return substitute(out, "── used: " .. m.group .. " of", "── used: " .. n .. " of", {missing_ok = true})
end

-- The kept stop.
local k = kept_err(bin, KEPT_INPUT, wrong)
local err = read(k.path)
if not contains(err, ": budget kept: ") then fail("kept_class plant: " .. KEPT_INPUT .. " no longer stops on `budget kept`: " .. err) end
check(wrong, contains(k.out, "  kept stop: ") and contains(k.out, " 1 on the kept or machine budget,"), "the kept stop: counted as judged by class")

replace(k.path, more_steps(err))
local steps = differ(bin, KEPT_INPUT, {"reuse=1"})
check(wrong, passes(steps), "the kept stop at another step: passes (" .. verdict(steps) .. ")")

replace(k.path, substitute(err, "is past the kept budget", "is past the kept limit"))
local msg = differ(bin, KEPT_INPUT, {"reuse=1"})
check(wrong, fails_on_stderr(msg), "the kept stop with another message: fails on stderr (" .. verdict(msg) .. ")")

replace(k.path, substitute(err, ": budget kept: ", ": budget machine: "))
local class = differ(bin, KEPT_INPUT, {"reuse=1"})
check(wrong, fails_on_stderr(class), "the kept stop with another class: fails on stderr (" .. verdict(class) .. ")")
replace(k.path, err)

-- An ordinary stop: its step count is the surface's.
local p = kept_err(bin, PLAIN_INPUT, wrong)
local plain = read(p.path)
check(wrong, not contains(p.out, "  kept stop: ") and contains(p.out, "): 0 inputs,"), "the ordinary stop: not judged by class")
replace(p.path, more_steps(plain))
local ordinary = differ(bin, PLAIN_INPUT, {"reuse=1"})
check(wrong, fails_on_stderr(ordinary), "the ordinary stop at another step: fails on stderr (" .. verdict(ordinary) .. ")")
replace(p.path, plain)

if #wrong > 0 then fail("kept_class plant: " .. #wrong .. " wrong") end
print("kept_class plant: PASS (a kept stop's step count is let go, its message and class are not; an ordinary stop's step count is held)")
