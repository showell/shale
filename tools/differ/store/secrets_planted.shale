-- A secrets mount (`k:`, the fixture's planted folder) refuses every read of
-- the store, by its own name and by the scratch mount's path to its folder,
-- and its file reaches a program only through `run`'s `secrets`, scrubbed
-- from what the program prints.
-- differ-before: fixture/setup.shale
-- differ-mounts: store.mounts
function rd(p) return read(p) end
function ex(p) return exists(p) end
function st(p) return stat(p) end
function lsd(p) return ls(p) end
function wk(p) return walk(p) end
print(attempt(rd, "k:token").error)
print(attempt(ex, "k:token").error)
print(attempt(st, "k:token").error)
print(attempt(lsd, "k:").error)
print(attempt(rd, "scratch:keys/token").error)
print(attempt(wk, "scratch:keys").error)
local r = run({"printenv", "PLANTED"}, {timeout_ms = 5000, tail = 5, secrets = {PLANTED = "k:token"}})
print(r.code, r.out)
