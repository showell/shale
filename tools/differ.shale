-- The differential harness: every input Shale's own checks hold it to, run
-- under two binaries and compared from the outside, so a new Shale (the C
-- rewrite) is judged against today's Zig Shale, the oracle. The language is
-- frozen byte for byte, so anything that differs is a failure, but for the
-- `── time:` line, which is let go whole, `fresh_dir`'s random names, which
-- are masked (`fresh_mask`), and the arena's numbers, which are outside the
-- frozen surface (docs/C-SEAMS.md, "Fidelity").
--
--   cd <shale> && shale tools/differ.shale old=<path> new=<path>
--
-- The arguments (Shale paths, as bench/baseline.shale takes its binary):
--   old       the oracle's binary (today's master build, zig-out/bin/shale);
--   new       the binary under test;
--   only      run only the inputs whose id or origin holds this literal;
--   predict   a literal: an input is predicted to fail when the oracle's
--             output holds it, and the report says how the failures match
--             the prediction (a plant's check: tools/differ/README.md);
--   keep      1: keep every run's tree under build:differ/keep (0: only
--             the failures');
--   reuse     1: run nothing, and judge the runs a `keep=1` run left;
--   list      1: list the inputs in build:differ/inputs.tsv and stop,
--             running nothing.
--
-- **The inputs are collected, never listed by hand** (`collect_*` below):
--   zig-tests     each Shale source a Zig test hands a runner helper
--                 (`expectOutput("...")` and its kin, `RUNNERS`), a string
--                 literal or a `\\` block, as the test file holds it;
--   prelude-tests the same, from the three preludes' own test files;
--   docs          each ```shale and ```shale-linux block of docs/SHALE.md
--                 and docs/SHALE-AGENTS.md, the blocks their tests run;
--   cookbook      each recipe that reads `arg("self_test"`, run as the
--                 `cookbook-test` step runs it, `self_test=1`;
--   lessons       web/lessons.js: lesson N is every cell of lessons 1 to N,
--                 in order, in one folder, as the tutorial builds its files;
--   stops         tools/differ/stops/*.shale, one script a stop class (and
--                 build:differ/surface/*.shale, written from
--                 docs/SURFACE.txt's stop templates once it lands);
--   cli           tools/differ/cli/*.shale, the command line's own paths,
--                 each with its argv in a `-- differ-argv:` line.
--
-- **Each input runs three times**: the oracle twice, then the binary under
-- test, each run in a fresh folder at one fixed path
-- (build:differ/work/root, its scratch mount beside it), with one mounts
-- file, one environment (`now()` pinned by SHALE_NOW, git's dates and
-- identity pinned, no user prelude, a fixed HOME and PATH) and the cookbook
-- copied at this checkout's state. The binary itself is copied to one path
-- (build:differ/bin/shale) for each phase, so its own path never differs.
-- An input whose two oracle runs differ is nondeterministic: it is reported
-- as such, a finding of the harness, and never judged. An input that fails
-- runs under the oracle a third time first, and is nondeterministic if that
-- run differs.
--
-- **The comparison:** each step's exit, stdout and stderr (the `── used:`
-- line among it), and every file the run left, by its kind, mode and bytes,
-- but for a git index, which is compared by what it stages (`is_git_index`):
-- git writes its stat cache, nanosecond times and inodes, in each run anew.
-- The `── time:` line is let go whole (Steve, 2026-11-17): its numbers,
-- whether it is there at all, and where it falls, since a second of wall time
-- in programs decides whether it is printed. Nothing else is, but for an
-- input that
-- observes arena bytes, which is **judged by class**: its oracle stops on the
-- arena budget, or its source reads `arena_bytes` outside a `-- budget:`
-- line (`arena_observer`, found from the run and the source, never a hand
-- list). Its stop's class and message are compared still; the digits of its
-- `── used:` line and its stop's `(N steps)` are let go, and, when it reads
-- `arena_bytes`, every digit of its output, since which number is the arena's
-- cannot be told from outside. The summary counts these inputs.
--
-- **The report:** one TSV row an input under build:differ/reports, and on
-- the console the failures grouped by the area most likely responsible,
-- each with its first differing line.
--
-- budget: programs=200000 steps=2000000000 reads=2000000 read_bytes=8000000000 arena_bytes=1500000000 changes=500000 change_bytes=4000000000 output_bytes=4000000 kept_bytes=268435456

-- The runner helpers of the Zig tests whose first string argument is a
-- whole Shale source.
const RUNNERS = {"expectOutput", "expectStop", "expectStopWith", "run", "runWith", "runOnce", "runAt", "once", "onceStop", "expectOnce", "expectFail", "expectOk", "lastLine", "runPreludes", "runByHeader", "reported", "parseOk", "parseStop", "parseCounted", "oomsBeforeStop", "expectSays", "output", "steps", "measure"}

-- The preludes' own test files: their inputs are `prelude-tests`.
const PRELUDE_TESTS = {"src/script/prelude_test.zig", "src/shale_prelude_linux_test.zig", "src/shale_prelude_git_test.zig"}

-- The docs whose shale blocks the tests run.
const DOCS = {"docs/SHALE.md", "docs/SHALE-AGENTS.md"}

-- An input that holds one of these is not run: each reaches past the box's
-- own folders (a process not its own, the network, a job kept past the
-- run's end). Each is
-- listed in the report as skipped, with its reason.
const SKIP_IF = {"proc_stop(", "http(", "http_get(", "keep_on_stop"}

const WORK = "build:differ/work"
const KEEP = "build:differ/keep"
const INPUTS = "build:differ/inputs"
const BIN = "build:differ/bin"

-- The wrapper that keeps a step's stdout and stderr apart: `run` gives the
-- two as one.
const WRAP = [=[exec "$@" <"$DIFFER_IN" >"$DIFFER_OUT" 2>"$DIFFER_ERR"]=]

const PINNED_NOW = "1700000000"
const PINNED_GIT_DATE = "2023-11-14T22:13:20+00:00"

const HEX = "0123456789abcdef"
const BYTES = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

-- ── decoding a Zig string literal ──

function byte_of(n)
  return sub(BYTES, n + 1, n + 1)
end

function hex_value(s)
  local v = 0
  for i = 1, #s do
    local d = find(HEX, lower(sub(s, i, i)))
    if d == nil then fail("differ: `" .. s .. "` is not hexadecimal") end
    v = v * 16 + d - 1
  end
  return v
end

-- A code point as UTF-8.
function utf8_of(cp)
  if cp < 128 then return byte_of(cp) end
  if cp < 2048 then return byte_of(192 + cp // 64) .. byte_of(128 + cp % 64) end
  if cp < 65536 then return byte_of(224 + cp // 4096) .. byte_of(128 + (cp // 64) % 64) .. byte_of(128 + cp % 64) end
  return byte_of(240 + cp // 262144) .. byte_of(128 + (cp // 4096) % 64) .. byte_of(128 + (cp // 64) % 64) .. byte_of(128 + cp % 64)
end

-- A Zig `"..."` literal's bytes.
function zig_unquote(t)
  local s = sub(t, 2, #t - 1)
  if find(s, "\\") == nil then return s end
  local out = {}
  local i = 1
  while i <= #s do
    local j = find(s, "\\", i)
    if j == nil then
      push(out, sub(s, i))
      break
    end
    if j > i then push(out, sub(s, i, j - 1)) end
    local c = sub(s, j + 1, j + 1)
    if c == "n" then
      push(out, "\n")
      i = j + 2
    elseif c == "t" then
      push(out, "\t")
      i = j + 2
    elseif c == "r" then
      push(out, "\r")
      i = j + 2
    elseif c == "\\" or c == "\"" or c == "'" then
      push(out, c)
      i = j + 2
    elseif c == "x" then
      push(out, byte_of(hex_value(sub(s, j + 2, j + 3))))
      i = j + 4
    elseif c == "u" then
      local close = find(s, "}", j)
      push(out, utf8_of(hex_value(sub(s, j + 3, close - 1))))
      i = close + 1
    else
      fail("differ: a Zig escape `\\" .. c .. "` the harness does not read, in " .. t)
    end
  end
  return join(out, "")
end

-- ── collecting the inputs ──

-- What an input source holds that makes it skipped, or "".
function skip_reason(text)
  for s in SKIP_IF do
    if contains(text, s) then return "holds `" .. s .. "`" end
  end
  return ""
end

-- One input added to `c`, its source written as a file of its own; a source
-- already collected is counted on the first, not run twice.
function add_input(c, source, origin, text, argv_tail)
  if has_key(c.seen, text) then
    c.dups = c.dups + 1
    return nil
  end
  c.seen[text] = true
  c.n = c.n + 1
  local id = "i" .. sub("0000" .. c.n, -4)
  local file = INPUTS .. "/" .. id .. ".shale"
  create(file, text)
  local argv = {real(file)}
  if argv_tail ~= nil then
    for a in argv_tail do push(argv, a) end
  end
  push(c.inputs, {id = id, source = source, origin = origin, text_path = file, steps = {{argv = argv, stdin = ""}}, skip = skip_reason(text)})
  return id
end

-- The Shale sources one Zig file hands the runner helpers.
function zig_sources(p)
  local toks = zig_tokens(p)
  local found = {}
  local i = 1
  while i + 2 <= #toks do
    if toks[i].tag == "identifier" and toks[i + 1].tag == "l_paren" and has_item(RUNNERS, toks[i].text) then
      local k = i + 2
      -- The fixture first (`t`, `&t`, `f`), then the source.
      local j = k
      if toks[j].tag == "ampersand" then j = j + 1 end
      if toks[j].tag == "identifier" and j + 2 <= #toks and toks[j + 1].tag == "comma" then k = j + 2 end
      local t = toks[k]
      if t.tag == "string_literal" then
        local after = toks[k + 1].tag
        if after == "comma" or after == "r_paren" then push(found, {line = t.line, text = zig_unquote(t.text)}) end
      elseif t.tag == "multiline_string_literal_line" then
        local parts = {}
        local m = k
        while m <= #toks and toks[m].tag == "multiline_string_literal_line" do
          push(parts, sub(toks[m].text, 3))
          m = m + 1
        end
        if m <= #toks and (toks[m].tag == "comma" or toks[m].tag == "r_paren") then push(found, {line = t.line, text = join(parts, "\n")}) end
      end
    end
    i = i + 1
  end
  return found
end

function collect_zig(c)
  for p in sort(glob("src/**/*.zig")) do
    local source = "zig-tests"
    if has_item(PRELUDE_TESTS, p) then source = "prelude-tests" end
    for s in zig_sources(p) do add_input(c, source, p .. ":" .. s.line, s.text, nil) end
    yield()
  end
end

function collect_docs(c)
  for d in DOCS do
    local n = 0
    local body = nil
    local start = 0
    for l in lines(read(d)) do
      n = n + 1
      if body ~= nil then
        if l == "```" then
          add_input(c, "docs", d .. ":" .. start, join(body, "\n") .. "\n", nil)
          body = nil
        else
          push(body, l)
        end
      elseif l == "```shale" or l == "```shale-linux" then
        body = {}
        start = n
      end
    end
    if body ~= nil then fail("differ: " .. d .. ":" .. start .. ": a shale block with no closing fence") end
  end
end

function collect_cookbook(c)
  for p in sort(glob("cookbook/**/*.shale")) do
    local text = read(p)
    if contains(text, "arg(\"self_test\"") then
      c.n = c.n + 1
      local id = "i" .. sub("0000" .. c.n, -4)
      local rel = sub(p, #"cookbook/" + 1)
      push(c.inputs, {id = id, source = "cookbook", origin = p, text_path = p, steps = {{argv = {"cookbook:" .. rel, "self_test=1"}, stdin = ""}}, skip = skip_reason(text)})
    end
  end
end

-- web/lessons.js's cells, in order, each `{lesson, code}`: a cell's code is
-- a String.raw template, so its text is the bytes between the backticks.
function lesson_cells()
  local t = read("web/lessons.js")
  if contains(t, "${") or contains(t, "\\`") then fail("differ: web/lessons.js holds `${` or an escaped backtick, which the harness does not read") end
  local cells = {}
  local lesson = 0
  local at = 1
  while true do
    local title = find(t, "\n    title: \"", at)
    local code = find(t, "code: R`", at)
    if code == nil then break end
    if title ~= nil and title < code then
      lesson = lesson + 1
      at = title + 1
    else
      local from = code + #"code: R`"
      local to = find(t, "`", from)
      push(cells, {lesson = lesson, code = sub(t, from, to - 1)})
      at = to + 1
    end
  end
  return {cells = cells, lessons = lesson}
end

function collect_lessons(c)
  local got = lesson_cells()
  for n = 1, got.lessons do
    c.n = c.n + 1
    local id = "i" .. sub("0000" .. c.n, -4)
    local steps = {}
    local texts = {}
    local k = 0
    for cell in got.cells do
      if cell.lesson <= n then
        k = k + 1
        local f = INPUTS .. "/" .. id .. "-" .. k .. ".shale"
        create(f, cell.code)
        push(steps, {argv = {real(f)}, stdin = ""})
        push(texts, cell.code)
      end
    end
    local all = join(texts, "\n")
    local file = INPUTS .. "/" .. id .. ".shale"
    create(file, all)
    push(c.inputs, {id = id, source = "lessons", origin = "web/lessons.js: lessons 1-" .. n, text_path = file, steps = steps, skip = skip_reason(all)})
  end
end

-- A hand-written input's launch: its `-- differ-argv:` line (the words
-- after the binary, `{script}` the file's own path; none is `{script}`),
-- `-- differ-stdin:` (one line given on stdin) or `-- differ-stdin-self: 1`
-- (the file itself on stdin).
function hand_steps(p, text)
  local argv = {real(p)}
  local stdin = ""
  for l in lines(text) do
    if starts_with(l, "-- differ-argv:") then
      argv = {}
      for w in words(sub(l, #"-- differ-argv:" + 1)) do
        if w == "{script}" then push(argv, real(p)) else push(argv, w) end
      end
    elseif starts_with(l, "-- differ-stdin:") then
      stdin = trim_start(sub(l, #"-- differ-stdin:" + 1)) .. "\n"
    elseif starts_with(l, "-- differ-stdin-self: 1") then
      stdin = text
    end
  end
  return {{argv = argv, stdin = stdin}}
end

function collect_dir(c, dir, source)
  if not exists(dir) then return 0 end
  local n = 0
  for p in sort(glob(dir .. "/*.shale")) do
    local text = read(p)
    c.n = c.n + 1
    n = n + 1
    local id = "i" .. sub("0000" .. c.n, -4)
    push(c.inputs, {id = id, source = source, origin = p, text_path = p, steps = hand_steps(p, text), skip = skip_reason(text)})
  end
  return n
end

-- docs/SURFACE.txt, the frozen surface, is to give one stop script for each
-- stop template it lists, written under build:differ/surface and collected
-- as `stops`. Until its format is settled this says what is there.
function surface_status()
  if not exists("docs/SURFACE.txt") then return "docs/SURFACE.txt is not here yet: the stops are tools/differ/stops/ alone" end
  return "docs/SURFACE.txt is here, and no generator reads it yet: write `surface_stops` to fill build:differ/surface from it"
end

function collect()
  if exists(INPUTS) then remove_tree(INPUTS) end
  mkdir(INPUTS)
  local c = {inputs = {}, seen = {}, n = 0, dups = 0}
  collect_zig(c)
  collect_docs(c)
  collect_cookbook(c)
  collect_lessons(c)
  collect_dir(c, "tools/differ/stops", "stops")
  collect_dir(c, "build:differ/surface", "stops")
  collect_dir(c, "tools/differ/cli", "cli")
  return {inputs = c.inputs, dups = c.dups}
end

-- ── running ──

function reset_work(cfg)
  if exists(WORK) then remove_tree(WORK) end
  mkdir(WORK .. "/root")
  mkdir(WORK .. "/scratch")
end

-- One input under the binary at BIN, as `side`: each step's stdout, stderr
-- and ending under KEEP/<id>/<side>, then the tree the run left.
function launch(cfg, inp, side)
  reset_work(cfg)
  local dest = KEEP .. "/" .. inp.id .. "/" .. side
  if exists(dest) then remove_tree(dest) end
  mkdir(dest)
  local meta = {}
  local ms = 0
  local k = 0
  for step in inp.steps do
    k = k + 1
    replace(cfg.cap .. "/stdin", step.stdin)
    cfg.env.DIFFER_OUT = real(dest) .. "/" .. k .. ".out"
    cfg.env.DIFFER_ERR = real(dest) .. "/" .. k .. ".err"
    local argv = {"sh", "-c", WRAP, "differ", cfg.bin_real}
    for a in step.argv do push(argv, a) end
    local r = run(argv, {cwd = WORK .. "/root", timeout_ms = cfg.timeout_ms, tail = 5, env = cfg.env, want = "differ: the binary under test, its stdout and stderr kept apart"})
    ms = ms + r.ms
    push(meta, k .. "\t" .. r.ended .. "\t" .. tostring(get(r, "code", "")) .. "\t" .. tostring(get(r, "signal", "")))
  end
  -- What the run left running in its folder (a job's reaper, a program it
  -- started) is stopped, and counted: it is part of what the run did.
  local left = 0
  for p in procs() do
    if contains(p.args, cfg.work_real) then
      proc_stop(p)
      left = left + 1
    end
  end
  push(meta, "left\t" .. left)
  create(dest .. "/meta", join(meta, "\n") .. "\n")
  -- Most runs write nothing: two empty folders need no `find` and no move.
  -- A link the run made stops a walk, so a walk that stops is not empty.
  local wr = attempt(walk_all, WORK .. "/root", {})
  local ws = attempt(walk_all, WORK .. "/scratch", {})
  if wr.ok and ws.ok and #wr.value == 0 and #ws.value == 0 then
    create(dest .. "/manifest", "(nothing written)\n")
    return ms
  end
  local f = must(run({"find", ".", "-printf", "%P\t%y\t%m\t%s\t%l\n"}, {cwd = WORK, timeout_ms = 60000, whole = 16000000}))
  local entries = {}
  for l in lines(f.out) do
    if l ~= "" and not starts_with(l, "\t") then push(entries, l) end
  end
  create(dest .. "/manifest", join(sort(entries), "\n") .. "\n")
  must(run({"mv", cfg.work_real, real(dest) .. "/tree"}, {timeout_ms = 60000, tail = 5}))
  return ms
end

-- ── comparing ──

-- A stream as lines, the `── time:` line left out wherever it is. `judge` says
-- what else is let go for an input judged by class (`arena_observer`):
-- `class`, the `── used:` line's digits and a stop's `(N steps)`; `digits`,
-- every digit, for an input that reads `arena_bytes`.
function normal_lines(text, judge)
  local out = {}
  for l in lines(text) do
    if starts_with(l, "── time:") then
      -- Let go whole.
    elseif judge.digits and not starts_with(l, "── stopped at") then
      push(out, re_replace(l, "[0-9]+", "#"))
    elseif judge.class and starts_with(l, "── used:") then
      push(out, re_replace(l, "[0-9]+", "#"))
    elseif judge.class and starts_with(l, "── stopped at") then
      push(out, re_replace(l, "\\([0-9]+ steps\\)$", "(# steps)"))
    else
      push(out, l)
    end
  end
  return out
end

-- Nothing let go but the time line.
const EXACT = {class = false, digits = false}

function clip(s)
  local t = substitute(substitute(s, "\t", "\\t", {missing_ok = true}), "\r", "\\r", {missing_ok = true})
  if #t > 160 then return sub(t, 1, 157) .. "..." end
  return t
end

-- The first line two texts differ at, or nil.
function first_diff(a, b, judge)
  local la = normal_lines(a, judge)
  local lb = normal_lines(b, judge)
  local n = max(#la, #lb)
  for i = 1, n do
    local x = get(la, i, "(no line)")
    local y = get(lb, i, "(no line)")
    if x ~= y then return {line = i, a = x, b = y} end
  end
  -- Every line matched as judged, so only a final newline can differ (a
  -- difference let go is no difference).
  if ends_with(a, "\n") ~= ends_with(b, "\n") then
    -- Only a final newline differs.
    return {line = n, a = "(ends with a newline: " .. tostring(ends_with(a, "\n")) .. ")", b = "(ends with a newline: " .. tostring(ends_with(b, "\n")) .. ")"}
  end
  return nil
end

function side_dir(id, side)
  return KEEP .. "/" .. id .. "/" .. side
end

-- ── `fresh_dir`'s names ──
--
-- The Linux prelude's `fresh_dir(parent, prefix)` names a folder
-- `<prefix>.XXXXXX`, mktemp's six random characters from [A-Za-z0-9]
-- (src/shale_prelude_linux.shale). Before comparing, each such name is
-- masked as `<prefix>.<fresh N>`, N counting the names in the order they
-- first appear in one side's run (each step's stdout and stderr, then the
-- files' paths and bytes), so two folders stay two and the same folder is
-- the same placeholder throughout. Only the prefixes the input's own source
-- passes `fresh_dir` as string literals are masked.

-- A stream without its `── time:` lines, taken out before the names are
-- masked: a time line is printed only past a second in programs, and may
-- name a `fresh_dir` folder (a child run's slowest program), so a name it
-- showed first would move every later name's number on one side alone.
function without_time(s)
  if not contains(s, "── time:") then return s end
  local kept = {}
  for l in lines(s) do
    if not starts_with(l, "── time:") then push(kept, l) end
  end
  if #kept == 0 then return "" end
  local out = join(kept, "\n")
  if ends_with(s, "\n") then out = out .. "\n" end
  return out
end

-- The prefixes `text` passes `fresh_dir` as string literals.
function fresh_prefixes(text)
  local out = {}
  if not contains(text, "fresh_dir(") then return out end
  for m in re_find_all(text, "fresh_dir\\([^,()]*,\\s*\"([A-Za-z0-9_][A-Za-z0-9_-]*)\"\\)") do
    if not has_item(out, m.group) then push(out, m.group) end
  end
  return out
end

function fresh_map(prefixes)
  return {prefixes = prefixes, names = {}, order = {}, n = 0}
end

-- `s` with every `fresh_dir` name of `fm`'s prefixes masked, a new name
-- numbered as it is met.
function fresh_mask(s, fm)
  if #fm.prefixes == 0 then return s end
  for p in fm.prefixes do
    for m in re_find_all(s, "\\b" .. p .. "\\.[A-Za-z0-9]{6}\\b") do
      if not has_key(fm.names, m.text) then
        fm.n = fm.n + 1
        fm.names[m.text] = p .. ".<fresh " .. fm.n .. ">"
        push(fm.order, m.text)
      end
    end
  end
  local out = s
  for name in fm.order do out = substitute(out, name, fm.names[name], {missing_ok = true}) end
  return out
end

-- A side's manifest with its `fresh_dir` names masked, sorted again by the
-- masked line (a random name sorts anywhere among its neighbours): each
-- entry `{masked, path, kind}`, `path` the file's own.
function masked_manifest(d, fm)
  local out = {}
  for l in lines(read(d .. "/manifest")) do
    local f = split(l, "\t")
    push(out, {masked = fresh_mask(l, fm), path = f[1], kind = get(f, 2, "")})
  end
  sort(out, "masked")
  return out
end

-- ── git's index ──
--
-- git writes a repository's index (`.git/index`, and a linked worktree's
-- `.git/worktrees/<name>/index`) with a stat cache of each tracked file: its
-- ctime and mtime to the nanosecond, its device and inode, a size git zeroes
-- when the file is racily clean, and a checksum of the whole. None of that is
-- the script's, so two runs of one script never leave the same bytes there.
-- Such a file is compared by what it stages, `git ls-files --stage`: each
-- path's mode, object and stage. Every other file under `.git` is compared by
-- its bytes, the objects and refs among them, so a difference in a repo's
-- tracked content still shows: in the work tree's files, in the objects, or
-- in what the index stages.

function is_git_index(path)
  return re_find(path, "(?:^|/)\\.git/(?:worktrees/[^/]+/)?index$") ~= nil
end

-- What the index at `p` stages, or nil when git cannot read it (a file
-- named `index` that is not one), which is then compared by its bytes.
function git_index_view(p)
  local r = run({"git", "--git-dir", real(dirname(p)), "ls-files", "--stage"}, {timeout_ms = 60000, whole = 16000000, width = 8192})
  if r.ended ~= "exit" or r.code ~= 0 then return nil end
  return r.out
end

-- How one file the two trees both hold differs, or nil: `px` and `py` its
-- paths in each, `fx` and `fy` the sides' `fresh_dir` maps (nil: no names to
-- mask).
function differ_file(dx, dy, px, py, fx, fy)
  local a = dx .. "/tree/" .. px
  local b = dy .. "/tree/" .. py
  local label = px
  if fx ~= nil then label = fresh_mask(px, fx) end
  local ta = nil
  local tb = nil
  local how = ""
  if is_git_index(px) then
    ta = git_index_view(a)
    tb = git_index_view(b)
    how = " (what it stages)"
  end
  if ta == nil or tb == nil then
    ta = read(a)
    tb = read(b)
    how = ""
  end
  if fx ~= nil then
    ta = fresh_mask(ta, fx)
    tb = fresh_mask(tb, fy)
  end
  local d = first_diff(ta, tb, EXACT)
  if d ~= nil then return {what = "file " .. label .. how, where = "line " .. d.line, a = d.a, b = d.b} end
  if fx == nil and how == "" and ta ~= tb then return {what = "file " .. label, where = "", a = "(bytes)", b = "(bytes)"} end
  return nil
end

-- The files of two trees whose paths hold `fresh_dir` names, compared file
-- by file with the names masked: the masked manifests matched, so the n-th
-- file of one is the n-th of the other.
function differ_fresh_files(dx, dy, ex, ey, fx, fy)
  for i = 1, #ex do
    if ex[i].kind == "f" then
      local d = differ_file(dx, dy, ex[i].path, ey[i].path, fx, fy)
      if d ~= nil then return d end
    end
  end
  return nil
end

-- The masked lines of a masked manifest, as one text.
function manifest_text(entries)
  local l = {}
  for e in entries do push(l, e.masked) end
  return join(l, "\n") .. "\n"
end

-- How two sides of one input differ, or nil: the first difference, in the
-- order a step's ending, stdout, stderr, then the files. `judge` is
-- `normal_lines`'s.
function differ_sides(inp, x, y, judge)
  local dx = side_dir(inp.id, x)
  local dy = side_dir(inp.id, y)
  local mx = lines(read(dx .. "/meta"))
  local my = lines(read(dy .. "/meta"))
  local prefixes = fresh_prefixes(read(inp.text_path))
  local fx = fresh_map(prefixes)
  local fy = fresh_map(prefixes)
  for k = 1, #inp.steps do
    local s = ""
    if #inp.steps > 1 then s = " (step " .. k .. ")" end
    if mx[k] ~= my[k] then return {what = "exit" .. s, where = "", a = mx[k], b = my[k]} end
    for stream in {"out", "err"} do
      local d = first_diff(fresh_mask(without_time(read(dx .. "/" .. k .. "." .. stream)), fx), fresh_mask(without_time(read(dy .. "/" .. k .. "." .. stream)), fy), judge)
      if d ~= nil then
        local what = "std" .. stream
        if starts_with(d.a, "── used:") or starts_with(d.b, "── used:") then what = "used" end
        return {what = what .. s, where = "line " .. d.line, a = d.a, b = d.b}
      end
    end
  end
  local left = #inp.steps + 1
  if mx[left] ~= my[left] then return {what = "left running", where = "", a = mx[left], b = my[left]} end
  local ex = masked_manifest(dx, fx)
  local ey = masked_manifest(dy, fy)
  local man = first_diff(manifest_text(ex), manifest_text(ey), EXACT)
  if man ~= nil then return {what = "files", where = "entry " .. man.line, a = man.a, b = man.b} end
  if #grep(dx .. "/manifest", "\tf\t") == 0 then return nil end
  if fx.n > 0 or fy.n > 0 then return differ_fresh_files(dx, dy, ex, ey, fx, fy) end
  -- Each file whose bytes differ is judged in turn, since a git index whose
  -- bytes differ may stage the same.
  local r = run({"diff", "-rq", "--no-dereference", real(dx) .. "/tree", real(dy) .. "/tree"}, {timeout_ms = 120000, whole = 16000000, width = 8192})
  if r.code == 0 then return nil end
  for l in lines(r.out) do
    if l ~= "" then
      local m = re_find(l, "^Files (.*) and (.*) differ$")
      if m == nil then return {what = "files", where = "", a = l, b = ""} end
      local rel = sub(m.groups[1], #real(dx) + #"/tree/" + 1)
      local d = differ_file(dx, dy, rel, rel, nil, nil)
      if d ~= nil then return d end
    end
  end
  return nil
end

-- The builtin families, most specific first: the area a stdout difference
-- is laid at when nothing else names one.
const FAMILIES = {
  {name = "the host: programs and jobs", calls = {"run(", "must(", "job_start(", "job_wait(", "job_alive(", "job_stop(", "procs(", "report_run("}},
  {name = "the host: git", calls = {"git_"}},
  {name = "the host: Zig, Roc and Go trees", calls = {"zig_", "roc_tree(", "go_tree(", "shale_tokens("}},
  {name = "builtins: json", calls = {"json_read(", "json_write("}},
  {name = "builtins: regex", calls = {"re_find(", "re_match(", "re_replace(", "re_find_all(", "re_lines(", "regex ="}},
  {name = "builtins: store", calls = {"edit(", "replace(", "create(", "append(", "remove(", "mkdir(", "copy(", "read(", "grep(", "glob(", "walk(", "walk_all(", "stat(", "exists(", "count_lines(", "read_lines(", "grep_tree("}},
  {name = "builtins: format", calls = {"table(", "pad(", "human(", "date(", "seconds("}},
  {name = "builtins: text", calls = {"split(", "sub(", "find(", "trim(", "join(", "words(", "lines(", "substitute(", "upper(", "lower(", "like(", "between(", "rep("}},
  {name = "builtins: lists and maps", calls = {"sort(", "push(", "pop(", "keys(", "take(", "last(", "same(", "reverse(", "unique("}},
}

-- The area most likely responsible for a failure, from the class of the
-- stop that differs, else from what the input calls.
function area_of(inp, d, text)
  if inp.source == "cli" then return "the CLI" end
  for v in {d.a, d.b} do
    local m = re_find(v, "── stopped at [^ ]*: (\\w+)")
    if m ~= nil then
      local c = m.group
      if c == "syntax" or c == "refused" or c == "name" then return "the lexer and parser (" .. c .. ")" end
      if c == "type" or c == "index" or c == "arithmetic" then return "the VM (" .. c .. ")" end
      if c == "budget" then return "the VM (budgets)" end
      if c == "host" then return "the host" end
      return "builtins (a stop, " .. c .. ")"
    end
    if starts_with(v, "shale:") then return "the CLI" end
  end
  if starts_with(d.what, "used") then return "the VM (accounting: the used line)" end
  if starts_with(d.what, "exit") then return "the CLI (the exit)" end
  if starts_with(d.what, "file") then return "builtins: store (the files written)" end
  if starts_with(d.what, "left") then return "the host: programs and jobs" end
  for f in FAMILIES do
    for call in f.calls do
      if contains(text, call) then return f.name end
    end
  end
  return "the VM (output)"
end

-- Whether an input observes arena bytes: its oracle stops on the arena
-- budget, or its source reads `arena_bytes` (from `budget()`) outside a
-- comment, a `-- budget:` line among them. Such an input is judged by class.
function arena_observer(inp, text)
  local stop = false
  local d = side_dir(inp.id, "old_a")
  for k = 1, #inp.steps do
    if contains(read(d .. "/" .. k .. ".err") .. read(d .. "/" .. k .. ".out"), "budget arena") then stop = true end
  end
  local reads = false
  for l in lines(text) do
    if contains(l, "arena_bytes") and not starts_with(trim(l), "--") then reads = true end
  end
  return {stop = stop, reads = reads}
end

-- Whether the oracle's output holds `lit`.
function oracle_holds(inp, lit)
  local d = side_dir(inp.id, "old_a")
  for k = 1, #inp.steps do
    if contains(read(d .. "/" .. k .. ".out"), lit) or contains(read(d .. "/" .. k .. ".err"), lit) then return true end
  end
  return false
end

-- ── the run ──

function install(from, cfg)
  if not exists(from) then fail("differ: no binary at " .. from) end
  must(run({"cp", real(from), cfg.bin_real}, {timeout_ms = 60000, tail = 5}))
end

function replace_or_create(p, text)
  if exists(p) then replace(p, text) else create(p, text) end
end

local old = arg("old", "")
local new = arg("new", "")
local only = arg("only", "")
local predict = arg("predict", "")
local keep_all = arg("keep", 0)
local list_only = arg("list", 0)
local reuse = arg("reuse", 0)
if list_only == 0 and (old == "" or new == "") then fail("differ: name both binaries, old=<path> new=<path> (Shale paths)") end

-- Every run shares build:differ (its inputs, its work folder, its kept
-- trees), so a second run at once removes what the first is reading, and
-- both judge the wreck: another `shale` running a differ.shale stops this
-- one before it touches anything. (`procs` never lists this run or what
-- started it, so a plant that runs the differ is not one.)
for p in procs() do
  if p.name == "shale" and re_find(p.args, "(?:^| )[^ ]*tools/differ\\.shale(?: |$)") ~= nil then
    fail("differ: another differ is running, and the two would share build:differ: wait for it (pid " .. p.pid .. ": " .. p.args .. ")")
  end
end

local got = collect()
local inputs = {}
for inp in got.inputs do
  if only == "" or contains(inp.id, only) or contains(inp.origin, only) then push(inputs, inp) end
end
local by_source = {}
for inp in inputs do incr(by_source, inp.source) end
local src_rows = {}
for s in keys(by_source) do push(src_rows, {source = s, inputs = by_source[s]}) end
print("── " .. #inputs .. " inputs (" .. got.dups .. " repeated sources counted once)")
print(table(src_rows, {"source", "inputs"}))
print("── " .. surface_status())
if list_only == 1 then
  local l = {}
  for inp in inputs do push(l, join({inp.id, inp.source, inp.origin, #inp.steps .. " step(s)", inp.skip}, "\t")) end
  replace_or_create("build:differ/inputs.tsv", join(l, "\n") .. "\n")
  print("── the list: build:differ/inputs.tsv")
  return
end

mkdir(BIN)
mkdir("build:differ/cap")
mkdir("build:differ/home")
mkdir("build:differ/reports")
if reuse == 0 then
  if exists(KEEP) then remove_tree(KEEP) end
  mkdir(KEEP)
end
if exists("build:differ/pinned") then remove_tree("build:differ/pinned") end
copy("cookbook", "build:differ/pinned/cookbook")
replace_or_create("build:differ/gitconfig", "[user]\n\tname = Differ\n\temail = differ@example.org\n[init]\n\tdefaultBranch = master\n")
reset_work({})
local work_real = real(WORK)
local mounts = "cookbook = " .. real("build:differ/pinned/cookbook") .. " ro\n" .. "tools = " .. real("tools:") .. " ro tools\n" .. "scratch = " .. work_real .. "/scratch\n"
replace_or_create("build:differ/mounts", mounts)
replace_or_create("build:differ/cap/stdin", "")
local cfg = {
  cap = "build:differ/cap",
  bin_real = real(BIN) .. "/shale",
  work_real = work_real,
  timeout_ms = 300000,
  env = {
    SHALE_MOUNTS = real("build:differ/mounts"), SHALE_PRELUDE = "", SHALE_NOW = PINNED_NOW,
    SHALE_ROOT = work_real .. "/root", HOME = real("build:differ/home"),
    PATH = real(BIN) .. ":/usr/local/bin:/usr/bin:/bin", TZ = "UTC", LC_ALL = "C",
    GIT_CEILING_DIRECTORIES = real("build:differ"), GIT_CONFIG_NOSYSTEM = "1", GIT_CONFIG_GLOBAL = real("build:differ/gitconfig"),
    GIT_AUTHOR_DATE = PINNED_GIT_DATE, GIT_COMMITTER_DATE = PINNED_GIT_DATE,
    DIFFER_IN = real("build:differ/cap/stdin"), DIFFER_OUT = "", DIFFER_ERR = "",
  },
}

-- The wall clock, which `now()` is not: the whole run's time is reported.
function clock()
  return tonumber(trim(must(run({"date", "+%s"}, {timeout_ms = 5000, tail = 1})).out))
end

local started = clock()
local phase_ms = {old_a = 0, old_b = 0, new = 0}
local per_ms = {}
local phases = {{side = "old_a", bin = old}, {side = "old_b", bin = old}, {side = "new", bin = new}}
if reuse == 1 then phases = {} end
for phase in phases do
  install(phase.bin, cfg)
  local t = 0
  for inp in inputs do
    if inp.skip == "" then
      local ms = launch(cfg, inp, phase.side)
      t = t + ms
      per_ms[inp.id .. " " .. phase.side] = ms
    end
    yield()
  end
  phase_ms[phase.side] = t
  print("── " .. phase.side .. ": " .. t .. " ms in the binary's runs")
end

-- A failure is confirmed by a third run of the oracle before it counts: two
-- runs that agree by chance (a race with a 10 ms deadline) are not yet a
-- deterministic oracle.
install(old, cfg)
local rows = {}
local counts = {pass = 0, fail = 0, nondet = 0, skipped = 0}
local by_area = {}
local nondet = {}
local skipped = {}
local arena = {stop = 0, reads = 0, either = 0, stop_ids = {}, read_ids = {}}
local pred = {hit = 0, missed = 0, extra = 0}
local extra_ids = {}
local missed_ids = {}
for inp in inputs do
  local row = {id = inp.id, source = inp.source, origin = inp.origin, verdict = "", arena = "", area = "", what = "", where = "", old = "", new = ""}
  if inp.skip ~= "" then
    row.verdict = "skipped"
    row.what = inp.skip
    push(skipped, inp.id .. " " .. inp.origin .. ": " .. inp.skip)
  else
    local text = read(inp.text_path)
    local ao = arena_observer(inp, text)
    if ao.stop then
      arena.stop = arena.stop + 1
      row.arena = "stop"
      push(arena.stop_ids, inp.id .. " " .. inp.origin)
    end
    if ao.reads then
      arena.reads = arena.reads + 1
      row.arena = row.arena .. " reads"
      push(arena.read_ids, inp.id .. " " .. inp.origin)
    end
    row.arena = trim(row.arena)
    if ao.stop or ao.reads then arena.either = arena.either + 1 end
    local judge = {class = ao.stop or ao.reads, digits = ao.reads}
    local twice = differ_sides(inp, "old_a", "old_b", judge)
    local d = nil
    if twice == nil then
      d = differ_sides(inp, "old_a", "new", judge)
      if d ~= nil then
        launch(cfg, inp, "old_c")
        local third = differ_sides(inp, "old_a", "old_c", judge)
        if third ~= nil then
          twice = third
          twice.what = twice.what .. " (on a third run)"
        end
      end
    end
    if twice ~= nil then
      row.verdict = "nondet"
      row.what = twice.what
      row.where = twice.where
      row.old = clip(twice.a)
      row.new = clip(twice.b)
      push(nondet, inp.id .. " " .. inp.origin .. ": " .. twice.what .. " " .. twice.where .. ": `" .. clip(twice.a) .. "` then `" .. clip(twice.b) .. "`")
    else
      if d == nil then
        row.verdict = "pass"
      else
        row.verdict = "fail"
        row.area = area_of(inp, d, text)
        row.what = d.what
        row.where = d.where
        row.old = clip(d.a)
        row.new = clip(d.b)
        push_at(by_area, row.area, row)
      end
      if predict ~= "" then
        local p = oracle_holds(inp, predict)
        if p and d ~= nil then pred.hit = pred.hit + 1 end
        if p and d == nil then
          pred.missed = pred.missed + 1
          push(missed_ids, inp.id .. " " .. inp.origin)
        end
        if not p and d ~= nil then
          pred.extra = pred.extra + 1
          push(extra_ids, inp.id .. " " .. inp.origin)
        end
      end
    end
    if keep_all == 0 and reuse == 0 and row.verdict == "pass" then remove_tree(KEEP .. "/" .. inp.id) end
  end
  counts[row.verdict] = counts[row.verdict] + 1
  push(rows, row)
  yield()
end

-- The TSV: a row an input.
const COLUMNS = {"id", "source", "origin", "verdict", "arena", "area", "what", "where", "old", "new"}
local stamp = substitute(substitute(date(now()), ":", ""), "-", "")
local tsv = "build:differ/reports/" .. stamp .. ".tsv"
local body = {"# differ: old " .. old .. ", new " .. new, join(COLUMNS, "\t")}
for row in rows do
  local f = {}
  for c in COLUMNS do push(f, substitute(tostring(row[c]), "\t", " ", {missing_ok = true})) end
  push(body, join(f, "\t"))
end
create(tsv, join(body, "\n") .. "\n")

print("")
print("── failures by the area most likely responsible")
if counts.fail == 0 then print("  none") end
for a in sort(keys(by_area)) do
  print(a .. ": " .. #by_area[a])
  for row in take(by_area[a], 8) do
    print("  " .. row.id .. " " .. row.origin .. ": " .. row.what .. " " .. row.where)
    print("      old: " .. row.old)
    print("      new: " .. row.new)
  end
  if #by_area[a] > 8 then print("  ... and " .. (#by_area[a] - 8) .. " more (the TSV)") end
end
if #nondet > 0 then
  print("")
  print("── nondeterministic under the oracle alone (a finding of the harness; not judged): " .. #nondet)
  for l in nondet do print("  " .. l) end
end
if #skipped > 0 then
  print("")
  print("── skipped, each for what it reaches: " .. #skipped)
  for l in skipped do print("  " .. l) end
end
if predict ~= "" then
  print("")
  print("── predicted by `" .. predict .. "` in the oracle's output: " .. pred.hit .. " failed as predicted, " .. pred.missed .. " predicted and passed, " .. pred.extra .. " failed unpredicted")
  for l in take(missed_ids, 10) do print("  predicted, passed: " .. l) end
  for l in take(extra_ids, 10) do print("  failed, unpredicted: " .. l) end
end
print("")
print("── judged by class (arena bytes are outside the surface; their numbers let go): " .. arena.either .. " inputs, " .. arena.stop .. " stopping on the arena budget, " .. arena.reads .. " reading `arena_bytes`")
for l in arena.stop_ids do print("  arena stop: " .. l) end
for l in arena.read_ids do print("  reads arena_bytes: " .. l) end
print("── wall: " .. (clock() - started) .. " s in all; in the binaries' runs, old " .. phase_ms.old_a .. " + " .. phase_ms.old_b .. " ms, new " .. phase_ms.new .. " ms")
print("── " .. tsv)
print("── " .. #inputs .. " inputs: " .. counts.pass .. " pass, " .. counts.fail .. " fail, " .. counts.nondet .. " nondeterministic, " .. counts.skipped .. " skipped")
if counts.fail > 0 then fail("differ: " .. counts.fail .. " inputs differ from the oracle") end
