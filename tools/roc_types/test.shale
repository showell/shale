-- roc-types held to its fixtures, the apps in tools/roc_types/tests, each
-- run once and judged by its exit, the modules it writes and a few of its
-- records. Run from Shale's checkout:
--   shale tools/roc_types/test.shale
--   shale tools/roc_types/test.shale exe=scratch:roc-types-build/bin/roc-types
-- Without `exe=` it runs the roc-types installed for this tree's pin
-- (`tools:roc-types-<pin>/bin/roc-types`, else `tools:roc-types/bin/roc-types`);
-- `exe=` names another, such as a roc-types workflow run's artifact before it
-- is published. The fixtures:
--   nested  an app whose package `outer` has a package of its own, `inner`,
--           which the app's header does not name. `roc check` resolves it,
--           so roc-types must too, and write inner's module;
--   broken  the same with a type error in `inner`: refused, no module
--           written, the report naming inner's module;
--   echo    an app that names no platform, so it runs on the Echo platform
--           and `echo!` is in scope: checked, and its call of `echo!` typed;
--   notapp  a type module given as the root: refused as not an app.
-- The roc-types workflow's Fixtures step runs the first three on every
-- build, by their exits and modules alone.

const EXE = arg("exe", "")
const TESTS = "tools/roc_types/tests"

function default_exe()
  local pin = trim(read("tools/roc_types/roc-version"))
  local own = "tools:roc-types-" .. pin .. "/bin/roc-types"
  if exists(own) then return own end
  return "tools:roc-types/bin/roc-types"
end

-- The `== <path>` lines of a run's output, each path's end below the
-- checkout (`tools/roc_types/tests/...`), and its `t` records by module.
function modules_of(out)
  local got = {paths = {}, records = {}}
  local path = ""
  for l in lines(out) do
    if starts_with(l, "== ") then
      local at = find(l, "/" .. TESTS .. "/")
      path = at == nil and sub(l, 4) or sub(l, at + 1)
      push(got.paths, path)
      got.records[path] = {}
    elseif starts_with(l, "t\t") and path ~= "" then
      push(got.records[path], sub(l, 3))
    end
  end
  return got
end

-- One fixture's run judged against `want`: `ok` (whether it exits 0),
-- `modules` (paths it must write), `says` (literals its output must hold)
-- and `records` (`{module, record}`, a record line without its `t\t`).
function judge(exe, name, root, want, failures)
  local r = run({real(exe), root}, {timeout_ms = 120000, whole = 16000000})
  local got = modules_of(r.out)
  local wrong = {}
  local ok = r.ended == "exit" and r.code == 0
  if ok ~= want.ok then push(wrong, "exited " .. (r.ended == "exit" and r.code or r.ended) .. ", want " .. (want.ok and "0" or "a failure")) end
  if not want.ok and #got.paths > 0 then push(wrong, #got.paths .. " module(s) written by a run that was to write none") end
  for m in get(want, "modules", {}) do
    if not has_item(got.paths, m) then push(wrong, "no module " .. m .. " (wrote " .. join(got.paths, ", ") .. ")") end
  end
  for s in get(want, "says", {}) do
    if not contains(r.out, s) then push(wrong, "the output doesn't say `" .. s .. "`") end
  end
  for rec in get(want, "records", {}) do
    if not has_key(got.records, rec.module) or not has_item(got.records[rec.module], rec.record) then push(wrong, "no record `" .. rec.record .. "` in " .. rec.module) end
  end
  if #wrong == 0 then
    print("ok    " .. name)
  else
    for w in wrong do print("FAIL  " .. name .. ": " .. w) end
    local said = slice(lines(r.out), 1, 12)
    for l in said do print("        " .. l) end
    failures.count = failures.count + 1
  end
  return nil
end

local exe = EXE ~= "" and EXE or default_exe()
if not exists(exe) then fail("roc-types test: no " .. exe .. ": `shale tools/roc_types/install.shale` installs it, or give exe=") end
print("roc-types test: " .. exe)
local failures = {count = 0}
judge(exe, "nested", TESTS .. "/nested/app/main.roc", {ok = true,
  modules = {TESTS .. "/nested/app/main.roc", TESTS .. "/nested/outer/Outer.roc", TESTS .. "/nested/inner/Inner.roc"},
  records = {
    {module = TESTS .. "/nested/outer/Outer.roc", record = "expr\te_lookup_external\t7\t17\t7\t28\tStr -> Str"},
    {module = TESTS .. "/nested/inner/Inner.roc", record = "pat\tassign\t4\t2\t4\t7\tStr -> Str"},
  }}, failures)
judge(exe, "broken", TESTS .. "/broken/app/main.roc", {ok = false,
  says = {TESTS .. "/broken/inner/Inner.roc", "no module written"}}, failures)
judge(exe, "echo", TESTS .. "/echo/main.roc", {ok = true,
  modules = {TESTS .. "/echo/main.roc"},
  records = {
    {module = TESTS .. "/echo/main.roc", record = "expr\te_lookup_local\t6\t2\t6\t7\tStr => {}"},
    {module = TESTS .. "/echo/main.roc", record = "expr\te_call\t6\t2\t6\t37\t{}"},
  }}, failures)
judge(exe, "notapp", TESTS .. "/nested/inner/Inner.roc", {ok = false,
  says = {"is not an app (NotAnAppHeader)"}}, failures)
if failures.count > 0 then fail("roc-types test: " .. failures.count .. " of 4 fixtures failed") end
print("roc-types test: 4 fixtures as they say")
