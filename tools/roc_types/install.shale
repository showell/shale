-- **ROC-TYPES, DOWNLOADED AND INSTALLED** where Shale may run it
-- (~/tools/roc-types-<roc-version>/bin/roc-types, under the `tools` mount,
-- beside the checkers of other pins, as cookbook/roc/types.shale looks for
-- a tree's own; the unpinned ~/tools/roc-types is left alone). The checker is
-- roc-lang/roc's at the commit roc-version names, linked whole: building it
-- takes more than the box holds beside its other work, so it is built on
-- GitHub and installed from its published asset, never built here. The
-- asset's URL and sha256 are tools/roc_types/release, CI's too; the
-- download is held to the sha256 before anything is unpacked. Run from
-- Shale's checkout:
--   shale tools/roc_types/install.shale
--
-- **A NEW PIN OR FORMAT IS A NEW ASSET**: run the roc-types workflow
-- (`gh workflow run roc-types.yml -f ref=<ref>`), which builds it static
-- for a baseline CPU and tars `bin/roc-types` as
-- `roc-types-<N>-<pin>-linux-x86_64.tar.gz`, printing its sha256; upload
-- it under that new name (a published asset never changes) and put its URL
-- and sha256 in tools/roc_types/release.

const RELEASE = "tools/roc_types/release"

local version = trim(read("tools/roc_types/roc-version"))
local parts = split(version, "-")
local short = parts[#parts]

local url = ""
local sha = ""
for l in lines(read(RELEASE)) do
  if starts_with(l, "url ") then url = trim(sub(l, 5)) end
  if starts_with(l, "sha256 ") then sha = trim(sub(l, 8)) end
end
if url == "" or sha == "" then fail("roc-types: " .. RELEASE .. " lacks its `url` or `sha256` line") end
if starts_with(url, "TODO") or starts_with(sha, "TODO") then
  fail("roc-types: " .. RELEASE .. " holds a placeholder: publish the roc-types workflow's asset and put its URL and sha256 there")
end
if find(url, "-" .. short .. "-") == nil then
  fail("roc-types: roc-version pins Roc " .. short .. ", and " .. RELEASE .. "'s asset is not that pin's (" .. url .. "): publish the pin's asset")
end

local home = "tools:roc-types-" .. version
if not exists(home) then mkdir(home) end
local dir = fresh_dir(home, "download")
local tarball = real(dir) .. "/roc-types.tar.gz"
must(run({"curl", "-fsSL", "-o", tarball, url}, {timeout_ms = 600000, tail = 20}))
local summed = must(run({"sha256sum", tarball}, {timeout_ms = 60000, tail = 2}))
local got = words(summed.out)[1]
if got ~= sha then
  remove_tree(dir)
  fail("roc-types: the download's sha256 is " .. got .. ", not " .. RELEASE .. "'s " .. sha .. "; nothing installed")
end
must(run({"tar", "-xzf", tarball, "-C", real(home)}, {timeout_ms = 60000, tail = 20}))
remove_tree(dir)
local exe = home .. "/bin/roc-types"
if not exists(exe) then fail("roc-types: the asset held no bin/roc-types; nothing installed at " .. real(home) .. "/bin/roc-types") end
-- The checker has no --version: its first line on the workflow's smoke
-- plant is its header, `roc-types <N> <roc-version>`.
local said = must(run({real(exe), "cookbook/roc/plants/methods/TypedApp.roc"}, {timeout_ms = 60000, head = 1}))
local head = trim(split(said.out, "\n")[1])
local head_words = words(head)
if #head_words ~= 3 or head_words[1] ~= "roc-types" or head_words[3] ~= version then fail("roc-types: installed at " .. real(exe) .. ", and its header on TypedApp.roc is `" .. head .. "`, not Roc " .. version .. "'s") end
print("roc-types: Roc " .. short .. "'s checker, installed at " .. real(exe) .. " (" .. head .. ")")
