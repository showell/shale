-- One call of each store builtin, run whole and then under a budget at
-- every reads and changes value its run passes and every 25 steps, so each
-- run stops at another call: an input for each `-- differ-argv:` line.
-- differ-before: fixture/setup.shale
print(#walk(""))
print(#grep("a.txt", "o"))
print(#read_lines("crlf.txt").lines)
print(line_at("a.txt", 5))
print(count_lines("a.txt"), count_in("a.txt", "o"))
create("g", "aaa\nbbb\nccc\n")
print(edit("g", {{old = "bbb", new = "B\nB"}, {old = "a", new = "x", all = true}}))
print(#ls("d"), stat("d/x").size, exists("d/y"), is_dir("d/y"))
print(read_or("nope", "dflt"), read("a.txt", 2, 3))
append("g", "more\n")
mkdir("h/i")
remove("g")
remove_tree("h")
print(host("edits_write", {{"a.txt", {{old = "one", new = "1"}}}}))

