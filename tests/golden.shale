-- tests/golden.shale: Shale's golden tests, the one judge of its behaviour:
-- every input the harness collects, frozen with the output a C `shale` gave
-- it, so a binary is held to that output byte for byte.
--
--   cd <shale> && shale tests/golden.shale [bin=<path>]
--   cd <shale> && shale tests/golden.shale freeze=1 [refreeze=<id>,<id>]
--
-- The cookbook's self-tests are not among them: the C full tier runs them
-- live (c/build.shale, `cookbook_self_tests`).
--
-- **The run** (tests/harness/run.shale) runs every case of
-- tests/golden/manifest.tsv under `bin` (a Shale path; c/out/release/shale,
-- the C build under test, unset), masks it, and prints each case that fails
-- with its first differing line, then the count. The arguments:
--   bin    the binary under test;
--   base   the work folder (unset, this checkout's own: `checkout_base`
--          below), the run's own folder padded below it to a fixed length
--          (`padded_base`), so step counts that hang on its path's length
--          are the same on every box;
--   dir    the goldens (tests/golden unset);
--   only   run only the cases whose id or origin holds this literal;
--   keep   1: keep every case's run under `base`/keep (0: only the failures').
--
-- **The freeze** (`freeze=1`, tests/harness/freeze.shale) rebuilds the
-- goldens from `bin` and writes them only when no case's expected output
-- changed or went, but those `refreeze=` names: a re-freeze is a deliberate
-- act, a case at a time, and its commit says why for each case. Its
-- arguments:
--   bin       the binary whose output is frozen (c/out/release/shale, the
--             C build, unset);
--   base      its work folder (this checkout's own unset, as the run's);
--   dir       where the goldens go (tests/golden unset);
--   only      freeze only the inputs whose origin holds this literal (a
--             trial, into another `dir`);
--   refreeze  the ids, by commas, whose change or loss is meant.
--
-- tests/harness/README.md has the inputs, the layout of a case and the
-- masks.
--
-- **This file launches the body**: a library is read through a mount, so
-- this writes a mounts file naming this checkout's tests/harness as
-- `harness`, beside the `build`, `tools` and `scratch` mounts it
-- was given, and runs the body under it.
--
-- **The body runs under umask 002**, the box's, whatever the caller's: the
-- goldens freeze each file's mode, and a 022 (GitHub's runner, most
-- machines) makes a folder 755 where the frozen one is 775. The body
-- inherits it, and so does each case it starts, the harness's own folders
-- and copies included, so the run and the freeze both have it from here.
-- Shale has no `umask` call, so a `sh` sets it and `exec`s the body.
--
-- budget: programs=10 output_bytes=8000000

const RUN_ARGS = {"bin", "base", "dir", "only", "keep"}

-- The umask every golden run is made under, set before the body starts.
const UMASK_WRAP = [=[umask 0002 && exec "$@"]=]
const FREEZE_ARGS = {"bin", "base", "dir", "only", "refreeze"}

-- The mounts the body may want, by the words each gets.
const PASSED_MOUNTS = {{name = "build", words = ""}, {name = "tools", words = " ro tools"}, {name = "scratch", words = ""}}

-- The default `base`: a folder of this checkout's own under `build:golden`,
-- named by the checkout's folder and the first 8 hex digits of its real
-- path's SHA-256, so two checkouts' golden runs (two lanes' full tiers at
-- once) never share a work folder. Its real path stays far below the 158
-- bytes `padded_base` allows.
function checkout_base()
  local root = real(".")
  local h = sub(trim(must(run({"sha256sum"}, {stdin = root, timeout_ms = 10000, tail = 1})).out), 1, 8)
  local name = re_replace(basename(root), "[^A-Za-z0-9_-]", "-")
  if #name > 32 then name = sub(name, 1, 32) end
  return "build:golden/" .. name .. "-" .. h
end

local freeze = arg("freeze", 0) == 1
local body = "tests/harness/run.shale"
local names = RUN_ARGS
if freeze then
  body = "tests/harness/freeze.shale"
  names = FREEZE_ARGS
end
local text = "harness = " .. real("tests/harness") .. " ro\n"
for m in PASSED_MOUNTS do
  local r = attempt(real, m.name .. ":.")
  if r.ok then text = text .. m.name .. " = " .. r.value .. m.words .. "\n" end
end
mkdir("c/out")
local mounts = "c/out/golden.mounts"
if exists(mounts) then replace(mounts, text) else create(mounts, text) end
local argv = {"sh", "-c", UMASK_WRAP, "golden", "shale", body}
for n in names do
  local v = arg(n, "")
  if n == "base" and v == "" then v = checkout_base() end
  if v ~= "" then push(argv, n .. "=" .. v) end
end
local r = run(argv, {timeout_ms = 14400000, tail = 100000, env = {SHALE_MOUNTS = real(mounts)}, not_re = "^── budgets from the script's header", want = "golden: the body under the goldens' umask, 002"})
print(trim(r.out))
if get(r, "code", -1) ~= 0 then fail("golden: " .. body .. " ended " .. r.ended .. " " .. tostring(get(r, "code", ""))) end
