-- roc_platform/self_test.shale: the platform's policy proofs, end to end,
-- with the pinned Roc: examples/escape.roc tried each way, each reach held to
-- Shale's own stop, and the ones that pass (a missing file as a value, a
-- program Shale lets through, a loop inside its budget) held to their
-- output; then count_lines.roc. It builds the host's object the first time
-- (about 40 s of gcc), so it runs when a Roc build is asked for, never in the
-- tiers (c/docs/builtin-table.md, "What runs where").
--
-- The three ways a Roc script was worse at failing than a Shale one, each a
-- plant and a near miss:
--   - the Roc's own computation has a budget: `try=loop`, a pure loop that
--     never ends, stops as `budget cpu` at its own line in escape.roc;
--     `try=spin`, a loop inside the budget, ends;
--   - a stop names the Roc's line: `try=climb`'s refused read names
--     escape.roc's line and column of its `Shale.read!` call, found in the
--     file here, so an edit there moves the plant with it;
--   - a value no `Shale.arg!` reads is refused: count_lines.roc given
--     `fiel=` stops before anything is built, naming `file`; given `file=`,
--     it runs.
--
-- Run from the shale checkout's root: shale roc_platform/self_test.shale
-- (`shale=c/out/tcc/shale` runs the launcher with a lane's own build, before
-- it is installed: the launcher reads its values with `arg_names()`).
-- budget: programs=40

const SHALE = arg("shale", "shale")
const ESCAPE = "roc_platform/examples/escape.roc"

-- `ESCAPE`'s line and column of `text`'s first character, as a stop names
-- them (`25:8`).
function place_of(text)
  for m in grep(ESCAPE, text) do return m.line .. ":" .. find(m.text, text) end
  fail("self_test: " .. ESCAPE .. " has no `" .. text .. "`: re-aim the plant")
end

-- Each try, and the literals its output must hold. A stop's is Shale's own
-- class and words.
const TRIES = {
  {try = "climb", stops = true, holds = {"── stopped at " .. ESCAPE .. ":" .. place_of("Shale.read!(\"../outside.txt\")") .. " (in `Shale.read!`): argument: `exists`: \"../outside.txt\" climbs out of the root"}},
  {try = "absolute", stops = true, holds = {"argument: `exists`: \"/etc/passwd\" is absolute"}},
  {try = "bash", stops = true, holds = {"refused: `run` of `bash`: a shell or an interpreter"}},
  {try = "write", stops = true, holds = {"argument: `replace`: \"../escaped.txt\" climbs out of the root"}},
  {try = "crash", stops = true, holds = {"the Roc crashed: a promise the script broke"}},
  {try = "arena", stops = true, holds = {"budget arena: the arena budget ran out"}},
  {try = "loop", stops = true, holds = {"── stopped at " .. ESCAPE .. ":", "budget cpu: the Roc's CPU time is past its budget (400 ms)", "of 400 Roc CPU ms"}},
  {try = "spin", stops = false, holds = {"spun 200000 times, inside the budget"}},
  {try = "missing", stops = false, holds = {"Missing, as a value: the script goes on"}},
  {try = "ok", stops = false, holds = {"git ran, exit 0: git version"}},
}

function launch(args)
  local argv = {SHALE, "roc_platform/run.shale"}
  for a in args do push(argv, a) end
  local opts = {timeout_ms = 600000, tail = 40}
  if SHALE ~= "shale" then opts.want = "lane: a lane's own shale, before it is installed" end
  return run(argv, opts)
end

-- What is wrong with `r`, held to stopping or not and to `holds`; "" for
-- nothing.
function judged(name, r, stops, holds)
  local stopped = get(r, "code", -1) ~= 0
  local said = trim(r.out)
  local wanted = "exit 0"
  if stops then wanted = "a stop" end
  if stopped ~= stops or contains(said, "did NOT hold") then return name .. ": exit " .. get(r, "code", -1) .. ", wanted " .. wanted .. "; it said:\n" .. said end
  for h in holds do
    if not contains(said, h) then return name .. ": it does not say `" .. h .. "`; it said:\n" .. said end
  end
  return ""
end

function held(bad, name, r, stops, holds)
  local why = judged(name, r, stops, holds)
  if why ~= "" then push(bad, why) else print("ok   " .. name .. ": " .. holds[1]) end
  return nil
end

local bad = {}
for t in TRIES do held(bad, "try=" .. t.try, launch({"script=" .. ESCAPE, "try=" .. t.try}), t.stops, t.holds) end
held(bad, "count_lines.roc fiel=", launch({"script=roc_platform/examples/count_lines.roc", "fiel=roc_platform/README.md"}), true, {"`fiel=` is given, and roc_platform/examples/count_lines.roc reads no `Shale.arg!(\"fiel\", ...)`: it reads file"})
held(bad, "count_lines.roc file=", launch({"script=roc_platform/examples/count_lines.roc", "file=roc_platform/README.md"}), false, {"roc_platform/README.md: "})
for b in bad do print("FAIL " .. b) end
if #bad > 0 then fail("roc_platform self-test: " .. #bad .. " failed") end
print("roc_platform self-test: " .. (#TRIES + 2) .. " runs held")
