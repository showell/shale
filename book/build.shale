-- budget: steps=60000000 output_bytes=100000
-- This builds the Shale book into the dev channel, one page a chapter.
--
--   cd <shale checkout> && shale book/build.shale
--
-- book.md is the whole book. Its `#` line is the title, the text under it is
-- the contents page's, and each `##` heading starts a chapter. A line that is
-- exactly `{{file PATH}}` or `{{file PATH:FIRST-LAST}}` becomes that file, or
-- those lines of it, as a code block, so every script the book quotes is the
-- script as it stands. `{{function PATH NAME}}` is one top-level function,
-- with the comment right above it. `{{lines PATH from "TEXT" to "TEXT"}}` is
-- the lines from the one holding the first text through the one holding the
-- second; each text must occur in the file exactly once, so the quote can't
-- drift the way a line range can. A path through a mount
-- (`repos:roc-apps/...`) reaches another checkout. `{{show REPO REV:PATH}}`
-- is a whole file as commit REV had it, for a script since changed or gone. Each block gets a caption
-- naming where it comes from.
--
-- The build is also the book's first gate. It stops on an include that names
-- no file or runs past its end, on any `{{` left over, and on a chapter over
-- MAX_PROSE_WORDS words of prose. The essay surface's roc-markdown renderer
-- draws each page.
-- `source=` builds another file, such as one chapter's draft, and `stage=`
-- puts it in its own folder of the channel, so a draft never replaces the book.
const SOURCE = arg("source", "book/book.md")
const STAGE = arg("stage", "shale-book")
const CSS = "book/book.css"
const DEST = "build:roc-apps/next/" .. STAGE
const URL = "http://143.244.172.148:9210/" .. STAGE .. "/"
const RENDER = "repos:essay-repl-server/bin/render_note"
const RENDER_WANT = "renderer: the essay surface's roc-markdown renderer draws the book's pages"
const MAX_PROSE_WORDS = 900
const FENCE = "```"

-- The lines of a text, without the empty one after its last newline.
function text_lines(text)
  local ls = lines(text)
  if #ls > 0 and ls[#ls] == "" then return take(ls, #ls - 1) end
  return ls
end

-- A path as the reader sees it, without the mount that reaches it.
function shown_path(path)
  if starts_with(path, "repos:") then return sub(path, 7) end
  return path
end

-- A fence's language, from the file's extension; Shale's unless named here.
const FENCE_TAGS = {roc = "roc", go = "go", zig = "zig", js = "javascript", css = "css", md = "markdown", json = "json", txt = "text", jsonl = "json"}

function fenced(path, ls)
  local tag = "shale"
  local m = re_find(path, "\\.(\\w+)$")
  if m ~= nil and has_key(FENCE_TAGS, m.group) then tag = FENCE_TAGS[m.group] end
  return FENCE .. tag .. "\n" .. join(ls, "\n") .. "\n" .. FENCE
end


-- One include, as the code block that takes its place.
function quoted(spec)
  local path = spec
  local first = 0
  local last = 0
  local m = re_find(spec, "^(.*):(\\d+)-(\\d+)$")
  if m ~= nil then
    path = m.groups[1]
    first = parse_int(m.groups[2])
    last = parse_int(m.groups[3])
  end
  if not exists(path) then fail("book: {{file " .. spec .. "}} names no file") end
  local ls = text_lines(read(path))
  if first == 0 then
    first = 1
    last = #ls
  end
  if first < 1 or first > last or last > #ls then
    fail("book: {{file " .. spec .. "}} runs past the file's " .. #ls .. " lines")
  end
  local where = shown_path(path) .. ", lines " .. first .. " to " .. last
  if first == 1 and last == #ls then where = shown_path(path) .. ", the whole file" end
  return "*" .. where .. "*\n\n" .. fenced(path, slice(ls, first, last))
end

-- One top-level function, with the comment lines right above it, through the
-- first `end` at the start of a line.
function function_of(path, name)
  if not exists(path) then fail("book: {{function " .. path .. " " .. name .. "}} names no file") end
  local ls = text_lines(read(path))
  local start = 0
  local i = 0
  for l in ls do
    i = i + 1
    if start == 0 and starts_with(l, "function " .. name .. "(") then start = i end
  end
  if start == 0 then fail("book: " .. path .. " has no top-level function " .. name) end
  local first = start
  while first > 1 and starts_with(ls[first - 1], "--") do first = first - 1 end
  local last = start
  while last <= #ls and ls[last] ~= "end" do last = last + 1 end
  if last > #ls then fail("book: " .. name .. " in " .. path .. " has no `end` at the start of a line") end
  return "*" .. shown_path(path) .. ", the function " .. name .. "*\n\n" .. fenced(path, slice(ls, first, last))
end

-- The number of the one line of `ls` that holds `anchor`, which must occur
-- exactly once, so an edit that removes or repeats it stops the build.
function anchored_line(ls, anchor, path)
  local at = 0
  local seen = 0
  local i = 0
  for l in ls do
    i = i + 1
    if contains(l, anchor) then
      seen = seen + 1
      at = i
    end
  end
  if seen ~= 1 then fail("book: `" .. anchor .. "` is in " .. path .. " " .. seen .. " times, and an anchor must be there once") end
  return at
end

-- The lines of `ls` from the one holding the first anchor through the one
-- holding the second.
function anchored_span(ls, from, to, where)
  local first = anchored_line(ls, from, where)
  local last = anchored_line(ls, to, where)
  if last < first then fail("book: in " .. where .. ", `" .. to .. "` comes before `" .. from .. "`") end
  return slice(ls, first, last)
end

function between_anchors(path, from, to)
  if not exists(path) then fail("book: {{lines " .. path .. " ...}} names no file") end
  return "*" .. shown_path(path) .. "*\n\n" .. fenced(path, anchored_span(text_lines(read(path)), from, to, path))
end

-- A file of prose, a prompt, as a block quote under its caption.
function quote_of(path)
  if not exists(path) then fail("book: {{quote " .. path .. "}} names no file") end
  local out = {"*" .. shown_path(path) .. "*", ""}
  for l in text_lines(read(path)) do
    if trim(l) == "" then push(out, ">") else push(out, "> " .. l) end
  end
  return join(out, "\n")
end

-- The one fenced block of a file that holds `text`, fences and all, as the
-- file has it. A journal's scripts are quoted this way.
function fence_of(path, text)
  if not exists(path) then fail("book: {{fence " .. path .. " ...}} names no file") end
  local blocks = {}
  local now = nil
  for l in text_lines(read(path)) do
    if now == nil and starts_with(l, FENCE) then
      now = {l}
    elseif now ~= nil then
      push(now, l)
      if trim(l) == FENCE then
        push(blocks, now)
        now = nil
      end
    end
  end
  local found = {}
  for b in blocks do
    if contains(join(b, "\n"), text) then push(found, b) end
  end
  if #found ~= 1 then fail("book: `" .. text .. "` is in " .. #found .. " fenced blocks of " .. path .. ", and a fence's anchor must be in one") end
  return found[1]
end

-- `{{fence PATH "TEXT"}}`, or with `from "A" to "B"` only the block's lines
-- between those anchors, its fences kept.
function fence_quote(path, text, from, to)
  local b = fence_of(path, text)
  if from ~= nil then
    local inside = slice(b, 2, #b - 1)
    local kept = anchored_span(inside, from, to, path .. " (the fence holding `" .. text .. "`)")
    b = {b[1]}
    for l in kept do push(b, l) end
    push(b, FENCE)
  end
  return "*" .. shown_path(path) .. "*\n\n" .. join(b, "\n")
end

-- A file as a commit had it, for a script the project has since changed or
-- removed: `{{show REPO REV:PATH}}`, the repo a Shale path.
-- `{{show REPO REV:PATH from "A" to "B"}}` quotes the lines between two
-- anchors of that old file.
function shown_at(repo, spec, from, to)
  local at = find(spec, ":")
  if at == nil then fail("book: {{show " .. repo .. " " .. spec .. "}} needs REV:PATH") end
  local ls = text_lines(git_show(repo, spec))
  if from ~= nil then ls = anchored_span(ls, from, to, spec) end
  return "*" .. shown_path(repo) .. "/" .. sub(spec, at + 1) .. ", as of " .. sub(spec, 1, at - 1) .. "*\n\n" .. fenced(spec, ls)
end

function expanded(text)
  local out = {}
  for l in text_lines(text) do
    local file = re_find(l, "^\\{\\{file (\\S+)\\}\\}$")
    local func = re_find(l, "^\\{\\{function (\\S+) (\\w+)\\}\\}$")
    local span = re_find(l, "^\\{\\{lines (\\S+) from \"([^\"]+)\" to \"([^\"]+)\"\\}\\}$")
    local prompt = re_find(l, "^\\{\\{quote (\\S+)\\}\\}$")
    local fence = re_find(l, "^\\{\\{fence (\\S+) \"([^\"]+)\"\\}\\}$")
    local fence_span = re_find(l, "^\\{\\{fence (\\S+) \"([^\"]+)\" from \"([^\"]+)\" to \"([^\"]+)\"\\}\\}$")
    local show = re_find(l, "^\\{\\{show (\\S+) (\\S+)\\}\\}$")
    local show_span = re_find(l, "^\\{\\{show (\\S+) (\\S+) from \"([^\"]+)\" to \"([^\"]+)\"\\}\\}$")
    local block = nil
    if file ~= nil then
      block = quoted(file.group)
    elseif func ~= nil then
      block = function_of(func.groups[1], func.groups[2])
    elseif span ~= nil then
      block = between_anchors(span.groups[1], span.groups[2], span.groups[3])
    elseif prompt ~= nil then
      block = quote_of(prompt.group)
    elseif fence ~= nil then
      block = fence_quote(fence.groups[1], fence.groups[2], nil, nil)
    elseif fence_span ~= nil then
      block = fence_quote(fence_span.groups[1], fence_span.groups[2], fence_span.groups[3], fence_span.groups[4])
    elseif show ~= nil then
      block = shown_at(show.groups[1], show.groups[2], nil, nil)
    elseif show_span ~= nil then
      block = shown_at(show_span.groups[1], show_span.groups[2], show_span.groups[3], show_span.groups[4])
    elseif contains(re_replace(l, "`[^`]*`", ""), "{{") then
      fail("book: a `{{` the build doesn't know: " .. l)
    end
    if block == nil then
      push(out, l)
    else
      for q in lines(block) do push(out, q) end
    end
  end
  return out
end

-- The book's parts: its title, the contents page's text, and each chapter as
-- {title, lines}.
function parts_of(ls)
  local title = ""
  local front = {}
  local chapters = {}
  local current = nil
  local in_code = false
  for l in ls do
    if starts_with(l, FENCE) then in_code = not in_code end
    if in_code or starts_with(l, FENCE) then
      if current == nil then push(front, l) else push(current.lines, l) end
    elseif title == "" and starts_with(l, "# ") then
      title = sub(l, 3)
    elseif starts_with(l, "## ") then
      current = {title = sub(l, 4), lines = {}}
      push(chapters, current)
    elseif current == nil then
      push(front, l)
    else
      push(current.lines, l)
    end
  end
  if title == "" then fail("book: book.md has no `#` title") end
  return {title = title, front = front, chapters = chapters}
end

const DOT_WANT = "graphviz: the book's diagrams, drawn at build time"

-- A ```dot fence's source drawn as SVG by Graphviz, ready to sit in a page,
-- its comments and titles dropped (a title shows as a tooltip on hover).
function drawn(source)
  local dir = fresh_dir("scratch:", "book-dot")
  replace(dir .. "/d.dot", source)
  local r = run({"dot", "-Tsvg", "-Gfontsize=12", "-Nfontsize=12", "-Efontsize=11", real(dir .. "/d.dot")}, {timeout_ms = 30000, whole = 2000000, want = DOT_WANT})
  remove_tree(dir)
  if r.code ~= 0 then
    print(trim(r.out))
    fail("book: dot could not draw a diagram")
  end
  local at = find(r.out, "<svg ")
  if at == nil then fail("book: dot drew no <svg>") end
  local kept = {}
  for l in lines(sub(r.out, at)) do
    if not starts_with(l, "<!--") and not starts_with(l, "<title>") then push(kept, l) end
  end
  return join(kept, "\n")
end

-- A chapter's markdown, its `###` sections made `##`, and its counts. A
-- ```dot fence becomes its drawing, as raw HTML.
function chapter_page(chapter)
  local out = {"# " .. chapter.title, ""}
  local in_code = false
  local in_dot = false
  local dot = {}
  local prose = 0
  local code = 0
  for l in chapter.lines do
    if in_dot then
      if trim(l) == FENCE then
        push(out, FENCE .. "raw")
        push(out, "<figure class=\"diagram\">" .. drawn(join(dot, "\n")) .. "</figure>")
        push(out, FENCE)
        in_dot = false
      else
        push(dot, l)
      end
    elseif not in_code and trim(l) == FENCE .. "dot" then
      in_dot = true
      dot = {}
    elseif starts_with(l, FENCE) then
      in_code = not in_code
      push(out, l)
    elseif in_code then
      code = code + 1
      push(out, l)
    elseif starts_with(l, "### ") then
      push(out, "## " .. sub(l, 5))
    else
      -- A quoted prompt is the prompt's words, not the chapter's, and a
      -- quote's caption names its file.
      local caption = re_find(l, "^\\*[^*]+\\*$") ~= nil
      if not starts_with(l, ">") and not caption then prose = prose + #words(l) end
      push(out, l)
    end
  end
  return {markdown = join(out, "\n"), prose = prose, code = code}
end

function rendered(markdown)
  local r = run({real(RENDER), markdown}, {timeout_ms = 30000, whole = 4000000, want = RENDER_WANT})
  if r.ended ~= "exit" or r.code ~= 0 then
    print(trim(r.out))
    fail("book: the renderer failed")
  end
  return r.out
end

function plain(s)
  return re_replace(re_replace(re_replace(re_replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "`", "")
end

-- A page: the contents page is `front`, and a chapter is `chapter`, with the
-- chapter list beside it, `nav`.
function page(kind, book_title, title, body, pager, nav)
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    .. "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    .. "<title>" .. plain(title) .. "</title>\n<link rel=\"stylesheet\" href=\"book.css\">\n</head>\n<body class=\"" .. kind .. "\">\n"
    .. "<header class=\"top-bar\"><a href=\"index.html\">" .. plain(book_title) .. "</a><span>a rough draft</span></header>\n"
    .. nav .. "<main>\n" .. body .. "\n" .. pager .. "\n</main>\n</body>\n</html>\n"
end

-- A rendered page's sections, `{id, title}`, from its `<h2>` lines.
function sections_of(html)
  local found = {}
  for l in lines(html) do
    local m = re_find(l, "^<h2 id=\"([^\"]+)\">(.*)</h2>$")
    if m ~= nil then push(found, {id = m.groups[1], title = re_replace(m.groups[2], "<[^>]*>", "")}) end
  end
  return found
end

-- The chapter list beside a chapter: every chapter by number, and the
-- sections of chapter `n`, the one being read.
function sidebar(book_title, chapters, n, sections)
  local ls = {"<nav class=\"book-nav\" aria-label=\"Chapters\">", "<a class=\"book-name\" href=\"index.html\">" .. plain(book_title) .. "</a>", "<ol>"}
  local i = 0
  for c in chapters do
    i = i + 1
    local file = "chapter-" .. i .. ".html"
    local link = "<a href=\"" .. file .. "\"><span class=\"number\">" .. i .. "</span>" .. plain(c.title) .. "</a>"
    if i == n then
      push(ls, "<li class=\"here\">" .. link .. "<ol class=\"sections\">")
      for s in sections do push(ls, "<li><a href=\"" .. file .. "#" .. s.id .. "\">" .. s.title .. "</a></li>") end
      push(ls, "</ol></li>")
    else
      push(ls, "<li>" .. link .. "</li>")
    end
  end
  push(ls, "</ol>")
  push(ls, "</nav>")
  return join(ls, "\n") .. "\n"
end

function pager(n, chapters)
  local before = "<span></span>"
  local after = "<span></span>"
  if n > 1 then before = "<a href=\"chapter-" .. (n - 1) .. ".html\">← " .. plain(chapters[n - 1].title) .. "</a>" end
  if n < #chapters then after = "<a href=\"chapter-" .. (n + 1) .. ".html\">" .. plain(chapters[n + 1].title) .. " →</a>" end
  return "<nav class=\"pager\">" .. before .. "<a href=\"index.html\">Contents</a>" .. after .. "</nav>"
end

function contents(book)
  local ls = {"<h1>" .. plain(book.title) .. "</h1>", rendered(join(book.front, "\n")), "<ol class=\"contents\">"}
  local n = 0
  for c in book.chapters do
    n = n + 1
    push(ls, "<li><a href=\"chapter-" .. n .. ".html\">" .. plain(c.title) .. "</a></li>")
  end
  push(ls, "</ol>")
  return join(ls, "\n")
end

-- The book's prose lints, over the whole expanded book, as `path-free`
-- findings: an output block over MAX_OUTPUT_LINES that long_blocks.txt
-- doesn't name, a phrase of refrains.txt used more than its allowance, and a
-- chapter named by number. A numbered session is fine. Each table line is `key<TAB>value`: a block's
-- first line and the reason it's long; a phrase's allowance and the phrase.
const MAX_OUTPUT_LINES = 12
const LONG_BLOCKS = "book/long_blocks.txt"
const REFRAINS = "book/refrains.txt"

function table_lines(path)
  local rows = {}
  if not exists(path) then return rows end
  for l in text_lines(read(path)) do
    if trim(l) ~= "" and not starts_with(l, "#") then
      local tab = find(l, "\t")
      if tab == nil then fail("book: " .. path .. " has a line with no tab: " .. l) end
      push(rows, {key = sub(l, 1, tab - 1), value = sub(l, tab + 1)})
    end
  end
  return rows
end

-- A caption an include wrote, which names the file a quote comes from, such
-- as `*essay-surface/journal/monday.md*`: a path, not the book's prose.
function source_caption(l)
  return starts_with(l, "*") and re_find(l, "^\\*[^* ]*/[^* ]*(\\*$|, )") ~= nil
end

function lint_findings(ls)
  local found = {}
  local long_ok = {}
  for row in table_lines(LONG_BLOCKS) do long_ok[row.key] = true end
  local prose = {}
  local in_code = false
  local tag = ""
  local block = {}
  for l in ls do
    if starts_with(l, FENCE) then
      if not in_code then
        tag = trim(sub(l, 4))
        block = {}
      elseif tag == "text" and #block > MAX_OUTPUT_LINES and not has_key(long_ok, get(block, 1, "")) then
        push(found, "an output block of " .. #block .. " lines, over " .. MAX_OUTPUT_LINES .. ", starting `" .. sub(get(block, 1, ""), 1, 80) .. "`: trim it, or name it in " .. LONG_BLOCKS)
      end
      in_code = not in_code
    elseif in_code then
      push(block, l)
    elseif not starts_with(l, ">") and not source_caption(l) then
      push(prose, lower(l))
    end
  end
  local text = join(prose, "\n")
  for row in table_lines(REFRAINS) do
    local uses = #find_all(text, lower(row.value))
    if uses > parse_int(row.key) then push(found, "`" .. row.value .. "` is used " .. uses .. " times, and " .. REFRAINS .. " allows " .. row.key) end
  end
  for m in re_find_all(text, "\\bchapters? [0-9]+") do push(found, "a chapter named by number: `" .. m.text .. "`") end
  return found
end

local whole = expanded(read(SOURCE))
local lint = lint_findings(whole)
local book = parts_of(whole)
if #book.chapters == 0 then fail("book: book.md has no `##` chapters") end
if exists(DEST) then remove_tree(DEST) end
mkdir(DEST)
replace(DEST .. "/book.css", read(CSS))
-- The book with every include filled in, for a reader who wants it in one file.
replace(DEST .. "/book.md", join(whole, "\n") .. "\n")
replace(DEST .. "/index.html", page("front", book.title, book.title, contents(book), "<nav class=\"pager\"><span></span><a href=\"chapter-1.html\">Start reading →</a></nav>", ""))
local rows = {}
local over = {}
local n = 0
for c in book.chapters do
  n = n + 1
  local p = chapter_page(c)
  local html = rendered(p.markdown)
  local nav = sidebar(book.title, book.chapters, n, sections_of(html))
  replace(DEST .. "/chapter-" .. n .. ".html", page("chapter", book.title, c.title, html, pager(n, book.chapters), nav))
  push(rows, {chapter = n, prose = p.prose, code = p.code, title = plain(c.title)})
  if p.prose > MAX_PROSE_WORDS then push(over, n .. " (" .. p.prose .. " words)") end
end
print(table(rows, {"chapter", "prose", "code", "title"}))
for f in lint do print("lint: " .. f) end
if #over > 0 then fail("book: over " .. MAX_PROSE_WORDS .. " words of prose: " .. join(over, ", ")) end
if #lint > 0 then fail("book: " .. #lint .. " lint findings, above") end
print("book: " .. #book.chapters .. " chapters at " .. URL)
