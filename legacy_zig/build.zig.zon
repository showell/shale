.{
    // DEPRECATED AND FROZEN (README.md): Zig Shale, replaced by the C in ../c.
    // Shale, the script language for a site's own data and an agent's own
    // tool: two modules an application depends on: `shale` (src/shale.zig,
    // portable, what its code imports) and `shale_linux` (src/shale_linux.zig,
    // the Linux host, for its Linux `main`); and the `shale` CLI.
    .name = .shale,
    .version = "0.1.0",
    .fingerprint = 0x3b47a285030d9023,
    .minimum_zig_version = "0.17.0",
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools" },
    .dependencies = .{
        // The web-server-in-a-box library: zig-webbox, a sibling of Shale's
        // checkout: its `store` holds every effect a script has.
        .webbox = .{ .path = "../../zig-webbox" },
        // zig-ast, a package of its own, live (../tools/zig_ast/README.md).
        .zig_ast = .{ .path = "../tools/zig_ast" },
        // The coverage SDK (a sibling, zig-coverage-sdk), for `zig build
        // script-coverage` alone: lazy, so `test` and the applications
        // that build Shale never need it.
        .zig_coverage_sdk = .{ .path = "../../zig-coverage-sdk", .lazy = true },
    },
}
